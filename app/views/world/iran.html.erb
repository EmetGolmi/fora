<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORA · Iran · Islamic Republic</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --blue:#1b3a6b;--blue-lt:#2a5298;--blue-vp:rgba(27,58,107,0.04);--blue-pl:rgba(27,58,107,0.12);
  --gilt:#b8860b;--gilt-dk:#8b6914;--gilt-pl:#fdf8ed;--gilt-rul:rgba(184,134,11,0.2);
  --red:#8b1a1a;--red-lt:#c0392b;--red-p:rgba(139,26,26,0.06);--red-r:rgba(139,26,26,0.18);
  --amber:#c47f00;--amber-p:rgba(196,127,0,0.07);--amber-r:rgba(196,127,0,0.2);
  --green:#155c2d;--green-p:rgba(21,92,45,0.07);
  --purple:#2d1a4a;--purple-lt:#f0eaf7;
  --ink:#0e1a2e;--ink-mid:#1e2d45;--ink-soft:#4a5568;--ink-mut:#7a8aaa;
  --bg:#f2f4f8;--bg2:#e8ebf2;--white:#ffffff;
  --rule:rgba(27,58,107,0.1);--rule-lt:rgba(27,58,107,0.06);
  --paper:#f7f4ee;--paper-ink:#0e0c08;--paper-soft:#5a5448;
}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);line-height:1.5;}
a{text-decoration:none;color:inherit;}
.plain-summary a,.nh-lead a,.nge-desc a,.cb-text a{color:var(--blue);border-bottom:1px solid rgba(27,58,107,0.3);}
.plain-summary a:hover,.nh-lead a:hover{border-bottom-color:var(--blue);}

/* NAV */
.nav{background:var(--blue);border-bottom:4px solid var(--gilt);padding:0 40px;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;}
.nav-logo{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:white;letter-spacing:0.04em;}
.nav-links{display:flex;gap:28px;align-items:center;}
.nav-link{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.5);cursor:pointer;}
.nav-link.active{color:white;}
.nav-btn{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:6px 14px;border-radius:100px;border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.7);cursor:pointer;background:transparent;}

/* TICKER */
.ticker-bar{height:30px;background:#0a0f1a;border-bottom:1px solid #1b3a6b;display:flex;align-items:center;overflow:hidden;}
.ticker-badge{flex-shrink:0;height:100%;padding:0 12px;display:flex;align-items:center;gap:6px;background:#7a1212;border-right:1px solid #c0392b;}
.ticker-badge-text{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.12em;text-transform:uppercase;color:white;white-space:nowrap;}
.ticker-scroll-wrap{flex:1;overflow:hidden;position:relative;}
.ticker-track{display:flex;align-items:center;animation:ticker-scroll 28s linear infinite;white-space:nowrap;}
@keyframes ticker-scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
.ticker-item{display:inline-flex;align-items:center;gap:8px;padding:0 18px;height:30px;border-right:1px solid rgba(255,255,255,0.06);}
.ticker-key{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.35);}
.ticker-val{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;}
.tv-red{color:#ff8080;}.tv-white{color:rgba(255,255,255,0.85);}.tv-amber{color:#FAC775;}.tv-green{color:#80ffaa;}

/* WAR ALERT */
.war-alert{background:linear-gradient(135deg,#4a0808,#7a1212);border-bottom:2px solid #c0392b;padding:10px 40px;display:flex;align-items:center;gap:14px;}
.wa-pulse{width:8px;height:8px;border-radius:50%;background:#ff4444;flex-shrink:0;animation:pulse 1.4s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(255,68,68,0.4);}50%{opacity:0.7;box-shadow:0 0 0 6px rgba(255,68,68,0);}}
.wa-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.5);flex-shrink:0;}
.wa-text{font-family:'Nunito',sans-serif;font-size:13px;color:white;line-height:1.4;flex:1;}
.wa-date{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:rgba(255,255,255,0.3);flex-shrink:0;}

/* HERO */
.hero{background:linear-gradient(160deg,#0e1a2e 0%,#1b3a6b 50%,#12295a 100%);padding:32px 40px 28px;position:relative;overflow:hidden;}
.hero-inner{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;position:relative;}
.breadcrumb{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:14px;display:flex;align-items:center;gap:6px;}
.bc-sep{color:rgba(255,255,255,0.15);}
.bc-here{color:rgba(255,255,255,0.6);}
.juris-identity{display:flex;align-items:center;gap:16px;margin-bottom:16px;}
.iran-flag{display:flex;flex-direction:column;border-radius:4px;overflow:hidden;border:1px solid rgba(255,255,255,0.15);width:48px;flex-shrink:0;}
.flag-green{background:#239f40;height:15px;}
.flag-white{background:#f5f5f5;height:15px;display:flex;align-items:center;justify-content:center;font-size:8px;}
.flag-red{background:#da0000;height:15px;}
.juris-name{font-family:'Playfair Display',serif;font-size:38px;font-weight:900;color:white;line-height:0.95;letter-spacing:-0.01em;}
.juris-name-local{font-family:'Source Serif 4',serif;font-size:13px;font-style:italic;color:rgba(255,255,255,0.45);margin-top:4px;direction:rtl;}
.juris-sub{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:6px;}
.juris-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
.jtag{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 8px;border-radius:100px;border:1px solid;}
.jtag-type{color:rgba(184,134,11,0.9);border-color:rgba(184,134,11,0.3);background:rgba(184,134,11,0.1);}
.jtag-war{color:rgba(255,100,100,0.9);border-color:rgba(255,100,100,0.3);background:rgba(255,100,100,0.08);animation:pulse 1.4s ease-in-out infinite;}
.jtag-blue{color:rgba(255,255,255,0.5);border-color:rgba(255,255,255,0.12);background:rgba(255,255,255,0.05);}
.jtag-new{color:rgba(128,255,170,0.9);border-color:rgba(128,255,170,0.3);background:rgba(128,255,170,0.08);}
.hero-stats{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);border-radius:10px;overflow:hidden;margin-top:18px;}
.hs{background:rgba(255,255,255,0.03);padding:11px 14px;}
.hs-num{font-family:'Libre Baskerville',serif;font-size:19px;font-weight:700;color:white;}
.hs-num.red{color:#ffaaaa;}
.hs-label{font-family:'JetBrains Mono',monospace;font-size:6px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.27);margin-top:3px;line-height:1.5;}
.hs-click{cursor:pointer;transition:background 0.15s;}
.hs-click:hover{background:rgba(255,255,255,0.1);}
.hero-right{display:flex;flex-direction:column;gap:8px;min-width:180px;flex-shrink:0;}
.btn-primary{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:none;cursor:pointer;background:var(--gilt);color:white;}
.btn-secondary{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(255,255,255,0.2);cursor:pointer;background:transparent;color:rgba(255,255,255,0.7);}
.btn-red{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(255,100,100,0.3);cursor:pointer;background:rgba(255,100,100,0.08);color:rgba(255,150,150,0.9);}

/* TABS */
.org-tabs{background:var(--white);border-bottom:1px solid var(--rule);position:sticky;top:60px;z-index:100;}
.tabs-inner{display:flex;align-items:center;padding:0 40px;gap:0;overflow-x:auto;}
.tab{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:14px 16px;cursor:pointer;color:var(--ink-mut);border-bottom:2px solid transparent;white-space:nowrap;}
.tab:hover{color:var(--blue);}
.tab.active{color:var(--blue);border-bottom-color:var(--blue);font-weight:600;}
.tab.live{color:var(--red);}
.tab.live.active{border-bottom-color:var(--red);}
.tab[title]{position:relative;}
.tab[title]:hover::after{content:attr(title);position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:var(--ink);color:rgba(255,255,255,0.9);font-family:'Source Serif 4',serif;font-size:11px;font-style:italic;white-space:nowrap;padding:5px 10px;border-radius:4px;pointer-events:none;z-index:300;}

/* BODY */
.juris-body{display:grid;grid-template-columns:1fr 280px;gap:0;max-width:1400px;margin:0 auto;padding:0 40px 60px;align-items:start;}
.juris-main{padding:32px 32px 0 0;min-width:0;}
.juris-sidebar{padding:32px 0 0;border-left:1px solid var(--rule);padding-left:24px;}

/* SECTION BLOCKS */
.sec-block{margin-bottom:40px;}
.sec-block+.sec-block{padding-top:32px;border-top:2px solid rgba(14,12,8,0.15);}
.nh-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt-dk);margin-bottom:5px;}
.nh-headline{font-family:'Playfair Display',serif;font-size:26px;font-weight:900;color:var(--paper-ink);line-height:1.1;margin-bottom:8px;}
.nh-headline.crisis{color:var(--red);}
.nh-lead{font-family:'Source Serif 4',serif;font-size:13.5px;color:var(--paper-soft);line-height:1.75;margin-bottom:18px;padding-bottom:16px;border-bottom:1px solid var(--rule);}

/* CRISIS BLOCK */
.cb-label{display:flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--red);margin-bottom:6px;}
.cb-dot{width:7px;height:7px;border-radius:50%;background:var(--red);animation:pulse 1.4s ease-in-out infinite;}
.cb-title{font-family:'Libre Baskerville',serif;font-size:15px;font-weight:700;color:var(--ink);margin-bottom:8px;line-height:1.35;}
.cb-text{font-family:'Source Serif 4',serif;font-size:13px;color:var(--ink-soft);line-height:1.7;margin-bottom:14px;}
.cb-facts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
.cbf{background:var(--bg);border:1px solid var(--rule);border-radius:6px;padding:9px 12px;}
.cbf-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:2px;}
.cbf-val{font-family:'Nunito',sans-serif;font-size:12.5px;font-weight:700;color:var(--ink);}
.succession-note{background:var(--amber-p);border:1px solid var(--amber-r);border-radius:8px;padding:10px 14px;display:flex;gap:10px;align-items:flex-start;margin-bottom:12px;}
.sn-icon{font-size:14px;flex-shrink:0;}
.sn-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-mid);line-height:1.65;}
.resolution-note{background:var(--green-p);border:1px solid rgba(21,92,45,0.2);border-radius:8px;padding:10px 14px;display:flex;gap:10px;align-items:flex-start;}
.rn-icon{font-size:14px;flex-shrink:0;}
.rn-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-mid);line-height:1.65;}

/* AUTHORITY TABLE */
.auth-table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid var(--rule);}
.auth-table thead tr{background:var(--blue);}
.auth-table th{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.45);padding:9px 14px;text-align:left;font-weight:400;}
.auth-table td{padding:10px 14px;border-bottom:1px solid var(--rule-lt);vertical-align:top;}
.auth-table tr:last-child td{border-bottom:none;}
.auth-table tr:hover td{background:var(--bg);}
.at-body{font-family:'Libre Baskerville',serif;font-size:12.5px;font-weight:700;color:var(--blue);margin-bottom:3px;}
.at-body.red{color:var(--red);}
.at-body.purple{color:var(--purple);}
.at-badge{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.08em;text-transform:uppercase;padding:1px 6px;border-radius:3px;display:inline-block;}
.ab-unelect{color:var(--red);background:var(--red-p);border:1px solid var(--red-r);}
.ab-appoint{color:var(--gilt);background:var(--gilt-pl);border:1px solid var(--gilt-rul);}
.ab-vetted{color:var(--amber);background:var(--amber-p);border:1px solid var(--amber-r);}
.ab-nge{color:var(--purple);background:var(--purple-lt);border:1px solid rgba(45,26,74,0.2);}
.at-holder{font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;color:var(--ink);margin-bottom:1px;}
.at-meta{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);}
.at-meta.crisis{color:var(--red);}
.at-meta.green{color:var(--green);}
.at-note{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);}
.circular-lock{background:var(--blue-vp);border:1px solid var(--blue-pl);border-radius:8px;padding:10px 14px;font-family:'Source Serif 4',serif;font-size:12px;color:var(--ink-soft);line-height:1.65;margin-top:12px;}

/* PHILOSOPHY */
.philosophy-block{background:var(--gilt-pl);border:1px solid var(--gilt-rul);border-radius:10px;padding:16px 20px;margin-bottom:14px;}
.pb-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gilt-dk);margin-bottom:5px;}
.pb-title{font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:var(--paper-ink);margin-bottom:6px;}
.pb-text{font-family:'Source Serif 4',serif;font-size:13px;color:var(--paper-soft);line-height:1.7;}

/* NGE CARDS */
.nge-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.nge-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:13px 15px;display:flex;gap:11px;align-items:flex-start;transition:box-shadow 0.12s;cursor:pointer;}
.nge-card:hover{box-shadow:0 2px 12px rgba(27,58,107,0.08);}
.nge-card.controls{border-left:3px solid var(--blue);}
.nge-card.degraded{border-left:3px solid var(--red);}
.nge-icon{font-size:18px;flex-shrink:0;margin-top:1px;}
.nge-name{font-family:'Libre Baskerville',serif;font-size:13px;font-weight:700;color:var(--blue);margin-bottom:3px;}
.nge-rel{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:1px 6px;border-radius:3px;background:var(--blue-vp);color:var(--blue);border:1px solid var(--blue-pl);display:inline-block;margin-bottom:5px;}
.nge-rel.red{background:var(--red-p);color:var(--red);border-color:var(--red-r);}
.nge-desc{font-family:'Nunito',sans-serif;font-size:11.5px;color:var(--ink-soft);line-height:1.55;}

/* ── TERM TOOLTIPS / MODALS ── */
.term{border-bottom:1px dotted currentColor;cursor:help;position:relative;}
@media(hover:hover)and(pointer:fine){
  .term::after{content:attr(data-def);position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:#0e1a2e;color:rgba(255,255,255,0.92);font-family:'Source Serif 4',serif;font-size:11.5px;font-style:normal;font-weight:400;line-height:1.65;padding:10px 14px;border-radius:7px;border:1px solid rgba(184,134,11,0.3);max-width:280px;width:max-content;white-space:normal;pointer-events:none;opacity:0;transition:opacity 0.15s;z-index:500;box-shadow:0 4px 20px rgba(0,0,0,0.35);}
  .term:hover::after{opacity:1;}
}
#term-modal{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end;}
.tm-backdrop{position:fixed;inset:0;background:rgba(0,0,0,0.55);}
.tm-box{position:relative;background:#fff;border-radius:14px 14px 0 0;padding:22px 20px 36px;width:100%;max-height:65vh;overflow-y:auto;box-shadow:0 -4px 32px rgba(0,0,0,0.25);}
.tm-title{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:#0e1a2e;margin-bottom:10px;}
.tm-def{font-family:'Source Serif 4',serif;font-size:14px;color:#4a5568;line-height:1.75;}
.tm-close{margin-top:18px;font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:8px 18px;border-radius:6px;border:1px solid rgba(27,58,107,0.2);background:transparent;color:#1b3a6b;cursor:pointer;display:block;}

/* PLAIN SUMMARY */
.plain-summary{background:rgba(27,58,107,0.05);border:1px solid rgba(27,58,107,0.15);border-radius:8px;padding:14px 16px;font-family:'Source Serif 4',serif;font-size:13px;color:var(--ink-mid);line-height:1.75;margin-bottom:0;}

/* SIDEBAR */
.sb-block{margin-bottom:24px;}
.sb-block+.sb-block{padding-top:20px;border-top:1px solid var(--rule);}
.sb-ey{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:4px;}
.sb-title{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:var(--blue);margin-bottom:12px;}
.data-row{display:flex;justify-content:space-between;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--rule-lt);}
.data-row:last-child{border-bottom:none;}
.dr-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);}
.dr-val{font-family:'Nunito',sans-serif;font-size:12px;font-weight:600;color:var(--ink);text-align:right;max-width:60%;}
.dr-val.red{color:var(--red);}
.official-row{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--rule-lt);}
.official-row:last-child{border-bottom:none;}
.or-avatar{width:32px;height:32px;border-radius:50%;background:var(--blue);color:white;font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.or-name{font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;color:var(--ink);}
.or-role{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.06em;color:var(--ink-mut);margin-top:1px;}
.or-badge{display:inline-block;font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.06em;text-transform:uppercase;padding:1px 5px;border-radius:3px;margin-top:3px;margin-right:3px;}
.ob-new{background:rgba(21,92,45,0.08);color:var(--green);border:1px solid rgba(21,92,45,0.2);}
.ob-crisis{background:var(--red-p);color:var(--red);border:1px solid var(--red-r);}
.ob-incumbent{background:var(--blue-vp);color:var(--blue);border:1px solid var(--blue-pl);}
.quick-link{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--rule-lt);font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.07em;color:var(--blue);}
.quick-link:last-child{border-bottom:none;}
.info-card{background:var(--blue-vp);border:1px solid var(--blue-pl);border-radius:8px;padding:10px 13px;margin-bottom:10px;}
.ic-label{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:3px;}
.ic-val{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink);line-height:1.6;}
</style>
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <div class="nav-logo">FORA</div>
  <div class="nav-links">
    <span class="nav-link">Governance</span>
    <span class="nav-link active">World</span>
    <span class="nav-link">Knowledge</span>
    <span class="nav-link">Discourse</span>
  </div>
  <button class="nav-btn">Sign In</button>
