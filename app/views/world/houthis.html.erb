<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORA · Houthis (Ansar Allah) · NGE</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#f2f4f8;--white:#ffffff;
  --blue:#1b3a6b;--blue-pl:rgba(27,58,107,0.12);--blue-vp:rgba(27,58,107,0.04);
  --gilt:#b8860b;--gilt-lt:#d4a832;--gilt-pl:#f8f0dc;--gilt-rul:rgba(184,134,11,0.22);--gilt-dk:#8b6914;
  --ink:#0e1a2e;--ink-soft:#5a6e8a;--ink-mut:#8a9ab8;--ink-mid:#1e2d45;
  --rule:rgba(27,58,107,0.1);--rule-lt:rgba(27,58,107,0.05);
  --green:#155c2d;--green-p:rgba(21,92,45,0.07);
  --red:#8b2020;--red-p:rgba(139,32,32,0.06);--red-r:rgba(139,32,32,0.2);
  --amber:#c47f00;--amber-p:rgba(196,127,0,0.07);--amber-r:rgba(196,127,0,0.2);
  /* Houthis: deep forest green accent */
  --hth:#1a3d1a;--hth-lt:#2e6b2e;--hth-p:rgba(26,61,26,0.07);--hth-r:rgba(26,61,26,0.22);
}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);}
a{text-decoration:none;color:inherit;}
.plain-summary a,.sec-lead a,.slogan-note a,.lf-bio a{color:var(--hth-lt);border-bottom:1px solid rgba(46,107,46,0.35);}
.plain-summary a:hover,.sec-lead a:hover{border-bottom-color:var(--hth-lt);}

nav{background:var(--blue);padding:0 48px;display:flex;align-items:center;height:60px;border-bottom:4px solid var(--gilt);position:sticky;top:0;z-index:200;}
.nav-logo{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:white;letter-spacing:0.1em;margin-right:24px;}
.nav-links{display:flex;gap:6px;}
.nav-link{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.38);padding:6px 14px;border-radius:100px;cursor:pointer;}
.nav-link.active{color:white;background:rgba(255,255,255,0.1);}
.nav-right{margin-left:auto;}

/* TICKER */
.ticker-bar{height:28px;background:#0a0f1a;border-bottom:1px solid #1b3a6b;display:flex;align-items:center;overflow:hidden;}
.ticker-badge{flex-shrink:0;height:100%;padding:0 12px;display:flex;align-items:center;gap:6px;background:#1a3d1a;border-right:1px solid #2e6b2e;}
.ticker-badge-text{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:white;}
.ticker-scroll-wrap{flex:1;overflow:hidden;}
.ticker-track{display:flex;align-items:center;animation:tickscroll 30s linear infinite;white-space:nowrap;}
@keyframes tickscroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
.ticker-item{display:inline-flex;align-items:center;gap:8px;padding:0 16px;height:28px;border-right:1px solid rgba(255,255,255,0.05);}
.t-key{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);}
.t-val{font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:500;}
.tv-r{color:#ff9090;}.tv-a{color:#FAC775;}.tv-w{color:rgba(255,255,255,0.8);}.tv-g{color:#80ffaa;}

/* HERO */
.hero{background:linear-gradient(160deg,#0c1e0c 0%,#1a3d1a 50%,#122212 100%);padding:36px 48px 28px;position:relative;overflow:hidden;}
.breadcrumb{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:16px;display:flex;align-items:center;gap:6px;}
.bc-sep{color:rgba(255,255,255,0.12);}
.bc-here{color:rgba(255,255,255,0.55);}
.hero-inner{display:flex;gap:32px;align-items:flex-start;position:relative;}
.entity-identity{flex:1;}
.entity-icon-wrap{width:52px;height:52px;border-radius:8px;border:1px solid rgba(255,255,255,0.15);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:26px;background:#1a3d1a;}
.entity-name{font-family:'Playfair Display',serif;font-size:36px;font-weight:900;color:white;line-height:0.95;margin-bottom:4px;}
.entity-name-local{font-family:'Source Serif 4',serif;font-size:13px;font-style:italic;color:rgba(255,255,255,0.4);margin-bottom:6px;direction:rtl;}
.entity-sub{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.25);}
.entity-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;}
.etag{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 9px;border-radius:100px;border:1px solid;}
.etag-fto{color:rgba(255,130,130,0.9);border-color:rgba(255,130,130,0.3);background:rgba(255,100,100,0.08);}
.etag-type{color:rgba(184,134,11,0.9);border-color:rgba(184,134,11,0.3);background:rgba(184,134,11,0.08);}
.etag-grey{color:rgba(255,255,255,0.45);border-color:rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);}
.etag-active{color:rgba(128,255,170,0.9);border-color:rgba(128,255,170,0.3);background:rgba(128,255,170,0.07);}
.hero-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.07);border-radius:10px;overflow:hidden;margin-top:18px;}
.hs{background:rgba(255,255,255,0.02);padding:10px 13px;}
.hs-num{font-family:'Libre Baskerville',serif;font-size:18px;font-weight:700;color:white;}
.hs-label{font-family:'JetBrains Mono',monospace;font-size:6px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-top:3px;line-height:1.5;}
.hero-actions{display:flex;flex-direction:column;gap:8px;min-width:160px;}
.btn-p{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:none;cursor:pointer;background:var(--gilt);color:white;}
.btn-s{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(255,255,255,0.18);cursor:pointer;background:transparent;color:rgba(255,255,255,0.65);}

/* TABS */
.page-tabs{background:var(--white);border-bottom:1px solid var(--rule);position:sticky;top:60px;z-index:100;}
.tabs-inner{display:flex;padding:0 48px;gap:0;overflow-x:auto;}
.tab{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:14px 15px;cursor:pointer;color:var(--ink-mut);border-bottom:2px solid transparent;white-space:nowrap;}
.tab:hover{color:var(--hth);}
.tab.active{color:var(--hth);border-bottom-color:var(--hth);font-weight:600;}

/* BODY */
.page-body{display:grid;grid-template-columns:1fr 272px;gap:0;max-width:1380px;margin:0 auto;padding:0 48px 60px;align-items:start;}
.page-main{padding:32px 28px 0 0;min-width:0;}
.page-sidebar{padding:32px 0 0;border-left:1px solid var(--rule);padding-left:22px;}
.sec{margin-bottom:40px;}
.sec+.sec{padding-top:30px;border-top:1.5px solid rgba(14,26,46,0.12);}
.sec-ey{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt-dk);margin-bottom:5px;}
.sec-headline{font-family:'Playfair Display',serif;font-size:24px;font-weight:900;color:#0e0c08;line-height:1.1;margin-bottom:8px;}
.sec-lead{font-family:'Source Serif 4',serif;font-size:13.5px;color:#5a5448;line-height:1.75;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--rule);}

.plain-summary{background:var(--hth-p);border:1px solid var(--hth-r);border-radius:8px;padding:12px 14px;font-family:'Source Serif 4',serif;font-size:13px;color:var(--ink-mid);line-height:1.7;margin-bottom:14px;}

/* SLOGAN CARD */
.slogan-card{background:linear-gradient(135deg,#0c1e0c,#1a3d1a);border-radius:10px;padding:18px 22px;margin-bottom:16px;position:relative;overflow:hidden;}
.slogan-text{font-family:'Playfair Display',serif;font-size:15px;font-style:italic;color:rgba(255,255,255,0.9);line-height:1.65;margin-bottom:8px;}
.slogan-arabic{font-family:'Source Serif 4',serif;font-size:14px;color:rgba(255,255,255,0.45);direction:rtl;text-align:right;}
.slogan-note{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:10px;border-top:1px solid rgba(255,255,255,0.1);padding-top:8px;}

/* LEADER CARD */
.leader-feature{background:var(--white);border:1px solid var(--rule);border-left:4px solid var(--hth);border-radius:10px;padding:16px 18px;margin-bottom:12px;}
.lf-avatar{width:44px;height:44px;border-radius:50%;background:var(--hth);color:white;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;float:left;margin-right:14px;margin-bottom:4px;}
.lf-name{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:var(--ink);margin-bottom:2px;}
.lf-role{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:6px;}
.lf-bio{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-soft);line-height:1.65;clear:both;}
.lf-badge{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.06em;text-transform:uppercase;padding:1px 6px;border-radius:3px;display:inline-block;margin-right:4px;margin-bottom:6px;}
.lb-inc{color:var(--green);background:var(--green-p);border:1px solid rgba(21,92,45,0.2);}
.lb-zaydi{color:var(--hth);background:var(--hth-p);border:1px solid var(--hth-r);}

/* OPERATIONS TABLE */
.ops-table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid var(--rule);margin-bottom:14px;}
.ops-table thead tr{background:var(--hth);}
.ops-table th{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.5);padding:9px 14px;text-align:left;font-weight:400;}
.ops-table td{padding:9px 14px;border-bottom:1px solid var(--rule-lt);vertical-align:top;font-size:12px;}
.ops-table tr:last-child td{border-bottom:none;}
.ops-table tr:hover td{background:var(--bg);}
.ot-event{font-family:'Libre Baskerville',serif;font-size:12.5px;font-weight:700;color:var(--ink);}
.ot-date{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);}
.ot-status{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.07em;text-transform:uppercase;padding:1px 6px;border-radius:3px;}
.st-active{color:var(--green);background:var(--green-p);border:1px solid rgba(21,92,45,0.2);}
.st-concluded{color:var(--ink-mut);background:var(--bg);border:1px solid var(--rule);}
.st-suspended{color:var(--amber);background:var(--amber-p);border:1px solid var(--amber-r);}

/* SIDEBAR */
.sb-block{margin-bottom:22px;}
.sb-block+.sb-block{padding-top:18px;border-top:1px solid var(--rule);}
.sb-ey{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:4px;}
.sb-title{font-family:'Libre Baskerville',serif;font-size:13.5px;font-weight:700;color:var(--hth);margin-bottom:10px;}
.data-row{display:flex;justify-content:space-between;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--rule-lt);}
.data-row:last-child{border-bottom:none;}
.dr-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.07em;text-transform:uppercase;color:var(--ink-mut);}
.dr-val{font-family:'Nunito',sans-serif;font-size:12px;font-weight:600;color:var(--ink);text-align:right;max-width:60%;}
.dr-val.red{color:var(--red);}
.quick-link{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--rule-lt);font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.07em;color:var(--hth);}
.quick-link:last-child{border-bottom:none;}
.desig-mini{border:1px solid var(--rule);border-radius:8px;overflow:hidden;margin-bottom:10px;}
.dm-item{display:flex;align-items:center;gap:8px;padding:6px 10px;border-bottom:1px solid var(--rule-lt);}
.dm-item:last-child{border-bottom:none;}
.dm-flag{font-size:12px;}
.dm-name{font-family:'Nunito',sans-serif;font-size:11px;font-weight:600;color:var(--ink);}
.dm-year{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);margin-left:auto;}
/* CAPTIVITY STOPWATCH */
.captive-widget{background:linear-gradient(160deg,#1c0a0a,#2e1212);border:1px solid rgba(220,60,60,0.2);border-radius:12px;overflow:hidden;margin-bottom:14px;}
.cw-header{display:flex;align-items:center;gap:10px;padding:9px 16px;background:rgba(0,0,0,0.35);border-bottom:1px solid rgba(220,60,60,0.15);}
.cw-live{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.15em;color:#ff6060;animation:cw-blink 1.4s step-start infinite;}
@keyframes cw-blink{0%,100%{opacity:1;}50%{opacity:0.25;}}
.cw-header-label{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.13em;text-transform:uppercase;color:rgba(255,255,255,0.35);}
.cw-timer{display:flex;align-items:flex-end;justify-content:center;flex-wrap:wrap;gap:0;padding:22px 16px 16px;}
.cw-unit{display:flex;flex-direction:column;align-items:center;min-width:48px;}
.cw-num{font-family:'JetBrains Mono',monospace;font-size:34px;font-weight:600;color:white;line-height:1;letter-spacing:-0.02em;}
.cw-num.cw-accent{color:#ff7070;}
.cw-unit-lbl{font-family:'JetBrains Mono',monospace;font-size:5.5px;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-top:5px;}
.cw-colon{font-family:'JetBrains Mono',monospace;font-size:26px;color:rgba(255,255,255,0.12);padding:0 3px;margin-bottom:16px;line-height:1;}
.cw-divider{width:100%;height:1px;background:rgba(220,60,60,0.1);margin:0 16px 0;}
.cw-footer{padding:14px 16px;}
.cw-name{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:rgba(255,255,255,0.9);margin-bottom:5px;}
.cw-bio-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:rgba(255,255,255,0.45);line-height:1.7;}
.cw-since{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,100,100,0.5);margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,0.06);}

/* ── TERM TOOLTIPS / MODALS ── */
.term{border-bottom:1px dotted currentColor;cursor:help;position:relative;}
@media(hover:hover)and(pointer:fine){
  .term::after{content:attr(data-def);position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:#0e1a2e;color:rgba(255,255,255,0.92);font-family:'Source Serif 4',serif;font-size:11.5px;font-style:normal;font-weight:400;line-height:1.65;padding:10px 14px;border-radius:7px;border:1px solid rgba(184,134,11,0.3);max-width:280px;width:max-content;white-space:normal;pointer-events:none;opacity:0;transition:opacity 0.15s;z-index:500;box-shadow:0 4px 20px rgba(0,0,0,0.35);}
  .term:hover::after{opacity:1;}
}
#term-modal{position:fixed;inset:0;z-index:1000;display:flex;align-items:flex-end;}
.tm-backdrop{position:fixed;inset:0;background:rgba(0,0,0,0.55);}
.tm-box{position:relative;background:#fff;border-radius:14px 14px 0 0;padding:22px 20px 36px;width:100%;max-height:65vh;overflow-y:auto;box-shadow:0 -4px 32px rgba(0,0,0,0.25);}
.tm-title{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:#0e1a2e;margin-bottom:10px;}
.tm-def{font-family:'Source Serif 4',serif;font-size:14px;color:#4a5568;line-height:1.75;}
.tm-close{margin-top:18px;font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:8px 18px;border-radius:6px;border:1px solid rgba(27,58,107,0.2);background:transparent;color:#1b3a6b;cursor:pointer;display:block;}
</style>
</head>
<body>

<nav>
  <div class="nav-logo">FORA</div>
  <div class="nav-links">
    <span class="nav-link">Governance</span>
    <span class="nav-link active">World</span>
    <span class="nav-link">Knowledge</span>
    <span class="nav-link">Discourse</span>
  </div>
  <div class="nav-right"></div>
</nav>

<!-- TICKER -->
<div class="ticker-bar">
  <div class="ticker-badge"><span class="ticker-badge-text">Houthis · Active</span></div>
  <div class="ticker-scroll-wrap">
    <div class="ticker-track">
      <div class="ticker-item"><span class="t-key">Leader</span><span class="t-val tv-g">Abdul-Malik al-Houthi · Incumbent since 2004</span></div>
      <div class="ticker-item"><span class="t-key">2026 War</span><span class="t-val tv-a">Declared solidarity with Iran · "Hands on trigger"</span></div>
      <div class="ticker-item"><span class="t-key">Red Sea</span><span class="t-val tv-w">Attacks suspended Oct 2025 per Gaza ceasefire; resumed 2026</span></div>
      <div class="ticker-item"><span class="t-key">US Strikes</span><span class="t-val tv-r">US-UK airstrikes Jan 2024–Jan 2025 · US strikes Mar–May 2025</span></div>
      <div class="ticker-item"><span class="t-key">Territory</span><span class="t-val tv-w">Controls Sanaa + northwest Yemen · since 2014</span></div>
      <div class="ticker-item"><span class="t-key">Membership</span><span class="t-val tv-w">Est. 350,000 (2024)</span></div>
      <!-- dup -->
      <div class="ticker-item"><span class="t-key">Leader</span><span class="t-val tv-g">Abdul-Malik al-Houthi · Incumbent since 2004</span></div>
      <div class="ticker-item"><span class="t-key">2026 War</span><span class="t-val tv-a">Declared solidarity with Iran · "Hands on trigger"</span></div>
    </div>
  </div>
</div>

<!-- HERO -->
<div class="hero">
  <div class="breadcrumb">
    <span>FORA</span><span class="bc-sep">/</span>
    <span>World</span><span class="bc-sep">/</span>
    <span>Organizations</span><span class="bc-sep">/</span>
    <span class="bc-here">Houthis</span>
  </div>
  <div class="hero-inner">
    <div class="entity-identity">
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
        <div class="entity-icon-wrap"><img src="/flags/flag-houthi.png" alt="Houthi flag" style="width:100%;height:100%;object-fit:cover;display:block;"></div>
        <div>
          <div class="entity-name">Houthis</div>
          <div class="entity-name-local">أنصار الله — Ansar Allah · Partisans of God</div>
          <div class="entity-sub">Zaydi Shia Armed Movement · Yemen · Founded 1994 · Controls Sanaa since 2014</div>
        </div>
      </div>
      <div class="entity-tags">
        <span class="etag etag-fto">FTO · US · Saudi Arabia · UAE + others</span>
        <span class="etag etag-type">Armed Movement · De Facto Gov.</span>
        <span class="etag etag-active">● Active · Axis of Resistance</span>
        <span class="etag etag-grey">Iran-Sponsored</span>
        <span class="etag etag-grey">Red Sea Operations</span>
      </div>
      <div class="hero-stats">
        <div class="hs"><div class="hs-num">1994</div><div class="hs-label">Founded<br>Saada, Yemen</div></div>
        <div class="hs"><div class="hs-num">2014</div><div class="hs-label">Sanaa<br>Captured</div></div>
        <div class="hs"><div class="hs-num">350K</div><div class="hs-label">Est. Members<br>2024</div></div>
        <div class="hs"><div class="hs-num">32M</div><div class="hs-label">Population<br>Affected</div></div>
        <div class="hs"><div class="hs-num">10+</div><div class="hs-label">FTO<br>Designations</div></div>
      </div>
    </div>
    <div class="hero-actions">
      <button class="btn-p">Follow Houthis</button>
      <button class="btn-s">Add to Dashboard</button>
    </div>
  </div>
</div>

<!-- TABS -->
<div class="page-tabs">
  <div class="tabs-inner">
    <div class="tab active">Overview</div>
    <div class="tab">Leadership</div>
