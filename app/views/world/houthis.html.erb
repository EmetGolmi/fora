// Captivity stopwatch — Lev Marhabi, arrested March 2016
(function(){
  var start = new Date('2016-03-13T00:00:00');
  function tick(){
    var now = new Date();
    var yr = now.getFullYear() - start.getFullYear();
    var mo = now.getMonth() - start.getMonth();
    var dy = now.getDate() - start.getDate();
    if(dy < 0){ mo--; dy += new Date(now.getFullYear(), now.getMonth(), 0).getDate(); }
    if(mo < 0){ yr--; mo += 12; }
    document.getElementById('cw-years').textContent = yr;
    document.getElementById('cw-months').textContent = mo;
    document.getElementById('cw-days').textContent = String(dy).padStart(2,'0');
    document.getElementById('cw-hours').textContent = String(now.getHours()).padStart(2,'0');
    document.getElementById('cw-mins').textContent = String(now.getMinutes()).padStart(2,'0');
    document.getElementById('cw-secs').textContent = String(now.getSeconds()).padStart(2,'0');
  }
  tick();
  setInterval(tick, 1000);
})();
