<script>
function foraShare(btn){
  var card=btn.parentElement;
  var clone=card.cloneNode(true);
  clone.querySelectorAll('.share-btn').forEach(function(b){b.remove();});
  var text=(clone.innerText||clone.textContent).replace(/\s+/g,' ').trim().slice(0,600);
  var url=window.location.href;
  if(navigator.share){navigator.share({title:document.title,text:text,url:url}).catch(function(){});}
  else{navigator.clipboard&&navigator.clipboard.writeText(text+'\n\nFORA · '+document.title+'\n'+url).then(function(){btn.classList.add('copied');setTimeout(function(){btn.classList.remove('copied');},1800);}).catch(function(){});}
}

function switchTab(name, el) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.getElementById('panel-' + name).classList.add('active');
  el.classList.add('active');
}

// Category pill selection
document.querySelectorAll('.fc-cat').forEach(btn => {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.fc-cat').forEach(b => b.classList.remove('selected'));
    this.classList.add('selected');
  });
});
</script>
