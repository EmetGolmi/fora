<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --blue:#1b3a6b;--blue-lt:#2a5298;--blue-vp:rgba(27,58,107,0.04);--blue-pl:rgba(27,58,107,0.12);
  --gilt:#b8860b;--gilt-dk:#8b6914;--gilt-pl:#fdf8ed;--gilt-rul:rgba(184,134,11,0.2);
  --red:#8b1a1a;--red-lt:#c0392b;--red-p:rgba(139,26,26,0.06);--red-r:rgba(139,26,26,0.18);
  --amber:#c47f00;--amber-p:rgba(196,127,0,0.07);--amber-r:rgba(196,127,0,0.2);
  --green:#155c2d;--green-p:rgba(21,92,45,0.07);--green-r:rgba(21,92,45,0.2);
  --purple:#2d1a4a;--purple-lt:#f0eaf7;
  --ink:#0e1a2e;--ink-mid:#1e2d45;--ink-soft:#4a5568;--ink-mut:#7a8aaa;
  --bg:#f2f4f8;--white:#ffffff;
  --rule:rgba(27,58,107,0.1);--rule-lt:rgba(27,58,107,0.06);
  --teal:#0e6b5e;--teal-lt:#1a9b8a;--teal-p:rgba(14,107,94,0.07);--teal-r:rgba(14,107,94,0.22);
  --cub:#8b1a1a;
}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);line-height:1.5;}
a{text-decoration:none;color:inherit;}

/* ── NAV ── */
.nav{background:var(--blue);border-bottom:4px solid var(--gilt);padding:0 40px;height:60px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:200;}
.nav-logo{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:white;letter-spacing:0.04em;}
.nav-links{display:flex;gap:28px;align-items:center;}
.nav-link{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.5);cursor:pointer;}
.nav-link.active{color:white;}
.nav-btn{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:6px 14px;border-radius:100px;border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.7);cursor:pointer;background:transparent;}

/* ── TICKER ── */
.ticker-bar{height:30px;background:#0a0f1a;border-bottom:1px solid #1b3a6b;display:flex;align-items:center;overflow:hidden;}
.ticker-badge{flex-shrink:0;height:100%;padding:0 12px;display:flex;align-items:center;gap:6px;background:#7a0c0c;border-right:1px solid #c0392b;}
.ticker-badge-text{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.12em;text-transform:uppercase;color:white;white-space:nowrap;}
.ticker-scroll-wrap{flex:1;overflow:hidden;}
.ticker-track{display:flex;align-items:center;animation:ticker-scroll 34s linear infinite;white-space:nowrap;}
@keyframes ticker-scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
.ticker-item{display:inline-flex;align-items:center;gap:8px;padding:0 18px;height:30px;border-right:1px solid rgba(255,255,255,0.06);}
.t-key{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.35);}
.t-val{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;}
.tv-r{color:#ff8080;}.tv-w{color:rgba(255,255,255,0.85);}.tv-a{color:#FAC775;}.tv-g{color:#80ffaa;}

/* ── BREAKING BANNER ── */
.breaking-bar{background:linear-gradient(135deg,#1a0808,#4a0c0c);border-bottom:2px solid var(--red-lt);padding:9px 40px;display:flex;align-items:center;gap:12px;}
.bb-badge{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.16em;text-transform:uppercase;background:var(--red-lt);color:white;padding:3px 8px;border-radius:3px;flex-shrink:0;}
.bb-text{font-family:'Nunito',sans-serif;font-size:13px;color:white;line-height:1.4;flex:1;}
.bb-date{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:rgba(255,255,255,0.3);flex-shrink:0;}

/* ── HERO ── */
.hero{background:linear-gradient(160deg,#0e1a2e 0%,#1b3566 45%,#0a2040 100%);padding:32px 40px 28px;position:relative;overflow:hidden;}
.hero-inner{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;position:relative;}
.breadcrumb{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:14px;display:flex;align-items:center;gap:6px;}
.bc-sep{color:rgba(255,255,255,0.15);}.bc-here{color:rgba(255,255,255,0.6);}
.juris-identity{display:flex;align-items:center;gap:16px;margin-bottom:14px;}
.cuba-flag{display:flex;flex-direction:column;border-radius:6px;overflow:hidden;border:1px solid rgba(255,255,255,0.15);width:80px;flex-shrink:0;position:relative;}
.cf-s{height:15px;}.cf-blue{background:#002a8f;}.cf-white{background:#f5f5f5;}.cf-tri{position:absolute;left:0;top:0;width:0;height:0;border-top:37px solid transparent;border-bottom:37px solid transparent;border-left:33px solid #cc0000;}
.juris-name{font-family:'Playfair Display',serif;font-size:38px;font-weight:900;color:white;line-height:0.95;letter-spacing:-0.01em;}
.juris-sub-en{font-family:'Source Serif 4',serif;font-size:13px;font-style:italic;color:rgba(255,255,255,0.45);margin-top:4px;}
.juris-sub{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:6px;}
.juris-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}
.jtag{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 8px;border-radius:100px;border:1px solid;}
.jtag-type{color:rgba(184,134,11,0.9);border-color:rgba(184,134,11,0.3);background:rgba(184,134,11,0.1);}
.jtag-live{color:rgba(255,180,80,0.9);border-color:rgba(255,180,80,0.3);background:rgba(255,180,80,0.08);}
.jtag-grey{color:rgba(255,255,255,0.5);border-color:rgba(255,255,255,0.12);background:rgba(255,255,255,0.05);}
.jtag-teal{color:rgba(128,255,230,0.8);border-color:rgba(128,255,230,0.2);background:rgba(128,255,230,0.06);}
.hero-stats{display:grid;grid-template-columns:repeat(6,1fr);gap:1px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);border-radius:10px;overflow:hidden;margin-top:18px;}
.hs{background:rgba(255,255,255,0.03);padding:11px 14px;cursor:pointer;transition:background 0.12s;}
.hs:hover{background:rgba(255,255,255,0.09);}
.hs-num{font-family:'Libre Baskerville',serif;font-size:19px;font-weight:700;color:white;}
.hs-label{font-family:'JetBrains Mono',monospace;font-size:6px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.27);margin-top:3px;line-height:1.5;}
.hero-right{display:flex;flex-direction:column;gap:8px;min-width:180px;flex-shrink:0;}
.btn-primary{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:none;cursor:pointer;background:var(--gilt);color:white;}
.btn-secondary{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(255,255,255,0.2);cursor:pointer;background:transparent;color:rgba(255,255,255,0.7);}
.btn-teal{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(14,107,94,0.5);cursor:pointer;background:rgba(14,107,94,0.15);color:rgba(128,255,230,0.85);}

/* ── TABS ── */
.org-tabs{background:var(--white);border-bottom:1px solid var(--rule);position:sticky;top:60px;z-index:100;}
.tabs-inner{display:flex;align-items:center;padding:0 40px;overflow-x:auto;}
.tab{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:14px 15px;cursor:pointer;color:var(--ink-mut);border-bottom:2px solid transparent;white-space:nowrap;transition:color 0.12s;}
.tab:hover{color:var(--blue);}
.tab.active{color:var(--blue);border-bottom-color:var(--blue);font-weight:600;}
.tab.t-forum{color:var(--teal);}
.tab.t-forum:hover,.tab.t-forum.active{color:var(--teal);border-bottom-color:var(--teal);}
.tab[title]{position:relative;}
.tab[title]:hover::after{content:attr(title);position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:var(--ink);color:rgba(255,255,255,0.9);font-family:'Source Serif 4',serif;font-size:11px;font-style:italic;white-space:nowrap;padding:5px 10px;border-radius:4px;pointer-events:none;z-index:300;box-shadow:0 2px 8px rgba(0,0,0,0.25);}

/* ── BODY LAYOUT ── */
.juris-body{display:grid;grid-template-columns:1fr 280px;gap:0;max-width:1400px;margin:0 auto;padding:0 40px 60px;align-items:start;}
.juris-main{padding:32px 32px 0 0;min-width:0;}
.juris-sidebar{padding:32px 0 0;border-left:1px solid var(--rule);padding-left:24px;}

/* Tab panels */
.tab-panel{display:none;}
.tab-panel.active{display:block;}

/* ── SHARED SECTION STYLES ── */
.sec{margin-bottom:36px;}
.sec+.sec{padding-top:28px;border-top:1.5px solid rgba(14,26,46,0.1);}
.nh-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt-dk);margin-bottom:5px;}
.nh-headline{font-family:'Playfair Display',serif;font-size:24px;font-weight:900;color:#0e0c08;line-height:1.1;margin-bottom:8px;}
.nh-lead{font-family:'Source Serif 4',serif;font-size:13.5px;color:#5a5448;line-height:1.75;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--rule);}

/* Context split */
.context-box{border-radius:10px;overflow:hidden;border:1px solid var(--rule);margin-bottom:16px;}
.cb-header{background:var(--ink);padding:10px 16px;font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.55);}
.cb-split{display:grid;grid-template-columns:1fr 1fr;}
.cb-col{padding:14px 16px;border-top:3px solid transparent;}
.cb-col.embargo{border-top-color:var(--red-lt);}
.cb-col.gov{border-top-color:var(--purple);}
.cb-col-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:6px;}
.cb-col-title{font-family:'Libre Baskerville',serif;font-size:13.5px;font-weight:700;color:var(--ink);margin-bottom:6px;}
.cb-col-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-soft);line-height:1.7;}
.cb-divider{width:1px;background:var(--rule);}

/* Quote */
.quote-card{background:var(--gilt-pl);border:1px solid var(--gilt-rul);border-left:4px solid var(--gilt);border-radius:8px;padding:13px 16px;margin-bottom:12px;}
.qc-text{font-family:'Source Serif 4',serif;font-size:13px;font-style:italic;color:var(--ink-mid);line-height:1.7;margin-bottom:6px;}
.qc-attr{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);}

/* Info card */
.info-card{background:var(--blue-vp);border:1px solid var(--blue-pl);border-radius:8px;padding:10px 13px;margin-bottom:10px;}
.ic-label{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:3px;}
.ic-val{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink);line-height:1.6;}

/* Note card */
.note-card{background:var(--amber-p);border:1px solid var(--amber-r);border-radius:8px;padding:10px 14px;display:flex;gap:10px;align-items:flex-start;margin-bottom:12px;}
.nc-icon{font-size:14px;flex-shrink:0;}
.nc-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-mid);line-height:1.65;}

/* ── GOVT TAB ── */
.auth-table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid var(--rule);}
.auth-table thead tr{background:var(--blue);}
.auth-table th{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.45);padding:9px 14px;text-align:left;font-weight:400;}
.auth-table td{padding:10px 14px;border-bottom:1px solid var(--rule-lt);vertical-align:top;}
.auth-table tr:last-child td{border-bottom:none;}
.auth-table tr:hover td{background:var(--bg);}
.at-office{font-family:'Libre Baskerville',serif;font-size:12.5px;font-weight:700;color:var(--blue);margin-bottom:3px;}
.at-badge{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.08em;text-transform:uppercase;padding:1px 6px;border-radius:3px;display:inline-block;}
.ab-party{color:var(--red);background:var(--red-p);border:1px solid var(--red-r);}
.ab-unelect{color:var(--gilt-dk);background:var(--gilt-pl);border:1px solid var(--gilt-rul);}
.at-holder{font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;color:var(--ink);margin-bottom:1px;}
.at-meta{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);}
.at-note{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);}

.rubber-stamp{background:var(--blue-vp);border:1px solid var(--blue-pl);border-radius:8px;padding:10px 14px;font-family:'Source Serif 4',serif;font-size:12px;color:var(--ink-soft);line-height:1.65;margin-top:12px;}

/* ── LEGISLATION ── */
.leg-row{background:var(--white);border:1px solid var(--rule);border-radius:8px;padding:13px 16px;margin-bottom:8px;display:flex;gap:14px;align-items:flex-start;cursor:pointer;transition:box-shadow 0.12s;}
.leg-row:hover{box-shadow:0 2px 10px rgba(27,58,107,0.08);}
.leg-year{font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--gilt);flex-shrink:0;width:32px;margin-top:2px;}
.leg-content{flex:1;}
.leg-title{font-family:'Libre Baskerville',serif;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:3px;line-height:1.35;}
.leg-desc{font-family:'Nunito',sans-serif;font-size:11.5px;color:var(--ink-soft);line-height:1.5;margin-bottom:5px;}
.leg-badges{display:flex;gap:6px;flex-wrap:wrap;}
.lb{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.07em;text-transform:uppercase;padding:1px 6px;border-radius:3px;border:1px solid;}
.lb-pass{color:var(--red);background:var(--red-p);border-color:var(--red-r);}
.lb-unan{color:var(--ink-mut);background:var(--bg);border-color:var(--rule);}
.lb-civil{color:var(--blue);background:var(--blue-vp);border-color:var(--blue-pl);}
.lb-econ{color:var(--green);background:var(--green-p);border-color:var(--green-r);}
.lb-media{color:var(--purple);background:var(--purple-lt);border-color:rgba(45,26,74,0.2);}
.leg-vote{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--ink-mut);flex-shrink:0;margin-top:2px;text-align:right;}
.leg-engage{display:flex;gap:6px;margin-top:8px;}
.le-btn{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 10px;border-radius:100px;cursor:pointer;border:1px solid var(--rule);background:transparent;color:var(--ink-mut);}
.le-btn:hover{background:var(--bg);}
.le-btn.concur{color:var(--green);border-color:var(--green-r);}
.le-btn.object{color:var(--red);border-color:var(--red-r);}

/* ── CRISIS TAB ── */
.crisis-timeline{position:relative;padding-left:24px;}
.crisis-timeline::before{content:'';position:absolute;left:7px;top:4px;bottom:4px;width:2px;background:var(--rule);}
.ct-item{position:relative;margin-bottom:20px;}
.ct-dot{position:absolute;left:-20px;top:3px;width:10px;height:10px;border-radius:50%;background:var(--blue);border:2px solid var(--white);flex-shrink:0;}
.ct-dot.red{background:var(--red);}
.ct-dot.amber{background:var(--amber);}
.ct-dot.green{background:var(--green);}
.ct-date{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:3px;}
.ct-title{font-family:'Libre Baskerville',serif;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:4px;line-height:1.35;}
.ct-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-soft);line-height:1.65;}

/* ── FOREIGN AFFAIRS TAB ── */
.partner-row{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:14px 16px;display:flex;gap:14px;margin-bottom:10px;}
.pr-flag{font-size:24px;flex-shrink:0;}
.pr-content{flex:1;}
.pr-name{font-family:'Libre Baskerville',serif;font-size:13.5px;font-weight:700;color:var(--ink);margin-bottom:3px;}
.pr-role-badge{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:1px 7px;border-radius:3px;border:1px solid;display:inline-block;margin-bottom:6px;}
.rb-ally{color:var(--green);background:var(--green-p);border-color:var(--green-r);}
.rb-main{color:var(--blue);background:var(--blue-vp);border-color:var(--blue-pl);}
.rb-embargo{color:var(--red);background:var(--red-p);border-color:var(--red-r);}
.rb-complex{color:var(--amber);background:var(--amber-p);border-color:var(--amber-r);}
.pr-text{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);line-height:1.6;}
.pr-stats{display:flex;gap:12px;margin-top:8px;flex-wrap:wrap;}
.pr-stat{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);}
.pr-stat strong{color:var(--ink);}

/* ── DOCTRINE TAB ── */
.doctrine-card{background:var(--gilt-pl);border:1px solid var(--gilt-rul);border-radius:10px;padding:16px 20px;margin-bottom:14px;}
.dc-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gilt-dk);margin-bottom:5px;}
.dc-title{font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:#0e0c08;margin-bottom:8px;}
.dc-text{font-family:'Source Serif 4',serif;font-size:13px;color:#5a5448;line-height:1.7;}
.hist-item{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--rule-lt);}
.hist-item:last-child{border-bottom:none;}
.hi-year{font-family:'Playfair Display',serif;font-size:18px;font-weight:900;color:var(--gilt);flex-shrink:0;width:44px;line-height:1;}
.hi-content{flex:1;}
.hi-title{font-family:'Libre Baskerville',serif;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:3px;}
.hi-text{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);line-height:1.55;}

/* ── FORUM TAB ── */
.forum-hero{background:linear-gradient(160deg,#0e1a2e,#0a3322);border-radius:12px;padding:22px 26px;margin-bottom:20px;}
.fh-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:6px;}
.fh-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:900;color:white;line-height:1.1;margin-bottom:8px;}
.fh-text{font-family:'Source Serif 4',serif;font-size:13px;color:rgba(255,255,255,0.6);line-height:1.7;margin-bottom:16px;}
.voice-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:16px;}
.voice-card{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:11px 13px;}
.vc-icon{font-size:16px;margin-bottom:5px;}
.vc-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:3px;}
.vc-desc{font-family:'Nunito',sans-serif;font-size:11.5px;color:rgba(255,255,255,0.65);line-height:1.5;}
.forum-compose{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:18px 20px;margin-bottom:16px;}
.fc-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:10px;}
.fc-categories{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;}
.fc-cat{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 10px;border-radius:100px;border:1px solid var(--rule);background:transparent;color:var(--ink-mut);cursor:pointer;transition:all 0.12s;}
