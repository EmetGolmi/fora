<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORA · Hamas · NGE</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg:      #f2f4f8;
  --bg2:     #e8ebf2;
  --white:   #ffffff;
  --blue:    #1b3a6b;
  --blue-lt: #3a6abf;
  --blue-pl: #dde5f5;
  --blue-vp: #edf1fb;
  --gilt:    #b8860b;
  --gilt-lt: #d4a832;
  --gilt-pl: #f8f0dc;
  --gilt-rul:rgba(184,134,11,0.22);
  --ink:     #0e1a2e;
  --ink-soft:#5a6e8a;
  --ink-mut: #8a9ab8;
  --rule:    rgba(27,58,107,0.1);
  --rule-lt: rgba(27,58,107,0.05);
  --green:   #155c2d;
  --green-p: #e5f0e8;
  --green-r: #8cc4a0;
  --red:     #8b2020;
  --red-p:   #f7eaea;
  --red-r:   #d4a0a0;
  --amber:   #c47f00;
  --amber-p: #fdf3dc;
  --amber-r: rgba(196,127,0,0.28);
  --terra:   #8b3a20;

  /* NGE colors */
  --nge:     #2d1a4a;   /* deep midnight purple for militant entities */
  --nge-p:   #f0eaf8;
  --nge-r:   rgba(45,26,74,0.25);
  --nge-lt:  #6b4a9b;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);}
::-webkit-scrollbar{width:5px;}
::-webkit-scrollbar-thumb{background:var(--gilt-rul);border-radius:10px;}

/* ══ NAV ══ */
nav{background:var(--blue);padding:0 48px;display:flex;align-items:center;height:60px;border-bottom:4px solid var(--gilt);position:sticky;top:0;z-index:200;}
.nav-logo{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:white;letter-spacing:0.1em;margin-right:24px;}
.nav-logo span{color:var(--gilt-lt);}
.nav-links{display:flex;gap:6px;}
.nav-link{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.38);padding:6px 14px;border-radius:100px;cursor:pointer;transition:all 0.15s;}
.nav-link.active{color:white;background:rgba(255,255,255,0.1);}
.nav-right{margin-left:auto;}
.nav-avatar{width:32px;height:32px;border-radius:50%;background:var(--gilt-pl);border:2px solid var(--gilt-rul);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gilt);font-weight:700;}

/* ══ HERO ══ */

/* ── TICKER ── */
.ticker-bar{height:30px;background:#0a0f1a;border-bottom:1px solid #1b3a6b;display:flex;align-items:center;overflow:hidden;}
.ticker-badge{flex-shrink:0;height:100%;padding:0 12px;display:flex;align-items:center;gap:6px;border-right:1px solid;}
.ticker-badge.crisis{background:#7a1212;border-right-color:#c0392b;}
.ticker-badge.active{background:#1b3a6b;border-right-color:#2a5298;}
.ticker-badge-text{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.12em;text-transform:uppercase;color:white;white-space:nowrap;}
.ticker-scroll-wrap{flex:1;overflow:hidden;}
.ticker-track{display:flex;align-items:center;animation:ticker-scroll 22s linear infinite;white-space:nowrap;}
@keyframes ticker-scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
.ticker-item{display:inline-flex;align-items:center;gap:8px;padding:0 18px;height:30px;border-right:1px solid rgba(255,255,255,0.06);}
.ticker-key{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.35);}
.ticker-val{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:500;}
.ticker-val.tv-red{color:#ff8080;}
.ticker-val.tv-white{color:rgba(255,255,255,0.85);}
.ticker-val.tv-amber{color:#FAC775;}
.ticker-val.tv-green{color:#C0DD97;}
/* ── QUIET TICKER ── */
.quiet-ticker{height:26px;background:#0e1a2e;border-bottom:1px solid rgba(27,58,107,0.4);display:flex;align-items:center;padding:0 24px;gap:18px;}
.qt-item{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.3);}
.qt-item span{color:rgba(255,255,255,0.65);}



.hero{background:var(--nge);padding:40px 48px 50px;position:relative;overflow:hidden;}
.hero::after{content:'★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★';position:absolute;bottom:0;left:0;right:0;height:26px;overflow:hidden;white-space:nowrap;display:flex;align-items:center;padding:0 48px;font-size:11px;letter-spacing:0.55em;color:var(--gilt);-webkit-mask-image:linear-gradient(to right,black 90%,transparent 100%);mask-image:linear-gradient(to right,black 90%,transparent 100%);}
.hero-ring{position:absolute;right:-80px;top:-100px;width:500px;height:500px;border-radius:50%;border:50px solid rgba(255,255,255,0.015);pointer-events:none;}

.hero-bc{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-bottom:16px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.hero-bc a{color:rgba(255,255,255,0.25);cursor:pointer;}
.hero-bc a:hover{color:rgba(255,255,255,0.6);}
.hero-bc-sep{opacity:0.2;}
.hero-bc-here{color:var(--gilt-lt);}

.hero-inner{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:start;}
.hero-left{}

.entity-eyebrow{display:flex;align-items:center;gap:8px;margin-bottom:10px;}
.entity-class{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.3);border:1px solid rgba(255,255,255,0.12);padding:3px 10px;border-radius:3px;}
.entity-status-chip{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;padding:3px 10px;border-radius:3px;}
.status-degraded{background:rgba(196,127,0,0.2);color:#fcd34d;border:1px solid rgba(196,127,0,0.35);}
.status-active{background:rgba(139,32,32,0.25);color:#fca5a5;border:1px solid rgba(139,32,32,0.4);}

.entity-endonym{font-family:'Libre Baskerville',serif;font-size:13px;font-style:italic;color:rgba(255,255,255,0.3);margin-bottom:4px;}
.entity-name{font-family:'Libre Baskerville',serif;font-size:40px;font-weight:700;color:white;line-height:1.0;margin-bottom:6px;}
.entity-aliases{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.2);margin-bottom:16px;}

.entity-summary{font-family:'Nunito',sans-serif;font-size:14px;font-weight:300;color:rgba(255,255,255,0.55);line-height:1.75;max-width:660px;margin-bottom:18px;}
.entity-summary .term{border-bottom:1px dashed rgba(184,134,11,0.4);cursor:pointer;color:rgba(255,255,255,0.75);transition:color 0.1s;}
.entity-summary .term:hover{color:var(--gilt-lt);}

.hero-meta{display:flex;gap:24px;flex-wrap:wrap;margin-bottom:18px;}
.hm{display:flex;flex-direction:column;gap:2px;}
.hm-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.2);}
.hm-val{font-family:'Nunito',sans-serif;font-size:13px;color:rgba(255,255,255,0.7);font-weight:600;}

.power-basis-row{display:flex;gap:6px;flex-wrap:wrap;}
.pb-chip{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;padding:4px 10px;border-radius:100px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.45);}

.hero-right{display:flex;flex-direction:column;gap:0;}
.hero-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);border-radius:10px;overflow:hidden;}
.hs{background:rgba(255,255,255,0.03);padding:12px 14px;}
.hs-num{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:white;}
.hs-label{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-top:3px;}

/* ══ TABS ══ */
.entity-tabs{background:var(--white);border-bottom:1px solid var(--rule);position:sticky;top:60px;z-index:100;}
.tabs-inner{display:flex;padding:0 48px;overflow-x:auto;}
.etab{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.12em;text-transform:uppercase;padding:14px 18px;color:var(--ink-mut);border-bottom:3px solid transparent;cursor:pointer;white-space:nowrap;transition:all 0.15s;}
.etab.active{color:var(--blue);border-bottom-color:var(--gilt);font-weight:700;}
.etab:hover{color:var(--blue);}

/* ══ BODY ══ */
.page-body{display:grid;grid-template-columns:1fr 320px;max-width:1280px;margin:0 auto;}
.page-main{padding:32px 48px;border-right:1px solid var(--rule);}
.page-sidebar{padding:28px 24px;background:var(--white);}

/* shared */
.sec-ey{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt);margin-bottom:4px;display:flex;align-items:center;gap:6px;}
.sec-ey::before{content:'◆';font-size:6px;}
.sec-title{font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;color:var(--blue);margin-bottom:16px;}
.sec-block{margin-bottom:40px;}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--rule);}
.sec-link{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:var(--blue-lt);cursor:pointer;}

/* ══ POWER STRUCTURE ══ */
.power-structure{background:var(--white);border:1px solid var(--rule);border-radius:12px;overflow:hidden;margin-bottom:16px;}
.ps-header{background:var(--nge);padding:14px 18px;}
.psh-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:3px;}
.psh-title{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:white;}
.psh-note{font-family:'Nunito',sans-serif;font-size:11.5px;color:rgba(255,255,255,0.35);margin-top:3px;}
.ps-body{padding:16px 18px;}
.ps-tier{margin-bottom:16px;}
.ps-tier-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.ps-tier-label::before{content:'';display:inline-block;width:20px;height:1px;background:var(--rule);}
.ps-tier-label::after{content:'';flex:1;height:1px;background:var(--rule);}
.ps-tier-items{display:flex;gap:8px;flex-wrap:wrap;}
.ps-person{background:var(--bg);border:1px solid var(--rule);border-radius:8px;padding:10px 12px;min-width:160px;}
.pp-name{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:var(--blue);margin-bottom:2px;}
.pp-role{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-mut);}
.pp-status{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 6px;border-radius:3px;margin-top:5px;display:inline-block;}
.st-active{background:var(--green-p);color:var(--green);border:1px solid var(--green-r);}
.st-dead{background:var(--red-p);color:var(--red);border:1px solid var(--red-r);}
.st-unknown{background:var(--bg2);color:var(--ink-mut);border:1px solid var(--rule);}
.st-new{background:var(--amber-p);color:var(--amber);border:1px solid var(--amber-r);}
.ps-council{background:var(--bg);border:1px solid var(--rule);border-radius:8px;padding:10px 12px;flex:1;}
.pc-title{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:var(--blue);margin-bottom:4px;}
.pc-note{font-family:'Nunito',sans-serif;font-size:11.5px;color:var(--ink-soft);line-height:1.55;}
.ps-restructure-note{background:var(--amber-p);border:1px solid var(--amber-r);border-radius:8px;padding:11px 14px;margin-top:12px;}
.prn-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--amber);margin-bottom:4px;}
.prn-text{font-family:'Nunito',sans-serif;font-size:12.5px;color:var(--ink);line-height:1.55;}

/* ══ TIMELINE ══ */
.timeline{position:relative;padding-left:24px;}
.timeline::before{content:'';position:absolute;left:5px;top:0;bottom:0;width:1px;background:linear-gradient(to bottom,var(--gilt-rul),var(--rule),transparent);}
.tl-decade{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.18em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:10px;margin-top:20px;position:relative;}
.tl-decade::before{content:'';position:absolute;left:-22px;top:50%;transform:translateY(-50%);width:7px;height:1px;background:var(--gilt-rul);}
.tl-item{position:relative;margin-bottom:10px;}
.tl-dot{position:absolute;left:-21px;top:8px;width:9px;height:9px;border-radius:50%;border:2px solid;flex-shrink:0;}
.dot-found{background:var(--nge-p);border-color:var(--nge-lt);}
.dot-attack{background:var(--red-p);border-color:var(--red);}
.dot-war{background:rgba(139,32,32,0.15);border-color:var(--red);}
.dot-political{background:var(--blue-vp);border-color:var(--blue-lt);}
.dot-milestone{background:var(--gilt-pl);border-color:var(--gilt);}
.dot-degraded{background:var(--amber-p);border-color:var(--amber);}
.tl-card{background:var(--white);border:1px solid var(--rule);border-radius:8px;padding:11px 13px;transition:box-shadow 0.12s;cursor:pointer;}
.tl-card:hover{box-shadow:0 3px 12px rgba(27,58,107,0.07);}
.tl-top{display:flex;align-items:flex-start;gap:8px;margin-bottom:5px;}
.tl-year{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--blue);flex-shrink:0;min-width:36px;}
.tl-type{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:3px;flex-shrink:0;margin-top:1px;}
.tt-found{background:var(--nge-p);color:var(--nge-lt);border:1px solid var(--nge-r);}
.tt-attack{background:var(--red-p);color:var(--red);border:1px solid var(--red-r);}
.tt-war{background:rgba(139,32,32,0.08);color:var(--red);border:1px solid rgba(139,32,32,0.2);}
.tt-political{background:var(--blue-vp);color:var(--blue-lt);border:1px solid var(--blue-pl);}
.tt-milestone{background:var(--gilt-pl);color:var(--gilt);border:1px solid var(--gilt-rul);}
.tt-degraded{background:var(--amber-p);color:var(--amber);border:1px solid var(--amber-r);}
.tl-title{font-family:'Nunito',sans-serif;font-size:13.5px;font-weight:700;color:var(--ink);flex:1;line-height:1.3;}
.tl-body{font-family:'Nunito',sans-serif;font-size:12.5px;color:var(--ink-soft);line-height:1.6;}
.tl-body .term{border-bottom:1px dashed var(--gilt-rul);cursor:pointer;}
.tl-deaths{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--red);margin-top:4px;}

/* ══ IRAN CONNECTION ══ */
.relationship-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;overflow:hidden;margin-bottom:10px;}
.rc-header{display:flex;align-items:center;gap:12px;padding:13px 16px;border-bottom:1px solid var(--rule-lt);}
.rc-flag{font-size:22px;}
.rc-entity{flex:1;}
.rc-name{font-family:'Nunito',sans-serif;font-size:14px;font-weight:700;color:var(--blue);}
.rc-type{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);margin-top:2px;}
.rc-strength{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 8px;border-radius:3px;}
.rc-confirmed{background:var(--green-p);color:var(--green);border:1px solid var(--green-r);}
.rc-assessed{background:var(--amber-p);color:var(--amber);border:1px solid var(--amber-r);}
.rc-alleged{background:var(--bg2);color:var(--ink-soft);border:1px solid var(--rule);}
.rc-body{padding:12px 16px;}
.rc-rel-type{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--nge-lt);margin-bottom:6px;}
.rc-desc{font-family:'Nunito',sans-serif;font-size:12.5px;color:var(--ink-soft);line-height:1.6;}
.rc-desc .term{border-bottom:1px dashed var(--gilt-rul);cursor:pointer;color:var(--ink);}
.rc-facts{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.rc-fact{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.06em;padding:3px 8px;border-radius:3px;background:var(--bg);border:1px solid var(--rule);color:var(--ink-soft);}
.rc-claimed{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);margin-top:8px;}

/* ══ DESIGNATIONS ══ */
.designation-table{width:100%;border-collapse:collapse;}
.dt-head th{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-mut);padding:0 10px 8px 0;text-align:left;border-bottom:1px solid var(--rule);font-weight:400;}
.designation-table td{padding:10px 10px 10px 0;border-bottom:1px solid var(--rule-lt);vertical-align:middle;}
.designation-table tr:last-child td{border-bottom:none;}
.dd-country{font-family:'JetBrains Mono',monospace;font-size:8.5px;color:var(--ink);white-space:nowrap;}
.dd-type{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.06em;text-transform:uppercase;padding:2px 7px;border-radius:3px;white-space:nowrap;}
.dt-fto{background:var(--red-p);color:var(--red);border:1px solid var(--red-r);}
.dt-sanc{background:var(--amber-p);color:var(--amber);border:1px solid var(--amber-r);}
.dt-prosc{background:var(--nge-p);color:var(--nge-lt);border:1px solid var(--nge-r);}
.dd-scope{font-family:'Nunito',sans-serif;font-size:11.5px;color:var(--ink-soft);}
.dd-year{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--ink-mut);white-space:nowrap;}

/* ══ DOCUMENTS ══ */
.doc-row{display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid var(--rule-lt);}
.doc-row:last-child{border-bottom:none;}
.doc-icon{width:34px;height:34px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
.doc-body{flex:1;}
.doc-name{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:var(--blue);margin-bottom:2px;}
.doc-meta{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);}
.doc-arrow{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-mut);cursor:pointer;}

/* ══ SIDEBAR ══ */
.sb-block{margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--rule);}
.sb-block:last-child{border-bottom:none;}
.sb-ey{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.16em;text-transform:uppercase;color:var(--gilt);margin-bottom:8px;display:flex;align-items:center;gap:5px;}
.sb-ey::before{content:'◆';font-size:5.5px;}
.sb-title{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:var(--blue);margin-bottom:12px;}
.sb-note{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);line-height:1.6;margin-bottom:10px;}

/* connected events */
.event-row{display:flex;gap:8px;align-items:flex-start;padding:7px 0;border-bottom:1px solid var(--rule-lt);}
.event-row:last-child{border-bottom:none;}
.er-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.er-body{flex:1;}
.er-title{font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;color:var(--blue);line-height:1.3;}
.er-meta{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);margin-top:1px;}

/* connected issues */
.issue-pill{display:flex;align-items:center;gap:8px;padding:7px 11px;border-radius:8px;background:var(--bg);border:1px solid var(--rule);cursor:pointer;transition:all 0.12s;margin-bottom:6px;}
.issue-pill:hover{background:var(--gilt-pl);border-color:var(--gilt-rul);}
.ip-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;}
.ip-text{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink);}

/* def modal */
.def-modal{display:none;position:fixed;inset:0;background:rgba(10,18,32,0.75);z-index:600;align-items:center;justify-content:center;}
.def-modal.open{display:flex;}
.def-panel{background:var(--white);border-radius:14px;padding:28px;max-width:440px;width:90%;position:relative;}
.def-close{position:absolute;top:14px;right:18px;font-size:20px;color:var(--ink-mut);cursor:pointer;}
.def-ey{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gilt);margin-bottom:5px;}
.def-title{font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;color:var(--blue);margin-bottom:10px;}
.def-body{font-family:'Nunito',sans-serif;font-size:13px;color:var(--ink);line-height:1.7;margin-bottom:12px;}
.def-ex{background:var(--bg);border-radius:8px;padding:11px 13px;border-left:3px solid var(--gilt);}
.def-ex-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:4px;}
.def-ex-text{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);line-height:1.55;}
.term{border-bottom:1px dashed var(--gilt-rul);cursor:pointer;transition:color 0.1s;}
.term:hover{color:var(--gilt);}

/* ══ FLAG & MEDIA ══ */
.hero-flag{position:absolute;right:48px;top:40px;opacity:0.18;pointer-events:none;}
.flag-block{display:flex;align-items:center;gap:16px;margin-bottom:20px;}
.flag-img{width:120px;height:auto;border-radius:4px;border:1px solid rgba(255,255,255,0.1);}
.flag-caption{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);line-height:1.6;}
.flag-caption strong{color:rgba(255,255,255,0.5);display:block;margin-bottom:2px;}
.photo-grid-nge{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px;}
.pg-item{border-radius:8px;overflow:hidden;background:var(--bg2);border:1px solid var(--rule);position:relative;aspect-ratio:16/9;cursor:pointer;transition:box-shadow 0.12s;}
.pg-item:hover{box-shadow:0 4px 14px rgba(27,58,107,0.1);}
.pg-item img{width:100%;height:100%;object-fit:cover;display:block;}
.pg-caption{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(14,26,46,0.88));padding:16px 10px 7px;font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.07em;color:rgba(255,255,255,0.75);}
.pg-placeholder{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;background:var(--bg2);}
.pg-pl-icon{font-size:22px;opacity:0.3;}
.pg-pl-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);text-align:center;padding:0 8px;line-height:1.4;}
/* NGE person profile */
.nge-profile-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:14px 16px;display:flex;gap:14px;margin-bottom:10px;cursor:pointer;transition:box-shadow 0.12s;}
.nge-profile-card:hover{box-shadow:0 4px 14px rgba(27,58,107,0.08);}
.npc-avatar{width:52px;height:52px;border-radius:50%;background:var(--nge-p);border:2px solid var(--nge-r);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--nge-lt);flex-shrink:0;position:relative;}
.npc-org-badge{position:absolute;bottom:-3px;right:-3px;background:var(--nge);border-radius:50%;width:18px;height:18px;display:flex;align-items:center;justify-content:center;border:2px solid var(--white);font-size:8px;}
.npc-body{flex:1;}
.npc-name-row{display:flex;align-items:center;gap:8px;margin-bottom:2px;}
.npc-name{font-family:'Nunito',sans-serif;font-size:14px;font-weight:700;color:var(--ink);}
.npc-org-chip{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:3px;background:var(--nge-p);color:var(--nge-lt);border:1px solid var(--nge-r);}
.npc-role{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:5px;}
.npc-desc{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);line-height:1.55;}
.npc-statement{background:var(--bg);border-left:2px solid var(--nge-r);padding:8px 10px;margin-top:8px;border-radius:0 6px 6px 0;}
.nps-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--nge-lt);margin-bottom:3px;}
.nps-text{font-family:'Libre Baskerville',serif;font-size:12px;font-style:italic;color:var(--ink-soft);line-height:1.55;}
.npc-fora-note{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);margin-top:8px;padding:5px 8px;background:var(--blue-vp);border-radius:4px;display:inline-block;}

.btn-primary{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:none;cursor:pointer;background:var(--gilt);color:white;transition:all 0.12s;}
.btn-secondary{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(255,255,255,0.2);cursor:pointer;background:transparent;color:rgba(255,255,255,0.7);transition:all 0.12s;}
.btn-red{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(255,100,100,0.3);cursor:pointer;background:rgba(255,100,100,0.08);color:rgba(255,150,150,0.9);transition:all 0.12s;}

/* ── TAB SECTIONS ── */
.tab-section{padding:32px 40px;border-bottom:1px solid rgba(255,255,255,0.06);}
.tab-section:last-child{border-bottom:none;}
.ts-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:var(--gilt);margin-bottom:8px;}
.ts-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;color:white;margin-bottom:14px;line-height:1.3;}
.ts-body{font-size:13.5px;color:rgba(255,255,255,0.65);line-height:1.85;max-width:780px;}

/* ── LEADER CARDS ── */
.leader-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px;margin-top:16px;}
.leader-card{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:16px;display:flex;gap:14px;align-items:flex-start;}
.leader-avatar{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:rgba(255,255,255,0.7);flex-shrink:0;border:2px solid rgba(255,255,255,0.12);}
.leader-name{font-family:'Libre Baskerville',serif;font-size:15px;font-weight:700;color:white;margin-bottom:2px;}
.leader-role{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:6px;}
.leader-status{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.08em;padding:2px 8px;border-radius:3px;display:inline-block;margin-bottom:8px;}
.leader-status.active{background:rgba(21,92,45,0.3);color:#9FE1CB;border:1px solid rgba(21,92,45,0.4);}
.leader-status.deceased{background:rgba(139,26,26,0.3);color:#ffaaaa;border:1px solid rgba(139,26,26,0.4);}
.leader-note{font-size:12px;color:rgba(255,255,255,0.5);line-height:1.6;}

/* ── INFO CARDS ── */
.info-card{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:16px;}
.ic-title{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:var(--gilt-lt);margin-bottom:8px;}
.ic-body{font-size:12.5px;color:rgba(255,255,255,0.6);line-height:1.7;}

/* ── RELATIONSHIP CARDS ── */
.rel-card{background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;overflow:hidden;}
.rc-header{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.1em;text-transform:uppercase;color:white;padding:8px 14px;}
.rc-body{font-size:12.5px;color:rgba(255,255,255,0.6);padding:12px 14px;line-height:1.7;}
.rc-status{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.08em;padding:6px 14px;border-top:1px solid rgba(255,255,255,0.06);}

/* ── TIMELINE ── */
.timeline{display:flex;flex-direction:column;gap:0;margin-top:16px;}
.tl-item{display:grid;grid-template-columns:16px 1fr;gap:16px;padding:0 0 20px;}
.tl-dot{width:14px;height:14px;border-radius:50%;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.2);flex-shrink:0;margin-top:3px;}
.tl-dot.active{background:var(--gilt);border-color:var(--gilt-lt);}
.tl-content{}
.tl-date{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--gilt);margin-bottom:4px;}
.tl-event{font-size:13px;color:rgba(255,255,255,0.65);line-height:1.7;}

/* ── FACTS TABLE ── */
.facts-table{width:100%;border-collapse:collapse;margin-top:12px;}
.facts-table th{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.4);background:rgba(255,255,255,0.06);padding:8px 12px;text-align:left;}
.facts-table td{padding:10px 12px;border-bottom:1px solid rgba(255,255,255,0.06);font-size:12.5px;color:rgba(255,255,255,0.65);vertical-align:top;}
.facts-table tr:last-child td{border-bottom:none;}
.ft-key{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.4);width:160px;}

/* ── RECORD ITEMS ── */
.record-list{display:flex;flex-direction:column;gap:12px;margin-top:16px;}
.record-item{display:flex;gap:14px;align-items:flex-start;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);border-radius:8px;padding:14px;}
.ri-tier{width:12px;height:12px;border-radius:50%;flex-shrink:0;margin-top:3px;}
.t1{background:var(--gilt);}
.t2{background:rgba(55,138,221,0.7);}
.t3{background:rgba(255,255,255,0.3);}
.ri-title{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:white;margin-bottom:4px;}
.ri-desc{font-size:12.5px;color:rgba(255,255,255,0.6);line-height:1.65;}

/* ── CIVIC ISSUES (from Iran) ── */
.ci-list{display:flex;flex-direction:column;gap:10px;margin-top:16px;}

.endonym-table{width:100%;border-collapse:collapse;border-radius:8px;overflow:hidden;border:1px solid var(--rule);}
.et-type{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;}
.et-end{color:var(--green);}
.et-exo{color:var(--ink-mut);}
.et-name{font-family:'Source Serif 4',serif;font-weight:600;color:var(--ink);margin-bottom:2px;}
.et-source{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);}
.ci-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:13px 16px;display:flex;gap:12px;align-items:flex-start;margin-bottom:8px;transition:box-shadow 0.12s;cursor:pointer;}
.ci-icon{font-size:18px;flex-shrink:0;}
.ci-title{font-family:'Libre Baskerville',serif;font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:3px;line-height:1.35;}
.ci-desc{font-family:'Nunito',sans-serif;font-size:11.5px;color:var(--ink-soft);line-height:1.5;}
.ci-count{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);margin-top:5px;}
.ci-arrow{font-size:14px;color:var(--ink-mut);flex-shrink:0;margin-left:auto;}
</style>
</head>
