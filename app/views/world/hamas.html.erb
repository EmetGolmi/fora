<script>
const defs = {
  'sunni': { ey:'Islamic tradition', title:'Sunni Islam', body:'The largest branch of Islam (~85-90% of Muslims worldwide). Sunnis follow the Sunnah (practice) of the Prophet Muhammad as recorded in hadith. Governance legitimacy derives from consensus of the community. Distinct from Shia Islam, which holds that political authority should rest with descendants of the Prophet through Ali. Hamas is Sunni — making it doctrinally distinct from its primary sponsor Iran, which is Shia.' },
  'mb': { ey:'Islamic political movement', title:'Muslim Brotherhood', body:'Founded in Egypt in 1928 by Hassan al-Banna. The largest and most influential Sunni Islamist political movement. Advocates for governance based on Islamic law through political participation rather than violence. Hamas is an offshoot of the Palestinian Muslim Brotherhood. The Brotherhood is banned in some countries (Egypt, Russia, UAE) and legal in others.' },
  'gaza': { ey:'Palestinian territory', title:'Gaza Strip', body:'A 41km × 10km strip of land on the Mediterranean coast, bordered by Israel and Egypt. Population ~2.3 million (before Oct 2023 war). Under Israeli blockade since 2007 when Hamas took control. One of the most densely populated territories on Earth. Governed by Hamas as de facto authority.' },
  'fatah': { ey:'Palestinian political party', title:'Fatah', body:'The secular Palestinian nationalist party founded by Yasser Arafat. Dominant in the PLO and Palestinian Authority. Controls the West Bank. Signed the Oslo Accords (1993) recognizing Israel\'s right to exist in exchange for Palestinian self-governance. Lost the 2006 elections to Hamas. Bitter rivals since 2007 Gaza civil conflict.' },
  'qassam': { ey:'Military wing', title:'Izz ad-Din al-Qassam Brigades', body:'Hamas\'s military wing, named after a Syrian-born Palestinian cleric killed by British forces in 1935. Founded 1991. Responsible for suicide bombings in the 1990s-2000s, rocket attacks on Israel, tunnel construction, and the Oct 7 2023 attack. Severely degraded 2024-2026 with loss of all top commanders.' },
  'iran': { ey:'Primary sponsor', title:'Iran / IRGC', body:'Iran has funded and armed Hamas since the 1990s. The relationship is pragmatic not theological — Iran is Shia, Hamas is Sunni. Iran views Hamas as a tool to project power to Israel\'s borders. Funding has varied (~$100M/year at peak) and was cut during 2012-17 when Hamas backed Syrian Sunni rebels. Restored after 2022 reconciliation.' },
  'qatar': { ey:'Gulf state / mediator', title:'Qatar', body:'Hosts Hamas political bureau in Doha. Provides ~$30M/month for Gaza civilian administration with Israeli tacit approval. Qatar\'s dual role as Hamas host and ceasefire mediator is the reason it can negotiate — it has direct access. Qatar has not designated Hamas as a terrorist organization. A NATO partner and host of US Central Command at Al Udeid Air Base.' },
  shia:{ey:'Religion · Islam',title:'Shia Islam',body:'One of the two major branches of Islam, comprising approximately 10–15% of the world\'s 1.8 billion Muslims. Shia Islam emerged from a dispute after the Prophet Muhammad\'s death in 632 CE over who should lead the Muslim community. Shia Muslims believe leadership should have remained with the Prophet\'s family — his cousin and son-in-law Ali and his descendants.',ex:'Hezbollah is a Shia organization. Its primary sponsor Iran is approximately 90–95% Shia. Lebanon\'s Shia community (approximately 30–40% of Lebanon\'s population) is Hezbollah\'s primary constituency. Hamas, by contrast, is Sunni — a different Islamic tradition. Their alliance is strategic, not theological.'},
  iran:{ey:'Jurisdiction · State',title:'Iran · Islamic Republic',body:'A theocratic republic in the Middle East, established after the 1979 Islamic Revolution. Iran is governed by a dual structure: an elected president and parliament, and a Supreme Leader (currently being determined after Khamenei\'s death) who holds ultimate authority over all state institutions, including the military, judiciary, and foreign policy.',ex:'Iran created Hezbollah in 1982, funds it, arms it, and commands it through the IRGC Quds Force. The relationship is theological (Hezbollah\'s Velayat-e Faqih doctrine means it answers to Iran\'s Supreme Leader as a religious obligation) as well as strategic.'},
  irgc:{ey:'Organization · Military',title:'IRGC — Islamic Revolutionary Guard Corps',body:'The primary military force of the Islamic Republic of Iran, distinct from the regular Iranian Army. Created after the 1979 revolution to protect the Islamic system. The IRGC Quds Force is its external operations branch — responsible for supporting, arming, and training proxy forces including Hezbollah, Hamas, Houthis, and Iraqi Shia militias. Designated a Foreign Terrorist Organization by the US in 2019.',ex:'The IRGC Quds Force is the direct link between Iran\'s Supreme Leader and Hezbollah. Quds Force Commander Qasem Soleimani personally managed Hezbollah\'s regional strategy until his assassination by the US in January 2020. His death severed important personal connective tissue between Tehran and Beirut.'},
  fto:{ey:'Legal term · US Federal',title:'Foreign Terrorist Organization (FTO)',body:'A designation made by the US Secretary of State under 8 U.S.C. § 1189. An FTO designation makes it a federal crime for US citizens or organizations to knowingly provide "material support or resources" to the group — including money, property, services, personnel, transportation, or training. It also enables deportation of aliens who are members.',ex:'Hezbollah has been an FTO since 1997. The Ghazali investigation centers on whether his contacts with suspected Hezbollah members constituted "material support." Simply knowing Hezbollah members is not sufficient — the prosecution must prove knowing, active support.'},
  nasrallah:{ey:'Person · Deceased',title:'Hassan Nasrallah',body:'Secretary-General of Hezbollah from 1992 until his assassination on September 27, 2024. Served for 32 years. Widely described as the most powerful non-state actor in the Middle East for much of his tenure. Led Hezbollah through: the 2000 Israeli withdrawal from Lebanon, the 2006 war, the Syria intervention, and the post-October 7 northern front. His death is assessed as the most significant single blow to Hezbollah\'s capabilities since its founding.',ex:'Nasrallah was killed in an Israeli airstrike on Hezbollah\'s headquarters in Beirut\'s southern suburbs. He reportedly died from toxic fumes rather than direct blast injuries. His funeral in February 2025 drew an estimated 450,000–1,400,000 attendees — demonstrating continued popular support despite the organization\'s military defeat.'},
  qassem:{ey:'Person · Current leader',title:'Naim Qassem',body:'Current Secretary-General of Hezbollah, elected October 29, 2024 following Nasrallah\'s assassination. Had served as deputy secretary-general for over 30 years under Nasrallah. Described by analysts as "a default choice," "weak," and "lacking charisma." Currently working to centralize control of the organization and stabilize after the leadership crisis, with active backing from Iran.',ex:'"There are no longer figures within Hezbollah that could be compared with Nasrallah, or even with Safieddine. Therefore, appointing a new secretary general for Hezbollah would take a while." — Lebanese analyst al-Amin, October 2024. Qassem was ultimately the appointment — confirming the assessment that it would be a default rather than a charismatic successor.'},
  velayat:{ey:'Theology · Political theory · Iran',title:'Velayat-e Faqih',body:'Literally "Guardianship of the Islamic Jurist." A political-theological doctrine developed by Ayatollah Khomeini that holds that in the absence of the Hidden Imam, a qualified Islamic jurist should govern society. In Iran, this means the Supreme Leader holds ultimate authority above the elected government. For Hezbollah, it means the organization answers to Iran\'s Supreme Leader as a religious obligation — not merely a political or strategic relationship.',ex:'Velayat-e Faqih is what makes the Iran-Hezbollah relationship different from most state-proxy relationships. Most proxy forces follow their sponsor for strategic reasons. Hezbollah follows Iran\'s Supreme Leader because it believes this is religiously required. This means the relationship survives changes in Iranian government — it is tied to the institution of the Supreme Leader, not to any individual.'},
  amia:{ey:'Event · Terrorism · 1994',title:'AMIA Bombing · Buenos Aires',body:'The bombing of the AMIA (Asociación Mutual Israelita Argentina) Jewish community center in Buenos Aires on July 18, 1994. 85 killed, more than 300 wounded. The deadliest terrorist attack in Argentine history. The first major Hezbollah operation outside Lebanon and the Middle East. Attributed to Hezbollah with Iranian government involvement. As of 2026 — 32 years later — no one has been convicted.',ex:'The AMIA bombing established Hezbollah\'s Latin American presence and its capability to conduct operations globally. Argentine courts have indicted Iranian officials including former President Rafsanjani (deceased) and former Foreign Minister Velayati. The case remains open. Argentina\'s Milei government has vowed to renew the investigation.'},
  tba:{ey:'Geographic · Security',title:'Tri-Border Area (TBA)',body:'The area where Argentina, Brazil, and Paraguay meet — centered on the cities of Puerto Iguazú (Argentina), Foz do Iguaçu (Brazil), and Ciudad del Este (Paraguay). Home to a large Lebanese diaspora community and historically a hub for informal economic activity, smuggling, counterfeiting, and terrorist financing.',ex:'Hezbollah has maintained financial and logistical networks in the TBA since the 1980s. US Senate testimony estimates the area generates tens of millions in annual revenue for Hezbollah through counterfeiting, narcotics, and trade-based money laundering. Brazil\'s 2024 Operation Trapiche targeted Hezbollah recruitment and financing networks there. Argentinian security minister Bullrich confirmed Hezbollah activity in Chile, Bolivia, and the TBA in June 2025.'}
};

function showDef(key){
  const d=defs[key]; if(!d) return;
  document.getElementById('def-ey').textContent=d.ey;
  document.getElementById('def-title').textContent=d.title;
  document.getElementById('def-body').textContent=d.body;
  document.getElementById('def-ex').textContent=d.ex;
  document.getElementById('def-modal').classList.add('open');
}
function closeDef(e){
  if(!e||e.target===document.getElementById('def-modal')) document.getElementById('def-modal').classList.remove('open');
}
document.addEventListener('keydown',e=>{if(e.key==='Escape') document.getElementById('def-modal').classList.remove('open');});

function switchTab(tab,el){
  const tabs=['overview','structure','timeline','relationships','designations','docs','current'];
  tabs.forEach(t=>{
    const el2=document.getElementById('tab-'+t);
    if(el2) el2.style.display=t===tab?'block':'none';
  });
  document.querySelectorAll('.etab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
}
</script>
