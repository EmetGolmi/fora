  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gilt);
  font-size: 32px;
}

.video-title { padding: 8px; font-size: 12px; font-weight: 600; color: var(--ink); }

/* ── TEXT CONTENT ────────────────────────────────────────────── */
.text-block { margin: 16px 0; line-height: 1.8; font-size: 14px; color: var(--ink); }
.italic-text { font-style: italic; color: var(--ink-soft); }
.centered-text { text-align: center; font-style: italic; margin: 20px 0; color: var(--ink-soft); }

.responsive-text {
  margin: 12px 0;
  padding-left: 20px;
  border-left: 3px solid var(--gilt);
  font-size: 13px;
  line-height: 1.7;
}

.response-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--gilt);
  margin-bottom: 4px;
  letter-spacing: 0.1em;
  display: block;
}

.responsive-text[data-speaker="reader"] {
  border-left: 3px solid var(--blue);
  background: var(--blue-pl);
  padding: 12px 16px;
  margin: 12px 0;
  border-radius: 3px;
}

.responsive-text[data-speaker="reader"] .response-label { color: var(--blue); }

.responsive-text[data-speaker="all"] {
  border-left: none;
  background: transparent;
  padding: 12px 0;
  margin: 12px 0;
  border-radius: 0;
  font-size: 14px;
  font-weight: 500;
}

.responsive-text[data-speaker="all"] .response-label { color: var(--gilt); font-weight: 700; }

.scripture {
