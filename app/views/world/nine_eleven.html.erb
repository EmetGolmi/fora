}

/* ── VIDEO CAROUSEL ──────────────────────────────────────────── */
.carousel { position: relative; overflow: hidden; margin: 16px 0; }

.carousel-label {
  font-family: 'Libre Baskerville', serif;
  font-weight: 700;
  font-size: 14px;
