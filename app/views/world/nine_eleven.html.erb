/* ── TORAH VERSE SECTION ─────────────────────────────────────── */
.torah-section {
  background: var(--gilt-pl);
  border-left: 4px solid var(--gilt);
  padding: 20px;
  margin: 16px 0;
  border-radius: 4px;
}

.torah-hebrew {
  font-size: 18px;
  line-height: 1.8;
