  <!-- ── IV. MY COUNTRY 'TIS OF THEE ──────────────────────────── -->
  <div class="section">
    <div class="section-eyebrow" data-lang-en>Processional Hymn</div>
    <div class="section-eyebrow" data-lang-es style="display:none;">Himno Procesional</div>
    <div class="section-title" data-lang-en>My Country 'Tis of Thee</div>
    <div class="section-title" data-lang-es style="display:none;">Mi País Es Tuyo</div>

