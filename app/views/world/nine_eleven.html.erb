<script>
function toggleColonies(btn) {
  var content = document.getElementById(btn.dataset.target);
  var isOpen = content.classList.toggle('open');
  btn.classList.toggle('open', isOpen);
  btn.querySelector('[data-lang-en].expand-label').textContent = isOpen ? 'Collapse' : 'View Full Comparison';
}

function openSoundModal() {
  document.getElementById('soundModal').classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeSoundModal() {
  document.getElementById('soundModal').classList.remove('active');
  document.body.style.overflow = 'auto';
}
function openCologneModal() {
  document.getElementById('cologneModal').classList.add('active');
  document.body.style.overflow = 'hidden';
}
function closeCologneModal() {
  document.getElementById('cologneModal').classList.remove('active');
  document.body.style.overflow = 'auto';
}
window.onclick = function(e) {
  if (e.target === document.getElementById('soundModal'))  closeSoundModal();
  if (e.target === document.getElementById('cologneModal')) closeCologneModal();
};

// Scripture translation toggle
document.querySelectorAll('.toggle-btn[data-version]').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.toggle-btn[data-version]').forEach(function(b){ b.classList.remove('active'); });
    this.classList.add('active');
    var v = this.getAttribute('data-version');
    var isES = document.querySelector('.toggle-btn[data-language].active') &&
               document.querySelector('.toggle-btn[data-language].active').getAttribute('data-language') === 'es';
    // Hide all versioned elements
    document.querySelectorAll('[data-kjv],[data-niv],[data-esv]').forEach(function(el){ el.style.display = 'none'; });
    // Show only the selected version — respecting current language
    document.querySelectorAll('[data-' + v + ']').forEach(function(el){
      if (el.hasAttribute('data-lang-es')) {
        // Spanish sibling: only show in ES mode
        el.style.display = isES ? 'block' : 'none';
      } else {
        // English (or untagged) versioned element: always show
        el.style.display = 'block';
      }
    });
  });
});

// Language toggle — ES shows Spanish beneath each English entry (bilingual);
// EN returns to English-only.
document.querySelectorAll('.toggle-btn[data-language]').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.toggle-btn[data-language]').forEach(function(b){ b.classList.remove('active'); });
    this.classList.add('active');
    var lang = this.getAttribute('data-language');
    var activeVersion = (document.querySelector('.toggle-btn[data-version].active') || {getAttribute: function(){ return 'kjv'; }}).getAttribute('data-version') || 'kjv';
    if (lang === 'es') {
      // Show everything — English stays, Spanish appears beneath
      document.querySelectorAll('[data-lang-en]').forEach(function(el){
        el.style.display = el.tagName === 'SPAN' ? 'inline' : 'block';
      });
      document.querySelectorAll('[data-lang-es]').forEach(function(el){
        // For versioned ES elements, only show if it matches active version
        if (el.hasAttribute('data-kjv') || el.hasAttribute('data-niv') || el.hasAttribute('data-esv')) {
          el.style.display = el.hasAttribute('data-' + activeVersion) ? 'block' : 'none';
        } else {
          el.style.display = el.tagName === 'SPAN' ? 'inline' : 'block';
        }
      });
    } else {
      // English only
      document.querySelectorAll('[data-lang-en]').forEach(function(el){
        el.style.display = el.tagName === 'SPAN' ? 'inline' : 'block';
      });
      document.querySelectorAll('[data-lang-es]').forEach(function(el){ el.style.display = 'none'; });
    }
  });
});

// Initialise — KJV on; EN is default so all Spanish elements remain hidden
document.querySelectorAll('[data-niv],[data-esv]').forEach(function(el){ el.style.display = 'none'; });
// Ensure all Spanish elements are hidden on load (EN is default)
document.querySelectorAll('[data-lang-es]').forEach(function(el){ el.style.display = 'none'; });
</script>
