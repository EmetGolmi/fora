  color: var(--blue);
  text-decoration: underline;
  cursor: pointer;
  font-weight: 600;
}
.cologne-link:hover { color: var(--gilt); }

/* ── SETTINGS TOGGLE ─────────────────────────────────────────── */
.setting-toggle {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 100;
  background: white;
  border: 1px solid var(--rule);
  border-radius: 6px;
  padding: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.toggle-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  color: var(--ink-soft);
  letter-spacing: 0.1em;
  margin-bottom: 8px;
  display: block;
}

.toggle-buttons { display: flex; gap: 4px; }

.toggle-btn {
  padding: 6px 10px;
  border: 1px solid var(--rule);
  background: white;
  color: var(--ink-soft);
  border-radius: 3px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  font-family: 'JetBrains Mono', monospace;
}

.toggle-btn.active { background: var(--blue); color: white; border-color: var(--blue); }
.toggle-btn:hover:not(.active) { border-color: var(--gilt); color: var(--gilt); }

/* ── MODAL ───────────────────────────────────────────────────── */
.modal {
  display: none;
  position: fixed;
  z-index: 200;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  animation: fadeIn 0.2s;
}

.modal.active { display: flex; align-items: center; justify-content: center; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal-content {
  background: var(--white);
  padding: 40px;
  border-radius: 8px;
  max-width: 600px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 16px; right: 16px;
  font-size: 24px;
  font-weight: bold;
  cursor: pointer;
  color: var(--ink-soft);
  background: none;
  border: none;
  width: 30px; height: 30px;
  display: flex; align-items: center; justify-content: center;
}
.modal-close:hover { color: var(--blue); }

.modal-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 24px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 16px;
}

.modal-section { margin-bottom: 20px; }

.modal-section-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 16px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 8px;
}

.modal-text { font-size: 14px; line-height: 1.7; color: var(--ink-soft); margin-bottom: 12px; }

.frequency-note {
  background: var(--blue-pl);
  border-left: 3px solid var(--blue);
  padding: 12px;
  margin: 12px 0;
  border-radius: 4px;
  font-size: 13px;
}

/* ── FOOTER ──────────────────────────────────────────────────── */
.page-footer {
  max-width: 760px;
  margin: 28px auto 0;
  text-align: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-mut);
}

/* ── RESPONSIVE ──────────────────────────────────────────────── */
@media (max-width: 600px) {
  .card-title { font-size: 28px; }
  .container { max-width: 100%; }
  .section, .card-header { padding: 20px; }
  .video-card { width: 160px; }
  .setting-toggle { top: 10px; right: 10px; padding: 10px; }
  .toggle-btn { padding: 5px 8px; font-size: 10px; }
}

/* ── THIRTEEN COLONIES EXPAND ────────────────────────────────── */
.expand-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: none;
  border: 1px solid var(--gilt);
  border-radius: 4px;
