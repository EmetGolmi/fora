<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORA · 9/11 Interfaith Prayer and Remembrance</title>
<meta name="description" content="An annual interfaith observance of prayer, remembrance, and civic covenant. September 11, 2001 — We do not forget.">
<meta property="og:title" content="9/11 Interfaith Prayer and Remembrance · FORA">
<meta property="og:description" content="Join in remembering September 11, 2001 — an interfaith civic observance honoring 2,977 lives lost, with prayer, scripture, and community memory.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://fora.center/9-11">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="9/11 Interfaith Prayer and Remembrance · FORA">
<meta name="twitter:description" content="An annual interfaith civic observance. September 11, 2001 — We do not forget. We do not surrender. We go forward — together.">
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --blue: #1b3a6b;
  --blue-md: #254f92;
  --blue-lt: #3a6abf;
  --blue-pl: #dde5f5;
  --gilt: #b8860b;
  --gilt-lt: #d4a832;
  --gilt-pl: #f8f0dc;
  --ink: #0e1a2e;
  --ink-soft: #5a6e8a;
  --ink-mut: #8a9ab8;
  --bg: #f2f4f8;
  --white: #ffffff;
  --newsprint: #f5f3ee;
  --rule: rgba(27, 58, 107, 0.1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Nunito', sans-serif;
  background: var(--newsprint);
  color: var(--ink);
  padding: 40px 20px;
}

.container { max-width: 760px; margin: 0 auto; }

/* ── FORA NAV BAR ──────────────────────────────────────────────── */
.fora-bar {
  max-width: 760px;
  margin: 0 auto 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fora-wordmark {
  font-family: 'Libre Baskerville', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--blue);
  text-decoration: none;
  letter-spacing: 0.04em;
}
.fora-back {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-mut);
  text-decoration: none;
}
.fora-back:hover { color: var(--blue); }

/* ── CARD HEADER ─────────────────────────────────────────────── */
.card-header {
  background: linear-gradient(135deg, var(--blue) 0%, var(--blue-md) 100%);
  border-radius: 8px 8px 0 0;
  padding: 40px;
  color: white;
  text-align: center;
  border-bottom: 4px solid var(--gilt);
}

.card-date {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 12px;
}

.card-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 12px;
}

.card-subtitle {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.8);
  font-style: italic;
}

/* ── SECTIONS ────────────────────────────────────────────────── */
.section {
  background: var(--white);
  padding: 32px;
  border-left: 4px solid var(--gilt);
  margin-top: -1px;
}

.section:last-child { border-radius: 0 0 8px 8px; }

.section-eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--gilt);
  margin-bottom: 8px;
}

.section-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 16px;
}

.section-desc {
  font-size: 14px;
  color: var(--ink-soft);
  line-height: 1.7;
  margin-bottom: 12px;
}

.chronology {
  background: var(--blue-pl);
  border-left: 3px solid var(--blue);
  padding: 16px;
  margin: 16px 0;
  border-radius: 4px;
  font-size: 13px;
  line-height: 1.8;
  font-family: 'JetBrains Mono', monospace;
}

.chrono-time {
  font-weight: 600;
  color: var(--blue);
  display: block;
  margin-bottom: 4px;
}

/* ── AUDIO & VIDEO PLAYERS ───────────────────────────────────── */
.media-player {
  background: var(--newsprint);
  border: 1px solid var(--rule);
  border-radius: 6px;
  padding: 16px;
  margin: 16px 0;
}

.media-label {
  font-family: 'Libre Baskerville', serif;
  font-weight: 700;
  font-size: 14px;
  color: var(--blue);
  margin-bottom: 8px;
}

audio { width: 100%; margin-bottom: 8px; }

.audio-context {
  font-size: 12px;
  color: var(--ink-soft);
  line-height: 1.6;
}

/* ── VIDEO CAROUSEL ──────────────────────────────────────────── */
.carousel { position: relative; overflow: hidden; margin: 16px 0; }

.carousel-label {
  font-family: 'Libre Baskerville', serif;
  font-weight: 700;
  font-size: 14px;
  color: var(--blue);
  margin-bottom: 12px;
}

.carousel-container {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 8px;
  scroll-behavior: smooth;
}

.carousel-container::-webkit-scrollbar { height: 6px; }
.carousel-container::-webkit-scrollbar-track { background: var(--rule); border-radius: 3px; }
.carousel-container::-webkit-scrollbar-thumb { background: var(--gilt); border-radius: 3px; }

.video-card {
  flex-shrink: 0;
  width: 200px;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid var(--rule);
  background: var(--newsprint);
  cursor: pointer;
  transition: transform 0.2s;
}

.video-card:hover { transform: scale(1.02); }

.video-thumbnail {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: var(--blue);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gilt);
  font-size: 32px;
}

.video-title { padding: 8px; font-size: 12px; font-weight: 600; color: var(--ink); }

/* ── TEXT CONTENT ────────────────────────────────────────────── */
.text-block { margin: 16px 0; line-height: 1.8; font-size: 14px; color: var(--ink); }
.italic-text { font-style: italic; color: var(--ink-soft); }
.centered-text { text-align: center; font-style: italic; margin: 20px 0; color: var(--ink-soft); }

.responsive-text {
  margin: 12px 0;
  padding-left: 20px;
  border-left: 3px solid var(--gilt);
  font-size: 13px;
  line-height: 1.7;
}

.response-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--gilt);
  margin-bottom: 4px;
  letter-spacing: 0.1em;
  display: block;
}

.responsive-text[data-speaker="reader"] {
  border-left: 3px solid var(--blue);
  background: var(--blue-pl);
  padding: 12px 16px;
  margin: 12px 0;
  border-radius: 3px;
}

.responsive-text[data-speaker="reader"] .response-label { color: var(--blue); }

.responsive-text[data-speaker="all"] {
  border-left: none;
  background: transparent;
  padding: 12px 0;
  margin: 12px 0;
  border-radius: 0;
  font-size: 14px;
  font-weight: 500;
}

.responsive-text[data-speaker="all"] .response-label { color: var(--gilt); font-weight: 700; }

.scripture {
  background: var(--gilt-pl);
  border-left: 4px solid var(--gilt);
  padding: 16px;
  margin: 16px 0;
  border-radius: 4px;
  font-style: italic;
  font-size: 14px;
  line-height: 1.8;
}

.scripture-ref {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-style: normal;
  text-transform: uppercase;
  color: var(--gilt);
  margin-top: 8px;
}

/* ── TORAH VERSE SECTION ─────────────────────────────────────── */
.torah-section {
  background: var(--gilt-pl);
  border-left: 4px solid var(--gilt);
  padding: 20px;
  margin: 16px 0;
  border-radius: 4px;
}

.torah-hebrew {
  font-size: 18px;
  line-height: 1.8;
  direction: rtl;
  margin-bottom: 12px;
  color: var(--blue);
  font-weight: 600;
}

.torah-transliteration {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--ink-soft);
  margin-bottom: 12px;
  line-height: 1.6;
}

.torah-english { font-size: 14px; font-style: italic; color: var(--ink); line-height: 1.8; }

.torah-ref {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  color: var(--gilt);
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid rgba(184, 134, 11, 0.3);
}

/* ── LEARN MORE LINK ─────────────────────────────────────────── */
.learn-more-link {
  color: var(--blue);
  text-decoration: underline;
  cursor: pointer;
  font-weight: 600;
}
.learn-more-link:hover { color: var(--gilt); }

/* ── COLOGNE LINK ────────────────────────────────────────────── */
.cologne-link {
  color: var(--blue);
  text-decoration: underline;
  cursor: pointer;
  font-weight: 600;
}
.cologne-link:hover { color: var(--gilt); }

/* ── SETTINGS TOGGLE ─────────────────────────────────────────── */
.setting-toggle {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 100;
  background: white;
  border: 1px solid var(--rule);
  border-radius: 6px;
  padding: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.toggle-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  color: var(--ink-soft);
  letter-spacing: 0.1em;
  margin-bottom: 8px;
  display: block;
}

.toggle-buttons { display: flex; gap: 4px; }

.toggle-btn {
  padding: 6px 10px;
  border: 1px solid var(--rule);
  background: white;
  color: var(--ink-soft);
  border-radius: 3px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  font-family: 'JetBrains Mono', monospace;
}

.toggle-btn.active { background: var(--blue); color: white; border-color: var(--blue); }
.toggle-btn:hover:not(.active) { border-color: var(--gilt); color: var(--gilt); }

/* ── MODAL ───────────────────────────────────────────────────── */
.modal {
  display: none;
  position: fixed;
  z-index: 200;
  left: 0; top: 0;
  width: 100%; height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  animation: fadeIn 0.2s;
}

.modal.active { display: flex; align-items: center; justify-content: center; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.modal-content {
  background: var(--white);
  padding: 40px;
  border-radius: 8px;
  max-width: 600px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 16px; right: 16px;
  font-size: 24px;
  font-weight: bold;
  cursor: pointer;
  color: var(--ink-soft);
  background: none;
  border: none;
  width: 30px; height: 30px;
  display: flex; align-items: center; justify-content: center;
}
.modal-close:hover { color: var(--blue); }

.modal-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 24px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 16px;
}

.modal-section { margin-bottom: 20px; }

.modal-section-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 16px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 8px;
}

.modal-text { font-size: 14px; line-height: 1.7; color: var(--ink-soft); margin-bottom: 12px; }

.frequency-note {
  background: var(--blue-pl);
  border-left: 3px solid var(--blue);
  padding: 12px;
  margin: 12px 0;
  border-radius: 4px;
  font-size: 13px;
}

/* ── FOOTER ──────────────────────────────────────────────────── */
.page-footer {
  max-width: 760px;
  margin: 28px auto 0;
  text-align: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-mut);
}

/* ── RESPONSIVE ──────────────────────────────────────────────── */
@media (max-width: 600px) {
  .card-title { font-size: 28px; }
  .container { max-width: 100%; }
  .section, .card-header { padding: 20px; }
  .video-card { width: 160px; }
  .setting-toggle { top: 10px; right: 10px; padding: 10px; }
  .toggle-btn { padding: 5px 8px; font-size: 10px; }
}

/* ── THIRTEEN COLONIES EXPAND ────────────────────────────────── */
.expand-toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: none;
  border: 1px solid var(--gilt);
  border-radius: 4px;
  padding: 10px 18px;
  color: var(--gilt);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  cursor: pointer;
  margin-top: 16px;
  transition: background 0.2s, color 0.2s;
}
.expand-toggle:hover { background: var(--gilt); color: #fff; }
.expand-toggle.open { background: var(--gilt); color: #fff; }
.expand-arrow { display: inline-block; transition: transform 0.3s; }
.expand-toggle.open .expand-arrow { transform: rotate(180deg); }
.colonies-content { display: none; margin-top: 24px; }
/* ── RELIGIOUS DISTORTION BLOCK ─────────────────────────────── */
.distortion-block {
  background: var(--newsprint);
  border: 1px solid var(--rule);
  border-radius: 6px;
  margin: 20px 0;
  overflow: hidden;
}
.distortion-block.distortion-response {
  border-color: rgba(27, 58, 107, 0.2);
}
.distortion-header {
  background: var(--ink);
  color: white;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 10px 16px;
}
.distortion-response .distortion-header {
  background: var(--blue);
}
.distortion-body {
  padding: 16px;
  font-size: 13px;
  line-height: 1.7;
  color: var(--ink);
}
.distortion-body p { margin-bottom: 10px; }
.distortion-body ul { margin: 8px 0 8px 20px; }
.distortion-body li { margin-bottom: 8px; line-height: 1.6; }

/* ── UNVERIFIED CREDENTIAL BADGE ─────────────────────────────── */
.cred-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #f3f3f3;
  border: 1px solid #d0d0d0;
  border-radius: 3px;
  padding: 3px 8px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: #777;
  margin: 3px 3px 3px 0;
  vertical-align: middle;
}
.cred-badge-icon {
  width: 10px; height: 10px;
  border: 1.5px solid #aaa;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}
.cred-badge-unverified {
  font-size: 9px;
  color: #bbb;
  font-style: italic;
  margin-left: 2px;
}

/* ── COMMUNITY MEMORIES / STORY CARDS ───────────────────────── */
.memory-form {
  background: var(--white);
  border: 1px solid var(--rule);
  border-radius: 6px;
  padding: 24px;
  margin: 20px 0;
}
.memory-form-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 15px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 16px;
}
.form-row { margin-bottom: 14px; }
.form-label {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-soft);
  margin-bottom: 5px;
}
.form-label .optional {
  font-weight: 400;
  color: var(--ink-mut);
  text-transform: none;
  letter-spacing: 0;
  font-size: 9px;
}
.form-input {
  width: 100%;
  border: 1px solid var(--rule);
  border-radius: 4px;
  padding: 9px 12px;
  font-family: 'Nunito', sans-serif;
  font-size: 13px;
  color: var(--ink);
  background: var(--newsprint);
  transition: border-color 0.2s;
}
.form-input:focus { outline: none; border-color: var(--blue); background: white; }
textarea.form-input { resize: vertical; min-height: 90px; }
.form-row-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 600px) { .form-row-2col { grid-template-columns: 1fr; } }
.form-cred-section {
  background: var(--newsprint);
  border: 1px dashed #ccc;
  border-radius: 4px;
  padding: 16px;
  margin: 14px 0;
}
.form-cred-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #aaa;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.form-cred-label::after {
  content: 'UNVERIFIED · OPTIONAL';
  font-size: 8px;
  color: #bbb;
  border: 1px solid #ddd;
  padding: 1px 5px;
  border-radius: 2px;
  letter-spacing: 0.06em;
}
.form-cred-note {
  font-size: 11px;
  color: var(--ink-mut);
  font-style: italic;
  margin-top: 10px;
  line-height: 1.5;
}
.btn-submit-story {
  background: var(--blue);
  color: white;
  border: none;
  border-radius: 4px;
  padding: 12px 24px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: 6px;
}
.btn-submit-story:hover { background: var(--blue-md); }
.memory-feed { margin-top: 24px; }
.memory-card {
  background: var(--white);
  border: 1px solid var(--rule);
  border-radius: 6px;
  padding: 18px;
  margin-bottom: 14px;
}
.memory-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 10px;
}
.memory-card-author {
  font-family: 'Libre Baskerville', serif;
  font-size: 13px;
  font-weight: 700;
  color: var(--blue);
}
.memory-card-location {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--ink-mut);
  margin-top: 2px;
}
.memory-card-text {
  font-size: 14px;
  line-height: 1.7;
  color: var(--ink);
  margin-bottom: 12px;
}
.memory-card-creds { margin-top: 8px; }
.memory-card-meta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  color: var(--ink-mut);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--rule);
}
.memory-empty {
  text-align: center;
  padding: 32px;
  color: var(--ink-mut);
  font-style: italic;
  font-size: 14px;
}

/* ── SOCIAL SHARE ─────────────────────────────────────────────── */
.share-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0 8px;
}
.share-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  border: 1px solid transparent;
  cursor: pointer;
  transition: opacity 0.15s;
}
.share-btn:hover { opacity: 0.85; }
.share-btn-x       { background: #000; color: #fff; }
.share-btn-fb      { background: #1877f2; color: #fff; }
.share-btn-li      { background: #0a66c2; color: #fff; }
.share-btn-reddit  { background: #ff4500; color: #fff; }
.share-btn-threads { background: #000; color: #fff; border: 1px solid #333; }
.share-btn-bluesky { background: #0085ff; color: #fff; }
.share-btn-copy    { background: white; color: var(--blue); border-color: var(--blue); }
.share-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  text-transform: uppercase;
  color: var(--ink-mut);
  letter-spacing: 0.1em;
  margin-bottom: 10px;
  display: block;
}

.colonies-content.open { display: block; }
.colonies-intro {
  background: var(--white);
  border-left: 4px solid var(--gilt);
  padding: 24px;
  border-radius: 6px;
  line-height: 1.8;
  font-size: 14px;
  margin-bottom: 20px;
}
.colonies-intro p { margin-bottom: 14px; }
.colonies-intro p:last-child { margin-bottom: 0; }
.colonies-table-wrap {
  overflow-x: auto;
  background: var(--white);
  border-radius: 6px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}
.colonies-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.colonies-table thead { background: linear-gradient(135deg,var(--blue) 0%,var(--blue-md) 100%); color: #fff; }
