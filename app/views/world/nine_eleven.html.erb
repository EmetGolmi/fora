}
.ctolerance:last-child { margin-bottom: 0; }
.ctolerance-lbl {
  font-family: 'JetBrains Mono',monospace;
  font-size: 9px;
  text-transform: uppercase;
  color: var(--gilt);
  letter-spacing: 0.1em;
  font-weight: 700;
  display: block;
