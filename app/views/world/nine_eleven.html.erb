}
.expand-toggle:hover { background: var(--gilt); color: #fff; }
.expand-toggle.open { background: var(--gilt); color: #fff; }
.expand-arrow { display: inline-block; transition: transform 0.3s; }
.expand-toggle.open .expand-arrow { transform: rotate(180deg); }
.colonies-content { display: none; margin-top: 24px; }
.colonies-content.open { display: block; }
.colonies-intro {
