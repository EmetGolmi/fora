<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORA · 9/11 Interfaith Prayer and Remembrance</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --blue: #1b3a6b;
  --blue-md: #254f92;
  --blue-lt: #3a6abf;
  --blue-pl: #dde5f5;
  --gilt: #b8860b;
  --gilt-lt: #d4a832;
  --gilt-pl: #f8f0dc;
  --ink: #0e1a2e;
  --ink-soft: #5a6e8a;
  --ink-mut: #8a9ab8;
  --bg: #f2f4f8;
  --white: #ffffff;
  --newsprint: #f5f3ee;
  --rule: rgba(27, 58, 107, 0.1);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Nunito', sans-serif;
  background: var(--newsprint);
  color: var(--ink);
  padding: 40px 20px;
}

.container { max-width: 760px; margin: 0 auto; }

/* ── FORA NAV BAR ──────────────────────────────────────────────── */
.fora-bar {
  max-width: 760px;
  margin: 0 auto 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fora-wordmark {
  font-family: 'Libre Baskerville', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--blue);
  text-decoration: none;
  letter-spacing: 0.04em;
}
.fora-back {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-mut);
  text-decoration: none;
}
.fora-back:hover { color: var(--blue); }

/* ── CARD HEADER ─────────────────────────────────────────────── */
.card-header {
  background: linear-gradient(135deg, var(--blue) 0%, var(--blue-md) 100%);
  border-radius: 8px 8px 0 0;
  padding: 40px;
  color: white;
  text-align: center;
  border-bottom: 4px solid var(--gilt);
}

.card-date {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 12px;
}

.card-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 12px;
}

.card-subtitle {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.8);
  font-style: italic;
}

/* ── SECTIONS ────────────────────────────────────────────────── */
.section {
  background: var(--white);
  padding: 32px;
  border-left: 4px solid var(--gilt);
  margin-top: -1px;
}

.section:last-child { border-radius: 0 0 8px 8px; }

.section-eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--gilt);
  margin-bottom: 8px;
}

.section-title {
  font-family: 'Libre Baskerville', serif;
  font-size: 18px;
  font-weight: 700;
  color: var(--blue);
  margin-bottom: 16px;
}

.section-desc {
  font-size: 14px;
  color: var(--ink-soft);
  line-height: 1.7;
  margin-bottom: 12px;
}

.chronology {
  background: var(--blue-pl);
  border-left: 3px solid var(--blue);
  padding: 16px;
  margin: 16px 0;
  border-radius: 4px;
  font-size: 13px;
  line-height: 1.8;
  font-family: 'JetBrains Mono', monospace;
}

.chrono-time {
  font-weight: 600;
  color: var(--blue);
