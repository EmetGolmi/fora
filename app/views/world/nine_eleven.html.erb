.colonies-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.colonies-table thead { background: linear-gradient(135deg,var(--blue) 0%,var(--blue-md) 100%); color: #fff; }
.colonies-table th { padding: 14px 12px; text-align: left; font-family: 'Libre Baskerville',serif; font-weight: 700; font-size: 13px; border-bottom: 2px solid var(--blue-lt); letter-spacing: 0.04em; }
.colonies-table td { padding: 12px; border-bottom: 1px solid var(--rule); vertical-align: top; }
.colonies-table tbody tr:hover { background: var(--blue-pl); }
.colonies-table tbody tr:last-child td { border-bottom: none; }
.col-cname { font-family: 'Libre Baskerville',serif; font-weight: 700; color: var(--blue); font-size: 13px; }
.crestrict {
