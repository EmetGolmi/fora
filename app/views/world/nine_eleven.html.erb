}
.crestrict:last-child { margin-bottom: 0; }
.crestrict-lbl {
  font-family: 'JetBrains Mono',monospace;
  font-size: 9px;
  text-transform: uppercase;
  color: var(--danger);
  letter-spacing: 0.1em;
  font-weight: 700;
  display: block;
  margin-bottom: 3px;
}
.ctolerance {
  background: var(--gilt-pl);
  border-left: 3px solid var(--gilt);
