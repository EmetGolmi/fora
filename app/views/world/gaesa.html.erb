<style>
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --bg:#f2f4f8;--white:#ffffff;
  --blue:#1b3a6b;--blue-pl:rgba(27,58,107,0.12);--blue-vp:rgba(27,58,107,0.04);
  --gilt:#b8860b;--gilt-lt:#d4a832;--gilt-pl:#f8f0dc;--gilt-rul:rgba(184,134,11,0.22);--gilt-dk:#8b6914;
  --ink:#0e1a2e;--ink-soft:#5a6e8a;--ink-mut:#8a9ab8;--ink-mid:#1e2d45;
  --rule:rgba(27,58,107,0.1);--rule-lt:rgba(27,58,107,0.05);
  --green:#155c2d;--green-p:rgba(21,92,45,0.07);--green-r:rgba(21,92,45,0.2);
  --red:#8b2020;--red-p:rgba(139,32,32,0.06);--red-r:rgba(139,32,32,0.2);--red-lt:#c0392b;
  --amber:#c47f00;--amber-p:rgba(196,127,0,0.07);--amber-r:rgba(196,127,0,0.2);
  --gae:#3a3a1a;--gae-lt:#6b6b2e;--gae-p:rgba(58,58,26,0.07);--gae-r:rgba(58,58,26,0.22);
}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);}
a{text-decoration:none;color:inherit;}

nav{background:var(--blue);padding:0 48px;display:flex;align-items:center;height:60px;border-bottom:4px solid var(--gilt);position:sticky;top:0;z-index:200;}
.nav-logo{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:white;letter-spacing:0.1em;margin-right:24px;}
.nav-links{display:flex;gap:6px;}
.nav-link{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.38);padding:6px 14px;border-radius:100px;cursor:pointer;}
.nav-link.active{color:white;background:rgba(255,255,255,0.1);}
.nav-right{margin-left:auto;}

/* TICKER */
.ticker-bar{height:28px;background:#0a0f1a;border-bottom:1px solid #1b3a6b;display:flex;align-items:center;overflow:hidden;}
.ticker-badge{flex-shrink:0;height:100%;padding:0 12px;display:flex;align-items:center;gap:6px;background:#3a3a1a;border-right:1px solid #6b6b2e;}
.ticker-badge-text{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:white;}
.ticker-scroll-wrap{flex:1;overflow:hidden;}
.ticker-track{display:flex;align-items:center;animation:tickscroll 32s linear infinite;white-space:nowrap;}
@keyframes tickscroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
.ticker-item{display:inline-flex;align-items:center;gap:8px;padding:0 16px;height:28px;border-right:1px solid rgba(255,255,255,0.05);}
.t-key{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);}
.t-val{font-family:'JetBrains Mono',monospace;font-size:10.5px;font-weight:500;}
.tv-r{color:#ff9090;}.tv-a{color:#FAC775;}.tv-w{color:rgba(255,255,255,0.8);}

/* HERO */
.hero{background:linear-gradient(160deg,#1a1a08 0%,#3a3a1a 50%,#252512 100%);padding:36px 48px 28px;position:relative;overflow:hidden;}
.breadcrumb{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:16px;display:flex;align-items:center;gap:6px;}
.bc-sep{color:rgba(255,255,255,0.12);}.bc-here{color:rgba(255,255,255,0.55);}
.hero-inner{display:flex;gap:32px;align-items:flex-start;position:relative;}
.entity-identity{flex:1;}
.entity-icon-wrap{width:84px;height:84px;border-radius:10px;border:1px solid rgba(255,255,255,0.15);overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:36px;background:#3a3a1a;}
.entity-name{font-family:'Playfair Display',serif;font-size:32px;font-weight:900;color:white;line-height:0.95;margin-bottom:4px;}
.entity-full{font-family:'Source Serif 4',serif;font-size:12px;font-style:italic;color:rgba(255,255,255,0.4);margin-bottom:5px;}
.entity-sub{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.25);}
.entity-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;}
.etag{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 9px;border-radius:100px;border:1px solid;}
.etag-sanction{color:rgba(255,130,130,0.9);border-color:rgba(255,130,130,0.3);background:rgba(255,100,100,0.08);}
.etag-mil{color:rgba(184,134,11,0.9);border-color:rgba(184,134,11,0.3);background:rgba(184,134,11,0.08);}
.etag-grey{color:rgba(255,255,255,0.45);border-color:rgba(255,255,255,0.1);background:rgba(255,255,255,0.04);}
.hero-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.07);border-radius:10px;overflow:hidden;margin-top:18px;}
.hs{background:rgba(255,255,255,0.02);padding:10px 13px;}
.hs-num{font-family:'Libre Baskerville',serif;font-size:18px;font-weight:700;color:white;}
.hs-label{font-family:'JetBrains Mono',monospace;font-size:6px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.25);margin-top:3px;line-height:1.5;}
.hero-actions{display:flex;flex-direction:column;gap:8px;min-width:160px;}
.btn-p{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:none;cursor:pointer;background:var(--gilt);color:white;}
.btn-s{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(255,255,255,0.18);cursor:pointer;background:transparent;color:rgba(255,255,255,0.65);}
.btn-submit{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid rgba(250,199,117,0.4);cursor:pointer;background:rgba(250,199,117,0.1);color:rgba(250,199,117,0.9);}

/* TABS */
.page-tabs{background:var(--white);border-bottom:1px solid var(--rule);position:sticky;top:60px;z-index:100;}
.tabs-inner{display:flex;padding:0 48px;gap:0;overflow-x:auto;}
.tab{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:14px 15px;cursor:pointer;color:var(--ink-mut);border-bottom:2px solid transparent;white-space:nowrap;transition:color 0.12s;}
.tab:hover{color:var(--gae);}
.tab.active{color:var(--gae);border-bottom-color:var(--gae);font-weight:600;}
.tab.t-submit{color:var(--amber);}
.tab.t-submit:hover,.tab.t-submit.active{color:var(--amber);border-bottom-color:var(--amber);}

/* BODY */
.page-body{display:grid;grid-template-columns:1fr 272px;gap:0;max-width:1380px;margin:0 auto;padding:0 48px 60px;align-items:start;}
.page-main{padding:32px 28px 0 0;min-width:0;}
.page-sidebar{padding:32px 0 0;border-left:1px solid var(--rule);padding-left:22px;}

.tab-panel{display:none;}
.tab-panel.active{display:block;}

/* SHARED */
.sec{margin-bottom:38px;}
.sec+.sec{padding-top:28px;border-top:1.5px solid rgba(14,26,46,0.1);}
.sec-ey{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt-dk);margin-bottom:5px;}
.sec-headline{font-family:'Playfair Display',serif;font-size:24px;font-weight:900;color:#0e0c08;line-height:1.1;margin-bottom:8px;}
.sec-lead{font-family:'Source Serif 4',serif;font-size:13.5px;color:#5a5448;line-height:1.75;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--rule);}
.plain-summary{background:var(--gae-p);border:1px solid var(--gae-r);border-radius:8px;padding:12px 14px;font-family:'Source Serif 4',serif;font-size:13px;color:var(--ink-mid);line-height:1.7;margin-bottom:16px;}
.note-card{background:var(--amber-p);border:1px solid var(--amber-r);border-radius:8px;padding:10px 14px;display:flex;gap:10px;align-items:flex-start;margin-bottom:12px;}
.nc-icon{font-size:14px;flex-shrink:0;}
.nc-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-mid);line-height:1.65;}

/* MONEY FLOW */
.money-flow{background:linear-gradient(135deg,#0e1a08,#1a3a1a);border-radius:10px;padding:18px 22px;margin-bottom:16px;}
.mf-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:10px;}
.mf-flow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.mf-node{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);border-radius:6px;padding:8px 12px;text-align:center;}
.mf-icon{font-size:16px;margin-bottom:3px;}
.mf-name{font-family:'JetBrains Mono',monospace;font-size:8px;color:rgba(255,255,255,0.7);white-space:nowrap;}
.mf-arrow{font-size:16px;color:rgba(255,255,255,0.25);}
.mf-leak{background:rgba(139,32,32,0.3);border-color:rgba(200,60,60,0.4);}
.mf-leak .mf-name{color:rgba(255,150,150,0.8);}
.mf-footnote{margin-top:10px;font-family:'Source Serif 4',serif;font-size:11.5px;color:rgba(255,255,255,0.4);font-style:italic;}

/* SECTOR GRID */
.sector-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:16px;}
.sector-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:12px 14px;}
.sc-icon{font-size:20px;margin-bottom:6px;}
.sc-name{font-family:'Libre Baskerville',serif;font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:3px;}
.sc-desc{font-family:'Nunito',sans-serif;font-size:11px;color:var(--ink-soft);line-height:1.5;margin-bottom:5px;}
.sc-subs{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);line-height:1.6;}

/* FAMILY TABLE */
.family-table{width:100%;border-collapse:collapse;border-radius:10px;overflow:hidden;border:1px solid var(--rule);}
.family-table thead tr{background:var(--ink);}
.family-table th{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.45);padding:9px 14px;text-align:left;font-weight:400;}
.family-table td{padding:11px 14px;border-bottom:1px solid var(--rule-lt);vertical-align:top;}
.family-table tr:last-child td{border-bottom:none;}
.family-table tr:hover td{background:var(--bg);}
.ft-name{font-family:'Libre Baskerville',serif;font-size:12.5px;font-weight:700;color:var(--ink);margin-bottom:2px;}
.ft-role{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-mut);}
.ft-badge{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.06em;text-transform:uppercase;padding:1px 6px;border-radius:3px;display:inline-block;margin-right:4px;}
.fb-dead{color:#555;background:#f0f0f0;border:1px solid #ddd;}
.fb-active{color:var(--gae);background:var(--gae-p);border:1px solid var(--gae-r);}
.fb-sanction{color:var(--red);background:var(--red-p);border:1px solid var(--red-r);}
.fb-family{color:var(--amber);background:var(--amber-p);border:1px solid var(--amber-r);}
.ft-note{font-family:'Nunito',sans-serif;font-size:11.5px;color:var(--ink-soft);line-height:1.55;margin-top:3px;}

/* ASSETS PANEL */
.assets-panel{background:linear-gradient(135deg,var(--red-p),var(--white));border:1px solid var(--red-r);border-radius:10px;padding:16px 20px;margin-bottom:14px;}
.ap-title{font-family:'Playfair Display',serif;font-size:15px;font-weight:700;color:var(--ink);margin-bottom:6px;}
.ap-text{font-family:'Source Serif 4',serif;font-size:12.5px;color:var(--ink-soft);line-height:1.7;margin-bottom:12px;}
.ap-numbers{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;}
.ap-num{background:var(--white);border:1px solid var(--rule);border-radius:6px;padding:10px 12px;text-align:center;}
.ap-val{font-family:'Libre Baskerville',serif;font-size:19px;font-weight:700;color:var(--red);margin-bottom:2px;}
.ap-label{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);line-height:1.5;}

/* ══ SUBMIT TAB ══ */
.submit-hero{background:linear-gradient(160deg,#1a1a08,#3a3a1a);border-radius:12px;padding:22px 26px;margin-bottom:20px;}
.sh-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.18em;text-transform:uppercase;color:rgba(255,255,255,0.35);margin-bottom:6px;}
.sh-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:900;color:white;line-height:1.1;margin-bottom:8px;}
.sh-text{font-family:'Source Serif 4',serif;font-size:13px;color:rgba(255,255,255,0.6);line-height:1.7;margin-bottom:16px;}
.sh-why-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:16px;}
.sh-why{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:8px;padding:11px 13px;}
.sw-icon{font-size:16px;margin-bottom:5px;}
.sw-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.4);margin-bottom:3px;}
.sw-text{font-family:'Nunito',sans-serif;font-size:11.5px;color:rgba(255,255,255,0.65);line-height:1.5;}

/* SUBMIT FORM */
.submit-form{background:var(--white);border:1px solid var(--rule);border-radius:10px;overflow:hidden;margin-bottom:16px;}
.sf-section{padding:18px 20px;border-bottom:1px solid var(--rule);}
.sf-section:last-child{border-bottom:none;}
.sf-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.sf-required{font-size:6.5px;color:var(--red);background:var(--red-p);border:1px solid var(--red-r);padding:1px 5px;border-radius:3px;}
.sf-optional{font-size:6.5px;color:var(--ink-mut);background:var(--bg);border:1px solid var(--rule);padding:1px 5px;border-radius:3px;}

/* Category pills */
.sf-pills{display:flex;gap:6px;flex-wrap:wrap;}
.sf-pill{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:5px 11px;border-radius:100px;border:1px solid var(--rule);background:transparent;color:var(--ink-mut);cursor:pointer;transition:all 0.12s;}
.sf-pill.selected,.sf-pill:hover{background:var(--gae);color:white;border-color:var(--gae);}

/* Upload zone */
.upload-zone{border:2px dashed var(--rule);border-radius:10px;padding:32px;text-align:center;cursor:pointer;transition:all 0.15s;background:var(--bg);}
.upload-zone:hover{border-color:var(--gilt);background:var(--gilt-pl);}
.uz-icon{font-size:32px;margin-bottom:8px;}
.uz-title{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:var(--ink);margin-bottom:5px;}
.uz-sub{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-mut);margin-bottom:10px;}
.uz-types{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;color:var(--ink-mut);}
.uz-btn{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:9px 18px;border-radius:6px;border:1px solid var(--gilt-rul);background:var(--gilt-pl);color:var(--gilt-dk);cursor:pointer;margin-top:12px;display:inline-block;}

/* Location & context inputs */
.sf-input{width:100%;border:1px solid var(--rule);border-radius:6px;padding:10px 13px;font-family:'Nunito',sans-serif;font-size:13px;color:var(--ink);outline:none;background:var(--bg);}
.sf-input:focus{border-color:var(--gae);}
.sf-textarea{width:100%;border:1px solid var(--rule);border-radius:6px;padding:10px 13px;font-family:'Source Serif 4',serif;font-size:13px;color:var(--ink);resize:vertical;min-height:80px;outline:none;background:var(--bg);}
.sf-textarea:focus{border-color:var(--gae);}
.sf-input-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.sf-input-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:4px;margin-top:10px;}
.sf-input-label:first-child{margin-top:0;}

/* Anon toggle */
.anon-row{display:flex;align-items:center;gap:10px;}
.anon-toggle{width:36px;height:20px;background:var(--green);border-radius:100px;position:relative;cursor:pointer;flex-shrink:0;}
.anon-toggle::after{content:'';position:absolute;right:3px;top:3px;width:14px;height:14px;border-radius:50%;background:white;}
.anon-text{font-family:'Source Serif 4',serif;font-size:12px;color:var(--ink-soft);line-height:1.5;}

/* Submit button */
.sf-submit-row{display:flex;align-items:center;justify-content:space-between;}
.sf-submit{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.1em;text-transform:uppercase;padding:11px 24px;border-radius:6px;border:none;cursor:pointer;background:var(--gae);color:white;}
.sf-caveat{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);max-width:280px;line-height:1.5;}

/* SUBMITTED GRID */
.submitted-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.submitted-title{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:var(--ink);}
.submitted-count{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--ink-mut);}
.evidence-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:20px;}
.evidence-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;overflow:hidden;cursor:pointer;transition:box-shadow 0.12s;}
.evidence-card:hover{box-shadow:0 3px 14px rgba(27,58,107,0.1);}
.ec-media{background:var(--bg);height:120px;display:flex;align-items:center;justify-content:center;position:relative;}
.ec-media-icon{font-size:32px;opacity:0.3;}
.ec-type-badge{position:absolute;top:7px;left:7px;font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:3px;color:white;}
.ecb-photo{background:rgba(14,107,94,0.8);}
.ecb-video{background:rgba(139,26,26,0.8);}
.ecb-receipt{background:rgba(184,134,11,0.8);}
.ec-verified{position:absolute;top:7px;right:7px;font-family:'JetBrains Mono',monospace;font-size:7px;padding:2px 6px;border-radius:3px;background:rgba(21,92,45,0.85);color:white;}
.ec-body{padding:10px 12px;}
.ec-category{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;color:var(--gae);margin-bottom:4px;}
.ec-desc{font-family:'Nunito',sans-serif;font-size:11.5px;color:var(--ink);line-height:1.5;margin-bottom:5px;}
.ec-meta{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);}
.ec-actions{display:flex;gap:6px;margin-top:6px;}
.ec-act{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.07em;text-transform:uppercase;padding:3px 8px;border-radius:100px;border:1px solid var(--rule);background:transparent;color:var(--ink-mut);cursor:pointer;}
.ec-act.verify{color:var(--green);border-color:var(--green-r);}

/* SIDEBAR */
.sb-block{margin-bottom:22px;}
.sb-block+.sb-block{padding-top:18px;border-top:1px solid var(--rule);}
.sb-ey{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:4px;}
.sb-title{font-family:'Libre Baskerville',serif;font-size:13.5px;font-weight:700;color:var(--gae);margin-bottom:10px;}
.data-row{display:flex;justify-content:space-between;align-items:baseline;padding:5px 0;border-bottom:1px solid var(--rule-lt);}
.data-row:last-child{border-bottom:none;}
.dr-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.07em;text-transform:uppercase;color:var(--ink-mut);}
.dr-val{font-family:'Nunito',sans-serif;font-size:12px;font-weight:600;color:var(--ink);text-align:right;max-width:58%;}
.dr-val.red{color:var(--red);}
.quick-link{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--rule-lt);font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.07em;color:var(--gae);cursor:pointer;}
.quick-link:last-child{border-bottom:none;}
.sub-list{border:1px solid var(--rule);border-radius:8px;overflow:hidden;}
.sub-item{padding:7px 10px;border-bottom:1px solid var(--rule-lt);display:flex;align-items:center;gap:8px;}
.sub-item:last-child{border-bottom:none;}
