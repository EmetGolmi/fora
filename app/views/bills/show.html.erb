<% content_for(:title) { "#{@bill.identifier} — #{truncate(@bill.title, length: 60)} — FORA" } %>

<% content_for :head do %>
<style>
  .bill-full-text-link:hover { background:rgba(255,255,255,0.13) !important; border-color:rgba(255,255,255,0.3) !important; }
  .back-link:hover { color:rgba(255,255,255,0.7) !important; }

  /* ── Civic Voice ── */
  .civic-voice-section { margin:2rem 0 1rem; padding:1.5rem 0 0; border-top:1px solid rgba(27,58,107,0.1); }
  .cv-header { font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px; display:flex; align-items:center; gap:6px; }
  .cv-title { font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin-bottom:1.25rem; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09); }
  .cv-stance-label, .cv-persp-label { font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.16em; text-transform:uppercase; color:#8a9ab8; margin-bottom:0.5rem; }
  .cv-stance-row { display:flex; gap:8px; margin-bottom:1.25rem; flex-wrap:wrap; }
  .cv-stance-btn { flex:1; min-width:100px; padding:10px 8px; border-radius:100px; border:1.5px solid #dde5f5; background:white; color:#5a6e8a; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.1em; text-transform:uppercase; font-weight:700; cursor:pointer; transition:all 0.12s; }
  .cv-stance-btn:hover { border-color:#3a6abf; color:#1b3a6b; }
  .cv-stance-btn.active-support   { border-color:#2e7d52; background:#e8f5ee; color:#2e7d52; }
  .cv-stance-btn.active-oppose    { border-color:#8b1a1a; background:#faeaea; color:#8b1a1a; }
  .cv-stance-btn.active-amend     { border-color:#b8860b; background:#fff8e6; color:#b8860b; }
  .cv-stance-btn.active-undecided { border-color:#3a6abf; background:#edf1fb; color:#1b3a6b; }
  .cv-persp-row { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:1.25rem; }
  .cv-persp-chip { padding:6px 12px; border-radius:100px; border:1.5px solid #dde5f5; background:white; color:#5a6e8a; font-family:'Nunito',sans-serif; font-size:12px; cursor:pointer; transition:all 0.12s; }
  .cv-persp-chip:hover { border-color:#3a6abf; color:#1b3a6b; }
  .cv-persp-chip.active { border-color:#b8860b; background:#fff8e6; color:#b8860b; }
  .cv-textarea { width:100%; min-height:90px; background:white; border:1.5px solid #dde5f5; border-radius:8px; color:#0e1a2e; font-size:13px; font-family:'Nunito',sans-serif; padding:12px 14px; resize:vertical; margin-bottom:4px; box-sizing:border-box; outline:none; }
  .cv-textarea::placeholder { color:#aab4c8; }
  .cv-textarea:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.08); }
  .cv-char-count { font-family:'JetBrains Mono',monospace; font-size:8px; color:#aab4c8; text-align:right; margin-bottom:10px; }
  .cv-meta-row { display:flex; align-items:center; gap:12px; margin-bottom:1rem; flex-wrap:wrap; }
  .cv-occupation { flex:1; min-width:200px; background:white; border:1.5px solid #dde5f5; border-radius:8px; color:#0e1a2e; font-size:12px; padding:8px 12px; outline:none; box-sizing:border-box; font-family:'Nunito',sans-serif; }
  .cv-occupation::placeholder { color:#aab4c8; }
  .cv-occupation:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.08); }
  .cv-anon-label { display:flex; align-items:center; gap:6px; font-size:12px; color:#5a6e8a; cursor:pointer; white-space:nowrap; font-family:'Nunito',sans-serif; }
  .cv-submit-btn { background:#1b3a6b; color:white; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; font-weight:700; padding:12px 24px; border-radius:7px; border:none; cursor:pointer; transition:all 0.12s; }
  .cv-submit-btn:hover { background:#254f92; }
  .cv-submit-btn:disabled { opacity:0.5; cursor:not-allowed; }
  .cv-error   { color:#8b1a1a; font-family:'Nunito',sans-serif; font-size:12px; margin-top:8px; }
  .cv-success { color:#2e7d52; font-family:'Nunito',sans-serif; font-size:12px; margin-top:8px; }
  .cv-comments-feed { margin-top:2.5rem; padding-top:1.5rem; border-top:1px solid rgba(27,58,107,0.09); }
  .cv-feed-header { font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:1rem; display:flex; align-items:center; gap:6px; }
  .cv-comment { padding:14px 0; border-bottom:1px solid rgba(27,58,107,0.07); }
  .cv-comment:last-child { border-bottom:none; }
  .cv-comment-meta { display:flex; align-items:center; gap:8px; margin-bottom:6px; flex-wrap:wrap; }
  .cv-comment-name { font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#1b3a6b; }
  .cv-stance-badge { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; padding:2px 8px; border-radius:100px; font-weight:700; }
  .cv-stance-badge.support   { background:#e8f5ee; color:#2e7d52; }
  .cv-stance-badge.oppose    { background:#faeaea; color:#8b1a1a; }
  .cv-stance-badge.amend     { background:#fff8e6; color:#b8860b; }
  .cv-stance-badge.undecided { background:#edf1fb; color:#3a6abf; }
  .cv-persp-badge { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.08em; text-transform:uppercase; color:#8a9ab8; }
  .cv-comment-date { font-family:'JetBrains Mono',monospace; font-size:8px; color:#aab4c8; margin-left:auto; }
  .cv-comment-body { font-family:'Nunito',sans-serif; font-size:13px; color:#3a4a5e; line-height:1.65; }
  .cv-loading { font-family:'Nunito',sans-serif; font-size:12px; color:#aab4c8; padding:1rem 0; }
  .cv-empty   { font-family:'Nunito',sans-serif; font-size:13px; color:#8a9ab8; padding:1rem 0; font-style:italic; }

  @media (max-width:600px) {
    .cv-stance-row { gap:6px; }
    .cv-stance-btn { min-width:80px; font-size:8px; }
    .cv-meta-row { flex-direction:column; align-items:flex-start; }
    .cv-occupation { min-width:100%; }
  }
</style>
<% end %>

<%
  jur_label = case @bill.jurisdiction
    when "federal"      then "Federal Legislation"
    when "pennsylvania" then "State Legislation"
    when "philadelphia" then "City Legislation"
    else                     "Local Legislation"
    end

  share_url  = "https://fora.center/bills/#{@bill.id}"
  bill_ref   = @bill.identifier.presence || "This bill"
%>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<div style="background:#1b3a6b; padding:36px 48px 52px; position:relative; overflow:hidden;">

  <div style="position:absolute; right:-60px; top:-80px; width:400px; height:400px; border-radius:50%; border:44px solid rgba(255,255,255,0.02); pointer-events:none;"></div>
  <div style="position:absolute; bottom:0; left:0; right:0; height:26px; display:flex; align-items:center; padding:0 48px; font-size:11px; letter-spacing:0.55em; color:#b8860b; overflow:hidden; white-space:nowrap; pointer-events:none; -webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%); mask-image:linear-gradient(to right,black 92%,transparent 100%);">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>

  <div style="max-width:860px; margin:0 auto; position:relative; z-index:1;">

    <div style="margin-bottom:18px;">
      <a href="javascript:history.back()" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.35); text-decoration:none;">← Back</a>
    </div>

    <% if @bill.identifier.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:clamp(22px,3.5vw,30px); font-weight:700; color:#d4a832; letter-spacing:0.04em; line-height:1; margin-bottom:8px;"><%= @bill.identifier %></div>
    <% end %>

    <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.22em; text-transform:uppercase; color:rgba(255,255,255,0.28); margin-bottom:22px;"><%= jur_label %></div>

    <% title_limit = 216 %>
    <% title_long  = @bill.title.length > title_limit %>
    <h1 style="font-family:'Libre Baskerville',serif; font-size:clamp(20px,3.2vw,30px); font-weight:700; color:white; line-height:1.25; margin:0 0 <%= title_long ? '10px' : '28px' %>; max-width:680px;">
      <span id="bill-title-short"><%= title_long ? @bill.title.first(title_limit) + "…" : @bill.title %></span>
      <% if title_long %>
        <span id="bill-title-full" style="display:none;"><%= @bill.title %></span>
      <% end %>
    </h1>

    <% if title_long %>
      <div style="margin-bottom:18px;">
        <a id="bill-title-expand" href="javascript:void(0)"
           onclick="document.getElementById('bill-title-short').style.display='none'; document.getElementById('bill-title-full').style.display='inline'; this.parentElement.style.display='none';"
           style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.12em; text-transform:uppercase; color:#b8860b; text-decoration:none;">Read full title ↓</a>
      </div>
    <% end %>

    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-top:8px;">
      <% if @bill.status_date %>
        <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.22);">Introduced <%= @bill.status_date.strftime("%b %d, %Y") %></span>
      <% end %>
    </div>

  </div>
</div>

<!-- ── BODY ──────────────────────────────────────────────────────────────── -->
<div style="max-width:860px; margin:0 auto; padding:44px 48px 72px;">

  <!-- What This Bill Does -->
  <div style="margin-bottom:44px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Plain Language</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What This Bill Does</h2>

    <% if @summary.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
      <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @summary %></p>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">AI analysis coming soon — check back shortly.</p>
      </div>
    <% end %>
  </div>

  <% if @bill.full_text_url.present? %>
    <div style="margin-bottom:44px;">
      <a href="<%= @bill.full_text_url %>" target="_blank" rel="noopener"
         style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.12em; text-transform:uppercase; color:#254f92; text-decoration:none; padding:8px 18px; background:white; border:1.5px solid #dde5f5; border-radius:6px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Read the full bill text
      </a>
    </div>
  <% end %>

  <!-- What May Happen -->
  <div style="margin-bottom:52px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Anticipated Effects</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What May Happen</h2>
    <% if @effects.present? %>
      <% if @effects_curated %>
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Editorial</div>
        <% @effects.split("\n\n").each do |para| %>
          <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75; margin-bottom:1.1em;"><%= para %></p>
        <% end %>
      <% else %>
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
        <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @effects %></p>
      <% end %>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">Based on similar legislation, anticipated effects will appear here. FORA never predicts outcomes — only what evidence suggests may be possible.</p>
      </div>
    <% end %>
  </div>

  <!-- Gilt divider -->
  <div style="display:flex; align-items:center; gap:16px; margin-bottom:48px;">
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
    <span style="font-size:10px; color:#b8860b; letter-spacing:0.3em;">★</span>
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
  </div>

  <!-- Civic Voice -->
  <div class="civic-voice-section">
    <div class="cv-header">&#9670; Civic Voice</div>
    <div class="cv-title">Your take on this bill</div>

    <div class="cv-stance-label">Where do you stand?</div>
    <div class="cv-stance-row" id="stance-row">
      <button class="cv-stance-btn" data-stance="support"   onclick="selectStance('support', this)">&#10003; Support</button>
      <button class="cv-stance-btn" data-stance="oppose"    onclick="selectStance('oppose', this)">&#10005; Oppose</button>
      <button class="cv-stance-btn" data-stance="amend"     onclick="selectStance('amend', this)">&#8644; Amend</button>
      <button class="cv-stance-btn" data-stance="undecided" onclick="selectStance('undecided', this)">? Undecided</button>
    </div>

    <div class="cv-persp-label">How do you see it?</div>
    <div class="cv-persp-row" id="persp-row">
      <button class="cv-persp-chip" data-type="affects_property" onclick="selectPersp('affects_property', this)">&#127968; Affects my property</button>
      <button class="cv-persp-chip" data-type="follow_money"     onclick="selectPersp('follow_money', this)">&#128269; Follow the money</button>
      <button class="cv-persp-chip" data-type="history_matters"  onclick="selectPersp('history_matters', this)">&#127963; History matters</button>
      <button class="cv-persp-chip" data-type="due_process"      onclick="selectPersp('due_process', this)">&#9878; Due process</button>
      <button class="cv-persp-chip" data-type="what_may_happen"  onclick="selectPersp('what_may_happen', this)">&#8594; What may happen</button>
    </div>

    <textarea id="cv-body" class="cv-textarea"
              placeholder="What do you see coming? What do you know from your block, your trade, your history here?"
              maxlength="2000"></textarea>
    <div class="cv-char-count"><span id="cv-char-count">0</span> / 2000</div>

    <div class="cv-meta-row">
      <input type="text" id="cv-occupation" class="cv-occupation"
             placeholder="Your role (optional — e.g. contractor, homeowner, architect)">
      <label class="cv-anon-label">
        <input type="checkbox" id="cv-anon" checked>
        Post anonymously
      </label>
    </div>

    <button class="cv-submit-btn" onclick="submitBillComment()" id="cv-submit">Share your take &#8594;</button>
    <div id="cv-error"   class="cv-error"   style="display:none;"></div>
    <div id="cv-success" class="cv-success" style="display:none;"></div>
  </div>

  <div id="cv-comments-feed" class="cv-comments-feed">
    <div class="cv-feed-header">&#9670; What people are saying</div>
    <div id="cv-comments-list"><div class="cv-loading">Loading takes...</div></div>
  </div>

</div>

<script>
(function() {
  var billId      = '<%= @bill.id %>';
  var commentsUrl = '/bills/' + billId + '/comments';
  var csrfToken   = document.querySelector('meta[name="csrf-token"]') && document.querySelector('meta[name="csrf-token"]').content;
  var selectedStance = null;
  var selectedPersp  = null;

  window.selectStance = function(stance, btn) {
    document.querySelectorAll('.cv-stance-btn').forEach(function(b) { b.className = 'cv-stance-btn'; });
    btn.classList.add('active-' + stance);
    selectedStance = stance;
  };

  window.selectPersp = function(type, btn) {
    document.querySelectorAll('.cv-persp-chip').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    selectedPersp = type;
  };

  var bodyEl = document.getElementById('cv-body');
  if (bodyEl) {
    bodyEl.addEventListener('input', function() {
      document.getElementById('cv-char-count').textContent = this.value.length;
    });
  }

  window.submitBillComment = function() {
    var body      = bodyEl && bodyEl.value && bodyEl.value.trim();
    var errorEl   = document.getElementById('cv-error');
    var successEl = document.getElementById('cv-success');
    var submitBtn = document.getElementById('cv-submit');

    errorEl.style.display   = 'none';
    successEl.style.display = 'none';

    if (!selectedStance) {
      errorEl.textContent    = 'Please select where you stand before posting.';
      errorEl.style.display  = 'block';
      return;
    }
    if (!selectedPersp) {
      errorEl.textContent    = 'Please choose how you see it.';
      errorEl.style.display  = 'block';
      return;
    }
    if (!body || body.length < 10) {
      errorEl.textContent    = 'Please write at least 10 characters.';
      errorEl.style.display  = 'block';
      return;
    }

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Posting...';

    var occupationEl = document.getElementById('cv-occupation');
    var anonEl       = document.getElementById('cv-anon');

    fetch(commentsUrl, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      body: JSON.stringify({
        bill_comment: {
          stance:           selectedStance,
          perspective_type: selectedPersp,
          body:             body,
          occupation:       occupationEl && occupationEl.value && occupationEl.value.trim() || null,
          anonymous:        anonEl ? anonEl.checked : true
        }
      })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        successEl.textContent    = 'Your take has been posted. Thank you for participating.';
        successEl.style.display  = 'block';
        bodyEl.value             = '';
        document.getElementById('cv-char-count').textContent = '0';
        if (occupationEl) occupationEl.value = '';
        document.querySelectorAll('.cv-stance-btn').forEach(function(b) { b.className = 'cv-stance-btn'; });
        document.querySelectorAll('.cv-persp-chip').forEach(function(b) { b.classList.remove('active'); });
        selectedStance         = null;
        selectedPersp          = null;
        submitBtn.disabled     = false;
        submitBtn.textContent  = 'Share your take \u2192';
        prependComment(data.comment);
      } else {
        errorEl.textContent   = (data.errors && data.errors.join(', ')) || 'Something went wrong.';
        errorEl.style.display = 'block';
        submitBtn.disabled    = false;
        submitBtn.textContent = 'Share your take \u2192';
      }
    })
    .catch(function() {
      errorEl.textContent   = 'Network error. Please try again.';
      errorEl.style.display = 'block';
      submitBtn.disabled    = false;
      submitBtn.textContent = 'Share your take \u2192';
    });
  };

  var perspLabels = {
    affects_property: 'Affects my property',
    follow_money:     'Follow the money',
    history_matters:  'History matters',
    due_process:      'Due process',
    what_may_happen:  'What may happen'
  };

  function escHtml(s) {
    return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function renderComment(c) {
    return '<div class="cv-comment">' +
      '<div class="cv-comment-meta">' +
        '<span class="cv-comment-name">' + escHtml(c.display_name || 'Resident') + '</span>' +
        '<span class="cv-stance-badge ' + escHtml(c.stance) + '">' + escHtml(c.stance) + '</span>' +
        '<span class="cv-persp-badge">' + escHtml(perspLabels[c.perspective_type] || c.perspective_type) + '</span>' +
        '<span class="cv-comment-date">' + escHtml(c.created_at) + '</span>' +
      '</div>' +
      '<div class="cv-comment-body">' + escHtml(c.body) + '</div>' +
    '</div>';
  }

  function prependComment(c) {
    var list  = document.getElementById('cv-comments-list');
    var empty = list.querySelector('.cv-empty, .cv-loading');
    if (empty) empty.remove();
    list.insertAdjacentHTML('afterbegin', renderComment(c));
  }

  function loadComments() {
    fetch(commentsUrl)
      .then(function(r) { return r.json(); })
      .then(function(comments) {
        var list = document.getElementById('cv-comments-list');
        if (!comments.length) {
          list.innerHTML = '<div class="cv-empty">No takes yet. Be the first.</div>';
          return;
        }
        list.innerHTML = comments.map(renderComment).join('');
      })
      .catch(function() {
        var list = document.getElementById('cv-comments-list');
        if (list) list.innerHTML = '<div class="cv-empty">Could not load takes.</div>';
      });
  }

  document.addEventListener('DOMContentLoaded', loadComments);
})();
</script>
