<% content_for(:title) { "#{@bill.identifier} — #{truncate(@bill.title, length: 60)} — FORA" } %>

<% content_for :head do %>
<style>
  .bill-full-text-link:hover { background:rgba(255,255,255,0.13) !important; border-color:rgba(255,255,255,0.3) !important; }
  .back-link:hover { color:rgba(255,255,255,0.7) !important; }

  /* ── Civic Voice ── */
  .civic-voice-wrap { margin:0; padding-bottom:1.5rem; border-bottom:1px solid rgba(255,255,255,0.1); }

  .cv-stance-row { display:flex; gap:8px; margin-bottom:1.25rem; flex-wrap:wrap; }
  .cv-stance-btn {
    flex:1; min-width:90px; padding:9px 8px;
    border-radius:100px; border:1px solid rgba(255,255,255,0.15);
    background:transparent; color:rgba(255,255,255,0.6);
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:0.1em; text-transform:uppercase;
    font-weight:700; cursor:pointer; transition:all 0.12s;
  }
  .cv-stance-btn:hover { border-color:rgba(255,255,255,0.4); color:white; }
  .cv-stance-btn.active-support   { border-color:#4caf7d; background:rgba(76,175,125,0.15); color:#4caf7d; }
  .cv-stance-btn.active-oppose    { border-color:#e57373; background:rgba(229,115,115,0.15); color:#e57373; }
  .cv-stance-btn.active-amend     { border-color:#ffb74d; background:rgba(255,183,77,0.15); color:#ffb74d; }
  .cv-stance-btn.active-undecided { border-color:rgba(255,255,255,0.4); color:white; background:rgba(255,255,255,0.08); }

  .cv-persp-row { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:1.25rem; }
  .cv-persp-chip {
    padding:6px 12px; border-radius:100px;
    border:1px solid rgba(255,255,255,0.15);
    background:transparent; color:rgba(255,255,255,0.55);
    font-size:12px; cursor:pointer; transition:all 0.12s;
  }
  .cv-persp-chip:hover { border-color:rgba(255,255,255,0.4); color:white; }
  .cv-persp-chip.active { border-color:var(--gilt,#b8860b); background:rgba(184,134,11,0.15); color:#d4a832; }

  .cv-submit-btn {
    background:var(--gilt,#b8860b); color:#0e1a2e;
    font-family:'JetBrains Mono',monospace; font-size:10px;
    letter-spacing:0.12em; text-transform:uppercase;
    font-weight:700; padding:12px 24px; border-radius:7px;
    border:none; cursor:pointer; transition:all 0.12s;
  }
  .cv-submit-btn:hover { background:#d4a832; }
  .cv-submit-btn:disabled { opacity:0.5; cursor:not-allowed; }

  .cv-error   { color:#e57373; font-size:12px; margin-top:8px; }
  .cv-success { color:#4caf7d; font-size:12px; margin-top:8px; }

  .cv-feed { margin-top:2rem; padding-top:1.5rem; border-top:1px solid rgba(255,255,255,0.1); }
  .cv-feed-header {
    font-family:'JetBrains Mono',monospace; font-size:11px;
    letter-spacing:0.14em; text-transform:uppercase;
    color:var(--gilt,#b8860b); margin-bottom:1rem;
  }
  .cv-comment { padding:14px 0; border-bottom:1px solid rgba(255,255,255,0.08); }
  .cv-comment:last-child { border-bottom:none; }
  .cv-comment-meta { display:flex; align-items:center; gap:8px; margin-bottom:6px; flex-wrap:wrap; }
  .cv-comment-name { font-size:12px; font-weight:700; color:rgba(255,255,255,0.8); }
  .cv-stance-badge {
    font-family:'JetBrains Mono',monospace; font-size:8px;
    letter-spacing:0.1em; text-transform:uppercase;
    padding:2px 8px; border-radius:100px; font-weight:700;
  }
  .cv-stance-badge.support   { background:rgba(76,175,125,0.2); color:#4caf7d; }
  .cv-stance-badge.oppose    { background:rgba(229,115,115,0.2); color:#e57373; }
  .cv-stance-badge.amend     { background:rgba(255,183,77,0.2); color:#ffb74d; }
  .cv-stance-badge.undecided { background:rgba(255,255,255,0.1); color:rgba(255,255,255,0.5); }
  .cv-persp-label {
    font-family:'JetBrains Mono',monospace; font-size:8px;
    letter-spacing:0.08em; text-transform:uppercase;
    color:rgba(255,255,255,0.35);
  }
  .cv-comment-date { font-family:'JetBrains Mono',monospace; font-size:9px; color:rgba(255,255,255,0.3); margin-left:auto; }
  .cv-comment-body { font-size:13px; color:rgba(255,255,255,0.78); line-height:1.6; }
  .cv-empty { font-size:13px; color:rgba(255,255,255,0.4); padding:1rem 0; font-style:italic; }
  .cv-char-count { font-family:'JetBrains Mono',monospace; font-size:9px; color:rgba(255,255,255,0.3); text-align:right; margin-bottom:10px; }

  @media (max-width:600px) {
    .cv-stance-row { gap:6px; }
    .cv-stance-btn { min-width:80px; font-size:8px; }
  }
</style>
<% end %>

<%
  jur_label = case @bill.jurisdiction
    when "federal"      then "Federal Legislation"
    when "pennsylvania" then "State Legislation"
    when "philadelphia" then "City Legislation"
    else                     "Local Legislation"
    end

  share_url  = "https://fora.center/bills/#{@bill.id}"
  bill_ref   = @bill.identifier.presence || "This bill"
%>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<div style="background:#1b3a6b; padding:36px 48px 52px; position:relative; overflow:hidden;">

  <div style="position:absolute; right:-60px; top:-80px; width:400px; height:400px; border-radius:50%; border:44px solid rgba(255,255,255,0.02); pointer-events:none;"></div>
  <div style="position:absolute; bottom:0; left:0; right:0; height:26px; display:flex; align-items:center; padding:0 48px; font-size:11px; letter-spacing:0.55em; color:#b8860b; overflow:hidden; white-space:nowrap; pointer-events:none; -webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%); mask-image:linear-gradient(to right,black 92%,transparent 100%);">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>

  <div style="max-width:860px; margin:0 auto; position:relative; z-index:1;">

    <div style="margin-bottom:18px;">
      <a href="javascript:history.back()" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.35); text-decoration:none;">← Back</a>
    </div>

    <% if @bill.identifier.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:clamp(22px,3.5vw,30px); font-weight:700; color:#d4a832; letter-spacing:0.04em; line-height:1; margin-bottom:8px;"><%= @bill.identifier %></div>
    <% end %>

    <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.22em; text-transform:uppercase; color:rgba(255,255,255,0.28); margin-bottom:22px;"><%= jur_label %></div>

    <% title_limit = 216 %>
    <% title_long  = @bill.title.length > title_limit %>
    <h1 style="font-family:'Libre Baskerville',serif; font-size:clamp(20px,3.2vw,30px); font-weight:700; color:white; line-height:1.25; margin:0 0 <%= title_long ? '10px' : '28px' %>; max-width:680px;">
      <span id="bill-title-short"><%= title_long ? @bill.title.first(title_limit) + "…" : @bill.title %></span>
      <% if title_long %>
        <span id="bill-title-full" style="display:none;"><%= @bill.title %></span>
      <% end %>
    </h1>

    <% if title_long %>
      <div style="margin-bottom:18px;">
        <a id="bill-title-expand" href="javascript:void(0)"
           onclick="document.getElementById('bill-title-short').style.display='none'; document.getElementById('bill-title-full').style.display='inline'; this.parentElement.style.display='none';"
           style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.12em; text-transform:uppercase; color:#b8860b; text-decoration:none;">Read full title ↓</a>
      </div>
    <% end %>

    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-top:8px;">
      <% if @bill.status_date %>
        <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.22);">Introduced <%= @bill.status_date.strftime("%b %d, %Y") %></span>
      <% end %>
    </div>

  </div>
</div>

<!-- ── BODY ──────────────────────────────────────────────────────────────── -->
<div style="max-width:860px; margin:0 auto; padding:44px 48px 72px;">

  <!-- What This Bill Does -->
  <div style="margin-bottom:44px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Plain Language</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What This Bill Does</h2>

    <% if @summary.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
      <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @summary %></p>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">AI analysis coming soon — check back shortly.</p>
      </div>
    <% end %>
  </div>

  <% if @bill.full_text_url.present? %>
    <div style="margin-bottom:44px;">
      <a href="<%= @bill.full_text_url %>" target="_blank" rel="noopener"
         style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.12em; text-transform:uppercase; color:#254f92; text-decoration:none; padding:8px 18px; background:white; border:1.5px solid #dde5f5; border-radius:6px;">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Read the full bill text
      </a>
    </div>
  <% end %>

  <!-- What May Happen -->
  <div style="margin-bottom:52px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Anticipated Effects</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What May Happen</h2>
    <% if @effects.present? %>
      <% if @effects_curated %>
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Editorial</div>
        <% @effects.split("\n\n").each do |para| %>
          <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75; margin-bottom:1.1em;"><%= para %></p>
        <% end %>
      <% else %>
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
        <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @effects %></p>
      <% end %>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">Based on similar legislation, anticipated effects will appear here. FORA never predicts outcomes — only what evidence suggests may be possible.</p>
      </div>
    <% end %>
  </div>

  <!-- Gilt divider -->
  <div style="display:flex; align-items:center; gap:16px; margin-bottom:48px;">
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
    <span style="font-size:10px; color:#b8860b; letter-spacing:0.3em;">★</span>
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
  </div>

  <%# ── CIVIC VOICE ──────────────────────────────────── %>
  <div style="background:#1b3a6b;border-radius:12px;padding:2rem 2rem 2.5rem;margin-top:0;">
  <div class="civic-voice-wrap">
    <div style="font-family:'JetBrains Mono',monospace;font-size:11px;
                letter-spacing:0.14em;text-transform:uppercase;
                color:var(--gilt,#b8860b);margin-bottom:0.5rem;
                display:flex;align-items:center;gap:6px;">
      &#9670; Civic Voice
    </div>
    <div style="font-family:'Libre Baskerville',serif;font-size:20px;
                font-weight:700;color:white;margin-bottom:1.25rem;">
      Your take on this bill
    </div>

    <%# Stance selector %>
    <div style="font-family:'JetBrains Mono',monospace;font-size:9px;
                letter-spacing:0.12em;text-transform:uppercase;
                color:rgba(255,255,255,0.5);margin-bottom:0.5rem;">
      Where do you stand?
    </div>
    <div class="cv-stance-row">
      <button class="cv-stance-btn" onclick="selectStance('support', this)">&#10003; Support</button>
      <button class="cv-stance-btn" onclick="selectStance('oppose',  this)">&#10005; Oppose</button>
      <button class="cv-stance-btn" onclick="selectStance('amend',   this)">&#8644; Amend</button>
      <button class="cv-stance-btn" onclick="selectStance('undecided',this)">? Undecided</button>
    </div>

    <%# Perspective chips %>
    <div style="font-family:'JetBrains Mono',monospace;font-size:9px;
                letter-spacing:0.12em;text-transform:uppercase;
                color:rgba(255,255,255,0.5);margin-bottom:0.5rem;">
      How do you see it?
    </div>
    <div class="cv-persp-row">
      <button class="cv-persp-chip" onclick="selectPersp('personal_stake', this)">&#127968; This affects me directly</button>
      <button class="cv-persp-chip" onclick="selectPersp('community_impact', this)">&#128106; This affects all of us</button>
      <button class="cv-persp-chip" onclick="selectPersp('fiscal_accountability', this)">&#128200; Fiscal accountability</button>
      <button class="cv-persp-chip" onclick="selectPersp('historical_context', this)">&#127963; Philadelphia has been here before</button>
      <button class="cv-persp-chip" onclick="selectPersp('prediction', this)">&#8594; Here's what I think happens next</button>
    </div>

    <%# Body %>
    <textarea id="cv-body"
              style="width:100%;min-height:90px;
                     background:rgba(255,255,255,0.06);
                     border:1px solid rgba(255,255,255,0.15);
                     border-radius:8px;color:white;font-size:13px;
                     font-family:'Nunito',sans-serif;padding:12px 14px;
                     resize:vertical;margin-bottom:4px;box-sizing:border-box;"
              placeholder="What do you see coming? What do you know from your block, your trade, your history here?"
              maxlength="2000"></textarea>
    <div class="cv-char-count"><span id="cv-char-count">0</span> / 2000</div>

    <%# Meta row %>
    <div style="display:flex;align-items:center;gap:12px;
                margin-bottom:1rem;flex-wrap:wrap;">
      <input type="text" id="cv-occupation"
             style="flex:1;min-width:200px;
                    background:rgba(255,255,255,0.06);
                    border:1px solid rgba(255,255,255,0.15);
                    border-radius:8px;color:white;
                    font-size:12px;padding:8px 12px;"
             placeholder="Your role (optional — e.g. contractor, homeowner, architect)">
      <label style="display:flex;align-items:center;gap:6px;
                    font-size:12px;color:rgba(255,255,255,0.5);
                    cursor:pointer;white-space:nowrap;">
        <input type="checkbox" id="cv-anon" checked> Post anonymously
      </label>
    </div>

    <button class="cv-submit-btn" id="cv-submit"
            onclick="submitBillComment()">
      Share your take &#8594;
    </button>
    <div id="cv-error"   class="cv-error"   style="display:none;"></div>
    <div id="cv-success" class="cv-success" style="display:none;"></div>
  </div>

  <%# ── COMMENTS FEED ─────────────────────────────────── %>
  <div class="cv-feed">
    <div class="cv-feed-header">&#9670; What people are saying</div>
    <div id="cv-comments-list">
      <div class="cv-empty">Loading takes...</div>
    </div>
  </div>
  </div><%# /dark container %>

</div>

<script>
(function() {
  var billId      = '<%= @bill.id %>';
  var commentsUrl = '/bills/' + billId + '/comments';
  var csrfToken   = document.querySelector('meta[name="csrf-token"]')?.content;
  var selectedStance = null;
  var selectedPersp  = null;

  window.selectStance = function(stance, btn) {
    document.querySelectorAll('.cv-stance-btn').forEach(function(b) {
      b.className = 'cv-stance-btn';
    });
    btn.classList.add('active-' + stance);
    selectedStance = stance;
  };

  window.selectPersp = function(type, btn) {
    document.querySelectorAll('.cv-persp-chip').forEach(function(b) {
      b.classList.remove('active');
    });
    btn.classList.add('active');
    selectedPersp = type;
  };

  var bodyEl = document.getElementById('cv-body');
  if (bodyEl) {
    bodyEl.addEventListener('input', function() {
      var el = document.getElementById('cv-char-count');
      if (el) el.textContent = this.value.length;
    });
  }

  window.submitBillComment = function() {
    var body      = (document.getElementById('cv-body')?.value || '').trim();
    var errorEl   = document.getElementById('cv-error');
    var successEl = document.getElementById('cv-success');
    var submitBtn = document.getElementById('cv-submit');

    if (errorEl)   errorEl.style.display   = 'none';
    if (successEl) successEl.style.display = 'none';

    if (!selectedStance) {
      if (errorEl) {
        errorEl.textContent = 'Please select where you stand.';
        errorEl.style.display = 'block';
      }
      return;
    }
    if (!selectedPersp) {
      if (errorEl) {
        errorEl.textContent = 'Please choose how you see it.';
        errorEl.style.display = 'block';
      }
      return;
    }
    if (body.length < 10) {
      if (errorEl) {
        errorEl.textContent = 'Please write at least 10 characters.';
        errorEl.style.display = 'block';
      }
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting...';
    }

    fetch(commentsUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({
        bill_comment: {
          stance:           selectedStance,
          perspective_type: selectedPersp,
          body:             body,
          occupation:       (document.getElementById('cv-occupation')?.value || '').trim() || null,
          anonymous:        document.getElementById('cv-anon')?.checked ?? true
        }
      })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        if (successEl) {
          successEl.textContent = 'Your take has been posted.';
          successEl.style.display = 'block';
        }
        if (bodyEl) bodyEl.value = '';
        var countEl = document.getElementById('cv-char-count');
        if (countEl) countEl.textContent = '0';
        var occEl = document.getElementById('cv-occupation');
        if (occEl) occEl.value = '';
        document.querySelectorAll('.cv-stance-btn').forEach(function(b) {
          b.className = 'cv-stance-btn';
        });
        document.querySelectorAll('.cv-persp-chip').forEach(function(b) {
          b.classList.remove('active');
        });
        selectedStance = null;
        selectedPersp  = null;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Share your take \u2192';
        }
        prependComment(data.comment);
      } else {
        if (errorEl) {
          errorEl.textContent = (data.errors || ['Something went wrong.']).join(', ');
          errorEl.style.display = 'block';
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Share your take \u2192';
        }
      }
    })
    .catch(function() {
      if (errorEl) {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.style.display = 'block';
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Share your take \u2192';
      }
    });
  };

  var perspLabels = {
    personal_stake:        'This affects me directly',
    community_impact:      'This affects all of us',
    fiscal_accountability: 'Fiscal accountability',
    historical_context:    'Philadelphia has been here before',
    prediction:            'Here\'s what I think happens next'
  };

  function escHtml(s) {
    return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function renderComment(c) {
    return '<div class="cv-comment">' +
      '<div class="cv-comment-meta">' +
        '<span class="cv-comment-name">' + escHtml(c.display_name) + '</span>' +
        '<span class="cv-stance-badge ' + escHtml(c.stance) + '">' + escHtml(c.stance) + '</span>' +
        '<span class="cv-persp-label">' + escHtml(perspLabels[c.perspective_type] || c.perspective_type) + '</span>' +
        '<span class="cv-comment-date">' + escHtml(c.created_at) + '</span>' +
      '</div>' +
      '<div class="cv-comment-body">' + escHtml(c.body) + '</div>' +
    '</div>';
  }

  function prependComment(c) {
    var list  = document.getElementById('cv-comments-list');
    if (!list) return;
    var empty = list.querySelector('.cv-empty');
    if (empty) empty.remove();
    list.insertAdjacentHTML('afterbegin', renderComment(c));
  }

  function loadComments() {
    var list = document.getElementById('cv-comments-list');
    if (!list) return;
    fetch(commentsUrl)
      .then(function(r) { return r.json(); })
      .then(function(comments) {
        if (!comments.length) {
          list.innerHTML = '<div class="cv-empty">No takes yet. Be the first.</div>';
          return;
        }
        list.innerHTML = comments.map(renderComment).join('');
      })
      .catch(function() {
        list.innerHTML = '<div class="cv-empty">Could not load takes.</div>';
      });
  }

  document.addEventListener('DOMContentLoaded', loadComments);
})();
</script>
