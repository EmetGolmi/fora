<% content_for(:title) { "#{@bill.identifier} — #{truncate(@bill.title, length: 60)} — FORA" } %>

<% content_for :head do %>
<style>
  .bill-full-text-link:hover { background:rgba(255,255,255,0.13) !important; border-color:rgba(255,255,255,0.3) !important; }
  .share-btn:hover { opacity:0.82 !important; }
  .back-link:hover { color:rgba(255,255,255,0.7) !important; }
</style>
<% end %>

<%
  jur_label = case @bill.jurisdiction
    when "federal"      then "Federal Legislation"
    when "pennsylvania" then "State Legislation"
    when "philadelphia" then "City Legislation"
    else                     "Local Legislation"
    end

  share_url  = "https://fora.center/bills/#{@bill.id}"
  tweet_text = ERB::Util.url_encode("#{@bill.identifier}: #{@bill.title}")
  x_href     = "https://x.com/intent/tweet?text=#{tweet_text}&url=#{ERB::Util.url_encode(share_url)}"
  fb_href    = "https://www.facebook.com/sharer/sharer.php?u=#{ERB::Util.url_encode(share_url)}"
%>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<div style="background:#1b3a6b; position:relative; overflow:hidden;">

  <!-- Decorative rings -->
  <div style="position:absolute; right:-60px; top:-80px; width:420px; height:420px; border-radius:50%; border:40px solid rgba(255,255,255,0.025); pointer-events:none;"></div>
  <div style="position:absolute; right:50px; top:-10px; width:220px; height:220px; border-radius:50%; border:1px solid rgba(184,134,11,0.12); pointer-events:none;"></div>

  <!-- Star strip -->
  <div style="position:absolute; bottom:0; left:0; right:0; height:26px; overflow:hidden; display:flex; align-items:center; padding:0 48px; font-size:11px; letter-spacing:0.55em; color:#b8860b; white-space:nowrap; pointer-events:none; -webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%); mask-image:linear-gradient(to right,black 92%,transparent 100%);">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>

  <!-- Grid: gilt rail | content -->
  <div style="max-width:860px; margin:0 auto; padding:36px 48px 52px; position:relative; z-index:1; display:grid; grid-template-columns:3px 1fr; align-items:stretch; gap:0;">

    <!-- Gilt left bar — full height of hero content -->
    <div style="background:#b8860b;"></div>

    <!-- Content column -->
    <div style="padding-left:36px;">

      <!-- Back link -->
      <div style="margin-bottom:28px;">
        <a href="javascript:history.back()" class="back-link" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.3); text-decoration:none; transition:color 0.15s;">← Back</a>
      </div>

      <!-- Identifier -->
      <% if @bill.identifier.present? %>
        <div style="font-family:'JetBrains Mono',monospace; font-size:clamp(22px,3.5vw,30px); font-weight:700; color:#d4a832; letter-spacing:0.04em; line-height:1; margin-bottom:8px;"><%= @bill.identifier %></div>
      <% end %>

      <!-- Jurisdiction label -->
      <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.22em; text-transform:uppercase; color:rgba(255,255,255,0.28); margin-bottom:22px;"><%= jur_label %></div>

      <!-- Title -->
      <h1 style="font-family:'Libre Baskerville',serif; font-size:clamp(20px,3.2vw,30px); font-weight:700; color:white; line-height:1.25; margin:0 0 28px; max-width:680px;"><%= @bill.title %></h1>

      <!-- Introduced date + full text link -->
      <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
        <% if @bill.status_date %>
          <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.22);">Introduced <%= @bill.status_date.strftime("%b %d, %Y") %></span>
        <% end %>
        <% if @bill.full_text_url.present? %>
          <a href="<%= @bill.full_text_url %>" target="_blank" rel="noopener" class="bill-full-text-link"
             style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.55); text-decoration:none; padding:7px 16px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14); border-radius:5px; transition:all 0.15s;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            View Official Text
          </a>
        <% end %>
      </div>

    </div>
  </div>
</div>

<!-- ── BODY ──────────────────────────────────────────────────────────────── -->
<div style="max-width:860px; margin:0 auto; padding:44px 48px 72px;">

  <!-- What This Bill Does -->
  <div style="margin-bottom:44px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Plain Language</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What This Bill Does</h2>

    <% if @bill.summary.present? %>
      <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @bill.summary %></p>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">AI analysis coming soon — check back shortly.</p>
      </div>
    <% end %>
  </div>

  <!-- What May Happen -->
  <div style="margin-bottom:52px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Anticipated Effects</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What May Happen</h2>
    <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
      <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
      <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">Based on similar legislation, anticipated effects will appear here. FORA never predicts outcomes — only what evidence suggests may be possible.</p>
    </div>
  </div>

  <!-- Gilt divider -->
  <div style="display:flex; align-items:center; gap:16px; margin-bottom:48px;">
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
    <span style="font-size:10px; color:#b8860b; letter-spacing:0.3em;">★</span>
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
  </div>

  <!-- Your Take -->
  <div>
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Civic Voice</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">Your Take</h2>

    <textarea id="your-take"
              placeholder="What does this mean for your community?"
              style="width:100%; min-height:120px; background:white; border:1.5px solid rgba(27,58,107,0.15); border-radius:10px; padding:16px 18px; font-family:'Nunito',sans-serif; font-size:14px; color:#0e1a2e; line-height:1.6; resize:vertical; outline:none; box-sizing:border-box; transition:border-color 0.15s;"
              onfocus="this.style.borderColor='rgba(27,58,107,0.4)'"
              onblur="this.style.borderColor='rgba(27,58,107,0.15)'"></textarea>

    <div style="display:flex; align-items:center; gap:10px; margin-top:14px; flex-wrap:wrap;">
      <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:#8a9ab8;">Share:</span>

      <!-- X / Twitter -->
      <a href="<%= x_href %>" target="_blank" rel="noopener" class="share-btn"
         style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:white; text-decoration:none; padding:8px 16px; background:#0e1a2e; border-radius:6px; transition:opacity 0.15s;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        Post on X
      </a>

      <!-- Facebook -->
      <a href="<%= fb_href %>" target="_blank" rel="noopener" class="share-btn"
         style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:white; text-decoration:none; padding:8px 16px; background:#1877f2; border-radius:6px; transition:opacity 0.15s;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Share on Facebook
      </a>
    </div>
  </div>

</div>
