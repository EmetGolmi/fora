<% content_for(:title) { "#{@bill.identifier} — #{truncate(@bill.title, length: 60)} — FORA" } %>

<% content_for :head do %>
<style>
  .bill-full-text-link:hover { background:rgba(255,255,255,0.13) !important; border-color:rgba(255,255,255,0.3) !important; }
  .back-link:hover { color:rgba(255,255,255,0.7) !important; }

  /* ── Your Take ── */
  .bt-card { background:white; border-radius:10px; border:0.5px solid #dde5f5; padding:22px 26px; }
  .bt-eyebrow { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.18em; text-transform:uppercase; color:#b8860b; font-weight:700; margin-bottom:12px; }
  .bt-perspective-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:14px; }
  .bt-perspective-btn { padding:9px 10px; border-radius:6px; border:1.5px solid #dde5f5; background:white; font-family:'Nunito',sans-serif; font-size:11px; font-weight:600; color:#5a6e8a; cursor:pointer; text-align:left; transition:all 0.12s; }
  .bt-perspective-btn:hover { border-color:#3a6abf; color:#1b3a6b; }
  .bt-perspective-btn.active[data-type="empathy"]        { background:#e8f4fd; border-color:#1b3a6b; color:#1b3a6b; }
  .bt-perspective-btn.active[data-type="practical"]      { background:#e5f0e8; border-color:#155c2d; color:#155c2d; }
  .bt-perspective-btn.active[data-type="accountability"] { background:#fff3dc; border-color:#b8860b; color:#b8860b; }
  .bt-perspective-btn.active[data-type="opposition"]     { background:#faeaea; border-color:#8b1a1a; color:#8b1a1a; }

  .bt-textarea { width:100%; min-height:100px; border:1px solid #dde5f5; border-radius:6px; padding:12px 14px; font-family:'Nunito',sans-serif; font-size:14px; color:#0e1a2e; line-height:1.65; resize:vertical; outline:none; box-sizing:border-box; }
  .bt-textarea:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .bt-form-row { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; margin-bottom:10px; }
  .bt-input { width:100%; border:1px solid #dde5f5; border-radius:6px; padding:8px 12px; font-family:'Nunito',sans-serif; font-size:12px; color:#0e1a2e; outline:none; box-sizing:border-box; }
  .bt-input:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .bt-checkbox-row { display:flex; align-items:center; gap:8px; margin-bottom:12px; font-family:'Nunito',sans-serif; font-size:12px; color:#5a6e8a; }
  .bt-submit { width:100%; padding:11px; background:#1b3a6b; color:white; border:none; border-radius:7px; font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; cursor:pointer; }
  .bt-submit:hover { background:#254f92; }

  .bt-share-panel { background:#f8faff; border:1px solid #dde5f5; border-radius:8px; padding:16px 18px; margin-top:14px; }
  .bt-share-panel-label { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#8a9ab8; margin-bottom:8px; }
  .bt-share-copy { font-family:'Nunito',sans-serif; font-size:12px; color:#2c3e5a; line-height:1.6; padding:10px 12px; background:white; border:1px solid #dde5f5; border-radius:6px; margin-bottom:12px; white-space:pre-wrap; word-break:break-word; }
  .bt-share-btns { display:flex; flex-wrap:wrap; gap:6px; }
  .bt-share-plat { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.07em; padding:6px 12px; border-radius:4px; border:1px solid #dde5f5; background:white; color:#254f92; cursor:pointer; }
  .bt-share-plat:hover { background:#edf1fb; }

  /* ── Photo attach ── */
  .photo-attach-wrap { margin-bottom:12px; }
  .photo-attach-label { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.12em; text-transform:uppercase; color:#8a9ab8; display:block; margin-bottom:6px; }
  .photo-attach-options { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .photo-opt-btn { font-family:'Nunito',sans-serif; font-size:12px; color:#254f92; background:white; border:1px solid #dde5f5; border-radius:5px; padding:6px 12px; cursor:pointer; white-space:nowrap; }
  .photo-opt-btn:hover { background:#edf1fb; border-color:#3a6abf; }
  .photo-opt-divider { font-family:'Nunito',sans-serif; font-size:11px; color:#b0b8c8; }
  .photo-link-input { flex:1; min-width:140px; border:1px solid #dde5f5; border-radius:5px; padding:6px 10px; font-family:'Nunito',sans-serif; font-size:12px; color:#0e1a2e; outline:none; box-sizing:border-box; }
  .photo-link-input:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .photo-preview-area { display:none; align-items:center; gap:10px; margin-top:8px; background:#f4f7ff; border:1px solid #dde5f5; border-radius:6px; padding:8px 10px; }
  .photo-preview-img { width:52px; height:52px; object-fit:cover; border-radius:4px; cursor:pointer; flex-shrink:0; }
  .photo-preview-meta { display:flex; flex-direction:column; gap:4px; flex:1; min-width:0; }
  .photo-preview-name { font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .photo-remove-btn { font-family:'JetBrains Mono',monospace; font-size:8px; color:#8b1a1a; background:none; border:none; cursor:pointer; padding:0; text-align:left; }
  .lightbox-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; justify-content:center; align-items:center; }
  .lightbox-overlay.open { display:flex; }
  .lightbox-overlay img { max-width:90vw; max-height:88vh; border-radius:8px; object-fit:contain; }
  .lightbox-close { position:absolute; top:18px; right:22px; background:none; border:none; color:white; font-size:24px; cursor:pointer; line-height:1; }

  @media (max-width:600px) {
    .bt-perspective-grid { grid-template-columns:1fr 1fr; }
    .bt-form-row { grid-template-columns:1fr; }
  }
</style>
<% end %>

<%
  jur_label = case @bill.jurisdiction
    when "federal"      then "Federal Legislation"
    when "pennsylvania" then "State Legislation"
    when "philadelphia" then "City Legislation"
    else                     "Local Legislation"
    end

  share_url  = "https://fora.center/bills/#{@bill.id}"
  bill_ref   = @bill.identifier.presence || "This bill"
%>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<div style="background:#1b3a6b; padding:36px 48px 52px; position:relative; overflow:hidden;">

  <div style="position:absolute; right:-60px; top:-80px; width:400px; height:400px; border-radius:50%; border:44px solid rgba(255,255,255,0.02); pointer-events:none;"></div>
  <div style="position:absolute; bottom:0; left:0; right:0; height:26px; display:flex; align-items:center; padding:0 48px; font-size:11px; letter-spacing:0.55em; color:#b8860b; overflow:hidden; white-space:nowrap; pointer-events:none; -webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%); mask-image:linear-gradient(to right,black 92%,transparent 100%);">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>

  <div style="max-width:860px; margin:0 auto; position:relative; z-index:1;">

    <div style="margin-bottom:18px;">
      <a href="javascript:history.back()" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.35); text-decoration:none;">← Back</a>
    </div>

    <% if @bill.identifier.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:clamp(22px,3.5vw,30px); font-weight:700; color:#d4a832; letter-spacing:0.04em; line-height:1; margin-bottom:8px;"><%= @bill.identifier %></div>
    <% end %>

    <div style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.22em; text-transform:uppercase; color:rgba(255,255,255,0.28); margin-bottom:22px;"><%= jur_label %></div>

    <% title_limit = 216 %>
    <% title_long  = @bill.title.length > title_limit %>
    <h1 style="font-family:'Libre Baskerville',serif; font-size:clamp(20px,3.2vw,30px); font-weight:700; color:white; line-height:1.25; margin:0 0 <%= title_long ? '10px' : '28px' %>; max-width:680px;">
      <span id="bill-title-short"><%= title_long ? @bill.title.first(title_limit) + "…" : @bill.title %></span>
      <% if title_long %>
        <span id="bill-title-full" style="display:none;"><%= @bill.title %></span>
      <% end %>
    </h1>

    <% if title_long %>
      <div style="margin-bottom:18px;">
        <a id="bill-title-expand" href="javascript:void(0)"
           onclick="document.getElementById('bill-title-short').style.display='none'; document.getElementById('bill-title-full').style.display='inline'; this.parentElement.style.display='none';"
           style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.12em; text-transform:uppercase; color:#b8860b; text-decoration:none;">Read full title ↓</a>
      </div>
    <% end %>

    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap; margin-top:8px;">
      <% if @bill.status_date %>
        <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.22);">Introduced <%= @bill.status_date.strftime("%b %d, %Y") %></span>
      <% end %>
      <% if @bill.full_text_url.present? %>
        <a href="<%= @bill.full_text_url %>" target="_blank" rel="noopener"
           style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.55); text-decoration:none; padding:7px 16px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14); border-radius:5px;">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          View Official Text
        </a>
      <% end %>
    </div>

  </div>
</div>

<!-- ── BODY ──────────────────────────────────────────────────────────────── -->
<div style="max-width:860px; margin:0 auto; padding:44px 48px 72px;">

  <!-- What This Bill Does -->
  <div style="margin-bottom:44px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Plain Language</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What This Bill Does</h2>

    <% if @summary.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
      <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @summary %></p>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">AI analysis coming soon — check back shortly.</p>
      </div>
    <% end %>
  </div>

  <!-- What May Happen -->
  <div style="margin-bottom:52px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Anticipated Effects</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What May Happen</h2>
    <% if @effects.present? %>
      <% if @effects_curated %>
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Editorial</div>
        <% @effects.split("\n\n").each do |para| %>
          <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75; margin-bottom:1.1em;"><%= para %></p>
        <% end %>
      <% else %>
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
        <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @effects %></p>
      <% end %>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">Based on similar legislation, anticipated effects will appear here. FORA never predicts outcomes — only what evidence suggests may be possible.</p>
      </div>
    <% end %>
  </div>

  <!-- Gilt divider -->
  <div style="display:flex; align-items:center; gap:16px; margin-bottom:48px;">
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
    <span style="font-size:10px; color:#b8860b; letter-spacing:0.3em;">★</span>
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
  </div>

  <!-- Your Take -->
  <div>
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Civic Voice</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 20px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">Your Take</h2>

    <div class="bt-card">
      <div class="bt-eyebrow">◆ How do you see it?</div>

      <div class="bt-perspective-grid" id="bt-perspectives">
        <button type="button" class="bt-perspective-btn" data-type="empathy"    data-label="🤝 With empathy">🤝 With empathy</button>
        <button type="button" class="bt-perspective-btn" data-type="practical"  data-label="🔧 Practical fix">🔧 Practical fix</button>
        <button type="button" class="bt-perspective-btn" data-type="accountability" data-label="📋 Hold accountable">📋 Hold accountable</button>
        <button type="button" class="bt-perspective-btn" data-type="opposition" data-label="↔ Different view">↔ Different view</button>
      </div>

      <textarea class="bt-textarea" id="bt-body"
        placeholder="What does <%= bill_ref %> mean for your community? Be specific — your take is more persuasive when it's grounded in real experience." rows="4"></textarea>

      <div class="bt-form-row">
        <div>
          <input class="bt-input" type="text" id="bt-name" placeholder="Your occupation (optional)">
        </div>
        <div style="display:flex; align-items:center;">
          <div class="bt-checkbox-row" style="margin-bottom:0;">
            <input type="checkbox" id="bt-anon">
            <label for="bt-anon">Post anonymously</label>
          </div>
        </div>
      </div>

      <div class="photo-attach-wrap">
        <span class="photo-attach-label">📷 Add a photo (optional)</span>
        <div class="photo-attach-options">
          <label class="photo-opt-btn">
            <input type="file" accept="image/*" style="display:none;" onchange="handleFileUpload(this, 'qa-bill')">
            📁 Camera roll
          </label>
          <span class="photo-opt-divider">or</span>
          <input type="text" class="photo-link-input" placeholder="🔗 Paste a photo link" oninput="handleLinkInput(this, 'qa-bill')">
        </div>
        <div class="photo-preview-area" id="preview-qa-bill" style="display:none;">
          <img class="photo-preview-img" id="preview-img-qa-bill" src="" alt="Preview" onclick="openLightbox(this.src)">
          <div class="photo-preview-meta">
            <span class="photo-preview-name" id="preview-name-qa-bill"></span>
            <button class="photo-remove-btn" onclick="clearPhoto('qa-bill')">✕ Remove</button>
          </div>
        </div>
      </div>

      <button class="bt-submit" onclick="btOpenShare()">Share your take →</button>

      <div class="bt-share-panel" id="bt-share-panel" hidden>
        <div class="bt-share-panel-label">Your take — ready to share</div>
        <div class="bt-share-copy" id="bt-share-copy"></div>
        <div id="bt-share-photo"></div>
        <div class="bt-share-btns" id="bt-share-btns"></div>
      </div>
    </div>
  </div>

</div>

<script>
(function() {
  var billRef  = '<%= j bill_ref %>';
  var billUrl  = '<%= j share_url %>';
  var selectedType  = 'empathy';
  var selectedLabel = '🤝 With empathy';

  // Perspective buttons
  var grid = document.getElementById('bt-perspectives');
  if (grid) {
    var defaultBtn = grid.querySelector('[data-type="empathy"]');
    if (defaultBtn) defaultBtn.classList.add('active');
    grid.querySelectorAll('.bt-perspective-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        grid.querySelectorAll('.bt-perspective-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        selectedType  = btn.dataset.type;
        selectedLabel = btn.dataset.label;
      });
    });
  }

  // Photo state
  var photoState = {};
  window.handleFileUpload = function(input, formId) {
    var file = input.files && input.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert('Please use a photo under 2 MB.'); input.value = ''; return; }
    var reader = new FileReader();
    reader.onload = function(e) {
      photoState[formId] = { photo_data: e.target.result, photo_url: null, photo_filename: file.name };
      showPhotoPreview(formId, e.target.result, file.name);
    };
    reader.readAsDataURL(file);
  };
  window.handleLinkInput = function(input, formId) {
    var url = input.value.trim();
    if (!url) { clearPhoto(formId); return; }
    var img = new Image();
    img.onload = function() {
      photoState[formId] = { photo_data: null, photo_url: url, photo_filename: url.split('/').pop().split('?')[0] || 'photo' };
      showPhotoPreview(formId, url, photoState[formId].photo_filename);
    };
    img.src = url;
  };
  function showPhotoPreview(formId, src, name) {
    var area = document.getElementById('preview-' + formId);
    var imgEl = document.getElementById('preview-img-' + formId);
    var nameEl = document.getElementById('preview-name-' + formId);
    if (area)   area.style.display = 'flex';
    if (imgEl)  imgEl.src = src;
    if (nameEl) nameEl.textContent = name || '';
  }
  window.clearPhoto = function(formId) {
    delete photoState[formId];
    var area = document.getElementById('preview-' + formId);
    if (area) area.style.display = 'none';
  };
  window.openLightbox = function(src) {
    var lb = document.getElementById('fora-lightbox');
    if (!lb) {
      lb = document.createElement('div');
      lb.id = 'fora-lightbox';
      lb.className = 'lightbox-overlay';
      lb.innerHTML = '<button class="lightbox-close" onclick="closeLightbox()">✕</button><img src="" alt="Full photo">';
      lb.addEventListener('click', function(e) { if (e.target === lb) closeLightbox(); });
      document.body.appendChild(lb);
    }
    lb.querySelector('img').src = src;
    lb.classList.add('open');
  };
  window.closeLightbox = function() {
    var lb = document.getElementById('fora-lightbox');
    if (lb) lb.classList.remove('open');
  };

  window.btOpenShare = function() {
    var bodyEl  = document.getElementById('bt-body');
    var nameEl  = document.getElementById('bt-name');
    var anonEl  = document.getElementById('bt-anon');
    var panel   = document.getElementById('bt-share-panel');
    var copyEl  = document.getElementById('bt-share-copy');
    var btnsEl  = document.getElementById('bt-share-btns');
    var photoEl = document.getElementById('bt-share-photo');

    var body = bodyEl ? bodyEl.value.trim() : '';
    if (!body) { bodyEl && bodyEl.focus(); return; }

    var anon    = anonEl && anonEl.checked;
    var name    = (!anon && nameEl && nameEl.value.trim()) ? nameEl.value.trim() : null;
    var byline  = name ? ' — ' + name : '';
    var shareText = selectedLabel + ': ' + body + byline + '\n\nvia FORA on ' + billRef + ' — ' + billUrl;

    if (copyEl) copyEl.textContent = shareText;

    var photo = photoState['qa-bill'] || {};
    if (photoEl) {
      var src = photo.photo_data || photo.photo_url;
      photoEl.innerHTML = src ? '<img src="' + src + '" alt="Attached photo" onclick="openLightbox(this.src)" style="max-width:100%; max-height:160px; border-radius:6px; margin-bottom:10px; cursor:pointer; display:block;">' : '';
    }

    var enc = encodeURIComponent;
    var t240 = shareText.substring(0, 240);
    var platforms = [
      ['𝕏 / Twitter',  function() { window.open('https://twitter.com/intent/tweet?text=' + enc(t240), '_blank', 'noopener'); }],
      ['Facebook',      function() { window.open('https://www.facebook.com/sharer/sharer.php?u=' + enc(billUrl), '_blank', 'noopener'); }],
      ['WhatsApp',      function() { window.open('https://wa.me/?text=' + enc(shareText.substring(0,300)), '_blank', 'noopener'); }],
      ['LinkedIn',      function() { window.open('https://www.linkedin.com/shareArticle?mini=true&url=' + enc(billUrl) + '&summary=' + enc(shareText.substring(0,200)), '_blank', 'noopener'); }],
      ['Instagram',     function() { navigator.clipboard.writeText(shareText).then(function() { window.open('https://www.instagram.com/', '_blank', 'noopener'); }); }],
      ['Copy text',     function() {
        navigator.clipboard.writeText(shareText).then(function() {
          var btn = btnsEl && btnsEl.querySelector('[data-copy]');
          if (btn) { var o = btn.textContent; btn.textContent = 'Copied!'; setTimeout(function() { btn.textContent = o; }, 1800); }
        });
      }],
    ];

    if (btnsEl) {
      btnsEl.innerHTML = '';
      platforms.forEach(function(pair) {
        var btn = document.createElement('button');
        btn.className = 'bt-share-plat';
        btn.textContent = pair[0];
        if (pair[0] === 'Copy text') btn.dataset.copy = '1';
        btn.addEventListener('click', pair[1]);
        btnsEl.appendChild(btn);
      });
    }

    if (panel) panel.hidden = false;
  };
})();
</script>
