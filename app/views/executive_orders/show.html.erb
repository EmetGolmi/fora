      </div>
      <div class="photo-attach-wrap">
        <span class="photo-attach-label">📷 Add a photo (optional)</span>
        <div class="photo-attach-options">
          <label class="photo-opt-btn"><input type="file" accept="image/*" style="display:none;" onchange="handleFileUpload(this, 'qa-eo')">📁 Camera roll</label>
          <span class="photo-opt-divider">or</span>
          <input type="text" class="photo-link-input" placeholder="🔗 Paste a photo link" oninput="handleLinkInput(this, 'qa-eo')">
