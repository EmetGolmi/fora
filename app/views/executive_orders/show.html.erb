<% content_for(:title) { "#{@eo['number']} — #{truncate(@eo['title'], length: 60)} — FORA" } %>

<% content_for :head do %>
<style>
  .eo-text-link:hover { background:rgba(255,255,255,0.13) !important; border-color:rgba(255,255,255,0.3) !important; }

  /* ── Your Take ── */
  .bt-card { background:white; border-radius:10px; border:0.5px solid #dde5f5; padding:22px 26px; }
  .bt-eyebrow { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.18em; text-transform:uppercase; color:#b8860b; font-weight:700; margin-bottom:12px; }
  .bt-perspective-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:14px; }
  .bt-perspective-btn { padding:9px 10px; border-radius:6px; border:1.5px solid #dde5f5; background:white; font-family:'Nunito',sans-serif; font-size:11px; font-weight:600; color:#5a6e8a; cursor:pointer; text-align:left; transition:all 0.12s; }
  .bt-perspective-btn:hover { border-color:#3a6abf; color:#1b3a6b; }
  .bt-perspective-btn.active[data-type="empathy"]        { background:#e8f4fd; border-color:#1b3a6b; color:#1b3a6b; }
  .bt-perspective-btn.active[data-type="practical"]      { background:#e5f0e8; border-color:#155c2d; color:#155c2d; }
  .bt-perspective-btn.active[data-type="accountability"] { background:#fff3dc; border-color:#b8860b; color:#b8860b; }
  .bt-perspective-btn.active[data-type="opposition"]     { background:#faeaea; border-color:#8b1a1a; color:#8b1a1a; }

  .bt-textarea { width:100%; min-height:100px; border:1px solid #dde5f5; border-radius:6px; padding:12px 14px; font-family:'Nunito',sans-serif; font-size:14px; color:#0e1a2e; line-height:1.65; resize:vertical; outline:none; box-sizing:border-box; }
  .bt-textarea:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .bt-form-row { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; margin-bottom:10px; }
  .bt-input { width:100%; border:1px solid #dde5f5; border-radius:6px; padding:8px 12px; font-family:'Nunito',sans-serif; font-size:12px; color:#0e1a2e; outline:none; box-sizing:border-box; }
  .bt-input:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .bt-checkbox-row { display:flex; align-items:center; gap:8px; margin-bottom:12px; font-family:'Nunito',sans-serif; font-size:12px; color:#5a6e8a; }
  .bt-submit { width:100%; padding:11px; background:#1b3a6b; color:white; border:none; border-radius:7px; font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; cursor:pointer; }
  .bt-submit:hover { background:#254f92; }

  .bt-share-panel { background:#f8faff; border:1px solid #dde5f5; border-radius:8px; padding:16px 18px; margin-top:14px; }
  .bt-share-panel-label { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#8a9ab8; margin-bottom:8px; }
  .bt-share-copy { font-family:'Nunito',sans-serif; font-size:12px; color:#2c3e5a; line-height:1.6; padding:10px 12px; background:white; border:1px solid #dde5f5; border-radius:6px; margin-bottom:12px; white-space:pre-wrap; word-break:break-word; }
  .bt-share-btns { display:flex; flex-wrap:wrap; gap:6px; }
  .bt-share-plat { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.07em; padding:6px 12px; border-radius:4px; border:1px solid #dde5f5; background:white; color:#254f92; cursor:pointer; }
  .bt-share-plat:hover { background:#edf1fb; }

  /* ── Photo attach ── */
  .photo-attach-wrap { margin-bottom:12px; }
  .photo-attach-label { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.12em; text-transform:uppercase; color:#8a9ab8; display:block; margin-bottom:6px; }
  .photo-attach-options { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .photo-opt-btn { font-family:'Nunito',sans-serif; font-size:12px; color:#254f92; background:white; border:1px solid #dde5f5; border-radius:5px; padding:6px 12px; cursor:pointer; white-space:nowrap; }
  .photo-opt-btn:hover { background:#edf1fb; border-color:#3a6abf; }
  .photo-opt-divider { font-family:'Nunito',sans-serif; font-size:11px; color:#b0b8c8; }
  .photo-link-input { flex:1; min-width:140px; border:1px solid #dde5f5; border-radius:5px; padding:6px 10px; font-family:'Nunito',sans-serif; font-size:12px; color:#0e1a2e; outline:none; box-sizing:border-box; }
  .photo-link-input:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .photo-preview-area { display:none; align-items:center; gap:10px; margin-top:8px; background:#f4f7ff; border:1px solid #dde5f5; border-radius:6px; padding:8px 10px; }
  .photo-preview-img { width:52px; height:52px; object-fit:cover; border-radius:4px; cursor:pointer; flex-shrink:0; }
  .photo-preview-meta { display:flex; flex-direction:column; gap:4px; flex:1; min-width:0; }
  .photo-preview-name { font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .photo-remove-btn { font-family:'JetBrains Mono',monospace; font-size:8px; color:#8b1a1a; background:none; border:none; cursor:pointer; padding:0; text-align:left; }
  .lightbox-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; justify-content:center; align-items:center; }
  .lightbox-overlay.open { display:flex; }
  .lightbox-overlay img { max-width:90vw; max-height:88vh; border-radius:8px; object-fit:contain; }
  .lightbox-close { position:absolute; top:18px; right:22px; background:none; border:none; color:white; font-size:24px; cursor:pointer; line-height:1; }

  @media (max-width:600px) {
    .bt-perspective-grid { grid-template-columns:1fr 1fr; }
    .bt-form-row { grid-template-columns:1fr; }
  }
</style>
<% end %>

<%
  official_profile_path = case @person.office_type
  when "governor"  then pa_governor_path
  when "mayor"     then philly_mayor_path
  when "president" then us_president_path
  else                  "#"
  end

  share_url = "https://fora.center/eo/#{@eo['slug']}"
  eo_ref    = @eo['number'].presence || "This order"
%>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<div style="background:#1b3a6b; padding:36px 48px 52px; position:relative; overflow:hidden;">

  <!-- Decorative ring -->
  <div style="position:absolute; right:-60px; top:-80px; width:400px; height:400px; border-radius:50%; border:44px solid rgba(255,255,255,0.02); pointer-events:none;"></div>

  <!-- Star strip -->
  <div style="position:absolute; bottom:0; left:0; right:0; height:26px; display:flex; align-items:center; padding:0 48px; font-size:11px; letter-spacing:0.55em; color:#b8860b; overflow:hidden; white-space:nowrap; pointer-events:none; -webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%); mask-image:linear-gradient(to right,black 92%,transparent 100%);">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>

  <div style="max-width:860px; margin:0 auto; position:relative; z-index:1;">

    <div style="margin-bottom:18px; display:flex; align-items:center; gap:16px;">
      <a href="<%= official_profile_path %>" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.35); text-decoration:none;">← <%= @person.full_name %></a>
    </div>

    <div style="font-family:'JetBrains Mono',monospace; font-size:clamp(22px,3.5vw,30px); font-weight:700; color:#d4a832; letter-spacing:0.04em; line-height:1; margin-bottom:8px;"><%= @eo['number'] %></div>

    <div style="display:flex; align-items:center; gap:10px; margin-bottom:22px; flex-wrap:wrap;">
      <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.28);"><%= @person.office_title %></span>
      <span style="width:3px; height:3px; border-radius:50%; background:rgba(255,255,255,0.2); flex-shrink:0;"></span>
      <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; color:rgba(255,255,255,0.28);"><%= @eo['date'] %></span>
      <% if @eo['category'].present? %>
        <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 10px; border-radius:100px; background:rgba(184,134,11,0.15); color:#d4a832; border:1px solid rgba(184,134,11,0.3);"><%= @eo['category'] %></span>
      <% end %>
    </div>

    <h1 style="font-family:'Libre Baskerville',serif; font-size:clamp(18px,3vw,26px); font-weight:700; color:white; line-height:1.3; margin:0 0 28px; max-width:680px;">
      <%= @eo['title'] %>
    </h1>

    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <% if @eo['official_url'].present? %>
        <a href="<%= @eo['official_url'] %>" target="_blank" rel="noopener" class="eo-text-link"
           style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.55); text-decoration:none; padding:7px 16px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14); border-radius:5px; transition:background 0.15s, border-color 0.15s;">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          View Official Text
        </a>
      <% end %>
    </div>

  </div>
</div>

<% if @eo['slug'] == '14404' %>
<% content_for :head do %>
<style>
