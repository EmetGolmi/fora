<% content_for(:title) { "#{@eo['number']} — #{truncate(@eo['title'], length: 60)} — FORA" } %>

<% content_for :head do %>
<style>
  .eo-text-link:hover { background:rgba(255,255,255,0.13) !important; border-color:rgba(255,255,255,0.3) !important; }
  .share-btn:hover { opacity:0.82 !important; }
</style>
<% end %>

<%
  official_profile_path = case @person.office_type
  when "governor" then pa_governor_path
  when "mayor"    then philly_mayor_path
  else                 "#"
  end

  share_url  = "https://fora.center/eo/#{@eo['slug']}"
  tweet_text = ERB::Util.url_encode("#{@eo['number']}: #{@eo['title']}")
  x_href     = "https://x.com/intent/tweet?text=#{tweet_text}&url=#{ERB::Util.url_encode(share_url)}"
  fb_href    = "https://www.facebook.com/sharer/sharer.php?u=#{ERB::Util.url_encode(share_url)}"
%>

<!-- ── HERO ─────────────────────────────────────────────────────────────── -->
<div style="background:#1b3a6b; padding:36px 48px 52px; position:relative; overflow:hidden;">

  <!-- Decorative ring -->
  <div style="position:absolute; right:-60px; top:-80px; width:400px; height:400px; border-radius:50%; border:44px solid rgba(255,255,255,0.02); pointer-events:none;"></div>

  <!-- Star strip -->
  <div style="position:absolute; bottom:0; left:0; right:0; height:26px; display:flex; align-items:center; padding:0 48px; font-size:11px; letter-spacing:0.55em; color:#b8860b; overflow:hidden; white-space:nowrap; pointer-events:none; -webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%); mask-image:linear-gradient(to right,black 92%,transparent 100%);">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>

  <div style="max-width:860px; margin:0 auto; position:relative; z-index:1;">

    <div style="margin-bottom:18px; display:flex; align-items:center; gap:16px;">
      <a href="<%= official_profile_path %>" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.35); text-decoration:none;">← <%= @person.full_name %></a>
    </div>

    <div style="font-family:'JetBrains Mono',monospace; font-size:clamp(22px,3.5vw,30px); font-weight:700; color:#d4a832; letter-spacing:0.04em; line-height:1; margin-bottom:8px;"><%= @eo['number'] %></div>

    <div style="display:flex; align-items:center; gap:10px; margin-bottom:22px; flex-wrap:wrap;">
      <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:rgba(255,255,255,0.28);"><%= @person.office_title %></span>
      <span style="width:3px; height:3px; border-radius:50%; background:rgba(255,255,255,0.2); flex-shrink:0;"></span>
      <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; color:rgba(255,255,255,0.28);"><%= @eo['date'] %></span>
      <% if @eo['category'].present? %>
        <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 10px; border-radius:100px; background:rgba(184,134,11,0.15); color:#d4a832; border:1px solid rgba(184,134,11,0.3);"><%= @eo['category'] %></span>
      <% end %>
    </div>

    <h1 style="font-family:'Libre Baskerville',serif; font-size:clamp(18px,3vw,26px); font-weight:700; color:white; line-height:1.3; margin:0 0 28px; max-width:680px;">
      <%= @eo['title'] %>
    </h1>

    <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
      <% if @eo['official_url'].present? %>
        <a href="<%= @eo['official_url'] %>" target="_blank" rel="noopener" class="eo-text-link"
           style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.55); text-decoration:none; padding:7px 16px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14); border-radius:5px; transition:background 0.15s, border-color 0.15s;">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          View Official Text
        </a>
      <% end %>
    </div>

  </div>
</div>

<!-- ── BODY ──────────────────────────────────────────────────────────────── -->
<div style="max-width:860px; margin:0 auto; padding:44px 48px 72px;">

  <!-- What This Order Does -->
  <div style="margin-bottom:44px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Plain Language</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">What This Order Does</h2>

    <% if @summary.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
      <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @summary %></p>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">AI analysis coming soon — check back shortly.</p>
      </div>
    <% end %>
  </div>

  <!-- Who It Affects -->
  <div style="margin-bottom:52px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Impact</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">Who It Affects</h2>
    <% if @effects.present? %>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ AI Analysis</div>
      <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#3a4a5e; line-height:1.75;"><%= @effects %></p>
    <% else %>
      <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:20px 22px; display:flex; align-items:flex-start; gap:14px;">
        <div style="width:8px; height:8px; border-radius:50%; background:#b8860b; flex-shrink:0; margin-top:5px;"></div>
        <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; line-height:1.6; margin:0; font-style:italic;">FORA never predicts outcomes — anticipated effects will appear here shortly.</p>
      </div>
    <% end %>
  </div>

  <!-- Gilt divider -->
  <div style="display:flex; align-items:center; gap:16px; margin-bottom:48px;">
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
    <span style="font-size:10px; color:#b8860b; letter-spacing:0.3em;">★</span>
    <div style="flex:1; height:1px; background:linear-gradient(to right, transparent, #b8860b, transparent);"></div>
  </div>

  <!-- Your Take -->
  <div>
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Civic Voice</div>
    <h2 style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b; margin:0 0 16px; padding-bottom:12px; border-bottom:1px solid rgba(27,58,107,0.09);">Your Take</h2>

    <textarea id="your-take"
              placeholder="What does this order mean for your community?"
              style="width:100%; min-height:120px; background:white; border:1.5px solid rgba(27,58,107,0.15); border-radius:10px; padding:16px 18px; font-family:'Nunito',sans-serif; font-size:14px; color:#0e1a2e; line-height:1.6; resize:vertical; outline:none; box-sizing:border-box; transition:border-color 0.15s;"
              onfocus="this.style.borderColor='rgba(27,58,107,0.4)'"
              onblur="this.style.borderColor='rgba(27,58,107,0.15)'"></textarea>

    <div style="display:flex; align-items:center; gap:10px; margin-top:14px; flex-wrap:wrap;">
      <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:#8a9ab8;">Share:</span>

      <a href="<%= x_href %>" target="_blank" rel="noopener" class="share-btn"
         style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:white; text-decoration:none; padding:8px 16px; background:#0e1a2e; border-radius:6px; transition:opacity 0.15s;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        Post on X
      </a>

      <a href="<%= fb_href %>" target="_blank" rel="noopener" class="share-btn"
         style="display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:white; text-decoration:none; padding:8px 16px; background:#1877f2; border-radius:6px; transition:opacity 0.15s;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Share on Facebook
      </a>
    </div>
  </div>

</div>
