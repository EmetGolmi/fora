<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="<%= form_authenticity_token %>">
<title>FORA — Join</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#1b3a6b;--blue-md:#254f92;--blue-lt:#3a6abf;--blue-pl:#dde5f5;--blue-vp:#edf1fb;
  --gilt:#b8860b;--gilt-lt:#d4a832;--gilt-pl:#f8f0dc;--gilt-rul:rgba(184,134,11,.25);
  --ink:#0e1a2e;--ink-soft:#5a6e8a;--ink-mut:#8a9ab8;
  --bg:#f0f3f8;--white:#fff;--surface:#fbfaf6;--rule:rgba(27,58,107,.1);
  --green:#155c2d;--green-lt:#1f7a3e;--green-pl:#e5f0e8;--green-tint:#f3f9f5;
  --temple:#b8860b;--temple-pl:#f8f0dc;--temple-tint:#fdfaf1;
  --govt:#1b3a6b;--govt-pl:#dde5f5;--govt-tint:#f4f7fc;
  --market:#155c2d;--market-pl:#e5f0e8;--market-tint:#f3f9f5;
  --amber:#c47f00;--field:#0c1729;--field-2:#13203a;--field-line:rgba(255,255,255,.08);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);line-height:1.55;min-height:100vh;}
.topbar{display:flex;justify-content:center;padding:18px;border-bottom:1px solid var(--rule);background:#fff;position:sticky;top:0;z-index:50;}
.logo{font-family:'Libre Baskerville',serif;font-size:21px;font-weight:700;color:var(--blue);letter-spacing:.1em;}
.o-ring{display:inline-block;width:.62em;height:.62em;border:2.5px solid var(--gilt-lt);border-radius:50%;vertical-align:.02em;margin:0 .04em;}
.wizard{max-width:580px;margin:0 auto;padding:24px 22px 70px;}

/* PILLAR PROGRESS */
.pillbar{display:flex;align-items:center;justify-content:center;gap:4px;margin-bottom:26px;}
.pillbar.hide{display:none;}
.pill-wrap{display:flex;flex-direction:column;align-items:center;gap:4px;}
.pill{font-size:24px;color:var(--ink-mut);opacity:.35;transition:all .3s;line-height:1;}
.pill.active{opacity:1;transform:scale(1.3);}
.pill.done{opacity:1;}
.p-t.active,.p-t.done{color:var(--gilt);}
.p-f.active,.p-f.done{color:var(--govt);}
.p-m.active,.p-m.done{color:var(--market);}
.pill-lbl{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mut);opacity:0;transition:opacity .3s;}
.pill-wrap.active .pill-lbl{opacity:1;color:var(--ink-soft);}
.pline{width:34px;height:2px;background:var(--rule);margin:0 2px 16px;transition:background .3s;}
.pline.done{background:var(--gilt);}

.step{display:none;}
.step.active{display:block;animation:fade .32s ease;}
@keyframes fade{from{opacity:0;transform:translateY(7px);}to{opacity:1;transform:none;}}
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:10px;}
.e-temple{color:var(--temple);}.e-govt{color:var(--govt);}.e-market{color:var(--market);}
.step-h{font-family:'Libre Baskerville',serif;font-size:26px;font-weight:700;line-height:1.18;color:var(--blue);}
.step-sub{font-size:14.5px;color:var(--ink-soft);margin-top:10px;line-height:1.6;}
.step-sub b{color:var(--ink);}
.field{margin-top:17px;}
.label{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:6px;display:block;}
.input{width:100%;border:1.5px solid var(--rule);border-radius:11px;padding:12px 14px;font-family:'Nunito',sans-serif;font-size:15px;outline:none;color:var(--ink);background:#fff;}
.input::placeholder{color:var(--ink-mut);}
.input:focus{border-color:var(--blue);}
.row2{display:flex;gap:10px;}
.row2 .field{flex:1;margin-top:17px;}
.micro{font-size:11px;color:var(--ink-mut);margin-top:7px;line-height:1.5;}
.micro b{color:var(--ink-soft);}
.btn{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.09em;text-transform:uppercase;font-weight:700;border:none;border-radius:11px;padding:14px 22px;cursor:pointer;}
.btn-primary{background:var(--blue);color:#fff;}
.btn-primary:hover{background:var(--blue-md);}
.btn-primary:disabled{opacity:.55;cursor:not-allowed;}
.btn-wide{width:100%;}
.nav-row{display:flex;align-items:center;gap:12px;margin-top:24px;padding-top:18px;border-top:1px solid var(--rule);}
.back{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mut);background:none;border:none;cursor:pointer;}
.skip{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);background:none;border:1px solid var(--rule);border-radius:100px;padding:9px 15px;cursor:pointer;}
.cont{margin-left:auto;}
.note{font-size:11.5px;color:var(--ink-soft);border-radius:10px;padding:10px 12px;margin-top:11px;line-height:1.5;}
.note.t{background:var(--temple-tint);border:1px solid var(--gilt-rul);}
.note.f{background:var(--govt-tint);border:1px solid var(--blue-pl);}
.note.m{background:var(--market-tint);border:1px solid var(--green-pl);}
.note b{color:var(--ink);}

/* Inline error */
.err{font-size:12px;color:#8b1a1a;background:#fce8e8;border:1px solid #e8a0a0;border-radius:9px;padding:10px 13px;margin-top:13px;display:none;line-height:1.5;}
.err.show{display:block;}

/* WELCOME */
.welcome{background:var(--surface);border:1px solid var(--gilt-rul);border-radius:18px;overflow:hidden;}
.welcome .toprule{height:4px;background:linear-gradient(90deg,var(--gilt),var(--blue) 60%,var(--blue-md));}
.welcome .pad{padding:34px 34px 30px;}
@media(max-width:520px){.welcome .pad{padding:26px 22px;}}
.wbrand{font-family:'Libre Baskerville',serif;font-weight:700;font-size:25px;letter-spacing:.06em;color:var(--blue);text-align:center;}
.wmarks{display:flex;justify-content:center;gap:15px;margin:13px 0 4px;color:var(--gilt);font-size:14px;letter-spacing:.3em;}
.weyebrow{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-mut);text-align:center;margin-top:9px;}
.wdiv{height:1px;background:var(--gilt-rul);margin:24px 0;}
.greeting{font-family:'Libre Baskerville',serif;font-size:23px;font-weight:700;color:var(--blue);line-height:1.3;margin-bottom:16px;}
.letter p{font-size:14.5px;color:var(--ink);line-height:1.7;margin-bottom:15px;}
.letter .mas{color:var(--gilt);font-weight:700;font-style:italic;font-family:'Libre Baskerville',serif;}
.aside{color:var(--ink-soft);font-style:italic;}
.pull{font-family:'Libre Baskerville',serif;font-style:italic;font-size:16px;color:var(--blue-md);line-height:1.5;border-left:3px solid var(--gilt);padding:4px 0 4px 17px;margin:20px 0;}
.loop{display:flex;gap:9px;margin:22px 0 4px;flex-wrap:wrap;}
.loop-step{flex:1;min-width:110px;background:var(--blue-vp);border:1px solid var(--blue-pl);border-radius:11px;padding:12px 13px;}
.loop-mark{font-size:15px;margin-bottom:5px;}
.lm-t{color:var(--gilt);}.lm-f{color:var(--govt);}.lm-m{color:var(--market);}
.loop-t{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--blue-md);font-weight:500;margin-bottom:3px;}
.loop-d{font-size:11px;color:var(--ink-soft);line-height:1.45;}
.sig{margin-top:22px;}
.sig-line{font-size:13.5px;color:var(--ink-soft);margin-bottom:6px;}
.sig-name{font-family:'Libre Baskerville',serif;font-size:19px;font-weight:700;color:var(--blue);}
.sig-title{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--gilt);margin-top:3px;}
.cta-wrap{margin-top:26px;text-align:center;}

/* HANDLE SUGGESTIONS */
.handles{display:flex;flex-wrap:wrap;gap:8px;margin-top:9px;}
.handle{font-family:'JetBrains Mono',monospace;font-size:12px;padding:8px 13px;border-radius:100px;border:1.5px solid var(--rule);color:var(--ink-soft);cursor:pointer;background:#fff;}
.handle.on{background:var(--temple);color:#fff;border-color:var(--temple);}

/* TOGGLE */
.toggle-row{display:flex;align-items:center;gap:13px;margin-top:18px;padding:13px 15px;border:1px solid var(--rule);border-radius:12px;background:#fff;cursor:pointer;}
.tog{width:42px;height:24px;border-radius:100px;background:var(--ink-mut);flex-shrink:0;position:relative;transition:background .2s;}
.tog::after{content:'';position:absolute;top:2px;left:2px;width:20px;height:20px;border-radius:50%;background:#fff;transition:left .2s;}
.tog.on{background:var(--green);}
.tog.on::after{left:20px;}
.toggle-t{font-size:13.5px;font-weight:700;}
.toggle-d{font-size:11.5px;color:var(--ink-soft);margin-top:2px;}

/* CHIPS */
.qlbl{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:var(--ink);margin:22px 0 4px;}
.qh{font-size:12px;color:var(--ink-soft);margin-bottom:11px;line-height:1.5;}
.opt{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mut);font-weight:400;margin-left:8px;}
.chips{display:flex;flex-wrap:wrap;gap:8px;}
.chip{font-size:12.5px;font-weight:600;color:var(--ink);background:#fff;border:1px solid var(--rule);border-radius:18px;padding:8px 14px;cursor:pointer;transition:all .12s;display:flex;align-items:center;gap:6px;}
.chip:hover{border-color:var(--gilt);}
.chip.on{background:var(--gilt-pl);border-color:var(--gilt);color:#6b5300;}
.chip.f.on{background:var(--govt-pl);border-color:var(--govt);color:var(--govt);}
.chip.m.on{background:var(--market-pl);border-color:var(--market);color:var(--market);}

/* TEMPLE — bipolar scales */
.quiz-h{font-family:'Libre Baskerville',serif;font-size:15px;font-weight:700;color:var(--ink);margin:24px 0 12px;}
.lik{padding:13px 0;border-bottom:1px solid var(--rule);}
.lik:first-of-type{border-top:1px solid var(--rule);}
.lik-q{font-size:14px;font-weight:600;color:var(--ink);margin-bottom:11px;line-height:1.4;}
.lik-scale{display:flex;align-items:center;gap:9px;}
.lik-end{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.02em;text-transform:uppercase;color:var(--ink-soft);flex:0 0 72px;line-height:1.25;}
.lik-end.left{text-align:left;}
.lik-end.right{text-align:right;}
.lik-dots{flex:1;display:flex;align-items:center;justify-content:space-between;}
.lik-dot{width:20px;height:20px;border-radius:50%;border:1.5px solid var(--rule);cursor:pointer;transition:all .12s;flex:0 0 auto;}
.lik-dot:hover{border-color:var(--gilt);}
.lik-dot.on{background:var(--temple);border-color:var(--temple);transform:scale(1.12);}
.lead-rome{font-family:'Libre Baskerville',serif;font-size:15.5px;line-height:1.7;color:var(--ink);margin-top:6px;}
.lead-rome b{color:var(--blue);}

/* FAITH expander */
.expander{border:1px solid var(--rule);border-radius:12px;margin-top:20px;overflow:hidden;}
.expander-head{display:flex;align-items:center;gap:8px;padding:13px 15px;cursor:pointer;font-size:13px;font-weight:600;color:var(--ink-soft);}
.expander-head:hover{background:var(--temple-tint);}
.expander-head .opt{margin-left:auto;}
.expander-body{display:none;padding:4px 15px 16px;border-top:1px solid var(--rule);}
.expander.open .expander-body{display:block;}
.branch{margin-top:10px;padding-top:11px;border-top:1px dashed var(--rule);}

/* CIVIC card */
.civic{margin-top:16px;background:var(--field);border-radius:14px;overflow:hidden;}
.civic-top{padding:16px 18px 14px;border-bottom:1px solid var(--field-line);}
.civic-ey{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--gilt-lt);margin-bottom:7px;}
.civic-place{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:#fff;}
.civic-body{padding:6px 18px 14px;}
.lvl-h{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.35);margin:12px 0 5px;}
.rep{display:flex;align-items:center;gap:10px;padding:6px 0;}
.rep-av{width:28px;height:28px;border-radius:7px;background:var(--field-2);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:600;color:rgba(255,255,255,.7);flex-shrink:0;}
.rep-name{font-size:12.5px;font-weight:700;color:#fff;line-height:1.2;}
.rep-role{font-size:10px;color:rgba(255,255,255,.45);}
.civic-loading{padding:18px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.35);text-align:center;}

/* VERIFY methods */
.method{display:flex;align-items:center;gap:12px;padding:13px 15px;border:1.5px solid var(--rule);border-radius:12px;margin-top:11px;cursor:pointer;background:#fff;}
.method.on{border-color:var(--govt);background:var(--govt-pl);}
.method-ico{width:34px;height:34px;border-radius:9px;background:var(--govt-pl);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;}
.method-t{font-size:13.5px;font-weight:700;}
.method-d{font-size:11.5px;color:var(--ink-soft);margin-top:2px;}
.method-tag{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-mut);border:1px solid var(--rule);border-radius:100px;padding:3px 8px;flex-shrink:0;}
.creed{font-size:11.5px;color:var(--ink-soft);background:var(--green-tint);border:1px solid var(--green-pl);border-radius:10px;padding:11px 13px;margin-top:18px;line-height:1.55;}
.creed b{color:var(--green);}

/* MARKET — NAICS read */
.reads{display:none;align-items:center;gap:8px;margin-top:10px;font-size:12px;color:var(--market);background:var(--market-tint);border:1px solid var(--green-pl);border-radius:9px;padding:8px 12px;}
.reads.show{display:flex;}
.reads .spark{color:var(--gilt);font-weight:800;}
.reads b{color:var(--market);}
.naics{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-mut);margin-left:auto;}
.refine{display:none;margin-top:13px;padding:13px 15px;border:1px solid var(--green-pl);background:var(--market-tint);border-radius:12px;}
.refine.show{display:block;animation:fade .3s;}
.refine-q{font-size:13px;font-weight:700;margin-bottom:9px;}
.lic-link{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:var(--market);margin-top:12px;display:inline-block;cursor:pointer;}

/* DONE */
.done-card{text-align:center;padding:14px 0;}
.done-av{width:80px;height:80px;border-radius:50%;background:var(--blue);border:3px solid var(--ink-mut);display:flex;align-items:center;justify-content:center;font-family:'Libre Baskerville',serif;font-weight:700;color:#fff;font-size:30px;margin:6px auto 16px;}
.done-handle{font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;}
.done-place{font-size:13px;color:var(--ink-soft);margin-top:4px;}
.done-tags{display:flex;gap:7px;justify-content:center;flex-wrap:wrap;margin:16px 0 8px;}
.done-tag{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.05em;text-transform:uppercase;padding:5px 11px;border-radius:100px;background:#fff;border:1px solid var(--rule);color:var(--ink-soft);}
.done-ringnote{font-size:11.5px;color:var(--amber);background:var(--gilt-pl);border:1px solid var(--gilt-rul);border-radius:9px;padding:9px 12px;margin:0 auto 4px;max-width:340px;line-height:1.5;}
</style>
</head>
<body>

<div class="topbar"><span class="logo">F<span class="o-ring"></span>RA</span></div>

<div class="wizard" id="wizard" data-start="<%= @start_step %>">

  <div class="pillbar hide" id="pillbar">
    <div class="pill-wrap" id="wt"><span class="pill p-t" id="pt">◯</span><span class="pill-lbl">Temple</span></div>
    <span class="pline" id="l1"></span>
    <div class="pill-wrap" id="wf"><span class="pill p-f" id="pf">△</span><span class="pill-lbl">Forum</span></div>
    <span class="pline" id="l2"></span>
    <div class="pill-wrap" id="wm"><span class="pill p-m" id="pm">▢</span><span class="pill-lbl">Market</span></div>
  </div>

  <!-- ─────────────────────────────────── s0 · WELCOME ──── -->
  <section class="step" id="s0">
    <div class="welcome">
      <div class="toprule"></div>
      <div class="pad">
        <div class="wbrand">F<span class="o-ring"></span>RA</div>
        <div class="wmarks">◯ △ ▢</div>
        <div class="weyebrow">An augmented community environment</div>
        <div class="wdiv"></div>
        <div class="letter">
          <div class="greeting">Welcome to FORA.</div>
          <p>My name is Noah. I'm an American architect, and I built this so we can work together to <span class="mas">Live MAS</span> — and no, not the cheesy gordita crunch kind. <span class="aside">I mean Mutually Assured Success.</span></p>
          <p>I made FORA because we all do the same things alone. Figuring out what comes after high school. Buying a first house. Pulling a permit. Learning how our own government even works. Each one is a new, confusing labyrinth — and we each walk it in the dark, by ourselves.</p>
          <div class="pull">FORA stands on three pillars, the way cities always have: the Temple, the Forum, and the Market. In a moment you'll walk through each. Nobody arrives knowing the way — we learn it here, together.</div>
          <div class="loop">
            <div class="loop-step"><div class="loop-mark lm-t">◯</div><div class="loop-t">Temple</div><div class="loop-d">What you tend in yourself</div></div>
            <div class="loop-step"><div class="loop-mark lm-f">△</div><div class="loop-t">Forum</div><div class="loop-d">Your place in the public world</div></div>
            <div class="loop-step"><div class="loop-mark lm-m">▢</div><div class="loop-t">Market</div><div class="loop-d">What you exchange with others</div></div>
          </div>
          <div class="sig">
            <div class="sig-line">With love and respect,</div>
            <div class="sig-name">Noah</div>
            <div class="sig-title">Principal Generalist</div>
          </div>
        </div>
        <div class="cta-wrap"><button type="button" class="btn btn-primary btn-wide" onclick="go(1)">Create your login →</button></div>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────── s1 · WHO ────────── -->
  <section class="step" id="s1">
    <div class="eyebrow e-govt">Step 1 · Who you are</div>
    <div class="step-h">Let's get you situated.</div>
    <div class="step-sub">Your account, your place, and how you'll be known. <b>All private</b> — your address shows publicly only as your neighborhood. However new this all feels, you're in the right place.</div>

    <div class="field">
      <label class="label">Email</label>
      <input class="input" type="email" id="emailIn" placeholder="you@example.com" autocomplete="email">
      <div class="micro"><b>For sign-in only</b> — never shown beside your handle, never sold.</div>
    </div>
    <div class="field">
      <label class="label">Password</label>
      <input class="input" type="password" id="passIn" placeholder="Create a password" autocomplete="new-password">
    </div>
    <div class="field">
      <label class="label">Street address</label>
      <input class="input" type="text" id="addrLine" placeholder="1423 Earl St" autocomplete="street-address" oninput="suggestHandles()">
    </div>
    <div class="row2">
      <div class="field"><label class="label">City</label><input class="input" type="text" id="addrCity" placeholder="Philadelphia" autocomplete="address-level2" oninput="suggestHandles()"></div>
      <div class="field" style="max-width:96px"><label class="label">State</label><input class="input" type="text" id="addrState" placeholder="PA" autocomplete="address-level1" oninput="suggestHandles()"></div>
    </div>

    <div class="qlbl">How you'll show up <span class="opt">ideas before faces</span></div>
    <div class="qh">Pick a handle — your legal name stays private.</div>
    <div class="field" style="margin-top:0">
      <input class="input" type="text" id="handleIn" placeholder="@phl.neighbor">
      <div class="handles" id="handleSugs">
        <span class="handle on" onclick="pickHandle(this)">@phl.neighbor</span>
        <span class="handle"    onclick="pickHandle(this)">@phl.reader</span>
        <span class="handle"    onclick="pickHandle(this)">@phl.voter</span>
      </div>
    </div>

    <div class="toggle-row" id="photoRow" onclick="photoToggle()">
      <div class="tog" id="photoTog"></div>
      <div><div class="toggle-t">Show a profile photo</div><div class="toggle-d">Off by default — that's the point. People engage your ideas first. Turn it on anytime.</div></div>
    </div>

    <div class="err" id="err1"></div>

    <div class="nav-row">
      <button type="button" class="back" onclick="go(0)">← Back</button>
      <button type="button" class="btn btn-primary cont" id="btn1" onclick="submitAccount()">Enter the Temple →</button>
    </div>
  </section>

  <!-- ─────────────────────────────────── s2 · ◯ TEMPLE ──── -->
  <section class="step" id="s2">
    <div class="eyebrow e-temple">◯ The Temple · knowledge &amp; the self</div>
    <div class="step-h">A few questions, so your guide can know you.</div>
    <div class="lead-rome">The first universities were temples of learning — places to understand the world and yourself as one pursuit, reason and evidence beside faith and experience. That's this room. What follows is a short personality check — <b>no right answers</b> — so your guide learns the way you think, the way a good mentor would over time.</div>

    <div class="quiz-h">Where do you land on each?<span class="opt">no right answers</span></div>

    <!-- Scale 1: reason ↔ instinct  (→ temple_scale_reason) -->
    <div class="lik" id="likR">
      <div class="lik-q">When you're figuring something out, you lean on…</div>
      <div class="lik-scale">
        <span class="lik-end left">reason &amp; evidence</span>
        <span class="lik-dots">
          <span class="lik-dot" data-scale="likR" data-val="1" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likR" data-val="2" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likR" data-val="3" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likR" data-val="4" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likR" data-val="5" onclick="likPick(this)"></span>
        </span>
        <span class="lik-end right">instinct &amp; feeling</span>
      </div>
    </div>

    <!-- Scale 2: purpose ↔ comfort  (→ temple_scale_purpose) -->
    <div class="lik" id="likP">
      <div class="lik-q">What moves you more, day to day…</div>
      <div class="lik-scale">
        <span class="lik-end left">purpose</span>
        <span class="lik-dots">
          <span class="lik-dot" data-scale="likP" data-val="1" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likP" data-val="2" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likP" data-val="3" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likP" data-val="4" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likP" data-val="5" onclick="likPick(this)"></span>
        </span>
        <span class="lik-end right">comfort</span>
      </div>
    </div>

    <!-- Scale 3: balance ↔ grind  (→ temple_scale_balance) -->
    <div class="lik" id="likB">
      <div class="lik-q">Right now, you're after more…</div>
      <div class="lik-scale">
        <span class="lik-end left">balance &amp; rest</span>
        <span class="lik-dots">
          <span class="lik-dot" data-scale="likB" data-val="1" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likB" data-val="2" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likB" data-val="3" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likB" data-val="4" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likB" data-val="5" onclick="likPick(this)"></span>
        </span>
        <span class="lik-end right">push &amp; grind</span>
      </div>
    </div>

    <!-- Scale 4: own traditions ↔ many traditions  (→ temple_scale_tradition = sources-breadth scalar) -->
    <div class="lik" id="likS">
      <div class="lik-q">Your guide should draw from…</div>
      <div class="lik-scale">
        <span class="lik-end left">my own&nbsp;traditions</span>
        <span class="lik-dots">
          <span class="lik-dot" data-scale="likS" data-val="1" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likS" data-val="2" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likS" data-val="3" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likS" data-val="4" onclick="likPick(this)"></span>
          <span class="lik-dot" data-scale="likS" data-val="5" onclick="likPick(this)"></span>
        </span>
        <span class="lik-end right">many traditions</span>
      </div>
    </div>

    <div class="quiz-h">What are you most working to grow right now?<span class="opt">pick any</span></div>
    <div class="chips" id="growChips">
      <span class="chip" data-key="mind"    onclick="this.classList.toggle('on')">🧠 My mind</span>
      <span class="chip" data-key="body"    onclick="this.classList.toggle('on')">💪 My body</span>
      <span class="chip" data-key="meaning" onclick="growMeaning(this)">🧭 My sense of meaning</span>
      <span class="chip" data-key="means"   onclick="this.classList.toggle('on')">💵 My means</span>
    </div>

    <!-- Faith/tradition expander — optional free string, NOT a scale -->
    <div class="expander" id="tradExp">
      <div class="expander-head" onclick="document.getElementById('tradExp').classList.toggle('open')">
        <span>Name a tradition, faith, or philosophy your guide should know</span>
        <span class="opt">optional</span>
      </div>
      <div class="expander-body">
        <div class="chips" id="faithMajor">
          <span class="chip" onclick="majorPick(this,'christianity')">Christianity</span>
          <span class="chip" onclick="majorPick(this,'islam')">Islam</span>
          <span class="chip" onclick="majorPick(this,'judaism')">Judaism</span>
          <span class="chip" onclick="majorPick(this,'hinduism')">Hinduism</span>
          <span class="chip" onclick="majorPick(this,'buddhism')">Buddhism</span>
          <span class="chip" onclick="majorPick(this,'stoic')">Stoicism</span>
          <span class="chip" onclick="majorPick(this,'humanist')">Secular humanism</span>
          <span class="chip" onclick="majorPick(this,'other')">Another path</span>
        </div>
        <div class="chips branch" id="faithBranch" style="display:none"></div>
        <input class="input" id="faithCustom" style="margin-top:11px" placeholder="Or name your own — a school of thought, a teacher, a community">
      </div>
    </div>

    <div class="note t">Your guide is tuned to how <b>you</b> reason — skeptic or believer, it meets you there. You can deepen all of this anytime.</div>

    <div class="err" id="err2"></div>

    <div class="nav-row">
      <button type="button" class="back" onclick="go(1)">← Back</button>
      <button type="button" class="btn btn-primary cont" id="btn2" onclick="submitTemple()">Enter the Forum →</button>
    </div>
  </section>

  <!-- ─────────────────────────────────── s3 · △ FORUM ──── -->
  <section class="step" id="s3">
    <div class="eyebrow e-govt">△ The Forum · your place in the public world</div>
    <div class="step-h">This is your government.</div>
    <div class="step-sub">In Rome, the Forum was where the republic set its laws. Here it is yours — and <b>most of us don't really know how it works yet. That's exactly why you're here.</b> FORA teaches you as you go.</div>

    <!-- Civic card — populated by /join/resolve polling -->
    <div class="civic">
      <div class="civic-top">
        <div class="civic-ey">From your address · this is your civic home</div>
        <div class="civic-place" id="civicPlace">📍 Loading…</div>
      </div>
      <div class="civic-body" id="civicBody">
        <div class="civic-loading">Resolving your representatives…</div>
      </div>
    </div>

    <div class="qlbl">Have you served?<span class="opt">optional</span></div>
    <div class="qh">Service earns an honor bar on your profile.</div>
    <div class="chips" id="svcChips">
      <span class="chip f" data-svc="active"   onclick="svcToggle(this)">🎖 Active service</span>
      <span class="chip f" data-svc="veteran"  onclick="svcToggle(this)">⭐ Veteran</span>
    </div>

    <div class="qlbl">Verify that you live here<span class="opt">optional</span></div>
    <div class="qh">Anyone can type an address. Verifying lets an official see you're a real resident, not noise.</div>
    <div class="method on" id="mPostcard" onclick="pickMethod('postcard')">
      <div class="method-ico">✉️</div>
      <div><div class="method-t">Mailed verification code</div><div class="method-d">A postcard to your address, 5–7 days.</div></div>
      <span class="method-tag">verifies residency</span>
    </div>
    <div class="method" id="mId" onclick="pickMethod('id_match')">
      <div class="method-ico">🪪</div>
      <div><div class="method-t">ID + address match</div><div class="method-d">Instant. Your details aren't stored after the check.</div></div>
      <span class="method-tag">verifies residency</span>
    </div>

    <div class="creed"><b>FORA verifies where you live, not your citizenship.</b> Everyone who lives here is governed here and has a stake here. We never ask, store, or share your immigration status.</div>

    <div class="err" id="err3"></div>

    <div class="nav-row">
      <button type="button" class="back" onclick="go(2)">← Back</button>
      <button type="button" class="skip" onclick="clearMethod(); submitForum('none','')">Verify later</button>
      <button type="button" class="btn btn-primary" id="btn3" style="flex:0 0 auto" onclick="submitForum()">Enter the Market →</button>
    </div>
  </section>

  <!-- ─────────────────────────────────── s4 · ▢ MARKET ──── -->
  <section class="step" id="s4">
    <div class="eyebrow e-market">▢ The Market · what you exchange with others</div>
    <div class="step-h">Two sides of one square.</div>
    <div class="step-sub">In Rome, the Market was where goods and services changed hands. Most people are on both sides — you look after things, and you may offer something too.</div>

    <div class="qlbl">What's your day's work?<span class="opt">optional</span></div>
    <input class="input" id="workIn" placeholder="e.g. I paint houses — interiors and finish work" oninput="readWork()">
    <div class="reads" id="reads">
      <span class="spark">✦</span>
      <span>FORA reads this as <b id="readCat">—</b></span>
      <span class="naics" id="readNaics"></span>
    </div>

    <div class="qlbl">What do you take care of?</div>
    <div class="qh">Each one opens a dashboard — maintenance schedules, service history, and the right pro when it's time.</div>
    <div class="chips" id="careChips">
      <span class="chip m" data-key="home"     onclick="this.classList.toggle('on')">🏠 Home</span>
      <span class="chip m" data-key="car"      onclick="this.classList.toggle('on')">🚗 Car</span>
      <span class="chip m" data-key="pets"     onclick="this.classList.toggle('on')">🐶 Pets</span>
      <span class="chip m" data-key="kids"     onclick="this.classList.toggle('on')">👶 Kids</span>
      <span class="chip m" data-key="yard"     onclick="this.classList.toggle('on')">🌿 Yard</span>
      <span class="chip m" data-key="business" onclick="this.classList.toggle('on')">🏢 Business</span>
    </div>

    <div class="toggle-row" id="offerRow" onclick="offerToggle()">
      <div class="tog" id="offerTog"></div>
      <div><div class="toggle-t">I offer a skill or service people can hire</div><div class="toggle-d">Opens your Market workspace — set your own prices, hold your clients, get found.</div></div>
    </div>
    <div class="refine" id="refine">
      <div class="refine-q">Is it a registered business?</div>
      <div class="chips" id="entityChips">
        <span class="chip m" data-entity="true"  onclick="bizPick(this)">Yes — I have an LLC or entity</span>
        <span class="chip m" data-entity="false" onclick="bizPick(this)">Not yet — just me</span>
      </div>
      <div class="note m" style="margin-top:11px">"Not yet" is fine — FORA's startup guide walks you through forming one when you're ready. Either way you get the workspace.</div>
      <span class="lic-link">+ Verify a professional license for your gold check →</span>
    </div>

    <div class="err" id="err4"></div>

    <div class="nav-row">
      <button type="button" class="back" onclick="go(3)">← Back</button>
      <button type="button" class="btn btn-primary cont" id="btn4" onclick="submitMarket()">Finish →</button>
    </div>
  </section>

  <!-- ─────────────────────────────────── s5 · DONE ─────── -->
  <section class="step" id="s5">
    <div class="done-card">
      <div class="done-av" id="doneAv">?</div>
      <div class="done-handle" id="doneHandle"></div>
      <div class="done-place"  id="donePlace"></div>
      <div class="done-tags">
        <span class="done-tag">◯ Temple</span>
        <span class="done-tag">△ Forum</span>
        <span class="done-tag">▢ Market</span>
      </div>
      <%# Gold ring note shown always here — ring renders only once residency_verified = true (set by verification flow) %>
      <div class="done-ringnote">Verify your address to earn your gold ring — the mark of a confirmed resident.</div>
      <div class="step-sub" style="margin-top:10px">Welcome to the room. Your feed is ready, and it'll keep teaching you as you go. Nobody has this all figured out — that's what we're here for.</div>
      <div class="err" id="err5"></div>
      <button type="button" class="btn btn-primary btn-wide" id="btn5" style="margin-top:22px" onclick="finalize()">Enter FORA →</button>
    </div>
  </section>

</div><!-- /.wizard -->

<script>
// ── State ────────────────────────────────────────────────────────────────────
var cur = 0;
var selectedMethod = 'postcard'; // default in Forum step
var detectedNaics  = '';         // set by readWork()
var resolvePolls   = 0;          // civic-card poll counter

// ── Step navigation ──────────────────────────────────────────────────────────
function go(n) {
  document.getElementById('s' + cur).classList.remove('active');
  cur = n;
  document.getElementById('s' + cur).classList.add('active');
  setPills(n);
  if (n === 3) startCivicPoll();
  if (n === 5) buildDoneCard();
  window.scrollTo(0, 0);
}

function setPills(n) {
  var bar = document.getElementById('pillbar');
  if (n === 0) { bar.classList.add('hide'); return; }
  bar.classList.remove('hide');
  var pt = document.getElementById('pt'), pf = document.getElementById('pf'), pm = document.getElementById('pm');
  var l1 = document.getElementById('l1'), l2 = document.getElementById('l2');
  var wt = document.getElementById('wt'), wf = document.getElementById('wf'), wm = document.getElementById('wm');
  [pt, pf, pm].forEach(function(p) { p.className = p.className.replace(/ ?(active|done)/g, ''); });
  [wt, wf, wm].forEach(function(w) { w.classList.remove('active'); });
  l1.classList.remove('done'); l2.classList.remove('done');
  pt.classList.add('p-t'); pf.classList.add('p-f'); pm.classList.add('p-m');
  if (n >= 3) { pt.classList.add('done'); l1.classList.add('done'); }
  if (n >= 4) { pf.classList.add('done'); l2.classList.add('done'); }
  if (n >= 5) { pm.classList.add('done'); }
  if (n === 2) { pt.classList.add('active'); wt.classList.add('active'); }
  if (n === 3) { pf.classList.add('active'); wf.classList.add('active'); }
  if (n === 4) { pm.classList.add('active'); wm.classList.add('active'); }
}

// ── CSRF ─────────────────────────────────────────────────────────────────────
function csrf() {
  return document.querySelector('meta[name="csrf-token"]').getAttribute('content');
}

// ── Error display ─────────────────────────────────────────────────────────────
function showErr(stepId, msgs) {
  var el = document.getElementById('err' + stepId);
  if (!el) return;
  el.textContent = Array.isArray(msgs) ? msgs.join(' · ') : msgs;
  el.classList.add('show');
}
function clearErr(stepId) {
  var el = document.getElementById('err' + stepId);
  if (el) { el.textContent = ''; el.classList.remove('show'); }
}
function setLoading(btnId, loading) {
  var btn = document.getElementById(btnId);
  if (!btn) return;
  btn.disabled = loading;
  if (loading) btn.setAttribute('data-orig', btn.textContent);
  else btn.textContent = btn.getAttribute('data-orig') || btn.textContent;
}

// ── Step 1: account ──────────────────────────────────────────────────────────
function photoToggle() {
  document.getElementById('photoTog').classList.toggle('on');
}

function suggestHandles() {
  var city  = (document.getElementById('addrCity').value  || '').trim().toLowerCase();
  var line  = (document.getElementById('addrLine').value  || '').trim().toLowerCase();
  if (!city && !line) return;
  var slug = city.replace(/[^a-z0-9]/g, '') || 'local';
  var street = line.split(/\s+/).filter(function(p) { return isNaN(p); })[0] || '';
  street = street.replace(/[^a-z]/gi, '').toLowerCase().slice(0, 8);
  var handles = [
    '@' + slug + (street ? '.' + street : '') + '.neighbor',
    '@' + slug + '.reader',
    '@' + slug + '.voter'
  ];
  var sugs = document.getElementById('handleSugs');
  sugs.innerHTML = handles.map(function(h, i) {
    return '<span class="handle' + (i === 0 ? ' on' : '') + '" onclick="pickHandle(this)">' + h + '</span>';
  }).join('');
  document.getElementById('handleIn').value = handles[0];
}

function pickHandle(el) {
  document.querySelectorAll('.handle').forEach(function(h) { h.classList.remove('on'); });
  el.classList.add('on');
  document.getElementById('handleIn').value = el.textContent.trim();
}

async function submitAccount() {
  clearErr(1);
  var email  = document.getElementById('emailIn').value.trim();
  var pass   = document.getElementById('passIn').value;
  var handle = document.getElementById('handleIn').value.trim();
  var line   = document.getElementById('addrLine').value.trim();
  var city   = document.getElementById('addrCity').value.trim();
  var state  = document.getElementById('addrState').value.trim();
  var photo  = document.getElementById('photoTog').classList.contains('on');

  if (!email || !pass || !handle || !line || !city || !state) {
    showErr(1, 'Please fill in all fields.'); return;
  }

  setLoading('btn1', true);
  try {
    var res = await fetch('/join/account', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
      body: JSON.stringify({
        user:    { email: email, password: pass, handle: handle },
        profile: { address_line1: line, address_city: city, address_state: state, show_photo: photo }
      })
    });
    var data = await res.json();
    if (res.ok) {
      go(2);
    } else {
      showErr(1, data.errors || ['Something went wrong.']);
    }
  } catch (e) {
    showErr(1, 'Network error — please try again.');
  } finally {
    setLoading('btn1', false);
  }
}

// ── Step 2: Temple ────────────────────────────────────────────────────────────
// Tracks which scale value is selected per scale group.
var scaleVals = { likR: null, likP: null, likB: null, likS: null };

function likPick(el) {
  var scaleId = el.getAttribute('data-scale');
  var val     = parseInt(el.getAttribute('data-val'), 10);
  // clear siblings in this scale row
  el.closest('.lik').querySelectorAll('.lik-dot').forEach(function(d) { d.classList.remove('on'); });
  el.classList.add('on');
  scaleVals[scaleId] = val;
}

function growMeaning(el) {
  el.classList.toggle('on');
  if (el.classList.contains('on')) { document.getElementById('tradExp').classList.add('open'); }
}

var faithTrad = '', faithBranch = '';
var BRANCHES = {
  christianity: ['Roman Catholic','Eastern Orthodox','Coptic Orthodox','Anglican','Lutheran','Presbyterian','Methodist','AME','Baptist','Pentecostal','Non-denominational','Seventh-day Adventist','Anabaptist','Quaker','Latter-day Saints','Jehovah\'s Witnesses'],
  islam:        ['Sunni','Twelver Shia','Ismaili Shia','Ibadi','Sufism','Alawite','Alevism','Ahmadiyya'],
  hinduism:     ['Shaivism','Vaishnavism','Shaktism'],
  buddhism:     ['Theravada','Mahayana','Vajrayana'],
  stoic:        [], humanist: []
};
function majorPick(el, key) {
  document.querySelectorAll('#faithMajor .chip').forEach(function(c) { c.classList.remove('on'); });
  el.classList.add('on');
  faithTrad = key; faithBranch = '';
  var b = document.getElementById('faithBranch');
  var list = BRANCHES[key] || [];
  if (list.length) {
    b.style.display = 'flex';
    b.innerHTML = list.map(function(x) {
      return '<span class="chip" onclick="branchPick(this,\'' + x.replace(/'/g, "\\'") + '\')">' + x + '</span>';
    }).join('');
  } else { b.style.display = 'none'; b.innerHTML = ''; }
}
function branchPick(el, val) {
  el.parentElement.querySelectorAll('.chip').forEach(function(c) { c.classList.remove('on'); });
  el.classList.add('on'); faithBranch = val;
}

async function submitTemple() {
  clearErr(2);
  var customFaith = document.getElementById('faithCustom').value.trim();
  var tradition   = faithTrad || customFaith || null;
  var grow        = Array.from(document.querySelectorAll('#growChips .chip.on')).map(function(c) { return c.getAttribute('data-key'); });

  setLoading('btn2', true);
  try {
    var res = await fetch('/join/temple', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
      body: JSON.stringify({
        temple: {
          reason_instinct:  scaleVals.likR,
          purpose_comfort:  scaleVals.likP,
          balance_grind:    scaleVals.likB,
          sources_breadth:  scaleVals.likS,
          faith_tradition:  tradition,
          faith_branch:     faithBranch || null,
          grow_areas:       grow
        }
      })
    });
    var data = await res.json();
    if (res.ok) {
      go(3); // entering Forum triggers startCivicPoll() via go()
    } else {
      showErr(2, data.errors || ['Something went wrong.']);
    }
  } catch (e) {
    showErr(2, 'Network error — please try again.');
  } finally {
    setLoading('btn2', false);
  }
}

// ── Step 3: Forum — civic-card polling ───────────────────────────────────────
function startCivicPoll() {
  resolvePolls = 0;
  pollCivic();
}

async function pollCivic() {
  if (resolvePolls > 14) return; // ~28 s max
  resolvePolls++;
  try {
    var res  = await fetch('/join/resolve', { headers: { 'X-CSRF-Token': csrf() } });
    var data = await res.json();
    if (data.ready) {
      renderCivicCard(data.place, data.officials);
    } else {
      setTimeout(pollCivic, 2000);
    }
  } catch (e) {
    setTimeout(pollCivic, 3000);
  }
}

function renderCivicCard(place, officials) {
  document.getElementById('civicPlace').textContent = '📍 ' + place;
  var levels = { federal: [], state: [], local: [] };
  (officials || []).forEach(function(o) { (levels[o.level] || levels.local).push(o); });
  var html = '';
  if (levels.federal.length) {
    html += '<div class="lvl-h">Federal</div>';
    levels.federal.forEach(function(o) {
      html += '<div class="rep"><div class="rep-av">US</div><div><div class="rep-name">' + esc(o.name) + '</div><div class="rep-role">' + esc(o.role) + '</div></div></div>';
    });
  }
  if (levels.state.length || levels.local.length) {
    html += '<div class="lvl-h">State &amp; City</div>';
    levels.state.concat(levels.local).forEach(function(o) {
      var av = o.level === 'state' ? 'PA' : '◯';
      html += '<div class="rep"><div class="rep-av">' + av + '</div><div><div class="rep-name">' + esc(o.name) + '</div><div class="rep-role">' + esc(o.role) + '</div></div></div>';
    });
  }
  if (!html) {
    html = '<div class="civic-loading">Representatives loaded.</div>';
  }
  document.getElementById('civicBody').innerHTML = html;
}

function esc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function svcToggle(el) { el.classList.toggle('on'); }

function pickMethod(key) {
  selectedMethod = key;
  document.getElementById('mPostcard').classList.toggle('on', key === 'postcard');
  document.getElementById('mId').classList.toggle('on',       key === 'id_match');
}

function clearMethod() { selectedMethod = ''; }

async function submitForum(svcOverride, methodOverride) {
  clearErr(3);
  var svcEl  = document.querySelector('#svcChips .chip.on');
  var svc    = svcOverride !== undefined ? svcOverride : (svcEl ? svcEl.getAttribute('data-svc') : 'none');
  var method = methodOverride !== undefined ? methodOverride : selectedMethod;

  setLoading('btn3', true);
  try {
    var res = await fetch('/join/forum', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
      body: JSON.stringify({
        forum: { service_status: svc || 'none', residency_verify_method: method || null }
      })
    });
    var data = await res.json();
    if (res.ok) {
      go(4);
    } else {
      showErr(3, data.errors || ['Something went wrong.']);
    }
  } catch (e) {
    showErr(3, 'Network error — please try again.');
  } finally {
    setLoading('btn3', false);
  }
}

// ── Step 4: Market ────────────────────────────────────────────────────────────
var NAICS_MAP = [
  {k:['paint'],             c:'Skilled Trades · Painting',    n:'238320'},
  {k:['electric'],          c:'Skilled Trades · Electrical',  n:'238210'},
  {k:['plumb'],             c:'Skilled Trades · Plumbing',    n:'238220'},
  {k:['nurse','rn'],        c:'Healthcare · Nursing',         n:'621399'},
  {k:['teach'],             c:'Education',                    n:'611110'},
  {k:['law','attorney','lawyer'], c:'Law',                    n:'541110'},
  {k:['inspect'],           c:'Building Inspection',          n:'541350'},
  {k:['cook','chef'],       c:'Culinary',                     n:'722330'},
  {k:['art','mural','craft'], c:'Arts & Crafts',              n:'711510'}
];

function readWork() {
  var v   = document.getElementById('workIn').value.toLowerCase();
  var row = document.getElementById('reads');
  if (v.trim().length < 3) { row.classList.remove('show'); detectedNaics = ''; return; }
  var hit = NAICS_MAP.find(function(m) { return m.k.some(function(k) { return v.includes(k); }); });
  document.getElementById('readCat').textContent   = hit ? hit.c : 'we\'ll categorize this for you';
  document.getElementById('readNaics').textContent = hit ? 'NAICS ' + hit.n : '';
  detectedNaics = hit ? hit.n : '';
  row.classList.add('show');
}

function offerToggle() {
  var tog = document.getElementById('offerTog');
  tog.classList.toggle('on');
  document.getElementById('refine').classList.toggle('show', tog.classList.contains('on'));
}

function bizPick(el) {
  document.querySelectorAll('#entityChips .chip').forEach(function(c) { c.classList.remove('on'); });
  el.classList.add('on');
}

async function submitMarket() {
  clearErr(4);
  var workText   = document.getElementById('workIn').value.trim();
  var careTags   = Array.from(document.querySelectorAll('#careChips .chip.on')).map(function(c) { return c.getAttribute('data-key'); });
  var provider   = document.getElementById('offerTog').classList.contains('on');
  var entityEl   = document.querySelector('#entityChips .chip.on');
  var hasEntity  = entityEl ? entityEl.getAttribute('data-entity') === 'true' : null;

  setLoading('btn4', true);
  try {
    var res = await fetch('/join/market', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
      body: JSON.stringify({
        market: {
          service_summary: workText || null,
          naics_code:      detectedNaics || null,
          provider_mode:   provider,
          has_entity:      hasEntity,
          care_tags:       careTags
        }
      })
    });
    var data = await res.json();
    if (res.ok) {
      go(5);
    } else {
      showErr(4, data.errors || ['Something went wrong.']);
    }
  } catch (e) {
    showErr(4, 'Network error — please try again.');
  } finally {
    setLoading('btn4', false);
  }
}

// ── Step 5: Done + finalize ───────────────────────────────────────────────────
function buildDoneCard() {
  var handle = document.getElementById('handleIn').value || '—';
  var city   = document.getElementById('addrCity').value  || '';
  var state  = document.getElementById('addrState').value || '';
  var letter = handle.replace('@', '')[0] || '?';
  document.getElementById('doneAv').textContent     = letter.toUpperCase();
  document.getElementById('doneHandle').textContent = handle;
  document.getElementById('donePlace').textContent  = 'Resident of ' + [city, state].filter(Boolean).join(', ');
}

async function finalize() {
  clearErr(5);
  setLoading('btn5', true);
  try {
    var res = await fetch('/join/complete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() }
    });
    var data = await res.json();
    if (res.ok && data.redirect) {
      window.location.href = data.redirect;
    } else {
      showErr(5, data.errors || ['Something went wrong.']);
      setLoading('btn5', false);
    }
  } catch (e) {
    showErr(5, 'Network error — please try again.');
    setLoading('btn5', false);
  }
}

// ── Resume from server-side onboarding_step ───────────────────────────────────
(function() {
  var start = parseInt(document.getElementById('wizard').getAttribute('data-start') || '0', 10);
  if (start > 0) go(start);
})();
</script>
</body>
</html>
