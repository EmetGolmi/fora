<!-- ═══════════════ STICKY VOTE FOOTER ═══════════════ -->
<div class="cast-bar" id="cast-bar">
  <div class="cast-bar-left">
    <div class="cast-bar-title">🗳 Pre-Vote Ballot · Pennsylvania Primary · May 19</div>
    <div class="cast-bar-progress">
      <div class="cast-bar-progress-track">
        <div class="cast-bar-progress-fill" id="cast-progress-fill" style="width:0%"></div>
      </div>
      <span class="cast-bar-progress-label" id="cast-progress-label">0 of 6 races selected</span>
    </div>
  </div>
  <div class="cast-bar-right">
    <div class="cast-bar-polling">
      Your polling place tomorrow<strong>Our Lady of Lebanon Maronite Cathedral</strong>
      <a href="https://www.google.com/maps/dir/?api=1&destination=1000+Ellsworth+St+Philadelphia+PA+19147" target="_blank" style="color:var(--gilt-lt);font-weight:700;text-decoration:none;font-size:9px;">Get directions →</a>
    </div>
    <button class="cast-bar-btn" id="cast-bar-btn" onclick="castPreBallot()" disabled>Cast My Pre-Ballot →</button>
  </div>
