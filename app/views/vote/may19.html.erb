<script>
// ── Countdown ──
function updateCountdown() {
  const target = new Date('2026-05-19T07:00:00');
  const diff = Math.max(0, target - new Date());
  const pad = n => String(Math.floor(n)).padStart(2,'0');
  const h = diff/3600000, m = (diff%3600000)/60000, s = (diff%60000)/1000;
  ['cd-h','cd-m','cd-s'].forEach((id,i)=>{const e=document.getElementById(id);if(e)e.textContent=pad([h,m,s][i]);});
}
updateCountdown();
setInterval(updateCountdown, 1000);

// ── Comment threads ──
function toggleThread(tid) {
  const body = document.getElementById('ask-body-'+tid);
  const tog  = document.getElementById('ask-toggle-'+tid);
  if(!body) return;
  body.classList.toggle('open');
  tog.textContent = body.classList.contains('open') ? '− Close' : '+ Open';
}
function setType(btn,type) {
  btn.closest('.comment-compose').querySelectorAll('.compose-type-btn').forEach(b=>b.className='compose-type-btn');
  btn.classList.add('active-'+type);
}
function submitComment(tid,btn) {
  const compose = btn.closest('.comment-compose');
  const ta = compose.querySelector('.compose-textarea');
  const text = ta.value.trim();
  if(!text) return;
  const ab = compose.querySelector('[class*="active-"]');
  const type = ab ? ab.textContent.toLowerCase() : 'perspective';
  const typeLabel = type[0].toUpperCase()+type.slice(1);
  const el = document.createElement('div');
  el.className = 'comment-row';
  el.style.animation = 'fadeIn 0.3s ease';
  const linkVal = (compose.querySelector('.compose-link-input')?.value || '').trim();
  el.innerHTML = `<div class="comment-avatar" style="background:var(--gilt-pl);color:var(--gilt);">Y</div>
    <div class="comment-bubble">
      <div class="comment-meta"><span class="comment-name">You</span><span class="comment-type ct-${type}">${typeLabel}</span><span class="comment-time">Just now</span></div>
      <div class="comment-text">${text.replace(/</g,'&lt;')}</div>
      ${linkVal ? '<div style="margin-top:5px;"><a href="' + linkVal + '" target="_blank" rel="noopener" style="font-family:var(--font-mono);font-size:9px;color:var(--blue-lt);text-decoration:none;word-break:break-all;">🔗 ' + linkVal + '</a></div>' : ''}
      <div class="comment-actions"><button class="comment-vote-btn" onclick="concurComment(this)">▲ Concur <span>0</span></button></div>
    </div>`;
  compose.parentNode.insertBefore(el, compose);
  ta.value = '';
  const li = compose.querySelector('.compose-link-input'); if(li) li.value = '';
  const hdr = document.getElementById('ask-thread-'+tid).querySelector('.ask-thread-count');
  const m = hdr.textContent.match(/(\d+)/);
  if(m) hdr.textContent = `${parseInt(m[1])+1} community contributions · Tap to expand`;
}
function concurComment(btn) {
  btn.classList.toggle('voted');
  const sp = btn.querySelector('span');
  sp.textContent = btn.classList.contains('voted') ? parseInt(sp.textContent)+1 : parseInt(sp.textContent)-1;
}

// ── Integrated vote selector ──
const preVote = {};
const raceLabels = {
  governor:'Governor', ltgov:'Lt. Governor', congress:'U.S. Rep (3rd District)',
  rep:'PA State Rep (182nd)', q1:'Ballot Q1', q2:'Ballot Q2'
};
const candLabels = {
  shapiro:'Josh Shapiro (D)', garrity:'Stacy Garrity (R)',
  davis:'Austin Davis (D)', ventre:'John Ventre (R)', richey:'Jason Richey (R)',
  stanford:'Ala Stanford (D)', street:'Sharif Street (D)', rabb:'Chris Rabb (D)', griffith:'Shaun Griffith (D)',
  scanlon:'Mary Gay Scanlon (D)', waxman:'Ben Waxman (D)', yes:'YES', no:'NO'
};
const totalRaces = 6; // governor, ltgov, congress, q1, q2

function integratedVote(race, cand, el, isQuestion) {
  if(isQuestion) { selectBallotQ(race, cand); return; }
  // Clear all options in this race
  document.getElementById('ivs-'+race).querySelectorAll('.ivs-option').forEach(o=>{
    o.classList.remove('ivs-selected','ivs-selected-q');
  });
  // Select this one
  el.classList.add(isQuestion ? 'ivs-selected-q' : 'ivs-selected');
  preVote[race] = cand;

  // Update status pill
  const status = document.getElementById('ivs-status-'+race);
  status.textContent = '✓ ' + (candLabels[cand]||cand);
  status.classList.add('done');

  updateCastBar();
}

function updateCastBar() {
  const count = Object.keys(preVote).length;
  const pct = Math.round((count/totalRaces)*100);
  document.getElementById('cast-progress-fill').style.width = pct+'%';
  document.getElementById('cast-progress-label').textContent = count+' of '+totalRaces+' races selected';
  const btn = document.getElementById('cast-bar-btn');
  if(count >= totalRaces) {
    btn.disabled = false;
    btn.style.background = '#004C54';
    btn.style.boxShadow = '0 0 16px rgba(0,76,84,0.6)';
    btn.textContent = 'Go Birds! Cast My Pre-Ballot 🦅';
  } else {
    btn.disabled = true;
    btn.style.background = '';
    btn.style.boxShadow = '';
    btn.textContent = 'Cast My Pre-Ballot →';
  }
  // swallow old body
  if(false) {
  }// end swallow
}

function castPreBallot() {
  if(Object.keys(preVote).length < totalRaces) return;
  // Validate any write-ins have a name
  for(const [race, val] of Object.entries(preVote)) {
    if(val === 'write-in:') {
      const input = document.getElementById('ivs-writein-input-' + race);
      if(input) { input.focus(); input.style.borderColor = 'var(--scarlet)'; }
      showToast('Please enter a write-in candidate name for ' + (raceLabels[race]||race));
      return;
    }
  }
  const btn = document.getElementById('cast-bar-btn');
  btn.textContent = '🦅 Fly Eagles Fly! See you at the polls.';
  btn.style.background = '#004C54';
  btn.style.boxShadow = '0 0 24px rgba(0,76,84,0.8)';
  btn.classList.add('cast-done');
  btn.disabled = true;
  document.getElementById('cast-progress-fill').style.background = 'var(--green-lt)';
  document.getElementById('cast-progress-fill').style.background = '#004C54';
  document.getElementById('cast-progress-label').textContent = 'Pre-ballot cast · Fly Eagles Fly! See you at the polls May 19 🦅';

  // Show a toast
  showToast('🦅 Fly Eagles Fly! Pre-ballot saved. See you at the polls May 19.');
}

// ── Share ──
function copyShare(event, text) {
  event.stopPropagation();
  navigator.clipboard.writeText(text).then(()=>showToast('Copied to clipboard')).catch(()=>{
    const ta = document.createElement('textarea');
    ta.value = text; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
    showToast('Copied to clipboard');
  });
}

function showToast(msg) {
  const t = document.createElement('div');
  t.className = 'copy-toast';
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(), 2000);
}

// ── Profile modal ──
function openProfile(event, card) {
  if(event.target.closest('button')||event.target.closest('a')||event.target.closest('.ivs-option')) return;
  const nameEl = card.querySelector('.cc-name');
  const metaEl = card.querySelector('.cc-meta');
  const bioEl  = card.querySelector('.cc-bio');
  if(!nameEl) return;
  let modal = document.getElementById('profile-modal');
  if(modal) modal.remove();
  modal = document.createElement('div');
  modal.id = 'profile-modal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(14,26,46,0.65);backdrop-filter:blur(4px);z-index:500;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s;';
  const initials = nameEl.textContent.trim().split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
  modal.innerHTML = `<div style="background:var(--white);border:1px solid var(--rule-md);border-radius:12px;width:520px;max-height:82vh;overflow-y:auto;box-shadow:0 20px 60px rgba(27,58,107,0.2);transform:translateY(16px);transition:transform 0.25s;">
    <div style="background:var(--blue);padding:20px 24px 16px;border-radius:12px 12px 0 0;display:flex;align-items:flex-start;gap:14px;">
      <div style="width:52px;height:52px;border-radius:10px;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center;font-family:var(--font-serif);font-size:20px;font-weight:700;color:white;flex-shrink:0;border:2px solid rgba(255,255,255,0.2);">${initials}</div>
      <div style="flex:1;"><div style="font-family:var(--font-serif);font-size:18px;font-weight:700;color:white;margin-bottom:3px;">${nameEl.textContent}</div>
      <div style="font-family:var(--font-mono);font-size:9px;letter-spacing:0.08em;color:rgba(255,255,255,0.5);text-transform:uppercase;">${metaEl?metaEl.textContent:''}</div></div>
      <button onclick="this.closest('#profile-modal').style.opacity='0';setTimeout(()=>this.closest('#profile-modal').remove(),200);" style="width:28px;height:28px;border-radius:5px;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.7);cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">✕</button>
    </div>
    <div style="padding:20px 24px;">
      <div style="font-family:var(--font-mono);font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:6px;">About this candidate</div>
      <div style="font-size:13px;color:var(--ink-soft);line-height:1.65;margin-bottom:16px;">${bioEl?bioEl.textContent:'Full biography coming soon.'}</div>
      <div id="pm-profile-block" style="background:var(--blue-xs);border:1px solid var(--blue-pl);border-radius:6px;padding:12px 16px;">
        <div id="pm-profile-label" style="font-family:var(--font-mono);font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:var(--blue-lt);margin-bottom:4px;">FORA Official Profile · In Development</div>
        <div id="pm-profile-desc" style="font-size:12px;color:var(--ink-soft);line-height:1.6;">Full profiles — voting record, donor history, social media, sponsored legislation, and community discourse — will live at fora.center/officials/[name].</div>
        <div id="pm-profile-btn-wrap" style="margin-top:10px;"><button disabled style="padding:7px 16px;background:var(--blue);color:white;border:none;border-radius:4px;font-family:var(--font-ui);font-size:12px;font-weight:700;cursor:not-allowed;opacity:0.5;">Profile In Progress</button></div>
      </div>
    </div>
  </div>`;
  modal.addEventListener('click',e=>{if(e.target===modal){modal.style.opacity='0';setTimeout(()=>modal.remove(),200);}});
  document.body.appendChild(modal);
  requestAnimationFrame(()=>{modal.style.opacity='1';modal.querySelector('div').style.transform='translateY(0)';});
  const profileUrl = card.dataset.profileUrl;
  const btnWrap = modal.querySelector('#pm-profile-btn-wrap');
  const labelEl = modal.querySelector('#pm-profile-label');
  if(profileUrl && btnWrap) {
    if(labelEl) labelEl.textContent = 'FORA Official Profile';
    modal.querySelector('#pm-profile-desc').textContent = 'This official has a full profile on FORA — voting record, donor history, social media, sponsored legislation, and community discourse.';
    btnWrap.innerHTML = '<a href="' + profileUrl + '" style="display:inline-block;padding:7px 16px;background:var(--blue);color:white;border:none;border-radius:4px;font-family:var(--font-ui);font-size:12px;font-weight:700;text-decoration:none;">View Full Profile →</a>';
  } else if(btnWrap) {
    btnWrap.innerHTML = '<button disabled style="padding:7px 16px;background:var(--blue);color:white;border:none;border-radius:4px;font-family:var(--font-ui);font-size:12px;font-weight:700;cursor:not-allowed;opacity:0.5;">Profile In Progress</button>';
  }
}

// ── Keyframes ──
const _s=document.createElement('style');
_s.textContent='@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}';
document.head.appendChild(_s);

// ── Write-in handling ──
function selectWriteIn(race, el) {
  // Deselect all options in this race
  const ivsBlock = document.getElementById('ivs-' + race);
  ivsBlock.querySelectorAll('.ivs-option').forEach(o => o.classList.remove('ivs-selected','ivs-selected-q'));
  ivsBlock.querySelectorAll('.ivs-writein-row').forEach(r => r.classList.remove('ivs-selected'));
  
  el.classList.add('ivs-selected');
  
  // Focus the input
  const input = el.querySelector('.ivs-writein-input');
  if(input) setTimeout(() => input.focus(), 50);
  
  // Record selection (empty until they type)
  const currentVal = input ? input.value.trim() : '';
  preVote[race] = currentVal ? 'write-in:' + currentVal : 'write-in:';
  
  const status = document.getElementById('ivs-status-' + race);
  status.textContent = currentVal ? '✍ Write-in: ' + currentVal : '✍ Write-in (type name)';
  status.classList.add('done');
  
  // Only count toward progress if they've typed something
  updateCastBar();
}

function updateWriteIn(race, input) {
  const val = input.value.trim();
  preVote[race] = val ? 'write-in:' + val : 'write-in:';
  
  const status = document.getElementById('ivs-status-' + race);
  status.textContent = val ? '✍ ' + val : '✍ Write-in (type name)';
  
  // Update share links dynamically
  const shareRow = document.getElementById('ivs-share-' + race + '-writein');
  if(shareRow && val) {
    const shareText = `I'm writing in ${val} for ${raceLabels[race]||race} in Philadelphia's May 19 primary. fora.center #PhillyVotes`;
    const enc = shareText.replace(/ /g,'%20').replace(/'/g,'%27').replace(/,/g,'%2C');
    shareRow.querySelector('.twitter').href = `https://twitter.com/intent/tweet?text=${enc}`;
    shareRow.querySelector('.copy').onclick = (e) => copyShare(e, shareText);
  }
  
  updateCastBar();
}

// Override candLabels lookup to handle write-ins
function getCandLabel(cand) {
  if(cand && cand.startsWith('write-in:')) {
    const name = cand.slice(9);
    return name ? '✍ ' + name : '✍ Write-in';
  }
  return candLabels[cand] || cand;
}

// ── Ballot question box clicks (sync with IVS below) ──
function selectBallotQ(qid, choice) {
  // Register vote immediately — no conditions
  preVote[qid] = choice;
  updateCastBar();

  // Update colored YES/NO rectangles
  const yesBox = document.getElementById('bq-' + qid + '-yes');
  const noBox  = document.getElementById('bq-' + qid + '-no');
  const yesChk = document.getElementById('bq-' + qid + '-yes-check');
  const noChk  = document.getElementById('bq-' + qid + '-no-check');
  if(yesBox) yesBox.classList.remove('bq-selected');
  if(noBox)  noBox.classList.remove('bq-selected');
  if(yesChk) yesChk.style.display = 'none';
  if(noChk)  noChk.style.display = 'none';
  if(choice === 'yes') {
    if(yesBox) yesBox.classList.add('bq-selected');
    if(yesChk) yesChk.style.display = 'inline';
  } else {
    if(noBox)  noBox.classList.add('bq-selected');
    if(noChk)  noChk.style.display = 'inline';
  }

  // Sync IVS radio (visual only)
  const ivsBlock = document.getElementById('ivs-' + qid);
  if(ivsBlock) {
    ivsBlock.querySelectorAll('.ivs-option').forEach(o => o.classList.remove('ivs-selected','ivs-selected-q'));
    const ivsEl = document.getElementById('ivs-' + qid + '-' + choice);
    if(ivsEl) ivsEl.classList.add('ivs-selected-q');
  }

  // Update status pill
  const status = document.getElementById('ivs-status-' + qid);
  if(status) { status.textContent = '✓ ' + (choice === 'yes' ? 'YES' : 'NO'); status.classList.add('done'); }

  // swallow old body
  if(false) {
  }// end swallow
}

// ── Notable write-in selection ──
function selectNotableWritein(race, slug, name, el) {
  // Deselect all options and write-ins in this race
  const ivsBlock = document.getElementById('ivs-' + race);
  ivsBlock.querySelectorAll('.ivs-option').forEach(o => o.classList.remove('ivs-selected','ivs-selected-q'));
  ivsBlock.querySelectorAll('.ivs-writein-row').forEach(r => r.classList.remove('ivs-selected'));
  ivsBlock.querySelectorAll('.ivs-notable-writein').forEach(n => n.classList.remove('ivs-selected'));
  
  el.classList.add('ivs-selected');
  preVote[race] = 'write-in:' + name;
  
  const status = document.getElementById('ivs-status-' + race);
  if(status) { 
    status.textContent = '✍ ' + name;
    status.classList.add('done');
    status.style.background = 'var(--purple-p)';
    status.style.color = 'var(--purple)';
    status.style.borderColor = 'rgba(45,26,74,0.25)';
  }
  
  updateCastBar();
}

</script>
