<%# Shared partial for RCO profile pages.
    Receives: rco (Hash) — all keys documented in RcosController. %>

<% content_for(:title) { "#{rco[:name]} — FORA" } %>

<% content_for :head do %>
<style>
:root {
  --bg:       #f2f4f8;
  --white:    #ffffff;
  --blue:     #1b3a6b;
  --blue-md:  #254f92;
  --blue-lt:  #3a6abf;
  --blue-pl:  #dde5f5;
  --blue-vp:  #edf1fb;
  --gilt:     #b8860b;
  --gilt-lt:  #d4a832;
  --gilt-pl:  #f8f0dc;
  --gilt-rul: rgba(184,134,11,0.22);
  --ink:      #0e1a2e;
  --ink-mid:  #2c3e5a;
  --ink-soft: #5a6e8a;
  --ink-mut:  #8a9ab8;
  --rule:     rgba(27,58,107,0.1);
  --green:    #155c2d;
  --green-p:  #e5f0e8;
}
*,*::before,*::after { box-sizing: border-box; }

/* ── HERO ── */
.rco-hero { background:var(--blue); padding:40px 48px 52px; position:relative; overflow:hidden; }
.rco-hero::after {
  content: '★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★';
  position:absolute; bottom:0; left:0; right:0; height:26px;
  display:flex; align-items:center; padding:0 48px;
  font-size:11px; letter-spacing:0.55em; color:var(--gilt);
  overflow:hidden; white-space:nowrap;
  -webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%);
  mask-image:linear-gradient(to right,black 92%,transparent 100%);
}
.hero-ring  { position:absolute; right:-60px; top:-80px; width:400px; height:400px; border-radius:50%; border:44px solid rgba(255,255,255,0.02); pointer-events:none; }
.hero-ring2 { position:absolute; right:60px;  top:20px;  width:220px; height:220px; border-radius:50%; border:1px solid rgba(184,134,11,0.1); pointer-events:none; }

.hero-bc     { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.3); margin-bottom:18px; }
.hero-bc a   { color:rgba(255,255,255,0.3); text-decoration:none; }
.hero-bc a:hover { color:rgba(255,255,255,0.75); }
.hero-bc .sep { opacity:0.25; margin:0 6px; }

.org-mark {
  width:64px; height:64px; border-radius:12px;
  background:var(--gilt-pl); border:2px solid var(--gilt-rul);
  display:flex; align-items:center; justify-content:center;
  font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:var(--gilt);
  flex-shrink:0; margin-bottom:18px;
}
.org-name    { font-family:'Libre Baskerville',serif; font-size:32px; font-weight:700; color:white; line-height:1.1; margin-bottom:12px; }
.org-tag     { display:inline-block; font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 9px; border-radius:3px; margin:0 5px 5px 0; }
.org-address { font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.08em; color:rgba(255,255,255,0.35); margin-top:10px; }

/* ── BODY GRID ── */
.rco-body {
  max-width:1100px; margin:0 auto;
  display:grid; grid-template-columns:1fr 300px; gap:28px;
  padding:32px 48px 60px; background:var(--bg);
}
@media (max-width:760px) {
  .rco-hero  { padding:28px 20px 44px; }
  .org-name  { font-size:22px; }
  .rco-body  { grid-template-columns:1fr; padding:20px 16px 48px; gap:16px; }
  .rco-sidebar    { order:-1; }
  .rco-stat-grid  { grid-template-columns:1fr 1fr 1fr !important; }
  .rco-engage-grid { grid-template-columns:1fr !important; }
}

/* ── CALLOUTS ── */
.rco-callout {
  border-left:3px solid var(--blue); background:var(--blue-vp);
  border-radius:0 8px 8px 0; padding:16px 20px; margin-bottom:20px;
}
.rco-callout-gilt {
  border-left:3px solid var(--gilt); background:var(--gilt-pl);
  border-radius:0 8px 8px 0; padding:16px 20px; margin-bottom:20px;
}
.rco-callout-eyebrow {
  font-family:'JetBrains Mono',monospace; font-size:7px;
  letter-spacing:0.18em; text-transform:uppercase; font-weight:700; margin-bottom:8px;
}
.rco-callout p { font-family:'Nunito',sans-serif; font-size:13px; line-height:1.72; color:var(--ink-mid); margin:0; }

/* ── STATS ── */
.rco-stat-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:10px; margin-bottom:20px; }
.rco-stat-tile { background:#f4f7fc; border-radius:8px; padding:18px 14px; text-align:center; }
.rco-stat-num  { font-family:'Libre Baskerville',serif; font-size:24px; font-weight:700; color:var(--blue); line-height:1; margin-bottom:6px; }
.rco-stat-lbl  { font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.12em; text-transform:uppercase; color:var(--ink-soft); }

/* ── ISSUE PILLS ── */
.rco-issues { margin-bottom:20px; }
.rco-issue-pill {
  display:inline-block; font-family:'JetBrains Mono',monospace;
  font-size:8px; letter-spacing:0.1em; text-transform:uppercase;
  padding:4px 10px; border-radius:3px; margin:0 5px 5px 0;
  background:var(--blue-vp); color:var(--blue-md); border:1px solid var(--blue-pl);
}

/* ── PLACEHOLDER BOXES ── */
.rco-placeholder { border:1.5px dashed var(--blue-pl); border-radius:10px; padding:28px 24px; text-align:center; margin-bottom:20px; }
.rco-placeholder-icon  { font-size:20px; margin-bottom:8px; }
.rco-placeholder-label { font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-mut); margin-bottom:6px; }
.rco-placeholder p { font-family:'Nunito',sans-serif; font-size:12px; color:var(--ink-soft); margin:0; line-height:1.6; }

/* ── ENGAGE TILES ── */
.rco-engage-grid  { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:24px; }
.rco-engage-tile  { background:white; border-radius:8px; border:0.5px solid var(--blue-pl); padding:16px 14px; }
.rco-engage-icon  { font-size:18px; margin-bottom:7px; }
.rco-engage-title { font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:var(--blue); margin-bottom:5px; }
.rco-engage-body  { font-family:'Nunito',sans-serif; font-size:11px; color:var(--ink-soft); line-height:1.55; }

/* ── SIDEBAR CARDS ── */
.rco-card       { background:white; border-radius:10px; border:0.5px solid var(--blue-pl); padding:18px 20px; margin-bottom:16px; }
.rco-card-title { font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.14em; text-transform:uppercase; color:var(--gilt); margin-bottom:12px; }
.rco-row        { display:flex; align-items:flex-start; justify-content:space-between; padding:7px 10px; background:var(--bg); border-radius:6px; margin-bottom:5px; gap:8px; }
.rco-row-lbl    { font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:var(--ink-mut); margin-bottom:2px; }
.rco-row-val    { font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:var(--blue); }

/* ── GOV CONTACTS ── */
.rco-gov-row { display:flex; align-items:center; gap:12px; padding:9px 0; border-bottom:1px solid rgba(27,58,107,0.07); }
.rco-gov-row:last-child { border-bottom:none; }
.rco-gov-icon { width:32px; height:32px; border-radius:6px; background:var(--bg); border:1px solid var(--blue-pl); display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; }
</style>
<% end %>

<%
  initials        = rco[:name].split.first(2).map { |w| w[0] }.join.upcase
  website_url     = rco[:website].present? ? (rco[:website].start_with?('http') ? rco[:website] : "https://#{rco[:website]}") : nil
  website_display = rco[:website].to_s.gsub(/^https?:\/\//, '').split('/').first
%>

<!-- ═══════════ HERO / HEADER CARD ═══════════ -->
<div class="rco-hero">
  <div class="hero-ring"></div>
  <div class="hero-ring2"></div>

  <div style="max-width:1100px; margin:0 auto;">
    <div class="hero-bc">
      <a href="/">FORA</a><span class="sep">/</span>
      <a href="#">Philadelphia</a><span class="sep">/</span>
      <a href="#">Community Organizations</a><span class="sep">/</span>
      <span style="color:var(--gilt-lt); font-weight:600;"><%= rco[:name] %></span>
    </div>

    <div class="org-mark"><%= initials %></div>
    <div class="org-name"><%= rco[:name] %></div>

    <div style="margin-bottom:8px;">
      <% if rco[:expiration_year].present? %>
        <span class="org-tag" style="background:rgba(21,92,45,0.25); color:#8cc4a0; border:1px solid rgba(21,92,45,0.3);">✓ Active thru <%= rco[:expiration_year] %></span>
      <% end %>
      <span class="org-tag" style="background:rgba(27,58,107,0.4); color:rgba(255,255,255,0.75); border:1px solid rgba(255,255,255,0.12);">RCO · Philadelphia PCPC</span>
      <% if rco[:neighborhood].present? %>
        <span class="org-tag" style="background:rgba(184,134,11,0.18); color:var(--gilt-lt); border:1px solid var(--gilt-rul);"><%= rco[:neighborhood] %><% if rco[:zip].present? %> · <%= rco[:zip] %><% end %></span>
      <% end %>
      <% if rco[:ward_committee] %>
        <span class="org-tag" style="background:#ede6f7; color:#2d1a4a; border:1px solid rgba(45,26,74,0.2);">Ward Committee</span>
      <% end %>
    </div>

    <% if rco[:address].present? %>
      <div class="org-address"><%= rco[:address] %></div>
    <% end %>
  </div>
</div>

<!-- ═══════════ BODY ═══════════ -->
<div class="rco-body">

  <!-- ─── MAIN COLUMN ─── -->
  <div>

    <!-- Neighborhood description -->
    <% if rco[:neighborhood_description].present? %>
      <div class="rco-callout">
        <div class="rco-callout-eyebrow" style="color:var(--gilt);">◆ About this neighborhood</div>
        <p><%= rco[:neighborhood_description].html_safe %></p>
      </div>
    <% end %>

    <!-- Stats grid -->
    <% if rco[:stats].present? %>
      <div class="rco-stat-grid">
        <% rco[:stats].each do |stat| %>
          <div class="rco-stat-tile">
            <div class="rco-stat-num"><%= stat[:number] %></div>
            <div class="rco-stat-lbl"><%= stat[:label] %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Issue tags -->
    <% if rco[:issues].present? %>
      <div class="rco-issues">
        <% rco[:issues].each do |issue| %>
          <span class="rco-issue-pill"><%= issue %></span>
        <% end %>
      </div>
    <% end %>

    <!-- Ward committee explainer (conditional) -->
    <% if rco[:ward_committee] && rco[:ward_explainer].present? %>
      <div class="rco-callout-gilt">
        <div class="rco-callout-eyebrow" style="color:var(--gilt);">◆ What is a ward committee RCO?</div>
        <p><%= rco[:ward_explainer].html_safe %></p>
      </div>
    <% end %>

    <!-- Active efforts placeholder -->
    <div class="rco-placeholder">
      <div class="rco-placeholder-icon">🗓</div>
      <div class="rco-placeholder-label">Active Efforts</div>
      <p>Efforts coming soon — FORA is building this layer. Contact <strong><%= rco[:primary_name] %></strong> at <a href="mailto:<%= rco[:primary_email] %>" style="color:var(--blue-lt); text-decoration:none;"><%= rco[:primary_email] %></a> to get involved.</p>
    </div>

    <!-- Zoning cases placeholder -->
    <div class="rco-placeholder">
      <div class="rco-placeholder-icon">📐</div>
      <div class="rco-placeholder-label">Active ZBA Cases</div>
      <p style="margin-bottom:10px;">Active ZBA applications for this RCO boundary will appear here.</p>
      <a href="https://phdcgis.phila.gov/portal/apps/sites/#/zoning" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--blue-lt); text-decoration:none;">Search ZBA calendar now ›</a>
    </div>

    <!-- How to engage -->
    <div class="rco-engage-grid">
      <div class="rco-engage-tile">
        <div class="rco-engage-icon">📅</div>
        <div class="rco-engage-title">Attend a meeting</div>
        <div class="rco-engage-body">Meetings at <%= rco[:meeting_location_short] %>. Open to all residents — no membership required.</div>
      </div>
      <div class="rco-engage-tile">
        <div class="rco-engage-icon">📋</div>
        <div class="rco-engage-title">Submit testimony</div>
        <div class="rco-engage-body">Email <%= rco[:primary_name] %> before any zoning meeting. Your words go into the official ZBA record.</div>
      </div>
      <div class="rco-engage-tile">
        <div class="rco-engage-icon">🔍</div>
        <div class="rco-engage-title">Find active cases</div>
        <div class="rco-engage-body">Search for pending zoning applications in your neighborhood.</div>
        <a href="https://phdcgis.phila.gov/portal/apps/sites/#/zoning" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.08em; color:var(--blue-lt); text-decoration:none; display:inline-block; margin-top:6px;">ZBA calendar ›</a>
      </div>
    </div>

    <!-- Footer -->
    <div style="text-align:center; padding-top:12px; border-top:1px solid var(--rule);">
      <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--ink-mut);">Source: Philadelphia PCPC · ArcGIS · Data updated nightly</div>
    </div>

  </div>

  <!-- ─── SIDEBAR ─── -->
  <div class="rco-sidebar">

    <!-- Contact card -->
    <div class="rco-card">
      <div class="rco-card-title">◆ Contact</div>

      <% if rco[:primary_name].present? %>
        <div class="rco-row">
          <div>
            <div class="rco-row-lbl">Chair / Contact</div>
            <div class="rco-row-val"><%= rco[:primary_name] %></div>
          </div>
        </div>
      <% end %>

      <% if rco[:primary_email].present? %>
        <div class="rco-row">
          <div style="flex:1; min-width:0;">
            <div class="rco-row-lbl">Email</div>
            <a href="mailto:<%= rco[:primary_email] %>" style="font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--blue-lt); text-decoration:none; word-break:break-all;"><%= rco[:primary_email] %></a>
          </div>
        </div>
      <% end %>

      <% if rco[:primary_phone].present? %>
        <div class="rco-row" style="align-items:center;">
          <div>
            <div class="rco-row-lbl">Phone</div>
            <div class="rco-row-val"><%= rco[:primary_phone] %></div>
          </div>
          <a href="tel:<%= rco[:primary_phone].gsub(/\D/,'') %>" style="font-family:'Nunito',sans-serif; font-size:11px; color:var(--blue-lt); text-decoration:none; flex-shrink:0;">Call ↗</a>
        </div>
      <% end %>

      <div class="rco-row">
        <div style="flex:1; min-width:0;">
          <div class="rco-row-lbl">Website</div>
          <% if website_url %>
            <a href="<%= website_url %>" target="_blank" rel="noopener" style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:var(--blue-lt); text-decoration:none;"><%= website_display %> ›</a>
          <% else %>
            <div style="font-family:'Nunito',sans-serif; font-size:12px; color:var(--ink-mut);">Not provided</div>
          <% end %>
        </div>
      </div>

      <% if rco[:meeting_location].present? %>
        <div class="rco-row">
          <div>
            <div class="rco-row-lbl">Meeting location</div>
            <div class="rco-row-val" style="font-size:11px; line-height:1.4;"><%= rco[:meeting_location] %></div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Government contacts card -->
    <% if rco[:gov_contacts].present? %>
      <div class="rco-card">
        <div class="rco-card-title">◆ Your government contacts<% if rco[:council_district].present? %> · District <%= rco[:council_district] %><% end %></div>
        <% rco[:gov_contacts].each do |contact| %>
          <div class="rco-gov-row">
            <div class="rco-gov-icon"><%= contact[:icon] %></div>
            <div>
              <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:var(--blue);"><%= contact[:name] %></div>
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:var(--ink-soft);"><%= contact[:detail] %></div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Registration card -->
    <div class="rco-card">
      <div class="rco-card-title">◆ Registration</div>

      <% if rco[:address].present? %>
        <div class="rco-row">
          <div>
            <div class="rco-row-lbl">Registered address</div>
            <div class="rco-row-val" style="font-size:11px; line-height:1.4;"><%= rco[:address] %></div>
          </div>
        </div>
      <% end %>

      <% if rco[:expiration_year].present? %>
        <div class="rco-row" style="align-items:center;">
          <div>
            <div class="rco-row-lbl">Active through</div>
            <div class="rco-row-val"><%= rco[:expiration_year] %></div>
          </div>
          <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.08em; text-transform:uppercase; padding:2px 8px; border-radius:3px; background:var(--green-p); color:var(--green); border:1px solid rgba(21,92,45,0.2); flex-shrink:0;">✓ Active</span>
        </div>
      <% end %>

      <div style="padding:8px 0 4px;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-mut);">Source: Philadelphia PCPC · ArcGIS</div>
      </div>
    </div>

    <!-- Resources card -->
    <div class="rco-card">
      <div class="rco-card-title">◆ Resources</div>
      <% [
        ["ZBA Calendar",             "https://phdcgis.phila.gov/portal/apps/sites/#/zoning",                                                                                       "Search active zoning cases"],
        ["PCPC RCO Directory",       "https://www.phila.gov/departments/philadelphia-city-planning-commission/registered-community-organizations/", "Full list of registered RCOs"],
        ["Zoning Board of Adjustment","https://www.phila.gov/departments/zoning-board-of-adjustment/",                                                                             "Submit or track an appeal"],
      ].each do |label, url, desc| %>
        <a href="<%= url %>" target="_blank" rel="noopener" style="display:flex; flex-direction:column; padding:8px 10px; background:var(--bg); border-radius:6px; margin-bottom:5px; text-decoration:none;">
          <span style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:var(--blue-lt);"><%= label %> ›</span>
          <span style="font-family:'Nunito',sans-serif; font-size:10.5px; color:var(--ink-soft); margin-top:1px;"><%= desc %></span>
        </a>
      <% end %>
    </div>

  </div>
</div>
