<% content_for(:title) { "#{@rco[:name]} — FORA" } %>

<% content_for :head do %>
<style>
:root {
  --bg:       #f2f4f8;
  --white:    #ffffff;
  --blue:     #1b3a6b;
  --blue-md:  #254f92;
  --blue-lt:  #3a6abf;
  --blue-pl:  #dde5f5;
  --blue-vp:  #edf1fb;
  --gilt:     #b8860b;
  --gilt-lt:  #d4a832;
  --gilt-pl:  #f8f0dc;
  --gilt-rul: rgba(184,134,11,0.22);
  --ink:      #0e1a2e;
  --ink-mid:  #2c3e5a;
  --ink-soft: #5a6e8a;
  --ink-mut:  #8a9ab8;
  --rule:     rgba(27,58,107,0.1);
  --green:    #155c2d;
  --green-p:  #e5f0e8;
}
*,*::before,*::after { box-sizing: border-box; }

/* ── HERO ── */
.rco-hero {
  background: var(--blue);
  padding: 40px 48px 52px;
  position: relative;
  overflow: hidden;
}
.rco-hero::after {
  content: '★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★';
  position: absolute; bottom: 0; left: 0; right: 0; height: 26px;
  display: flex; align-items: center; padding: 0 48px;
  font-size: 11px; letter-spacing: 0.55em; color: var(--gilt);
  overflow: hidden; white-space: nowrap;
  -webkit-mask-image: linear-gradient(to right, black 92%, transparent 100%);
  mask-image: linear-gradient(to right, black 92%, transparent 100%);
}
.hero-ring  { position:absolute; right:-60px; top:-80px; width:400px; height:400px; border-radius:50%; border:44px solid rgba(255,255,255,0.02); pointer-events:none; }
.hero-ring2 { position:absolute; right:60px; top:20px; width:220px; height:220px; border-radius:50%; border:1px solid rgba(184,134,11,0.1); pointer-events:none; }

.hero-breadcrumb { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.3); margin-bottom:18px; }
.hero-breadcrumb a { color:rgba(255,255,255,0.3); text-decoration:none; }
.hero-breadcrumb a:hover { color:rgba(255,255,255,0.75); }
.hero-breadcrumb .sep { opacity:0.25; margin:0 6px; }

.org-mark {
  width: 64px; height: 64px; border-radius: 12px;
  background: var(--gilt-pl); border: 2px solid var(--gilt-rul);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Libre Baskerville', serif; font-size: 20px; font-weight: 700; color: var(--gilt);
  flex-shrink: 0; position: relative; margin-bottom: 18px;
}
.org-verified-badge {
  position: absolute; bottom: -4px; right: -4px;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--green); border: 2.5px solid var(--blue);
  display: flex; align-items: center; justify-content: center; font-size: 9px;
}
.org-label { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:var(--gilt-lt); margin-bottom:6px; }
.org-name  { font-family:'Libre Baskerville',serif; font-size:32px; font-weight:700; color:white; line-height:1.1; margin-bottom:6px; }
.org-sub   { font-family:'Nunito',sans-serif; font-size:14px; font-weight:300; color:rgba(255,255,255,0.5); margin-bottom:14px; }
.org-tag   { display:inline-block; font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 9px; border-radius:3px; margin-right:6px; }

/* ── BODY ── */
.rco-body {
  max-width: 1100px; margin: 0 auto;
  display: grid; grid-template-columns: 1fr 300px; gap: 28px;
  padding: 32px 48px 60px; background: var(--bg);
}
@media (max-width: 760px) {
  .rco-hero { padding: 28px 20px 44px; }
  .org-name  { font-size: 24px; }
  .rco-body  { grid-template-columns: 1fr; padding: 20px 16px 48px; }
  .rco-sidebar { order: -1; }
}

/* ── MAIN ── */
.rco-section { background:white; border-radius:10px; border:0.5px solid var(--blue-pl); padding:24px 28px; margin-bottom:20px; }
.rco-section-eyebrow { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.18em; text-transform:uppercase; color:var(--gilt); margin-bottom:6px; }
.rco-section-title   { font-family:'Libre Baskerville',serif; font-size:19px; font-weight:700; color:var(--blue); margin:0 0 14px; line-height:1.25; }

/* ── SIDEBAR ── */
.rco-card { background:white; border-radius:10px; border:0.5px solid var(--blue-pl); padding:18px 20px; margin-bottom:16px; }
.rco-card-title { font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.14em; text-transform:uppercase; color:var(--gilt); margin-bottom:12px; }
.rco-row { display:flex; align-items:flex-start; justify-content:space-between; padding:7px 10px; background:var(--bg); border-radius:6px; margin-bottom:5px; gap:8px; }
.rco-row-label { font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:var(--ink-mut); margin-bottom:2px; }
.rco-row-value { font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:var(--blue); }
</style>
<% end %>

<%
  initials = @rco[:name].split.first(2).map { |w| w[0] }.join.upcase
  website_display = @rco[:website].to_s.gsub(/^https?:\/\//, '').split('/').first
%>

<!-- Hero -->
<div class="rco-hero">
  <div class="hero-ring"></div>
  <div class="hero-ring2"></div>

  <div style="max-width:1100px; margin:0 auto;">
    <div class="hero-breadcrumb">
      <a href="/">FORA</a><span class="sep">/</span>
      <a href="#">Philadelphia</a><span class="sep">/</span>
      <a href="#">Community Organizations</a><span class="sep">/</span>
      <span style="color:var(--gilt-lt); font-weight:600;"><%= @rco[:name] %></span>
    </div>

    <div class="org-mark">
      <%= initials %>
      <div class="org-verified-badge">✓</div>
    </div>

    <div class="org-label">
      <span style="background:rgba(184,134,11,0.18); border:1px solid var(--gilt-rul); padding:2px 8px; border-radius:3px;">Registered Community Organization</span>
      <span style="color:rgba(255,255,255,0.25); font-size:7px; margin-left:6px;">Philadelphia · PCPC Verified</span>
    </div>

    <div class="org-name"><%= @rco[:name] %></div>
    <div class="org-sub">Philadelphia, PA · Active through <%= @rco[:expiration_year] %></div>

    <div>
      <span class="org-tag" style="background:rgba(27,58,107,0.4); color:rgba(255,255,255,0.75); border:1px solid rgba(255,255,255,0.12);">Philadelphia</span>
      <span class="org-tag" style="background:rgba(184,134,11,0.15); color:var(--gilt-lt); border:1px solid var(--gilt-rul);">RCO · PCPC</span>
      <% if @rco[:expiration_year].present? %>
        <span class="org-tag" style="background:rgba(21,92,45,0.25); color:#8cc4a0; border:1px solid rgba(21,92,45,0.3);">✓ Active thru <%= @rco[:expiration_year] %></span>
      <% end %>
    </div>
  </div>
</div>

<!-- Body -->
<div class="rco-body">

  <!-- Main column -->
  <div>

    <!-- What is an RCO -->
    <div class="rco-section">
      <div class="rco-section-eyebrow">◆ About This Organization</div>
      <h2 class="rco-section-title">Registered Community Organization</h2>
      <p style="font-family:'Nunito',sans-serif; font-size:13.5px; color:var(--ink-mid); line-height:1.7; margin:0 0 16px;">
        Your <strong>Registered Community Organization</strong> is your neighborhood's official seat at the table. When a developer files for a zoning variance, a bar applies for a license, or a shelter seeks approval — your RCO is the first body the city notifies. RCOs hold public meetings, collect resident testimony, and submit formal positions to the Zoning Board of Adjustment.
      </p>
      <p style="font-family:'Nunito',sans-serif; font-size:13.5px; color:var(--ink-mid); line-height:1.7; margin:0;">
        Meetings are <strong>open to all residents</strong> — you don't need to be a member. RCO decisions carry real weight with your councilmember and the ZBA. If something is changing in your neighborhood, this is where neighbors go to respond.
      </p>
    </div>

    <!-- How to get involved -->
    <div class="rco-section">
      <div class="rco-section-eyebrow">◆ Get Involved</div>
      <h2 class="rco-section-title">How to Participate</h2>

      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:16px;">
        <div style="background:var(--bg); border-radius:8px; padding:14px;">
          <div style="font-size:18px; margin-bottom:6px;">📅</div>
          <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:var(--blue); margin-bottom:4px;">Attend a meeting</div>
          <div style="font-family:'Nunito',sans-serif; font-size:11px; color:var(--ink-soft); line-height:1.55;">Open to all residents. No membership required. Show up when a project near you is on the agenda.</div>
        </div>
        <div style="background:var(--bg); border-radius:8px; padding:14px;">
          <div style="font-size:18px; margin-bottom:6px;">📋</div>
          <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:var(--blue); margin-bottom:4px;">Submit testimony</div>
          <div style="font-family:'Nunito',sans-serif; font-size:11px; color:var(--ink-soft); line-height:1.55;">Can't attend? Send written comments to the RCO chair before the meeting. Your words enter the official record.</div>
        </div>
        <div style="background:var(--bg); border-radius:8px; padding:14px;">
          <div style="font-size:18px; margin-bottom:6px;">🔍</div>
          <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:var(--blue); margin-bottom:4px;">Track active cases</div>
          <div style="font-family:'Nunito',sans-serif; font-size:11px; color:var(--ink-soft); line-height:1.55;">Search the ZBA calendar for pending zoning applications in this neighborhood.</div>
          <a href="https://phdcgis.phila.gov/portal/apps/sites/#/zoning" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:8.5px; letter-spacing:0.08em; color:var(--blue-lt); text-decoration:none; display:block; margin-top:6px;">Search ZBA Calendar ›</a>
        </div>
      </div>

      <% if @rco[:primary_email].present? %>
        <div style="background:var(--blue-vp); border:1px solid var(--blue-pl); border-left:3px solid var(--blue); border-radius:6px; padding:12px 16px; display:flex; align-items:center; justify-content:space-between; gap:12px;">
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.12em; text-transform:uppercase; color:var(--blue); margin-bottom:3px;">Contact this RCO</div>
            <div style="font-family:'Nunito',sans-serif; font-size:13px; color:var(--ink-mid);">Email <strong><%= @rco[:primary_name] %></strong> to get on the meeting list or submit comments.</div>
          </div>
          <a href="mailto:<%= @rco[:primary_email] %>" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.1em; text-transform:uppercase; padding:8px 14px; background:var(--blue); color:white; border-radius:6px; text-decoration:none; white-space:nowrap; flex-shrink:0;">Email ↗</a>
        </div>
      <% end %>
    </div>

    <!-- Meeting location -->
    <% if @rco[:meeting_location].present? %>
    <div class="rco-section">
      <div class="rco-section-eyebrow">◆ Meetings</div>
      <h2 class="rco-section-title">Meeting Location</h2>
      <div style="display:flex; align-items:flex-start; gap:14px;">
        <div style="width:40px; height:40px; border-radius:8px; background:var(--gilt-pl); border:1px solid var(--gilt-rul); display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0;">📍</div>
        <div>
          <div style="font-family:'Nunito',sans-serif; font-size:13.5px; font-weight:600; color:var(--blue); margin-bottom:4px;"><%= @rco[:meeting_location] %></div>
          <a href="https://maps.google.com/?q=<%= CGI.escape(@rco[:meeting_location]) %>" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.08em; text-transform:uppercase; color:var(--blue-lt); text-decoration:none;">Open in Maps ›</a>
        </div>
      </div>
      <div style="margin-top:16px; padding:10px 14px; background:var(--bg); border-radius:6px;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-mut); margin-bottom:4px;">Meeting schedule</div>
        <div style="font-family:'Nunito',sans-serif; font-size:12.5px; color:var(--ink-soft);">Contact the RCO chair for upcoming meeting dates and agenda items.</div>
      </div>
    </div>
    <% end %>

    <!-- Data note -->
    <div style="border-top:1px solid #e0e5ef; padding-top:14px; margin-top:4px;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--gilt); margin-bottom:5px;">◆ Data Note</div>
      <p style="font-family:'Nunito',sans-serif; font-size:11px; color:var(--ink-mut); line-height:1.6; margin:0;">RCO data sourced from the Philadelphia Planning Commission (PCPC) via the City's ArcGIS open data portal. Registration status and contact information reflects the most recent PCPC filing.</p>
    </div>

  </div>

  <!-- Sidebar -->
  <div class="rco-sidebar">

    <!-- Contact card -->
    <div class="rco-card">
      <div class="rco-card-title">◆ Contact</div>

      <% if @rco[:primary_name].present? %>
        <div class="rco-row">
          <div>
            <div class="rco-row-label">Chair / Contact</div>
            <div class="rco-row-value"><%= @rco[:primary_name] %></div>
          </div>
        </div>
      <% end %>

      <% if @rco[:primary_email].present? %>
        <div class="rco-row">
          <div style="flex:1; min-width:0;">
            <div class="rco-row-label">Email</div>
            <a href="mailto:<%= @rco[:primary_email] %>" style="font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--blue-lt); text-decoration:none; word-break:break-all;"><%= @rco[:primary_email] %></a>
          </div>
        </div>
      <% end %>

      <% if @rco[:primary_phone].present? %>
        <div class="rco-row" style="justify-content:space-between;">
          <div>
            <div class="rco-row-label">Phone</div>
            <div class="rco-row-value"><%= @rco[:primary_phone] %></div>
          </div>
          <a href="tel:<%= @rco[:primary_phone].gsub(/\D/,'') %>" style="font-family:'Nunito',sans-serif; font-size:11px; color:var(--blue-lt); text-decoration:none; flex-shrink:0;">Call ↗</a>
        </div>
      <% end %>

      <% if @rco[:website].present? %>
        <div class="rco-row">
          <div style="flex:1; min-width:0;">
            <div class="rco-row-label">Website</div>
            <a href="<%= @rco[:website].start_with?('http') ? @rco[:website] : "https://#{@rco[:website]}" %>" target="_blank" rel="noopener" style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:var(--blue-lt); text-decoration:none;"><%= website_display %> ↗</a>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Registration card -->
    <div class="rco-card">
      <div class="rco-card-title">◆ Registration</div>

      <% if @rco[:address].present? %>
        <div class="rco-row">
          <div>
            <div class="rco-row-label">Registered address</div>
            <div class="rco-row-value" style="font-size:11px; line-height:1.4;"><%= @rco[:address] %></div>
          </div>
        </div>
      <% end %>

      <% if @rco[:expiration_year].present? %>
        <div class="rco-row" style="justify-content:space-between;">
          <div>
            <div class="rco-row-label">Registration active through</div>
            <div class="rco-row-value"><%= @rco[:expiration_year] %></div>
          </div>
          <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.08em; text-transform:uppercase; padding:2px 8px; border-radius:3px; background:var(--green-p); color:var(--green); border:1px solid rgba(21,92,45,0.2); flex-shrink:0;">✓ Active</span>
        </div>
      <% end %>

      <div style="padding:8px 0 4px;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink-mut);">Source: Philadelphia PCPC · ArcGIS</div>
      </div>
    </div>

    <!-- Resources card -->
    <div class="rco-card">
      <div class="rco-card-title">◆ Resources</div>
      <% [
        ["ZBA Calendar", "https://phdcgis.phila.gov/portal/apps/sites/#/zoning", "Search active zoning cases"],
        ["PCPC RCO Directory", "https://www.phila.gov/departments/philadelphia-city-planning-commission/registered-community-organizations/", "Full list of registered RCOs"],
        ["Zoning Board of Adjustment", "https://www.phila.gov/departments/zoning-board-of-adjustment/", "Submit or track an appeal"],
      ].each do |label, url, desc| %>
        <a href="<%= url %>" target="_blank" rel="noopener" style="display:flex; flex-direction:column; padding:8px 10px; background:var(--bg); border-radius:6px; margin-bottom:5px; text-decoration:none; transition:background 0.12s;">
          <span style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:var(--blue-lt);"><%=label %> ›</span>
          <span style="font-family:'Nunito',sans-serif; font-size:10.5px; color:var(--ink-soft); margin-top:1px;"><%= desc %></span>
        </a>
      <% end %>
    </div>

  </div>
</div>
