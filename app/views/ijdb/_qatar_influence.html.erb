<script>
var activeDetail = null;
function toggleDetail(key) {
  var panels = ['univ','re','lobby','media','qia','proj'];
  var cards = {univ:'sc-univ',re:'sc-re',lobby:'sc-lobby',media:'sc-media',qia:'sc-qia',proj:'sc-proj'};
  if (activeDetail === key) {
    document.getElementById('dp-' + key).classList.remove('open');
    document.getElementById(cards[key]).classList.remove('active');
    activeDetail = null;
  } else {
    panels.forEach(function(p) {
      document.getElementById('dp-' + p).classList.remove('open');
      document.getElementById(cards[p]).classList.remove('active');
    });
    document.getElementById('dp-' + key).classList.add('open');
    document.getElementById(cards[key]).classList.add('active');
    activeDetail = key;
    setTimeout(function(){
      document.getElementById('dp-' + key).scrollIntoView({behavior:'smooth',block:'nearest'});
    }, 50);
  }
}
</script>
