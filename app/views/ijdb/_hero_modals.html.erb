<%# app/views/ijdb/_hero_modals.html.erb %>

<% content_for :head do %>
<style>
/* ── HERO MODALS ── */
.hm-dialog{border:none;padding:0;border-radius:10px;max-width:680px;width:92vw;box-shadow:0 24px 80px rgba(0,0,0,0.50);overflow:hidden;}
.hm-dialog::backdrop{background:rgba(0,0,0,0.70);backdrop-filter:blur(3px);}
.hm-header{background:#0e1a2e;padding:28px 28px 22px;position:relative;}
.hm-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.24em;text-transform:uppercase;color:#d4a832;margin-bottom:10px;}
.hm-headline{font-family:'Libre Baskerville',serif;font-size:40px;font-weight:700;color:#d4a832;line-height:1.0;margin-bottom:6px;}
.hm-subtitle{font-family:'Nunito',sans-serif;font-size:13px;color:rgba(255,255,255,0.45);line-height:1.6;}
.hm-close{position:absolute;top:18px;right:20px;background:none;border:none;color:rgba(255,255,255,0.35);font-size:22px;cursor:pointer;line-height:1;padding:4px 8px;border-radius:4px;}
.hm-close:hover{color:#fff;background:rgba(255,255,255,0.08);}
.hm-body{background:#fff;padding:22px 28px 24px;max-height:70vh;overflow-y:auto;}
/* stat grid */
.hm-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:10px;margin-bottom:18px;}
.hm-stat{background:#f5f7fb;border-radius:6px;padding:12px 14px;}
.hm-stat-val{font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;color:#0e1a2e;line-height:1.1;margin-bottom:3px;}
.hm-stat-lbl{font-family:'Nunito',sans-serif;font-size:11px;color:#5a6e8a;line-height:1.4;}
/* facts */
.hm-facts{list-style:none;padding:0;margin:0 0 16px;}
.hm-facts li{font-family:'Nunito',sans-serif;font-size:12.5px;color:#2c3e5a;padding:7px 0 7px 16px;border-bottom:1px solid rgba(27,58,107,0.07);line-height:1.65;position:relative;}
.hm-facts li:last-child{border-bottom:none;}
.hm-facts li::before{content:'›';color:#b8860b;font-weight:700;position:absolute;left:0;top:7px;}
/* sources footer */
.hm-srcs{background:#f5f7fb;border-top:0.5px solid rgba(27,58,107,0.10);margin:0 -28px 14px;padding:10px 28px 14px;}
.hm-srcs-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:#b8860b;margin-bottom:5px;}
.hm-srcs-list{font-family:'Libre Baskerville',serif;font-size:11px;color:#8a9ab8;line-height:1.7;margin:0;}
.hm-srcs-list a{color:#185FA5;text-decoration:none;}
.hm-srcs-list a:hover{text-decoration:underline;}
/* share bar */
.hm-share-bar{display:flex;align-items:center;gap:5px;flex-wrap:wrap;padding-top:14px;border-top:1px solid rgba(27,58,107,0.08);}
.hm-share-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:#b8860b;margin-right:2px;flex-shrink:0;}
.hm-share-btn{display:inline-flex;align-items:center;gap:4px;font-family:'Nunito',sans-serif;font-size:11px;font-weight:600;padding:4px 10px;border-radius:20px;border:1px solid;cursor:pointer;transition:opacity 0.12s;background:transparent;line-height:1.3;}
.hm-share-btn:hover{opacity:0.70;}
.hm-share-x       {border-color:#000;color:#000;}
.hm-share-linkedin{border-color:#0A66C2;color:#0A66C2;}
.hm-share-facebook{border-color:#1877F2;color:#1877F2;}
.hm-share-instagram{border-color:#C13584;color:#C13584;}
.hm-share-tiktok  {border-color:#333;color:#333;}
.hm-share-discord {border-color:#5865F2;color:#5865F2;}
.hm-share-copy    {border-color:#8a9ab8;color:#8a9ab8;}
/* toast */
#hm-toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(12px);background:#1b3a6b;color:#fff;font-family:'Nunito',sans-serif;font-size:13px;font-weight:600;padding:9px 22px;border-radius:30px;box-shadow:0 4px 20px rgba(0,0,0,0.25);opacity:0;transition:opacity 0.18s,transform 0.18s;pointer-events:none;z-index:10000;}
#hm-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
</style>
<% end %>

<div id="hm-toast">Copied!</div>

<%# ── MODAL 1: ~$8T TOTAL ── %>
<dialog id="total-ct-modal" class="hm-dialog" aria-labelledby="hm-total-title">
  <div class="hm-header">
    <button class="hm-close" onclick="this.closest('dialog').close()" aria-label="Close">✕</button>
    <div class="hm-eyebrow">◆ Islamic Jihad Cost Database · Total spending</div>
    <div class="hm-headline" id="hm-total-title">~$8T</div>
    <p class="hm-subtitle">The full 20-year accounting of American counter-terrorism</p>
  </div>
  <div class="hm-body">
    <div class="hm-stats">
      <div class="hm-stat"><div class="hm-stat-val">$2.3T</div><div class="hm-stat-lbl">War operations (OCO)</div></div>
      <div class="hm-stat"><div class="hm-stat-val">$2.2T</div><div class="hm-stat-lbl">Veteran care (VA)</div></div>
      <div class="hm-stat"><div class="hm-stat-val">$1.1T</div><div class="hm-stat-lbl">Homeland security (DHS)</div></div>
      <div class="hm-stat"><div class="hm-stat-val">&gt;$1T</div><div class="hm-stat-lbl">Debt interest on war borrowing</div></div>
    </div>
    <ul class="hm-facts">
      <li>No single government document has ever totaled U.S. counter-terrorism spending. This figure was assembled by researchers from 26 separate budget documents.</li>
      <li>Every war since 9/11 was funded entirely through deficit spending — not the base defense budget. The debt interest alone has passed $1 trillion and compounds indefinitely.</li>
      <li>Future VA obligations for post-9/11 veterans could add another $2T+ — the $8T figure will keep rising for decades after the wars ended.</li>
      <li>Equivalent to 40 Marshall Plans (inflation-adjusted), or two years of Japan's entire GDP.</li>
      <li>The U.S. averaged ~$400B/year on CT — more than the entire UK defense budget, every year, for twenty consecutive years.</li>
    </ul>
    <div class="hm-srcs">
      <div class="hm-srcs-lbl">Sources</div>
      <p class="hm-srcs-list">
        <a href="https://watson.brown.edu/costsofwar/" target="_blank" rel="noopener noreferrer">Brown University, Costs of War Project (2021)</a>
        &middot;
        <a href="https://www.stimson.org/2018/counterterrorism-spending-protecting-america-while-promoting-efficiencies-and-accountability/" target="_blank" rel="noopener noreferrer">Stimson Center, Counterterrorism Spending (2018)</a>
        &middot;
        <a href="https://www.cbo.gov/topics/defense-and-national-security" target="_blank" rel="noopener noreferrer">Congressional Budget Office — defense baseline data</a>
      </p>
    </div>
    <div class="hm-share-bar">
      <span class="hm-share-lbl">Share</span>
      <button class="hm-share-btn hm-share-x"         data-share="x"><i class="ti ti-brand-x"></i> X</button>
      <button class="hm-share-btn hm-share-linkedin"   data-share="linkedin"><i class="ti ti-brand-linkedin"></i> LinkedIn</button>
      <button class="hm-share-btn hm-share-facebook"   data-share="facebook"><i class="ti ti-brand-facebook"></i> Facebook</button>
      <button class="hm-share-btn hm-share-instagram"  data-share="instagram"><i class="ti ti-brand-instagram"></i> Instagram</button>
      <button class="hm-share-btn hm-share-tiktok"     data-share="tiktok"><i class="ti ti-brand-tiktok"></i> TikTok</button>
      <button class="hm-share-btn hm-share-discord"    data-share="discord"><i class="ti ti-brand-discord"></i> Discord</button>
      <button class="hm-share-btn hm-share-copy"       data-share="copy"><i class="ti ti-copy"></i> Copy link</button>
    </div>
  </div>
</dialog>

<%# ── MODAL 2: $1.1T HOMELAND SECURITY ── %>
<dialog id="homeland-sec-modal" class="hm-dialog" aria-labelledby="hm-dhs-title">
  <div class="hm-header">
    <button class="hm-close" onclick="this.closest('dialog').close()" aria-label="Close">✕</button>
    <div class="hm-eyebrow">◆ Islamic Jihad Cost Database · Homeland security</div>
    <div class="hm-headline" id="hm-dhs-title">$1.1T</div>
    <p class="hm-subtitle">A department built from scratch in under a year</p>
  </div>
  <div class="hm-body">
    <div class="hm-stats">
      <div class="hm-stat"><div class="hm-stat-val">2003</div><div class="hm-stat-lbl">Year DHS began operations</div></div>
      <div class="hm-stat"><div class="hm-stat-val">22</div><div class="hm-stat-lbl">Agencies merged into DHS</div></div>
      <div class="hm-stat"><div class="hm-stat-val">~240K</div><div class="hm-stat-lbl">DHS employees (2022)</div></div>
      <div class="hm-stat"><div class="hm-stat-val">~$55B</div><div class="hm-stat-lbl">Avg annual appropriation</div></div>
    </div>
    <ul class="hm-facts">
      <li>The Homeland Security Act of 2002 was signed just 13 months after 9/11 — the largest U.S. government reorganization since the National Security Act of 1947, which created the CIA and Joint Chiefs.</li>
      <li>TSA has screened more than 10 billion passengers since 2002, and the agency alone accounts for roughly $10B/year in DHS spending.</li>
      <li>CBP, FEMA, the Secret Service, the Coast Guard, and CISA all operate under DHS — agencies with vastly different missions folded under one counter-terrorism umbrella.</li>
      <li>The 9/11 Commission found all 19 hijackers entered the U.S. legally. DHS was built to detect weapons, not the immigration fraud that actually enabled the attacks.</li>
      <li>DHS's budget has more than doubled since its founding — from $19B in FY2002 to over $97B requested in FY2024.</li>
    </ul>
    <div class="hm-srcs">
      <div class="hm-srcs-lbl">Sources</div>
      <p class="hm-srcs-list">
        <a href="https://www.dhs.gov/dhs-budget" target="_blank" rel="noopener noreferrer">DHS Budget in Brief (annual)</a>
        &middot;
        <a href="https://www.dhs.gov/homeland-security-act-2002" target="_blank" rel="noopener noreferrer">Homeland Security Act of 2002</a>
        &middot;
        <a href="https://www.stimson.org/2018/counterterrorism-spending-protecting-america-while-promoting-efficiencies-and-accountability/" target="_blank" rel="noopener noreferrer">Stimson Center, Counterterrorism Spending (2018)</a>
      </p>
    </div>
    <div class="hm-share-bar">
      <span class="hm-share-lbl">Share</span>
      <button class="hm-share-btn hm-share-x"         data-share="x"><i class="ti ti-brand-x"></i> X</button>
      <button class="hm-share-btn hm-share-linkedin"   data-share="linkedin"><i class="ti ti-brand-linkedin"></i> LinkedIn</button>
      <button class="hm-share-btn hm-share-facebook"   data-share="facebook"><i class="ti ti-brand-facebook"></i> Facebook</button>
      <button class="hm-share-btn hm-share-instagram"  data-share="instagram"><i class="ti ti-brand-instagram"></i> Instagram</button>
      <button class="hm-share-btn hm-share-tiktok"     data-share="tiktok"><i class="ti ti-brand-tiktok"></i> TikTok</button>
      <button class="hm-share-btn hm-share-discord"    data-share="discord"><i class="ti ti-brand-discord"></i> Discord</button>
      <button class="hm-share-btn hm-share-copy"       data-share="copy"><i class="ti ti-copy"></i> Copy link</button>
