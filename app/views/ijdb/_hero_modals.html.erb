  /* ── Share handler ── */
  document.querySelectorAll('.hm-share-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var platform = btn.dataset.share;
      var dlg      = btn.closest('dialog');
      var modalId  = dlg ? dlg.id : '';
      var data     = SHARE[modalId] || {};
      var url      = PAGE_URL;
      var text     = data[platform] || '';

      switch (platform) {
        case 'x':
          window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(text) + '&url=' + encodeURIComponent(url), '_blank', 'width=600,height=400');
          break;
        case 'linkedin':
          window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url), '_blank', 'width=600,height=500');
          break;
        case 'facebook':
          window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url), '_blank', 'width=600,height=400');
          break;
        case 'instagram':
          copyAndToast(text + '\n\n' + url);
          break;
        case 'tiktok':
          copyAndToast(text);
          break;
        case 'discord':
          copyAndToast(text);
          break;
        case 'copy':
          copyAndToast(url);
          break;
      }
    });
  });

  /* ── Backdrop click closes dialog ── */
  document.querySelectorAll('.hm-dialog').forEach(function (dlg) {
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });
  });

  /* ── Copy + toast ── */
  function copyAndToast(text) {
    var toast = document.getElementById('hm-toast');
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(function () { showToast(toast); });
    } else {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.cssText = 'position:fixed;opacity:0;';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      showToast(toast);
    }
  }

  function showToast(toast) {
    toast.classList.add('show');
    setTimeout(function () { toast.classList.remove('show'); }, 2000);
  }
}());
