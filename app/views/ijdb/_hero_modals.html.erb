      <button class="hm-share-btn hm-share-discord"    data-share="discord"><i class="ti ti-brand-discord"></i> Discord</button>
      <button class="hm-share-btn hm-share-copy"       data-share="copy"><i class="ti ti-copy"></i> Copy link</button>
    </div>
  </div>
</dialog>

<script>
(function () {
  var PAGE_URL = 'https://fora.center/usa/ijdb';

  /* Platform-appropriate copy per modal */
  var SHARE = {
    'total-ct-modal': {
      x:         'The US spent ~$8 TRILLION on counter-terrorism since 9/11.\n\n$24,000 per American. More than Germany\u2019s GDP. And no government document has ever officially totaled it.\n\nfora.center/usa/ijdb #JihadTax',
