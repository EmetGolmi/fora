<% content_for :head do %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/tabler-icons.min.css">
<style>
.methodology-wrap{max-width:1100px;margin:0 auto;padding:28px 24px 0;}
.methodology-panel{border:1px solid rgba(27,58,107,0.10);border-radius:7px;background:#ffffff;overflow:hidden;}
.methodology-toggle{list-style:none;cursor:pointer;user-select:none;display:flex;align-items:center;justify-content:space-between;padding:14px 18px;background:#f5f7fb;border-bottom:1px solid transparent;transition:background 0.12s;}
.methodology-toggle::-webkit-details-marker{display:none;}
.methodology-toggle:hover{background:#eef1f7;}
details[open] .methodology-toggle{border-bottom-color:rgba(27,58,107,0.10);}
.methodology-label{display:flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:#1b3a6b;font-weight:700;}
.methodology-label i{font-size:14px;color:#b8860b;}
.methodology-chevron{font-size:14px;color:#8a9ab8;transition:transform 0.20s;}
details[open] .methodology-chevron{transform:rotate(180deg);}
.methodology-body{padding:24px 22px 28px;display:grid;grid-template-columns:1fr 1fr;gap:28px 40px;}
@media(max-width:700px){.methodology-body{grid-template-columns:1fr;}}
.methodology-section h4{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.20em;text-transform:uppercase;color:#b8860b;margin-bottom:14px;}
.methodology-method{display:flex;gap:12px;margin-bottom:14px;align-items:flex-start;}
.method-num{font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:#ffffff;background:#1b3a6b;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.methodology-method strong{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:#0e1a2e;display:block;margin-bottom:4px;}
.methodology-method p{font-family:'Nunito',sans-serif;font-size:12.5px;color:#2c3e5a;line-height:1.70;margin:0;}
.methodology-source{display:flex;gap:12px;margin-bottom:12px;align-items:flex-start;}
.methodology-source > i{font-size:16px;color:#8a9ab8;flex-shrink:0;margin-top:2px;}
.methodology-source strong{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:#0e1a2e;display:block;margin-bottom:3px;}
.methodology-source span{font-family:'Nunito',sans-serif;font-size:12px;color:#5a6e8a;display:block;margin-bottom:3px;line-height:1.55;}
.methodology-source a{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.06em;color:#254f92;text-decoration:none;}
.methodology-source a:hover{text-decoration:underline;}
.methodology-contribute{grid-column:1/-1;display:flex;gap:14px;align-items:flex-start;padding:16px 18px;background:#fafbfd;border:1px solid rgba(27,58,107,0.08);border-radius:6px;margin-top:4px;}
.methodology-contribute > i{font-size:20px;color:#b8860b;flex-shrink:0;margin-top:2px;}
.methodology-contribute strong{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:#0e1a2e;display:block;margin-bottom:4px;}
.methodology-contribute p{font-family:'Nunito',sans-serif;font-size:12.5px;color:#2c3e5a;line-height:1.65;margin:0 0 10px;}
.methodology-link{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.10em;text-transform:uppercase;background:#1b3a6b;color:#ffffff;border-radius:4px;padding:7px 14px;text-decoration:none;display:inline-block;}
.methodology-link:hover{background:#254f92;}
.methodology-footer{grid-column:1/-1;font-family:'Nunito',sans-serif;font-size:12px;color:#8a9ab8;text-align:center;padding-top:12px;border-top:1px solid rgba(27,58,107,0.07);line-height:1.6;margin:0;}
.methodology-footer strong{color:#1b3a6b;}
</style>
<% end %>

<div class="methodology-wrap">
  <details class="methodology-panel">
    <summary class="methodology-toggle">
      <span class="methodology-label">
        <i class="ti ti-info-circle"></i>
        How we built these numbers
      </span>
      <i class="ti ti-chevron-down methodology-chevron"></i>
    </summary>

    <div class="methodology-body">

      <div class="methodology-section">
        <h4>Four methods</h4>

        <div class="methodology-method">
          <span class="method-num">1</span>
          <div>
            <strong>National program totals ÷ city share</strong>
            <p>Where Philadelphia is a known Tier 1 recipient (UASI, TSGP),
            we applied Philadelphia's estimated share based on population,
            risk tier, and transit system size.</p>
          </div>
        </div>

        <div class="methodology-method">
          <span class="method-num">2</span>
          <div>
            <strong>Documented grant awards</strong>
            <p>Where specific awards appear in ProPublica, USASpending,
            FEMA award notices, or press releases — used directly,
            marked as documented.</p>
          </div>
        </div>

        <div class="methodology-method">
          <span class="method-num">3</span>
          <div>
            <strong>Program cost modeling</strong>
            <p>For equipment (body scanners, X-ray machines, BDS anthrax
            units) — published unit costs × Philadelphia's estimated
            quantity by facility count and airport category.</p>
          </div>
        </div>

        <div class="methodology-method">
          <span class="method-num">4</span>
          <div>
            <strong>Expert estimates / named gaps</strong>
            <p>Where no public data exists — surveillance programs,
            classified enforcement, private sector compliance — we
            name the gap and explain why no figure is possible.</p>
          </div>
        </div>
      </div>

      <div class="methodology-section">
        <h4>What we are doing next</h4>

        <div class="methodology-source">
          <i class="ti ti-building-government"></i>
          <div>
            <strong>Pennsylvania Emergency Management Agency (PEMA)</strong>
            <span>Cumulative UASI and SHSP sub-award summaries to
            Philadelphia, 2003–2024.</span>
            <a href="mailto:grants@pa.gov">grants@pa.gov</a>
            · 717-651-2001
          </div>
        </div>

        <div class="methodology-source">
          <i class="ti ti-building"></i>
          <div>
            <strong>Philadelphia Office of Emergency Management</strong>
            <span>Annual reports — received and expended homeland
            security grant funds. Requested May 2026.</span>
          </div>
        </div>

        <div class="methodology-source">
          <i class="ti ti-database"></i>
          <div>
            <strong>FEMA Enterprise Grants Management System</strong>
            <span>Award-level data for all Pennsylvania UASI
            recipients by fiscal year.</span>
          </div>
        </div>
      </div>

      <div class="methodology-contribute">
        <i class="ti ti-users"></i>
        <div>
          <strong>Contribute a source</strong>
          <p>If you work in Philadelphia city government, PEMA, SEPTA,
          Philadelphia police, or any institution named on this page
          and have access to more precise figures — we want them.
          Your name goes on the entry.</p>
          <%= link_to "Submit a source →",
              new_city_ijdb_foia_path(city: @city),
              class: "methodology-link" %>
        </div>
      </div>

      <p class="methodology-footer">
        When figures move from estimated to documented, this page updates.
        Every upgrade gets a source link.
        <strong>This is why FORA exists.</strong>
      </p>

    </div>
  </details>
</div>
