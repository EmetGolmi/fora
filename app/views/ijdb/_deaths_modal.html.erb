<%# app/views/ijdb/_deaths_modal.html.erb %>

<% content_for :head do %>
<style>
/* ── DEATHS MODAL ── */
#deaths-modal{border:none;padding:0;border-radius:10px;max-width:720px;width:92vw;box-shadow:0 24px 80px rgba(0,0,0,0.50);overflow:hidden;}
#deaths-modal::backdrop{background:rgba(0,0,0,0.70);backdrop-filter:blur(3px);}
.dm-header{background:#0e1a2e;padding:28px 28px 24px;position:relative;}
.dm-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.24em;text-transform:uppercase;color:#d4a832;margin-bottom:10px;}
.dm-headline{font-family:'Libre Baskerville',serif;font-size:38px;font-weight:700;color:#ff7070;line-height:1.0;margin-bottom:6px;}
.dm-subtitle{font-family:'Nunito',sans-serif;font-size:13px;color:rgba(255,255,255,0.45);line-height:1.6;}
.dm-close{position:absolute;top:18px;right:20px;background:none;border:none;color:rgba(255,255,255,0.35);font-size:22px;cursor:pointer;line-height:1;padding:4px 8px;border-radius:4px;}
.dm-close:hover{color:#ffffff;background:rgba(255,255,255,0.08);}
.dm-body{background:#ffffff;padding:24px 28px 24px;max-height:72vh;overflow-y:auto;}

/* breakdown cols */
.dm-split{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:22px;}
@media(max-width:480px){.dm-split{grid-template-columns:1fr;}}
.dm-col{background:#f5f7fb;border-radius:7px;padding:16px 16px 14px;}
.dm-col-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.18em;text-transform:uppercase;color:#b8860b;margin-bottom:7px;}
.dm-col-value{font-family:'Libre Baskerville',serif;font-size:26px;font-weight:700;color:#0e1a2e;line-height:1.0;margin-bottom:5px;}
.dm-col-label{font-family:'Nunito',sans-serif;font-size:11px;color:#5a6e8a;margin-bottom:9px;}
.dm-bullets{list-style:none;padding:0;margin:0;}
.dm-bullets li{font-family:'JetBrains Mono',monospace;font-size:10px;color:#4a5a72;padding:3px 0;border-bottom:1px solid rgba(27,58,107,0.07);display:flex;justify-content:space-between;gap:8px;}
.dm-bullets li:last-child{border-bottom:none;}

/* attacks table */
.dm-section-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.20em;text-transform:uppercase;color:#b8860b;margin-bottom:10px;}
.dm-table{width:100%;border-collapse:collapse;margin-bottom:20px;}
.dm-table th{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:#8a9ab8;padding:6px 8px 6px 0;border-bottom:2px solid #1b3a6b;text-align:left;}
.dm-table th:last-child{text-align:right;padding-right:0;}
.dm-table td{font-family:'Nunito',sans-serif;font-size:12.5px;color:#2c3e5a;padding:9px 8px 9px 0;border-bottom:1px solid rgba(27,58,107,0.07);vertical-align:top;}
.dm-table td:last-child{text-align:right;padding-right:0;font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;white-space:nowrap;}
.dm-table tr:last-child td{border-bottom:none;}
.dm-yr{font-family:'JetBrains Mono',monospace;font-size:10px;color:#b8860b;font-weight:700;white-space:nowrap;}
.dm-sub{font-size:11px;color:#8a9ab8;display:block;margin-top:2px;}
.dm-deaths-high{color:#c0392b !important;}
.dm-perp-line{display:block;font-family:'JetBrains Mono',monospace;font-size:9px;color:#aaa;font-weight:400;margin-top:3px;}

/* FORA badge (for historical entries) */
.dm-badge{font-family:'JetBrains Mono',monospace;font-size:7px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:3px;margin-left:8px;vertical-align:middle;display:inline-block;}
.dm-badge-fora{background:#e8eef8;color:#1b3a6b;}

/* FORA framework strip (bottom) */
.dm-fora-strip{border-left:3px solid rgba(192,57,43,0.60);background:rgba(139,0,0,0.05);border-radius:0 6px 6px 0;padding:11px 15px;margin-bottom:18px;}
.dm-fora-strip p{font-family:'Nunito',sans-serif;font-size:11.5px;color:#5a3535;line-height:1.75;margin:0;}
.dm-fora-strip strong{color:#8b0000;}

/* methodology + sources */
.dm-rule{border:none;border-top:1px solid rgba(27,58,107,0.10);margin:4px 0 18px;}
.dm-methodology{background:#fffbf0;border:1px solid rgba(184,134,11,0.20);border-radius:6px;padding:13px 16px;margin-bottom:18px;}
.dm-methodology p{font-family:'Nunito',sans-serif;font-size:11.5px;color:#5a4a1a;line-height:1.75;margin:0;}
.dm-sources-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.16em;text-transform:uppercase;color:#b8860b;margin-bottom:8px;}
.dm-sources{font-family:'Nunito',sans-serif;font-size:11.5px;color:#5a6e8a;line-height:1.90;margin-bottom:20px;}
.dm-sources a{color:#1b3a6b;text-decoration:none;}
.dm-sources a:hover{text-decoration:underline;}
</style>
<% end %>

<dialog id="deaths-modal" aria-labelledby="dm-title">

  <div class="dm-header">
    <button class="dm-close" onclick="document.getElementById('deaths-modal').close()" aria-label="Close">✕</button>
    <div class="dm-eyebrow">◆ Islamic Jihad Cost Database · Deaths</div>
    <div class="dm-headline" id="dm-title">3,800+</div>
    <p class="dm-subtitle">Jihad's American death toll</p>
  </div>

  <div class="dm-body">

    <%# ── BREAKDOWN ── %>
    <div class="dm-split">
      <div class="dm-col">
        <div class="dm-col-eyebrow">September 11, 2001</div>
        <div class="dm-col-value">2,977</div>
        <div class="dm-col-label">Official count · 9/11 Commission</div>
        <ul class="dm-bullets">
          <li><span>World Trade Center</span><span>2,753</span></li>
          <li><span>Pentagon</span><span>184</span></li>
          <li><span>Flight 93 · Shanksville</span><span>40</span></li>
        </ul>
      </div>
      <div class="dm-col">
        <div class="dm-col-eyebrow">Post-9/11 · U.S. soil</div>
        <div class="dm-col-value">121+</div>
        <div class="dm-col-label">2002 – 2025</div>
        <ul class="dm-bullets">
          <li><span>New America Foundation</span><span>107</span></li>
          <li><span>New Orleans · Jan 2025</span><span>+14</span></li>
        </ul>
      </div>
    </div>

    <%# ── CHRONOLOGICAL TABLE ── %>
    <div class="dm-section-lbl">All recorded entries · chronological</div>
    <table class="dm-table">
      <thead>
        <tr>
          <th>Year</th>
          <th>Event</th>
          <th>Deaths</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="dm-yr">1627</td>
          <td>
            Little James — maritime enslavement
            <span class="dm-badge dm-badge-fora">FORA</span>
            <span class="dm-sub">North African Islamic corsair raid · ~12 enslaved, none returned</span>
          </td>
          <td>~12</td>
        </tr>
        <tr>
          <td class="dm-yr">1785</td>
          <td>
            Maria &amp; Dauphin — Algiers
            <span class="dm-badge dm-badge-fora">FORA</span>
            <span class="dm-sub">Algerian corsairs seized two American ships · 21 sailors enslaved · ~12 died in captivity before 1796 treaty</span>
          </td>
          <td>~12</td>
        </tr>
        <tr>
          <td class="dm-yr">1793</td>
          <td>
            Algerine crisis — 11 ships seized
            <span class="dm-badge dm-badge-fora">FORA</span>
            <span class="dm-sub">119 Americans enslaved in Algiers · deaths in captivity est. 40+ · ransomed 1796</span>
          </td>
          <td>~40</td>
        </tr>
        <tr>
          <td class="dm-yr">1801–05</td>
          <td>
            First Barbary War — Tripoli
            <span class="dm-badge dm-badge-fora">FORA</span>
            <span class="dm-sub">USS Philadelphia seized 1803 · 307 crew held 19 months · ~35 Americans killed in combat and captivity</span>
          </td>
          <td>~35</td>
        </tr>
        <tr>
          <td class="dm-yr">2009</td>
          <td>Fort Hood, TX<span class="dm-sub">Nidal Hasan · U.S. Army Major</span></td>
          <td>13</td>
        </tr>
        <tr>
          <td class="dm-yr">2013</td>
          <td>Boston Marathon<span class="dm-sub">Dzhokhar &amp; Tamerlan Tsarnaev</span></td>
          <td>3</td>
        </tr>
        <tr>
          <td class="dm-yr">2015</td>
          <td>Military recruiting center, Chattanooga TN<span class="dm-sub">Mohammad Abdulazeez</span></td>
          <td>5</td>
        </tr>
        <tr>
          <td class="dm-yr">2015</td>
          <td>San Bernardino, CA<span class="dm-sub">Syed Farook &amp; Tashfeen Malik</span></td>
          <td class="dm-deaths-high">14</td>
        </tr>
        <tr>
          <td class="dm-yr">2016</td>
          <td>Pulse nightclub, Orlando FL<span class="dm-sub">Omar Mateen</span></td>
          <td class="dm-deaths-high">49</td>
        </tr>
        <tr>
          <td class="dm-yr">2017</td>
          <td>Halloween truck attack, New York City<span class="dm-sub">Sayfullo Saipov</span></td>
          <td>8</td>
        </tr>
        <tr>
          <td class="dm-yr">2019</td>
          <td>Naval Air Station Pensacola, FL<span class="dm-sub">Mohammed Alshamrani · Saudi Air Force</span></td>
          <td>3</td>
        </tr>
        <tr>
          <td class="dm-yr">2023</td>
          <td>October 7 — Israel<span class="dm-sub">Hamas attack · 46 U.S. citizens confirmed killed · U.S. State Dept.</span></td>
          <td class="dm-deaths-high">46</td>
        </tr>
        <tr>
          <td class="dm-yr">2023</td>
          <td>Thousand Oaks CA — Paul Kessler<span class="dm-sub">Loay Alnaji · pro-Palestinian demonstration · charged involuntary manslaughter</span></td>
          <td>1</td>
        </tr>
        <tr>
          <td class="dm-yr">2025</td>
          <td>New Year's Day, New Orleans LA<span class="dm-sub">Shamsud-Din Jabbar · ISIS-inspired · FBI update Jan 14, 2025</span></td>
          <td>
            <span class="dm-deaths-high">14</span>
            <span class="dm-perp-line">+1 perpetrator</span>
          </td>
        </tr>
        <tr>
          <td class="dm-yr">2025</td>
          <td>Capital Jewish Museum, Washington DC<span class="dm-sub">Elias Rodriguez · shouted "Free Palestine"</span></td>
          <td>2</td>
        </tr>
      </tbody>
    </table>

    <hr class="dm-rule">

    <%# ── METHODOLOGY ── %>
    <div class="dm-methodology">
      <p>
        <strong>Counting methodology:</strong>
        The 3,800+ figure combines: the official 9/11 victim count (2,977); post-9/11 domestic
        deaths tracked by the New America Foundation (107) and the FBI New Orleans update of
        January 14, 2025 (14); 46 Americans killed on October 7, 2023 (U.S. State Department);
        and Barbary-era deaths and enslavements (1627–1805) counted under the FORA framework.
        The New Orleans perpetrator death (+1) is displayed separately and not included in the
        victim count.
      </p>
    </div>

    <%# ── SOURCES ── %>
    <div class="dm-sources-lbl">Sources</div>
    <div class="dm-sources">
      <a href="https://www.newamerica.org/in-depth/terrorism-in-america/" target="_blank" rel="noopener">New America Foundation, "Terrorism in America After 9/11"</a>
      · <a href="https://govinfo.gov/app/details/GPO-911REPORT" target="_blank" rel="noopener">9/11 Commission Report (2004)</a>
      · Fondapol / Global Terrorism Database (GTD)
      · FBI Field Office New Orleans, official update January 14, 2025
      · U.S. State Department — October 7 American casualties (2023)
      · <a href="https://www.newenglandhistoricalsociety.com" target="_blank" rel="noopener">New England Historic Genealogical Society — <em>Little James</em> (1627)</a>
      · Frank Lambert, <em>The Barbary Wars</em> (2005) · Naval History and Heritage Command
      · Los Angeles Times — Paul Kessler / Loay Alnaji (2023)
      · Washington Post / FBI statement — Capital Jewish Museum, Elias Rodriguez (2025)
    </div>

    <%# ── FORA EDITORIAL FRAMEWORK (bottom) ── %>
    <div class="dm-fora-strip">
      <p>
        <strong>FORA editorial framework:</strong> This count extends beyond standard counter-terrorism
        databases (New America Foundation, GTD) by applying FORA's position that slavery is a form
        of death. Entries marked <strong>FORA</strong> cover the Barbary era (1627–1805) and are not
        included in NAF or GTD tallies. Standard CT databases begin at 9/11.
      </p>
    </div>

  </div>
</dialog>
