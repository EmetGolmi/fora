<% content_for :head do %>
<style>
/* ── Foiled Plots section — prefix: fp- ── */
/* Hardcoded data MVP: plots array defined as local variable below */

.fp-section {
  margin: 0 -24px;
  padding: 28px 24px 32px;
  background: #f0f3f8;
  border-top: 0.5px solid rgba(27,58,107,0.14);
  border-bottom: 0.5px solid rgba(27,58,107,0.14);
}

/* Header */
.fp-hd {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 20px;
}
.fp-hd-title {
  font-family: 'Libre Baskerville', Georgia, serif;
  font-size: 1.25rem;
  font-weight: 700;
  color: #1b3a6b;
  letter-spacing: -0.01em;
}
.fp-hd-count {
  font-size: 0.78rem;
  font-weight: 600;
  color: #7a7a7a;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* Stat cards */
.fp-stats {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
  margin-bottom: 18px;
}
@media (max-width: 860px) {
  .fp-stats { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 520px) {
  .fp-stats { grid-template-columns: repeat(2, 1fr); }
}
.fp-stat {
  background: #ffffff;
  border: 0.5px solid rgba(27,58,107,0.14);
  border-radius: 7px;
  padding: 14px 12px 12px;
  text-align: center;
}
.fp-stat-val {
  font-size: 1.45rem;
  font-weight: 700;
  line-height: 1;
  color: #1b3a6b;
  letter-spacing: -0.02em;
  margin-bottom: 5px;
}
.fp-stat-val.red  { color: #b91c1c; }
.fp-stat-val.amber{ color: #b45309; }
.fp-stat-val.green{ color: #15803d; }
.fp-stat-lbl {
  font-size: 0.70rem;
  color: #5a5a5a;
  line-height: 1.3;
  font-weight: 500;
}

/* Definitions panel */
.fp-defs-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: 0.5px solid rgba(27,58,107,0.25);
  border-radius: 5px;
  padding: 5px 12px;
  font-size: 0.75rem;
  font-weight: 600;
  color: #1b3a6b;
  cursor: pointer;
  margin-bottom: 14px;
  letter-spacing: 0.02em;
  transition: background 0.15s;
}
.fp-defs-toggle:hover { background: rgba(27,58,107,0.06); }
.fp-defs-toggle .fp-arrow { transition: transform 0.2s; display: inline-block; }
.fp-defs-toggle.open .fp-arrow { transform: rotate(90deg); }

.fp-defs-panel {
  display: none;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 18px;
}
.fp-defs-panel.open { display: grid; }
@media (max-width: 700px) {
  .fp-defs-panel { grid-template-columns: 1fr; }
}
.fp-def-block {
  background: #ffffff;
  border: 0.5px solid rgba(27,58,107,0.14);
  border-radius: 7px;
  padding: 14px 14px 12px;
}
.fp-def-pill {
  display: inline-block;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border-radius: 10px;
  padding: 2px 8px;
  margin-bottom: 8px;
}
.fp-def-pill.sunni  { background: #fef3c7; color: #92400e; }
.fp-def-pill.shia   { background: #d1fae5; color: #065f46; }
.fp-def-pill.pal    { background: #ede9fe; color: #4c1d95; }
.fp-def-block h4 {
  font-size: 0.8rem;
  font-weight: 700;
  color: #1b3a6b;
  margin: 0 0 6px;
  line-height: 1.3;
}
.fp-def-block p {
  font-size: 0.73rem;
  color: #444;
  line-height: 1.55;
  margin: 0;
}

/* Filter bar */
.fp-filter-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 14px;
}
.fp-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 11px;
  border-radius: 20px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  cursor: pointer;
  border: 1.5px solid transparent;
  transition: all 0.15s;
  user-select: none;
}
.fp-pill.all   { background:#e8edf5; color:#1b3a6b; border-color:#c5cfe0; }
.fp-pill.sunni { background:#fef3c7; color:#92400e; border-color:#fcd34d; }
.fp-pill.shia  { background:#d1fae5; color:#065f46; border-color:#6ee7b7; }
.fp-pill.pal   { background:#ede9fe; color:#4c1d95; border-color:#c4b5fd; }
.fp-pill.active,
.fp-pill:hover { opacity: 0.85; filter: brightness(0.92); }
.fp-pill.active { outline: 2px solid currentColor; outline-offset: 1px; }

.fp-search {
  margin-left: auto;
  padding: 5px 10px;
  border: 0.5px solid rgba(27,58,107,0.25);
  border-radius: 5px;
  font-size: 0.74rem;
  width: 170px;
  background: #fff;
  color: #1b3a6b;
  outline: none;
}
.fp-search:focus { border-color: #1b3a6b; }
@media (max-width: 520px) { .fp-search { width: 100%; margin-left: 0; } }

/* Table */
.fp-table-wrap {
  overflow-x: auto;
  border-radius: 7px;
  border: 0.5px solid rgba(27,58,107,0.14);
  background: #fff;
  margin-bottom: 14px;
}
.fp-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.77rem;
  color: #1a1a1a;
}
.fp-table thead th {
  background: #1b3a6b;
  color: #fff;
  padding: 9px 8px 8px;
  font-weight: 600;
  font-size: 0.68rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  text-align: left;
  white-space: nowrap;
}
.fp-table thead th:first-child { border-radius: 7px 0 0 0; }
.fp-table thead th:last-child  { border-radius: 0 7px 0 0; }

.fp-row {
  cursor: pointer;
  border-bottom: 0.5px solid rgba(27,58,107,0.08);
  transition: background 0.12s;
}
.fp-row:hover  { background: #f5f7fb; }
.fp-row.sunni-row td:first-child { border-left: 3px solid #f59e0b; }
.fp-row.shia-row  td:first-child { border-left: 3px solid #10b981; }
.fp-row.pal-row   td:first-child { border-left: 3px solid #8b5cf6; }

.fp-row td {
  padding: 8px 8px;
  vertical-align: middle;
}
.fp-td-num   { width: 32px;  color: #888; font-size: 0.70rem; text-align: center; }
.fp-td-date  { width: 80px;  white-space: nowrap; color: #555; }
.fp-td-plot  { width: 210px; font-weight: 600; }
.fp-td-cat   { width: 116px; }
.fp-td-group { width: 110px; color: #444; }
.fp-td-foil  { width: 82px;  }
.fp-td-out   { }

.fp-cat-pill {
  display: inline-block;
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: 9px;
  padding: 2px 7px;
}
.fp-cat-pill.sunni { background:#fef3c7; color:#92400e; }
.fp-cat-pill.shia  { background:#d1fae5; color:#065f46; }
.fp-cat-pill.pal   { background:#ede9fe; color:#4c1d95; }

.fp-foil-tag {
  display: inline-block;
  font-size: 0.63rem;
  font-weight: 600;
  border-radius: 4px;
  padding: 1px 5px;
  background: #e8edf5;
  color: #1b3a6b;
  white-space: nowrap;
}
.fp-foil-tag.sting  { background:#fef3c7; color:#92400e; }
.fp-foil-tag.intel  { background:#dbeafe; color:#1e40af; }
.fp-foil-tag.public { background:#d1fae5; color:#065f46; }
.fp-foil-tag.intl   { background:#ede9fe; color:#4c1d95; }

/* Detail rows */
.fp-detail {
  display: none;
  background: #f8f9fc;
  border-bottom: 0.5px solid rgba(27,58,107,0.10);
}
.fp-detail.open { display: table-row; }
.fp-detail td {
  padding: 10px 12px 12px 36px;
  font-size: 0.74rem;
  color: #444;
  line-height: 1.6;
}
.fp-detail-src {
  margin-top: 6px;
  font-size: 0.68rem;
  color: #888;
}
.fp-detail-src a { color: #1b3a6b; text-decoration: underline; }

/* Pagination */
.fp-pagination {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.74rem;
  color: #555;
}
.fp-pg-btn {
  background: #1b3a6b;
  color: #fff;
  border: none;
  border-radius: 5px;
  padding: 4px 14px;
  font-size: 0.74rem;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.15s;
}
.fp-pg-btn:disabled { opacity: 0.35; cursor: default; }
.fp-pg-info { flex: 1; text-align: center; }

/* Footer note */
.fp-footnote {
  margin-top: 16px;
  font-size: 0.68rem;
  color: #777;
  line-height: 1.55;
  border-top: 0.5px solid rgba(27,58,107,0.10);
  padding-top: 10px;
}
</style>
<% end %>

