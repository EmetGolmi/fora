<section class="fp-section" id="foiled-plots">

  <%# ── Section header ── %>
  <div class="fp-hd">
    <span class="fp-hd-title">Foiled &amp; completed plots on U.S. soil</span>
    <span class="fp-hd-count">36 documented cases · 2002–2024</span>
  </div>

  <%# ── 6 stat cards ── %>
  <div class="fp-stats">
    <div class="fp-stat">
      <div class="fp-stat-val">36</div>
      <div class="fp-stat-lbl">Total documented plots</div>
    </div>
    <div class="fp-stat">
      <div class="fp-stat-val red">4</div>
      <div class="fp-stat-lbl">Completed attacks</div>
    </div>
    <div class="fp-stat">
      <div class="fp-stat-val green">32</div>
      <div class="fp-stat-lbl">Disrupted pre-attack</div>
    </div>
    <div class="fp-stat">
      <div class="fp-stat-val amber">17</div>
      <div class="fp-stat-lbl">Disrupted via FBI sting</div>
    </div>
    <div class="fp-stat">
      <div class="fp-stat-val">20</div>
      <div class="fp-stat-lbl">Sunni apocalyptic</div>
    </div>
    <div class="fp-stat">
      <div class="fp-stat-val">16</div>
      <div class="fp-stat-lbl">Shia state terror &amp; Palestinian</div>
    </div>
  </div>

  <%# ── Definitions panel ── %>
  <button class="fp-defs-toggle" id="fp-defs-btn" onclick="fpToggleDefs()" aria-expanded="false">
    <span class="fp-arrow">&#9654;</span> Category definitions
  </button>
  <div class="fp-defs-panel" id="fp-defs-panel">
    <div class="fp-def-block">
      <span class="fp-def-pill sunni">Sunni Apocalyptic</span>
      <h4>Salafi-jihadist / takfiri operations</h4>
      <p>Plots motivated by the ideological framework of al-Qaeda, ISIS, and allied groups: global caliphate, takfir (apostasy declaration), martyrdom operations, and the killing of civilians as a religious obligation. Perpetrators may be foreign nationals, first-generation immigrants, or converts. Theology traces to Ibn Taymiyya → Sayyid Qutb → Abdullah Azzam → bin Laden lineage. FORA tracks this track because the U.S. spent ~$8T in response to a single cohort of plots in this category.</p>
    </div>
    <div class="fp-def-block">
      <span class="fp-def-pill shia">Shia State Terror</span>
      <h4>IRGC / Hezbollah directed operations</h4>
      <p>Plots authorized, funded, or directed by the Islamic Revolutionary Guard Corps (Quds Force) or Hezbollah (Iranian proxy). Distinguished from Sunni track by state-sponsorship: Iran uses deniable assets (sleeper cells, criminal proxies, diaspora recruits) to conduct assassination, surveillance, and infrastructure sabotage. The 2011 Saudi ambassador plot and IRGC revenge plots post-Soleimani are canonical examples. Motivation is geopolitical, not millenarian.</p>
    </div>
    <div class="fp-def-block">
      <span class="fp-def-pill pal">Palestinian Extremism</span>
      <h4>Hamas, PIJ &amp; affiliated operations</h4>
      <p>Plots linked to Palestinian militant organizations (Hamas, Palestinian Islamic Jihad) or individuals acting in solidarity with Palestinian armed resistance. Includes material support networks, fundraising cells, and recruitment on U.S. soil. Pre-October 7 cases were largely financial; post-October 7 cases include incitement, assassination plots, and infrastructure support. FORA distinguishes this from the Sunni apocalyptic track: motivation is territorial and nationalist rather than eschatological, though there is ideological overlap via Muslim Brotherhood lineage.</p>
    </div>
  </div>

  <%# ── Filter pills + search ── %>
  <div class="fp-filter-bar" id="fp-filter-bar">
    <span class="fp-pill all active" data-filter="all"    onclick="fpFilter('all',this)">All <span id="fp-count-all">36</span></span>
    <span class="fp-pill sunni"      data-filter="sunni"  onclick="fpFilter('sunni',this)">Sunni Apocalyptic <span id="fp-count-sunni">20</span></span>
    <span class="fp-pill shia"       data-filter="shia"   onclick="fpFilter('shia',this)">Shia State Terror <span id="fp-count-shia">8</span></span>
    <span class="fp-pill pal"        data-filter="pal"    onclick="fpFilter('pal',this)">Palestinian <span id="fp-count-pal">8</span></span>
    <input class="fp-search" id="fp-search" type="search" placeholder="Search plots…" oninput="fpSearch(this.value)" aria-label="Search foiled plots">
  </div>

  <%# ── Table ── %>
  <div class="fp-table-wrap">
    <table class="fp-table" id="fp-table" aria-label="Foiled and completed terror plots">
      <thead>
        <tr>
          <th class="fp-td-num">#</th>
          <th class="fp-td-date">Date</th>
          <th class="fp-td-plot">Plot / Perpetrator</th>
          <th class="fp-td-cat">Category</th>
          <th class="fp-td-group">Group</th>
          <th class="fp-td-foil">Foiled by</th>
          <th class="fp-td-out">Outcome</th>
        </tr>
      </thead>
      <tbody id="fp-tbody">
        <% plots.each do |p| %>
          <% cat_s = p[:cat].to_s %>
          <% foil_s = p[:foiled_by].to_s %>
          <% foil_label = { "sting" => "FBI sting", "intel" => "Intelligence", "public" => "Public tip", "intl" => "Intl intel", "na" => "N/A — completed" }[foil_s] || foil_s %>
          <tr class="fp-row <%= cat_s %>-row"
              data-cat="<%= cat_s %>"
              data-search="<%= [p[:name], p[:location], p[:group], p[:outcome]].join(' ').downcase %>"
              data-detail="fp-detail-<%= p[:n] %>"
              onclick="fpToggleDetail(<%= p[:n] %>)"
              aria-expanded="false">
            <td class="fp-td-num"><%= p[:n] %></td>
            <td class="fp-td-date"><%= p[:date] %></td>
            <td class="fp-td-plot"><%= p[:name] %><br><small style="font-weight:400;color:#666;"><%= p[:location] %></small></td>
            <td class="fp-td-cat"><span class="fp-cat-pill <%= cat_s %>"><%= { sunni: "Sunni", shia: "Shia", pal: "Palestinian" }[p[:cat]] %></span></td>
            <td class="fp-td-group"><%= p[:group] %></td>
            <td class="fp-td-foil"><span class="fp-foil-tag <%= foil_s %>"><%= foil_label %></span></td>
            <td class="fp-td-out"><%= p[:outcome] %></td>
          </tr>
          <tr class="fp-detail" id="fp-detail-<%= p[:n] %>">
            <td colspan="7">
              <%= p[:detail] %>
              <div class="fp-detail-src">Source: <a href="<%= p[:src_url] %>" target="_blank" rel="noopener noreferrer"><%= p[:src_title] %></a></div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── Pagination ── %>
  <div class="fp-pagination" id="fp-pagination">
    <button class="fp-pg-btn" id="fp-prev" onclick="fpPage(-1)" disabled>&#8592; Prev</button>
    <span class="fp-pg-info" id="fp-pg-info">Page 1 of 4 &middot; 36 entries</span>
    <button class="fp-pg-btn" id="fp-next" onclick="fpPage(1)">Next &#8594;</button>
  </div>

  <%# ── Footer note ── %>
  <p class="fp-footnote">
    Entries include both disrupted plots and completed attacks where the perpetrator was motivated by jihadi ideology as defined in the FORA framework. FBI sting operations are included because they reflect operational intent; critics argue some would not have materialized without government facilitation — FORA notes this debate but does not filter sting operations from the total. Sources: DOJ press releases, court records, and linked primary sources. Shia state terror and Palestinian extremism entries are drawn from federal indictments and Congressional testimony; some suspects remain at large. This list is non-exhaustive.
  </p>

</section>

<script>
(function() {
  var PER_PAGE = 10;
  var currentFilter = 'all';
  var currentSearch = '';
  var currentPage = 1;

  function getVisibleRows() {
    var tbody = document.getElementById('fp-tbody');
    if (!tbody) return [];
    var rows = tbody.querySelectorAll('tr.fp-row');
    var visible = [];
    rows.forEach(function(row) {
      var cat = row.getAttribute('data-cat');
      var srch = row.getAttribute('data-search') || '';
      var catMatch = (currentFilter === 'all') || (cat === currentFilter);
      var searchMatch = !currentSearch || srch.indexOf(currentSearch.toLowerCase()) !== -1;
      if (catMatch && searchMatch) visible.push(row);
    });
    return visible;
  }

  function render() {
    var tbody = document.getElementById('fp-tbody');
    if (!tbody) return;
    var allRows = tbody.querySelectorAll('tr.fp-row');
    var visibleRows = getVisibleRows();
    var totalPages = Math.max(1, Math.ceil(visibleRows.length / PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;
    var start = (currentPage - 1) * PER_PAGE;
    var end = start + PER_PAGE;

    // Hide all main rows + detail rows
    allRows.forEach(function(row) {
      row.style.display = 'none';
      var detailId = row.getAttribute('data-detail');
      if (detailId) {
        var det = document.getElementById(detailId);
        if (det) { det.style.display = 'none'; det.classList.remove('open'); }
      }
    });

    // Show current page of visible rows
    visibleRows.slice(start, end).forEach(function(row) {
      row.style.display = '';
    });

    // Update pagination UI
    var info = document.getElementById('fp-pg-info');
    if (info) info.textContent = 'Page ' + currentPage + ' of ' + totalPages + ' \u00B7 ' + visibleRows.length + ' entries';
    var prev = document.getElementById('fp-prev');
    var next = document.getElementById('fp-next');
    if (prev) prev.disabled = (currentPage <= 1);
    if (next) next.disabled = (currentPage >= totalPages);
  }

  window.fpFilter = function(cat, el) {
    currentFilter = cat;
    currentPage = 1;
    document.querySelectorAll('#fp-filter-bar .fp-pill').forEach(function(p) {
      p.classList.toggle('active', p.getAttribute('data-filter') === cat);
    });
    render();
  };

  window.fpSearch = function(val) {
    currentSearch = val;
    currentPage = 1;
    render();
  };

  window.fpPage = function(dir) {
    var visibleRows = getVisibleRows();
    var totalPages = Math.max(1, Math.ceil(visibleRows.length / PER_PAGE));
    currentPage = Math.min(Math.max(1, currentPage + dir), totalPages);
    render();
  };

  window.fpToggleDetail = function(n) {
    var det = document.getElementById('fp-detail-' + n);
    var row = det ? det.previousElementSibling : null;
    if (!det) return;
    var isOpen = det.classList.contains('open');
    det.classList.toggle('open', !isOpen);
    det.style.display = isOpen ? 'none' : 'table-row';
    if (row) row.setAttribute('aria-expanded', String(!isOpen));
  };

  window.fpToggleDefs = function() {
    var btn = document.getElementById('fp-defs-btn');
    var panel = document.getElementById('fp-defs-panel');
    if (!btn || !panel) return;
    var isOpen = panel.classList.contains('open');
    panel.classList.toggle('open', !isOpen);
    btn.classList.toggle('open', !isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  };

  // Initial render on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', render);
  } else {
    render();
  }
})();
</script>
