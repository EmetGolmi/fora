<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "FORA" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="FORA">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="font-family:'Nunito',sans-serif; background:#f0f3f8; color:#0e1a2e; margin:0; padding:0; min-height:100vh;">

    <nav style="background:#1b3a6b; border-bottom:3px solid #b8860b; height:60px; display:flex; align-items:center; justify-content:space-between; padding:0 48px; position:sticky; top:0; z-index:200; box-sizing:border-box;">
      <%= link_to "javascript:history.back()", title: "Back to My Government", style: "font-family:'Libre Baskerville',serif; font-size:22px; font-weight:700; color:white; letter-spacing:0.1em; text-decoration:none; flex-shrink:0;" do %>F<span style="color:#d4a832;">O</span>RA<% end %>
      <%= link_to "About", about_path, style: "font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.5); text-decoration:none; flex-shrink:0; transition:color 0.15s;", onmouseover: "this.style.color='rgba(212,168,50,0.9)'", onmouseout: "this.style.color='rgba(255,255,255,0.5)'" %>
    </nav>

    <%= yield %>

  </body>
</html>
