<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORA · Chris Rabb · PA House District 200 · Candidate, U.S. Congress PA-3</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --blue:     #1b3a6b;
  --blue-md:  #254f92;
  --blue-lt:  #3a6abf;
  --blue-pl:  #dde5f5;
  --blue-xs:  #f0f4fb;
  --gilt:     #b8860b;
  --gilt-lt:  #d4a832;
  --gilt-pl:  #f8f0dc;
  --ink:      #0e1a2e;
  --ink-soft: #5a6e8a;
  --ink-mut:  #8a9ab8;
  --bg:       #f2f4f8;
  --white:    #ffffff;
  --rule:     rgba(27,58,107,0.1);
  --rule-md:  rgba(27,58,107,0.18);
  --green:    #155c2d;
  --green-p:  #e5f0e8;
  --scarlet:  #8b1a1a;
  --scarlet-p:#faeaea;
  --amber:    #c47f00;
  --amber-p:  #fff3dc;
  --purple:   #4a1a7a;
  --purple-p: #f0e8f8;
  --ticker-bg:#0a0f1a;
  --font-serif:'Libre Baskerville',serif;
  --font-mono: 'JetBrains Mono',monospace;
  --font-ui:   'Nunito',sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:var(--font-ui);background:var(--bg);color:var(--ink);font-size:14px;line-height:1.6;}



/* ── HERO ── */
.profile-hero{background:var(--blue);padding:32px 24px 28px;position:relative;overflow:hidden;}
.profile-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(27,58,107,1) 0%,rgba(37,79,146,0.8) 100%);}
.ph-inner{max-width:960px;margin:0 auto;display:flex;align-items:flex-start;gap:24px;position:relative;}

.ph-avatar{
  width:88px;height:88px;border-radius:12px;
  background:rgba(255,255,255,0.15);
  border:2px solid rgba(255,255,255,0.2);
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-serif);font-size:32px;font-weight:700;color:white;
  flex-shrink:0;
}

.ph-info{flex:1;}
.ph-eyebrow{font-family:var(--font-mono);font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt-lt);margin-bottom:5px;}
.ph-name{font-family:var(--font-serif);font-size:28px;font-weight:700;color:white;margin-bottom:4px;line-height:1.1;}
.ph-title{font-family:var(--font-mono);font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.6);margin-bottom:12px;}

.ph-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
.ph-tag{font-family:var(--font-mono);font-size:8px;letter-spacing:0.08em;text-transform:uppercase;padding:3px 10px;border-radius:3px;font-weight:700;}
.pt-dem{background:rgba(58,106,191,0.3);color:#93b8ff;border:1px solid rgba(58,106,191,0.4);}
.pt-socialist{background:rgba(74,26,122,0.4);color:#c89dff;border:1px solid rgba(74,26,122,0.5);}
.pt-candidate{background:rgba(184,134,11,0.3);color:var(--gilt-lt);border:1px solid rgba(184,134,11,0.4);}
.pt-incumbent{background:rgba(21,92,45,0.3);color:#69d5a0;border:1px solid rgba(21,92,45,0.4);}

.ph-links{display:flex;gap:6px;flex-wrap:wrap;}
.ph-link{font-family:var(--font-mono);font-size:9px;letter-spacing:0.08em;text-transform:uppercase;padding:5px 12px;border-radius:4px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.7);text-decoration:none;transition:all 0.12s;}
.ph-link:hover{background:rgba(255,255,255,0.18);color:white;}
.ph-link.fec{border-color:rgba(184,134,11,0.3);color:var(--gilt-lt);}
.ph-avatar img{width:100%;height:100%;object-fit:cover;border-radius:10px;}

/* ── SHARE ROWS ── */
.pi-share{display:flex;align-items:center;gap:4px;flex-wrap:wrap;margin-top:7px;padding-top:7px;border-top:1px solid var(--rule);}
.pi-share-label{font-family:var(--font-mono);font-size:8px;color:var(--ink-mut);letter-spacing:0.06em;margin-right:2px;}
.pi-share-btn{font-family:var(--font-mono);font-size:9px;padding:2px 8px;border-radius:2px;text-decoration:none;background:var(--blue-xs);color:var(--blue-lt);border:1px solid var(--blue-pl);cursor:pointer;display:inline-flex;align-items:center;transition:all 0.1s;line-height:1.6;}
.pi-share-btn:hover{background:var(--blue-pl);color:var(--blue);}

/* ── TRUE COLORS BAR ── */
.true-colors{background:var(--blue-xs);border-bottom:1px solid var(--rule);}
.tc-inner{max-width:960px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;gap:16px;}
.tc-label{font-family:var(--font-mono);font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);flex-shrink:0;}
.tc-bar{flex:1;height:10px;border-radius:5px;background:linear-gradient(90deg, var(--blue) 0%, #6b4c8a 100%);position:relative;overflow:visible;}
.tc-marker{position:absolute;top:-2px;width:14px;height:14px;border-radius:50%;background:var(--blue);border:2px solid white;box-shadow:0 1px 4px rgba(0,0,0,0.3);transform:translateX(-50%);left:15%;}
.tc-ends{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);margin-top:2px;}
.tc-pct{font-family:var(--font-mono);font-size:9px;color:var(--blue-lt);flex-shrink:0;}

/* ── PAGE ── */
.page{max-width:960px;margin:0 auto;padding:28px 24px 80px;}
.page-grid{display:grid;grid-template-columns:1fr 320px;gap:28px;align-items:start;}

/* ── SECTIONS ── */
.sec-eyebrow{font-family:var(--font-mono);font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt);margin-bottom:3px;}
.sec-title{font-family:var(--font-serif);font-size:20px;font-weight:700;color:var(--ink);margin-bottom:12px;}

.card{background:var(--white);border:1px solid var(--rule);border-radius:10px;overflow:hidden;margin-bottom:20px;}
.card-header{background:var(--blue-xs);border-bottom:1px solid var(--rule);padding:10px 18px;display:flex;align-items:center;gap:8px;}
.ch-icon{font-size:16px;}
.ch-title{font-family:var(--font-serif);font-size:14px;font-weight:700;color:var(--ink);}
.ch-sub{font-family:var(--font-mono);font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);margin-left:auto;}
.card-body{padding:16px 18px;}

/* ── BIO ── */
.bio-text{font-size:13px;color:var(--ink-soft);line-height:1.7;margin-bottom:10px;}
.bio-text:last-child{margin-bottom:0;}
.bio-text strong{color:var(--ink);}

/* ── PLATFORM ITEMS ── */
.platform-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid var(--rule);}
.platform-item:last-child{border-bottom:none;}
.pi-icon{font-size:18px;flex-shrink:0;margin-top:1px;}
.pi-title{font-family:var(--font-serif);font-size:13px;font-weight:700;color:var(--ink);margin-bottom:3px;}
.pi-desc{font-size:12px;color:var(--ink-soft);line-height:1.6;}
.pi-links{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px;}
.pi-link{font-family:var(--font-mono);font-size:8px;letter-spacing:0.06em;padding:2px 8px;border-radius:2px;text-decoration:none;transition:all 0.12s;}
.pi-link.pro{background:var(--green-p);color:var(--green);border:1px solid rgba(21,92,45,0.2);}
.pi-link.con{background:var(--scarlet-p);color:var(--scarlet);border:1px solid rgba(139,26,26,0.2);}
.pi-link.neutral{background:var(--blue-pl);color:var(--blue-lt);border:1px solid rgba(27,58,107,0.15);}
.pi-link:hover{filter:brightness(0.92);}

/* ── DONOR BARS ── */
.donor-row{display:flex;align-items:center;gap:10px;padding:6px 0;border-bottom:1px solid var(--rule);}
.donor-row:last-child{border-bottom:none;}
.donor-name{font-size:12px;color:var(--ink-soft);flex:1;}
.donor-bar-track{width:80px;height:5px;background:var(--bg);border:1px solid var(--rule);border-radius:3px;overflow:hidden;}
.donor-bar-fill{height:100%;border-radius:3px;}
.donor-amt{font-family:var(--font-mono);font-size:10px;font-weight:700;color:var(--ink);width:60px;text-align:right;}

/* ── ALERT / WARNING CARD ── */
.alert-card{border-radius:8px;padding:14px 16px;margin-bottom:16px;display:flex;gap:12px;align-items:flex-start;}
.alert-card.warning{background:var(--amber-p);border:1px solid rgba(196,127,0,0.25);}
.alert-card.info{background:var(--blue-xs);border:1px solid var(--blue-pl);}
.alert-card.notable{background:var(--purple-p);border:1px solid rgba(74,26,122,0.2);}
.ac-icon{font-size:16px;flex-shrink:0;margin-top:1px;}
.ac-title{font-family:var(--font-serif);font-size:12px;font-weight:700;margin-bottom:3px;}
.alert-card.warning .ac-title{color:var(--amber);}
.alert-card.info    .ac-title{color:var(--blue);}
.alert-card.notable .ac-title{color:var(--purple);}
.ac-body{font-size:11px;color:var(--ink-soft);line-height:1.6;}
.ac-body a{color:var(--blue-lt);font-weight:600;text-decoration:none;}
.ac-body a:hover{text-decoration:underline;}

/* ── ENDORSEMENTS ── */
.endorse-row{display:flex;gap:8px;align-items:flex-start;padding:8px 0;border-bottom:1px solid var(--rule);}
.endorse-row:last-child{border-bottom:none;}
.er-badge{font-family:var(--font-mono);font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:2px;font-weight:700;flex-shrink:0;margin-top:2px;}
.erb-national{background:var(--blue-pl);color:var(--blue);}
.erb-local{background:var(--green-p);color:var(--green);}
.erb-media{background:var(--gilt-pl);color:var(--gilt);}
.er-name{font-size:12px;font-weight:700;color:var(--ink);}
.er-note{font-size:11px;color:var(--ink-mut);}

/* ── COMPARE TABLE ── */
.compare-table{width:100%;border-collapse:collapse;font-size:12px;}
.compare-table th{text-align:left;padding:8px 10px;background:var(--blue);color:white;font-family:var(--font-mono);font-size:8px;letter-spacing:0.1em;text-transform:uppercase;}
.compare-table td{padding:9px 10px;border-bottom:1px solid var(--rule);vertical-align:top;line-height:1.5;}
.compare-table tr:nth-child(even) td{background:var(--bg);}
.compare-table tr:last-child td{border-bottom:none;}
.ct-country{font-weight:700;color:var(--ink);}
.ct-green{color:var(--green);font-weight:700;}
.ct-red{color:var(--scarlet);font-weight:700;}
.ct-amber{color:var(--amber);font-weight:700;}

/* ── SIDEBAR ── */
.sidebar{}
.sidebar-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;overflow:hidden;margin-bottom:16px;}
.sc-header{background:var(--blue);padding:10px 14px;}
.sc-title{font-family:var(--font-serif);font-size:13px;font-weight:700;color:white;}
.sc-body{padding:14px;}

.stat-row{display:flex;align-items:center;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--rule);}
.stat-row:last-child{border-bottom:none;}
.stat-label{font-family:var(--font-mono);font-size:9px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);}
.stat-value{font-family:var(--font-serif);font-size:14px;font-weight:700;color:var(--ink);}

.district-map-placeholder{background:var(--blue-xs);border:1px dashed var(--blue-pl);border-radius:6px;height:120px;display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:9px;color:var(--ink-mut);text-align:center;padding:12px;}


/* ── WIKI TOOLTIPS ── */
.wiki-tooltip {
  position: relative;
  display: inline;
  border-bottom: 1px dashed var(--blue-lt);
  cursor: help;
  color: inherit;
  text-decoration: none;
}
.wiki-tooltip .wt-bubble {
  display: none;
  position: absolute;
  bottom: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%);
  width: 300px;
  background: var(--ink);
  color: rgba(255,255,255,0.88);
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 11px;
  line-height: 1.6;
  z-index: 400;
  pointer-events: none;
  box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  font-family: var(--font-ui);
  font-style: normal;
  font-weight: 400;
}
.wiki-tooltip .wt-bubble::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 6px solid transparent;
  border-top-color: var(--ink);
}
.wiki-tooltip .wt-title {
  font-family: var(--font-serif);
  font-size: 12px;
  font-weight: 700;
  color: white;
  margin-bottom: 4px;
  display: block;
}
.wiki-tooltip .wt-link {
  display: inline-block;
  margin-top: 6px;
  font-family: var(--font-mono);
  font-size: 8.5px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--gilt-lt);
  pointer-events: all;
  text-decoration: none;
}
.wiki-tooltip:hover .wt-bubble,
.wiki-tooltip:focus .wt-bubble { display: block; }

/* ── BILL CARDS ── */
.bill-cards { display: flex; flex-direction: column; gap: 8px; }
.bill-card {
  border: 1px solid var(--rule);
  border-radius: 7px;
  padding: 10px 14px;
  background: var(--white);
  display: flex;
  align-items: flex-start;
  gap: 12px;
  transition: background 0.1s;
}
.bill-card:hover { background: var(--blue-xs); }
.bc-id {
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.1em;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 3px;
  flex-shrink: 0;
  margin-top: 2px;
}
.bc-id.passed { background: var(--green-p); color: var(--green); }
.bc-id.referred { background: var(--blue-pl); color: var(--blue); }
.bc-id.active { background: var(--amber-p); color: var(--amber); }
.bc-body { flex: 1; }
.bc-title { font-size: 12px; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
.bc-desc { font-size: 11px; color: var(--ink-soft); line-height: 1.55; }
.bc-status { font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-mut); margin-top: 3px; }
.bc-link { font-family: var(--font-mono); font-size: 8px; letter-spacing: 0.06em; color: var(--blue-lt); text-decoration: none; flex-shrink: 0; margin-top: 3px; }
.bc-link:hover { text-decoration: underline; }

/* ── BOOK CARD ── */
.book-card {
  background: var(--ink);
  border-radius: 10px;
  padding: 16px 18px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 8px;
}
.book-cover {
  width: 52px;
  flex-shrink: 0;
  background: var(--blue);
  border-radius: 4px;
  padding: 8px 6px;
  text-align: center;
  font-family: var(--font-serif);
  font-size: 8px;
  font-weight: 700;
  color: white;
  line-height: 1.4;
  border-left: 4px solid var(--gilt);
}
.book-info { flex: 1; }
.book-title { font-family: var(--font-serif); font-size: 14px; font-weight: 700; color: white; margin-bottom: 3px; font-style: italic; }
.book-sub { font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 6px; }
.book-desc { font-size: 11px; color: rgba(255,255,255,0.7); line-height: 1.6; margin-bottom: 8px; }
.book-links { display: flex; gap: 6px; flex-wrap: wrap; }
.book-btn {
  font-family: var(--font-mono);
  font-size: 8.5px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 3px;
  text-decoration: none;
  font-weight: 700;
  transition: all 0.1s;
}
.book-btn.buy { background: var(--gilt); color: var(--ink); }
.book-btn.buy:hover { background: var(--gilt-lt); }
.book-btn.preview { background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.2); }
.book-btn.preview:hover { background: rgba(255,255,255,0.2); color: white; }

hr.rule{border:none;border-top:1px solid var(--rule);margin:24px 0;}

@media(max-width:740px){
  .page-grid{grid-template-columns:1fr;}
  .ph-inner{flex-direction:column;gap:16px;}
}
</style>
</head>
<body>



