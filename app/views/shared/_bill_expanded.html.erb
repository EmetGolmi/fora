<%#
  Shared partial: bill expand panel
  Used by: dashboard card (context: :card) and bills#show (context: :page)

  Locals:
    bill       — CivicBill (required)
    context    — :card (default) | :page
    ai_summary — String from bills#show AI cache (optional, card ignores)
    ai_effects — String from bills#show AI cache (optional, card ignores)

  Data model (all optional / gracefully absent):
    bill.plain_summary   — human-seeded plain language; overrides ai_summary
    bill.effects         — jsonb Array<String>; bullet list; overrides ai_effects
    bill.sit_for         — text, "the case for"
    bill.sit_against     — text, "the case against"
    bill.study_facts     — jsonb Array<{text, source_label, source_url?}>
    bill.guide_seeded    — boolean guard; false → graceful placeholder
    bill.full_text_url   — existing column; used for doc links
%>
<% ctx      = local_assigns.fetch(:context,    :card) %>
<% ai_sum   = local_assigns.fetch(:ai_summary, nil)   %>
<% ai_eff   = local_assigns.fetch(:ai_effects, nil)   %>
<% sum_text = bill.plain_summary.presence || ai_sum   %>
<% eff_rows = Array(bill.effects).presence            %>
<% gid      = "guide-#{bill.id}"                      %>

<%# ── CSS (once per page) ──────────────────────────────────────────────── %>
<% unless @_bill_guide_css_loaded %>
  <% @_bill_guide_css_loaded = true %>
  <style>
  /* expand panel — title + metarow */
  .exp-full-t{font-family:'Libre Baskerville',serif;font-weight:700;font-size:17px;line-height:1.4;margin:12px 0 9px;color:var(--ink,#0e1a2e);}
  .bexp-metarow{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;}
  .bexp-chip{font-size:11.5px;color:var(--ink-soft,#5a6e8a);background:var(--rule-soft,#eef1f6);border-radius:999px;padding:5px 11px;display:flex;align-items:center;gap:5px;text-decoration:none;}
  a.bexp-chip{color:var(--ink-soft,#5a6e8a);}
  .bexp-chip.doc{background:#faeaea;color:#8b1a1a;font-weight:700;}

  /* content blocks */
  .bexp-block{border-top:1px solid var(--rule,#e3e8f0);padding-top:13px;margin-top:14px;}
  .bexp-block-h{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-mut,#8a9ab8);margin-bottom:8px;}
  .bexp-summary{font-size:14.5px;line-height:1.65;color:var(--ink,#0e1a2e);}
  .bexp-affect{list-style:none;}
  .bexp-affect li{font-size:13.5px;line-height:1.5;padding:7px 0 7px 24px;position:relative;color:var(--ink,#0e1a2e);}
  .bexp-affect li::before{content:"→";position:absolute;left:0;top:7px;color:var(--gilt,#b8860b);font-weight:700;}
  .bexp-src-note{font-size:10.5px;color:var(--ink-mut,#8a9ab8);font-style:italic;margin-top:6px;}
  .bexp-placeholder{font-size:13px;color:var(--ink-mut,#8a9ab8);font-style:italic;padding:4px 0;}

  /* guide container */
  .exp-guide{margin-top:16px;border:1px solid rgba(184,134,11,.28);border-radius:13px;overflow:hidden;background:#fff;}
  .exp-guide-head{background:linear-gradient(120deg,#fdfaf1,#fff);padding:13px 15px;border-bottom:1px solid rgba(184,134,11,.28);}
  .exp-guide-eyebrow{display:flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--temple,#b8860b);margin-bottom:5px;}
  .exp-guide-h{font-family:'Libre Baskerville',serif;font-weight:700;font-size:15px;color:var(--blue,#1b3a6b);}
  .exp-guide-sub{font-size:11.5px;color:var(--ink-soft,#5a6e8a);margin-top:3px;line-height:1.5;}
  .exp-guide-sub b{color:var(--ink,#0e1a2e);}
  .exp-guide-unseeded{padding:16px;font-size:13px;color:var(--ink-mut,#8a9ab8);font-style:italic;}

  /* guide tabs */
  .eg-tabs{display:flex;border-bottom:1px solid var(--rule,#e3e8f0);}
  .eg-tab{flex:1;text-align:center;padding:11px 4px 9px;cursor:pointer;border-bottom:3px solid transparent;}
  .eg-tab-n{font-family:'Libre Baskerville',serif;font-weight:700;font-size:14px;color:var(--ink-soft,#5a6e8a);}
  .eg-tab-d{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-mut,#8a9ab8);margin-top:2px;}
  .eg-tab.on{border-bottom-color:var(--temple,#b8860b);}
  .eg-tab.on .eg-tab-n{color:var(--temple,#b8860b);}
  .eg-tab.locked{opacity:.38;cursor:default;pointer-events:none;}
  .eg-pane{display:none;padding:15px;}
  .eg-pane.on{display:block;}

  /* feeling chips */
  .eg-sit-intro{font-size:13.5px;line-height:1.6;color:var(--ink,#0e1a2e);margin:0 0 13px;}
  .eg-feel-chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:13px;}
  .eg-feel-chip{border:1.5px solid;border-radius:999px;padding:7px 14px;font-size:12.5px;font-family:'Nunito',sans-serif;font-weight:700;cursor:pointer;background:#fff;transition:all .15s;}
  .eg-feel-chip.angry{border-color:#c97070;color:#8b1414;}
  .eg-feel-chip.worried{border-color:#c9a050;color:#7a4800;}
  .eg-feel-chip.hopeful{border-color:#5aab72;color:#1f6b3b;}
  .eg-feel-chip.skeptical{border-color:#6a82b8;color:#2c4a8a;}
  .eg-feel-chip.conflicted{border-color:#9a70c9;color:#5c3b8a;}
  .eg-feel-chip.on.angry{background:#fdf0f0;border-color:#8b1414;}
  .eg-feel-chip.on.worried{background:#fdf7ec;border-color:#7a4800;}
  .eg-feel-chip.on.hopeful{background:#f0faf3;border-color:#1f6b3b;}
  .eg-feel-chip.on.skeptical{background:#eef2fb;border-color:#2c4a8a;}
  .eg-feel-chip.on.conflicted{background:#f5f0fb;border-color:#5c3b8a;}

  /* react note textarea */
  .eg-react-note{margin-bottom:12px;}
  .eg-react-note textarea{width:100%;border:1.5px solid var(--rule,#e3e8f0);border-radius:8px;padding:9px 11px;font-family:'Nunito',sans-serif;font-size:12.5px;resize:vertical;min-height:52px;outline:none;color:var(--ink,#0e1a2e);box-sizing:border-box;}
  .eg-react-note textarea:focus{border-color:rgba(27,58,107,.35);}
  .eg-react-note-label{font-size:10.5px;color:var(--ink-mut,#8a9ab8);font-style:italic;margin-bottom:5px;}

  /* reveal / advance CTAs */
  .eg-cta-btn{display:inline-block;padding:9px 18px;border-radius:999px;font-family:'Nunito',sans-serif;font-weight:700;font-size:13px;cursor:pointer;border:1.5px solid var(--gilt,#b8860b);color:var(--gilt,#b8860b);background:#fff;transition:all .15s;}
  .eg-cta-btn:not(:disabled):hover{background:#fdf5e0;}
  .eg-cta-btn:disabled{opacity:.38;cursor:default;}
  .eg-cta-btn.primary{background:var(--blue,#1b3a6b);border-color:var(--blue,#1b3a6b);color:#fff;}
  .eg-cta-btn.primary:not(:disabled):hover{background:#254f92;}

  /* sit sides */
  .eg-sides{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:13px;}
  @media(max-width:520px){.eg-sides{grid-template-columns:1fr;}}
  .eg-side{border:1px solid var(--rule,#e3e8f0);border-radius:10px;padding:11px 12px;}
  .eg-side-h{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;margin-bottom:6px;font-weight:600;}
  .eg-side.for  .eg-side-h{color:#1f7a3e;}
  .eg-side.against .eg-side-h{color:#8b1a1a;}
  .eg-side p{font-size:12.5px;line-height:1.55;color:var(--ink,#0e1a2e);margin:0;}

  /* steel-man banner */
  .eg-steelman{border-left:4px solid #7b3fa0;background:#f7f2fc;border-radius:0 10px 10px 0;padding:13px 14px;margin-top:12px;}
  .eg-steelman-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:#7b3fa0;margin-bottom:5px;}
  .eg-steelman-h{font-family:'Libre Baskerville',serif;font-weight:700;font-size:13.5px;color:#3d1a5a;margin-bottom:4px;}
  .eg-steelman-sub{font-size:11.5px;color:#5a3d78;line-height:1.5;margin-bottom:10px;}
  .eg-steelman textarea{width:100%;border:1.5px solid rgba(123,63,160,.3);border-radius:8px;padding:9px 11px;font-family:'Nunito',sans-serif;font-size:13px;resize:vertical;min-height:58px;outline:none;background:#fff;box-sizing:border-box;color:var(--ink,#0e1a2e);}
  .eg-steelman textarea:focus{border-color:#7b3fa0;}
  .eg-steelman-note{font-size:10px;color:#7b5fa0;font-style:italic;margin-top:6px;margin-bottom:10px;}

  /* study */
  .eg-facts{list-style:none;margin:0;padding:0;}
  .eg-facts li{font-size:13px;line-height:1.5;padding:8px 0;border-bottom:1px solid var(--rule-soft,#eef1f6);display:flex;gap:9px;align-items:flex-start;}
  .eg-facts li:last-child{border-bottom:none;}
  .eg-fact-src{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.04em;text-transform:uppercase;color:var(--blue,#1b3a6b);background:var(--blue-pl,#dde5f5);border-radius:5px;padding:2px 6px;white-space:nowrap;flex:none;text-decoration:none;}
  .eg-study-doc{margin-top:11px;display:inline-flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:#8b1a1a;border:1px solid #faeaea;background:#faeaea;border-radius:999px;padding:8px 13px;text-decoration:none;}

  /* share */
  .eg-share-draft{margin-bottom:13px;}
  .eg-share-draft-label{font-size:11px;color:var(--ink-mut,#8a9ab8);font-style:italic;margin-bottom:7px;}
  .eg-share-draft textarea{width:100%;border:1.5px solid var(--rule,#e3e8f0);border-radius:8px;padding:10px 12px;font-family:'Nunito',sans-serif;font-size:13.5px;resize:vertical;min-height:80px;outline:none;color:var(--ink,#0e1a2e);box-sizing:border-box;}
  .eg-share-draft textarea:focus{border-color:rgba(27,58,107,.35);}
  .eg-share-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap;}
  .eg-share-status{font-size:11.5px;color:var(--ink-soft,#5a6e8a);font-style:italic;}
  .eg-share-ok{color:#1f7a3e;font-weight:700;}

  /* correction slip */
  .eg-slip{display:none;border-left:4px solid #8b1414;background:#fdf0f0;border-radius:0 10px 10px 0;padding:12px 14px;margin-bottom:12px;}
  .eg-slip.on{display:block;}
  .eg-slip-head{display:flex;align-items:center;gap:7px;font-family:'Libre Baskerville',serif;font-weight:700;font-size:13px;color:#8b1414;margin-bottom:4px;}
  .eg-slip-reason{font-size:12.5px;color:#5a1010;line-height:1.5;margin-bottom:10px;}
  .eg-slip-acts{display:flex;gap:8px;flex-wrap:wrap;}
  .eg-slip-revise{padding:7px 15px;border-radius:999px;font-family:'Nunito',sans-serif;font-weight:700;font-size:12px;cursor:pointer;border:1.5px solid #8b1414;color:#8b1414;background:#fff;}
  .eg-slip-revise:hover{background:#fdf0f0;}
  .eg-slip-anyway{padding:7px 15px;border-radius:999px;font-family:'Nunito',sans-serif;font-weight:700;font-size:12px;cursor:pointer;border:1.5px solid var(--rule,#e3e8f0);color:var(--ink-soft,#5a6e8a);background:#fff;}
  .eg-slip-anyway:hover{border-color:#8b1414;color:#8b1414;}
  </style>
<% end %>

<%# ── Card context: full title + metarow ─────────────────────────────── %>
<% if ctx == :card %>
  <div class="exp-full-t"><%= bill.title %></div>
  <div class="bexp-metarow">
    <% sp = Array(bill.sponsors).first %>
    <% if sp.present? %>
      <span class="bexp-chip">📋 <%= sp["name"] || sp[:name] %></span>
    <% end %>
    <span class="bexp-chip">🏛 <%= bill.status.to_s.truncate(60) %></span>
    <% if bill.full_text_url.present? %>
      <a href="<%= bill.full_text_url %>" target="_blank" rel="noopener" class="bexp-chip doc">📄 Official text →</a>
    <% end %>
  </div>
<% end %>

<%# ── Summary ──────────────────────────────────────────────────────────── %>
<div class="bexp-block">
  <div class="bexp-block-h">In plain language</div>
  <% if sum_text.present? %>
    <div class="bexp-summary"><%= sum_text %></div>
    <% if bill.plain_summary.blank? %>
      <div class="bexp-src-note">AI-generated analysis.</div>
    <% end %>
  <% else %>
    <div class="bexp-summary-lazy" data-bill-id="<%= bill.id %>" style="color:var(--ink-mut);font-size:13px;font-style:italic;">
      <span class="bexp-lazy-spinner" style="display:inline-block;width:10px;height:10px;border:1.5px solid rgba(27,58,107,.2);border-top-color:var(--blue);border-radius:50%;animation:spin-bill .7s linear infinite;margin-right:6px;vertical-align:middle;"></span>
      Loading summary…
    </div>
    <style>.bexp-lazy-spinner{animation:spin-bill .7s linear infinite;}@keyframes spin-bill{to{transform:rotate(360deg);}}</style>
  <% end %>
</div>

<%# ── Effects ─────────────────────────────────────────────────────────── %>
<% if eff_rows.present? || ai_eff.present? %>
  <div class="bexp-block">
    <div class="bexp-block-h">How it may affect you</div>
    <% if eff_rows.present? %>
      <ul class="bexp-affect">
        <% eff_rows.each do |eff| %>
          <li><%= eff %></li>
        <% end %>
      </ul>
    <% else %>
      <div class="bexp-summary"><%= ai_eff %></div>
      <div class="bexp-src-note">AI-generated analysis.</div>
    <% end %>
  </div>
<% end %>

<%# ── Guide ────────────────────────────────────────────────────────────── %>
<div class="exp-guide" id="<%= gid %>">
  <div class="exp-guide-head">
    <div class="exp-guide-eyebrow">
      <span style="font-size:13px;">◯</span> Think it through with your guide
    </div>
    <div class="exp-guide-h">Sit with it. Study it. Then take your stand.</div>
    <div class="exp-guide-sub">
      <b>FORA never tells you what to think.</b>
      It makes sure you've understood — both sides, then the facts — before you decide.
    </div>
  </div>

  <% if bill.guide_seeded? %>

    <div class="eg-tabs">
      <div class="eg-tab on" id="<%= gid %>-tab-sit"
           onclick="egTab(this,'sit','<%= gid %>')">
        <div class="eg-tab-n">Sit</div>
        <div class="eg-tab-d">both sides</div>
      </div>
      <div class="eg-tab locked" id="<%= gid %>-tab-study"
           onclick="egTab(this,'study','<%= gid %>')">
        <div class="eg-tab-n">Study</div>
        <div class="eg-tab-d">the facts</div>
      </div>
      <div class="eg-tab locked" id="<%= gid %>-tab-share"
           onclick="egTab(this,'share','<%= gid %>')">
        <div class="eg-tab-n">Share</div>
        <div class="eg-tab-d">your stand</div>
      </div>
    </div>

    <%# ── SIT ─────────────────────────────────────────────────────────── %>
    <div class="eg-pane on" id="<%= gid %>-sit">

      <%# Stage 1: Gut reaction %>
      <div id="<%= gid %>-sit-react">
        <p class="eg-sit-intro">Before seeing the arguments — what's your <em>gut reaction</em> to this bill?</p>
        <div class="eg-feel-chips" id="<%= gid %>-chips">
          <button class="eg-feel-chip angry"      onclick="egFeel(this,'<%= gid %>')">😤 Angry</button>
          <button class="eg-feel-chip worried"     onclick="egFeel(this,'<%= gid %>')">😟 Worried</button>
          <button class="eg-feel-chip hopeful"     onclick="egFeel(this,'<%= gid %>')">🌱 Hopeful</button>
          <button class="eg-feel-chip skeptical"   onclick="egFeel(this,'<%= gid %>')">🤔 Skeptical</button>
          <button class="eg-feel-chip conflicted"  onclick="egFeel(this,'<%= gid %>')">⚖ Conflicted</button>
        </div>
        <div class="eg-react-note" id="<%= gid %>-react-wrap" style="display:none;">
          <div class="eg-react-note-label">What's driving that feeling? (stays private)</div>
          <textarea id="<%= gid %>-react-ta" placeholder="Optional — just for you…" rows="2"></textarea>
        </div>
        <button class="eg-cta-btn" id="<%= gid %>-reveal-btn"
                disabled
                onclick="egRevealSides('<%= gid %>')">
          See both sides →
        </button>
      </div>

      <%# Stage 2: Both sides + steel-man %>
      <div id="<%= gid %>-sit-sides" style="display:none;">
        <div class="eg-sides">
          <div class="eg-side for">
            <div class="eg-side-h">The case for</div>
            <p><%= bill.sit_for %></p>
          </div>
          <div class="eg-side against">
            <div class="eg-side-h">The case against</div>
            <p><%= bill.sit_against %></p>
          </div>
        </div>

        <div class="eg-steelman">
          <div class="eg-steelman-eyebrow">⚖ &nbsp;The editor taps your shoulder</div>
          <div class="eg-steelman-h">Can you argue the other side?</div>
          <div class="eg-steelman-sub">
            A position you can't argue against isn't one you've actually examined.
            Write the <em>strongest</em> version of the argument you disagree with.
          </div>
          <textarea id="<%= gid %>-steelman-ta"
                    placeholder="The strongest point on the other side is…"
                    rows="3"
                    oninput="egSteelmanInput(this,'<%= gid %>')"></textarea>
          <div class="eg-steelman-note">Private. FORA never stores or uses this for profiling.</div>
          <button class="eg-cta-btn primary" id="<%= gid %>-advance-btn"
                  disabled
                  onclick="egSaveSit('<%= gid %>', <%= bill.id %>)">
            I can argue the other side →
          </button>
        </div>
      </div>

    </div><%# /.eg-pane#sit %>

    <%# ── STUDY ───────────────────────────────────────────────────────── %>
    <div class="eg-pane" id="<%= gid %>-study">
      <% facts = Array(bill.study_facts) %>
      <% if facts.present? %>
        <ul class="eg-facts">
          <% facts.each do |fact| %>
            <li>
              <span><%= fact["text"] %></span>
              <% if fact["source_label"].present? %>
                <% if fact["source_url"].present? %>
                  <a href="<%= fact["source_url"] %>" target="_blank" rel="noopener"
                     class="eg-fact-src"><%= fact["source_label"] %></a>
                <% else %>
                  <span class="eg-fact-src"><%= fact["source_label"] %></span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if bill.full_text_url.present? %>
        <a href="<%= bill.full_text_url %>" target="_blank" rel="noopener"
           class="eg-study-doc">📄 Read the official bill text →</a>
      <% end %>
      <div style="margin-top:14px;">
        <button class="eg-cta-btn primary"
                onclick="egUnlockShare('<%= gid %>')">
          Ready to take a stand →
        </button>
      </div>
    </div>

    <%# ── SHARE ───────────────────────────────────────────────────────── %>
    <div class="eg-pane" id="<%= gid %>-share">

      <%# Correction slip — hidden until tone check flags %>
      <div class="eg-slip" id="<%= gid %>-slip">
        <div class="eg-slip-head">🌡 &nbsp;A note before you post</div>
        <div class="eg-slip-reason" id="<%= gid %>-slip-reason"></div>
        <div class="eg-slip-acts">
          <button class="eg-slip-revise"
                  onclick="egSlipRevise('<%= gid %>')">Revise</button>
          <button class="eg-slip-anyway"
                  onclick="egPostComment('<%= gid %>', <%= bill.id %>, true)">Post anyway</button>
        </div>
      </div>

      <div class="eg-share-draft">
        <div class="eg-share-draft-label">
          Your voice on this bill — visible to your community.
        </div>
        <textarea id="<%= gid %>-draft"
                  placeholder="What do you think about this bill? Your neighbors want to hear it."
                  rows="4"></textarea>
      </div>

      <div class="eg-share-row">
        <button class="eg-cta-btn" onclick="egToneCheck('<%= gid %>', <%= bill.id %>)"
                id="<%= gid %>-tone-btn">
          Check my tone →
        </button>
        <button class="eg-cta-btn primary" style="display:none;"
                id="<%= gid %>-post-btn"
                onclick="egPostComment('<%= gid %>', <%= bill.id %>, false)">
          Post this →
        </button>
        <span class="eg-share-status" id="<%= gid %>-share-status"></span>
      </div>

    </div>

  <% else %>
    <div class="exp-guide-unseeded">
      Deeper guide coming — the Sit / Study / Share guide for this bill is being prepared.
    </div>
  <% end %>
</div><%# /.exp-guide %>

<%# ── JS (once per page) ────────────────────────────────────────────────── %>
<% unless @_bill_guide_js_loaded %>
  <% @_bill_guide_js_loaded = true %>
  <script>
  /* ── Tab navigation ─────────────────────────────────────────────────── */
  function egTab(tab, key, gid) {
    if (tab.classList.contains('locked')) return;
    var guide = document.getElementById(gid);
    if (!guide) return;
    guide.querySelectorAll('.eg-tab').forEach(function(t){ t.classList.remove('on'); });
    tab.classList.add('on');
    guide.querySelectorAll('.eg-pane').forEach(function(p){ p.classList.remove('on'); });
    var pane = document.getElementById(gid + '-' + key);
    if (pane) pane.classList.add('on');
  }

  function egUnlockTab(gid, key) {
    var tab = document.getElementById(gid + '-tab-' + key);
    if (tab) tab.classList.remove('locked');
  }

  /* ── Feeling chips ───────────────────────────────────────────────────── */
  function egFeel(chip, gid) {
    chip.classList.toggle('on');
    // Show react note once any chip is selected
    var anyOn = document.querySelectorAll('#' + gid + '-chips .eg-feel-chip.on').length > 0;
    var wrap  = document.getElementById(gid + '-react-wrap');
    if (wrap) wrap.style.display = anyOn ? 'block' : 'none';
    // Enable "See both sides" button
    var btn = document.getElementById(gid + '-reveal-btn');
    if (btn) btn.disabled = !anyOn;
  }

  /* ── Reveal both sides ───────────────────────────────────────────────── */
  function egRevealSides(gid) {
    var reactEl = document.getElementById(gid + '-sit-react');
    var sidesEl = document.getElementById(gid + '-sit-sides');
    if (reactEl) reactEl.style.display = 'none';
    if (sidesEl) sidesEl.style.display = 'block';
  }

  /* ── Steel-man textarea — enable advance button when non-empty ───────── */
  function egSteelmanInput(ta, gid) {
    var btn = document.getElementById(gid + '-advance-btn');
    if (btn) btn.disabled = ta.value.trim().length < 8;
  }

  /* ── Save Sit reflection + advance to Study ─────────────────────────── */
  function egSaveSit(gid, billId) {
    var chips      = document.querySelectorAll('#' + gid + '-chips .eg-feel-chip.on');
    var feelTags   = Array.from(chips).map(function(c){
      return c.className.match(/angry|worried|hopeful|skeptical|conflicted/)[0];
    });
    var reactNote  = (document.getElementById(gid + '-react-ta')    || {}).value || '';
    var steelNote  = (document.getElementById(gid + '-steelman-ta') || {}).value || '';

    // Advance immediately — save is best-effort / fail-open
    egUnlockTab(gid, 'study');
    var studyTab = document.getElementById(gid + '-tab-study');
    if (studyTab) egTab(studyTab, 'study', gid);

    fetch('/mvp/bills/' + billId + '/reflection', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json',
                 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')
                                         ? document.querySelector('meta[name="csrf-token"]').content : '' },
      body: JSON.stringify({
        feeling_tags:   feelTags,
        reaction_note:  reactNote,
        steelman_note:  steelNote
      })
    }).catch(function(){
      // Fail silently — reflection is a nice-to-have, not a gate
    });
  }

  /* ── Unlock Share tab (called from Study CTA) ────────────────────────── */
  function egUnlockShare(gid) {
    egUnlockTab(gid, 'share');
    var shareTab = document.getElementById(gid + '-tab-share');
    if (shareTab) egTab(shareTab, 'share', gid);
  }

  /* ── Tone check ─────────────────────────────────────────────────────── */
  function egToneCheck(gid, billId) {
    var draft   = (document.getElementById(gid + '-draft') || {}).value || '';
    var toneBtn = document.getElementById(gid + '-tone-btn');
    var postBtn = document.getElementById(gid + '-post-btn');
    var status  = document.getElementById(gid + '-share-status');
    var slip    = document.getElementById(gid + '-slip');

    if (!draft.trim()) {
      if (status) status.textContent = 'Write something first.';
      return;
    }

    if (toneBtn) { toneBtn.disabled = true; toneBtn.textContent = 'Checking…'; }
    if (status)  status.textContent = '';
    if (slip)    slip.classList.remove('on');

    fetch('/mvp/bills/' + billId + '/tone_check', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json',
                 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')
                                         ? document.querySelector('meta[name="csrf-token"]').content : '' },
      body: JSON.stringify({ draft: draft })
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      if (toneBtn) { toneBtn.disabled = false; toneBtn.textContent = 'Check my tone →'; }
      if (data.flagged) {
        // Show correction slip
        var reasonEl = document.getElementById(gid + '-slip-reason');
        if (reasonEl) reasonEl.textContent = data.reason || 'This may read as a personal attack or contempt.';
        if (slip) slip.classList.add('on');
      } else {
        // Clean — reveal Post button
        if (postBtn) postBtn.style.display = 'inline-block';
        if (status)  { status.textContent = '✓ Looks good.'; status.classList.add('eg-share-ok'); }
      }
    })
    .catch(function() {
      // Fail-open: let the user post
      if (toneBtn) { toneBtn.disabled = false; toneBtn.textContent = 'Check my tone →'; }
      if (postBtn) postBtn.style.display = 'inline-block';
    });
  }

  /* ── Dismiss slip and return to edit ────────────────────────────────── */
  function egSlipRevise(gid) {
    var slip  = document.getElementById(gid + '-slip');
    var draft = document.getElementById(gid + '-draft');
    if (slip)  slip.classList.remove('on');
    if (draft) draft.focus();
  }

  /* ── Post comment (also handles "Post anyway") ───────────────────────── */
  function egPostComment(gid, billId, skipTone) {
    var draft   = (document.getElementById(gid + '-draft') || {}).value || '';
    var status  = document.getElementById(gid + '-share-status');
    var postBtn = document.getElementById(gid + '-post-btn');
    var toneBtn = document.getElementById(gid + '-tone-btn');
    var slip    = document.getElementById(gid + '-slip');

    if (!draft.trim()) {
      if (status) status.textContent = 'Write something first.';
      return;
    }

    if (postBtn) postBtn.disabled = true;
    if (toneBtn) toneBtn.disabled = true;
    if (status)  status.textContent = 'Posting…';
    if (slip)    slip.classList.remove('on');

    var csrfToken = document.querySelector('meta[name="csrf-token"]');

    fetch('/mvp/bills/' + billId + '/comments', {
      method:  'POST',
      headers: { 'Content-Type': 'application/json',
                 'X-CSRF-Token': csrfToken ? csrfToken.content : '' },
      body: JSON.stringify({ bill_comment: { body: draft } })
    })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      if (data.success) {
        if (status) {
          status.textContent = '✓ Posted. Your voice is on the record.';
          status.classList.add('eg-share-ok');
        }
        if (postBtn) postBtn.style.display = 'none';
        if (toneBtn) toneBtn.style.display = 'none';
        var draftEl = document.getElementById(gid + '-draft');
        if (draftEl) { draftEl.value = ''; draftEl.disabled = true; }
      } else {
        if (status) status.textContent = (data.errors || ['Something went wrong.']).join(' ');
        if (postBtn) postBtn.disabled = false;
        if (toneBtn) toneBtn.disabled = false;
      }
    })
    .catch(function() {
      if (status) status.textContent = 'Network error — please try again.';
      if (postBtn) postBtn.disabled = false;
      if (toneBtn) toneBtn.disabled = false;
    });
  }
  </script>
<% end %>
