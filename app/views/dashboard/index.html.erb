<div style="max-width: 600px; margin: 120px auto; text-align: center;">
  <h1>FORA</h1>
  <p>Find your elected representatives and track legislation in your area.</p>

  <% if flash[:alert] %>
    <p style="color: #c00;"><%= flash[:alert] %></p>
  <% end %>

  <%= form_tag dashboard_path, method: :get, style: "margin-top: 2em;" do %>
    <div>
      <%= text_field_tag :address, nil,
        placeholder: "Enter your street address",
        style: "width: 100%; padding: 12px; font-size: 16px; box-sizing: border-box;",
        autofocus: true %>
    </div>
    <div style="margin-top: 1em;">
      <%= submit_tag "Find my representatives",
        style: "padding: 12px 24px; font-size: 16px; cursor: pointer;" %>
    </div>
  <% end %>
</div>
