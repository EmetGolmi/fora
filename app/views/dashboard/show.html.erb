  };
});

// ── Official profile panel ────────────────────────────────────────────────
function openOfficialProfile(path, name) {
  var iframe = document.getElementById('official-iframe');
  iframe.style.height = 'calc(100vh - 100px)';
  iframe.src = path;
  document.getElementById('official-panel-name').textContent = name;
  switchPanel('official', null);
  iframe.onload = function() {
    try {
      var h = iframe.contentWindow.document.body.scrollHeight;
      if (h > 200) iframe.style.height = (h + 40) + 'px';
    } catch(e) {}
  };
}

