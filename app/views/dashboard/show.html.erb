    'Real estate': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia homebuyer resources \u2014 where to start', sub:'The Philadelphia Home Buy Now program connects first-time buyers with HUD-approved counseling agencies. Free sessions cover credit readiness, mortgage options, and neighborhood market conditions. philahome.org.', tag:'Resource'},
          {title:'Understanding the Philadelphia property tax system', sub:'Philly uses the Actual Value Initiative (AVI) to assess properties. Your assessed value should equal market value. If it doesn\u2019t, you have the right to appeal at the BRT. Appeals must be filed by the first Monday of October.', tag:'Guide'},
          {title:'Tenant rights when a landlord sells your building', sub:'Under Philadelphia law, tenants have the right to remain through their lease term when a property sells. Landlords must give 30 days\u2019 notice to vacate unless cause is shown. Know your rights at phila.gov/tenants.', tag:'Rights'}
