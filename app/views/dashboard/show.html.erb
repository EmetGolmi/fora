    'Plumbing': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'How to shut off water in a Philadelphia rowhome', sub:'Most rowhomes have the main shutoff inside the basement near the front wall. Know where it is before a pipe bursts. The street-level curb stop requires a T-bar tool \u2014 Philadelphia Water will shut it from outside in emergencies.', tag:'How-to'},
          {title:'Philadelphia Water Department \u2014 Lead Service Line Replacement Program', sub:'PWD is replacing lead service lines at no cost to homeowners. Check your line material at water.phila.gov/lsl. Replacement typically takes one day; temporary water service is provided.', tag:'Resource'},
          {title:'PA plumber licensing \u2014 what to verify before hiring', sub:'All journeyman and master plumbers in PA must be licensed through the State Plumbing Board under the Pennsylvania Construction Code Act. Ask for license number before any work begins. Verify at license.pa.gov.', tag:'Guide'}
