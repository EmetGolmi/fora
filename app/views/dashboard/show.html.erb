<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="<%= form_authenticity_token %>">
<title>FORA · Home</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/tabler-icons.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css">
<style>
:root{
  --blue:#1b3a6b;--blue-md:#254f92;--blue-lt:#3a6abf;--blue-pl:#dde5f5;--blue-vp:#eef2fb;
  --gilt:#b8860b;--gilt-lt:#d4a832;--gilt-pl:#f8f0dc;--gilt-vp:#fdf8ef;
  --scarlet:#8b1a1a;--scarlet-p:#faeaea;--amber:#c47f00;--amber-p:#fff3dc;
  --green:#155c2d;--green-lt:#1f7a3e;--green-p:#e5f0e8;--green-vp:#f0f7f2;--purple:#2d1a4a;
  --bg:#f2f4f8;--white:#fff;--ink:#0e1a2e;--ink-soft:#5a6e8a;--ink-mut:#8a9ab8;
  --rule:#e3e8f0;--rule-soft:#eef1f6;
  --temple:#b8860b;--forum:#1b3a6b;--market:#155c2d;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--bg);color:var(--ink);font-family:'Nunito',sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased;}
.serif{font-family:'Libre Baskerville',serif;}
a{text-decoration:none;color:inherit;}

.shell{width:100%;display:grid;grid-template-columns:245px minmax(0,1fr) minmax(335px,1fr);min-height:100vh;}
.col-left{border-right:1px solid var(--rule);position:sticky;top:0;height:100vh;padding:12px 9px;display:flex;flex-direction:column;overflow-y:auto;}
.col-center{border-right:1px solid var(--rule);background:var(--white);min-width:0;}
.col-right{padding:12px 16px;}
/* Market map — desktop right column */
#mkt-map-right{display:none;height:calc(100vh - 24px);position:sticky;top:12px;border-radius:12px;overflow:hidden;margin-bottom:14px;border:1px solid var(--rule);}
#mkt-map-d{height:100%;width:100%;}
#right-civic{}
/* Market map — mobile/tablet toggle */
.mkt-view-toggle{display:none;gap:0;border-bottom:1px solid var(--rule);padding:10px 16px;}
.mvt-btn{flex:1;padding:7px 0;border:1px solid var(--rule);background:#fff;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;color:var(--ink-soft);cursor:pointer;}
.mvt-btn:first-child{border-radius:8px 0 0 8px;border-right:none;}
.mvt-btn:last-child{border-radius:0 8px 8px 0;}
.mvt-btn.on{background:var(--market);color:#fff;border-color:var(--market);}
#mkt-map-m-wrap{display:none;height:calc(100vh - 110px);}
#mkt-map-m{height:100%;width:100%;}
@media(max-width:1040px){
  .mkt-view-toggle{display:flex;}
  #mkt-map-right{display:none!important;}
}
/* Service area panel */
.svc-head{padding:18px 20px 12px;border-bottom:1px solid var(--rule-soft);}
.svc-head-title{font-family:'Libre Baskerville',serif;font-size:17px;font-weight:700;color:var(--market);margin-bottom:4px;}
.svc-head-sub{font-size:12px;color:var(--ink-soft);line-height:1.5;}
.svc-hint{font-size:11px;color:var(--ink-mut);line-height:1.6;}
.ms-add-svc-bar{padding:12px 20px;border-bottom:1px solid var(--rule);}
.ms-add-svc-btn{width:100%;padding:10px 16px;background:none;border:1.5px dashed var(--market);border-radius:10px;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;color:var(--market);cursor:pointer;transition:all .15s;}
.ms-add-svc-btn:hover{background:var(--market-pl);}
.ms-svc-list{padding:14px 20px;display:flex;flex-direction:column;gap:10px;}
.ms-svc-card{background:#fff;border:1.5px solid var(--rule);border-radius:12px;padding:14px 16px;}
.ms-svc-card-trade{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:var(--blue);margin-bottom:7px;}
.ms-svc-card-codes{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:9px;}
.ms-svc-code{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.05em;padding:3px 9px;border-radius:100px;font-weight:700;}
.ms-svc-code.naics{background:#e8f0ff;color:#254f92;}
.ms-svc-code.onet{background:#e5f0e8;color:#155c2d;}
.ms-svc-code.isco{background:#f5f0e8;color:#7a5c1e;}
.ms-svc-card-meta{display:flex;align-items:center;justify-content:space-between;}
.ms-svc-status{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.05em;font-weight:700;color:var(--market);}
.ms-svc-view-link{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.06em;text-transform:uppercase;color:var(--market);text-decoration:none;padding:4px 10px;border:1px solid var(--market);border-radius:7px;}
.ms-svc-view-link:hover{background:var(--market-pl);}
/* ── My Services embedded wizard (ms-prefix) ─────────────────────────────── */
.ms-stepbar{display:flex;align-items:stretch;margin-bottom:18px;background:#fff;border:1px solid var(--rule);border-radius:9px;overflow:hidden;}
.ms-sb-step{flex:1;text-align:center;padding:8px 2px;font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-mut);border-right:1px solid var(--rule);transition:all .2s;}
.ms-sb-step:last-child{border-right:none;}
.ms-sb-step.done{background:var(--green-p);color:var(--green);}
.ms-sb-step.active{background:var(--market);color:#fff;font-weight:700;}
.ms-step{display:none;}
.ms-step.active{display:block;}
.ms-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px;color:var(--market);}
.ms-step-h{font-family:'Libre Baskerville',serif;font-size:21px;font-weight:700;line-height:1.2;color:var(--blue);}
.ms-step-sub{font-size:13px;color:var(--ink-soft);margin-top:8px;line-height:1.6;}
.ms-field{margin-top:14px;}
.ms-label{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:5px;display:block;}
.ms-input{width:100%;border:1.5px solid var(--rule);border-radius:9px;padding:10px 12px;font-family:'Nunito',sans-serif;font-size:14px;outline:none;color:var(--ink);background:#fff;}
.ms-input:focus{border-color:var(--blue);}
.ms-textarea{resize:vertical;min-height:78px;}
.ms-btn{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;border:none;border-radius:9px;padding:11px 20px;cursor:pointer;}
.ms-btn-primary{background:var(--market);color:#fff;}
.ms-btn-primary:hover{background:var(--green-lt);}
.ms-btn-primary:disabled{opacity:.55;cursor:not-allowed;}
.ms-back{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-mut);background:none;border:none;cursor:pointer;}
.ms-skip{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink-soft);background:none;border:1px solid var(--rule);border-radius:100px;padding:7px 13px;cursor:pointer;}
.ms-nav-row{display:flex;align-items:center;gap:10px;margin-top:18px;padding-top:14px;border-top:1px solid var(--rule);}
.ms-err{font-size:11.5px;color:#8b1a1a;background:#fce8e8;border:1px solid #e8a0a0;border-radius:8px;padding:9px 12px;margin-top:10px;display:none;line-height:1.5;}
.ms-err.show{display:block;}
.ms-note{font-size:10.5px;color:var(--ink-soft);border-radius:8px;padding:9px 11px;margin-top:10px;line-height:1.5;}
.ms-note-m{background:var(--green-vp);border:1px solid var(--green-p);}
.ms-note b{color:var(--ink);}
.ms-occ-search{width:100%;padding:9px 12px;border:1.5px solid var(--rule);border-radius:9px;font-family:'Nunito',sans-serif;font-size:13px;color:var(--ink);background:#fff;outline:none;margin-top:8px;box-sizing:border-box;}
.ms-occ-search:focus{border-color:var(--market);}
.ms-occ-filters{display:flex;gap:5px;margin-top:7px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none;}
.ms-occ-filters::-webkit-scrollbar{display:none;}
.ms-occ-pill{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.05em;text-transform:uppercase;padding:5px 10px;border:1.5px solid var(--rule);border-radius:100px;cursor:pointer;color:var(--ink-soft);background:#fff;white-space:nowrap;transition:all .15s;}
.ms-occ-pill:hover{border-color:var(--market);color:var(--market);}
.ms-occ-pill.on{background:var(--market);color:#fff;border-color:var(--market);}
.ms-occ-list{margin-top:8px;display:flex;flex-direction:column;gap:4px;max-height:220px;overflow-y:auto;}
.ms-occ-row{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1.5px solid var(--rule);border-radius:9px;cursor:pointer;background:#fff;transition:all .15s;}
.ms-occ-row:hover{border-color:var(--market);background:var(--market-tint);}
.ms-occ-row.selected{border-color:var(--market);background:var(--market-pl);}
.ms-occ-name{flex:1;font-size:13px;font-weight:700;color:var(--ink);}
.ms-occ-codes{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);letter-spacing:.03em;}
.ms-occ-sel-btn{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border:1.5px solid var(--market);color:var(--market);background:none;border-radius:7px;cursor:pointer;white-space:nowrap;}
.ms-occ-breakdown{margin-top:10px;border:1.5px solid var(--market);border-radius:11px;padding:12px 14px;background:var(--market-pl);display:none;}
.ms-occ-breakdown.show{display:block;}
.ms-occ-bd-title{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--market);margin-bottom:8px;font-weight:700;}
.ms-occ-bd-row{display:flex;gap:8px;align-items:baseline;margin-bottom:4px;}
.ms-occ-bd-label{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-mut);width:52px;flex-shrink:0;}
.ms-occ-bd-val{font-size:12px;color:var(--ink);font-weight:600;flex:1;}
.ms-occ-bd-tag{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink-mut);margin-left:auto;}
.ms-occ-note{font-size:10px;color:var(--ink-soft);margin-top:8px;padding-top:8px;border-top:1px solid var(--gilt-rul);line-height:1.55;}
.ms-handle-row{display:flex;align-items:center;gap:6px;margin-top:6px;}
.ms-handle-prefix{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-mut);}
.ms-handle-slug{font-family:'JetBrains Mono',monospace;font-size:11.5px;font-weight:700;color:var(--blue);}
.ms-handle-status{font-size:10px;font-weight:700;margin-left:auto;}
.ms-handle-avail{color:var(--green);}
.ms-handle-taken{color:#8b1a1a;}
.ms-word-count{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--ink-mut);text-align:right;margin-top:3px;}
.ms-word-count.warn{color:#c47f00;}
.ms-word-count.over{color:#8b1a1a;}
.ms-port-list{margin-top:10px;display:flex;flex-direction:column;gap:6px;}
.ms-port-item{background:#fff;border:1px solid var(--rule);border-radius:9px;padding:10px 12px;display:flex;align-items:center;gap:8px;}
.ms-port-item-title{font-size:12.5px;font-weight:700;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ms-port-item-type{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-mut);margin-top:2px;}
.ms-port-vis-btn{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.04em;padding:4px 9px;border-radius:100px;cursor:pointer;border:1px solid var(--rule);background:#fff;color:var(--ink-soft);}
.ms-port-vis-btn.pub{border-color:var(--green);color:var(--green);background:var(--green-p);}
.ms-port-del-btn{background:none;border:none;cursor:pointer;color:var(--ink-mut);font-size:13px;padding:3px;}
.ms-port-del-btn:hover{color:#8b1a1a;}
.ms-port-type-toggle{display:flex;border:1px solid var(--rule);border-radius:7px;overflow:hidden;margin-top:12px;}
.ms-ptt-btn{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.05em;padding:7px 12px;border:none;background:#fff;cursor:pointer;color:var(--ink-soft);}
.ms-ptt-btn.on{background:var(--market);color:#fff;}
.ms-port-add-input{flex:1;border:1.5px solid var(--rule);border-radius:7px;padding:8px 11px;font-size:13px;font-family:'Nunito',sans-serif;outline:none;color:var(--ink);}
.ms-port-add-input:focus{border-color:var(--blue);}
.ms-port-add-btn{padding:8px 13px;background:var(--market);color:#fff;border:none;border-radius:7px;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.05em;cursor:pointer;}
#ms-svc-map{height:240px;border-radius:10px;overflow:hidden;margin-bottom:10px;border:1px solid var(--rule);}
.ms-area-toggle{display:flex;gap:6px;margin-bottom:10px;}
.ms-at-btn{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;padding:7px 14px;border:1.5px solid var(--rule);border-radius:100px;cursor:pointer;background:#fff;color:var(--ink-soft);}
.ms-at-btn.on{background:var(--market);color:#fff;border-color:var(--market);}
.ms-mt-btn{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;padding:7px 14px;border:1.5px solid var(--rule);border-radius:100px;cursor:pointer;background:#fff;color:var(--ink-soft);}
.ms-mt-on{background:var(--market)!important;color:#fff!important;border-color:var(--market)!important;}
.ms-complete-card{background:var(--gilt-vp);border:1.5px solid rgba(184,134,11,.22);border-radius:13px;padding:22px 20px;text-align:center;}
.ms-complete-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.15em;text-transform:uppercase;color:var(--gilt);margin-bottom:8px;}
.ms-complete-h{font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;color:var(--blue);margin-bottom:6px;}
.ms-complete-url{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--market);background:var(--green-p);border:1px solid var(--green-p);border-radius:7px;padding:7px 13px;display:inline-block;margin:8px 0;}
.ms-qr-wrap{display:flex;justify-content:center;margin:12px 0;}
.ms-btn-outline{background:none;border:1.5px solid var(--market);color:var(--market);font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.07em;font-weight:700;border-radius:9px;padding:11px 20px;cursor:pointer;width:100%;margin-bottom:7px;}
.ms-btn-outline:hover{background:var(--green-p);}
/* Temple subcategory panel */
.tpl-fhead{padding:14px 16px 10px;border-bottom:1px solid var(--rule);display:flex;align-items:baseline;gap:6px;}
.tpl-fhead-title{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--temple);}
.tpl-fhead-crumb{font-size:13px;color:var(--ink-soft);}
.tpl-empty{padding:40px 24px;font-size:13px;color:var(--ink-mut);text-align:center;}
/* Temple expandable card system */
.tpl-cards{display:flex;flex-direction:column;padding:10px 14px;}
.tpl-card{background:#fff;border:1px solid var(--rule);border-radius:12px;margin-bottom:10px;overflow:hidden;transition:border-color .15s,box-shadow .15s;}
.tpl-card:hover{box-shadow:0 2px 8px rgba(27,58,107,.06);}
.tpl-card.open{border-color:var(--temple);}
.tpl-card-head{padding:13px 14px;cursor:pointer;display:flex;align-items:flex-start;gap:11px;user-select:none;}
.tpl-card-av{width:34px;height:34px;border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:16px;}
.tpl-card-av.guide,.tpl-card-av.fora{background:rgba(27,58,107,.1);}
.tpl-card-av.psa{background:#fdf3e0;}
.tpl-card-av.resource{background:#e8eef8;}
.tpl-card-av.tool{background:#e5f4ea;}
.tpl-card-av.nbr{background:#f5f0e8;}
.tpl-card-av.prog{background:#e5f4ea;}
.tpl-card-main{flex:1;min-width:0;}
.tpl-card-name{font-weight:700;font-size:13px;color:var(--ink);line-height:1.3;}
.tpl-card-short{font-size:12px;color:var(--ink-soft);margin-top:3px;line-height:1.5;}
.tpl-card-badge{font-family:'JetBrains Mono',monospace;font-size:9px;padding:1px 7px;border-radius:999px;margin-top:5px;display:inline-block;letter-spacing:.04em;}
.tpl-card-badge.guide,.tpl-card-badge.fora{background:rgba(27,58,107,.1);color:var(--temple);}
.tpl-card-badge.psa{background:#fdf3e0;color:var(--gilt);}
.tpl-card-badge.resource{background:#e8eef8;color:var(--forum);}
.tpl-card-badge.tool{background:#e5f4ea;color:var(--green);}
.tpl-card-badge.nbr{background:#f5f0e8;color:#8b5e2a;}
.tpl-card-badge.prog{background:#e5f4ea;color:var(--green);}
.tpl-card-chev{font-size:12px;color:var(--ink-mut);margin-left:4px;transition:transform .2s;flex-shrink:0;padding-top:1px;}
.tpl-card.open>.tpl-card-head .tpl-card-chev{transform:rotate(180deg);}
.tpl-card-body{display:none;padding:0 14px 14px;border-top:1px solid var(--rule-soft);}
.tpl-card.open>.tpl-card-body{display:block;}
.tpl-body-text{padding-top:11px;font-size:12.5px;color:var(--ink-soft);line-height:1.65;}
.tpl-body-text ul{margin:6px 0 6px 18px;}
.tpl-body-text li{margin-bottom:3px;}
.tpl-card-links{margin-top:10px;display:flex;flex-direction:column;gap:5px;}
.tpl-card-link{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid var(--rule);border-radius:8px;text-decoration:none;color:var(--ink);font-size:12px;transition:border-color .15s;}
.tpl-card-link:hover{border-color:var(--temple);background:var(--rule-soft);}
/* Reminder widget */
.tpl-reminder{margin-top:12px;background:#f7f9fc;border:1px solid var(--rule);border-radius:10px;padding:11px 13px;}
.tpl-reminder-h{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--temple);margin-bottom:8px;}
.tpl-rem-item{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 0;border-bottom:1px solid var(--rule-soft);}
.tpl-rem-item:last-child{border-bottom:none;}
.tpl-rem-label{font-size:12px;font-weight:600;color:var(--ink);}
.tpl-rem-freq{font-size:11px;color:var(--ink-soft);margin-top:1px;}
.tpl-rem-btn{padding:4px 10px;border-radius:20px;border:1px solid var(--temple);background:#fff;color:var(--temple);font-size:10px;cursor:pointer;font-family:'JetBrains Mono',monospace;white-space:nowrap;flex-shrink:0;}
.tpl-rem-btn:hover{background:var(--temple);color:#fff;}
.tpl-rem-set{padding:4px 10px;border-radius:20px;background:#e5f4ea;color:#2a6e3f;font-size:10px;font-family:'JetBrains Mono',monospace;flex-shrink:0;}
/* PSA sponsor header */
.tpl-psa-hd{display:flex;align-items:center;gap:10px;padding:10px 14px;background:#fdf9ee;border-bottom:1px solid #f0e6c0;}
.tpl-psa-logo{width:34px;height:34px;border-radius:7px;background:var(--gilt);color:#fff;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;text-align:center;line-height:1.2;font-family:'JetBrains Mono',monospace;flex-shrink:0;}
.tpl-psa-org{font-size:12px;font-weight:700;color:var(--ink);}
.tpl-psa-sub{font-size:10px;color:var(--ink-soft);}
.tpl-psa-sponsored{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--ink-mut);letter-spacing:.06em;}
.tpl-psa-edict{font-size:10px;color:var(--ink-mut);margin-top:10px;font-style:italic;line-height:1.5;}
/* Temple conversation */
.tpl-convo{margin-top:14px;border-top:1px solid var(--rule-soft);padding-top:13px;}
.tpl-convo-hd{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--temple);margin-bottom:9px;font-weight:700;}
.tpl-convo-input{width:100%;border:1px solid var(--rule);border-radius:8px;padding:8px 11px;font-family:'Nunito',sans-serif;font-size:13px;resize:none;color:var(--ink);line-height:1.5;margin-bottom:7px;box-sizing:border-box;}
.tpl-convo-input:focus{outline:none;border-color:var(--temple);box-shadow:0 0 0 2px rgba(27,58,107,.06);}
.tpl-convo-foot{display:flex;align-items:center;gap:10px;margin-bottom:11px;}
.tpl-convo-submit{padding:7px 18px;background:var(--temple);color:#fff;border:none;border-radius:999px;font-weight:700;font-size:12.5px;cursor:pointer;font-family:'Nunito',sans-serif;transition:opacity .12s;}
.tpl-convo-submit:hover{opacity:.85;}
.tpl-convo-submit:disabled{opacity:.5;cursor:default;}
.tpl-convo-err{font-size:11.5px;color:var(--scarlet);}
.tpl-convo-empty{font-size:12px;color:var(--ink-mut);padding:4px 0 2px;}
.tpl-convo-item{border:1px solid var(--rule);border-radius:9px;padding:10px 12px;margin-bottom:7px;background:#fff;}
.tpl-convo-meta{display:flex;align-items:center;gap:8px;margin-bottom:5px;}
.tpl-convo-handle{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--temple);font-weight:700;}
.tpl-convo-date{font-size:10px;color:var(--ink-mut);}
.tpl-convo-body{font-size:12.5px;color:var(--ink);line-height:1.55;}

/* MOBILE chrome */
.mtop{display:none;}
.mbar{display:none;}

/* LEFT RAIL */
.brand{display:flex;align-items:center;gap:9px;padding:6px 11px 12px;}
.brand-mark{width:33px;height:33px;border-radius:8px;background:linear-gradient(150deg,var(--blue),var(--blue-md));display:flex;align-items:center;justify-content:center;color:var(--gilt-lt);font-family:'Libre Baskerville',serif;font-weight:700;font-size:18px;box-shadow:inset 0 0 0 1px rgba(212,168,50,.35);}
.brand-word{font-family:'Libre Baskerville',serif;font-weight:700;font-size:20px;color:var(--blue);}
.nav-home{display:flex;align-items:center;gap:13px;padding:10px 13px;border-radius:999px;font-weight:800;font-size:16px;color:var(--blue);background:var(--blue-vp);cursor:pointer;}
.nav-home .ni{width:22px;text-align:center;color:var(--gilt);}

.pillar-h{display:flex;align-items:center;gap:8px;padding:13px 13px 4px;}
.pg{font-size:14px;width:17px;text-align:center;}
.pg-t{color:var(--temple);}.pg-f{color:var(--forum);}.pg-m{color:var(--market);}
.pn{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-mut);}
.tools{padding-left:7px;border-left:2px solid var(--rule);margin-left:20px;}
.tools.t{border-color:var(--gilt-pl);}.tools.f{border-color:var(--blue-pl);}.tools.m{border-color:var(--green-p);}
.tool{display:flex;align-items:center;gap:10px;padding:7px 12px;border-radius:999px;font-weight:600;font-size:14px;cursor:pointer;color:var(--ink-soft);}
.tool:hover{background:var(--rule-soft);}
.tool.active{background:var(--blue-vp);color:var(--blue);font-weight:800;}
.tool.active .ti{color:var(--gilt);}
.tool .ti{width:16px;text-align:center;color:var(--ink-soft);font-size:13px;flex:none;}
.tool .bdg{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:8px;background:var(--scarlet);color:#fff;border-radius:999px;padding:1px 6px;}

/* Market left-nav accordion */
.mkt-nav{margin-left:20px;border-left:2px solid var(--green-p);padding-left:7px;}
.mkt-dom-h{display:flex;align-items:center;gap:7px;padding:7px 10px 7px 5px;color:var(--ink-soft);font-size:13px;font-weight:600;cursor:pointer;user-select:none;border-radius:8px;}
.mkt-dom-h:hover{background:var(--rule-soft);color:var(--ink);}
.mkt-dom-h.on{color:var(--market);}
.mkt-dom-icon{font-size:13px;flex-shrink:0;width:16px;text-align:center;}
.mkt-dom-label{flex:1;}
.mkt-chev{font-size:10px;color:var(--ink-mut);transition:transform .15s;flex-shrink:0;}
.mkt-dom-h.open .mkt-chev{transform:rotate(180deg);}
.mkt-sub-list{display:none;padding-bottom:2px;}
.mkt-sub-list.open{display:block;}
.mkt-sub{padding:4px 8px 4px 28px;font-size:12px;color:var(--ink-soft);cursor:pointer;border-left:2px solid transparent;border-radius:0 6px 6px 0;}
.mkt-sub:hover{color:var(--ink);background:var(--rule-soft);}
.mkt-sub.on{color:var(--market);font-weight:700;border-left-color:var(--market);}

/* Temple left-nav accordion */
.tpl-nav{margin-left:20px;border-left:2px solid var(--gilt-pl);padding-left:7px;}
.tpl-dom-h{display:flex;align-items:center;gap:7px;padding:7px 10px 7px 5px;color:var(--ink-soft);font-size:13px;font-weight:600;cursor:pointer;user-select:none;border-radius:8px;}
.tpl-dom-h:hover{background:var(--rule-soft);color:var(--ink);}
.tpl-dom-h.on{color:var(--temple);}
.tpl-dom-icon{font-size:13px;flex-shrink:0;width:16px;text-align:center;}
.tpl-dom-label{flex:1;}
.tpl-chev{font-size:10px;color:var(--ink-mut);transition:transform .15s;flex-shrink:0;}
.tpl-dom-h.open .tpl-chev{transform:rotate(180deg);}
.tpl-sub-list{display:none;padding-bottom:2px;}
.tpl-sub-list.open{display:block;}
.tpl-sub{padding:4px 8px 4px 28px;font-size:12px;color:var(--ink-soft);cursor:pointer;border-left:2px solid transparent;border-radius:0 6px 6px 0;}
.tpl-sub:hover{color:var(--ink);background:var(--rule-soft);}
.tpl-sub.on{color:var(--temple);font-weight:700;border-left-color:var(--temple);}

/* Forum left-nav accordion */
.frm-nav{margin-left:20px;border-left:2px solid var(--blue-pl);padding-left:7px;}
.frm-dom-h{display:flex;align-items:center;gap:7px;padding:7px 10px 7px 5px;color:var(--ink-soft);font-size:13px;font-weight:600;cursor:pointer;user-select:none;border-radius:8px;}
.frm-dom-h:hover{background:var(--rule-soft);color:var(--ink);}
.frm-dom-h.on{color:var(--forum);}
.frm-dom-icon{font-size:13px;flex-shrink:0;width:16px;text-align:center;}
.frm-dom-label{flex:1;}
.frm-chev{font-size:10px;color:var(--ink-mut);transition:transform .15s;flex-shrink:0;}
.frm-dom-h.open .frm-chev{transform:rotate(180deg);}
.frm-sub-list{display:none;padding-bottom:2px;}
.frm-sub-list.open{display:block;}
.frm-sub{padding:4px 8px 4px 28px;font-size:12px;color:var(--ink-soft);cursor:pointer;border-left:2px solid transparent;border-radius:0 6px 6px 0;}
.frm-sub:hover{color:var(--ink);background:var(--rule-soft);}
.frm-sub.on{color:var(--forum);font-weight:700;border-left-color:var(--forum);}
.frm-gov-sub{padding-left:28px !important;}
#frm-leg-domains>.frm-dom-h{padding-left:14px;}
#frm-leg-domains .frm-sub-list .frm-sub{padding-left:44px;}

/* Forum legislation panel */
.frm-fhead{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-bottom:2px solid var(--forum);padding:13px 18px 10px;}
.frm-fhead-title{font-family:'Libre Baskerville',serif;font-weight:700;font-size:20px;color:var(--forum);}
.frm-fhead-crumb{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-soft);margin-top:3px;}
.frm-jur-row{display:flex;gap:6px;padding:9px 16px 8px;border-bottom:1px solid var(--rule-soft);flex-wrap:wrap;background:#fff;}
.frm-jchip{padding:3px 11px;border-radius:20px;border:1px solid var(--rule);background:#fff;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.07em;cursor:pointer;color:var(--ink-soft);transition:all .15s;user-select:none;}
.frm-jchip:hover{border-color:var(--ink-soft);}
.frm-jchip.on{color:#fff;border-color:transparent;}
.frm-jchip[data-jur="all"].on{background:var(--forum);}
.frm-jchip[data-jur="federal"].on{background:#B22234;}
.frm-jchip[data-jur="pennsylvania"].on{background:#003087;}
.frm-jchip[data-jur="philadelphia"].on{background:#004C54;}
.frm-grid{display:flex;flex-direction:column;padding:12px 18px;}
.frm-bill{background:#fff;border:1px solid var(--rule);border-radius:12px;margin-bottom:10px;padding:14px 16px;transition:border-color .15s,box-shadow .15s;}
.frm-bill:hover{border-color:var(--blue-pl);box-shadow:0 2px 8px rgba(27,58,107,.08);}
.frm-bill-top{display:flex;align-items:center;gap:8px;margin-bottom:7px;flex-wrap:wrap;}
.frm-bill-num{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.06em;background:var(--blue-pl);color:var(--forum);padding:2px 8px;border-radius:999px;font-weight:700;}
.frm-tracker{display:flex;align-items:center;margin-left:auto;}
.frm-ts{font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:500;padding:3px 8px;border-top:0.5px solid var(--rule);border-bottom:0.5px solid var(--rule);border-right:0.5px solid var(--rule);color:var(--ink-soft);background:#fafafa;white-space:nowrap;line-height:1.4;}
.frm-ts:first-child{border-left:0.5px solid var(--rule);border-radius:4px 0 0 4px;}
.frm-ts:last-child{border-radius:0 4px 4px 0;}
.frm-ts.done{background:#E1F5EE;color:#0F6E56;border-color:#5DCAA5;}
.frm-ts.active{background:var(--forum);color:#fff;border-color:var(--forum);}
.frm-ts.enacted{background:var(--gilt);color:#fff;border-color:var(--gilt);}
.frm-ts.vetoed{background:#FAECE7;color:#993C1D;border-color:#D85A30;}
.frm-bill-status{font-family:'JetBrains Mono',monospace;font-size:9px;padding:2px 8px;border-radius:999px;border:1px solid var(--rule);color:var(--ink-soft);}
.frm-bill-status.signed,.frm-bill-status.passed{background:#e5f0e8;color:var(--green);border-color:var(--green-p);}
.frm-bill-status.pending{background:var(--amber-p);color:var(--amber);border-color:#ffe08a;}
.frm-bill-name{font-weight:700;font-size:14px;color:var(--ink);line-height:1.3;margin-bottom:3px;}
.frm-bill-type{font-size:12px;color:var(--ink-soft);margin-bottom:6px;}
.frm-bill-desc{font-size:12.5px;color:var(--ink-soft);line-height:1.55;}
.frm-bill-link{margin-top:8px;font-family:'JetBrains Mono',monospace;font-size:11px;}
.frm-bill-link a{color:var(--forum);}
.frm-bill-link a:hover{text-decoration:underline;}
.frm-expand-cue{margin-top:10px;padding:7px 12px;border-top:1px dashed var(--blue-pl);display:flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--forum);font-weight:700;}
.frm-bill:hover .frm-expand-cue{color:var(--blue-md);}
.frm-empty-state{color:var(--ink-soft);font-size:13px;padding:56px 24px;text-align:center;line-height:1.7;}

/* Forum bill card actions */
.frm-bill-actions{display:flex;align-items:center;gap:8px;margin-top:11px;flex-wrap:wrap;}
.frm-action-btn{display:inline-flex;align-items:center;gap:5px;padding:5px 13px;border:1px solid var(--rule);border-radius:999px;background:#fff;color:var(--ink-soft);font-size:12px;font-weight:600;cursor:pointer;font-family:'Nunito',sans-serif;transition:background .12s,color .12s,border-color .12s;}
.frm-action-btn:hover{background:var(--blue-vp);color:var(--forum);border-color:var(--blue-pl);}
.frm-action-btn .ti{font-size:13px;}
.frm-share-wrap{position:relative;}
.frm-share-menu{position:absolute;left:0;top:calc(100% + 5px);background:#fff;border:1px solid var(--rule);border-radius:10px;box-shadow:0 4px 18px rgba(0,0,0,.11);z-index:30;min-width:175px;padding:4px 0;overflow:hidden;}
.frm-share-item{display:flex;align-items:center;gap:10px;padding:9px 16px;font-size:13px;color:var(--ink);cursor:pointer;border:none;background:transparent;width:100%;text-align:left;font-family:'Nunito',sans-serif;text-decoration:none;}
.frm-share-item:hover{background:var(--rule-soft);}
.frm-share-item .ti{font-size:14px;width:16px;color:var(--ink-soft);}

/* Forum comment area */
.frm-comment-area{margin-top:11px;padding-top:11px;border-top:1px solid var(--rule);}
.frm-comment-list{margin-bottom:10px;}
.frm-comment-item{padding:8px 0 7px;border-bottom:1px solid var(--rule-soft);}
.frm-comment-item:last-child{border-bottom:none;}
.frm-ci-meta{display:flex;align-items:center;gap:8px;margin-bottom:3px;}
.frm-ci-handle{font-weight:700;font-size:12px;color:var(--forum);}
.frm-ci-date{font-size:11px;color:var(--ink-mut);font-family:'JetBrains Mono',monospace;}
.frm-ci-body{font-size:13px;color:var(--ink);line-height:1.5;}
.frm-no-comments,.frm-comment-loading{font-size:12px;color:var(--ink-mut);padding:5px 0;font-style:italic;}
.frm-comment-form{display:flex;gap:8px;align-items:flex-start;margin-top:2px;}
.frm-comment-input{flex:1;border:1px solid var(--rule);border-radius:8px;padding:7px 10px;font-size:13px;font-family:'Nunito',sans-serif;resize:none;color:var(--ink);line-height:1.45;}
.frm-comment-input:focus{outline:none;border-color:var(--forum);box-shadow:0 0 0 2px rgba(27,58,107,.08);}
.frm-comment-submit{padding:7px 16px;background:var(--forum);color:#fff;border:none;border-radius:999px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Nunito',sans-serif;white-space:nowrap;transition:background .12s;}
.frm-comment-submit:hover{background:var(--blue-md);}

/* Forum bill detail panel */
.frm-detail-head{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-bottom:2px solid var(--forum);padding:11px 16px;display:flex;align-items:center;gap:10px;}
.frm-detail-back{font-size:13px;font-weight:700;color:var(--forum);cursor:pointer;background:none;border:none;padding:4px 10px;border-radius:6px;font-family:'Nunito',sans-serif;display:flex;align-items:center;gap:5px;}
.frm-detail-back:hover{background:var(--blue-vp);}
.frm-detail-title{flex:1;font-family:'Libre Baskerville',serif;font-weight:700;font-size:17px;color:var(--forum);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.frm-detail-body{padding:14px 18px 24px;}
.frm-detail-meta{display:flex;align-items:center;gap:7px;margin-bottom:8px;flex-wrap:wrap;}
.frm-detail-desc{font-size:13.5px;color:var(--ink-soft);line-height:1.6;margin-bottom:16px;}
/* Metrics bar */
.frm-metrics{background:var(--blue-vp);border-radius:12px;padding:13px 15px;margin-bottom:16px;}
.frm-metrics-title{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:10px;}
.frm-bar-wrap{display:flex;height:11px;border-radius:6px;overflow:hidden;margin-bottom:9px;background:var(--rule);}
.frm-bar-seg{height:100%;transition:width .4s ease;min-width:0;}
.frm-seg-support{background:#2a9d5c;}.frm-seg-oppose{background:var(--scarlet);}
.frm-seg-side_effect{background:var(--amber);}.frm-seg-unforeseen{background:#8b5cf6;}
.frm-seg-error_omission{background:#e76f51;}.frm-seg-general{background:var(--ink-mut);}
.frm-legend-row{display:flex;gap:10px;flex-wrap:wrap;}
.frm-leg-item{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--ink-soft);}
.frm-leg-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
.frm-leg-ct{font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;color:var(--ink);}
/* Add perspective form */
.frm-add-persp{border:1px solid var(--blue-pl);border-radius:12px;padding:14px 16px;margin-bottom:16px;background:#fff;}
.frm-add-title{font-weight:800;font-size:13px;color:var(--forum);margin-bottom:10px;}
.frm-persp-chips{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:10px;}
.frm-pchip{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.05em;padding:5px 10px;border-radius:999px;border:1px solid var(--rule);color:var(--ink-soft);cursor:pointer;background:#fff;transition:background .12s,color .12s,border-color .12s;}
.frm-pchip.on[data-p="general"]{background:var(--rule-soft);color:var(--ink);border-color:var(--rule);}
.frm-pchip.on[data-p="support"]{background:#e5f8ed;color:#1d6e3b;border-color:#7dcfa0;}
.frm-pchip.on[data-p="oppose"]{background:var(--scarlet-p);color:var(--scarlet);border-color:#e8a0a0;}
.frm-pchip.on[data-p="side_effect"]{background:var(--amber-p);color:var(--amber);border-color:#ffe08a;}
.frm-pchip.on[data-p="unforeseen"]{background:#f3efff;color:#6d28d9;border-color:#c4b5fd;}
.frm-pchip.on[data-p="error_omission"]{background:#fff0ec;color:#c2410c;border-color:#fdba74;}
.frm-persp-body{width:100%;border:1px solid var(--rule);border-radius:8px;padding:8px 11px;font-family:'Nunito',sans-serif;font-size:13px;resize:none;color:var(--ink);line-height:1.5;margin-bottom:8px;}
.frm-persp-body:focus{outline:none;border-color:var(--forum);box-shadow:0 0 0 2px rgba(27,58,107,.07);}
.frm-social-url{width:100%;border:1px solid var(--rule);border-radius:8px;padding:7px 11px;font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);margin-bottom:9px;outline:none;}
.frm-social-url:focus{border-color:var(--forum);}
.frm-persp-foot{display:flex;align-items:center;gap:10px;}
.frm-persp-submit{padding:8px 22px;background:var(--forum);color:#fff;border:none;border-radius:999px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Nunito',sans-serif;transition:background .12s;}
.frm-persp-submit:hover{background:var(--blue-md);}
.frm-persp-hint{font-size:11px;color:var(--ink-mut);}
/* Perspectives list */
.frm-perspectives-hd{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mut);margin:0 0 11px;}
.frm-persp-item{border:1px solid var(--rule);border-radius:10px;padding:12px 14px;margin-bottom:9px;background:#fff;}
.frm-pi-top{display:flex;align-items:center;gap:7px;margin-bottom:7px;flex-wrap:wrap;}
.frm-pi-badge{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.06em;padding:3px 9px;border-radius:999px;font-weight:700;}
.frm-pi-support{background:#e5f8ed;color:#1d6e3b;}
.frm-pi-oppose{background:var(--scarlet-p);color:var(--scarlet);}
.frm-pi-side_effect{background:var(--amber-p);color:var(--amber);}
.frm-pi-unforeseen{background:#f3efff;color:#6d28d9;}
.frm-pi-error_omission{background:#fff0ec;color:#c2410c;}
.frm-pi-general{background:var(--rule-soft);color:var(--ink-soft);}
.frm-pi-handle{font-weight:700;font-size:12px;color:var(--forum);}
.frm-pi-date{font-size:10.5px;color:var(--ink-mut);font-family:'JetBrains Mono',monospace;margin-left:auto;}
.frm-pi-body{font-size:13px;color:var(--ink);line-height:1.55;}
.frm-pi-embed{margin-top:9px;border-radius:8px;overflow:hidden;}
.frm-pi-embed img{max-width:100%;border-radius:8px;display:block;}
.frm-pi-embed iframe{border-radius:8px;display:block;}
.frm-pi-link{display:inline-flex;align-items:center;gap:6px;margin-top:9px;font-size:12px;color:var(--forum);border:1px solid var(--blue-pl);border-radius:999px;padding:4px 12px;background:var(--blue-vp);text-decoration:none;}
.frm-pi-link:hover{background:var(--blue-pl);}
.frm-no-persp{font-size:13px;color:var(--ink-mut);padding:20px 0;text-align:center;font-style:italic;}

/* Market center panel */
.mkt-fhead{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--rule);padding:13px 18px 10px;}
.mkt-fhead-title{font-family:'Libre Baskerville',serif;font-weight:700;font-size:20px;color:var(--market);}
.mkt-fhead-crumb{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-soft);margin-top:3px;display:none;}
.mkt-grid{display:flex;flex-direction:column;padding:12px 18px;}
.mkt-empty-state{color:var(--ink-soft);font-size:13px;padding:56px 24px;text-align:center;line-height:1.7;}
/* Expand for Conversation cue on market cards */
.mkt-expand-cue{margin-top:10px;padding:7px 0 0;border-top:1px dashed #e5e5e5;display:flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--market);font-weight:700;}
.listing:hover .mkt-expand-cue{color:#0e4823;}
/* Market listing detail panel */
.mkt-detail-head{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-bottom:2px solid var(--market);padding:11px 16px;display:flex;align-items:center;gap:10px;}
.mkt-detail-back{font-size:13px;font-weight:700;color:var(--market);cursor:pointer;background:none;border:none;padding:4px 10px;border-radius:6px;font-family:'Nunito',sans-serif;display:flex;align-items:center;gap:5px;}
.mkt-detail-back:hover{background:var(--green-p);}
.mkt-detail-title{flex:1;font-family:'Libre Baskerville',serif;font-weight:700;font-size:17px;color:var(--market);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mkt-detail-body{padding:0 0 32px;}
.mkt-detail-hero{padding:18px 18px 14px;border-bottom:1px solid var(--rule);}
.mkt-hero-top{display:flex;gap:14px;align-items:flex-start;margin-bottom:10px;}
.mkt-hero-avatar{width:62px;height:62px;border-radius:14px;font-size:20px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;}
.mkt-hero-main{flex:1;min-width:0;}
.mkt-hero-name{font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;color:var(--ink);line-height:1.2;margin-bottom:5px;}
.mkt-hero-badges{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:6px;}
.mkt-hero-rating{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-soft);margin-bottom:4px;}
.mkt-hero-stars{color:#f5a623;font-size:13px;}
.mkt-hero-meta{font-size:12.5px;color:var(--ink-soft);display:flex;gap:10px;flex-wrap:wrap;}
.mkt-detail-desc{padding:14px 18px;font-size:13.5px;color:var(--ink);line-height:1.65;border-bottom:1px solid var(--rule);}
.mkt-detail-tags{display:flex;gap:5px;flex-wrap:wrap;padding:11px 18px;border-bottom:1px solid var(--rule);}
.mkt-detail-actions{display:flex;gap:8px;padding:12px 18px;border-bottom:1px solid var(--rule);}
.mkt-da-btn{padding:9px 20px;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;font-family:'Nunito',sans-serif;border:none;}
.mkt-da-primary{background:var(--market);color:#fff;}
.mkt-da-primary:hover{background:#0e4823;}
.mkt-da-sec{background:var(--green-p);color:var(--market);border:1px solid #bfe0cb!important;}
.mkt-detail-section{padding:14px 18px;border-bottom:1px solid var(--rule);}
.mkt-detail-section-h{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:11px;}
.mkt-review-item{display:flex;gap:10px;margin-bottom:12px;}
.mkt-review-av{width:34px;height:34px;border-radius:50%;background:var(--green-p);border:1px solid var(--market);color:var(--market);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.mkt-review-who{font-size:12px;font-weight:700;color:var(--ink);display:flex;align-items:center;gap:5px;margin-bottom:2px;}
.mkt-review-text{font-size:12.5px;color:var(--ink-soft);line-height:1.5;}
.mkt-review-verified{font-size:9px;color:#2a9d5c;font-family:'JetBrains Mono',monospace;letter-spacing:.04em;}
/* Conversation in detail panel */
.mkt-convo-form{display:flex;flex-direction:column;gap:8px;margin-bottom:14px;}
.mkt-convo-input{border:1px solid var(--rule);border-radius:8px;padding:9px 12px;font-family:'Nunito',sans-serif;font-size:13px;resize:none;color:var(--ink);line-height:1.5;}
.mkt-convo-input:focus{outline:none;border-color:var(--market);}
.mkt-convo-submit{align-self:flex-end;padding:8px 20px;background:var(--market);color:#fff;border:none;border-radius:999px;font-weight:700;font-size:13px;cursor:pointer;font-family:'Nunito',sans-serif;}
.mkt-convo-submit:hover{background:#0e4823;}
.mkt-convo-item{padding:9px 0 8px;border-bottom:1px solid var(--rule-soft);}
.mkt-convo-item:last-child{border-bottom:none;}
.mkt-convo-meta{display:flex;align-items:center;gap:8px;margin-bottom:3px;}
.mkt-convo-handle{font-weight:700;font-size:12px;color:var(--market);}
.mkt-convo-date{font-size:10.5px;color:var(--ink-mut);font-family:'JetBrains Mono',monospace;}
.mkt-convo-body{font-size:13px;color:var(--ink);line-height:1.5;}
.mkt-convo-empty{font-size:12.5px;color:var(--ink-mut);padding:8px 0;font-style:italic;}
/* category header above listings */
.mkt-cat-header{padding:10px 18px 6px;font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:var(--ink);}
.mkt-cat-sub{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin-top:1px;}
/* sponsored PSA card */
.sponsored-post{background:#fff;border:0.5px solid #e5e5e5;border-radius:12px;margin-bottom:10px;overflow:hidden;}
.sponsored-header{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 0;}
.sponsored-who{display:flex;align-items:center;gap:10px;}
.sponsored-logo{width:38px;height:38px;border-radius:6px;background:#ff6800;color:#fff;font-size:8px;font-weight:700;font-family:monospace;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.2;letter-spacing:.03em;}
.sponsored-name{font-size:13px;font-weight:700;color:#111;}
.sponsored-label{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.08em;color:#999;border:0.5px solid #e5e5e5;padding:2px 6px;border-radius:4px;}
.psa-body{padding:10px 16px 14px;font-size:12.5px;color:#555;line-height:1.6;border-left:3px solid #ff6800;margin:10px 16px 0;border-radius:0;}
.psa-body strong{color:#111;}
.psa-cta{display:flex;align-items:center;gap:6px;margin:10px 16px 14px;font-size:12px;color:#1b3a6b;font-weight:600;cursor:pointer;text-decoration:none;}
.psa-edict{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.04em;color:#aaa;padding:8px 16px;border-top:0.5px solid #eee;background:#f8f8f7;}
/* Deutsche Bank Oasis Index sponsored card */
.db-oasis-card .sponsored-logo{background:#003b8e;font-size:11px;font-weight:900;letter-spacing:.02em;font-family:serif;}
.db-oasis-cols{display:grid;grid-template-columns:1fr 1fr;gap:0;margin:12px 16px 0;border-radius:8px;overflow:hidden;border:0.5px solid #e8e8e8;}
.db-col{padding:10px 12px;}
.db-col-hi{background:#fff8f5;}
.db-col-lo{background:#f3f9f5;border-left:0.5px solid #e8e8e8;}
.db-col-h{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;margin-bottom:8px;padding-bottom:6px;border-bottom:0.5px solid #e8e8e8;}
.db-col-hi .db-col-h{color:#b03030;}
.db-col-lo .db-col-h{color:#155c2d;}
.db-oasis-row{display:flex;align-items:center;gap:5px;padding:3px 0;border-bottom:0.5px solid #f0f0f0;}
.db-oasis-row:last-child{border-bottom:none;}
.db-rank{font-family:'JetBrains Mono',monospace;font-size:9px;color:#bbb;width:10px;flex-shrink:0;text-align:right;}
.db-flag{font-size:13px;flex-shrink:0;line-height:1;}
.db-country{font-size:11px;font-weight:600;color:#222;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.db-dots{font-family:'JetBrains Mono',monospace;font-size:9px;flex-shrink:0;letter-spacing:-1px;}
.db-col-hi .db-dots{color:#b03030;}
.db-col-lo .db-dots{color:#155c2d;}
.db-expand-btn{display:flex;align-items:center;gap:6px;width:calc(100% - 32px);margin:10px 16px 0;padding:9px 14px;background:#f5f7fa;border:0.5px solid #dde5f5;border-radius:8px;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.04em;font-weight:700;color:#1b3a6b;cursor:pointer;text-align:left;transition:background .12s;}
.db-expand-btn:hover{background:#dde5f5;}
.db-expand-btn.open{border-bottom-left-radius:0;border-bottom-right-radius:0;border-bottom-color:transparent;}
.db-detail{display:none;margin:0 16px;padding:14px 16px;background:#f5f7fa;border:0.5px solid #dde5f5;border-top:none;border-bottom-left-radius:8px;border-bottom-right-radius:8px;}
.db-detail-h{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:#1b3a6b;margin-bottom:10px;}
.db-detail p{font-size:12px;color:#444;line-height:1.65;margin-bottom:8px;}
.db-detail p:last-child{margin-bottom:0;}
.db-you-bar{display:flex;align-items:center;gap:10px;background:#fff;border:0.5px solid #dde5f5;border-radius:8px;padding:10px 12px;margin-bottom:10px;}
.db-you-flag{font-size:20px;flex-shrink:0;}
.db-you-info{flex:1;min-width:0;}
.db-you-label{font-size:11px;font-weight:700;color:#1b3a6b;}
.db-you-rank{font-family:'JetBrains Mono',monospace;font-size:9px;color:#888;margin-top:2px;}
.db-track{width:80px;height:6px;background:#e0e8f0;border-radius:3px;overflow:hidden;flex-shrink:0;}
.db-track-fill{height:100%;background:linear-gradient(90deg,#155c2d 0%,#b8860b 50%,#b03030 100%);border-radius:3px;}
.db-convo{margin:12px 16px 0;padding:12px;background:#f9f9f9;border-radius:8px;border:0.5px solid #eee;}
.db-convo-h{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:#aaa;margin-bottom:8px;}
.db-comment-list{max-height:160px;overflow-y:auto;margin-bottom:8px;}
.db-comment{display:flex;gap:8px;margin-bottom:6px;}
.db-comment:last-child{margin-bottom:0;}
.db-comment-av{width:24px;height:24px;border-radius:50%;background:#1b3a6b;color:#fff;font-size:8px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;}
.db-comment-body{flex:1;background:#fff;border-radius:0 8px 8px 8px;padding:6px 10px;border:0.5px solid #eee;}
.db-comment-who{font-size:10px;font-weight:700;color:#1b3a6b;}
.db-comment-text{font-size:12px;color:#444;margin-top:2px;line-height:1.5;}
.db-comment-input-row{display:flex;gap:6px;}
.db-comment-input-row input{flex:1;border:0.5px solid #dde5f5;border-radius:8px;padding:8px 11px;font-size:12px;font-family:'Nunito',sans-serif;outline:none;background:#fff;}
.db-comment-input-row input:focus{border-color:#1b3a6b;}
.db-comment-input-row button{padding:8px 14px;background:#1b3a6b;color:#fff;border:none;border-radius:8px;font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;cursor:pointer;}
.db-comment-input-row button:hover{background:#254f92;}
.db-share-row{display:flex;align-items:center;justify-content:flex-end;padding:8px 16px 4px;position:relative;}
.db-share-btn{display:flex;align-items:center;gap:5px;padding:6px 12px;border:0.5px solid #e5e5e5;border-radius:7px;background:#fff;font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:#555;cursor:pointer;}
.db-share-btn:hover{background:#f5f5f5;}
.db-oasis-card .lshare-menu{top:auto;bottom:calc(100% + 4px);right:16px;}
/* listing card — matches /market/square */
.listing{background:#fff;border:0.5px solid #e5e5e5;border-radius:12px;padding:15px 17px;margin-bottom:10px;cursor:pointer;transition:border-color .12s;position:relative;}
.lshare-btn{position:absolute;top:10px;right:10px;width:28px;height:28px;border-radius:6px;border:0.5px solid #e5e5e5;background:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;color:#999;transition:background .12s,color .12s;}
.lshare-btn:hover{background:#f0f0f0;color:#1b3a6b;}
.lshare-menu{display:none;position:absolute;top:42px;right:10px;z-index:20;background:#fff;border:0.5px solid #e5e5e5;border-radius:9px;box-shadow:0 4px 18px rgba(0,0,0,.12);min-width:160px;overflow:hidden;}
.lshare-menu.open{display:block;}
.lshare-item{display:flex;align-items:center;gap:8px;padding:9px 14px;font-size:12.5px;color:#111;cursor:pointer;text-decoration:none;border-bottom:0.5px solid #f0f0f0;}
.lshare-item:last-child{border-bottom:none;}
.lshare-item:hover{background:#f5f5f5;}
.listing-url{display:inline-flex;align-items:center;gap:5px;margin-top:6px;font-size:11.5px;color:#1b3a6b;text-decoration:none;font-weight:600;}
.listing-url:hover{text-decoration:underline;}
.listing:hover{border-color:#1b3a6b;}
.listing-top{display:flex;gap:12px;align-items:flex-start;}
.listing-avatar{width:46px;height:46px;border-radius:50%;font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;}
.av-biz{background:#e8f0fb;color:#1b3a6b;border:2px solid #1b3a6b;}
.av-neighbor{background:#e8f3eb;color:#2a6e3f;border:2px solid #4caf72;}
.av-community{background:#fef3e2;color:#b8860b;border:2px solid #b8860b;}
.vet-bar{position:absolute;bottom:-4px;left:50%;transform:translateX(-50%);background:#3b5323;color:#fff;font-size:6px;font-weight:700;letter-spacing:.04em;padding:1px 5px;border-radius:3px;white-space:nowrap;font-family:monospace;}
.listing-main{flex:1;min-width:0;}
.listing-name-row{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:3px;}
.listing-name{font-size:14.5px;font-weight:700;color:#1b3a6b;}
.lbdg{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.06em;padding:2px 6px;border-radius:4px;font-weight:700;text-transform:uppercase;}
.lbdg-biz{background:#e8f0fb;color:#1b3a6b;}
.lbdg-neighbor{background:#e8f3eb;color:#2a6e3f;}
.lbdg-community{background:#fef3e2;color:#9a6f00;}
.lbdg-prog{background:var(--green-p);color:var(--market);}
.lbdg-fora{background:#f5f5f7;color:#666;}
.lbdg-cleared{background:#eef7f0;color:#1d6e3b;border:0.5px solid #7dcfa0;}
.listing-meta{font-size:11.5px;color:#666;display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:5px;}
.lrating{display:flex;align-items:center;gap:3px;font-weight:600;color:#111;font-size:12px;}
.star-ic{color:#f5a623;}
.social-proof-row{font-size:11.5px;color:#2a6e3f;font-weight:600;display:flex;align-items:center;gap:4px;margin-bottom:6px;}
.listing-desc{font-size:12.5px;color:#555;line-height:1.5;margin-bottom:7px;}
.tag-row{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:8px;}
.ltag{font-size:11px;background:#f8f8f7;border:0.5px solid #e5e5e5;color:#666;padding:2px 8px;border-radius:20px;}
.listing-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap;}
.lact-btn{font-size:11.5px;padding:5px 13px;border-radius:6px;border:0.5px solid #ccc;background:#f8f8f7;color:#111;cursor:pointer;display:flex;align-items:center;gap:5px;font-family:'Nunito',sans-serif;}
.lact-btn.primary{background:#1b3a6b;color:#fff;border-color:#1b3a6b;}
.lreviews-toggle{display:flex;align-items:center;gap:5px;margin-top:8px;font-size:11.5px;color:#999;cursor:pointer;padding:0;background:none;border:none;font-family:'Nunito',sans-serif;}
.lrev-chev{font-size:11px;transition:transform .2s;display:inline-block;}
.lreviews-toggle.open .lrev-chev{transform:rotate(180deg);}
.top-comment{margin-top:6px;padding:6px 10px;background:#f8f8f7;border-radius:7px;font-size:11.5px;color:#666;border:0.5px solid #eee;}
.top-comment-who{font-size:10.5px;font-weight:600;color:#111;margin-bottom:2px;display:flex;align-items:center;gap:4px;}
.lrev-expand{display:none;margin-top:10px;border-top:0.5px solid #eee;padding-top:10px;}
.lrev-expand.open{display:block;}
.lcomment-row{display:flex;gap:9px;margin-bottom:10px;}
.lcomment-av{width:28px;height:28px;border-radius:50%;background:#f0f0ee;border:0.5px solid #e5e5e5;color:#666;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.lcomment-who{font-size:11px;font-weight:600;color:#111;display:flex;align-items:center;gap:4px;margin-bottom:2px;}
.lcomment-text{font-size:11.5px;color:#555;line-height:1.45;}
.listing-related{font-size:11px;color:#1b3a6b;margin-top:8px;padding-top:6px;border-top:0.5px solid #eee;}
.listing-related a{color:#1b3a6b;font-weight:600;text-decoration:underline;text-decoration-color:rgba(27,58,107,.3);}

.voice{margin:14px 7px 6px;padding:12px;border:none;border-radius:999px;width:calc(100% - 14px);background:var(--gilt);color:#fff;font-weight:800;font-size:15px;cursor:pointer;box-shadow:0 2px 0 rgba(120,86,8,.45);}
.voice:hover{background:var(--gilt-lt);}
.id-block{margin-top:auto;display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:999px;cursor:pointer;}
.id-block:hover{background:var(--blue-pl);}
.id-av{width:38px;height:38px;border-radius:50%;background:var(--green);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;flex:none;font-size:15px;}
.id-n{font-weight:800;font-size:13.5px;line-height:1.15;}
.id-h{color:var(--ink-mut);font-size:12px;}

/* CENTER */
.fhead{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--rule);}
.ftitle{padding:13px 18px 9px;font-family:'Libre Baskerville',serif;font-weight:700;font-size:20px;color:var(--blue);}
.dash-search{display:flex;gap:8px;padding:10px 16px;border-bottom:1px solid var(--rule);position:sticky;top:0;z-index:6;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);}
.dash-search-input{flex:1;padding:9px 13px;border:1px solid var(--rule);border-radius:8px;font-family:'Nunito',sans-serif;font-size:14px;color:var(--ink);outline:none;background:#fff;}
.dash-search-input::placeholder{color:var(--ink-soft);}
.dash-search-input:focus{border-color:var(--blue);}
.dash-search-loc{width:180px;flex-shrink:0;padding:9px 13px;border:1px solid var(--rule);border-radius:8px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ink-soft);background:#fafafa;outline:none;text-overflow:ellipsis;white-space:nowrap;overflow:hidden;cursor:text;}
.dash-search-loc:focus{border-color:var(--blue);color:var(--ink);background:#fff;}
.dash-search-go{width:44px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--blue);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:17px;}
.dash-search-go:hover{background:#122d55;}
.dash-search-new{flex-shrink:0;padding:9px 14px;border:1px solid var(--rule);border-radius:8px;font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:var(--blue);background:#fff;cursor:pointer;white-space:nowrap;}
.dash-search-new:hover{background:var(--rule-soft);}
.tabs{display:flex;}
.tab{flex:1;text-align:center;padding:13px 0;font-weight:700;font-size:14.5px;color:var(--ink-soft);cursor:pointer;position:relative;}
.tab:hover{background:var(--rule-soft);}
.tab.active{color:var(--ink);}
.tab.active::after{content:"";position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:64px;height:4px;border-radius:4px;background:var(--gilt);}
.pf{display:flex;gap:7px;padding:9px 16px;border-bottom:1px solid var(--rule);overflow-x:auto;}
.pchip{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;padding:6px 12px;border-radius:999px;border:1px solid var(--rule);color:var(--ink-soft);cursor:pointer;white-space:nowrap;background:#fff;}
.pchip.on{background:var(--ink);color:#fff;border-color:var(--ink);}
.pchip[data-p="t"].on{background:var(--temple);border-color:var(--temple);}
.pchip[data-p="f"].on{background:var(--forum);border-color:var(--forum);}
.pchip[data-p="m"].on{background:var(--market);border-color:var(--market);}

.legend{display:flex;align-items:center;gap:5px;flex-wrap:wrap;padding:10px 16px;background:var(--blue-vp);border-bottom:1px solid var(--rule);font-size:11.5px;color:var(--ink-soft);}
.legend b{color:var(--ink);}
.lg{display:flex;align-items:center;gap:5px;}
.lg .ic{width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff;}
.ic-s{background:var(--gilt);}.ic-b{background:var(--blue-md);}.ic-i{background:var(--green);}
.lg-arr{color:var(--ink-mut);}

.tabview{display:none;}.tabview.active{display:block;}

/* EMPTY STATE */
.empty{padding:40px 24px;text-align:center;color:var(--ink-soft);}
.empty-icon{font-size:32px;margin-bottom:12px;}
.empty-h{font-family:'Libre Baskerville',serif;font-size:18px;font-weight:700;color:var(--blue);margin-bottom:8px;}
.empty-p{font-size:14px;line-height:1.6;}

/* FEED POSTS */
.post{padding:13px 16px;border-bottom:1px solid var(--rule);display:flex;gap:11px;border-left:3px solid transparent;position:relative;}
.post:hover{background:#fbfcfe;}
.post.t{border-left-color:var(--temple);}.post.f{border-left-color:var(--forum);}.post.m{border-left-color:var(--market);}
.av{width:44px;height:44px;border-radius:50%;flex:none;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:15px;border:2px solid transparent;}
.av-gov{background:var(--blue);border-color:var(--gilt);}.av-org{background:var(--purple);}.av-doc{background:var(--scarlet);}.av-user{background:var(--green);}
.pb{flex:1;min-width:0;}
.pm{display:flex;align-items:center;gap:5px;flex-wrap:wrap;font-size:13.5px;}
.pn2{font-weight:800;}
.vchk{color:var(--gilt);font-weight:900;}
.pr,.ph{color:var(--ink-mut);font-size:12.5px;}
.pbadge{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.05em;text-transform:uppercase;padding:3px 7px;border-radius:999px;}
.bb-t{background:var(--gilt-pl);color:#6b5300;}.bb-f{background:var(--blue-pl);color:var(--blue);}.bb-m{background:var(--green-p);color:var(--market);}
.fctx{font-size:11.5px;color:var(--ink-mut);margin:2px 0 6px;display:flex;align-items:center;gap:6px;}
.fctx .star{color:var(--gilt);}
.ptext{margin:3px 0;font-size:14.5px;line-height:1.5;}

.icard{border:1px solid var(--rule);border-radius:12px;padding:11px 13px;margin-top:8px;background:#fff;}
.ic-top{display:flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:5px;}
.ic-k{padding:2px 6px;border-radius:5px;}
.k-bill{background:var(--blue-pl);color:var(--blue);}.k-eo{background:var(--scarlet-p);color:var(--scarlet);}.k-issue{background:var(--amber-p);color:var(--amber);}
.ic-t{font-family:'Libre Baskerville',serif;font-weight:700;font-size:14.5px;line-height:1.3;}
.ic-stage{margin-top:7px;display:flex;align-items:center;gap:7px;font-size:11px;color:var(--ink-soft);}
.sbar{display:flex;gap:3px;flex:1;}
.sseg{height:5px;flex:1;border-radius:3px;background:var(--rule);}
.sseg.done{background:var(--blue);}.sseg.now{background:var(--gilt);}

/* THE ARC */
.arc{display:flex;align-items:center;gap:7px;margin-top:11px;flex-wrap:wrap;}
.rung{display:flex;align-items:center;gap:6px;border:1.5px solid var(--rule);background:#fff;border-radius:999px;padding:6px 13px;font-weight:700;font-size:12.5px;color:var(--ink-soft);cursor:pointer;transition:all .12s;}
.rung .ri{width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff;background:var(--ink-mut);}
.rung:hover{border-color:var(--gilt);}
.rung.spark.on{background:var(--gilt-pl);border-color:var(--gilt);color:#6b5300;}
.rung.spark.on .ri{background:var(--gilt);}
.rung.build.on{background:var(--blue-vp);border-color:var(--blue-md);color:var(--blue);}
.rung.build.on .ri{background:var(--blue-md);}
.rung.integ.on{background:var(--green-p);border-color:var(--green);color:var(--market);}
.rung.integ.on .ri{background:var(--green);}
.rung.locked{opacity:.45;cursor:default;}
.rung.locked:hover{border-color:var(--rule);}
.arc-sec{margin-left:auto;display:flex;align-items:center;gap:13px;color:var(--ink-mut);font-size:12.5px;}
.arc-sec span{cursor:pointer;}
.arc-sec span:hover{color:var(--blue-lt);}
.concur-ct{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--gilt);font-weight:700;}

/* TRAY */
.tray{display:none;margin-top:9px;padding:11px 12px;border-radius:11px;font-size:12.5px;}
.tray.show{display:block;}
.tray.build{background:var(--blue-vp);border:1px solid var(--blue-pl);}
.tray.integ{background:var(--green-p);border:1px solid #bfe0cb;}
.tray-h{font-weight:800;margin-bottom:7px;font-size:12px;}
.tray.build .tray-h{color:var(--blue);}
.tray.integ .tray-h{color:var(--market);}
.tray-opts{display:flex;flex-wrap:wrap;gap:6px;}
.topt{background:#fff;border:1px solid var(--rule);border-radius:999px;padding:6px 11px;font-weight:700;font-size:12px;cursor:pointer;}
.topt:hover{border-color:var(--gilt);}
.topt.stub{opacity:.5;cursor:default;}
.topt.stub:hover{border-color:var(--rule);}

/* NOTE FORM (Build tray) */
.note-form{margin-top:9px;display:flex;gap:7px;}
.note-form textarea{flex:1;border:1.5px solid var(--blue-pl);border-radius:8px;padding:7px 10px;font-family:'Nunito',sans-serif;font-size:13px;resize:none;outline:none;}
.note-form textarea:focus{border-color:var(--blue-md);}
.note-form button{background:var(--blue-md);color:#fff;border:none;border-radius:999px;padding:7px 14px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;cursor:pointer;white-space:nowrap;}

/* PROJECT FORM (Integrate tray) */
.project-sel{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px;}
.proj-chip{background:#fff;border:1px solid var(--rule);border-radius:999px;padding:5px 10px;font-size:12px;font-weight:700;cursor:pointer;}
.proj-chip:hover{border-color:var(--green);}
.proj-new-form{display:flex;gap:7px;margin-top:7px;width:100%;}
.proj-new-form input{flex:1;border:1.5px solid #bfe0cb;border-radius:8px;padding:6px 10px;font-family:'Nunito',sans-serif;font-size:13px;outline:none;}
.proj-new-form input:focus{border-color:var(--green);}
.proj-new-form button{background:var(--green);color:#fff;border:none;border-radius:999px;padding:6px 13px;font-family:'JetBrains Mono',monospace;font-size:9px;text-transform:uppercase;font-weight:700;cursor:pointer;}

/* RIGHT RAIL */
.rcard{background:var(--white);border:1px solid var(--rule);border-radius:15px;margin-bottom:15px;overflow:hidden;}
.rh{padding:12px 15px 3px;font-family:'Libre Baskerville',serif;font-weight:700;font-size:15.5px;color:var(--blue);}
.rs{padding:0 15px 9px;font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mut);}
.dk{padding:10px 15px;border-top:1px solid var(--rule-soft);cursor:pointer;}
.dk:hover{background:var(--rule-soft);}
.dk-top{display:flex;align-items:center;gap:6px;margin-bottom:4px;}
.dk-k{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.04em;text-transform:uppercase;padding:2px 6px;border-radius:4px;}
.dk-w{margin-left:auto;font-size:10.5px;color:var(--ink-mut);}
.dk-t{font-weight:700;font-size:13px;line-height:1.3;}
.dk-s{margin-top:5px;display:flex;gap:3px;}
.dk-sg{height:4px;flex:1;border-radius:2px;background:var(--rule);}
.dk-sg.done{background:var(--blue);}.dk-sg.now{background:var(--gilt);}
.rfoot{padding:10px 15px;text-align:center;border-top:1px solid var(--rule-soft);font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--blue);cursor:pointer;}
.rfoot:hover{background:var(--blue-vp);}
.rrow{display:flex;align-items:center;gap:9px;padding:7px 14px;border-top:1px solid var(--rule-soft);font-size:13px;cursor:pointer;}
.rrow:hover{background:var(--rule-soft);}
.rrow-av{width:28px;height:28px;border-radius:50%;background:var(--blue);border:1.5px solid var(--gilt);color:#fff;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;flex-shrink:0;}
.rrow-name{font-weight:700;font-size:12.5px;}
.rrow-role{font-size:10.5px;color:var(--ink-mut);}
.rep{display:flex;align-items:center;gap:9px;padding:8px 15px;border-top:1px solid var(--rule-soft);cursor:pointer;}
/* ── Official expand panel ── */
.rep-expand-toggle{margin-top:6px;font-size:11px;color:var(--ink-mut);background:none;border:none;padding:0;cursor:pointer;font-family:inherit;display:flex;align-items:center;gap:4px;}
.rep-expand-toggle .arr{font-size:10px;display:inline-block;transition:transform .18s;}
.rep-expand-toggle.open .arr{transform:rotate(180deg);}
.rep-panel{display:none;margin-top:10px;padding-top:10px;border-top:1px solid var(--rule-soft);}
.rep-panel.open{display:block;}
.rep-panel-hd{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mut);margin:0 0 6px;}
.rep-panel-photo{width:52px;height:62px;border-radius:6px;object-fit:cover;object-position:top;float:right;margin:0 0 8px 10px;border:1px solid var(--rule);}
.rep-panel-contact{font-size:12px;color:var(--ink-soft);line-height:1.7;margin-bottom:10px;}
.rep-panel-contact a{color:var(--blue);text-decoration:none;}
.rep-panel-contact a:hover{text-decoration:underline;}
.rep-stats{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px;}
.rep-stat{background:var(--rule-soft);border-radius:8px;padding:7px 10px;flex:1;min-width:72px;}
.rep-stat-n{font-size:15px;font-weight:800;color:var(--ink);}
.rep-stat-l{font-size:9.5px;color:var(--ink-mut);margin-top:1px;line-height:1.3;}
.rep-bills{}
.rep-bill{font-size:11.5px;color:var(--ink-soft);padding:4px 0;border-bottom:0.5px solid var(--rule-soft);display:flex;gap:6px;}
.rep-bill:last-child{border-bottom:none;}
.rep-bill-id{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--ink-mut);white-space:nowrap;padding-top:2px;}
.rep-profile-link{display:inline-flex;align-items:center;gap:5px;margin-top:10px;font-size:11.5px;font-weight:700;color:var(--blue);border:1px solid var(--blue-pl);border-radius:999px;padding:5px 14px;background:var(--blue-vp);text-decoration:none;clear:both;}
.rep-profile-link:hover{background:var(--blue-pl);}
.rep:hover{background:var(--rule-soft);}
.rep-av{width:34px;height:34px;border-radius:50%;background:var(--blue);border:2px solid var(--gilt);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:12px;flex:none;}
.rep-n{font-weight:700;font-size:13px;}.rep-r{font-size:11px;color:var(--ink-mut);}
.rep-f{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.04em;text-transform:uppercase;border:1px solid var(--blue);color:var(--blue);border-radius:999px;padding:4px 8px;white-space:nowrap;cursor:pointer;}
.rep-f.on{background:var(--blue);color:#fff;}
.rh-btn{padding:12px 15px;font-family:'Nunito',sans-serif;font-weight:700;font-size:14.5px;color:var(--white);background:var(--blue-md);border:none;cursor:pointer;width:100%;text-align:left;}
.rh-btn:hover{background:var(--blue);}
.opt-c-section{padding:12px 15px;border-top:1px solid var(--rule-soft);}
.opt-c-section.federal{background:var(--blue-vp);}
.opt-c-section.state{background:var(--green-p);}
.opt-c-section.city{background:var(--amber-p);}
.opt-c-section-h{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);font-weight:700;padding-bottom:8px;border-bottom:2px solid rgba(0,0,0,.1);display:flex;align-items:center;justify-content:space-between;cursor:pointer;user-select:none;}
.opt-c-section-h .tog-arrow{font-size:10px;transition:transform .2s;}
.opt-c-section-h.collapsed .tog-arrow{transform:rotate(-90deg);}
.opt-c-body{margin-top:10px;}
.opt-c-body.collapsed{display:none;}
.opt-c-rep{display:flex;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid rgba(0,0,0,.05);cursor:pointer;}
.opt-c-rep:last-child{border-bottom:none;}
.opt-c-rep:hover .opt-c-name{color:var(--blue);}
/* Official profile panel */
.official-panel-bar{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.95);backdrop-filter:blur(8px);border-bottom:1px solid var(--rule);padding:9px 16px;display:flex;align-items:center;gap:10px;}
.official-panel-back{font-size:13px;font-weight:700;color:var(--blue);cursor:pointer;background:none;border:none;padding:4px 8px;border-radius:6px;}
.official-panel-back:hover{background:var(--rule-soft);}
.official-iframe{width:100%;border:none;display:block;}
.settings-iframe{width:100%;border:none;display:block;min-height:calc(100vh - 50px);}
.opt-c-av{width:30px;height:30px;border-radius:50%;background:var(--blue);border:2px solid var(--gilt);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:10px;flex:none;}
.opt-c-name{font-weight:700;font-size:12px;}
.opt-c-title{font-size:9.5px;color:var(--ink-mut);}
.opt-c-btn{padding:3px 8px;border:1px solid var(--blue);border-radius:4px;font-size:7px;letter-spacing:.04em;text-transform:uppercase;font-weight:700;cursor:pointer;background:#fff;color:var(--blue);flex:none;}
.opt-c-btn.on{background:var(--blue);color:#fff;}
.cm{padding:12px 15px;}
.cm-n{font-family:'Libre Baskerville',serif;font-size:29px;font-weight:700;color:var(--gilt);}
.cm-l{font-size:11.5px;color:var(--ink-soft);line-height:1.4;margin-top:4px;}
.cm-l b{color:var(--ink);}
.cm-empty{padding:12px 15px;font-size:13px;color:var(--ink-mut);}

/* EXPAND SHELL */
.expand-cue{display:flex;align-items:center;justify-content:center;gap:7px;margin-top:9px;padding:6px;border-top:1px dashed var(--rule);font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--blue);cursor:pointer;user-select:none;}
.expand-cue:hover{color:var(--blue-md);}
.exp{display:none;}
.exp.open{display:block;animation:expfade .25s ease;}
@keyframes expfade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}

/* RESPONSIVE */
@media(max-width:1040px){
  .shell{grid-template-columns:230px minmax(0,1fr);}
  .col-right{display:none;}
}
@media(max-width:720px){
  .shell{grid-template-columns:1fr;max-width:600px;}
  .col-left{display:none;}
  .mtop{display:flex;align-items:center;gap:9px;position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid var(--rule);padding:10px 15px;}
  .mtop .mm{width:30px;height:30px;border-radius:7px;background:linear-gradient(150deg,var(--blue),var(--blue-md));color:var(--gilt-lt);font-family:'Libre Baskerville',serif;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:16px;}
  .mtop .mw{font-family:'Libre Baskerville',serif;font-weight:700;font-size:18px;color:var(--blue);}
  .mtop .mav{margin-left:auto;width:32px;height:32px;border-radius:50%;background:var(--green);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;}
  body{padding-bottom:64px;}
  .mbar{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:30;background:#fff;border-top:1px solid var(--rule);box-shadow:0 -2px 14px rgba(20,44,82,.07);}
  .mtab{flex:1;text-align:center;padding:11px 0 9px;font-size:21px;cursor:pointer;color:var(--ink-soft);}
  .mtab.home.on{color:var(--blue);}
  .mtab[data-g="t"]{color:var(--temple);}.mtab[data-g="f"]{color:var(--forum);}.mtab[data-g="m"]{color:var(--market);}
  .mtab.fab{position:relative;}
  .mtab.fab span{display:inline-flex;width:38px;height:38px;border-radius:50%;background:var(--gilt);color:#fff;align-items:center;justify-content:center;font-size:24px;font-weight:400;box-shadow:0 2px 8px rgba(120,86,8,.4);margin-top:-3px;}
  .arc-sec{margin-left:0;width:100%;justify-content:flex-start;margin-top:4px;}
}
/* ── Three-layer market panel ──────────────────────────────────────────── */
.layer-banner{border-bottom:1px solid var(--rule);cursor:pointer;user-select:none}
.layer-banner-head{display:flex;align-items:center;gap:9px;padding:9px 18px}
.layer-glyph{font-size:13px;flex-shrink:0;width:18px;text-align:center}
.layer-label{font-size:11px;font-weight:500;flex:1;color:var(--ink-soft)}
.layer-count{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--ink-mut);background:var(--bg);border:0.5px solid var(--rule);border-radius:20px;padding:2px 7px}
.layer-chev{font-size:11px;color:var(--ink-mut);transition:transform .15s}
.layer-banner.open .layer-chev{transform:rotate(180deg)}
.layer-body{display:none;padding:0 18px 10px;border-top:0.5px solid var(--rule)}
.layer-body.open{display:block}
.temple-banner .layer-banner-head{background:#fdf8ef}
.temple-item{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:0.5px solid var(--rule)}
.temple-item:last-child{border-bottom:none}
.temple-dot{width:6px;height:6px;border-radius:50%;background:var(--gilt);flex-shrink:0;margin-top:5px}
.temple-item-title{font-size:12px;font-weight:500;color:var(--ink);margin:0 0 1px}
.temple-item-sub{font-size:11px;color:var(--ink-soft);margin:0}
.temple-item-tag{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.05em;color:var(--gilt);background:#fdf8ef;border:0.5px solid #f8e8b0;border-radius:4px;padding:1px 5px;margin-left:auto;flex-shrink:0;align-self:flex-start;margin-top:1px}
.forum-banner .layer-banner-head{background:#eef2fb}
.forum-item{display:flex;gap:10px;align-items:flex-start;padding:9px 0;border-bottom:0.5px solid var(--rule)}
.forum-item:last-child{border-bottom:none}
.forum-dot{width:6px;height:6px;border-radius:50%;background:var(--blue);flex-shrink:0;margin-top:5px}
.forum-item-title{font-size:12px;font-weight:500;color:var(--ink);margin:0 0 1px}
.forum-item-sub{font-size:11px;color:var(--ink-soft);margin:0;line-height:1.4}
.forum-item-tag{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.05em;color:var(--blue);background:#eef2fb;border:0.5px solid #c8d8f5;border-radius:4px;padding:1px 5px;margin-left:auto;flex-shrink:0;align-self:flex-start;margin-top:1px}
.mkt-sec-label{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-mut);font-family:'JetBrains Mono',monospace;padding:12px 18px 6px;border-top:1px solid var(--rule);display:flex;align-items:center;gap:8px}
.mkt-filter-chips{display:flex;gap:5px;padding:0 18px 10px;flex-wrap:wrap}
.mkt-fchip{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:20px;border:1px solid var(--rule);color:var(--ink-soft);cursor:pointer;background:#fff}
.mkt-fchip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
/* ── Global search results panel ──────────────────────────────────────────── */
.scope-row{display:flex;gap:6px;padding:9px 14px;border-bottom:1px solid var(--rule);overflow-x:auto;}
.schip{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:.07em;text-transform:uppercase;padding:5px 11px;border-radius:999px;border:1px solid var(--rule);color:var(--ink-soft);cursor:pointer;white-space:nowrap;background:#fff;}
.schip.on{background:var(--ink);color:#fff;border-color:var(--ink);}
.schip[data-p="t"].on{background:var(--gilt);border-color:var(--gilt);}
.schip[data-p="f"].on{background:var(--blue);border-color:var(--blue);}
.schip[data-p="m"].on{background:var(--green);border-color:var(--green);}
.result-card{border-bottom:1px solid var(--rule);padding:12px 16px;cursor:pointer;display:flex;gap:10px;align-items:flex-start;border-left:3px solid transparent;}
.result-card:hover{background:var(--rule-soft);}
.result-card.r-t{border-left-color:var(--gilt);}
.result-card.r-f{border-left-color:var(--blue);}
.result-card.r-m{border-left-color:var(--green);}
.r-icon{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;color:#fff;}
.ri-t{background:var(--gilt);}.ri-f{background:var(--blue);}.ri-m{background:var(--green);}
.r-body{flex:1;min-width:0;}
.r-top{display:flex;align-items:center;gap:6px;margin-bottom:2px;flex-wrap:wrap;}
.r-name{font-size:13px;font-weight:700;color:var(--ink);}
.r-badge{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:.05em;text-transform:uppercase;padding:2px 6px;border-radius:4px;font-weight:700;}
.rb-t{background:var(--gilt-pl,#fdf8ef);color:#6b5300;}.rb-f{background:var(--blue-pl,#eef2fb);color:var(--blue);}.rb-m{background:var(--green-p,#eaf4ee);color:var(--green);}
.r-sub{font-size:11.5px;color:var(--ink-soft);line-height:1.45;}
.r-meta{font-size:10.5px;color:var(--ink-mut);margin-top:3px;font-family:'JetBrains Mono',monospace;}
.results-label{padding:8px 16px 4px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-mut);}
.srch-idle{padding:48px 24px;text-align:center;}
.srch-idle-glyph{font-size:22px;color:var(--ink-mut);margin-bottom:12px;}
.srch-idle-h{font-family:'Libre Baskerville',serif;font-size:17px;font-weight:700;color:var(--ink);margin-bottom:6px;}
.srch-idle-p{font-size:13px;color:var(--ink-soft);line-height:1.6;}
.srch-sug-chips{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-top:14px;}
.srch-sug{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.05em;padding:5px 11px;border-radius:999px;border:1px solid var(--rule);color:var(--ink-soft);cursor:pointer;background:#fff;}
.srch-sug:hover{background:var(--rule-soft);}

/* ── Home Wall ─────────────────────────────────────────────────────────────── */
#home-wall{overflow-y:auto;height:100%;}
.wall-compose-bar{padding:12px 20px;border-bottom:1px solid var(--rule-soft);}
.wall-compose-trigger{display:flex;align-items:center;gap:10px;padding:10px 14px;border:1.5px dashed var(--rule);border-radius:12px;cursor:pointer;background:var(--white);transition:border-color .15s;}
.wall-compose-trigger:hover{border-color:var(--ink-mut);}
.wall-compose-avatar{width:32px;height:32px;border-radius:50%;background:var(--blue);color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.wall-compose-ph{font-size:13px;color:var(--ink-mut);}
.wall-compose-form{display:none;padding:14px 20px;border-bottom:1px solid var(--rule);background:var(--white);}
.wall-compose-form.open{display:block;}
.wall-compose-textarea{width:100%;border:1.5px solid var(--rule);border-radius:10px;padding:10px 12px;font-family:'Nunito',sans-serif;font-size:14px;resize:none;color:var(--ink);outline:none;min-height:80px;line-height:1.5;}
.wall-compose-textarea:focus{border-color:var(--blue);}
.wall-compose-types{display:flex;gap:6px;margin:8px 0;flex-wrap:wrap;}
.wall-type-chip{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;padding:5px 10px;border-radius:999px;border:1px solid var(--rule);color:var(--ink-soft);cursor:pointer;background:#fff;transition:all .12s;}
.wall-type-chip.sel{background:var(--blue);color:#fff;border-color:var(--blue);}
.wall-compose-foot{display:flex;align-items:center;justify-content:space-between;margin-top:10px;}
.wall-img-btn{display:flex;align-items:center;gap:5px;padding:6px 11px;border:1px solid var(--rule);border-radius:7px;background:#fff;color:var(--ink-soft);font-size:12px;cursor:pointer;}
.wall-img-btn:hover{background:var(--rule-soft);}
.wall-img-preview{max-width:100%;border-radius:8px;margin-top:8px;display:none;}
.wall-post-btn{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.07em;text-transform:uppercase;font-weight:700;padding:8px 16px;background:var(--blue);color:#fff;border:none;border-radius:8px;cursor:pointer;}
.wall-post-btn:hover{background:var(--blue-md);}
.wall-post-btn:disabled{opacity:.5;cursor:not-allowed;}
.wall-cancel-btn{font-size:12px;color:var(--ink-mut);background:none;border:none;cursor:pointer;padding:6px;}
.wall-feed{padding:16px 20px;display:flex;flex-direction:column;gap:12px;}
.wall-post{background:var(--white);border:1px solid var(--rule);border-radius:14px;padding:14px 16px;position:relative;}
.wall-post-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.wall-post-meta{display:flex;align-items:center;gap:8px;}
.wall-post-av{width:30px;height:30px;border-radius:50%;background:var(--blue);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;}
.wall-post-handle{font-weight:700;font-size:13px;color:var(--ink);}
.wall-post-time{font-size:10.5px;color:var(--ink-mut);font-family:'JetBrains Mono',monospace;}
.wall-post-type{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.06em;text-transform:uppercase;padding:2px 7px;border-radius:20px;border:1px solid var(--rule);color:var(--ink-soft);}
.wall-post-body{font-size:14px;color:var(--ink);line-height:1.55;margin-bottom:8px;}
.wall-post-img{width:100%;border-radius:10px;margin-bottom:8px;display:block;}
.wall-post-actions{display:flex;align-items:center;gap:8px;padding-top:8px;border-top:1px solid var(--rule-soft);}
.wall-action-btn{display:flex;align-items:center;gap:4px;padding:4px 10px;border:0.5px solid var(--rule);border-radius:7px;background:#fff;color:var(--ink-soft);font-size:12px;cursor:pointer;font-family:'Nunito',sans-serif;}
.wall-action-btn:hover{background:var(--rule-soft);color:var(--ink);}
.wall-action-btn.liked{color:var(--blue);border-color:var(--blue-pl);}

/* ── Weather station card ──────────────────────────────────────────────────── */
.ws-wrap{background:var(--white);border:1px solid var(--rule);border-radius:14px;padding:16px 18px;overflow:hidden;}
.ws-header{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:.9rem;}
.ws-city{font-size:12px;color:var(--ink-soft);}
.ws-updated{font-size:11px;color:var(--ink-mut);font-family:'JetBrains Mono',monospace;}
.ws-hero{background:#1b3a6b;border-radius:12px;padding:1rem 1.25rem;color:#fff;margin-bottom:.85rem;display:flex;align-items:center;gap:1.25rem;}
.ws-temp-big{font-size:52px;font-weight:500;line-height:1;color:#fff;}
.ws-hero-meta{flex:1;}
.ws-condition{font-size:14px;color:#b8c8e8;margin-bottom:3px;}
.ws-feels{font-size:12px;color:#8aaad0;}
.ws-feels span{color:#f5c842;font-weight:600;}
.ws-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:8px;margin-bottom:.85rem;}
.ws-card{background:var(--rule-soft);border:0.5px solid var(--rule);border-radius:10px;padding:.7rem .85rem;cursor:pointer;transition:border-color .15s;}
.ws-card:hover{border-color:var(--ink-mut);}
.ws-card.active{border-color:#1b3a6b;border-width:1.5px;}
.ws-card-label{font-size:10px;color:var(--ink-mut);text-transform:uppercase;letter-spacing:.06em;margin-bottom:3px;font-family:'JetBrains Mono',monospace;}
.ws-card-val{font-size:20px;font-weight:500;color:var(--ink);line-height:1.1;}
.ws-card-unit{font-size:11px;color:var(--ink-soft);margin-top:1px;}
.ws-card-bar{height:3px;border-radius:2px;margin-top:7px;background:var(--rule);overflow:hidden;}
.ws-card-fill{height:100%;border-radius:2px;}
.ws-pill{display:inline-block;font-size:9.5px;padding:2px 7px;border-radius:20px;margin-top:5px;font-weight:600;font-family:'JetBrains Mono',monospace;letter-spacing:.03em;}
.pill-warn{background:#faeeda;color:#854f0b;}
.pill-ok{background:#eaf3de;color:#3b6d11;}
.pill-mod{background:#e6f1fb;color:#185fa5;}
.pill-high{background:#faece7;color:#993c1d;}
.ws-detail{background:var(--rule-soft);border:0.5px solid var(--rule);border-radius:12px;padding:.95rem 1.1rem;margin-top:.85rem;}
.ws-detail-title{font-size:14.5px;font-weight:600;color:var(--ink);margin-bottom:3px;display:flex;align-items:center;gap:7px;}
.ws-detail-sub{font-size:12px;color:var(--ink-soft);margin-bottom:.8rem;line-height:1.55;}
.ws-nav-row{display:flex;gap:6px;margin-bottom:.8rem;flex-wrap:wrap;}
.ws-nav-btn{font-size:11px;padding:4px 11px;border-radius:20px;border:0.5px solid var(--rule);color:var(--ink-soft);cursor:pointer;background:var(--white);}
.ws-nav-btn.active{background:#1b3a6b;color:#fff;border-color:#1b3a6b;}
.ws-psa-card{background:var(--white);border-radius:8px;padding:.6rem .85rem;margin-bottom:.4rem;display:flex;gap:9px;align-items:flex-start;border:0.5px solid var(--rule);}
.ws-psa-badge{font-size:9.5px;font-weight:600;padding:2px 7px;border-radius:20px;white-space:nowrap;margin-top:1px;font-family:'JetBrains Mono',monospace;letter-spacing:.03em;}
.badge-govt{background:#e6f1fb;color:#185fa5;}
.badge-creator{background:#eeedfe;color:#3c3489;}
.badge-resident{background:#e1f5ee;color:#085041;}
.ws-psa-text{font-size:12.5px;color:var(--ink);line-height:1.5;}
.ws-psa-meta{font-size:10.5px;color:var(--ink-mut);margin-top:2px;font-family:'JetBrains Mono',monospace;}
.ws-compare-row{display:flex;align-items:center;gap:7px;margin-bottom:4px;}
.ws-compare-name{font-size:11px;color:var(--ink-soft);width:80px;flex-shrink:0;}
.ws-compare-track{flex:1;height:5px;background:var(--rule);border-radius:3px;overflow:hidden;}
.ws-compare-fill{height:100%;border-radius:3px;}
.ws-compare-num{font-size:11px;color:var(--ink);font-weight:600;width:28px;text-align:right;}
.ws-loading{padding:24px;text-align:center;color:var(--ink-mut);font-size:13px;}
.ws-share-wrap{position:relative;margin-left:auto;}
</style>
</head>
<body>

<!-- MOBILE top bar -->
<div class="mtop">
  <a href="<%= root_path %>" class="mm">F</a>
  <span class="mw">FORA</span>
  <div class="mav"><%= initials(current_user.handle) %></div>
</div>

<div class="shell">

  <%# ── LEFT RAIL ─────────────────────────────────────────────────────────── %>
  <nav class="col-left">
    <div class="brand">
      <a href="<%= root_path %>" class="brand-mark">F</a>
      <span class="brand-word">FORA</span>
    </div>

    <a href="#" class="nav-home" onclick="switchPanel('search',null);return false;">
      <i class="ti ti-home ni"></i> Home
    </a>
    <a href="#" class="tool" style="margin-top:2px;" onclick="openSettingsPanel();return false;">
      <i class="ti ti-settings"></i> Settings
    </a>

    <div class="pillar-h"><span class="pg pg-t">◯</span><span class="pn">Wisdom</span></div>
    <div class="tpl-nav">
      <%- @temple_domains.each do |dom| %>
        <div class="tpl-dom-h" onclick="toggleNavDom(this,'tpl')">
          <i class="ti <%= dom.icon %> tpl-dom-icon"></i>
          <span class="tpl-dom-label"><%= dom.name %></span>
          <i class="ti ti-chevron-down tpl-chev"></i>
        </div>
        <div class="tpl-sub-list">
          <%- dom.temple_subcategories.each do |sub| %>
            <div class="tpl-sub" onclick="tplSubClick('<%= sub.slug %>',this)"><%= sub.name %></div>
          <%- end %>
        </div>
      <%- end %>
    </div>

    <div class="pillar-h"><span class="pg pg-f">△</span><span class="pn">Law</span></div>
    <div class="frm-nav">
      <div class="frm-dom-h" id="frm-officials-h" onclick="frmOfficialsClick(this)">
        <i class="ti ti-users frm-dom-icon"></i>
        <span class="frm-dom-label">Officials</span>
        <i class="ti ti-chevron-down frm-chev"></i>
      </div>
      <div class="frm-sub-list" id="frm-officials-subs">
        <div class="frm-sub frm-gov-sub" onclick="filterOfficials('federal',this)">Federal</div>
        <div class="frm-sub frm-gov-sub" onclick="filterOfficials('state',this)">State</div>
        <div class="frm-sub frm-gov-sub" onclick="filterOfficials('local',this)">Local</div>
      </div>
      <div class="frm-dom-h" id="frm-leg-h" onclick="frmLegislationClick(this)">
        <i class="ti ti-file-description frm-dom-icon"></i>
        <span class="frm-dom-label">Legislation</span>
        <i class="ti ti-chevron-down frm-chev"></i>
      </div>
      <div class="frm-sub-list" id="frm-leg-domains">
        <%- @forum_domains.reject { |d| d.slug == 'officials' }.each do |dom| %>
          <div class="frm-dom-h" onclick="frmDomClick(this,'<%= dom.slug %>')">
            <i class="ti <%= dom.icon %> frm-dom-icon"></i>
            <span class="frm-dom-label"><%= dom.name %></span>
            <i class="ti ti-chevron-down frm-chev"></i>
          </div>
          <div class="frm-sub-list">
            <%- dom.forum_subcategories.each do |sub| %>
              <div class="frm-sub" onclick="frmSubClick('<%= sub.slug %>',this)"><%= sub.name %></div>
            <%- end %>
          </div>
        <%- end %>
      </div>
    </div>

    <div class="pillar-h" style="cursor:pointer" onclick="switchPanel('market',null);return false;"><span class="pg pg-m">▢</span><span class="pn">Market</span></div>
    <div class="mkt-nav" id="mkt-nav"></div>
    <% if @profile.provider_mode? %>
      <a href="#" class="tool" style="margin-top:4px" onclick="openSvcPanel();return false;"><i class="ti ti-map-pin"></i> My Services</a>
    <% end %>

    <button class="voice">Add your Voice</button>


  </nav>

  <%# ── CENTER ──────────────────────────────────────────────────────────────── %>
  <main class="col-center">
  <div class="dash-search">
    <input class="dash-search-input" id="srch" type="text"
           placeholder="Search FORA — legislation, officials, businesses, discussions…"
           oninput="onSrchInput(this.value)"
           onkeydown="if(event.key==='Enter')doSearch(this.value)">
    <input class="dash-search-loc" type="text"
           value="<%= [@profile.address_city.presence, @profile.address_state.presence].compact.join(', ').presence || '' %>"
           placeholder="Your location" readonly>
    <button class="dash-search-go" onclick="doSearch(document.getElementById('srch').value)">
      <i class="ti ti-search"></i>
    </button>
    <button class="dash-search-new" onclick="switchPanel('market',null)">&#9634; Market</button>
  </div>
  <div class="scope-row" id="scope-row" style="display:none">
    <span class="schip on" data-p="all" onclick="setSrchScope(this,'all')">All results</span>
    <span class="schip" data-p="t" onclick="setSrchScope(this,'t')">&#9675; Wisdom</span>
    <span class="schip" data-p="f" onclick="setSrchScope(this,'f')">&#9651; Law</span>
    <span class="schip" data-p="m" onclick="setSrchScope(this,'m')">&#9634; Market</span>
  </div>
  <div id="panel-observe" style="display:none">
    <div class="fhead">
      <div class="ftitle">Home</div>
      <div class="tabs">
        <div class="tab active" data-tab="following">Following</div>
        <div class="tab" data-tab="juris">Your Jurisdictions</div>
      </div>
      <div class="pf">
        <span class="pchip on" data-p="all">All</span>
        <span class="pchip" data-p="t">◯ Wisdom</span>
        <span class="pchip" data-p="f">△ Law</span>
        <span class="pchip" data-p="m">▢ Market</span>
      </div>
      <div class="legend">
        <span class="lg"><span class="ic ic-s">★</span> <b>Track</b> save it</span><span class="lg-arr">→</span>
        <span class="lg"><span class="ic ic-b">⊕</span> <b>Build</b> connect &amp; develop</span><span class="lg-arr">→</span>
        <span class="lg"><span class="ic ic-i">↗</span> <b>Integrate</b> weave it into something useful</span>
      </div>
    </div>

    <%# ── FOLLOWING TAB ────────────────────────────────────────────────────── %>
    <div class="tabview active" id="tv-following">
      <% if @feed.empty? %>
        <div class="empty">
          <div class="empty-icon">★</div>
          <div class="empty-h">Your feed is empty</div>
          <div class="empty-p">Switch to <strong>Your Jurisdictions</strong> to find bills, issues, and officials to track — they'll appear here.</div>
        </div>
      <% else %>
        <% @feed.each do |h| %>
          <%
            item    = h[:item]
            follow  = h[:follow]
            type    = h[:type]
            key     = "#{type}:#{item.id}"
            built   = @connection_map.key?(key)
            integrated = type == "NeighborhoodIssue" && @concurred_issues.include?(item.id)
            time_str = time_ago_short(h[:last_at])
          %>
          <div class="post f">
            <%# Avatar %>
            <% if type == "CivicBill" %>
              <div class="av av-doc">§</div>
            <% elsif type == "NeighborhoodIssue" %>
              <div class="av av-org"><%= item.rco_slug.upcase.first(2) %></div>
            <% elsif type == "CivicRepresentative" %>
              <div class="av av-gov"><%= initials(item.name) %></div>
            <% end %>

            <div class="pb">
              <%# Meta line %>
              <div class="pm">
                <% if type == "CivicBill" %>
                  <span class="pn2"><%= item.identifier.presence || "Bill" %></span>
                  <span class="pr">· <%= stage_label(item) %></span>
                <% elsif type == "NeighborhoodIssue" %>
                  <span class="pn2"><%= item.rco_slug.upcase %></span>
                  <span class="pr">· Neighborhood Issue</span>
                <% elsif type == "CivicRepresentative" %>
                  <span class="pn2"><%= item.name %></span>
                  <span class="vchk">✓</span>
                  <span class="pr">· <%= item.office %></span>
                <% end %>
                <span class="pbadge bb-f">△ Law</span>
              </div>

              <%# Context line %>
              <div class="fctx">
                <span class="star">★</span>
                <% if type == "CivicBill" %>
                  You're tracking this bill
                <% elsif type == "NeighborhoodIssue" %>
                  <% if @concurred_issues.include?(item.id) %>
                    Issue you concurred with
                    <% if item.threshold_reached? %>
                      · hit <%= item.alert_threshold %> → alerted to RCO
                    <% end %>
                  <% else %>
                    Issue you're tracking
                  <% end %>
                <% elsif type == "CivicRepresentative" %>
                  You follow this official
                <% end %>
                <% if time_str.present? %> · <%= time_str %><% end %>
              </div>

              <%# Item card for bills and issues %>
              <% if type == "CivicBill" %>
                <div class="icard">
                  <div class="ic-top">
                    <span class="ic-k k-bill">Bill · <%= jur_label(item) %></span>
                    <%= sponsors_line(item) %>
                  </div>
                  <div class="ic-t"><%= item.title.truncate(120) %></div>
                  <% segs = stage_segs(item) %>
                  <div class="ic-stage">
                    <div class="sbar">
                      <% segs.each do |s| %><span class="sseg <%= s %>"></span><% end %>
                    </div>
                    <span><%= stage_label(item) %></span>
                  </div>
                </div>
                <div class="expand-cue" onclick="toggleExpand(this)">▾ Open · read it, weigh it, take your stand</div>
                <div class="exp">
                  <%= render "shared/bill_expanded", bill: item, context: :card %>
                </div>
              <% elsif type == "NeighborhoodIssue" %>
                <div class="icard">
                  <div class="ic-top">
                    <span class="ic-k k-issue">Issue</span>
                    <%= item.location_description.presence || item.rco_slug.upcase %>
                  </div>
                  <div class="ic-t"><%= item.body.truncate(100) %></div>
                </div>
              <% end %>

              <%# ARC buttons %>
              <div class="arc">
                <button class="rung spark on"
                        data-type="<%= type %>"
                        data-id="<%= item.id %>"
                        onclick="toggleSpark(this)">
                  <span class="ri">★</span> Tracking
                </button>
                <button class="rung build <%= 'on' if built %>"
                        data-type="<%= type %>"
                        data-id="<%= item.id %>"
                        onclick="openTray(this,'build')">
                  <span class="ri">⊕</span> <%= built ? "Built" : "Build" %>
                </button>
                <button class="rung integ <%= 'on' if integrated %>"
                        data-type="<%= type %>"
                        data-id="<%= item.id %>"
                        onclick="openTray(this,'integ')">
                  <span class="ri">↗</span> <%= integrated ? "Integrated" : "Integrate" %>
                </button>
                <div class="arc-sec">
                  <% if type == "CivicBill" %>
                    <span class="concur-ct"><%= item.follows.count %> tracking</span>
                  <% elsif type == "NeighborhoodIssue" %>
                    <span class="concur-ct"><%= item.concurrence_count %> concur</span>
                  <% end %>
                  <span>💬 Discuss</span>
                </div>
              </div>
              <div class="tray build" data-source-type="<%= type %>" data-source-id="<%= item.id %>"></div>
              <div class="tray integ" data-source-type="<%= type %>" data-source-id="<%= item.id %>"></div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div><%# /tv-following %>

    <%# ── YOUR JURISDICTIONS TAB ───────────────────────────────────────────── %>
    <div class="tabview" id="tv-juris">
      <% if @jurisdiction_reps.empty? && @jurisdiction_bills.none? && @jurisdiction_issues.none? %>
        <div class="empty">
          <div class="empty-icon">△</div>
          <div class="empty-h">No local activity yet</div>
          <div class="empty-p">As bills and issues for <%= @profile.place_label.presence || "your area" %> are added, they'll appear here.</div>
        </div>
      <% else %>

        <%# — Your representatives (only those with CivicRepresentative AR records) -%>
        <% @jurisdiction_reps.each do |rep| %>
          <% rep_sparked = @rep_follows.include?(rep.id) %>
          <% odata = official_card_data(rep) %>
          <div class="post f">
            <div class="av av-gov"><%= initials(rep.name) %></div>
            <div class="pb">
              <div class="pm">
                <span class="pn2"><%= rep.name %></span>
                <span class="vchk">✓</span>
                <span class="pr">· <%= rep.office %></span>
                <span class="pbadge bb-f">△ Law</span>
              </div>
              <div class="fctx"><%= rep_sparked ? "You follow this official" : "Your representative" %></div>
              <div class="arc">
                <button class="rung spark <%= 'on' if rep_sparked %>"
                        data-type="CivicRepresentative"
                        data-id="<%= rep.id %>"
                        onclick="toggleSpark(this)">
                  <span class="ri">★</span> <%= rep_sparked ? "Tracking" : "Track" %>
                </button>
                <button class="rung build <%= 'locked' unless rep_sparked %>"><span class="ri">⊕</span> Build</button>
                <button class="rung integ <%= 'locked' unless rep_sparked %>"><span class="ri">↗</span> Integrate</button>
                <div class="arc-sec">
                  <span class="concur-ct"><%= rep.follows.count %> following</span>
                </div>
              </div>
              <div class="tray build" data-source-type="CivicRepresentative" data-source-id="<%= rep.id %>"></div>
              <div class="tray integ" data-source-type="CivicRepresentative" data-source-id="<%= rep.id %>"></div>

