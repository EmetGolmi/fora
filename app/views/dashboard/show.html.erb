                <% if odata[:photo] %>
                  <img class="rep-panel-photo" src="<%= odata[:photo] %>" alt="<%= rep.name %>">
                <% end %>
                <div class="rep-panel-hd">Contact</div>
                <div class="rep-panel-contact">
                  <% if odata[:website] %>📎 <a href="<%= odata[:website] %>" target="_blank" rel="noopener"><%= odata[:website].sub(%r{https?://}, '') %></a><br><% end %>
