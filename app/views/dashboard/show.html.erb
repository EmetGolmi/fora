function toggleMktLayer(id) {
  var banner = document.getElementById('mkt-' + id + '-banner');
  var body   = document.getElementById('mkt-' + id + '-body');
  if (!banner || !body) return;
  var open = body.classList.contains('open');
  body.classList.toggle('open', !open);
  banner.classList.toggle('open', !open);
}
function mktFchip(el) {
  el.closest('.mkt-filter-chips').querySelectorAll('.mkt-fchip').forEach(function(c){ c.classList.remove('on'); });
  el.classList.add('on');
}

function renderMktCards(title, sub, cards) {
  var crumb = document.getElementById('mkt-crumb');
  crumb.textContent = title + (sub !== 'All subcategories' ? ' \u203a ' + sub : '');
  crumb.style.display = '';
  var heading = '<div class="mkt-cat-header"><div>' + (sub !== 'All subcategories' ? sub : title) + '</div><div class="mkt-cat-sub">' + (sub !== 'All subcategories' ? title : '') + '</div></div>';
  var _isFoodCtx = _dbFoodSubs.indexOf(sub) >= 0 || title === 'Food & drink';
  var ad = (sub === 'Auto repair') ? MKT_JIFFY_AD : (_isFoodCtx ? MKT_DB_OASIS_AD : '');
  var _prevMktSeq = _mktLSeq;
  var html = cards.map(function(c, i){ return mktCardHtml(c, i); }).join('');

  var layers = MKT_LAYERS[sub];
  var layerHtml = '';
  if (layers) {
    var templeItems = layers.temple.items.map(function(it) {
      return '<div class="temple-item"><div class="temple-dot"></div><div style="flex:1;min-width:0"><p class="temple-item-title">' + it.title + '</p><p class="temple-item-sub">' + it.sub + '</p></div><span class="temple-item-tag">' + it.tag + '</span></div>';
    }).join('');
    layerHtml += '<div class="layer-banner temple-banner" id="mkt-temple-banner" onclick="toggleMktLayer(\'temple\')">'
      + '<div class="layer-banner-head"><span class="layer-glyph" style="color:var(--gilt)">&#9711;</span>'
      + '<span class="layer-label" style="color:#7a5c00">' + layers.temple.label + '</span>'
      + '<span class="layer-count">' + layers.temple.items.length + ' items</span>'
      + '<span class="layer-chev">&#9662;</span></div>'
      + '<div class="layer-body" id="mkt-temple-body">' + templeItems + '</div></div>';

    var forumItems = layers.forum.items.map(function(it) {
      return '<div class="forum-item"><div class="forum-dot"></div><div style="flex:1;min-width:0"><p class="forum-item-title">' + it.title + '</p><p class="forum-item-sub">' + it.sub + '</p></div><span class="forum-item-tag">' + it.tag + '</span></div>';
    }).join('');
    layerHtml += '<div class="layer-banner forum-banner" id="mkt-forum-banner" onclick="toggleMktLayer(\'forum\')">'
      + '<div class="layer-banner-head"><span class="layer-glyph" style="color:var(--blue)">&#9651;</span>'
      + '<span class="layer-label" style="color:#1b3a6b">' + layers.forum.label + '</span>'
      + '<span class="layer-count">' + layers.forum.items.length + ' items</span>'
      + '<span class="layer-chev">&#9662;</span></div>'
      + '<div class="layer-body" id="mkt-forum-body">' + forumItems + '</div></div>';

    var chips = layers.filterChips.map(function(c, i) {
      return '<span class="mkt-fchip' + (i === 0 ? ' on' : '') + '" onclick="mktFchip(this)">' + c + '</span>';
    }).join('');
    layerHtml += '<div class="mkt-sec-label"><span>&#9634; Market \u2014 providers near you</span></div>'
      + '<div class="mkt-filter-chips">' + chips + '</div>';
  }

  document.getElementById('mkt-main').innerHTML = heading + layerHtml + '<div class="mkt-grid">' + ad + html + '</div>';
  if (_isFoodCtx) setTimeout(dbRenderComments, 0);

  // Collect the lids just registered and pin them on the map
  var newLids = [];
  for (var n = _prevMktSeq + 1; n <= _mktLSeq; n++) newLids.push('mli' + n);
  renderMktMapPins(newLids);
}

// ── Global search ──────────────────────────────────────────────────────────
var srchResults = [], srchScope = 'all', srchPrevPanel = 'observe';
var srchDebounce;

function onSrchInput(v) {
  clearTimeout(srchDebounce);
  if (!v.trim()) { resetSrch(); return; }
  srchDebounce = setTimeout(function(){ doSearch(v); }, 350);
}

function doSearch(q) {
  q = q.trim();
  if (!q) { resetSrch(); return; }
  var vis = document.querySelector('.col-center [id^="panel-"]:not([style*="display:none"])');
  if (vis && vis.id !== 'panel-search') srchPrevPanel = vis.id.replace('panel-','');
  switchPanel('search', null);
  document.getElementById('scope-row').style.display = 'flex';
  document.getElementById('home-wall').style.display = 'none';
  document.getElementById('srch-results').style.display = 'block';
  document.getElementById('srch-results').innerHTML = '<div style="padding:32px;text-align:center;color:var(--ink-mut);font-size:13px;">Searching\u2026</div>';

  var csrf = document.querySelector('meta[name="csrf-token"]');
  fetch('/search?q=' + encodeURIComponent(q), {
    headers: { 'X-CSRF-Token': csrf ? csrf.content : '' }
  })
  .then(function(r){ return r.json(); })
  .then(function(data){
    srchResults = [];
    (data.temple||[]).forEach(function(r){ r.p='t'; srchResults.push(r); });
    (data.forum||[]).forEach(function(r){ r.p='f'; srchResults.push(r); });
    (data.market||[]).forEach(function(r){ r.p='m'; srchResults.push(r); });
    srchScope = 'all';
    document.querySelectorAll('.schip').forEach(function(c){ c.classList.toggle('on', c.dataset.p==='all'); });
    renderSrchResults(q);
  })
  .catch(function(){
    document.getElementById('srch-results').innerHTML = '<div style="padding:32px;text-align:center;color:var(--ink-mut);">Search unavailable.</div>';
  });
}

function setSrchScope(el, scope) {
  srchScope = scope;
  document.querySelectorAll('.schip').forEach(function(c){ c.classList.remove('on'); });
  el.classList.add('on');
  renderSrchResults(document.getElementById('srch').value);
}

function renderSrchResults(q) {
  var res = srchScope === 'all' ? srchResults : srchResults.filter(function(r){ return r.p === srchScope; });
  var area = document.getElementById('srch-results');
  if (!res.length) {
    area.innerHTML = '<div class="srch-idle"><div class="srch-idle-h" style="margin-top:40px">No results for &ldquo;'+q+'&rdquo;</div><p class="srch-idle-p">Try a different term or broaden your scope.</p></div>';
    return;
  }
  var groups = {t:[],f:[],m:[]};
  res.forEach(function(r){ if(groups[r.p]) groups[r.p].push(r); });
  var html = '<div style="padding:10px 16px 4px;font-size:11.5px;color:var(--ink-mut)">' + res.length + ' result' + (res.length===1?'':'s') + ' for <strong style="color:var(--ink)">&ldquo;' + q + '&rdquo;</strong></div>';
  [['t','\u25cb','Wisdom'],['f','\u25b3','Law'],['m','\u25a2','Market']].forEach(function(pg){
    var p=pg[0],glyph=pg[1],label=pg[2];
    if(!groups[p].length) return;
    html += '<div class="results-label">' + glyph + ' ' + label + ' \u2014 ' + groups[p].length + ' result' + (groups[p].length===1?'':'s') + '</div>';
    html += groups[p].map(function(r){
      var bc=p==='t'?'rb-t':p==='f'?'rb-f':'rb-m';
      var ic=p==='t'?'ri-t':p==='f'?'ri-f':'ri-m';
      var badge=r.type==='bill'?'Bill':r.type==='official'?'Official':r.type==='guide'?'Guide':r.type==='community'?'Community':r.type==='rights'?'Rights':'Provider';
      return '<div class="result-card r-'+p+'">'
        +'<div class="r-icon '+ic+'"><i class="ti '+(r.icon||'ti-circle')+'" aria-hidden="true"></i></div>'
        +'<div class="r-body"><div class="r-top"><span class="r-name">'+r.title+'</span><span class="r-badge '+bc+'">'+badge+'</span></div>'
        +'<div class="r-sub">'+(r.subtitle||'')+'</div>'
        +'<div class="r-meta">'+(r.meta||'')+'</div></div></div>';
    }).join('');
  });
  area.innerHTML = html;
}

function resetSrch() {
