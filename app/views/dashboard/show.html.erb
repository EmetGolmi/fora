var _mktLSeq = 0;
var _mktRegistry = {};
var _currentMktListing = null;
var _lastMktContext = null;

function openMktListing(lid) {
  var c = _mktRegistry[lid];
  if (!c) return;
  _currentMktListing = { lid: lid, key: 'mkt:' + c.name };
  document.getElementById('mkt-listing-title').textContent = c.name;
  document.getElementById('mkt-listing-body').innerHTML = buildMktDetailHtml(c);
  switchPanel('market-listing', null);
  loadMktConversation('mkt:' + c.name);
}

function closeMktListing() {
  switchPanel('market', null);
  if (_lastMktContext) {
    if (_lastMktContext.type === 'sub') renderMktCards(_lastMktContext.d.label, _lastMktContext.s.label, _lastMktContext.s.cards);
    else renderMktDomain(_lastMktContext.d);
  }
}

function buildMktDetailHtml(c) {
  // Determine avatar styles
  var avClass, avContent;
  if (c.av) {
    avClass = (c.avClass || 'av-biz') + ' mkt-hero-avatar';
    avContent = c.av + (c.vetBar ? '<div class="vet-bar">'+c.vetBar+'</div>' : '');
    if (c.avStyle) avClass += '" style="' + c.avStyle.replace(/^style="/,'').replace(/"$/,'');
  } else {
    var initials = c.name.split(/\s+/).slice(0,2).map(function(w){return w[0];}).join('').toUpperCase();
    var avCls2 = c.kind==='nbr'?'av-neighbor':c.kind==='prog'?'av-community':'av-biz';
    avClass = avCls2 + ' mkt-hero-avatar';
    avContent = initials;
  }
  var bdgClass = c.bdgClass || (c.kind==='nbr'?'lbdg-neighbor':c.kind==='prog'?'lbdg-prog':c.kind==='fora'?'lbdg-fora':'lbdg-biz');
  var bdgLabel = c.bdgLabel || (c.kind==='nbr'?'Neighbor':c.kind==='prog'?'Program':c.kind==='fora'?'FORA guide':'Business');
  var cleared  = c.cleared ? '<span class="lbdg lbdg-cleared">&#10003; BG cleared</span>' : '';
  var ratingHtml = c.rating
    ? '<span class="mkt-hero-stars">&#9733; '+c.rating+'</span> <span style="color:#999">('+c.reviewCount+' reviews)</span>'
    : (c.stars ? c.stars : '');
  var metaParts = [c.location, c.price].filter(Boolean);
  var urlHtml = c.url
    ? '<a href="'+c.url+'" target="_blank" rel="noopener" onclick="event.stopPropagation()" class="listing-url" style="margin-top:6px">&#127760; '+c.url.replace(/^https?:\/\/(www\.)?/,'').replace(/\/$/,'')+'</a>'
    : '';
  var sp = c.socialProof ? '<div class="social-proof-row" style="margin-top:4px">&#128101; '+c.socialProof+'</div>' : '';
  var tags = (c.tags||[]).map(function(t){return '<span class="ltag">'+t+'</span>';}).join('');
  var tagsHtml = tags ? '<div class="mkt-detail-tags">'+tags+'</div>' : '';
  var descText = c.desc || c.type || '';
  // Reviews
  var reviewsHtml = '';
  if (c.topComment) {
    var revItems = '<div class="mkt-review-item"><div class="mkt-review-av">'+c.topComment.who.split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2)+'</div><div><div class="mkt-review-who">'+c.topComment.who+' <span class="mkt-review-verified">&#10003; verified</span></div><div class="mkt-review-text">'+c.topComment.text+'</div></div></div>';
    if (c.moreReviews) {
      revItems += c.moreReviews.map(function(r){
        return '<div class="mkt-review-item"><div class="mkt-review-av">'+r.av+'</div><div><div class="mkt-review-who">'+r.who+' <span class="mkt-review-verified">&#10003; verified</span></div><div class="mkt-review-text">'+r.text+'</div></div></div>';
      }).join('');
    }
    reviewsHtml = '<div class="mkt-detail-section"><div class="mkt-detail-section-h">Reviews</div>'+revItems+'</div>';
  }
  // Related
  var relatedHtml = c.related ? '<div class="mkt-detail-section" style="font-size:12.5px;color:var(--market)">&#8599; Related: <a href="'+c.related.url+'" target="_blank" rel="noopener" style="color:var(--market);font-weight:700;text-decoration:underline">'+c.related.label+'</a></div>' : '';

  return '<div class="mkt-detail-hero">'
    + '<div class="mkt-hero-top">'
      + '<div class="'+avClass+'">'+avContent+'</div>'
      + '<div class="mkt-hero-main">'
        + '<div class="mkt-hero-name">'+c.name+'</div>'
        + '<div class="mkt-hero-badges"><span class="lbdg '+bdgClass+'">'+bdgLabel+'</span>'+cleared+'</div>'
        + (ratingHtml ? '<div class="mkt-hero-rating">'+ratingHtml+'</div>' : '')
        + (metaParts.length ? '<div class="mkt-hero-meta"><span>'+metaParts.join('</span><span>')+'</span></div>' : '')
      + '</div>'
    + '</div>'
    + sp + urlHtml
    + '</div>'
    + (descText ? '<div class="mkt-detail-desc">'+descText+'</div>' : '')
    + tagsHtml
    + '<div class="mkt-detail-actions">'
      + '<button class="mkt-da-btn mkt-da-primary">Schedule</button>'
      + '<button class="mkt-da-btn mkt-da-sec">Message</button>'
    + '</div>'
    + reviewsHtml
    + relatedHtml
    + '<div class="mkt-detail-section" id="mkt-convo-section">'
      + '<div class="mkt-detail-section-h">Community Conversation</div>'
      + '<div class="mkt-convo-form">'
        + '<textarea class="mkt-convo-input" id="mkt-convo-input" placeholder="Ask a question, share an experience, or leave a note for the community&#8230;" rows="3"></textarea>'
        + '<button class="mkt-convo-submit" onclick="submitMktConversation()">Post</button>'
      + '</div>'
      + '<div id="mkt-convo-list"><div class="mkt-convo-empty">Loading&#8230;</div></div>'
    + '</div>';
}

function loadMktConversation(key) {
  var list = document.getElementById('mkt-convo-list');
  if (!list) return;
  fetch('/mvp/forum/comments?bill_num=' + encodeURIComponent(key), {
    headers: {'X-Requested-With':'XMLHttpRequest'}
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (!data.length) {
      list.innerHTML = '<div class="mkt-convo-empty">No community notes yet \u2014 be the first to share yours.</div>';
    } else {
      list.innerHTML = data.map(function(p) {
        return '<div class="mkt-convo-item">'
          + '<div class="mkt-convo-meta"><span class="mkt-convo-handle">@'+p.handle+'</span><span class="mkt-convo-date">'+p.created_at+'</span></div>'
          + '<div class="mkt-convo-body">'+p.body.replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</div>'
          + '</div>';
      }).join('');
    }
  }).catch(function() {
    if (list) list.innerHTML = '<div class="mkt-convo-empty">Could not load conversation.</div>';
  });
}

function submitMktConversation() {
  if (!_currentMktListing) return;
  var input = document.getElementById('mkt-convo-input');
  var body  = input ? input.value.trim() : '';
  if (!body || body.length < 3) return;
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var btn  = document.querySelector('.mkt-convo-submit');
  if (btn) btn.disabled = true;
  fetch('/mvp/forum/comments', {
    method:  'POST',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'X-Requested-With':'XMLHttpRequest'},
    body:    JSON.stringify({ bill_num: _currentMktListing.key, body: body, perspective_type: 'general' })
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (btn) btn.disabled = false;
    if (data.ok) {
      if (input) input.value = '';
      loadMktConversation(_currentMktListing.key);
    }
  }).catch(function() { if (btn) btn.disabled = false; });
}

(function buildMktNav() {
  var nav = document.getElementById('mkt-nav');
  MKT_DOMS.forEach(function(d) {
    var row = document.createElement('div');

    var hd = document.createElement('div');
    hd.className = 'mkt-dom-h';
    hd.innerHTML = '<i class="ti ' + d.icon + ' mkt-dom-icon"></i><span class="mkt-dom-label">' + d.label + '</span><i class="ti ti-chevron-down mkt-chev"></i>';

    var sl = document.createElement('div');
    sl.className = 'mkt-sub-list';

    d.subs.forEach(function(s) {
      var si = document.createElement('div');
      si.className = 'mkt-sub';
      si.textContent = s.label;
      si.onclick = (function(d,s){ return function(e) {
        e.stopPropagation();
        document.querySelectorAll('.mkt-sub').forEach(function(x){x.classList.remove('on');});
        si.classList.add('on');
        _lastMktContext = {type:'sub', d:d, s:s};
        switchPanel('market', null);
        renderMktCards(d.label, s.label, s.cards);
      }; })(d, s);
      sl.appendChild(si);
    });

    hd.onclick = function() {
      var isOpen = sl.classList.contains('open');
      document.querySelectorAll('.mkt-sub-list').forEach(function(x){x.classList.remove('open');});
      document.querySelectorAll('.mkt-dom-h').forEach(function(x){x.classList.remove('on','open');});
      if (!isOpen) {
        sl.classList.add('open');
        hd.classList.add('on','open');
        _lastMktContext = {type:'domain', d:d};
        switchPanel('market', null);
        renderMktDomain(d);
      }
    };

    row.appendChild(hd);
    row.appendChild(sl);
    nav.appendChild(row);
  });
})();

function renderMktDomain(d) {
  var all = [];
  d.subs.forEach(function(s){ s.cards.forEach(function(c){ all.push(c); }); });
  var unique = all.filter(function(c,i,a){ return a.findIndex(function(x){return x.name===c.name;})===i; }).slice(0,8);
  renderMktCards(d.label, 'All subcategories', unique);
}

