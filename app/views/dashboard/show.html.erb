}

// ── Home Wall & Weather Station ────────────────────────────────────────────
var WMO_DESC = {
  0:'Clear sky',1:'Mainly clear',2:'Partly cloudy',3:'Overcast',
  45:'Fog',48:'Icy fog',
  51:'Light drizzle',53:'Drizzle',55:'Heavy drizzle',
  61:'Light rain',63:'Rain',65:'Heavy rain',
  71:'Light snow',73:'Snowfall',75:'Heavy snowfall',77:'Snow grains',
  80:'Rain showers',81:'Showers',82:'Violent showers',
  85:'Snow showers',86:'Heavy snow showers',
  95:'Thunderstorm',96:'Thunderstorm & hail',99:'Severe thunderstorm'
};
var WMO_ICON = {
  0:'ti-sun',1:'ti-sun',2:'ti-cloud-sun',3:'ti-cloud',
  45:'ti-mist',48:'ti-mist',
  51:'ti-cloud-drizzle',53:'ti-cloud-drizzle',55:'ti-cloud-drizzle',
  61:'ti-cloud-rain',63:'ti-cloud-rain',65:'ti-cloud-rain',
  71:'ti-snowflake',73:'ti-snowflake',75:'ti-snowflake',77:'ti-snowflake',
  80:'ti-cloud-rain',81:'ti-cloud-rain',82:'ti-cloud-rain',
  95:'ti-cloud-storm',96:'ti-cloud-storm',99:'ti-cloud-storm'
};
var wsData = null, wsActiveKey = 'uv', wsActiveTab = 0;

function degToDir(d) {
  var dirs = ['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];
  return dirs[Math.round(d/22.5)%16];
}
function uvMeta(v) {
  if (v<=2) return {l:'Low',cls:'pill-ok'};
  if (v<=5) return {l:'Moderate',cls:'pill-mod'};
  if (v<=7) return {l:'High',cls:'pill-warn'};
  if (v<=10) return {l:'Very high',cls:'pill-high'};
  return {l:'Extreme',cls:'pill-high'};
}
function aqiMeta(v) {
  if (v<=50) return {l:'Good',cls:'pill-ok'};
  if (v<=100) return {l:'Moderate',cls:'pill-mod'};
  if (v<=150) return {l:'Sensitive groups',cls:'pill-warn'};
  return {l:'Unhealthy',cls:'pill-high'};
}
function getMoonPhase() {
  var known = new Date(2025,0,29,12,36); // known new moon
  var cycle = 29.53058770576;
  var age = (((new Date()-known)/86400000)%cycle+cycle)%cycle;
  var pct = Math.round((age/cycle)*100);
  var p = age<1.85?'New moon':age<7.38?'Waxing crescent':age<9.22?'First quarter':
          age<14.77?'Waxing gibbous':age<16.61?'Full moon':age<22.15?'Waning gibbous':
          age<23.99?'Last quarter':'Waning crescent';
  return {phase:p, pct:pct, age:age};
}

function wsLoadWeather() {
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      function(p){ wsFetch(p.coords.latitude, p.coords.longitude); },
      function(){ wsFetch(39.9526,-75.1652); },
      {timeout:6000, maximumAge:300000}
    );
  } else { wsFetch(39.9526,-75.1652); }
}

function wsFetch(lat, lon) {
  var m = 'https://api.open-meteo.com/v1/forecast?latitude='+lat.toFixed(4)+'&longitude='+lon.toFixed(4)
    +'&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,wind_direction_10m,weather_code,visibility'
    +'&hourly=uv_index&daily=uv_index_max&timezone=auto&temperature_unit=fahrenheit&wind_speed_unit=mph&forecast_days=1';
  var a = 'https://air-quality-api.open-meteo.com/v1/air-quality?latitude='+lat.toFixed(4)+'&longitude='+lon.toFixed(4)
    +'&current=us_aqi&timezone=auto';
  var n = 'https://api.weather.gov/points/'+lat.toFixed(4)+','+lon.toFixed(4);
  Promise.all([
    fetch(m).then(function(r){return r.json();}),
    fetch(a).then(function(r){return r.json();}).catch(function(){return null;}),
    fetch(n).then(function(r){return r.json();}).catch(function(){return null;})
  ]).then(function(res){
    var meteo=res[0], aqi=res[1], nws=res[2];
    var cur = meteo.current;
    var moon = getMoonPhase();
    var wall = document.getElementById('home-wall');
    var locLabel = (wall.dataset.city||'')+(wall.dataset.state?' · '+wall.dataset.state:'');
    if (!locLabel && nws && nws.properties && nws.properties.relativeLocation) {
      var rl = nws.properties.relativeLocation.properties;
      locLabel = rl.city + ', ' + rl.state;
    }
    if (!locLabel) locLabel = 'Your area';
    var uvArr = (meteo.hourly && meteo.hourly.uv_index) || [];
    var uvTimes = (meteo.hourly && meteo.hourly.time) || [];
    var curHour = cur.time.substring(0,13);
    var uvIdx = uvTimes.findIndex(function(t){return t.startsWith(curHour);});
    var uvNow = uvIdx>=0 ? uvArr[uvIdx] : (meteo.daily&&meteo.daily.uv_index_max?meteo.daily.uv_index_max[0]:0);
    var aqiVal = aqi && aqi.current ? Math.round(aqi.current.us_aqi||0) : null;
    var visMi = Math.min(Math.round(cur.visibility/1609.34),10);
    wsData = {
      temp: Math.round(cur.temperature_2m),
      feels: Math.round(cur.apparent_temperature),
      humidity: cur.relative_humidity_2m,
      condition: WMO_DESC[cur.weather_code]||'Partly cloudy',
      condIcon: WMO_ICON[cur.weather_code]||'ti-cloud-sun',
      wind: Math.round(cur.wind_speed_10m),
      windDir: degToDir(cur.wind_direction_10m),
      visMi: visMi,
      uv: Math.round(uvNow),
      aqi: aqiVal,
      moon: moon,
      locLabel: locLabel,
      updatedAt: new Date().toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit'})
    };
    wsRender();
  }).catch(function(){
    document.getElementById('weather-station').innerHTML =
      '<div class="ws-loading" style="color:var(--ink-soft)"><i class="ti ti-cloud-off" style="font-size:20px;display:block;margin-bottom:6px"></i>Weather unavailable right now</div>';
  });
}

function wsRender() {
  var d = wsData;
  if (!d) return;
  var uvm = uvMeta(d.uv);
  var aqm = d.aqi!=null ? aqiMeta(d.aqi) : {l:'N/A',cls:'pill-mod'};
  var aqiVal = d.aqi!=null ? d.aqi : '—';
  var feelsDiff = d.feels - d.temp;
  var feelsNote = feelsDiff>4?'Heat index':feelsDiff<-4?'Wind chill':'Same as actual';
  var heatCls = feelsDiff>4?'pill-warn':feelsDiff<-4?'pill-mod':'pill-ok';
  var heatLbl = feelsDiff>4?'Caution':feelsDiff<-4?'Wind chill':'Comfortable';
  var windLbl = d.wind<8?'Calm':d.wind<20?'Light breeze':d.wind<30?'Moderate':'Strong';
  var windCls = d.wind<20?'pill-ok':d.wind<30?'pill-mod':'pill-warn';
  var visCls = d.visMi>=8?'pill-ok':d.visMi>=3?'pill-mod':'pill-warn';
  var visLbl = d.visMi>=8?'Excellent':d.visMi>=3?'Good':'Low';

  var html = '<div class="ws-header">'
    +'<div><div style="font-size:15px;font-weight:600;color:var(--ink)">Weather station</div>'
    +'<div class="ws-city"><i class="ti ti-map-pin" style="font-size:11px"></i> '+wsEsc(d.locLabel)+'</div></div>'
    +'<div style="display:flex;align-items:center;gap:8px">'
    +'<div class="ws-updated">Updated '+wsEsc(d.updatedAt)+'</div>'
    +'<div class="ws-share-wrap"><button class="lshare-btn" id="ws-share-btn" style="position:static;width:auto;padding:4px 8px;font-size:11px;gap:4px" onclick="event.stopPropagation();wsShareWeather()" title="Share"><i class="ti ti-share-2"></i></button>'
    +'<div class="lshare-menu" id="ws-share"></div></div>'
    +'</div></div>';

  html += '<div class="ws-hero">'
    +'<div class="ws-temp-big">'+d.temp+'°</div>'
    +'<div class="ws-hero-meta">'
    +'<div class="ws-condition"><i class="ti '+d.condIcon+'" style="margin-right:4px"></i>'+wsEsc(d.condition)+'</div>'
    +'<div class="ws-feels">Feels like <span>'+d.feels+'°</span> &mdash; humidity '+d.humidity+'%</div>'
    +'<div style="margin-top:9px;display:flex;gap:8px;flex-wrap:wrap">'
    +'<span style="font-size:11px;color:#8aaad0"><i class="ti ti-wind"></i> '+d.wind+' mph '+wsEsc(d.windDir)+'</span>'
    +'<span style="font-size:11px;color:#8aaad0"><i class="ti ti-eye"></i> '+d.visMi+' mi</span>'
    +'<span style="font-size:11px;color:#8aaad0"><i class="ti ti-droplet"></i> '+d.humidity+'%</span>'
    +'</div>'
    +'</div></div>';

  html += '<div class="ws-grid" id="ws-metric-grid">';
  html += wsMetricCard('uv','UV index',d.uv,'',Math.min(Math.round((d.uv/11)*100),100),'#e24b4a',uvm.cls,uvm.l);
  html += wsMetricCard('feels','Feels like',d.feels+'°',feelsNote,Math.min(Math.round(((d.feels-32)/88)*100),100),'#ba7517',heatCls,heatLbl);
  html += wsMetricCard('aqi','Air quality',aqiVal,'AQI',aqiVal!='—'?Math.min(Math.round((aqiVal/150)*100),100):0,'#ef9f27',aqm.cls,aqm.l);
  html += wsMetricCard('moon','Moon',d.moon.pct+'%',d.moon.phase,d.moon.pct,'#1b3a6b','pill-mod','');
  html += wsMetricCard('wind','Wind',d.wind+' mph',d.windDir+' &mdash; gusts',Math.min(Math.round((d.wind/30)*100),100),'#1d9e75',windCls,windLbl);
  html += wsMetricCard('vis','Visibility',d.visMi+' mi','Clear sightlines',Math.min(Math.round((d.visMi/10)*100),100),'#1d9e75',visCls,visLbl);
  html += '</div>';

  html += '<div class="ws-detail" id="ws-detail"><div id="ws-detail-content"></div></div>';

  document.getElementById('weather-station').innerHTML = html;
  wsShowDetail(wsActiveKey);
}

function wsShareWeather() {
  if (!wsData) return;
  toggleShareMenu('ws-share', 'FORA Weather Station \u2014 ' + wsData.locLabel, window.location.href);
}

function wsMetricCard(key, label, val, unit, pct, fillColor, pillCls, pillLbl) {
  var act = key===wsActiveKey?' active':'';
  return '<div class="ws-card'+act+'" onclick="wsShowDetail(\''+key+'\')" data-wskey="'+key+'">'
    +'<div class="ws-card-label">'+label+'</div>'
    +'<div class="ws-card-val">'+val+'</div>'
    +(unit?'<div class="ws-card-unit">'+unit+'</div>':'')
    +'<div class="ws-card-bar"><div class="ws-card-fill" style="width:'+pct+'%;background:'+fillColor+'"></div></div>'
    +(pillLbl?'<span class="ws-pill '+pillCls+'">'+pillLbl+'</span>':'')
    +'</div>';
}

