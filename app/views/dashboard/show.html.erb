        + '<button class="mkt-convo-submit" onclick="submitMktConversation()">Post</button>'
      + '</div>'
      + '<div id="mkt-convo-list"><div class="mkt-convo-empty">Loading&#8230;</div></div>'
    + '</div>';
}

function loadMktConversation(key) {
  var list = document.getElementById('mkt-convo-list');
  if (!list) return;
  fetch('/mvp/forum/comments?bill_num=' + encodeURIComponent(key), {
    headers: {'X-Requested-With':'XMLHttpRequest'}
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (!data.length) {
      list.innerHTML = '<div class="mkt-convo-empty">No community notes yet \u2014 be the first to share yours.</div>';
    } else {
      list.innerHTML = data.map(function(p) {
        return '<div class="mkt-convo-item">'
          + '<div class="mkt-convo-meta"><span class="mkt-convo-handle">@'+p.handle+'</span><span class="mkt-convo-date">'+p.created_at+'</span></div>'
          + '<div class="mkt-convo-body">'+p.body.replace(/</g,'&lt;').replace(/>/g,'&gt;')+'</div>'
          + '</div>';
      }).join('');
    }
  }).catch(function() {
    if (list) list.innerHTML = '<div class="mkt-convo-empty">Could not load conversation.</div>';
  });
}

function submitMktConversation() {
  if (!_currentMktListing) return;
  var input = document.getElementById('mkt-convo-input');
  var body  = input ? input.value.trim() : '';
  if (!body || body.length < 3) return;
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var btn  = document.querySelector('.mkt-convo-submit');
  if (btn) btn.disabled = true;
  fetch('/mvp/forum/comments', {
    method:  'POST',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'X-Requested-With':'XMLHttpRequest'},
    body:    JSON.stringify({ bill_num: _currentMktListing.key, body: body, perspective_type: 'general' })
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (btn) btn.disabled = false;
    if (data.ok) {
      if (input) input.value = '';
      loadMktConversation(_currentMktListing.key);
    }
  }).catch(function() { if (btn) btn.disabled = false; });
}

(function buildMktNav() {
  var nav = document.getElementById('mkt-nav');
  MKT_DOMS.forEach(function(d) {
    var row = document.createElement('div');

    var hd = document.createElement('div');
    hd.className = 'mkt-dom-h';
    hd.innerHTML = '<i class="ti ' + d.icon + ' mkt-dom-icon"></i><span class="mkt-dom-label">' + d.label + '</span><i class="ti ti-chevron-down mkt-chev"></i>';

    var sl = document.createElement('div');
    sl.className = 'mkt-sub-list';

    d.subs.forEach(function(s) {
      var si = document.createElement('div');
      si.className = 'mkt-sub';
      si.textContent = s.label;
      si.onclick = (function(d,s){ return function(e) {
        e.stopPropagation();
        document.querySelectorAll('.mkt-sub').forEach(function(x){x.classList.remove('on');});
        si.classList.add('on');
        _lastMktContext = {type:'sub', d:d, s:s};
        switchPanel('market', null);
        renderMktCards(d.label, s.label, s.cards);
      }; })(d, s);
      sl.appendChild(si);
    });

    hd.onclick = function() {
      var isOpen = sl.classList.contains('open');
      document.querySelectorAll('.mkt-sub-list').forEach(function(x){x.classList.remove('open');});
      document.querySelectorAll('.mkt-dom-h').forEach(function(x){x.classList.remove('on','open');});
      if (!isOpen) {
        sl.classList.add('open');
        hd.classList.add('on','open');
        _lastMktContext = {type:'domain', d:d};
        switchPanel('market', null);
        renderMktDomain(d);
      }
    };

    row.appendChild(hd);
    row.appendChild(sl);
    nav.appendChild(row);
  });
})();

function renderMktDomain(d) {
  var all = [];
  d.subs.forEach(function(s){ s.cards.forEach(function(c){ all.push(c); }); });
  var unique = all.filter(function(c,i,a){ return a.findIndex(function(x){return x.name===c.name;})===i; });
  renderMktCards(d.label, 'All subcategories', unique);
}

