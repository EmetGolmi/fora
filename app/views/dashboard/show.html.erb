function _mktTileLayer(map) {
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19
  }).addTo(map);
}

function _svcCenter() {
  var label = '<%= j @profile.place_label.to_s.downcase %>';
  var city  = '<%= j @profile.address_city.to_s.downcase %>';
  var keys  = Object.keys(PHILLY_HOODS);
  for (var i = 0; i < keys.length; i++) {
    if (label.indexOf(keys[i]) !== -1 || city.indexOf(keys[i]) !== -1) return PHILLY_HOODS[keys[i]];
  }
  return [39.9526, -75.1652];
}

function _addUserSvcCircle(map) {
  if (!_userSvcRadiusMi || _userSvcRadiusMi <= 0) return;
  L.circle(_svcCenter(), {
    radius: _userSvcRadiusMi * 1609.34,
    color: '#1b3a6b', fillColor: '#3a6abf', fillOpacity: 0.07, weight: 2, dashArray: '6,5'
  }).bindTooltip('My service area', {direction: 'top'}).addTo(map);
}

