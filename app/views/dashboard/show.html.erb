  if (_mktMapD || !document.getElementById('mkt-map-d')) return;
  _mktMapD = L.map('mkt-map-d', {zoomControl:true, scrollWheelZoom:true})
              .setView([39.9526,-75.1652], 13);
  _mktTileLayer(_mktMapD);
  _addUserSvcCircle(_mktMapD);
}

function initMktMapM() {
  if (_mktMapM || !document.getElementById('mkt-map-m')) return;
  _mktMapM = L.map('mkt-map-m', {zoomControl:true, scrollWheelZoom:false})
              .setView([39.9526,-75.1652], 13);
  _mktTileLayer(_mktMapM);
  _addUserSvcCircle(_mktMapM);
}

function _coordsForLoc(lid, loc) {
  if (_mktCoords[lid]) return _mktCoords[lid]; // reuse stable jitter
  var lower = (loc || '').toLowerCase();
  var keys  = Object.keys(PHILLY_HOODS);
  var base  = [39.9526, -75.1652]; // fallback: Center City
  for (var i = 0; i < keys.length; i++) {
    if (lower.indexOf(keys[i]) !== -1) { base = PHILLY_HOODS[keys[i]]; break; }
  }
  var coords = [base[0] + (Math.random()-0.5)*0.005, base[1] + (Math.random()-0.5)*0.005];
  _mktCoords[lid] = coords;
  return coords;
}

function _mktPinIcon(kind) {
  var bg = kind === 'prog' ? '#155c2d' : kind === 'nbr' ? '#2a9d5c' : '#1b3a6b';
  return L.divIcon({
    className: '',
    html: '<div style="width:13px;height:13px;border-radius:50%;background:'+bg+';border:2.5px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.45)"></div>',
    iconSize: [13,13], iconAnchor:[6,6], popupAnchor:[0,-9]
  });
}

function renderMktMapPins(lids) {
  if (!lids || !lids.length) return;
  // Clear old markers and service circles
  Object.keys(_mktMarkersD).forEach(function(k){ if (_mktMapD) _mktMapD.removeLayer(_mktMarkersD[k]); });
  Object.keys(_mktMarkersM).forEach(function(k){ if (_mktMapM) _mktMapM.removeLayer(_mktMarkersM[k]); });
  Object.keys(_mktCirclesD).forEach(function(k){ if (_mktMapD) _mktMapD.removeLayer(_mktCirclesD[k]); });
  Object.keys(_mktCirclesM).forEach(function(k){ if (_mktMapM) _mktMapM.removeLayer(_mktCirclesM[k]); });
  _mktMarkersD = {}; _mktMarkersM = {};
  _mktCirclesD = {}; _mktCirclesM = {};

  var bounds = [];
  lids.forEach(function(lid) {
    var c = _mktRegistry[lid];
    if (!c) return;
    var coords = _coordsForLoc(lid, c.location || '');
    bounds.push(coords);
    var popup = '<div style="font-size:12px;min-width:150px;line-height:1.5">'
      + '<strong style="color:#1b3a6b">'+c.name+'</strong><br>'
      + '<span style="color:#666;font-size:11px">'+(c.location||'')+'</span><br>'
      + '<a href="#" onclick="event.preventDefault();openMktListing(\''+lid+'\')" style="color:#155c2d;font-weight:700;font-size:11px">Expand for Conversation →</a>'
      + '</div>';
    var icon = _mktPinIcon(c.kind || '');
    if (_mktMapD) { _mktMarkersD[lid] = L.marker(coords,{icon:icon}).bindPopup(popup).addTo(_mktMapD); }
    if (_mktMapM) { _mktMarkersM[lid] = L.marker(coords,{icon:icon}).bindPopup(popup).addTo(_mktMapM); }
    if (c.svcRadius) {
      var cOpts = {radius:c.svcRadius*1609.34,color:'#155c2d',fillColor:'#1f7a3e',fillOpacity:0.10,weight:1.5,dashArray:'5,4'};
      if (_mktMapD) _mktCirclesD[lid] = L.circle(coords, cOpts).addTo(_mktMapD);
      if (_mktMapM) _mktCirclesM[lid] = L.circle(coords, cOpts).addTo(_mktMapM);
    }
  });

  if (bounds.length) {
    _mktBounds = L.latLngBounds(bounds);
    if (_mktMapD) _mktMapD.fitBounds(_mktBounds, {padding:[24,24], maxZoom:15});
    if (_mktMapM) _mktMapM.fitBounds(_mktBounds, {padding:[20,20], maxZoom:15});
  }
}

function zoomMktPin(lid) {
  var md = _mktMarkersD[lid], cd = _mktCirclesD[lid];
  if (_mktMapD) {
    if (cd) _mktMapD.fitBounds(cd.getBounds(), {padding:[30,30]});
    else if (md) _mktMapD.setView(md.getLatLng(), 16, {animate:true});
    if (md) md.openPopup();
  }
  var mm = _mktMarkersM[lid], cm = _mktCirclesM[lid];
  if (_mktMapM) {
    if (cm) _mktMapM.fitBounds(cm.getBounds(), {padding:[20,20]});
    else if (mm) _mktMapM.setView(mm.getLatLng(), 16, {animate:true});
    if (mm) mm.openPopup();
  }
}

function resetMktMapExtent() {
  if (_mktBounds) {
    if (_mktMapD) _mktMapD.fitBounds(_mktBounds, {padding:[24,24], maxZoom:15});
    if (_mktMapM) _mktMapM.fitBounds(_mktBounds, {padding:[20,20], maxZoom:15});
  }
}

function mktViewToggle(mode) {
  var lb = document.getElementById('mvt-list');
  var mb = document.getElementById('mvt-map');
  var main = document.getElementById('mkt-main');
  var wrap = document.getElementById('mkt-map-m-wrap');
  if (mode === 'map') {
    if (lb) lb.classList.remove('on');
    if (mb) mb.classList.add('on');
    if (main) main.style.display = 'none';
    if (wrap) {
      wrap.style.display = 'block';
      setTimeout(function(){
        initMktMapM();
        if (_mktMapM) {
          _mktMapM.invalidateSize();
          if (_mktBounds) _mktMapM.fitBounds(_mktBounds, {padding:[20,20], maxZoom:15});
        }
      }, 0);
    }
  } else {
    if (lb) lb.classList.add('on');
    if (mb) mb.classList.remove('on');
    if (main) main.style.display = '';
    if (wrap) wrap.style.display = 'none';
  }
}

