var TPL_KIND_META = {
  guide:    {label:'FORA Guide',    icon:'\uD83D\uDCCB'},
  fora:     {label:'FORA Guide',    icon:'\uD83D\uDCCB'},
  psa:      {label:'Community PSA', icon:'\uD83D\uDCE2'},
  resource: {label:'Resource',      icon:'\uD83D\uDD17'},
  tool:     {label:'Interactive',   icon:'\uD83D\uDEE0'},
  nbr:      {label:'Neighbor',      icon:'\uD83D\uDC64'},
  prog:     {label:'Program',       icon:'\uD83C\uDFDB'}
};

function tplCardHtml(c, idx) {
  var bid = 'tplc-' + idx;
  var km = TPL_KIND_META[c.kind] || TPL_KIND_META.guide;
  var convoKey = 'tpl:' + c.name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
  var psaHd = '';
  if (c.psa) {
    psaHd = '<div class="tpl-psa-hd">'
      + '<div class="tpl-psa-logo">' + (c.psa.logo || (c.psa.name||'').slice(0,3).toUpperCase()) + '</div>'
      + '<div><div class="tpl-psa-org">' + (c.psa.name||'') + '</div>'
      + '<div class="tpl-psa-sub">Community partner</div></div>'
      + '<span class="tpl-psa-sponsored">Sponsored</span></div>';
  }
  var bodyParts = [];
  if (c.expand) bodyParts.push('<div class="tpl-body-text">' + c.expand + '</div>');
  if (c.links && c.links.length) {
    bodyParts.push('<div class="tpl-card-links">' + c.links.map(function(l){
      return '<a class="tpl-card-link" href="' + (l.url||'#') + '" target="_blank" rel="noopener" onclick="event.stopPropagation()">'
        + '<span>' + (l.icon||'\u2192') + '</span><span>' + l.label + '</span></a>';
    }).join('') + '</div>');
  }
  if (c.widget === 'reminder' && c.reminders && c.reminders.length) {
    bodyParts.push(buildTplReminderWidget(c.reminders, idx));
  }
  if (c.psa) bodyParts.push('<div class="tpl-psa-edict">FORA ad policy: sponsors earn placement by contributing to the community.</div>');
  bodyParts.push(tplConvoHtml(bid));
  return '<div class="tpl-card" id="' + bid + '" data-convo-key="' + convoKey + '">'
    + psaHd
    + '<div class="tpl-card-head" onclick="toggleTplCard(\'' + bid + '\')">'
      + '<div class="tpl-card-av ' + c.kind + '">' + km.icon + '</div>'
      + '<div class="tpl-card-main">'
        + '<div class="tpl-card-name">' + c.name + '</div>'
        + ((c.desc||c.type) ? '<div class="tpl-card-short">' + (c.desc||c.type) + '</div>' : '')
        + '<span class="tpl-card-badge ' + c.kind + '">' + km.label + '</span>'
      + '</div>'
      + '<span class="tpl-card-chev">\u25be</span>'
    + '</div>'
    + '<div class="tpl-card-body">' + bodyParts.join('') + '</div>'
    + '</div>';
}

function toggleTplCard(id) {
  var el = document.getElementById(id);
  if (!el) return;
  var opening = !el.classList.contains('open');
  el.classList.toggle('open');
  if (opening && !el.dataset.convoLoaded) {
    el.dataset.convoLoaded = '1';
    loadTplConversation(id, el.dataset.convoKey);
  }
}

function tplConvoHtml(bid) {
  return '<div class="tpl-convo" id="' + bid + '-convo">'
    + '<div class="tpl-convo-hd">Contribute to the Conversation</div>'
    + '<textarea class="tpl-convo-input" id="' + bid + '-input" placeholder="Share your experience or knowledge\u2026" rows="3" onclick="event.stopPropagation()"></textarea>'
    + '<div class="tpl-convo-foot">'
      + '<button class="tpl-convo-submit" onclick="event.stopPropagation();submitTplConversation(\'' + bid + '\')">Post</button>'
      + '<span class="tpl-convo-err" id="' + bid + '-err" style="display:none"></span>'
    + '</div>'
    + '<div id="' + bid + '-notes"><div class="tpl-convo-empty">Loading\u2026</div></div>'
    + '</div>';
}

function loadTplConversation(bid, key) {
  if (!key) return;
  fetch('/mvp/forum/comments?bill_num=' + encodeURIComponent(key), {
    headers: {'X-Requested-With':'XMLHttpRequest'}
  }).then(function(r){ return r.json(); }).then(function(data) {
    var el = document.getElementById(bid + '-notes');
    if (!el) return;
    if (!data.length) {
      el.innerHTML = '<div class="tpl-convo-empty">No notes yet \u2014 be the first.</div>';
      return;
    }
    el.innerHTML = data.map(function(p) {
      return '<div class="tpl-convo-item">'
        + '<div class="tpl-convo-meta">'
          + '<span class="tpl-convo-handle">@' + p.handle + '</span>'
          + '<span class="tpl-convo-date">' + p.created_at + '</span>'
        + '</div>'
        + '<div class="tpl-convo-body">' + p.body.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>'
        + '</div>';
    }).join('');
  }).catch(function() {
    var el = document.getElementById(bid + '-notes');
    if (el) el.innerHTML = '<div class="tpl-convo-empty">Could not load notes.</div>';
  });
}

function submitTplConversation(bid) {
  var card = document.getElementById(bid);
  if (!card) return;
  var key = card.dataset.convoKey;
  var body = (document.getElementById(bid + '-input') || {}).value.trim();
  var errEl = document.getElementById(bid + '-err');
  if (!body || body.length < 3) {
    errEl.textContent = 'Please write at least a few words.';
    errEl.style.display = '';
    return;
  }
  errEl.style.display = 'none';
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var btn = card.querySelector('.tpl-convo-submit');
  if (btn) btn.disabled = true;
  fetch('/mvp/forum/comments', {
    method: 'POST',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'X-Requested-With':'XMLHttpRequest'},
    body: JSON.stringify({ bill_num: key, body: body, perspective_type: 'general' })
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (btn) btn.disabled = false;
    if (data.ok) {
      document.getElementById(bid + '-input').value = '';
      loadTplConversation(bid, key);
    } else {
      errEl.textContent = (data.errors || ['Error posting']).join(', ');
      errEl.style.display = '';
    }
  }).catch(function() {
    if (btn) btn.disabled = false;
    errEl.textContent = 'Network error \u2014 please try again.';
    errEl.style.display = '';
  });
}

function buildTplReminderWidget(reminders, baseIdx) {
  var html = '<div class="tpl-reminder"><div class="tpl-reminder-h">Set Maintenance Reminders</div>';
  reminders.forEach(function(r, i) {
    var rid = 'rem-' + baseIdx + '-' + i;
    html += '<div class="tpl-rem-item">'
      + '<div><div class="tpl-rem-label">' + r.label + '</div>'
      + '<div class="tpl-rem-freq">' + r.freq + '</div></div>'
      + '<button class="tpl-rem-btn" id="' + rid + '" onclick="event.stopPropagation();setTplReminder(\'' + rid + '\')">Remind me</button>'
      + '</div>';
  });
  return html + '</div>';
}

function setTplReminder(btnId) {
  var btn = document.getElementById(btnId);
  if (btn) { btn.className = 'tpl-rem-set'; btn.textContent = '\u2713 Set'; }
}

