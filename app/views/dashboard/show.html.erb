    </div>
    <div class="mkt-view-toggle">
      <button class="mvt-btn on" id="mvt-list" onclick="mktViewToggle('list')">&#8801; List</button>
      <button class="mvt-btn" id="mvt-map" onclick="mktViewToggle('map')">&#9675; Map</button>
    </div>
    <div id="mkt-map-m-wrap"><div id="mkt-map-m"></div></div>
    <div id="mkt-main"><p class="mkt-empty-state">Select a category from the left to explore your neighborhood marketplace.</p></div>
  </div>

  <%# ── MARKET LISTING DETAIL PANEL ─────────────────────────────────────── %>
  <div id="panel-market-listing" style="display:none">
    <div class="mkt-detail-head">
      <button class="mkt-detail-back" onclick="closeMktListing()"><i class="ti ti-arrow-left"></i> Back</button>
      <div class="mkt-detail-title" id="mkt-listing-title">Provider</div>
    </div>
    <div class="mkt-detail-body" id="mkt-listing-body"></div>
  </div><%# /panel-market-listing %>

  <%# ── SERVICE AREA PANEL ─────────────────────────────────────────────────── %>
  <div id="panel-service-area" style="display:none">
    <% if @profile.provider_mode? && !@profile.card_builder_complete? %>
      <%# ── WIZARD MODE ──────────────────────────────────────────────────────── %>
      <div class="svc-head">
        <div class="svc-head-title">▢ My Services</div>
        <div class="svc-head-sub">Set up your public provider card — appear on the marketplace and share a link with clients.</div>
      </div>
      <div style="padding:16px 20px 28px">
        <div class="ms-stepbar" id="ms-stepbar">
          <div class="ms-sb-step" data-s="1">Trade</div>
          <div class="ms-sb-step" data-s="2">Headline</div>
          <div class="ms-sb-step" data-s="3">Portfolio</div>
          <div class="ms-sb-step" data-s="4">Area</div>
          <div class="ms-sb-step" data-s="5">Wisdom</div>
          <div class="ms-sb-step" data-s="6">Live!</div>
        </div>

        <%# Step 1: Trade & Identity %>
        <div class="ms-step" id="ms-s1">
          <div class="ms-eyebrow">Step 1 of 6 — Trade &amp; Identity</div>
          <div class="ms-step-h">What's your trade?</div>
          <div class="ms-step-sub">Your business name becomes your FORA handle — a permanent link to your public card.</div>
          <div class="ms-field">
            <label class="ms-label" for="ms-biz-name">Business or trade name</label>
            <input class="ms-input" id="ms-biz-name" type="text"
                   placeholder="e.g. Philly Fresh Paint Co."
                   value="<%= @profile.market_display_name.presence || @profile.market_entity_name.presence || "" %>"
                   oninput="msOnBizNameInput(this.value)">
            <div class="ms-handle-row">
              <span class="ms-handle-prefix" id="ms-handle-prefix">fora.center/<%= @profile.locode.presence || "[city]" %>/</span>
              <span class="ms-handle-slug" id="ms-handle-slug"><%= @profile.provider_handle.presence || "your-handle" %></span>
              <span class="ms-handle-status" id="ms-handle-status"></span>
            </div>
          </div>
          <div class="ms-field">
            <label class="ms-label">Trade classification</label>
            <input class="ms-occ-search" id="ms-occ-search" type="text"
                   placeholder="Search your trade…"
                   oninput="msSearchOcc(this.value)">
            <div class="ms-occ-filters" id="ms-occ-filters">
              <button class="ms-occ-pill on" data-group="all" onclick="msFilterOcc('all',this)">All</button>
              <button class="ms-occ-pill" data-group="7" onclick="msFilterOcc('7',this)">7 · Craft</button>
              <button class="ms-occ-pill" data-group="2" onclick="msFilterOcc('2',this)">2 · Professional</button>
              <button class="ms-occ-pill" data-group="5" onclick="msFilterOcc('5',this)">5 · Service</button>
              <button class="ms-occ-pill" data-group="3" onclick="msFilterOcc('3',this)">3 · Technical</button>
              <button class="ms-occ-pill" data-group="9" onclick="msFilterOcc('9',this)">9 · Elementary</button>
              <button class="ms-occ-pill" data-group="1" onclick="msFilterOcc('1',this)">1 · Manager</button>
              <button class="ms-occ-pill" data-group="6" onclick="msFilterOcc('6',this)">6 · Agricultural</button>
            </div>
            <div class="ms-occ-list" id="ms-occ-list"></div>
            <div class="ms-occ-breakdown" id="ms-occ-breakdown">
              <div class="ms-occ-bd-title" id="ms-occ-bd-title"></div>
              <div class="ms-occ-bd-row">
                <span class="ms-occ-bd-label">ISCO-08</span>
                <span class="ms-occ-bd-val" id="ms-occ-bd-isco"></span>
                <span class="ms-occ-bd-tag">global standard</span>
              </div>
              <div class="ms-occ-bd-row">
                <span class="ms-occ-bd-label">NAICS</span>
                <span class="ms-occ-bd-val" id="ms-occ-bd-naics"></span>
                <span class="ms-occ-bd-tag">US gov contracting</span>
              </div>
              <div class="ms-occ-bd-row">
                <span class="ms-occ-bd-label">O*NET</span>
                <span class="ms-occ-bd-val" id="ms-occ-bd-onet"></span>
                <span class="ms-occ-bd-tag">US workforce database</span>
              </div>
              <div class="ms-occ-note">
                NAICS <span id="ms-occ-bd-naics-note"></span> is the code used for SAM.gov registration, SBA certifications, and federal set-aside programs.
              </div>
            </div>
          </div>
          <div class="ms-note ms-note-m">
            <b>Your neighborhood</b> — <%= @profile.place_label.presence || "location on file" %><br>
            <span style="font-size:9.5px;color:var(--ink-mut)">This appears on your public card as your base area.</span>
          </div>
          <div class="ms-err" id="ms-s1-err"></div>
          <div class="ms-nav-row">
            <button class="ms-btn ms-btn-primary" style="margin-left:auto" id="ms-s1-btn" onclick="msSubmitTrade()">Continue →</button>
          </div>
        </div>

        <%# Step 2: Headline & Summary %>
        <div class="ms-step" id="ms-s2">
          <div class="ms-eyebrow">Step 2 of 6 — Headline &amp; Summary</div>
          <div class="ms-step-h">Tell them what you do</div>
          <div class="ms-step-sub">Your headline is the first thing homeowners read. Make it specific.</div>
          <div class="ms-field">
            <label class="ms-label" for="ms-hl-input">Headline <span style="font-weight:400;color:var(--ink-mut)">(15 words max)</span></label>
            <input class="ms-input" id="ms-hl-input" type="text"
                   placeholder="e.g. Interior and exterior painting with a clean finish, every time."
                   value="<%= @profile.provider_headline.to_s %>"
                   oninput="msOnHlInput(this.value)">
            <div class="ms-word-count" id="ms-hl-count">0 / 15</div>
          </div>
          <div class="ms-note ms-note-m" style="margin-top:12px">
            <b>Consigliere tip:</b> Homeowners want to know what you're <em>good at</em> and what you <em>won't do</em>. Say both.
          </div>
          <div class="ms-field">
            <label class="ms-label" for="ms-ss-input">Summary <span style="font-weight:400;color:var(--ink-mut)">(2–3 sentences)</span></label>
            <textarea class="ms-input ms-textarea" id="ms-ss-input" placeholder="Describe your work, your style, and who you work best with."><%= @profile.service_summary.to_s %></textarea>
          </div>
          <div class="ms-err" id="ms-s2-err"></div>
          <div class="ms-nav-row">
            <button class="ms-back" onclick="msGoStep(1)">← Back</button>
            <button class="ms-btn ms-btn-primary" style="margin-left:auto" onclick="msSubmitHeadline()">Continue →</button>
          </div>
        </div>

        <%# Step 3: Portfolio %>
        <div class="ms-step" id="ms-s3">
          <div class="ms-eyebrow">Step 3 of 6 — Portfolio</div>
          <div class="ms-step-h">Show your work</div>
          <div class="ms-step-sub">Add links to photos or write notes. Even one item builds trust.</div>
          <div class="ms-port-type-toggle">
            <button class="ms-ptt-btn on" id="ms-ptt-link" onclick="msSetPortType('link')">Link</button>
            <button class="ms-ptt-btn" id="ms-ptt-note" onclick="msSetPortType('note')">Note</button>
          </div>
          <div style="display:flex;gap:7px;margin-top:8px">
            <input class="ms-port-add-input" id="ms-port-title" type="text" placeholder="Title (optional)" style="flex:1">
          </div>
          <div style="display:flex;gap:7px;margin-top:5px" id="ms-port-link-row">
            <input class="ms-port-add-input" id="ms-port-url" type="url" placeholder="https://…" style="flex:1">
            <button class="ms-port-add-btn" onclick="msAddPortItem()">Add</button>
          </div>
          <div style="margin-top:5px;display:none" id="ms-port-note-row">
            <textarea class="ms-port-add-input ms-textarea" id="ms-port-note" style="width:100%" placeholder="Write your note…" rows="3"></textarea>
            <button class="ms-port-add-btn" style="margin-top:5px" onclick="msAddPortItem()">Add</button>
          </div>
          <div class="ms-port-list" id="ms-port-list">
            <% @profile.library_items.where("? = ANY(tags)", "portfolio").order(created_at: :desc).each do |item| %>
              <div class="ms-port-item" id="ms-pi-<%= item.id %>">
                <div style="flex:1;min-width:0">
                  <div class="ms-port-item-title"><%= item.title %></div>
                  <div class="ms-port-item-type"><%= item.item_type %><% if item.source_url.present? %> · <a href="<%= item.source_url %>" target="_blank" style="color:var(--market)">open ↗</a><% end %></div>
                </div>
                <button class="ms-port-vis-btn <%= item.visibility_public? ? 'pub' : '' %>"
                        id="ms-pv-<%= item.id %>"
                        onclick="msToggleVis(<%= item.id %>)"><%= item.visibility_public? ? 'Public' : 'Private' %></button>
                <button class="ms-port-del-btn" onclick="msDelPort(<%= item.id %>)">✕</button>
              </div>
            <% end %>
          </div>
          <div class="ms-err" id="ms-s3-err"></div>
          <div class="ms-nav-row">
            <button class="ms-back" onclick="msGoStep(2)">← Back</button>
            <button class="ms-btn ms-btn-primary" style="margin-left:auto" onclick="msGoStep(4)">Continue →</button>
          </div>
        </div>

        <%# Step 4: Service Area %>
        <div class="ms-step" id="ms-s4">
          <div class="ms-eyebrow">Step 4 of 6 — Service Area</div>
          <div class="ms-step-h">Where do you work?</div>
          <div class="ms-step-sub">Set your coverage. Clients searching nearby will find you on the map.</div>
          <div class="ms-area-toggle">
            <button id="ms-at-radius" class="ms-at-btn on" onclick="msSetAreaMode('radius')">Radius</button>
            <button id="ms-at-zone" class="ms-at-btn" onclick="msSetAreaMode('zone')">Zone</button>
          </div>
          <div id="ms-svc-map"></div>
          <div id="ms-radius-ui">
            <div class="svc-radius-label">Radius: <span id="ms-radius-val"><%= @profile.service_radius_mi.presence || 3 %></span> miles</div>
            <input type="range" id="ms-slider" min="0.5" max="50" step="0.5"
                   value="<%= @profile.service_radius_mi.presence || 3 %>"
                   oninput="msCbSliderMove(this.value)" style="width:100%;accent-color:var(--market);margin-bottom:12px;cursor:pointer">
          </div>
          <div id="ms-zone-ui" style="display:none">
            <p class="svc-hint" style="margin-bottom:10px">Use the polygon tool on the map to draw your service zone. Click to add points; close the shape by clicking the first point.</p>
          </div>
          <div class="ms-err" id="ms-s4-err"></div>
          <div class="ms-nav-row">
            <button class="ms-back" onclick="msGoStep(3)">← Back</button>
            <button class="ms-btn ms-btn-primary" style="margin-left:auto" onclick="msSubmitArea()">Save &amp; Continue →</button>
          </div>
        </div>

        <%# Step 5: Temple Contribution %>
        <div class="ms-step" id="ms-s5">
          <div class="ms-eyebrow">Step 5 of 6 — Wisdom Contribution</div>
          <div class="ms-step-h">Share what you know</div>
          <div class="ms-step-sub">Write a tip for homeowners about your trade. Optional — providers who teach earn a credit against their platform take.</div>
          <div class="ms-field">
            <label class="ms-label" for="ms-tip-title">Tip title</label>
            <input class="ms-input" id="ms-tip-title" type="text" placeholder="e.g. How to tell if paint is failing before it peels">
          </div>
          <div class="ms-field">
            <label class="ms-label" for="ms-tip-body">Tip content</label>
            <textarea class="ms-input ms-textarea" id="ms-tip-body" rows="4" placeholder="Share your insight…"></textarea>
          </div>
          <div class="ms-note ms-note-m"><b>This is public</b> and will appear on your card under "Expert Tip."</div>
          <div class="ms-err" id="ms-s5-err"></div>
          <div class="ms-nav-row">
            <button class="ms-back" onclick="msGoStep(4)">← Back</button>
            <button class="ms-skip" onclick="msSkipTemple()">Skip</button>
            <button class="ms-btn ms-btn-primary" onclick="msSubmitTemple()">Post Tip →</button>
          </div>
        </div>

        <%# Step 6: Live! %>
        <div class="ms-step" id="ms-s6">
          <div class="ms-complete-card">
            <div class="ms-complete-eyebrow">▢ Your card is live</div>
            <div class="ms-complete-h">Welcome to the marketplace</div>
            <p style="color:var(--ink-soft);font-size:13px;margin-bottom:4px">Your public profile is live at:</p>
            <div class="ms-complete-url" id="ms-live-url"><%= @profile.locode.present? ? "fora.center/#{@profile.locode}/#{@profile.provider_handle.to_s}" : "fora.center/p/#{@profile.provider_handle.to_s}" %></div>
            <div class="ms-qr-wrap">
              <canvas id="ms-qr-canvas" width="130" height="130"></canvas>
            </div>
            <div style="display:flex;flex-direction:column;gap:7px;margin-top:12px">
              <button class="ms-btn-outline" onclick="msDownloadQR()">Download QR Code</button>
              <a id="ms-view-card-link"
                 href="<%= @profile.locode.present? ? "/#{@profile.locode}/#{@profile.provider_handle.to_s}" : "/p/#{@profile.provider_handle.to_s}" %>"
                 target="_blank"
                 style="display:block;text-align:center;text-decoration:none;padding:11px 20px;background:var(--market);color:#fff;font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;border-radius:9px">View Your Card ↗</a>
            </div>
          </div>
        </div>

      </div><%# /wizard-body %>

    <% else %>
      <%# ── EDITOR MODE (card_builder_complete = true) ──────────────────────── %>
      <%
        _occ_data = begin
          JSON.parse(File.read(Rails.root.join('app/data/occupations.json')))
        rescue
          []
        end
        _capabilities = @profile.provider_capabilities.active.order(created_at: :asc)
      %>
      <div class="svc-head">
        <div class="svc-head-title">▢ My Services</div>
      </div>

      <div class="ms-add-svc-bar">
        <button class="ms-add-svc-btn" onclick="msAddService()">+ Add a Service</button>
      </div>

      <%
        # One card per capability. Fall back to profile.naics_code for older accounts
        # that predate capability-row creation. If still nothing, show one card anyway —
        # every completed provider deserves to see their listing.
        _cards = if _capabilities.any?
          _capabilities.map { |c| { naics_code: c.naics_code, profession: c.profession } }
        elsif @profile.naics_code.present?
          [{ naics_code: @profile.naics_code, profession: nil }]
        else
          [{ naics_code: nil, profession: nil }]
        end

        _display_name = @profile.market_display_name.presence ||
                        @profile.market_entity_name.presence ||
                        @profile.provider_handle.to_s.gsub("-", " ").split.map(&:capitalize).join(" ")
        _initials     = _display_name.split(/\s+/).first(2).map { |w| w[0]&.upcase }.join
        _card_path    = @profile.locode.present? ? "/#{@profile.locode}/#{@profile.provider_handle}" : "/p/#{@profile.provider_handle}"
        _card_url     = @profile.locode.present? ? "https://fora.center/#{@profile.locode}/#{@profile.provider_handle}" : "https://fora.center/p/#{@profile.provider_handle}"
      %>
      <div class="ms-svc-list">
        <% _cards.each do |entry| %>
          <%
            occ = _occ_data.find { |o|
              o["naics_code"] == entry[:naics_code] &&
              (@profile.onet_code.blank? || o["onet_code"] == @profile.onet_code)
            } || _occ_data.find { |o| o["naics_code"] == entry[:naics_code] }
            trade_label = if occ
              occ["display_label"]
            elsif entry[:profession].present?
              entry[:profession].to_s.gsub("-", " ").split.map(&:capitalize).join(" ")
            end
          %>
          <div style="border:1.5px solid var(--rule);border-radius:13px;overflow:hidden;background:#fff;">
            <div class="mkt-detail-hero">
              <div class="mkt-hero-top">
                <div class="av-biz mkt-hero-avatar"><%= _initials %></div>
                <div class="mkt-hero-main">
                  <div class="mkt-hero-name"><%= _display_name %></div>
                  <div class="mkt-hero-badges">
                    <% if trade_label %>
                      <span class="lbdg lbdg-biz"><%= trade_label %></span>
                    <% end %>
                    <span class="lbdg lbdg-cleared">● Active</span>
                  </div>
                  <div class="mkt-hero-meta">
                    <% if @profile.place_label.present? %>
                      <span>📍 <%= @profile.place_label %></span>
                    <% end %>
                    <% if @profile.service_radius_mi.present? %>
                      <span>Serves within <%= @profile.service_radius_mi.round(1) %> mi</span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
            <% if @profile.provider_headline.present? %>
              <div class="mkt-detail-desc"><%= @profile.provider_headline %></div>
            <% end %>
            <div class="mkt-detail-actions">
              <a href="<%= _card_path %>" target="_blank"
                 class="mkt-da-btn mkt-da-primary"
                 style="text-decoration:none;display:inline-block">View Card ↗</a>
              <button class="mkt-da-btn mkt-da-sec"
                      onclick="msCopyCardLink('<%= j _card_url %>', this)">Copy Link</button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div><%# /panel-service-area %>

  <%# ── TEMPLE SUBCATEGORY PANEL ───────────────────────────────────────────── %>
  <div id="panel-temple-sub" style="display:none">
    <div class="tpl-fhead">
      <div class="tpl-fhead-title">◯ Wisdom</div>
      <div class="tpl-fhead-crumb" id="tpl-crumb"></div>
    </div>
    <div id="tpl-sub-main"></div>
  </div><%# /panel-temple-sub %>

  <%# ── OFFICIAL PROFILE PANEL ──────────────────────────────────────────── %>
  <div id="panel-official" style="display:none">
    <div class="official-panel-bar">
      <button class="official-panel-back" onclick="switchPanel('observe',null)">← Your Representatives</button>
      <span id="official-panel-name" style="font-size:13px;color:var(--ink-soft);"></span>
    </div>
    <iframe id="official-iframe" class="official-iframe" src="" title="Official profile"
            onload="this.style.height=(this.contentWindow.document.body.scrollHeight+40)+'px'"></iframe>
  </div>

  <%# ── HOME WALL / GLOBAL SEARCH PANEL ─────────────────────────────────── %>
  <div id="panel-search">

    <div id="home-wall"
         data-handle="<%= j current_user.handle %>"
         data-initials="<%= j initials(current_user.handle) %>"
         data-city="<%= j [@profile.place_label, @profile.address_city].compact_blank.first.to_s %>"
         data-state="<%= j @profile.address_state.to_s %>">

      <%# Compose bar %>
      <div class="wall-compose-bar">
        <div class="wall-compose-trigger" onclick="wallOpenCompose()">
          <div class="wall-compose-avatar"><%= initials(current_user.handle) %></div>
          <div class="wall-compose-ph">Share something with the wall&hellip;</div>
        </div>
      </div>

      <div class="wall-compose-form" id="wall-compose-form">
        <textarea class="wall-compose-textarea" id="wall-compose-text"
                  placeholder="What's on your mind? Share an update, question, or photo with your FORA neighborhood&#8230;" rows="3"
                  oninput="wallComposeInput()"></textarea>
        <img id="wall-img-preview" class="wall-img-preview" alt="">
        <div class="wall-compose-types" id="wall-type-chips">
          <span class="wall-type-chip sel" data-type="update" onclick="wallSelectType(this)">Update</span>
          <span class="wall-type-chip" data-type="question" onclick="wallSelectType(this)">Question</span>
          <span class="wall-type-chip" data-type="photo" onclick="wallSelectType(this)">Photo</span>
          <span class="wall-type-chip" data-type="link" onclick="wallSelectType(this)">Link</span>
        </div>
        <div class="wall-compose-foot">
          <div class="wall-compose-left">
            <button class="wall-img-btn" type="button" onclick="document.getElementById('wall-img-input').click()">
              <i class="ti ti-photo"></i> Add photo
            </button>
            <input type="file" id="wall-img-input" accept="image/*" style="display:none" onchange="wallLoadImage(event)">
          </div>
          <div style="display:flex;gap:6px;align-items:center">
            <button class="wall-cancel-btn" type="button" onclick="wallCloseCompose()">Cancel</button>
            <button class="wall-post-btn" id="wall-post-btn" type="button" onclick="wallSubmitPost()" disabled>Post</button>
          </div>
        </div>
      </div>

      <%# Wall feed %>
      <div class="wall-feed" id="wall-feed">
        <%# Weather card — first, always %>
        <div class="ws-wrap" id="weather-station">
          <div class="ws-loading">
            <i class="ti ti-cloud" style="font-size:24px;display:block;margin-bottom:8px"></i>
            Loading weather for your area&hellip;
          </div>
        </div>
        <%# User-generated posts rendered by JS from localStorage %>
      </div>
    </div>

    <div id="srch-results" style="display:none"></div>
  </div>

  <%# ── SETTINGS PANEL ────────────────────────────────────────────────────── %>
  <div id="panel-settings" style="display:none">
    <div class="official-panel-bar">
      <button class="official-panel-back" onclick="switchPanel('search',null)">← Home</button>
      <span style="font-size:13px;color:var(--ink-soft);">Settings</span>
    </div>
    <iframe id="settings-iframe" class="settings-iframe" src="" title="Settings"></iframe>
  </div>
  </main>

  <%# ── RIGHT RAIL ──────────────────────────────────────────────────────────── %>
  <aside class="col-right">
    <div id="mkt-map-right"><div id="mkt-map-d"></div></div>
    <div id="right-civic">

    <%# YOUR DOCKET %>
    <div class="rcard">
      <div class="rh">Your Docket</div>
      <div class="rs">What you're tracking · <%= @feed.size %> item<%= @feed.size == 1 ? "" : "s" %></div>
      <% if @docket_items.empty? %>
        <div style="padding:12px 15px;font-size:13px;color:var(--ink-mut);">Nothing on your docket yet — Track something to start.</div>
      <% else %>
        <% @docket_items.each do |h| %>
          <% item = h[:item]; type = h[:type] %>
          <div class="dk">
            <div class="dk-top">
              <% if type == "CivicBill" %>
                <span class="dk-k k-bill">Bill</span>
                <%= item.identifier.presence || "" %>
              <% elsif type == "NeighborhoodIssue" %>
                <span class="dk-k k-issue">Issue</span>
                <%= item.location_description.presence || item.rco_slug %>
              <% elsif type == "CivicRepresentative" %>
                <span class="dk-k" style="background:var(--blue-pl);color:var(--blue);">Rep</span>
                <%= item.office.to_s.split.first(3).join(" ") %>
              <% end %>
              <span class="dk-w"><%= time_ago_short(h[:last_at]) %></span>
            </div>
            <div class="dk-t">
              <% if type == "CivicBill" %>
                <%= item.title.truncate(70) %>
              <% elsif type == "NeighborhoodIssue" %>
                <%= item.body.truncate(70) %>
              <% elsif type == "CivicRepresentative" %>
                <%= item.name %>
              <% end %>
            </div>
            <% if type == "CivicBill" %>
              <% segs = stage_segs(item) %>
              <div class="dk-s">
                <% segs.each do |s| %><span class="dk-sg <%= s %>"></span><% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <div class="rfoot">See your full docket →</div>
    </div>

    <%# YOUR OFFICIALS %>
    <div class="rcard">
      <div class="rh">Your officials</div>
      <div class="rs"><%= [@profile.place_label.presence, @profile.address_city.presence].compact.first.to_s %></div>
      <% if @officials.empty? %>
        <div style="padding:10px 14px;font-size:13px;color:var(--ink-mut);">
          Officials couldn't be loaded.
          <a href="<%= dashboard_reresolve_path %>" style="display:block;margin-top:6px;font-size:12px;font-weight:700;color:var(--blue);">Resolve now →</a>
        </div>
      <% else %>
        <% @officials.first(5).each do |o| %>
          <% prof_path = official_profile_path(o) %>
          <div class="rrow" <%= prof_path ? "onclick=\"openOfficialProfile('#{prof_path}', '#{j o[:name]}')\"" : "" %>>
            <div class="rrow-av"><%= initials(o[:name]) %></div>
            <div style="flex:1;min-width:0;">
              <div class="rrow-name"><%= o[:name] %></div>
              <div class="rrow-role"><%= o[:office] %></div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# ACTIVE LEGISLATION %>
    <div class="rcard">
      <div class="rh">Active legislation</div>
      <div class="rs">Near you · this week</div>
      <% if @jurisdiction_bills.any? %>
        <% @jurisdiction_bills.first(3).each do |b| %>
          <div class="rrow" style="align-items:flex-start;padding:9px 14px;">
            <div style="flex:1;min-width:0;">
              <div style="font-size:12.5px;font-weight:700;margin-bottom:2px;line-height:1.35">
                <%= [b.identifier.presence, b.title.truncate(52)].compact.join(" — ") %>
              </div>
              <div style="font-size:10.5px;color:var(--ink-mut);font-family:'JetBrains Mono',monospace">
                <%= b.jurisdiction.capitalize %> · <%= b.status %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div style="padding:10px 14px;font-size:13px;color:var(--ink-mut);">No active legislation near you.</div>
      <% end %>
    </div>

    <%# CONSTITUENCY METER %>
    <div class="rcard">
      <div class="rh">The constituency meter</div>
      <% if @meter_bill && @meter_pct %>
        <div class="cm">
          <div class="cm-n"><%= @meter_pct %>%</div>
          <div class="cm-l">
            of people tracking <b><%= @meter_bill.identifier.presence || @meter_bill.title.truncate(40) %></b>
            are <b>verified residents</b><% if @jurisdiction[:city].present? %> of <%= @jurisdiction[:city] %><% end %>.
            The thing X can't show.
          </div>
        </div>
      <% else %>
        <div class="cm-empty">Track a bill to see the verified-resident share of everyone following it.</div>
      <% end %>
    </div>

    </div><%# /right-civic %>
  </aside>
</div><%# /.shell %>

<!-- MOBILE bottom bar — pillars kept together -->
<div class="mbar">
  <div class="mtab home on">⌂</div>
  <div class="mtab fab"><span>+</span></div>
  <div class="mtab" data-g="t">◯</div>
  <div class="mtab" data-g="f">△</div>
  <div class="mtab" data-g="m">▢</div>
</div>

<script>
var SPARK_URL       = '<%= dashboard_spark_path %>';
var BUILD_URL       = '<%= dashboard_build_path %>';
var PROJECT_URL     = '<%= dashboard_project_add_path %>';
var PROJECTS        = <%= raw @project_list.map { |p| { id: p.id, title: p.title } }.to_json %>;

function csrf() {
  return document.querySelector('meta[name="csrf-token"]').content;
}

function post(url, body) {
  return fetch(url, {
    method:  'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
    body:    JSON.stringify(body)
  }).then(function(r){ return r.json(); });
}

// ── Tab switching ─────────────────────────────────────────────────────────────
document.querySelectorAll('.tab').forEach(function(t) {
  t.onclick = function() {
    document.querySelectorAll('.tab').forEach(function(x){ x.classList.remove('active'); });
    t.classList.add('active');
    document.querySelectorAll('.tabview').forEach(function(v){ v.classList.remove('active'); });
    document.getElementById('tv-' + t.dataset.tab).classList.add('active');
  };
});

// ── Pillar filter ─────────────────────────────────────────────────────────────
document.querySelectorAll('.pchip').forEach(function(c) {
  c.onclick = function() {
    document.querySelectorAll('.pchip').forEach(function(x){ x.classList.remove('on'); });
    c.classList.add('on');
    var p = c.dataset.p;
    document.querySelectorAll('.tabview.active .post').forEach(function(post) {
      post.style.display = (p === 'all' || post.classList.contains(p)) ? 'flex' : 'none';
    });
  };
});

// ── Spark toggle ──────────────────────────────────────────────────────────────
function toggleSpark(btn) {
  var type = btn.dataset.type;
  var id   = btn.dataset.id;
  post(SPARK_URL, { type: type, id: id }).then(function(data) {
    if (data.sparked) {
      btn.classList.add('on');
      btn.innerHTML = '<span class="ri">★</span> Tracking';
      // Unlock build and integrate in the same card
      var pb = btn.closest('.pb');
      pb.querySelectorAll('.rung.locked').forEach(function(r){
        r.classList.remove('locked');
      });
    } else {
      btn.classList.remove('on');
      btn.innerHTML = '<span class="ri">★</span> Track';
    }
    // Update any concur count displayed
    if (data.count !== undefined) {
      var sec = btn.closest('.pb').querySelector('.concur-ct');
      if (sec) sec.textContent = data.count + ' tracking';
    }
  }).catch(function(){ /* silent — button state stays */ });
}

// ── Official card expand (Jurisdictions tab) ──────────────────────────────────
function toggleRepPanel(btn) {
  btn.classList.toggle('open');
  btn.nextElementSibling.classList.toggle('open');
  btn.querySelector('.arr').style.transform = btn.classList.contains('open') ? 'rotate(180deg)' : '';
}

// ── Rep section collapse ──────────────────────────────────────────────────────
function toggleRepSection(hdr) {
  hdr.classList.toggle('collapsed');
  hdr.nextElementSibling.classList.toggle('collapsed');
}

// ── Rep Follow toggle (right rail) ────────────────────────────────────────────
function toggleRepFollow(btn, repId) {
  post(SPARK_URL, { type: 'CivicRepresentative', id: repId }).then(function(data) {
    if (data.sparked) {
      btn.classList.add('on');
    } else {
      btn.classList.remove('on');
    }
  }).catch(function(){});
}

// ── Build / Integrate trays ───────────────────────────────────────────────────
function openTray(btn, type) {
  if (btn.classList.contains('locked')) return;

  var pb       = btn.closest('.pb');
  var tray     = pb.querySelector('.tray.' + type);
  var isOpen   = tray.classList.contains('show');

  // Close all trays in this card first
  pb.querySelectorAll('.tray').forEach(function(x){ x.classList.remove('show'); });

  if (!isOpen) {
    if (type === 'build') {
      renderBuildTray(btn, tray);
    } else {
      renderIntegTray(btn, tray);
    }
    tray.classList.add('show');
    btn.classList.add('on');
    btn.innerHTML = type === 'build'
      ? '<span class="ri">⊕</span> Built'
      : '<span class="ri">↗</span> Integrated';
  }
}

function renderBuildTray(btn, tray) {
  var sourceType = tray.dataset.sourceType;
  var sourceId   = tray.dataset.sourceId;
  tray.innerHTML =
    '<div class="tray-h">Build on this — grow your understanding:</div>' +
    '<div class="tray-opts">' +
      '<span class="topt" onclick="showNoteForm(this, \'' + sourceType + '\', \'' + sourceId + '\')">+ Add your take</span>' +
      '<span class="topt stub" title="Coming soon">✦ Ask your guide</span>' +
    '</div>' +
    '<div class="note-area"></div>';
}

function showNoteForm(topt, sourceType, sourceId) {
  var area = topt.closest('.tray').querySelector('.note-area');
  if (area.querySelector('textarea')) return; // already open
  area.innerHTML =
    '<div class="note-form">' +
      '<textarea rows="2" placeholder="Your take on this…"></textarea>' +
      '<button onclick="submitNote(this, \'' + sourceType + '\', \'' + sourceId + '\')">Save</button>' +
    '</div>';
}

function submitNote(btn, sourceType, sourceId) {
  var ta   = btn.previousElementSibling;
  var note = ta.value.trim();
  if (!note) { ta.focus(); return; }
  btn.disabled = true;
  btn.textContent = '…';
  post(BUILD_URL, { source_type: sourceType, source_id: sourceId, note: note })
    .then(function(data) {
      if (data.ok) {
        btn.closest('.note-form').innerHTML = '<span style="color:var(--blue-md);font-size:12px;">✓ Note saved</span>';
      } else {
        btn.disabled = false; btn.textContent = 'Save';
      }
    }).catch(function(){ btn.disabled = false; btn.textContent = 'Save'; });
}

function renderIntegTray(btn, tray) {
  var sourceType = tray.dataset.sourceType;
  var sourceId   = tray.dataset.sourceId;
  var projOpts   = PROJECTS.map(function(p) {
    return '<span class="proj-chip" onclick="addToProject(' + p.id + ', \'' + sourceType + '\', \'' + sourceId + '\')">' + p.title + '</span>';
  }).join('');

  tray.innerHTML =
    '<div class="tray-h">Integrate — weave it into something on FORA:</div>' +
    '<div class="tray-opts">' +
      '<span class="topt" onclick="showProjectForm(this, \'' + sourceType + '\', \'' + sourceId + '\')">↗ Add to a project</span>' +
      (sourceType === 'NeighborhoodIssue'
        ? '<span class="topt stub" title="Concur coming soon">✓ Cast your voice (Concur)</span>'
        : '') +
      '<span class="topt stub" title="Coming soon">⇄ Share to Discourse</span>' +
    '</div>' +
    '<div class="project-area"></div>';
}

function showProjectForm(topt, sourceType, sourceId) {
  var area = topt.closest('.tray').querySelector('.project-area');
  if (area.querySelector('.project-sel')) return;

  var projHtml = PROJECTS.length
    ? '<div class="project-sel">' +
        PROJECTS.map(function(p){
          return '<span class="proj-chip" onclick="addToProject(' + p.id + ',\'' + sourceType + '\',\'' + sourceId + '\')">' + p.title + '</span>';
        }).join('') +
      '</div>'
    : '';

  area.innerHTML = projHtml +
    '<div class="proj-new-form">' +
      '<input type="text" placeholder="New project name…">' +
      '<button onclick="createAndAdd(this, \'' + sourceType + '\', \'' + sourceId + '\')">Create</button>' +
    '</div>';
}

function addToProject(projectId, sourceType, sourceId) {
  post(PROJECT_URL, { project_id: projectId, type: sourceType, id: sourceId })
    .then(function(data){
      if (data.ok) showFlash('Added to "' + data.project_title + '"');
    }).catch(function(){});
}

function createAndAdd(btn, sourceType, sourceId) {
  var input = btn.previousElementSibling;
  var title = input.value.trim();
  if (!title) { input.focus(); return; }
  btn.disabled = true;
  post(PROJECT_URL, { title: title, type: sourceType, id: sourceId })
    .then(function(data){
      if (data.ok) {
        PROJECTS.push({ id: data.project_id, title: data.project_title });
        showFlash('Project "' + data.project_title + '" created');
        btn.closest('.proj-new-form').innerHTML =
          '<span style="color:var(--green);font-size:12px;">✓ ' + data.project_title + '</span>';
      } else {
        btn.disabled = false;
      }
    }).catch(function(){ btn.disabled = false; });
}

function showFlash(msg) {
  var el = document.createElement('div');
  el.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:8px 18px;border-radius:999px;font-family:"JetBrains Mono",monospace;font-size:11px;z-index:999;opacity:1;transition:opacity .4s';
  el.textContent = msg;
  document.body.appendChild(el);
  setTimeout(function(){ el.style.opacity = '0'; setTimeout(function(){ el.remove(); }, 400); }, 2200);
}

// ── Expand bill card in place ─────────────────────────────────────────────────
function toggleExpand(cue) {
  var pb    = cue.closest('.pb');
  var exp   = pb.querySelector('.exp');
  var icard = pb.querySelector('.icard');
  if (!exp) return;
  var isOpen = exp.classList.toggle('open');
  if (icard) icard.style.display = isOpen ? 'none' : '';
  cue.innerHTML = isOpen
    ? '&#9652; Collapse'
    : '&#9662; Open &middot; read it, weigh it, take your stand';
  if (isOpen) {
    var top = pb.closest('.post').getBoundingClientRect().top + window.scrollY - 20;
    window.scrollTo({ top: top, behavior: 'smooth' });
    // Lazy-load summary if missing
    var lazy = exp.querySelector('.bexp-summary-lazy');
    if (lazy && !lazy.dataset.loaded) {
      lazy.dataset.loaded = '1';
      var billId = lazy.dataset.billId;
      fetch('/mvp/bills/' + billId + '/summary')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.summary) {
            lazy.innerHTML = data.summary;
            lazy.style.fontStyle = 'normal';
            lazy.style.color = 'var(--ink)';
            lazy.style.fontSize = '14.5px';
            lazy.style.lineHeight = '1.65';
            // Inject effects if present and no effects block exists
            if (data.effects && data.effects.length && !exp.querySelector('.bexp-affect')) {
              var effDiv = document.createElement('div');
              effDiv.className = 'bexp-block';
              effDiv.innerHTML = '<div class="bexp-block-h">How it may affect you</div>'
                + '<ul class="bexp-affect">'
                + data.effects.map(function(e){ return '<li>' + e + '</li>'; }).join('')
                + '</ul>';
              lazy.closest('.bexp-block').insertAdjacentElement('afterend', effDiv);
            }
          } else {
            lazy.textContent = 'Summary not yet available.';
          }
        })
        .catch(function() { lazy.textContent = 'Could not load summary.'; });
    }
  }
}

// ── Jurisdiction bills infinite scroll ───────────────────────────────────────
(function() {
  var sentinel = document.getElementById('juris-bills-sentinel');
  if (!sentinel) return;

  var loading  = false;
  var hasMore  = true;
  var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

  var STAGE_SEGS = {
    introduced: ['done','now','','',''],
    committee:  ['done','done','now','',''],
    passed_chamber: ['done','done','done','now',''],
    resolving_differences: ['done','done','done','done','now'],
    to_president: ['done','done','done','done','now'],
    became_law:   ['done','done','done','done','done'],
    vetoed:       ['done','done','done','done','done'],
    failed:       ['done','now','','',''],
    withdrawn:    ['done','now','','','']
  };
  var STAGE_LABEL = {
    introduced:  'Introduced', committee: 'In Committee',
    passed_chamber: 'Passed Chamber', resolving_differences: 'Resolving Differences',
    to_president: 'To President', became_law: 'Became Law',
    vetoed: 'Vetoed', failed: 'Failed', withdrawn: 'Withdrawn'
  };
  var JUR_COLOR = { federal: '#B22234', pennsylvania: '#003087', philadelphia: '#004C54' };
  var JUR_LABEL = { federal: 'Federal', pennsylvania: 'State', philadelphia: 'Local' };

  function esc(s) {
    return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderSegs(stage) {
    var segs = STAGE_SEGS[stage] || ['done','now','','',''];
    return segs.map(function(cls) { return '<span class="sseg ' + cls + '"></span>'; }).join('');
  }

  function renderBillCard(b) {
    var color = JUR_COLOR[b.jurisdiction] || '#B22234';
    var jlbl  = JUR_LABEL[b.jurisdiction] || 'Federal';
    var slbl  = STAGE_LABEL[b.bill_stage]  || b.status || '';
    var date  = b.status_date ? ' · ' + esc(b.status_date) : '';
    var sparkOn = b.sparked ? ' on' : '';
    var sparkTxt = b.sparked ? 'Tracking' : 'Track';

    // — Expand panel content —
    var expHtml = '';

    // Summary block
    if (b.plain_summary) {
      expHtml += '<div class="bexp-block">'
               + '<div class="bexp-block-h">In plain language</div>'
               + '<div class="bexp-summary">' + esc(b.plain_summary) + '</div>'
               + '</div>';
    }

    // Effects block
    var effects = b.effects || [];
    if (effects.length) {
      expHtml += '<div class="bexp-block"><div class="bexp-block-h">How it may affect you</div>'
               + '<ul class="bexp-affect">'
               + effects.map(function(e){ return '<li>' + esc(e) + '</li>'; }).join('')
               + '</ul></div>';
    }

    // Sit with it (guide)
    if (b.guide_seeded && b.sit_for && b.sit_against) {
      expHtml += '<div class="exp-guide" id="guide-' + b.id + '">'
        + '<div class="exp-guide-head">'
        + '<div class="exp-guide-eyebrow"><span style="font-size:13px;">◯</span> Think it through with your guide</div>'
        + '<div class="exp-guide-h">Sit with it. Study it. Then take your stand.</div>'
        + '<div class="exp-guide-sub"><b>FORA never tells you what to think.</b> It makes sure you\'ve understood — both sides, then the facts — before you decide.</div>'
        + '</div>'
        + '<div class="eg-tabs">'
        + '<div class="eg-tab on" onclick="egTab(this,\'sit\',\'guide-' + b.id + '\')"><div class="eg-tab-n">Sit</div><div class="eg-tab-d">both sides</div></div>'
        + '<div class="eg-tab" onclick="egTab(this,\'study\',\'guide-' + b.id + '\')"><div class="eg-tab-n">Study</div><div class="eg-tab-d">the facts</div></div>'
        + '<div class="eg-tab" onclick="egTab(this,\'share\',\'guide-' + b.id + '\')"><div class="eg-tab-n">Share</div><div class="eg-tab-d">your stand</div></div>'
        + '</div>'
        // Sit pane
        + '<div class="eg-pane on" id="guide-' + b.id + '-sit">'
        + '<div class="eg-sides">'
        + '<div class="eg-side for"><div class="eg-side-h">The case for</div><p>' + esc(b.sit_for) + '</p></div>'
        + '<div class="eg-side against"><div class="eg-side-h">The case against</div><p>' + esc(b.sit_against) + '</p></div>'
        + '</div>'
        + '<div class="eg-minority"><b>⚖ Democracy with minority consent.</b> Even if most of your neighbors land one way, the other view holds something true. FORA asks you to understand it — not to agree with it.</div>'
        + '<div class="eg-ack"><div class="eg-ack-h">Before you take a stand:</div>'
        + '<textarea placeholder="In your own words — what\'s the strongest point on the side you disagree with?" oninput="egAckInput(this,\'guide-' + b.id + '\')"></textarea>'
        + '<div class="eg-ack-note">Private. This isn\'t a test — it\'s the difference between a reaction and a position.</div>'
        + '</div></div>'
        // Study pane
        + '<div class="eg-pane" id="guide-' + b.id + '-study">'
        + (b.study_facts && b.study_facts.length
            ? '<ul class="eg-facts">' + b.study_facts.map(function(f){
                return '<li><span>' + esc(f.text) + '</span><span class="eg-fact-src">' + esc(f.source_label) + '</span></li>';
              }).join('') + '</ul>'
            : '')
        + (b.full_text_url ? '<a href="' + esc(b.full_text_url) + '" target="_blank" rel="noopener" class="eg-study-doc">📄 Read the official bill text →</a>' : '')
        + '</div>'
        // Share pane
        + '<div class="eg-pane" id="guide-' + b.id + '-share">'
        + '<div class="eg-gate" id="guide-' + b.id + '-gate">Reflect on the strongest opposing argument — Share lightens once you have.</div>'
        + '<div class="eg-share-acts dimmed" id="guide-' + b.id + '-acts">'
        + '<a href="/mvp/bills/' + b.id + '#civic-voice" class="eg-sact"><div class="eg-sact-ico" style="background:#f8f0dc;">✓</div><div><div class="eg-sact-t">Share your voice</div><div class="eg-sact-d">Your take on the bill, visible to your community.</div></div></a>'
        + '<a href="/mvp/bills/' + b.id + '#civic-voice" class="eg-sact"><div class="eg-sact-ico" style="background:#e5f0e8;">💬</div><div><div class="eg-sact-t">See neighbor takes</div><div class="eg-sact-d">What others in your jurisdiction are saying.</div></div></a>'
        + '</div></div>'
        + '</div>';
    }

    // Full bill page link
    expHtml += '<div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--rule);">'
             + '<a href="/mvp/bills/' + b.id + '" style="font-family:\'JetBrains Mono\',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);text-decoration:none;">'
             + '→ Full bill page</a></div>';

    return '<div class="post f">'
      + '<div class="av av-doc">§</div>'
      + '<div class="pb">'
      + '<div class="pm">'
      + '<span class="pn2">' + esc(b.identifier || 'Bill') + '</span>'
      + '<span class="pr">· ' + esc(slbl) + date + '</span>'
      + '<span class="pbadge bb-f">△ Law</span>'
      + '</div>'
      + '<div class="fctx">' + (b.sparked ? 'On your docket' : 'Your jurisdiction · not yet on your docket') + '</div>'
      + '<div class="icard">'
      + '<div class="ic-top"><span class="ic-k k-bill">Bill · ' + jlbl + '</span></div>'
      + '<div class="ic-t">' + esc((b.title || '').substring(0, 120)) + '</div>'
      + '<div class="ic-stage"><div class="sbar">' + renderSegs(b.bill_stage) + '</div><span>' + esc(slbl) + '</span></div>'
      + '</div>'
      + '<div class="expand-cue" onclick="toggleExpand(this)">▾ Open · read it, weigh it, take your stand</div>'
      + '<div class="exp">' + expHtml + '</div>'
      + '<div class="arc">'
      + '<button class="rung spark' + sparkOn + '" data-type="CivicBill" data-id="' + b.id + '" onclick="toggleSpark(this)">'
      + '<span class="ri">★</span> ' + sparkTxt
      + '</button>'
      + '<button class="rung build locked"><span class="ri">⊕</span> Build</button>'
      + '<button class="rung integ locked"><span class="ri">↗</span> Integrate</button>'
      + '<div class="arc-sec"><span class="concur-ct">' + b.follow_count + ' tracking</span> <span>💬 Discuss</span></div>'
      + '</div>'
      + '</div></div>';
  }

  function loadMore() {
    if (loading || !hasMore) return;
    loading = true;
    var offset = parseInt(sentinel.dataset.offset || '0', 10);
    fetch('/mvp/dashboard/jurisdiction_bills?offset=' + offset, {
      headers: { 'X-CSRF-Token': csrfToken }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      hasMore = data.has_more;
      sentinel.dataset.offset = data.offset;
      var frag = document.createElement('div');
      frag.innerHTML = data.bills.map(renderBillCard).join('');
      while (frag.firstChild) {
        sentinel.parentNode.insertBefore(frag.firstChild, sentinel);
      }
      loading = false;
      if (!hasMore) observer.unobserve(sentinel);
    })
    .catch(function() { loading = false; });
  }

  var observer = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: '200px' });

  observer.observe(sentinel);
}());

// ── Left nav panel switching ──────────────────────────────────────────────────
function switchPanel(key, el) {
  document.querySelectorAll('.col-left .tool').forEach(function(t) {
    t.classList.remove('active');
  });
  if (el) el.classList.add('active');

  var panels = document.querySelectorAll('.col-center [id^="panel-"]');
  panels.forEach(function(p) {
    p.style.display = (p.id === 'panel-' + key) ? '' : 'none';
  });

  if (key === 'pathsprograms') renderPathsPrograms();
  if (key === 'religion') renderReligion();
  if (key === 'search') {
    var hw = document.getElementById('home-wall'), sr = document.getElementById('srch-results');
    var hasQuery = document.getElementById('srch') && document.getElementById('srch').value.trim();
    if (!hasQuery && hw && sr) { hw.style.display = ''; sr.style.display = 'none'; }
  }

  // Market map: show right-column map on desktop when market is active
  var isMkt = (key === 'market' || key === 'market-listing');
  var mapRight = document.getElementById('mkt-map-right');
  var civic    = document.getElementById('right-civic');
  if (mapRight) mapRight.style.display = isMkt ? 'block' : 'none';
  if (civic)    civic.style.display    = isMkt ? 'none'  : 'block';
  if (isMkt) {
    setTimeout(function(){
      initMktMapD();
      if (_mktMapD) _mktMapD.invalidateSize();
    }, 0);
  }
}

