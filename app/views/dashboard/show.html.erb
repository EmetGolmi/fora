        items: [
          {title:'Philadelphia Parks & Recreation \u2014 free and low-cost fitness programs', sub:'PPR operates fitness centers at recreation centers across all neighborhoods. Annual membership is $40 for adults. Free fitness classes, swim lessons, and sports leagues run year-round. Find your rec center at phila.gov/rec.', tag:'Resource'},
          {title:'Community yoga and movement events in Philadelphia', sub:'Philly Free Yoga and neighborhood rec centers host free outdoor yoga in Clark Park, Rittenhouse Square, and Mander Recreation Center from May through September. No registration required.', tag:'Community'},
          {title:'What to look for when choosing a massage therapist in PA', sub:'Pennsylvania requires massage therapists to be licensed through the State Board of Massage Therapy. Always verify license at license.pa.gov. Licensed therapists must complete 600 hours of approved training.', tag:'Guide'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Philadelphia Recreation Financial Assistance Program \u2014 reduced-fee memberships', sub:'Income-eligible residents can receive reduced or waived fees for PPR programs including fitness centers, swim classes, and camp programs. Apply at any recreation center with proof of income.', tag:'City program'},
          {title:'PA Massage Therapy Practice Act \u2014 2024 continuing education updates', sub:'Act 39 of 2024 updated CEU requirements for PA licensed massage therapists to include 3 hours of ethics training per two-year cycle. New applications now require background clearances.', tag:'Bill \u00b7 State'},
          {title:'Healthy People 2030 \u2014 federal physical activity grants available to PA organizations', sub:'CDC funds community-level physical activity promotion through the REACH program and Community Preventive Services programs. Philadelphia-area nonprofits and health systems are eligible to apply.', tag:'Federal'}
        ]
      },
      filterChips: ['All','Gym','Yoga','Martial arts','Massage','Swimming']
    },
    'Personal care': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia cosmetology licensing \u2014 what practitioners must have', sub:'All cosmetologists, barbers, estheticians, and nail technicians in PA must be licensed through the State Board of Cosmetology. Verify any salon or individual provider at license.pa.gov before services.', tag:'Guide'},
          {title:'Community barbershop and beauty events in Philadelphia', sub:'Several Philadelphia barbershops and salons host free or reduced-cost community cut days, often tied to back-to-school season. The Barbershop Books program at local shops also provides literacy resources for children.', tag:'Community'},
          {title:'Your rights when a salon service goes wrong in Pennsylvania', sub:'Complaints against licensed cosmetologists can be filed with the PA Bureau of Professional and Occupational Affairs. The Board can suspend or revoke licenses for sanitation violations or consumer harm.', tag:'Rights'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'PA Cosmetology Law \u2014 Sanitation Code updates (2024)', sub:'PA Board of Cosmetology issued updated sanitation guidelines effective January 2024. Requires single-use items for each client, documented disinfection logs, and annual sanitation training for all licensed operators.', tag:'Bill \u00b7 State'},
          {title:'Philadelphia Workforce Development \u2014 free cosmetology training programs', sub:'Philadelphia Works funds subsidized cosmetology and barbering training programs at several city institutions including community colleges and licensed private schools. Income-eligible residents can receive full tuition support.', tag:'City program'},
          {title:'H.B. 1588 \u2014 Natural Hair Discrimination prohibition (PA CROWN Act, 2025)', sub:'PA CROWN Act prohibits discrimination based on natural hair texture and protective hairstyles (locs, braids, twists, Bantu knots) in employment, education, and housing. Signed into law February 2025.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Hair','Nails','Skin','Barbershop','Spa']
    },
    'Transit & rideshare': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'SEPTA Key card \u2014 how to get one and load it in Philadelphia', sub:'SEPTA Key cards replace tokens and paper transfers. Purchase at any SEPTA station, Wawa, or ACME. The Convenience card works without registration; the Registered card protects your balance. Load at septakey.org or at kiosks.', tag:'How-to'},
          {title:'Low-income transit programs in Philadelphia', sub:'SEPTA\u2019s Reduced Fare Program offers 50% discounts for seniors over 65, people with disabilities, and Medicare card holders. The Key Assist program provides subsidized Key cards to income-eligible riders. Apply at transit.phila.gov.', tag:'Resource'},
          {title:'Philly transit safety and rider rights', sub:'SEPTA riders have the right to safe, accessible transportation. Report unsafe conditions to SEPTA Transit Police at 215-580-8111. Riders with disabilities can use SEPTA\u2019s accessibility complaint process at septa.org/ada.', tag:'Rights'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'SEPTA Key Assist \u2014 subsidized transit for low-income Philadelphians', sub:'City-funded program in partnership with SEPTA provides subsidized monthly TransPasses to income-eligible Philadelphia residents. Administered through Community Legal Services and participating social service agencies.', tag:'Program'},
          {title:'Philadelphia Bill No. 220856 \u2014 Congestion pricing study authorization', sub:'City Council resolution directed the Office of Transportation to study congestion-based pricing for Center City and commissioned a report on equity impacts for low-income commuters and transit-dependent households.', tag:'City ordinance'},
          {title:'H.B. 2088 \u2014 SEPTA Capital Funding Reform Act (PA, 2025)', sub:'Proposes dedicated state funding stream for SEPTA capital projects through a 0.5% increase in the state\u2019s sales tax on fuel. Would provide $400M annually for track, signal, and station upgrades. Passed House Transportation Committee May 2025.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Bus','Subway','Regional Rail','Rideshare','Bike share']
    },
    'Moving & logistics': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia moving logistics \u2014 navigating narrow streets and parking', sub:'Many Philly streets are too narrow for large moving trucks. Scope the route in advance and note any low bridges or one-way streets. The Streets Department\u2019s online map shows street width restrictions and loading zone locations.', tag:'Guide'},
          {title:'Freight and delivery resources for small Philadelphia businesses', sub:'The Philadelphia Commerce Department\u2019s Delivery Innovation Task Force has published guidance on last-mile delivery for small businesses including approved loading zone use and cargo bike delivery options in Center City.', tag:'Resource'},
          {title:'Philly community mutual aid \u2014 neighbor-to-neighbor moving help', sub:'Several Philly mutual aid networks (West Philly Mutual Aid, Germantown Mutual Aid) coordinate volunteer moving help for neighbors in need, particularly seniors, people with disabilities, and those facing eviction.', tag:'Community'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Philadelphia Streets Department \u2014 Loading Zone and Delivery Management Program', sub:'Commercial delivery operators can apply for designated loading zone permits in high-density commercial corridors. Program launched as part of the City\u2019s Curbside Management Plan. Fee schedule at phila.gov/streets.', tag:'City program'},
          {title:'PA PUC \u2014 freight broker and household goods mover regulations', sub:'PA requires all for-hire motor carriers operating within the state to hold a PUC Certificate of Public Convenience. Brokers arranging moves must register separately. Consumer complaint process at puc.pa.gov.', tag:'Program'},
          {title:'S.B. 612 \u2014 Last-Mile Delivery Vehicle Emissions Standards (PA, 2025)', sub:'Would require delivery vehicles under 10,000 lbs GVWR registered in PA to meet zero-emission standards by 2030. Includes voucher program for small delivery businesses to transition to EVs. Introduced September 2025.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Residential','Commercial','Freight','Courier','Storage']
    },
    'Vehicle services': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia street sweeping schedule \u2014 and how to avoid tickets', sub:'The Streets Department posts sweeping schedules at phila.gov/streets. Alternate-side parking rules are enforced by PPA. Sign up for text alerts through the PPA app to avoid $51 cleaning violation tickets.', tag:'How-to'},
          {title:'PA vehicle inspection requirements \u2014 what you need to know', sub:'Pennsylvania requires annual safety inspections and biennial emissions inspections for most vehicles. Stickers expire at the end of the month shown. Driving with an expired sticker is a $25 fine plus court costs.', tag:'Guide'},
          {title:'Free car seat inspections in Philadelphia', sub:'Philadelphia Fire Department stations and several hospitals offer free car seat inspection events. Certified Child Passenger Safety Technicians verify installation and fit. Find events at safercar.gov/cpsApp.', tag:'Resource'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'PA Vehicle Code \u2014 inspection station licensing and consumer rights', sub:'PennDOT licenses all PA vehicle inspection stations. If a station fails your vehicle, you have the right to a reinspection at a different station. File complaints about inspection fraud at 1-800-932-4600.', tag:'Rights'},
          {title:'Philadelphia Parking Authority \u2014 residential permit parking program', sub:'RPP allows residents in designated zones to park without time limits. Annual permit costs $35. Applications processed online at philapark.org. Zone maps updated annually based on community petitions.', tag:'City program'},
          {title:'H.B. 1654 \u2014 EV Charging Access in Multi-Unit Dwellings (PA, 2025)', sub:'Would require landlords of apartment buildings with 50+ units to permit tenants to install EV charging equipment at their own expense. Prohibits lease provisions blocking EV charger installation. Passed House Commerce Committee June 2025.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Inspection','Registration','Car wash','Towing','Parking']
    },
    'Childcare': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia childcare subsidy \u2014 who qualifies and how to apply', sub:'The Child Care Works subsidy program pays childcare costs for income-eligible Philadelphia families. Income limit is 180% FPL. Apply through OCDEL at compass.state.pa.us. Waitlists exist; apply early.', tag:'Resource'},
          {title:'How to evaluate a licensed childcare provider in Philadelphia', sub:'All licensed childcare centers and family daycare homes in PA are rated through Keystone STARS (1\u20134 stars). Inspection records and complaint history are public at findchildcare.pa.gov. Always verify the provider\u2019s license.', tag:'Guide'},
          {title:'Philadelphia community childcare co-ops and cooperative care networks', sub:'Several Philadelphia neighborhoods have informal childcare co-ops where parents trade care hours. The Philadelphia Parent Child Center network connects families with community-based childcare resources and parenting support.', tag:'Community'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Child Care Works \u2014 PA subsidy program for income-eligible families', sub:'State-funded subsidy covers full or partial childcare costs at licensed providers. Philadelphia administers through the Office of Children and Families. Families pay a sliding-scale copay based on income. Apply at compass.state.pa.us.', tag:'Program'},
          {title:'Philadelphia Universal Pre-K \u2014 PHLpreK expansion', sub:'PHLpreK provides free, high-quality pre-K to Philadelphia 3- and 4-year-olds whose families earn up to 300% FPL. Funded through the Philadelphia Beverage Tax. Over 3,000 seats across 200+ provider sites. Apply at phila.gov/phlprek.', tag:'City program'},
          {title:'H.B. 2450 \u2014 Child Care Provider Tax Credit Act (PA, 2026)', sub:'Would provide PA employers a 30% tax credit for contributions to employee childcare costs or on-site childcare facilities. Also creates a refundable credit for home daycare providers who achieve Keystone STARS 3 or 4 rating.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Infant','Toddler','Pre-K','After school','Subsidy']
    },
    'Elder care': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia Corporation for Aging \u2014 services for residents 60 and older', sub:'PCA is the Area Agency on Aging for Philadelphia. Services include in-home care, Meals on Wheels, caregiver support, benefits counseling, and protective services. Call the helpline at 215-765-9040 (M\u2013F 8am\u20136pm).', tag:'Resource'},
          {title:'How to spot elder financial abuse in Philadelphia', sub:'Financial abuse is the most common form of elder abuse in PA. Signs include unusual bank transactions, unpaid bills, or sudden changes to legal documents. Report to PCA\u2019s Protective Services at 215-765-9040 or APS at 1-800-490-8505.', tag:'Guide'},
          {title:'Philadelphia senior centers \u2014 free programs and lunch five days a week', sub:'The City and PCA fund 32 senior centers across Philadelphia offering congregate meals, fitness, social programming, and benefits enrollment help. No income requirement for most programs. Find your nearest center at pcacares.org.', tag:'Community'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'PA PENNCARE \u2014 home and community-based waiver programs for older adults', sub:'The PA Department of Human Services administers OBRA and COMMCARE waivers providing in-home services (personal care, adult day, home modifications) to Medicaid-eligible seniors as an alternative to nursing home placement.', tag:'Program'},
          {title:'Philadelphia Property Tax Freeze for seniors \u2014 Senior Citizen Tax Freeze', sub:'Philadelphia homeowners 65+ with incomes under $33,500 can freeze their property tax at current assessment. Freezes do not accumulate; the current bill stays flat indefinitely while enrolled. Apply at phila.gov/otr.', tag:'City program'},
          {title:'S.B. 838 \u2014 Personal Care Home Reform Act (PA, 2025)', sub:'Would increase staffing ratios, require 24-hour supervision in licensed personal care homes, and establish a state ombudsman for personal care home residents. Passed Senate Aging & Youth Committee October 2025.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','In-home care','Adult day','Meals','Transportation','Housing']
    },
    'Youth & after-school': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia Out-of-School Time \u2014 finding after-school programs near you', sub:'The City\u2019s OST program funds after-school and summer enrichment at over 200 sites across Philadelphia. Programs are free or low-cost for income-eligible families. Search at phila.gov/ost or call 215-685-1830.', tag:'Resource'},
          {title:'Summer camp and recreation options for Philadelphia youth', sub:'Philadelphia Parks & Recreation runs summer camps at 25+ recreation centers across the city. Fee assistance is available. The Fairmount Park Conservancy\u2019s camp scholarship fund helps cover costs for families in need.', tag:'Community'},
          {title:'What to look for in a quality after-school program', sub:'Quality indicators include certified staff, low child-to-staff ratios, structured homework time, and enrichment activities. Ask about staff turnover, safety protocols, and family communication practices before enrolling.', tag:'Guide'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Philadelphia 21st Century Community Learning Centers grants', sub:'Federally funded after-school and summer program grants administered through PDE. Philadelphia schools and nonprofits apply for 3-year grants to run evidence-based OST programs. Priority for high-poverty schools.', tag:'Federal'},
          {title:'Philadelphia Youth Commission \u2014 Youth Grants Program', sub:'City grants up to $5,000 for youth-led projects and organizations serving Philadelphia young people ages 14\u201324. Applications open annually in winter. Details at phila.gov/youth.', tag:'City program'},
          {title:'H.B. 1399 \u2014 Youth Workforce Investment Act (PA, 2025)', sub:'Expands Pennsylvania\u2019s youth workforce development funding by $25M annually through WIOA Title I reauthorization. Prioritizes youth ages 16\u201324 who are out of school or system-involved. Passed House Labor Committee March 2025.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Academic','Arts','Sports','STEM','Summer']
    },
    'Pets': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'ACCT Philly \u2014 adoption, low-cost vet care, and surrender resources', sub:'ACCT Philly (Animal Care & Control Team) is the City\u2019s open-admission shelter. Offers adoptions, low-cost spay/neuter, community cat programs, and pet food pantry. Located at 111 W. Hunting Park Ave. acctphilly.org.', tag:'Resource'},
          {title:'Low-cost veterinary care in Philadelphia \u2014 where to find it', sub:'The Pennsylvania SPCA and ACCT offer low-cost vaccine clinics and wellness services. Red Paw Emergency Relief Team provides emergency vet care for pets of people facing housing instability. Many vet schools offer discounted care.', tag:'Resource'},
          {title:'Philadelphia dog laws \u2014 leash rules, registration, and prohibited breeds', sub:'All dogs in Philadelphia must be licensed annually through ACCT. Leash law requires dogs on leash in all public areas except designated off-leash zones. Philadelphia does not have a breed-specific ban. Register at acctphilly.org.', tag:'Guide'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Philadelphia Dog License \u2014 annual registration requirement', sub:'Philadelphia dog owners must license their dog annually through ACCT Philly. Fee is $10 for spayed/neutered dogs, $35 unaltered. Revenue supports animal control operations. Unlicensed dogs subject to $300 fine.', tag:'City program'},
          {title:'PA Dog Law \u2014 Bureau of Dog Law Enforcement regulations', sub:'The PA Department of Agriculture enforces the Dog Law (3 Pa.C.S. \u00a7 459) governing kennel licensing, dangerous dog hearings, and cruelty investigations. File complaints about dangerous or mistreated dogs at 1-800-698-6423.', tag:'Bill \u00b7 State'},
          {title:'H.B. 1821 \u2014 Pet Protection in Domestic Violence Cases (PA, 2025)', sub:'Allows PA courts to include pets in Protection From Abuse orders, granting temporary custody to abuse survivors. Passed House Judiciary Committee January 2025. Builds on 2022 Act 68 which first introduced pet provisions.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Dogs','Cats','Veterinary','Grooming','Training']
    },
    'Clothing & tailoring': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia thrift and consignment shops by neighborhood', sub:'Philly has a strong secondhand clothing culture. Top spots include Community Thrift (South Philly), Retrospect (Manayunk), and Philly AIDS Thrift (Bella Vista). Proceeds from several shops support local nonprofits.', tag:'Community'},
          {title:'Finding a tailor for alterations and custom work in Philadelphia', sub:'Look for tailors certified through the Tailors Guild or with verifiable portfolio work. Ask about turnaround time, whether they do hand-stitching vs. machine only, and whether they have experience with your garment\u2019s fabric.', tag:'Guide'},
          {title:'Dress for Success Philadelphia \u2014 professional clothing for job seekers', sub:'Dress for Success provides free professional clothing and career development support to women entering the workforce. Appointments required. Located at 1420 Walnut St. Referrals accepted from partner agencies or self-referral.', tag:'Resource'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Philadelphia Fashion Incubator \u2014 design business support', sub:'Operated through the Philadelphia Museum of Art, the Fashion Incubator provides subsidized studio space, mentorship, and business development resources to emerging Philadelphia-based fashion designers. Applications open annually.', tag:'Program'},
          {title:'PA Textile Recycling Program \u2014 collection sites and accepted materials', sub:'PA DEP funds textile recycling through municipal solid waste grants. Philadelphia Streets Department operates drop-off locations for used clothing and textiles at sanitation convenience centers. Diverts over 4,000 tons annually.', tag:'Program'},
          {title:'Philadelphia Wage Tax exemption \u2014 what self-employed tailors need to know', sub:'Philadelphia residents working as self-employed tailors or seamstresses must file a Philadelphia Net Profits Tax return. Non-resident tailors working in the city owe the Earnings Tax on Philly-sourced income. Details at phila.gov/revenue.', tag:'Guide'}
        ]
      },
      filterChips: ['All','Alterations','Custom','Thrift','Formal wear','Sustainable']
    },
    'Arts & culture': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia free museum days and cultural access programs', sub:'The Philadelphia Museum of Art, Franklin Institute, Please Touch Museum, and Academy of Natural Sciences all offer free or reduced admission days. The EBT Museum Access program provides $3 admission for SNAP recipients at participating institutions.', tag:'Resource'},
          {title:'Philadelphia Mural Arts Program \u2014 tours, community projects, and artist opportunities', sub:'Mural Arts Philadelphia offers free neighborhood mural tours, youth art programs, and open calls for professional artists. The Guild program provides mural production jobs for Philadelphians in recovery or re-entry. muralarts.org.', tag:'Community'},
          {title:'Finding studio space and residencies for Philadelphia artists', sub:'The City\u2019s Office of Arts, Culture and the Creative Economy maintains a studio space database. Crane Arts, Vox Populi, and the Icebox Project Space offer residencies and subsidized studios for working artists.', tag:'Resource'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Philadelphia Cultural Fund \u2014 city grants for arts organizations', sub:'The Philadelphia Cultural Fund distributes $2.5M+ annually to Philadelphia-based arts and culture organizations through competitive grant rounds. Eligible organizations must be 501(c)(3) and have at least two years of programming history.', tag:'Program'},
          {title:'PA Council on the Arts \u2014 individual artist and organization grants', sub:'PCA offers grants to PA artists and organizations including the Artistic Excellence Program and Arts Organization grants. Philadelphia applicants eligible for all statewide categories. Applications at arts.pa.gov.', tag:'Program'},
          {title:'Philadelphia Bill No. 230589 \u2014 Artist Live/Work Space Preservation ordinance', sub:'Requires developers converting buildings with existing artist studio or live/work leases to provide 180 days\u2019 notice and right of first refusal to affected tenants. Also requires L&I to track displacement of arts spaces citywide.', tag:'City ordinance'}
        ]
      },
      filterChips: ['All','Visual art','Music','Theater','Film','Dance']
    },
    'Tutoring & coaching': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Free tutoring resources at Philadelphia Free Library branches', sub:'The Free Library of Philadelphia offers free homework help, one-on-one tutoring referrals, and digital literacy support at all branch locations. The Culinary Literacy Center (Parkway Central) offers adult basic education with cooking.', tag:'Resource'},
          {title:'How to evaluate a tutor for your child in Philadelphia', sub:'Look for tutors with subject-specific credentials, references, and a clear assessment process. Ask about their approach to identifying learning gaps vs. simply re-teaching content. Many offer a free first session.', tag:'Guide'},
          {title:'Philadelphia peer tutoring and mentorship networks', sub:'City Year Philadelphia, Big Brothers Big Sisters of Greater Philadelphia, and the YMCA Achievers program all match students with volunteer tutors and mentors. Waitlists exist; apply early in the school year.', tag:'Community'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'Philadelphia ESOP \u2014 Extended School Offerings Program', sub:'SDP-funded program provides free tutoring and enrichment for struggling Philadelphia public school students. Extended School Year (summer school) services available for students with IEPs and those below grade level.', tag:'City program'},
          {title:'PA Education Improvement Tax Credit \u2014 EITC scholarship funding', sub:'PA EITC allows businesses to earn 75\u201390% tax credits for donations to approved scholarship organizations. Scholarship organizations distribute funds to income-eligible students for tutoring and private school tuition. Apply at dced.pa.gov.', tag:'Program'},
          {title:'H.B. 1122 \u2014 Reading Intervention and Literacy Act (PA, 2024)', sub:'Mandates structured literacy instruction in K\u20133 Philadelphia public schools and requires diagnostic reading screenings for all students. Includes funding for reading specialist positions and tutoring through LETRS-trained interventionists.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','K-12','Test prep','Adult literacy','ESL','College prep']
    },
    'Classes & skills': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Philadelphia Free Library \u2014 free classes, workshops, and certifications', sub:'The Free Library offers free computer classes, GED preparation, ESL instruction, digital literacy workshops, and job readiness programs at branches citywide. No library card required for most programs.', tag:'Resource'},
          {title:'Community colleges and continuing education options in Philadelphia', sub:'Community College of Philadelphia offers non-credit workforce training, professional development, and personal enrichment courses. Many courses qualify for WIOA funding for income-eligible adults. Register at ccp.edu.', tag:'Guide'},
          {title:'Skill-share and community learning networks in Philadelphia', sub:'PhillySkillShare and Neighborly connect Philadelphians who want to exchange skills informally. Free and donation-based workshops are posted regularly on Eventbrite, Meetup, and through neighborhood association listservs.', tag:'Community'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'WIOA Adult Education \u2014 free training for Philadelphia workers', sub:'Workforce Innovation and Opportunity Act funding covers tuition-free job training, skills certifications, and OJT for income-eligible Philadelphia adults at approved providers. Apply through Philadelphia Works at philaworks.com.', tag:'Program'},
          {title:'PA Apprenticeship and Training Office \u2014 registered apprenticeship programs', sub:'PA L&I registers apprenticeship programs in over 50 trades and occupations. Apprentices earn while they learn. Employers receive $2,000\u20133,000 state incentive for each registered apprentice hired. List at dli.pa.gov.', tag:'Program'},
          {title:'Philadelphia Digital Equity Fund \u2014 technology training grants', sub:'City-funded program provides laptops, internet access, and digital skills training to income-eligible Philadelphians. Administered through the Mayor\u2019s Office of Innovation and Technology in partnership with digital literacy nonprofits.', tag:'City program'}
        ]
      },
      filterChips: ['All','Digital skills','Language','Creative','Certification','Workforce']
    },
    'Trades & apprenticeships': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'How to enter the building trades in Philadelphia', sub:'Philadelphia\u2019s joint apprenticeship training committees (JATCs) are the primary path into the unionized trades. Programs in electrical, plumbing, ironwork, and carpentry are highly competitive. Most require a high school diploma and math assessment.', tag:'Guide'},
          {title:'Pre-apprenticeship programs for Philadelphia residents', sub:'Build Commonwealth and Utility Workers of the World pre-apprenticeship programs prepare Philadelphia residents \u2014 especially women and people of color \u2014 for entry into union apprenticeships. Programs are free and include stipends.', tag:'Resource'},
          {title:'Philadelphia Building Trades Council \u2014 union apprenticeship directory', sub:'The Philadelphia Building and Construction Trades Council coordinates joint apprenticeships for 18 affiliated unions. Applications typically open annually. Visit the council at 1500 N. American St for current openings.', tag:'Community'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
        items: [
          {title:'PA Apprenticeship Tax Credit \u2014 up to $3,000 per apprentice hired', sub:'PA employers who hire registered apprentices receive a $2,000 credit in year one and $1,000 in year two, per apprentice. Credit applied against PA Corporate Net Income Tax. Apply through PA L&I Office of Apprenticeships.', tag:'Program'},
          {title:'Philadelphia Executive Order 06-11 \u2014 local hiring on city contracts', sub:'Requires prime contractors on city-funded construction projects over $500,000 to make good-faith efforts to hire Philadelphia residents and MBE/WBE firms. L&I monitors compliance and can withhold payment for violations.', tag:'City ordinance'},
          {title:'H.B. 1780 \u2014 Skilled Workforce Scholarship Act (PA, 2025)', sub:'Creates a $5,000 annual scholarship for PA residents enrolled in approved trade apprenticeship programs. Priority for students from households below 300% FPL. Funded through PA Higher Education Assistance Agency. Passed Senate October 2025.', tag:'Bill \u00b7 State'}
        ]
      },
      filterChips: ['All','Electrical','Plumbing','Carpentry','HVAC','Ironwork']
    },
    'Legal aid': {
      temple: {
        label: 'Temple \u2014 community resources & what to know',
        items: [
          {title:'Free legal help in Philadelphia \u2014 who to call first', sub:'Community Legal Services (CLS) provides free civil legal aid to low-income Philadelphians in housing, benefits, consumer, and family law. Call 215-981-3700. Philadelphia Volunteers for the Indigent Program (VIP) connects clients with pro bono attorneys.', tag:'Resource'},
          {title:'Know your rights as a Philadelphia renter', sub:'Philadelphia tenants have among the strongest protections in Pennsylvania: right to a livable unit (implied warranty of habitability), right to the Tenant\u2019s Bill of Rights notice at lease signing, and protection from retaliatory eviction. Know your rights at clsphila.org.', tag:'Rights'},
          {title:'Philadelphia Bar Association Lawyer Referral Service', sub:'The PBA Lawyer Referral Service connects Philadelphia residents with attorneys for a $35 consultation fee. Referrals available in most practice areas. Sliding-scale and pro bono attorneys identified during intake. Call 215-238-6333.', tag:'Resource'}
        ]
      },
      forum: {
        label: 'Forum \u2014 legislation, programs & incentives',
