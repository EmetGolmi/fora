<% content_for(:title) { "My Government — FORA" } %>

<% content_for :head do %>
<style>
  .rep-item:hover { background:#edf1fb; margin-left:-12px !important; margin-right:-12px !important; padding-left:12px !important; padding-right:12px !important; border-radius:6px; }
  .bill-card:hover { background:#f4f7fc !important; }
  .back-link:hover { color:#1b3a6b !important; }
</style>
<% end %>

<%
  party_labels = { "D" => "Democratic", "R" => "Republican", "W" => "Working Families", "I" => "Independent" }
  city_offices = %w[mayor city_council city_council_at_large]
  federal_offices = %w[federal president vice_president us_senate us_house]
  state_offices = %w[governor lt_governor]

  classify_level = ->(official) {
    jur_name = official.dig(:jurisdiction, :name).to_s
    division_id = official.dig(:jurisdiction, :division_id).to_s
    if city_offices.include?(jur_name)
      "City"
    elsif division_id.include?("sldu") || division_id.include?("sldl:")
      "State"
    elsif federal_offices.include?(jur_name) || division_id.include?("cd:")
      "Federal"
    elsif state_offices.include?(jur_name)
      "State"
    elsif %w[upper lower].include?(jur_name)
      "State"
    else
      "Federal"
    end
  }

  format_party = ->(raw) {
    return raw unless raw
    party_labels[raw.strip] || raw
  }

  format_office = ->(official) {
    office = official[:office].to_s
    district = official.dig(:jurisdiction, :district).to_s.strip
    has_district = district.present? && district != "0"

    if office.start_with?("U.S. Representative")
      has_district ? "U.S. Representative, Congressional District #{district}" : office
    elsif office.start_with?("State Senator")
      has_district ? "State Senator, District #{district}" : office
    elsif office.start_with?("State Representative")
      has_district ? "State Representative, District #{district}" : office
    elsif office == "City Council" || office.start_with?("City Council,")
      has_district ? "City Council, District #{district}" : office
    else
      office
    end
  }

  level_badge = ->(level) {
    case level
    when "Federal" then "background:#dde5f5; color:#1b3a6b; border:1px solid rgba(27,58,107,0.18);"
    when "State"   then "background:#e5f0e8; color:#155c2d; border:1px solid rgba(21,92,45,0.2);"
    when "City"    then "background:#f8f0dc; color:#b8860b; border:1px solid rgba(184,134,11,0.25);"
    else                "background:#f0f3f8; color:#5a6e8a; border:1px solid rgba(90,110,138,0.18);"
    end
  }

  party_color = ->(raw) {
    case (raw || "").strip
    when "D" then "#3a6abf"
    when "R" then "#8b2020"
    else "#5a6e8a"
    end
  }
%>

<div style="max-width:900px; margin:0 auto; padding:36px 24px 60px;">

  <% if @jurisdiction.nil? %>
    <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:12px; padding:32px; text-align:center;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.16em; text-transform:uppercase; color:#8a9ab8; margin-bottom:12px;">Address Not Found</div>
      <p style="font-family:'Nunito',sans-serif; font-size:15px; color:#5a6e8a;">Could not resolve: <strong style="color:#0e1a2e;"><%= @address %></strong></p>
      <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; margin-top:8px;">Please check the address and try again.</p>
    </div>
  <% elsif @jurisdiction[:not_covered] %>
    <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:12px; padding:36px 32px; text-align:center;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.2em; text-transform:uppercase; color:#b8860b; margin-bottom:14px;">◆ Coming Soon</div>
      <p style="font-family:'Libre Baskerville',serif; font-size:18px; font-weight:700; color:#1b3a6b; margin:0 0 10px; line-height:1.3;"><%= @jurisdiction[:message] %></p>
      <p style="font-family:'Nunito',sans-serif; font-size:13px; color:#8a9ab8; margin:0;">You searched for: <strong style="color:#5a6e8a;"><%= @address %></strong></p>
    </div>
  <% else %>

    <!-- Address header -->
    <div style="margin-bottom:28px;">
      <h1 style="font-family:'Libre Baskerville',serif; font-size:24px; font-weight:700; color:#0e1a2e; line-height:1.2; margin-bottom:4px;">My Government — <%= @jurisdiction[:normalized_address] %></h1>
      <span style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.1em; text-transform:uppercase; color:#8a9ab8;"><%= @jurisdiction[:city] %>, <%= @jurisdiction[:state] %> <%= @jurisdiction[:zip] %></span>
    </div>

    <!-- Representatives card -->
    <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:12px; margin-bottom:32px; overflow:hidden;">
      <div style="padding:12px 20px 11px; border-bottom:1px solid rgba(27,58,107,0.09); display:flex; align-items:center; gap:8px;">
        <div style="width:6px; height:6px; border-radius:50%; background:#1b3a6b; flex-shrink:0;"></div>
        <span style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:#5a6e8a;">My Government</span>
      </div>

      <div style="padding:4px 20px 14px;">
        <% if @jurisdiction[:officials].any? %>
          <%
            grouped = @jurisdiction[:officials].group_by { |o| classify_level.call(o) }
            level_order = %w[Federal State City]
          %>
          <% level_order.each do |level| %>
            <% next unless grouped[level]&.any? %>

            <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.16em; text-transform:uppercase; color:#8a9ab8; padding:12px 0 4px; border-bottom:1px solid rgba(27,58,107,0.06); margin-bottom:2px;"><%= level %></div>

            <% grouped[level].each do |official| %>
              <% bioguide     = official.dig(:jurisdiction, :bioguide_id) %>
              <% openstates_id = official.dig(:jurisdiction, :openstates_id) %>
              <div class="rep-item" style="display:flex; align-items:center; gap:9px; padding:8px 0; border-bottom:1px solid rgba(27,58,107,0.06); cursor:pointer; transition:all 0.12s;">
                <div style="flex:1; min-width:0;">
                  <% if bioguide.present? %>
                    <%= link_to official[:name], official_path(bioguide), style: "font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; color:#0e1a2e; text-decoration:none; display:block; line-height:1.25;" %>
                  <% elsif openstates_id.present? %>
                    <%= link_to official[:name], state_official_path(openstates_id), style: "font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; color:#0e1a2e; text-decoration:none; display:block; line-height:1.25;" %>
                  <% else %>
                    <span style="font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; color:#0e1a2e; display:block; line-height:1.25;"><%= official[:name] %></span>
                  <% end %>
                  <span style="font-family:'Nunito',sans-serif; font-size:11.5px; color:#5a6e8a;"><%= format_office.call(official) %></span>
                </div>
                <span style="font-family:'Nunito',sans-serif; font-size:11.5px; color:<%= party_color.call(official[:party].to_s) %>; font-weight:600; flex-shrink:0;"><%= format_party.call(official[:party]) %></span>
                <span style="font-size:12px; color:#8a9ab8; margin-left:2px; flex-shrink:0;">›</span>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; padding:20px 0; text-align:center;">No representatives found for this address.</p>
        <% end %>
      </div>
    </div>

  <% end %>

  <!-- Legislation Toggle -->
  <%
    jur_to_level_rail = ->(jur) {
      case jur
      when "federal"      then ["Federal", "#B22234"]
      when "pennsylvania" then ["State",   "#003087"]
      when "philadelphia" then ["City",    "#004C54"]
      else                     ["Other",   "#8a9ab8"]
      end
    }

    friendly_status = ->(raw) {
      return [nil, false] if raw.blank?
      s = raw.to_s.upcase.strip
      if    s.include?("REFERRED") || s.include?("READ TWICE") then ["Under Review",   true]
      elsif s == "IN COMMITTEE"                                 then ["In Committee",   true]
      elsif s == "IN COUNCIL - FINAL PASSAGE"                   then ["Final Passage",  false]
      elsif s == "IN COUNCIL"                                   then ["Before Council", true]
      elsif s == "ADOPTED"                                      then ["Adopted",        false]
      else  [raw.to_s.split.map(&:capitalize).join(" "), true]
      end
    }

    status_color_for = ->(label) {
      case label
      when "Under Review"                   then "#b8860b"
      when "In Committee", "Before Council" then "#185FA5"
      when "Adopted"                        then "#2d6a2d"
      when "Final Passage"                  then "#8b1a1a"
      else                                       "#8a9ab8"
      end
    }

    docket_bills_safe = @docket_bills || []
    record_bills_safe = @record_bills || []
    docket_total_safe = @docket_total || 0
    record_total_safe = @record_total || 0
  %>

  <div style="margin-bottom:36px;">

    <!-- Toggle header -->
    <div style="border-left:2px solid #b8860b; padding-left:10px; margin-bottom:14px; display:flex; align-items:flex-end; justify-content:space-between; gap:12px;">
      <div>
        <h2 id="bills-title" style="font-family:'Libre Baskerville',serif; font-size:18px; font-weight:700; color:#1b3a6b; margin:0 0 4px; line-height:1.2;">The Docket</h2>
        <a id="bills-toggle-link" href="javascript:void(0)" onclick="foraBillsToggle()" style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.1em; color:#b8860b; text-decoration:none; cursor:pointer;">Check The Record →</a>
      </div>
      <span id="bills-count" style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; color:#8a9ab8; white-space:nowrap; padding-bottom:2px;"><%= docket_total_safe %> upcoming actions</span>
    </div>

    <!-- ── Docket panel ── -->
    <div id="docket-panel">
      <div id="docket-feed">
        <% if docket_bills_safe.any? %>
          <% docket_bills_safe.each do |b| %>
            <%= render "shared/bill_card", bill: b, bill_id: b.try(:id), show_action_badge: true %>
          <% end %>
        <% else %>
          <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; padding:16px 0;">No active bills on the docket.</p>
        <% end %>
      </div>
      <div id="docket-sentinel" style="height:1px;">
        <% unless @docket_has_more %>
          <% if docket_bills_safe.any? %>
            <div style="text-align:center; padding:16px; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#8a9ab8;">★ All bills loaded</div>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- ── Record panel ── -->
    <div id="record-panel" style="display:none;">
      <div id="record-feed">
        <% if record_bills_safe.any? %>
          <% record_bills_safe.each do |b| %>
            <%= render "shared/bill_card", bill: b, bill_id: b.try(:id), show_action_badge: false %>
          <% end %>
        <% else %>
          <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; padding:16px 0;">No bills in the record.</p>
        <% end %>
      </div>
      <div id="record-sentinel" style="height:1px;">
        <% unless @record_has_more %>
          <% if record_bills_safe.any? %>
            <div style="text-align:center; padding:16px; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.2em; text-transform:uppercase; color:#8a9ab8;">★ All bills loaded</div>
          <% end %>
        <% end %>
      </div>
    </div>

  </div>

</div>

<script>
(function () {
  // ── State ──────────────────────────────────────────────────────────────
  var state = {
    docket: { offset: 18, hasMore: <%= @docket_has_more %>, fetching: false, total: <%= docket_total_safe %> },
    record: { offset: 18, hasMore: <%= @record_has_more %>, fetching: false, total: <%= record_total_safe %> }
  };
  var docketActive = true;

  // ── Helpers ────────────────────────────────────────────────────────────
  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function friendlyStatus(raw) {
    if (!raw) return [null, false];
    var s = raw.toUpperCase().trim();
    if (s.indexOf('REFERRED') !== -1 || s.indexOf('READ TWICE') !== -1) return ['Under Review',   true];
    if (s === 'IN COMMITTEE')               return ['In Committee',   true];
    if (s === 'IN COUNCIL - FINAL PASSAGE') return ['Final Passage',  false];
    if (s === 'IN COUNCIL')                 return ['Before Council', true];
    if (s === 'ADOPTED')                    return ['Adopted',        false];
    var words = raw.split(' ');
    return [words.map(function(w){ return w.charAt(0).toUpperCase() + w.slice(1).toLowerCase(); }).join(' '), true];
  }

  function statusColor(label) {
    if (label === 'Under Review')                                 return '#b8860b';
    if (label === 'In Committee' || label === 'Before Council')   return '#185FA5';
    if (label === 'Adopted')                                      return '#2d6a2d';
    if (label === 'Final Passage')                                return '#8b1a1a';
    return '#8a9ab8';
  }

  function jurInfo(jur) {
    if (jur === 'federal')      return ['Federal', '#B22234'];
    if (jur === 'pennsylvania') return ['State',   '#003087'];
    if (jur === 'philadelphia') return ['City',    '#004C54'];
    return ['Other', '#8a9ab8'];
  }

  function buildCard(b, view) {
    var info    = jurInfo(b.jurisdiction);
    var level   = info[0], rail = info[1];
    var fs      = friendlyStatus(b.status);
    var label   = fs[0], ongoing = fs[1];
    var dateStr = b.status_date || '';
    var metaHtml = '';

    if (view === 'docket') {
      if (label)   metaHtml += '<div style="font-family:\'JetBrains Mono\',monospace;font-size:7px;letter-spacing:0.06em;color:' + statusColor(label) + ';margin-bottom:3px;">' + esc(label) + '</div>';
      if (dateStr) metaHtml += '<div style="font-family:\'JetBrains Mono\',monospace;font-size:7px;letter-spacing:0.06em;color:#b8860b;background:rgba(184,134,11,0.09);border:0.5px solid rgba(184,134,11,0.3);border-radius:3px;padding:1px 6px;display:inline-block;">Upcoming Action \xB7 ' + esc(dateStr) + '</div>';
    } else {
      if (label)   metaHtml += '<div style="font-family:\'JetBrains Mono\',monospace;font-size:7px;letter-spacing:0.06em;color:' + statusColor(label) + ';margin-bottom:3px;">' + esc(label) + '</div>';
      if (dateStr) metaHtml += '<div style="font-family:\'JetBrains Mono\',monospace;font-size:7px;letter-spacing:0.06em;color:#8a9ab8;">' + (ongoing ? 'as of ' + esc(dateStr) : esc(dateStr)) + '</div>';
    }

    var idPart = b.identifier ? ' \xB7 ' + esc(b.identifier) : '';
    var mb     = view === 'docket' ? '6px' : '5px';
    return '<a href="/bills/' + b.id + '" style="text-decoration:none;display:block;color:inherit;">' +
      '<div class="bill-card" style="display:flex;align-items:stretch;background:white;border:0.5px solid #dde5f5;border-radius:8px;margin-bottom:8px;overflow:hidden;transition:background 0.12s;cursor:pointer;">' +
        '<div style="width:8px;background:' + rail + ';flex-shrink:0;"></div>' +
        '<div style="flex:1;padding:12px 14px;">' +
          '<div style="font-family:\'JetBrains Mono\',monospace;font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:' + rail + ';margin-bottom:4px;">' + esc(level) + idPart + '</div>' +
          '<div style="font-family:\'Nunito\',sans-serif;font-size:11px;font-weight:600;color:#1b3a6b;line-height:1.35;margin-bottom:' + mb + ';">' + (function(t){ return t.length > 216 ? esc(t.slice(0,216)) + '…' : esc(t); })(b.title || '') + '</div>' +
          metaHtml +
        '</div>' +
      '</div>' +
    '</a>';
  }

  // ── Load more ──────────────────────────────────────────────────────────
  function loadMore(view) {
    var s = state[view];
    if (s.fetching || !s.hasMore) return;
    s.fetching = true;

    var sentinel = document.getElementById(view + '-sentinel');
    sentinel.innerHTML = '<div style="text-align:center;padding:16px;font-family:\'JetBrains Mono\',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:#b8860b;">&#9670; Loading...</div>';

    fetch('/dashboard/bills?view=' + view + '&offset=' + s.offset)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var feed = document.getElementById(view + '-feed');
        data.bills.forEach(function(b) { feed.insertAdjacentHTML('beforeend', buildCard(b, view)); });
        s.offset  += data.bills.length;
        s.hasMore  = data.has_more;
        s.fetching = false;
        sentinel.innerHTML = s.hasMore
          ? ''
          : '<div style="text-align:center;padding:16px;font-family:\'JetBrains Mono\',monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:#8a9ab8;">&#9733; All bills loaded</div>';
      })
      .catch(function() { s.fetching = false; sentinel.innerHTML = ''; });
  }

  // ── IntersectionObserver ───────────────────────────────────────────────
  if ('IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        loadMore(entry.target.id.replace('-sentinel', ''));
      });
    }, { rootMargin: '300px' });
    ['docket', 'record'].forEach(function(v) {
      var el = document.getElementById(v + '-sentinel');
      if (el) observer.observe(el);
    });
  }

  // ── Toggle ─────────────────────────────────────────────────────────────
  window.foraBillsToggle = function () {
    docketActive = !docketActive;
    var view = docketActive ? 'docket' : 'record';
    document.getElementById('docket-panel').style.display    = docketActive ? 'block' : 'none';
    document.getElementById('record-panel').style.display    = docketActive ? 'none'  : 'block';
    document.getElementById('bills-title').textContent       = docketActive ? 'The Docket' : 'The Record';
    document.getElementById('bills-toggle-link').textContent = docketActive ? 'Check The Record \u2192' : 'See what\'s on The Docket \u2192';
    document.getElementById('bills-count').textContent       = docketActive
      ? state.docket.total + ' upcoming actions'
      : state.record.total + ' recent bills';

    // Manually trigger if sentinel already in viewport
    var sentinel = document.getElementById(view + '-sentinel');
    if (sentinel) {
      var rect = sentinel.getBoundingClientRect();
      if (rect.top < window.innerHeight + 300) loadMore(view);
    }
  };
}());
</script>
