function wsShowDetail(key) {
  wsActiveKey = key; wsActiveTab = 0;
  document.querySelectorAll('.ws-card').forEach(function(c){ c.classList.toggle('active', c.dataset.wskey===key); });
  wsRenderDetail();
}
function wsSwitchTab(i) { wsActiveTab=i; wsRenderDetail(); }

function wsRenderDetail() {
  if (!wsData) return;
  var d = wsData, det = wsDetails[wsActiveKey];
  var title = typeof det.title==='function'?det.title(d):det.title;
  var sub   = typeof det.sub==='function'?det.sub(d):det.sub;
  var html = '<div class="ws-detail-title"><i class="ti ti-info-circle" style="color:#1b3a6b;font-size:16px"></i>'+wsEsc(title)+'</div>'
    +'<div class="ws-detail-sub">'+wsEsc(sub)+'</div>'
    +'<div class="ws-nav-row">';
  ['Official','Community','Compare'].forEach(function(t,i){
    html += '<div class="ws-nav-btn'+(wsActiveTab===i?' active':'')+'" onclick="wsSwitchTab('+i+')">'+t+'</div>';
  });
  html += '</div>';

  if (wsActiveTab===0) {
    det.official.forEach(function(item){
      html += wsPsaCard(item.badge,item.label,item.text,item.meta);
    });
  } else if (wsActiveTab===1) {
    det.creators.forEach(function(item){
      html += wsPsaCard(item.badge,item.label,item.text,item.meta);
    });
    html += wsPsaCard('badge-resident','You','Share how this metric is affecting your day \u2014 your experience, your neighborhood.',
      '<span style="cursor:pointer;color:#1b3a6b;font-size:11px" onclick="wallOpenCompose()">Post to the wall \u2197</span>');
  } else {
    var rows = typeof det.compare==='function'?det.compare(d):det.compare;
    var colors = ['#1b3a6b','#378add','#1d9e75','#ba7517'];
    html += '<div style="margin-bottom:4px;font-size:11px;color:var(--ink-mut)">How the numbers compare</div>';
    rows.forEach(function(row,i){
      var pct = row.max>0?Math.min(Math.round((row.val/row.max)*100),100):0;
      html += '<div class="ws-compare-row"><div class="ws-compare-name">'+wsEsc(row.name)+'</div>'
        +'<div class="ws-compare-track"><div class="ws-compare-fill" style="width:'+pct+'%;background:'+colors[i%colors.length]+'"></div></div>'
        +'<div class="ws-compare-num">'+row.val+'</div></div>';
    });
    html += wsPsaCard('badge-resident','Community','Compare your block to neighboring areas. Tap &ldquo;Community&rdquo; to share what you\'re seeing.',
      '<span style="cursor:pointer;color:#1b3a6b;font-size:11px" onclick="wallOpenCompose()">Post to the wall \u2197</span>');
  }
  var el = document.getElementById('ws-detail-content');
  if (el) el.innerHTML = html;
}

function wsPsaCard(badge, label, text, meta) {
  return '<div class="ws-psa-card"><span class="ws-psa-badge '+badge+'">'+label+'</span>'
    +'<div><div class="ws-psa-text">'+text+'</div>'+(meta?'<div class="ws-psa-meta">'+meta+'</div>':'')+'</div></div>';
}
function wsEsc(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Wall compose & posts ────────────────────────────────────────────────────
var wallPostType = 'update', wallImgData = null;

function wallOpenCompose() {
  var f = document.getElementById('wall-compose-form');
  f.classList.add('open');
  document.getElementById('wall-compose-text').focus();
}
function wallCloseCompose() {
  document.getElementById('wall-compose-form').classList.remove('open');
  document.getElementById('wall-compose-text').value = '';
  wallImgData = null;
  var prev = document.getElementById('wall-img-preview');
  prev.style.display = 'none'; prev.src = '';
  document.getElementById('wall-post-btn').disabled = true;
  document.getElementById('wall-img-input').value = '';
}
function wallComposeInput() {
  var v = document.getElementById('wall-compose-text').value.trim();
  document.getElementById('wall-post-btn').disabled = !v && !wallImgData;
}
function wallSelectType(el) {
  document.querySelectorAll('.wall-type-chip').forEach(function(c){c.classList.remove('sel');});
  el.classList.add('sel');
  wallPostType = el.dataset.type;
}
function wallLoadImage(ev) {
  var file = ev.target.files[0];
  if (!file) return;
  if (file.size > 5*1024*1024) { alert('Image must be under 5MB'); return; }
  var reader = new FileReader();
  reader.onload = function(e) {
    wallImgData = e.target.result;
    var prev = document.getElementById('wall-img-preview');
    prev.src = wallImgData; prev.style.display = 'block';
    document.getElementById('wall-post-btn').disabled = false;
  };
  reader.readAsDataURL(file);
}
function wallSubmitPost() {
  var body = document.getElementById('wall-compose-text').value.trim();
  if (!body && !wallImgData) return;
  var wall = document.getElementById('home-wall');
  var post = {
    id: 'wp_'+Date.now(),
    type: wallPostType,
    body: body,
    image: wallImgData,
    handle: wall.dataset.handle,
    initials: wall.dataset.initials,
    ts: Date.now(),
    likes: 0,
    liked: false
  };
  var posts = wallGetPosts();
  posts.unshift(post);
  try { localStorage.setItem('fora_wall_posts', JSON.stringify(posts.slice(0,50))); } catch(e){}
  wallCloseCompose();
  wallRenderPosts();
}

function wallGetPosts() {
  try { return JSON.parse(localStorage.getItem('fora_wall_posts')||'[]'); } catch(e){ return []; }
}

function wallRenderPosts() {
  var posts = wallGetPosts();
  var feed = document.getElementById('wall-feed');
  if (!feed) return;
  // Remove existing post cards (not weather card)
  Array.from(feed.querySelectorAll('.wall-post')).forEach(function(el){el.remove();});
  posts.forEach(function(p){
    var div = document.createElement('div');
    div.className = 'wall-post';
    div.id = 'wpost_'+p.id;
    div.innerHTML = wallPostHTML(p);
    feed.appendChild(div);
  });
}

function wallPostHTML(p) {
  var timeAgo = wallTimeAgo(p.ts);
  var typeLabel = {update:'Update',question:'Question',photo:'Photo',link:'Link'}[p.type]||p.type;
  var html = '<div class="wall-post-top">'
    +'<div class="wall-post-meta">'
    +'<div class="wall-post-av">'+wsEsc(p.initials||'?')+'</div>'
    +'<div><div class="wall-post-handle">@'+wsEsc(p.handle)+'</div>'
    +'<div class="wall-post-time">'+timeAgo+'</div></div>'
    +'</div>'
    +'<span class="wall-post-type">'+wsEsc(typeLabel)+'</span>'
    +'</div>';
  if (p.image) html += '<img class="wall-post-img" src="'+p.image+'" alt="Post image">';
  if (p.body) html += '<div class="wall-post-body">'+wsEsc(p.body).replace(/\n/g,'<br>')+'</div>';
  var likedCls = p.liked?' liked':'';
  var likeCount = p.likes>0?' · '+p.likes:'';
  html += '<div class="wall-post-actions">'
    +'<button class="wall-action-btn'+likedCls+'" onclick="wallToggleLike(\''+p.id+'\')">'
    +'<i class="ti ti-heart'+(p.liked?'-filled':'')+'"></i> Like'+likeCount+'</button>'
    +'<div style="position:relative">'
    +'<button class="wall-action-btn" onclick="event.stopPropagation();wallSharePost(\''+p.id+'\',this)"><i class="ti ti-share-2"></i> Share</button>'
    +'<div class="lshare-menu" id="wshare_'+p.id+'"></div>'
    +'</div>'
    +'</div>';
  return html;
}

function wallToggleLike(id) {
  var posts = wallGetPosts();
  var p = posts.find(function(x){return x.id===id;});
  if (!p) return;
  p.liked = !p.liked;
  p.likes = Math.max(0,(p.likes||0)+(p.liked?1:-1));
  try { localStorage.setItem('fora_wall_posts', JSON.stringify(posts.slice(0,50))); } catch(e){}
  var el = document.getElementById('wpost_'+id);
  if (el) el.innerHTML = wallPostHTML(p);
}

function wallSharePost(id, btn) {
  var posts = wallGetPosts();
  var p = posts.find(function(x){return x.id===id;});
  if (!p) return;
  var text = (p.body?p.body.substring(0,100):'Photo post')+' — posted on FORA';
  var url = window.location.href;
  var menuId = 'wshare_'+id;
  toggleShareMenu(menuId, text, url);
}

function wallTimeAgo(ts) {
  var diff = Math.floor((Date.now()-ts)/1000);
  if (diff<60) return 'just now';
  if (diff<3600) return Math.floor(diff/60)+'m ago';
  if (diff<86400) return Math.floor(diff/3600)+'h ago';
  return Math.floor(diff/86400)+'d ago';
}

// Init wall on page load
document.addEventListener('DOMContentLoaded', function() {
  wsLoadWeather();
  wallRenderPosts();
});

// ── Settings panel ─────────────────────────────────────────────────────────
function openSettingsPanel() {
  var iframe = document.getElementById('settings-iframe');
  if (!iframe.getAttribute('data-loaded')) {
    iframe.src = '<%= settings_path %>?embed=1';
    iframe.setAttribute('data-loaded', '1');
    iframe.onload = function() {
      try {
        var h = iframe.contentWindow.document.body.scrollHeight;
        if (h > 200) iframe.style.height = (h + 40) + 'px';
      } catch(e) {}
    };
  }
  switchPanel('settings', null);
}

// ── Temple accordion toggle (no panel) ──────────────────────────────────────
function toggleNavDom(h, prefix) {
  var sl = h.nextElementSibling;
  var isOpen = sl.classList.contains('open');
  var nav = h.parentElement;
  nav.querySelectorAll('.' + prefix + '-dom-h').forEach(function(x){ x.classList.remove('on','open'); });
  nav.querySelectorAll('.' + prefix + '-sub-list').forEach(function(x){ x.classList.remove('open'); });
  if (!isOpen) {
    sl.classList.add('open');
    h.classList.add('on','open');
  }
}

