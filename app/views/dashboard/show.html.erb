                      <div class="rep-stat"><div class="rep-stat-n"><%= o_person.attendance_rate_pct.to_i %>%</div><div class="rep-stat-l">attendance</div></div>
                      <div class="rep-stat"><div class="rep-stat-n"><%= o_person.party_line_vote_pct.to_i %>%</div><div class="rep-stat-l">party-line votes</div></div>
                    <% end %>
                    <% if o_person.bills_introduced_count.present? %>
                      <div class="rep-stat"><div class="rep-stat-n"><%= o_person.bills_introduced_count %></div><div class="rep-stat-l">bills introduced</div></div>
                      <div class="rep-stat"><div class="rep-stat-n"><%= o_person.bills_passed_count || '—' %></div><div class="rep-stat-l">bills passed</div></div>
                    <% end %>
                  </div>
                <% end %>
                <% if o_bills.any? %>
                  <div class="rep-panel-hd">Recent bills</div>
                  <div class="rep-bills">
                    <% o_bills.each do |bill| %>
                      <div class="rep-bill">
                        <span class="rep-bill-id"><%= bill["bill_number"] %></span>
                        <span><%= bill["title"].to_s.truncate(70) %></span>
                      </div>
                    <% end %>
                  </div>
                <% end %>
                <% if prof_path %>
                  <a href="<%= prof_path %>" class="rep-profile-link" onclick="event.stopPropagation();openOfficialProfile('<%= prof_path %>','<%= j o[:name] %>');return false;">Full profile →</a>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div><%# /panel-officials %>

