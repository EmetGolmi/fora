    avClass = (c.avClass || 'av-biz') + ' mkt-hero-avatar';
    avContent = c.av + (c.vetBar ? '<div class="vet-bar">'+c.vetBar+'</div>' : '');
    if (c.avStyle) avClass += '" style="' + c.avStyle.replace(/^style="/,'').replace(/"$/,'');
  } else {
    var initials = c.name.split(/\s+/).slice(0,2).map(function(w){return w[0];}).join('').toUpperCase();
    var avCls2 = c.kind==='nbr'?'av-neighbor':c.kind==='prog'?'av-community':'av-biz';
    avClass = avCls2 + ' mkt-hero-avatar';
    avContent = initials;
  }
  var bdgClass = c.bdgClass || (c.kind==='nbr'?'lbdg-neighbor':c.kind==='prog'?'lbdg-prog':c.kind==='fora'?'lbdg-fora':'lbdg-biz');
  var bdgLabel = c.bdgLabel || (c.kind==='nbr'?'Neighbor':c.kind==='prog'?'Program':c.kind==='fora'?'FORA guide':'Business');
  var cleared  = c.cleared ? '<span class="lbdg lbdg-cleared">&#10003; BG cleared</span>' : '';
  var ratingHtml = c.rating
    ? '<span class="mkt-hero-stars">&#9733; '+c.rating+'</span> <span style="color:#999">('+c.reviewCount+' reviews)</span>'
    : (c.stars ? c.stars : '');
  var svcText = c.svcRadius ? 'Serves within '+c.svcRadius+' mi' : null;
  var metaParts = [c.location, c.price, svcText].filter(Boolean);
  var urlHtml = c.url
    ? '<a href="'+c.url+'" target="_blank" rel="noopener" onclick="event.stopPropagation()" class="listing-url" style="margin-top:6px">&#127760; '+c.url.replace(/^https?:\/\/(www\.)?/,'').replace(/\/$/,'')+'</a>'
    : '';
  var sp = c.socialProof ? '<div class="social-proof-row" style="margin-top:4px">&#128101; '+c.socialProof+'</div>' : '';
  var tags = (c.tags||[]).map(function(t){return '<span class="ltag">'+t+'</span>';}).join('');
  var tagsHtml = tags ? '<div class="mkt-detail-tags">'+tags+'</div>' : '';
  var descText = c.desc || c.type || '';
  // Reviews
  var reviewsHtml = '';
  if (c.topComment) {
    var revItems = '<div class="mkt-review-item"><div class="mkt-review-av">'+c.topComment.who.split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2)+'</div><div><div class="mkt-review-who">'+c.topComment.who+' <span class="mkt-review-verified">&#10003; verified</span></div><div class="mkt-review-text">'+c.topComment.text+'</div></div></div>';
    if (c.moreReviews) {
      revItems += c.moreReviews.map(function(r){
        return '<div class="mkt-review-item"><div class="mkt-review-av">'+r.av+'</div><div><div class="mkt-review-who">'+r.who+' <span class="mkt-review-verified">&#10003; verified</span></div><div class="mkt-review-text">'+r.text+'</div></div></div>';
      }).join('');
    }
    reviewsHtml = '<div class="mkt-detail-section"><div class="mkt-detail-section-h">Reviews</div>'+revItems+'</div>';
  }
  // Related
  var relatedHtml = c.related ? '<div class="mkt-detail-section" style="font-size:12.5px;color:var(--market)">&#8599; Related: <a href="'+c.related.url+'" target="_blank" rel="noopener" style="color:var(--market);font-weight:700;text-decoration:underline">'+c.related.label+'</a></div>' : '';

  return '<div class="mkt-detail-hero">'
    + '<div class="mkt-hero-top">'
      + '<div class="'+avClass+'">'+avContent+'</div>'
      + '<div class="mkt-hero-main">'
        + '<div class="mkt-hero-name">'+c.name+'</div>'
        + '<div class="mkt-hero-badges"><span class="lbdg '+bdgClass+'">'+bdgLabel+'</span>'+cleared+'</div>'
        + (ratingHtml ? '<div class="mkt-hero-rating">'+ratingHtml+'</div>' : '')
        + (metaParts.length ? '<div class="mkt-hero-meta"><span>'+metaParts.join('</span><span>')+'</span></div>' : '')
      + '</div>'
    + '</div>'
    + sp + urlHtml
    + '</div>'
    + (descText ? '<div class="mkt-detail-desc">'+descText+'</div>' : '')
    + tagsHtml
    + '<div class="mkt-detail-actions">'
      + '<button class="mkt-da-btn mkt-da-primary">Schedule</button>'
      + '<button class="mkt-da-btn mkt-da-sec">Message</button>'
    + '</div>'
    + reviewsHtml
    + relatedHtml
    + '<div class="mkt-detail-section" id="mkt-convo-section">'
