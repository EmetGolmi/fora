// ── Forum panel click handlers ────────────────────────────────────────────────
var _lastFrmContext = null;
var _frmJurFilter = 'all';

function frmOfficialsClick(h) {
  var subs = document.getElementById('frm-officials-subs');
  var isOpen = subs.classList.contains('open');
  subs.classList.toggle('open');
  h.classList.toggle('on');
  h.classList.toggle('open');
  if (!isOpen) {
    document.querySelectorAll('.frm-gov-sub').forEach(function(x){ x.classList.remove('on'); });
    document.querySelectorAll('#panel-officials .post.f').forEach(function(c){ c.style.display = ''; });
    switchPanel('officials', null);
  }
}

function filterOfficials(level, el) {
  document.querySelectorAll('.frm-gov-sub').forEach(function(x){ x.classList.remove('on'); });
  if (el) el.classList.add('on');
  document.querySelectorAll('#panel-officials .post.f').forEach(function(c){
    c.style.display = (c.dataset.govLevel === level) ? '' : 'none';
  });
}

function frmLegislationClick(h) {
  var legDoms = document.getElementById('frm-leg-domains');
  var isOpen = legDoms.classList.contains('open');
  legDoms.classList.toggle('open');
  h.classList.toggle('on');
  h.classList.toggle('open');
  if (!isOpen) {
    _lastFrmContext = { type: 'all' };
    switchPanel('forum-domain', null);
    renderFrmAll();
  }
}

function renderFrmAll() {
  document.getElementById('frm-panel-title').textContent = '\u25b3 Law \u00b7 All Legislation';
  document.getElementById('frm-panel-crumb').textContent = 'All categories';
  var seen = {}, allCards = [];
  Object.keys(FRM_DOMS).forEach(function(dk) {
    Object.keys(FRM_DOMS[dk].subs).forEach(function(sk) {
      FRM_DOMS[dk].subs[sk].cards.forEach(function(c) {
        if (!seen[c.name]) { seen[c.name] = true; allCards.push(c); }
      });
    });
  });
  if (_frmJurFilter !== 'all') allCards = allCards.filter(function(c){ return billJur(c) === _frmJurFilter; });
  var jurLabel = {federal:'Federal',pennsylvania:'State',philadelphia:'Local'}[_frmJurFilter] || '';
  var el = document.getElementById('frm-main');
  el.innerHTML = allCards.length
    ? allCards.map(frmBillHtml).join('')
    : '<div class="frm-empty-state">No ' + (jurLabel ? jurLabel + ' ' : '') + 'legislation available.</div>';
}

function billJur(c) {
  if (c.jurisdiction) return c.jurisdiction;
  var t = (c.type || '').toLowerCase();
  if (t.indexOf('philadelphia') !== -1) return 'philadelphia';
  if (t.indexOf('pennsylvania') !== -1 || t.indexOf(' pa ·') !== -1) return 'pennsylvania';
  return 'federal';
}

function setFrmJur(jur, el) {
  _frmJurFilter = jur;
  document.querySelectorAll('.frm-jchip').forEach(function(x){ x.classList.remove('on'); });
  if (el) el.classList.add('on');
  if (_lastFrmContext) {
    if (_lastFrmContext.type === 'all') renderFrmAll();
    else if (_lastFrmContext.type === 'domain') renderFrmDomain(_lastFrmContext.slug);
    else renderFrmCards(_lastFrmContext.slug);
  }
}

function frmDomClick(h, slug) {
  var sl = h.nextElementSibling;
  var isOpen = sl.classList.contains('open');
  var nav = h.parentElement;
  nav.querySelectorAll('.frm-dom-h').forEach(function(x){ x.classList.remove('on','open'); });
  nav.querySelectorAll('.frm-sub-list').forEach(function(x){ x.classList.remove('open'); });
  if (!isOpen) {
    sl.classList.add('open');
    h.classList.add('on','open');
    _lastFrmContext = { type: 'domain', slug: slug };
    switchPanel('forum-domain', null);
    renderFrmDomain(slug);
  }
}

function frmSubClick(slug, el) {
  document.querySelectorAll('.frm-sub').forEach(function(x){ x.classList.remove('on'); });
  el.classList.add('on');
  _lastFrmContext = { type: 'sub', slug: slug };
  switchPanel('forum-domain', null);
  renderFrmCards(slug);
}

function renderFrmDomain(domSlug) {
  var dom = FRM_DOMS[domSlug];
  if (!dom) return;
  document.getElementById('frm-panel-title').textContent = '\u25b3 Law \u00b7 ' + dom.name;
  document.getElementById('frm-panel-crumb').textContent = 'All subcategories';
  var seen = {}, allCards = [];
  Object.keys(dom.subs).forEach(function(k) {
    dom.subs[k].cards.forEach(function(c) {
      if (!seen[c.name]) { seen[c.name] = true; allCards.push(c); }
    });
  });
  if (_frmJurFilter !== 'all') allCards = allCards.filter(function(c){ return billJur(c) === _frmJurFilter; });
  var jurLabel = {federal:'Federal',pennsylvania:'State',philadelphia:'Local'}[_frmJurFilter] || '';
  var el = document.getElementById('frm-main');
  el.innerHTML = allCards.length
    ? allCards.map(frmBillHtml).join('')
    : '<div class="frm-empty-state">No ' + (jurLabel ? jurLabel + ' ' : '') + 'legislation data for this domain yet.</div>';
}

function renderFrmCards(subSlug) {
  var domSlug, subData;
  Object.keys(FRM_DOMS).forEach(function(dk) {
    if (FRM_DOMS[dk].subs[subSlug]) { domSlug = dk; subData = FRM_DOMS[dk].subs[subSlug]; }
  });
  if (!subData) return;
  document.getElementById('frm-panel-title').textContent = '\u25b3 Law \u00b7 ' + FRM_DOMS[domSlug].name;
  document.getElementById('frm-panel-crumb').textContent = subData.label;
  var cards = subData.cards;
  if (_frmJurFilter !== 'all') cards = cards.filter(function(c){ return billJur(c) === _frmJurFilter; });
  var jurLabel = {federal:'Federal',pennsylvania:'State',philadelphia:'Local'}[_frmJurFilter] || '';
  var el = document.getElementById('frm-main');
  el.innerHTML = cards.length
    ? cards.map(frmBillHtml).join('')
    : '<div class="frm-empty-state">No ' + (jurLabel ? jurLabel + ' ' : '') + 'legislation data for this subcategory yet.</div>';
}

var _frmSeq = 0;
var _frmBillRegistry = {};
var _currentFrmBill  = null;

var FRM_PERSP_META = {
  support:        { label:'Support',          cls:'frm-pi-support',        dot:'#2a9d5c'  },
  oppose:         { label:'Oppose',           cls:'frm-pi-oppose',         dot:'#8b1a1a'  },
  side_effect:    { label:'Side Effect',      cls:'frm-pi-side_effect',    dot:'#c47f00'  },
  unforeseen:     { label:'Unforeseen',       cls:'frm-pi-unforeseen',     dot:'#8b5cf6'  },
  error_omission: { label:'Error & Omission', cls:'frm-pi-error_omission', dot:'#e76f51'  },
  general:        { label:'General',          cls:'frm-pi-general',        dot:'#8a9ab8'  }
};

function escJs(s) {
  return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/"/g,'&quot;');
}

function frmTrackerHtml(c) {
  var jur = billJur(c);
  var exec = jur === 'pennsylvania' ? 'Governor' : (jur === 'philadelphia' ? 'Mayor' : 'Executive');
  var stages = ['Introduced', 'Committee', 'Floor Vote', exec, 'Enacted'];
  var s = c.status || '';
  var lbl = (c.statusLabel || '').toLowerCase();
  var active, isEnacted = false, isVetoed = false;
  if (s === 'signed' || lbl.indexOf('enacted') !== -1 || lbl.indexOf('in effect') !== -1 || lbl.indexOf('signed') !== -1) {
    active = 4; isEnacted = true;
  } else if (lbl.indexOf('vetoed') !== -1) {
    active = 3; isVetoed = true;
  } else if (s === 'passed') {
    active = lbl.indexOf('passed congress') !== -1 ? 3 : 2;
  } else {
    if (lbl.indexOf('introduced') !== -1 || lbl.indexOf('budget proposal') !== -1 || lbl.indexOf('policy analysis') !== -1 || lbl.indexOf('admin proposal') !== -1) active = 0;
    else active = 1;
  }
  var html = '<div class="frm-tracker">';
  for (var i = 0; i < stages.length; i++) {
    var cls = 'frm-ts';
    if (isEnacted && i === 4) cls += ' enacted';
    else if (isVetoed && i === active) cls += ' vetoed';
    else if (i < active) cls += ' done';
    else if (i === active) cls += ' active';
    html += '<div class="' + cls + '">' + stages[i] + '</div>';
  }
  html += '</div>';
  return html;
}

function frmBillHtml(c) {
  var bid = 'fbi' + (++_frmSeq);
  _frmBillRegistry[bid] = c;
  var shareUrl  = encodeURIComponent(c.url || 'https://fora.community');
  var shareText = encodeURIComponent((c.name || '') + (c.num ? ' \u2014 ' + c.num : ''));
  return '<div class="frm-bill" id="' + bid + '" onclick="openFrmBill(\'' + bid + '\')" style="cursor:pointer">' +
    '<div class="frm-bill-top">' +
      (c.num ? '<span class="frm-bill-num">' + c.num + '</span>' : '') +
      frmTrackerHtml(c) +
    '</div>' +
    '<div class="frm-bill-name">' + c.name + '</div>' +
    '<div class="frm-bill-type">' + c.type + '</div>' +
    '<div class="frm-bill-desc">' + c.desc + '</div>' +
    '<div class="frm-bill-actions" onclick="event.stopPropagation()">' +
      '<div class="frm-share-wrap" style="margin-left:auto">' +
        '<button class="frm-action-btn" onclick="toggleFrmShare(\'' + bid + '\',event)"><i class="ti ti-share"></i> Share</button>' +
        '<div class="frm-share-menu" id="sm-' + bid + '" style="display:none">' +
          '<a class="frm-share-item" href="https://twitter.com/intent/tweet?text=' + shareText + '&url=' + shareUrl + '" target="_blank" rel="noopener"><i class="ti ti-brand-x"></i> X / Twitter</a>' +
          '<a class="frm-share-item" href="https://www.facebook.com/sharer/sharer.php?u=' + shareUrl + '" target="_blank" rel="noopener"><i class="ti ti-brand-facebook"></i> Facebook</a>' +
          '<a class="frm-share-item" href="https://www.linkedin.com/sharing/share-offsite/?url=' + shareUrl + '" target="_blank" rel="noopener"><i class="ti ti-brand-linkedin"></i> LinkedIn</a>' +
          '<button class="frm-share-item" onclick="frmCopyLink(\'' + escJs(c.url || '') + '\',this,\'' + bid + '\')"><i class="ti ti-copy"></i> Copy Link</button>' +
        '</div>' +
      '</div>' +
    '</div>' +
    '<div class="frm-expand-cue"><i class="ti ti-messages"></i> Expand for Conversation</div>' +
    '</div>';
}

// ── Bill detail panel ─────────────────────────────────────────────────────────
function openFrmBill(bid) {
  var c = _frmBillRegistry[bid];
  if (!c) return;
  _currentFrmBill = { bid: bid, billNum: c.num || '' };
  // Reset form
  document.getElementById('frm-persp-body').value = '';
  document.getElementById('frm-social-url').value = '';
  document.querySelectorAll('.frm-pchip').forEach(function(x){ x.classList.remove('on'); });
  var def = document.querySelector('.frm-pchip[data-p="general"]');
  if (def) def.classList.add('on');
  document.getElementById('frm-persp-err').style.display = 'none';
  // Render header & meta
  var sc = (c.status === 'signed' || c.status === 'passed') ? c.status : 'pending';
  document.getElementById('frm-bill-title').textContent = c.num || c.name;
  document.getElementById('frm-bill-meta').innerHTML =
    (c.num ? '<span class="frm-bill-num">' + c.num + '</span>' : '') +
    '<span class="frm-bill-status ' + sc + '">' + c.statusLabel + '</span>' +
    '<span style="font-size:12px;color:var(--ink-soft);">' + c.type + '</span>' +
    (c.url ? '<a href="' + c.url + '" target="_blank" rel="noopener" style="margin-left:auto;font-family:\'JetBrains Mono\',monospace;font-size:10.5px;color:var(--forum);">Congress.gov \u2197</a>' : '');
  document.getElementById('frm-bill-desc').textContent = c.desc || '';
  // Reset metrics
  document.getElementById('frm-mbar').innerHTML = '';
  document.getElementById('frm-mlegend').innerHTML = '<span style="font-size:11px;color:var(--ink-mut);">Loading\u2026</span>';
  document.getElementById('frm-perspectives-list').innerHTML = '<div class="frm-no-persp">Loading\u2026</div>';
  switchPanel('forum-bill', null);
  loadFrmBillConversation(c.num || '');
}

function closeFrmBill() {
  switchPanel('forum-domain', null);
  if (_lastFrmContext) {
    if (_lastFrmContext.type === 'all') renderFrmAll();
    else if (_lastFrmContext.type === 'domain') renderFrmDomain(_lastFrmContext.slug);
    else renderFrmCards(_lastFrmContext.slug);
  }
}

function loadFrmBillConversation(billNum) {
  if (!billNum) return;
  fetch('/mvp/forum/comments/metrics?bill_num=' + encodeURIComponent(billNum), {
    headers: {'X-Requested-With':'XMLHttpRequest'}
  }).then(function(r){ return r.json(); }).then(renderFrmMetrics).catch(function(){
    document.getElementById('frm-mlegend').innerHTML = '<span style="font-size:11px;color:var(--ink-mut);">No perspectives yet</span>';
  });
  fetch('/mvp/forum/comments?bill_num=' + encodeURIComponent(billNum), {
    headers: {'X-Requested-With':'XMLHttpRequest'}
  }).then(function(r){ return r.json(); }).then(renderFrmPerspectives).catch(function() {
    document.getElementById('frm-perspectives-list').innerHTML = '<div class="frm-no-persp">Could not load perspectives.</div>';
  });
}

function renderFrmMetrics(counts) {
  var order = ['support','oppose','side_effect','unforeseen','error_omission','general'];
  var total = order.reduce(function(s,k){ return s + (counts[k]||0); }, 0);
  var bar = document.getElementById('frm-mbar');
  var leg = document.getElementById('frm-mlegend');
  if (!bar) return;
  if (!total) {
    bar.innerHTML = '';
    leg.innerHTML = '<span style="font-size:11px;color:var(--ink-mut);">No perspectives yet</span>';
    return;
  }
  bar.innerHTML = order.map(function(k) {
    var ct = counts[k] || 0;
    if (!ct) return '';
    var pct = (ct / total * 100).toFixed(1);
    return '<div class="frm-bar-seg frm-seg-' + k + '" style="width:' + pct + '%" title="' + FRM_PERSP_META[k].label + ': ' + ct + '"></div>';
  }).join('');
  leg.innerHTML = order.filter(function(k){ return counts[k] > 0; }).map(function(k) {
    var m = FRM_PERSP_META[k];
    return '<div class="frm-leg-item"><div class="frm-leg-dot" style="background:' + m.dot + '"></div>' + m.label + '&nbsp;<span class="frm-leg-ct">' + counts[k] + '</span></div>';
  }).join('');
}

function renderFrmPerspectives(data) {
  var list = document.getElementById('frm-perspectives-list');
  if (!data.length) {
    list.innerHTML = '<div class="frm-no-persp">No perspectives yet \u2014 be the first to share yours.</div>';
    return;
  }
  list.innerHTML = data.map(function(p) {
    var m = FRM_PERSP_META[p.perspective_type] || FRM_PERSP_META.general;
    var embed = p.social_url ? embedFrmMedia(p.social_url) : '';
    return '<div class="frm-persp-item">' +
      '<div class="frm-pi-top">' +
        '<span class="frm-pi-badge ' + m.cls + '">' + m.label + '</span>' +
        '<span class="frm-pi-handle">@' + p.handle + '</span>' +
        '<span class="frm-pi-date">' + p.created_at + '</span>' +
      '</div>' +
      '<div class="frm-pi-body">' + p.body.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>' +
      embed +
      '</div>';
  }).join('');
}

function embedFrmMedia(url) {
  var yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  if (yt) {
    return '<div class="frm-pi-embed"><iframe width="100%" height="200" src="https://www.youtube.com/embed/' + yt[1] + '" frameborder="0" allowfullscreen></iframe></div>';
  }
  if (/\.(jpg|jpeg|png|gif|webp)(\?|$)/i.test(url)) {
    return '<div class="frm-pi-embed"><img src="' + url.replace(/"/g,'&quot;') + '" alt="Shared image" loading="lazy"></div>';
  }
  return '<a class="frm-pi-link" href="' + url.replace(/"/g,'&quot;') + '" target="_blank" rel="noopener"><i class="ti ti-link"></i> View linked post</a>';
}

function frmPerspClick(el) {
  document.querySelectorAll('.frm-pchip').forEach(function(c){ c.classList.remove('on'); });
  el.classList.add('on');
}

function submitFrmPerspective() {
  if (!_currentFrmBill) return;
  var body       = (document.getElementById('frm-persp-body') || {}).value.trim();
  var socialUrl  = (document.getElementById('frm-social-url') || {}).value.trim();
  var perspType  = ((document.querySelector('.frm-pchip.on') || {}).dataset || {}).p || 'general';
  var errDiv     = document.getElementById('frm-persp-err');
  if (!body || body.length < 3) {
    errDiv.textContent = 'Please write at least a few words.';
    errDiv.style.display = '';
    return;
  }
  errDiv.style.display = 'none';
  var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
  var btn  = document.querySelector('.frm-persp-submit');
  if (btn) btn.disabled = true;
  fetch('/mvp/forum/comments', {
    method:  'POST',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'X-Requested-With':'XMLHttpRequest'},
    body:    JSON.stringify({ bill_num: _currentFrmBill.billNum, body: body, perspective_type: perspType, social_url: socialUrl || null })
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (btn) btn.disabled = false;
    if (data.ok) {
      document.getElementById('frm-persp-body').value = '';
      document.getElementById('frm-social-url').value = '';
      document.querySelectorAll('.frm-pchip').forEach(function(x){ x.classList.remove('on'); });
      var def = document.querySelector('.frm-pchip[data-p="general"]');
      if (def) def.classList.add('on');
      loadFrmBillConversation(_currentFrmBill.billNum);
    } else {
      errDiv.textContent = (data.errors || ['Error posting']).join(', ');
      errDiv.style.display = '';
    }
  }).catch(function() {
    if (btn) btn.disabled = false;
    errDiv.textContent = 'Network error — please try again.';
    errDiv.style.display = '';
  });
}

