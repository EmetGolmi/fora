          {title:'Philadelphia Bill No. 230145 \u2014 food waste reporting for large generators', sub:'Requires grocery stores, food distributors, and large restaurants to report annual food waste diversion tonnage to the Streets Department. First reports due January 2025. Enforcement begins 2026.', tag:'City ordinance'},
          {title:'USDA ReConnect \u2014 food system resilience grants available to PA nonprofits', sub:'USDA ReConnect and Community Food Projects Competitive Grant Program fund food waste reduction infrastructure including cold storage, gleaning programs, and community kitchen composting. Applications at grants.gov.', tag:'Federal'}
