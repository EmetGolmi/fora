<div class="mbar">
  <div class="mtab home on">⌂</div>
  <div class="mtab fab"><span>+</span></div>
  <div class="mtab" data-g="t">◯</div>
  <div class="mtab" data-g="f">△</div>
  <div class="mtab" data-g="m">▢</div>
</div>

<script>
var SPARK_URL       = '<%= dashboard_spark_path %>';
var BUILD_URL       = '<%= dashboard_build_path %>';
var PROJECT_URL     = '<%= dashboard_project_add_path %>';
var PROJECTS        = <%= raw @project_list.map { |p| { id: p.id, title: p.title } }.to_json %>;

function csrf() {
  return document.querySelector('meta[name="csrf-token"]').content;
}

function post(url, body) {
  return fetch(url, {
    method:  'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
    body:    JSON.stringify(body)
  }).then(function(r){ return r.json(); });
}

// ── Tab switching ─────────────────────────────────────────────────────────────
document.querySelectorAll('.tab').forEach(function(t) {
  t.onclick = function() {
    document.querySelectorAll('.tab').forEach(function(x){ x.classList.remove('active'); });
    t.classList.add('active');
    document.querySelectorAll('.tabview').forEach(function(v){ v.classList.remove('active'); });
    document.getElementById('tv-' + t.dataset.tab).classList.add('active');
  };
});

// ── Pillar filter ─────────────────────────────────────────────────────────────
document.querySelectorAll('.pchip').forEach(function(c) {
  c.onclick = function() {
    document.querySelectorAll('.pchip').forEach(function(x){ x.classList.remove('on'); });
    c.classList.add('on');
    var p = c.dataset.p;
    document.querySelectorAll('.tabview.active .post').forEach(function(post) {
      post.style.display = (p === 'all' || post.classList.contains(p)) ? 'flex' : 'none';
    });
  };
});

// ── Spark toggle ──────────────────────────────────────────────────────────────
function toggleSpark(btn) {
  var type = btn.dataset.type;
  var id   = btn.dataset.id;
  post(SPARK_URL, { type: type, id: id }).then(function(data) {
    if (data.sparked) {
      btn.classList.add('on');
      btn.innerHTML = '<span class="ri">★</span> Tracking';
      // Unlock build and integrate in the same card
      var pb = btn.closest('.pb');
      pb.querySelectorAll('.rung.locked').forEach(function(r){
        r.classList.remove('locked');
      });
    } else {
      btn.classList.remove('on');
      btn.innerHTML = '<span class="ri">★</span> Track';
    }
    // Update any concur count displayed
    if (data.count !== undefined) {
      var sec = btn.closest('.pb').querySelector('.concur-ct');
      if (sec) sec.textContent = data.count + ' tracking';
    }
  }).catch(function(){ /* silent — button state stays */ });
}

// ── Official card expand (Jurisdictions tab) ──────────────────────────────────
function toggleRepPanel(btn) {
  btn.classList.toggle('open');
  btn.nextElementSibling.classList.toggle('open');
  btn.querySelector('.arr').style.transform = btn.classList.contains('open') ? 'rotate(180deg)' : '';
}

// ── Rep section collapse ──────────────────────────────────────────────────────
function toggleRepSection(hdr) {
  hdr.classList.toggle('collapsed');
  hdr.nextElementSibling.classList.toggle('collapsed');
}

// ── Rep Follow toggle (right rail) ────────────────────────────────────────────
function toggleRepFollow(btn, repId) {
  post(SPARK_URL, { type: 'CivicRepresentative', id: repId }).then(function(data) {
    if (data.sparked) {
      btn.classList.add('on');
    } else {
      btn.classList.remove('on');
    }
  }).catch(function(){});
}

// ── Build / Integrate trays ───────────────────────────────────────────────────
function openTray(btn, type) {
  if (btn.classList.contains('locked')) return;

  var pb       = btn.closest('.pb');
  var tray     = pb.querySelector('.tray.' + type);
  var isOpen   = tray.classList.contains('show');

  // Close all trays in this card first
  pb.querySelectorAll('.tray').forEach(function(x){ x.classList.remove('show'); });

  if (!isOpen) {
    if (type === 'build') {
      renderBuildTray(btn, tray);
    } else {
      renderIntegTray(btn, tray);
    }
    tray.classList.add('show');
    btn.classList.add('on');
    btn.innerHTML = type === 'build'
      ? '<span class="ri">⊕</span> Built'
      : '<span class="ri">↗</span> Integrated';
  }
}

function renderBuildTray(btn, tray) {
  var sourceType = tray.dataset.sourceType;
  var sourceId   = tray.dataset.sourceId;
  tray.innerHTML =
    '<div class="tray-h">Build on this — grow your understanding:</div>' +
    '<div class="tray-opts">' +
      '<span class="topt" onclick="showNoteForm(this, \'' + sourceType + '\', \'' + sourceId + '\')">+ Add your take</span>' +
      '<span class="topt stub" title="Coming soon">✦ Ask your guide</span>' +
    '</div>' +
    '<div class="note-area"></div>';
}

function showNoteForm(topt, sourceType, sourceId) {
  var area = topt.closest('.tray').querySelector('.note-area');
  if (area.querySelector('textarea')) return; // already open
  area.innerHTML =
    '<div class="note-form">' +
      '<textarea rows="2" placeholder="Your take on this…"></textarea>' +
      '<button onclick="submitNote(this, \'' + sourceType + '\', \'' + sourceId + '\')">Save</button>' +
    '</div>';
}

function submitNote(btn, sourceType, sourceId) {
  var ta   = btn.previousElementSibling;
  var note = ta.value.trim();
  if (!note) { ta.focus(); return; }
  btn.disabled = true;
  btn.textContent = '…';
  post(BUILD_URL, { source_type: sourceType, source_id: sourceId, note: note })
    .then(function(data) {
      if (data.ok) {
        btn.closest('.note-form').innerHTML = '<span style="color:var(--blue-md);font-size:12px;">✓ Note saved</span>';
      } else {
        btn.disabled = false; btn.textContent = 'Save';
      }
    }).catch(function(){ btn.disabled = false; btn.textContent = 'Save'; });
}

function renderIntegTray(btn, tray) {
  var sourceType = tray.dataset.sourceType;
  var sourceId   = tray.dataset.sourceId;
  var projOpts   = PROJECTS.map(function(p) {
    return '<span class="proj-chip" onclick="addToProject(' + p.id + ', \'' + sourceType + '\', \'' + sourceId + '\')">' + p.title + '</span>';
  }).join('');

  tray.innerHTML =
    '<div class="tray-h">Integrate — weave it into something on FORA:</div>' +
    '<div class="tray-opts">' +
      '<span class="topt" onclick="showProjectForm(this, \'' + sourceType + '\', \'' + sourceId + '\')">↗ Add to a project</span>' +
      (sourceType === 'NeighborhoodIssue'
        ? '<span class="topt stub" title="Concur coming soon">✓ Cast your voice (Concur)</span>'
        : '') +
      '<span class="topt stub" title="Coming soon">⇄ Share to Discourse</span>' +
    '</div>' +
    '<div class="project-area"></div>';
}

function showProjectForm(topt, sourceType, sourceId) {
  var area = topt.closest('.tray').querySelector('.project-area');
  if (area.querySelector('.project-sel')) return;

  var projHtml = PROJECTS.length
    ? '<div class="project-sel">' +
        PROJECTS.map(function(p){
          return '<span class="proj-chip" onclick="addToProject(' + p.id + ',\'' + sourceType + '\',\'' + sourceId + '\')">' + p.title + '</span>';
        }).join('') +
      '</div>'
    : '';

  area.innerHTML = projHtml +
    '<div class="proj-new-form">' +
      '<input type="text" placeholder="New project name…">' +
      '<button onclick="createAndAdd(this, \'' + sourceType + '\', \'' + sourceId + '\')">Create</button>' +
    '</div>';
}

function addToProject(projectId, sourceType, sourceId) {
  post(PROJECT_URL, { project_id: projectId, type: sourceType, id: sourceId })
    .then(function(data){
      if (data.ok) showFlash('Added to "' + data.project_title + '"');
    }).catch(function(){});
}

function createAndAdd(btn, sourceType, sourceId) {
  var input = btn.previousElementSibling;
  var title = input.value.trim();
  if (!title) { input.focus(); return; }
  btn.disabled = true;
  post(PROJECT_URL, { title: title, type: sourceType, id: sourceId })
    .then(function(data){
      if (data.ok) {
        PROJECTS.push({ id: data.project_id, title: data.project_title });
        showFlash('Project "' + data.project_title + '" created');
        btn.closest('.proj-new-form').innerHTML =
          '<span style="color:var(--green);font-size:12px;">✓ ' + data.project_title + '</span>';
      } else {
        btn.disabled = false;
      }
    }).catch(function(){ btn.disabled = false; });
}

function showFlash(msg) {
  var el = document.createElement('div');
  el.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:8px 18px;border-radius:999px;font-family:"JetBrains Mono",monospace;font-size:11px;z-index:999;opacity:1;transition:opacity .4s';
  el.textContent = msg;
  document.body.appendChild(el);
  setTimeout(function(){ el.style.opacity = '0'; setTimeout(function(){ el.remove(); }, 400); }, 2200);
}

// ── Expand bill card in place ─────────────────────────────────────────────────
function toggleExpand(cue) {
  var pb    = cue.closest('.pb');
  var exp   = pb.querySelector('.exp');
  var icard = pb.querySelector('.icard');
  if (!exp) return;
  var isOpen = exp.classList.toggle('open');
  if (icard) icard.style.display = isOpen ? 'none' : '';
  cue.innerHTML = isOpen
    ? '&#9652; Collapse'
    : '&#9662; Open &middot; read it, weigh it, take your stand';
  if (isOpen) {
    var top = pb.closest('.post').getBoundingClientRect().top + window.scrollY - 20;
    window.scrollTo({ top: top, behavior: 'smooth' });
    // Lazy-load summary if missing
    var lazy = exp.querySelector('.bexp-summary-lazy');
    if (lazy && !lazy.dataset.loaded) {
      lazy.dataset.loaded = '1';
      var billId = lazy.dataset.billId;
      fetch('/mvp/bills/' + billId + '/summary')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.summary) {
            lazy.innerHTML = data.summary;
            lazy.style.fontStyle = 'normal';
            lazy.style.color = 'var(--ink)';
            lazy.style.fontSize = '14.5px';
            lazy.style.lineHeight = '1.65';
            // Inject effects if present and no effects block exists
            if (data.effects && data.effects.length && !exp.querySelector('.bexp-affect')) {
              var effDiv = document.createElement('div');
              effDiv.className = 'bexp-block';
              effDiv.innerHTML = '<div class="bexp-block-h">How it may affect you</div>'
                + '<ul class="bexp-affect">'
                + data.effects.map(function(e){ return '<li>' + e + '</li>'; }).join('')
                + '</ul>';
              lazy.closest('.bexp-block').insertAdjacentElement('afterend', effDiv);
            }
          } else {
            lazy.textContent = 'Summary not yet available.';
          }
        })
        .catch(function() { lazy.textContent = 'Could not load summary.'; });
    }
  }
}

// ── Jurisdiction bills infinite scroll ───────────────────────────────────────
(function() {
  var sentinel = document.getElementById('juris-bills-sentinel');
  if (!sentinel) return;

  var loading  = false;
  var hasMore  = true;
  var csrfToken = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';

  var STAGE_SEGS = {
    introduced: ['done','now','','',''],
    committee:  ['done','done','now','',''],
    passed_chamber: ['done','done','done','now',''],
    resolving_differences: ['done','done','done','done','now'],
    to_president: ['done','done','done','done','now'],
    became_law:   ['done','done','done','done','done'],
    vetoed:       ['done','done','done','done','done'],
    failed:       ['done','now','','',''],
    withdrawn:    ['done','now','','','']
  };
  var STAGE_LABEL = {
    introduced:  'Introduced', committee: 'In Committee',
    passed_chamber: 'Passed Chamber', resolving_differences: 'Resolving Differences',
    to_president: 'To President', became_law: 'Became Law',
    vetoed: 'Vetoed', failed: 'Failed', withdrawn: 'Withdrawn'
  };
  var JUR_COLOR = { federal: '#B22234', pennsylvania: '#003087', philadelphia: '#004C54' };
  var JUR_LABEL = { federal: 'Federal', pennsylvania: 'State', philadelphia: 'Local' };

  function esc(s) {
    return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function renderSegs(stage) {
    var segs = STAGE_SEGS[stage] || ['done','now','','',''];
    return segs.map(function(cls) { return '<span class="sseg ' + cls + '"></span>'; }).join('');
  }

  function renderBillCard(b) {
    var color = JUR_COLOR[b.jurisdiction] || '#B22234';
    var jlbl  = JUR_LABEL[b.jurisdiction] || 'Federal';
    var slbl  = STAGE_LABEL[b.bill_stage]  || b.status || '';
    var date  = b.status_date ? ' · ' + esc(b.status_date) : '';
    var sparkOn = b.sparked ? ' on' : '';
    var sparkTxt = b.sparked ? 'Tracking' : 'Track';

    // — Expand panel content —
    var expHtml = '';

    // Summary block
    if (b.plain_summary) {
      expHtml += '<div class="bexp-block">'
               + '<div class="bexp-block-h">In plain language</div>'
               + '<div class="bexp-summary">' + esc(b.plain_summary) + '</div>'
               + '</div>';
    }

    // Effects block
    var effects = b.effects || [];
    if (effects.length) {
      expHtml += '<div class="bexp-block"><div class="bexp-block-h">How it may affect you</div>'
               + '<ul class="bexp-affect">'
               + effects.map(function(e){ return '<li>' + esc(e) + '</li>'; }).join('')
               + '</ul></div>';
    }

    // Sit with it (guide)
    if (b.guide_seeded && b.sit_for && b.sit_against) {
      expHtml += '<div class="exp-guide" id="guide-' + b.id + '">'
        + '<div class="exp-guide-head">'
        + '<div class="exp-guide-eyebrow"><span style="font-size:13px;">◯</span> Think it through with your guide</div>'
        + '<div class="exp-guide-h">Sit with it. Study it. Then take your stand.</div>'
        + '<div class="exp-guide-sub"><b>FORA never tells you what to think.</b> It makes sure you\'ve understood — both sides, then the facts — before you decide.</div>'
        + '</div>'
        + '<div class="eg-tabs">'
        + '<div class="eg-tab on" onclick="egTab(this,\'sit\',\'guide-' + b.id + '\')"><div class="eg-tab-n">Sit</div><div class="eg-tab-d">both sides</div></div>'
        + '<div class="eg-tab" onclick="egTab(this,\'study\',\'guide-' + b.id + '\')"><div class="eg-tab-n">Study</div><div class="eg-tab-d">the facts</div></div>'
        + '<div class="eg-tab" onclick="egTab(this,\'share\',\'guide-' + b.id + '\')"><div class="eg-tab-n">Share</div><div class="eg-tab-d">your stand</div></div>'
        + '</div>'
        // Sit pane
        + '<div class="eg-pane on" id="guide-' + b.id + '-sit">'
        + '<div class="eg-sides">'
        + '<div class="eg-side for"><div class="eg-side-h">The case for</div><p>' + esc(b.sit_for) + '</p></div>'
        + '<div class="eg-side against"><div class="eg-side-h">The case against</div><p>' + esc(b.sit_against) + '</p></div>'
        + '</div>'
        + '<div class="eg-minority"><b>⚖ Democracy with minority consent.</b> Even if most of your neighbors land one way, the other view holds something true. FORA asks you to understand it — not to agree with it.</div>'
        + '<div class="eg-ack"><div class="eg-ack-h">Before you take a stand:</div>'
        + '<textarea placeholder="In your own words — what\'s the strongest point on the side you disagree with?" oninput="egAckInput(this,\'guide-' + b.id + '\')"></textarea>'
        + '<div class="eg-ack-note">Private. This isn\'t a test — it\'s the difference between a reaction and a position.</div>'
        + '</div></div>'
        // Study pane
        + '<div class="eg-pane" id="guide-' + b.id + '-study">'
        + (b.study_facts && b.study_facts.length
            ? '<ul class="eg-facts">' + b.study_facts.map(function(f){
                return '<li><span>' + esc(f.text) + '</span><span class="eg-fact-src">' + esc(f.source_label) + '</span></li>';
              }).join('') + '</ul>'
            : '')
        + (b.full_text_url ? '<a href="' + esc(b.full_text_url) + '" target="_blank" rel="noopener" class="eg-study-doc">📄 Read the official bill text →</a>' : '')
        + '</div>'
        // Share pane
        + '<div class="eg-pane" id="guide-' + b.id + '-share">'
        + '<div class="eg-gate" id="guide-' + b.id + '-gate">Reflect on the strongest opposing argument — Share lightens once you have.</div>'
        + '<div class="eg-share-acts dimmed" id="guide-' + b.id + '-acts">'
        + '<a href="/mvp/bills/' + b.id + '#civic-voice" class="eg-sact"><div class="eg-sact-ico" style="background:#f8f0dc;">✓</div><div><div class="eg-sact-t">Share your voice</div><div class="eg-sact-d">Your take on the bill, visible to your community.</div></div></a>'
        + '<a href="/mvp/bills/' + b.id + '#civic-voice" class="eg-sact"><div class="eg-sact-ico" style="background:#e5f0e8;">💬</div><div><div class="eg-sact-t">See neighbor takes</div><div class="eg-sact-d">What others in your jurisdiction are saying.</div></div></a>'
        + '</div></div>'
        + '</div>';
    }

    // Full bill page link
    expHtml += '<div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--rule);">'
             + '<a href="/mvp/bills/' + b.id + '" style="font-family:\'JetBrains Mono\',monospace;font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);text-decoration:none;">'
             + '→ Full bill page</a></div>';

    return '<div class="post f">'
      + '<div class="av av-doc">§</div>'
      + '<div class="pb">'
      + '<div class="pm">'
      + '<span class="pn2">' + esc(b.identifier || 'Bill') + '</span>'
      + '<span class="pr">· ' + esc(slbl) + date + '</span>'
      + '<span class="pbadge bb-f">△ Forum</span>'
      + '</div>'
      + '<div class="fctx">' + (b.sparked ? 'On your docket' : 'Your jurisdiction · not yet on your docket') + '</div>'
      + '<div class="icard">'
      + '<div class="ic-top"><span class="ic-k k-bill">Bill · ' + jlbl + '</span></div>'
      + '<div class="ic-t">' + esc((b.title || '').substring(0, 120)) + '</div>'
      + '<div class="ic-stage"><div class="sbar">' + renderSegs(b.bill_stage) + '</div><span>' + esc(slbl) + '</span></div>'
      + '</div>'
      + '<div class="expand-cue" onclick="toggleExpand(this)">▾ Open · read it, weigh it, take your stand</div>'
      + '<div class="exp">' + expHtml + '</div>'
      + '<div class="arc">'
      + '<button class="rung spark' + sparkOn + '" data-type="CivicBill" data-id="' + b.id + '" onclick="toggleSpark(this)">'
      + '<span class="ri">★</span> ' + sparkTxt
      + '</button>'
      + '<button class="rung build locked"><span class="ri">⊕</span> Build</button>'
      + '<button class="rung integ locked"><span class="ri">↗</span> Integrate</button>'
      + '<div class="arc-sec"><span class="concur-ct">' + b.follow_count + ' tracking</span> <span>💬 Discuss</span></div>'
      + '</div>'
      + '</div></div>';
  }

  function loadMore() {
    if (loading || !hasMore) return;
    loading = true;
    var offset = parseInt(sentinel.dataset.offset || '0', 10);
    fetch('/mvp/dashboard/jurisdiction_bills?offset=' + offset, {
      headers: { 'X-CSRF-Token': csrfToken }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      hasMore = data.has_more;
      sentinel.dataset.offset = data.offset;
      var frag = document.createElement('div');
      frag.innerHTML = data.bills.map(renderBillCard).join('');
      while (frag.firstChild) {
        sentinel.parentNode.insertBefore(frag.firstChild, sentinel);
      }
      loading = false;
      if (!hasMore) observer.unobserve(sentinel);
    })
    .catch(function() { loading = false; });
  }

  var observer = new IntersectionObserver(function(entries) {
    if (entries[0].isIntersecting) loadMore();
  }, { rootMargin: '200px' });

  observer.observe(sentinel);
}());

// ── Left nav panel switching ──────────────────────────────────────────────────
function switchPanel(key, el) {
  document.querySelectorAll('.col-left .tool').forEach(function(t) {
    t.classList.remove('active');
  });
  if (el) el.classList.add('active');

  var panels = document.querySelectorAll('.col-center [id^="panel-"]');
  panels.forEach(function(p) {
    p.style.display = (p.id === 'panel-' + key) ? '' : 'none';
  });

  if (key === 'pathsprograms') renderPathsPrograms();
  if (key === 'religion') renderReligion();
}

