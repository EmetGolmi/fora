function renderReligion() {
  var el = document.getElementById('rel-main');
  if (el.children.length > 0) return;
  el.innerHTML = RELIGION_CARDS.map(function(c, i) { return mktCardHtml(c, 'rel' + i); }).join('');
}

function renderPathsPrograms() {
  var el = document.getElementById('pp-main');
  if (el.children.length > 0) return; // already rendered
  var cards = [];
  MKT_DOMS.forEach(function(d) {
    d.subs.forEach(function(s) {
      s.cards.forEach(function(c) {
        if (c.kind === 'prog' || c.bdgClass === 'lbdg-community' || c.bdgClass === 'lbdg-prog') {
          cards.push(c);
        }
      });
    });
  });
  // deduplicate by name
  var seen = {};
  cards = cards.filter(function(c) {
    if (seen[c.name]) return false;
    seen[c.name] = true;
    return true;
  });
  el.innerHTML = cards.map(function(c, i) { return mktCardHtml(c, 'pp' + i); }).join('');
}

// ── Mobile bottom bar ─────────────────────────────────────────────────────────
document.querySelectorAll('.mtab').forEach(function(m) {
  m.onclick = function() {
    document.querySelectorAll('.mtab').forEach(function(x){ x.classList.remove('on'); });
    m.classList.add('on');
  };
});

// ── Official profile panel ────────────────────────────────────────────────
function openOfficialProfile(path, name) {
  var iframe = document.getElementById('official-iframe');
  iframe.style.height = 'calc(100vh - 100px)';
  iframe.src = path;
  document.getElementById('official-panel-name').textContent = name;
  switchPanel('official', null);
  iframe.onload = function() {
    try {
      var h = iframe.contentWindow.document.body.scrollHeight;
      if (h > 200) iframe.style.height = (h + 40) + 'px';
    } catch(e) {}
  };
}

