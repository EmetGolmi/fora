var _currentMktListing = null;
var _lastMktContext = null;

function openMktListing(lid) {
  var c = _mktRegistry[lid];
  if (!c) return;
  _currentMktListing = { lid: lid, key: 'mkt:' + c.name };
  document.getElementById('mkt-listing-title').textContent = c.name;
  document.getElementById('mkt-listing-body').innerHTML = buildMktDetailHtml(c);
  switchPanel('market-listing', null);
  zoomMktPin(lid);
  loadMktConversation('mkt:' + c.name);
}

function closeMktListing() {
  switchPanel('market', null);
  resetMktMapExtent();
  if (_lastMktContext) {
    if (_lastMktContext.type === 'sub') renderMktCards(_lastMktContext.d.label, _lastMktContext.s.label, _lastMktContext.s.cards);
    else renderMktDomain(_lastMktContext.d);
  }
}

function buildMktDetailHtml(c) {
  // Determine avatar styles
  var avClass, avContent;
