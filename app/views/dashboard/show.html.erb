function renderReligion() {
  var el = document.getElementById('rel-main');
  if (el.children.length > 0) return;
  el.innerHTML = RELIGION_CARDS.map(function(c, i) { return mktCardHtml(c, 'rel' + i); }).join('');
}

function renderPathsPrograms() {
  var el = document.getElementById('pp-main');
  if (el.children.length > 0) return; // already rendered
  var cards = [];
  MKT_DOMS.forEach(function(d) {
    d.subs.forEach(function(s) {
      s.cards.forEach(function(c) {
        if (c.kind === 'prog' || c.bdgClass === 'lbdg-community' || c.bdgClass === 'lbdg-prog') {
          cards.push(c);
        }
      });
    });
  });
  // deduplicate by name
  var seen = {};
  cards = cards.filter(function(c) {
    if (seen[c.name]) return false;
    seen[c.name] = true;
    return true;
  });
  el.innerHTML = cards.map(function(c, i) { return mktCardHtml(c, 'pp' + i); }).join('');
}

