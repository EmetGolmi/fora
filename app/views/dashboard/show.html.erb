function tplSubClick(slug, el) {
  document.querySelectorAll('.tpl-sub').forEach(function(x){ x.classList.remove('on'); });
  if (el) el.classList.add('on');
  var content = TPL_SUB_CONTENT[slug];
  var crumb = document.getElementById('tpl-crumb');
  var main  = document.getElementById('tpl-sub-main');
  if (!main) return;
  if (crumb) crumb.textContent = content ? (content.domain + ' · ' + content.title) : slug;
  if (content) {
    main.innerHTML = '<div class="tpl-cards">' + content.cards.map(function(c, i){ return tplCardHtml(c, 'tpl'+i); }).join('') + '</div>';
  } else {
    main.innerHTML = '<div class="tpl-empty">Content for this guide is in preparation.</div>';
  }
  switchPanel('temple-sub', null);
}

// ── Service area panel ────────────────────────────────────────────────────────
var _svcMap    = null;
var _svcCircle = null;
var _svcRadiusMi = <%= @profile.service_radius_mi || 3.0 %>;

function openSvcPanel() {
  switchPanel('service-area', null);
  setTimeout(function(){ initSvcMap(); }, 0);
}

function initSvcMap() {
  var el = document.getElementById('svc-map');
  if (!el) return;
  if (_svcMap) { _svcMap.invalidateSize(); return; }
  var center = _svcCenter();
  _svcMap = L.map('svc-map', {zoomControl:true, scrollWheelZoom:true}).setView(center, 12);
  _mktTileLayer(_svcMap);
  _svcCircle = L.circle(center, {
    radius: _svcRadiusMi * 1609.34,
    color: '#155c2d', fillColor: '#1f7a3e', fillOpacity: 0.18, weight: 2
  }).addTo(_svcMap);
  _svcMap.fitBounds(_svcCircle.getBounds(), {padding:[30,30]});
  var sl = document.getElementById('svc-slider');
  var rv = document.getElementById('svc-radius-val');
  if (sl) sl.value = _svcRadiusMi;
  if (rv) rv.textContent = _svcRadiusMi.toFixed(1);
}

function svcSliderMove(val) {
  _svcRadiusMi = parseFloat(val);
  var rv = document.getElementById('svc-radius-val');
  if (rv) rv.textContent = _svcRadiusMi.toFixed(1);
  if (_svcCircle) {
    _svcCircle.setRadius(_svcRadiusMi * 1609.34);
    if (_svcMap) _svcMap.fitBounds(_svcCircle.getBounds(), {padding:[30,30]});
  }
}

function saveSvcArea() {
  var btn   = document.querySelector('.svc-save-btn');
  var saved = document.getElementById('svc-saved');
  if (btn) btn.disabled = true;
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/mvp/dashboard/service_area', {
    method:  'PATCH',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf},
    body:    JSON.stringify({radius_mi: _svcRadiusMi})
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (btn) btn.disabled = false;
    if (data.ok) {
      _userSvcRadiusMi = _svcRadiusMi;
      if (saved) { saved.style.display=''; setTimeout(function(){ saved.style.display='none'; }, 2500); }
    }
  }).catch(function(){ if (btn) btn.disabled = false; });
}

// ── Share handlers ────────────────────────────────────────────────────────────
function toggleFrmShare(bid, e) {
  if (e) e.stopPropagation();
  var menu = document.getElementById('sm-' + bid);
  if (!menu) return;
  var willOpen = menu.style.display === 'none';
  document.querySelectorAll('.frm-share-menu').forEach(function(m){ m.style.display='none'; });
  if (willOpen) menu.style.display = '';
}

function frmCopyLink(url, btn, bid) {
  if (!url) return;
  navigator.clipboard.writeText(url).then(function() {
    btn.textContent = 'Copied!';
    setTimeout(function() {
      btn.innerHTML = '<i class="ti ti-copy"></i> Copy Link';
      var m = document.getElementById('sm-' + bid);
      if (m) m.style.display = 'none';
    }, 1500);
  });
}

document.addEventListener('click', function() {
  document.querySelectorAll('.frm-share-menu').forEach(function(m){ m.style.display='none'; });
});

// ── My Services embedded wizard (ms-prefix) ────────────────────────────────
var MS_OCCUPATIONS = <%= raw File.read(Rails.root.join('app/data/occupations.json')) %>;
var _msCurrentStep  = <%= @profile.card_builder_step.to_i.clamp(1, 6) %>;
var _msSelectedOcc   = null;
var _msOccFilter     = 'all';
var _msCurrentHandle = "<%= j @profile.provider_handle.to_s %>";
var _msLocode        = "<%= j @profile.locode.to_s %>";
var _msHandleAvail   = <%= @profile.provider_handle.present? ? 'true' : 'false' %>;
var _msPortType      = 'link';
var _msWizMap        = null;
var _msWizCircle     = null;
var _msDrawnLayer    = null;
var _msDrawControl   = null;
var _msDrawFG        = null;
var _msQrGenerated   = false;
var _msHandleTimer   = null;
var _msWizRadiusMi   = <%= @profile.service_radius_mi || 3.0 %>;

function msGoStep(n, init) {
  document.querySelectorAll('.ms-step').forEach(function(s){ s.classList.remove('active'); });
  var el = document.getElementById('ms-s' + n);
  if (el) el.classList.add('active');
  _msCurrentStep = n;
  msSbUpdate();
  if (n === 4 && !_msWizMap) setTimeout(msinitWizMap, 50);
  if (n === 6 && !_msQrGenerated) msInitQR();
  if (!init) {
    var panel = document.getElementById('panel-service-area');
    if (panel) panel.scrollTop = 0;
  }
}

function msSbUpdate() {
  document.querySelectorAll('.ms-sb-step').forEach(function(el) {
    var s = parseInt(el.dataset.s);
    el.classList.remove('active', 'done');
    if (s === _msCurrentStep) el.classList.add('active');
    else if (s < _msCurrentStep) el.classList.add('done');
  });
}

// ── Step 1 — Trade ───────────────────────────────────────────────────────────
function msOnBizNameInput(val) {
  var slug = msSlugify(val);
  var slugEl = document.getElementById('ms-handle-slug');
  var statEl = document.getElementById('ms-handle-status');
  if (slugEl) slugEl.textContent = slug || 'your-handle';
  if (statEl) { statEl.textContent = ''; statEl.className = 'ms-handle-status'; }
  _msHandleAvail = false;
  clearTimeout(_msHandleTimer);
  if (!slug) return;
  _msHandleTimer = setTimeout(function(){ msCheckHandle(slug); }, 400);
}

function msSlugify(str) {
  return str.toLowerCase().replace(/[^a-z0-9\s-]/g,'').trim().replace(/\s+/g,'-').replace(/-+/g,'-');
}

function msCheckHandle(handle) {
  fetch('/card-builder/check-handle?handle=' + encodeURIComponent(handle))
    .then(function(r){ return r.json(); })
    .then(function(data) {
      _msCurrentHandle = data.handle;
      _msHandleAvail = data.available;
      var el = document.getElementById('ms-handle-status');
      if (!el) return;
      el.textContent = data.available ? '✓ Available' : '✗ Taken';
      el.className = 'ms-handle-status ' + (data.available ? 'ms-handle-avail' : 'ms-handle-taken');
    });
}

// ── Occupation picker ─────────────────────────────────────────────────────────
function msFilterOcc(group, btn) {
  _msOccFilter = group;
  document.querySelectorAll('.ms-occ-pill').forEach(function(p){ p.classList.remove('on'); });
  if (btn) btn.classList.add('on');
  msRenderOccList();
}

function msSearchOcc(query) {
  msRenderOccList(query);
}

function msRenderOccList(query) {
  query = (query || document.getElementById('ms-occ-search').value || '').toLowerCase().trim();
  var list = MS_OCCUPATIONS.filter(function(o) {
    if (_msOccFilter !== 'all' && o.isco_major !== _msOccFilter) return false;
    if (query) {
      var haystack = (o.display_label + ' ' + o.tags.join(' ')).toLowerCase();
      return query.split(/\s+/).every(function(w){ return haystack.indexOf(w) !== -1; });
    }
    return true;
  });
  var el = document.getElementById('ms-occ-list');
  if (!el) return;
  if (list.length === 0) {
    el.innerHTML = '<div style="font-size:12px;color:var(--ink-mut);padding:8px 4px">No matches — try a different search.</div>';
    return;
  }
  el.innerHTML = list.map(function(o) {
    var sel = _msSelectedOcc && _msSelectedOcc.onet_code === o.onet_code && _msSelectedOcc.naics_code === o.naics_code;
    return '<div class="ms-occ-row' + (sel ? ' selected' : '') + '" onclick="msSelectOcc(' + JSON.stringify(o).replace(/'/g,"&#39;") + ')">' +
      '<span class="ms-occ-name">' + o.display_label + '</span>' +
      '<span class="ms-occ-codes">NAICS&nbsp;' + o.naics_code + '&nbsp;·&nbsp;O*NET&nbsp;' + o.onet_code + '</span>' +
      '<button class="ms-occ-sel-btn">' + (sel ? '✓' : 'Select') + '</button>' +
      '</div>';
  }).join('');
}

function msSelectOcc(occ) {
  _msSelectedOcc = occ;
  msRenderOccList();
  var bd = document.getElementById('ms-occ-breakdown');
  if (!bd) return;
  bd.classList.add('show');
  document.getElementById('ms-occ-bd-title').textContent = '✓ ' + occ.display_label.toUpperCase() + ' — YOUR PROFESSIONAL CLASSIFICATION';
  document.getElementById('ms-occ-bd-isco').textContent = occ.isco_code + ' · ' + occ.isco_label;
  document.getElementById('ms-occ-bd-naics').textContent = occ.naics_code + ' · ' + occ.naics_label;
  document.getElementById('ms-occ-bd-onet').textContent = occ.onet_code + ' · ' + occ.onet_label;
  document.getElementById('ms-occ-bd-naics-note').textContent = occ.naics_code;
}

function msSubmitTrade() {
  var bizName = document.getElementById('ms-biz-name').value.trim();
  if (!bizName) return msShowErr('ms-s1-err', 'Please enter your business name.');
  var btn = document.getElementById('ms-s1-btn');
  if (btn) btn.disabled = true;
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';

  var doSubmit = function() {
    if (!_msHandleAvail) {
      if (btn) btn.disabled = false;
      return msShowErr('ms-s1-err', 'That handle is taken — try a different name.');
    }
    var payload = { business_name: bizName };
    if (_msSelectedOcc) {
      payload.naics_code = _msSelectedOcc.naics_code;
      payload.onet_code  = _msSelectedOcc.onet_code;
      payload.isco_code  = _msSelectedOcc.isco_code;
    }
    fetch('/card-builder/trade', {
      method: 'PATCH',
      headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'Accept':'application/json'},
      body: JSON.stringify({ trade: payload })
    }).then(function(r){ return r.json(); }).then(function(data) {
      if (btn) btn.disabled = false;
      if (data.ok) {
        _msCurrentHandle = data.handle;
        if (data.locode) {
          _msLocode = data.locode;
          var pfx = document.getElementById('ms-handle-prefix');
          if (pfx) pfx.textContent = 'fora.center/' + _msLocode + '/';
        }
        msGoStep(2);
      } else {
        msShowErr('ms-s1-err', (data.errors || ['Error saving']).join(', '));
      }
    }).catch(function(){ if (btn) btn.disabled = false; });
  };

  var handle = msSlugify(bizName);
  if (!_msHandleAvail && handle) {
    fetch('/card-builder/check-handle?handle=' + encodeURIComponent(handle))
      .then(function(r){ return r.json(); })
      .then(function(data){ _msCurrentHandle = data.handle; _msHandleAvail = data.available; doSubmit(); })
      .catch(function(){ if (btn) btn.disabled = false; });
  } else {
    doSubmit();
  }
}

// ── Step 2 — Headline ─────────────────────────────────────────────────────────
function msOnHlInput(val) {
  var words = val.trim() ? val.trim().split(/\s+/).length : 0;
  var el = document.getElementById('ms-hl-count');
  if (el) {
    el.textContent = words + ' / 15';
    el.className = 'ms-word-count' + (words > 15 ? ' over' : words >= 12 ? ' warn' : '');
  }
}

function msSubmitHeadline() {
  var hl = document.getElementById('ms-hl-input').value.trim();
  var ss = document.getElementById('ms-ss-input').value.trim();
  if (hl.split(/\s+/).filter(Boolean).length > 15) return msShowErr('ms-s2-err', 'Headline must be 15 words or fewer.');
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/card-builder/headline', {
    method: 'PATCH',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'Accept':'application/json'},
    body: JSON.stringify({ headline: { provider_headline: hl, service_summary: ss } })
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (data.ok) msGoStep(3);
    else msShowErr('ms-s2-err', (data.errors || ['Error saving']).join(', '));
  });
}

// ── Step 3 — Portfolio ────────────────────────────────────────────────────────
function msSetPortType(type) {
  _msPortType = type;
  document.getElementById('ms-ptt-link').classList.toggle('on', type === 'link');
  document.getElementById('ms-ptt-note').classList.toggle('on', type === 'note');
  document.getElementById('ms-port-link-row').style.display = type === 'link' ? 'flex' : 'none';
  document.getElementById('ms-port-note-row').style.display = type === 'note' ? 'block' : 'none';
}

function msAddPortItem() {
  var title = document.getElementById('ms-port-title').value.trim();
  var url   = document.getElementById('ms-port-url').value.trim();
  var note  = document.getElementById('ms-port-note').value.trim();
  if (_msPortType === 'link' && !url) return msShowErr('ms-s3-err', 'Please enter a URL.');
  if (_msPortType === 'note' && !note) return msShowErr('ms-s3-err', 'Please write your note.');
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/card-builder/portfolio', {
    method: 'POST',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'Accept':'application/json'},
    body: JSON.stringify({ portfolio: { item_type: _msPortType, title: title, source_url: url, description: note } })
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (data.ok) {
      msAppendPortItem(data.item);
      document.getElementById('ms-port-title').value = '';
      document.getElementById('ms-port-url').value = '';
      document.getElementById('ms-port-note').value = '';
      msHideErr('ms-s3-err');
    } else msShowErr('ms-s3-err', (data.errors || ['Error adding item']).join(', '));
  });
}

function msAppendPortItem(item) {
  var list = document.getElementById('ms-port-list');
  if (!list) return;
  var div = document.createElement('div');
  div.className = 'ms-port-item';
  div.id = 'ms-pi-' + item.id;
  div.innerHTML =
    '<div style="flex:1;min-width:0">' +
      '<div class="ms-port-item-title">' + msEscHtml(item.title) + '</div>' +
      '<div class="ms-port-item-type">' + item.item_type +
        (item.source_url ? ' · <a href="' + msEscHtml(item.source_url) + '" target="_blank" style="color:var(--market)">open ↗</a>' : '') +
      '</div></div>' +
    '<button class="ms-port-vis-btn pub" id="ms-pv-' + item.id + '" onclick="msToggleVis(' + item.id + ')">Public</button>' +
    '<button class="ms-port-del-btn" onclick="msDelPort(' + item.id + ')">✕</button>';
  list.prepend(div);
}

function msToggleVis(id) {
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/card-builder/portfolio/' + id, {
    method: 'PATCH', headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'Accept':'application/json'}, body: '{}'
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (data.ok) {
      var btn = document.getElementById('ms-pv-' + id);
      if (!btn) return;
      var isPub = data.visibility === 'public';
      btn.textContent = isPub ? 'Public' : 'Private';
      btn.className = 'ms-port-vis-btn' + (isPub ? ' pub' : '');
    }
  });
}

function msDelPort(id) {
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/card-builder/portfolio/' + id, {
    method: 'DELETE', headers: {'X-CSRF-Token':csrf,'Accept':'application/json'}
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (data.ok) { var el = document.getElementById('ms-pi-' + id); if (el) el.remove(); }
  });
}

// ── Step 4 — Service Area (wizard) ────────────────────────────────────────────
function msinitWizMap() {
  var el = document.getElementById('ms-svc-map');
  if (!el || _msWizMap) return;
  var center = _svcCenter();
  _msWizMap = L.map('ms-svc-map', {zoomControl:true, scrollWheelZoom:true}).setView(center, 11);
  _mktTileLayer(_msWizMap);
  _msWizCircle = L.circle(center, {
    radius: _msWizRadiusMi * 1609.34,
    color: '#155c2d', fillColor: '#155c2d', fillOpacity: 0.12, weight: 2
  }).addTo(_msWizMap);
  _msWizMap.fitBounds(_msWizCircle.getBounds(), {padding:[20,20]});
}

function msSetAreaMode(mode) {
  _msAreaMode = mode;
  var btnR = document.getElementById('ms-at-radius');
  var btnZ = document.getElementById('ms-at-zone');
  if (btnR) btnR.classList.toggle('on', mode === 'radius');
  if (btnZ) btnZ.classList.toggle('on', mode === 'zone');
  var radUI = document.getElementById('ms-radius-ui');
  var zonUI = document.getElementById('ms-zone-ui');
  if (radUI) radUI.style.display = mode === 'radius' ? '' : 'none';
  if (zonUI) zonUI.style.display = mode === 'zone' ? '' : 'none';
  if (!_msWizMap) msinitWizMap();
  if (mode === 'zone') {
    if (_msWizCircle) { _msWizMap.removeLayer(_msWizCircle); _msWizCircle = null; }
    if (!_msDrawControl && typeof L.Control.Draw !== 'undefined') {
      _msDrawFG = new L.FeatureGroup().addTo(_msWizMap);
      _msDrawControl = new L.Control.Draw({
        draw: { polygon: { shapeOptions: {color:'#155c2d', fillOpacity:0.18} }, circle:false, rectangle:false, marker:false, circlemarker:false, polyline:false },
        edit: { featureGroup: _msDrawFG }
      });
      _msWizMap.addControl(_msDrawControl);
      _msWizMap.on(L.Draw.Event.CREATED, function(e) {
        if (_msDrawnLayer) _msDrawFG.removeLayer(_msDrawnLayer);
        _msDrawnLayer = e.layer;
        _msDrawFG.addLayer(_msDrawnLayer);
      });
    }
  } else {
    if (_msDrawnLayer && _msDrawFG) { _msDrawFG.removeLayer(_msDrawnLayer); _msDrawnLayer = null; }
    if (_msDrawControl) { _msWizMap.removeControl(_msDrawControl); _msDrawControl = null; _msDrawFG = null; }
    var center = _svcCenter();
    _msWizCircle = L.circle(center, {
      radius: _msWizRadiusMi * 1609.34,
      color: '#155c2d', fillColor: '#155c2d', fillOpacity: 0.12, weight: 2
    }).addTo(_msWizMap);
    _msWizMap.fitBounds(_msWizCircle.getBounds(), {padding:[20,20]});
  }
}

function msCbSliderMove(val) {
  _msWizRadiusMi = parseFloat(val);
  var rv = document.getElementById('ms-radius-val');
  if (rv) rv.textContent = _msWizRadiusMi.toFixed(1);
  if (_msWizCircle) {
    _msWizCircle.setRadius(_msWizRadiusMi * 1609.34);
    if (_msWizMap) _msWizMap.fitBounds(_msWizCircle.getBounds(), {padding:[20,20]});
  }
}

function msSubmitArea() {
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  var body;
  if (_msAreaMode === 'zone') {
    if (!_msDrawnLayer) return msShowErr('ms-s4-err', 'Please draw your service zone on the map first.');
    body = JSON.stringify({ polygon: JSON.stringify(_msDrawnLayer.toGeoJSON()) });
  } else {
    body = JSON.stringify({ radius_mi: _msWizRadiusMi });
  }
  fetch('/card-builder/area', {
    method: 'PATCH',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'Accept':'application/json'},
    body: body
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (data.ok) msGoStep(5);
    else msShowErr('ms-s4-err', (data.errors || ['Error saving']).join(', '));
  });
}

// ── Step 5 — Temple ───────────────────────────────────────────────────────────
function msSkipTemple() {
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/card-builder/temple', {
    method: 'PATCH',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'Accept':'application/json'},
    body: JSON.stringify({ skip: true })
  }).then(function(r){ return r.json(); }).then(function(data) { if (data.ok) msGoStep(6); });
}

function msSubmitTemple() {
  var title = document.getElementById('ms-tip-title').value.trim();
  var body  = document.getElementById('ms-tip-body').value.trim();
  if (!body) return msShowErr('ms-s5-err', 'Please write your tip or use "Skip."');
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/card-builder/temple', {
    method: 'PATCH',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf,'Accept':'application/json'},
    body: JSON.stringify({ temple: { title: title, description: body } })
  }).then(function(r){ return r.json(); }).then(function(data) {
    if (data.ok) msGoStep(6);
    else msShowErr('ms-s5-err', (data.errors || ['Error saving']).join(', '));
  });
}

// ── Step 6 — Complete ─────────────────────────────────────────────────────────
function msCardUrl(handle) {
  return _msLocode
    ? 'https://fora.center/' + _msLocode + '/' + handle
    : 'https://fora.center/p/' + handle;
}

function msInitQR() {
  fetch('/card-builder/complete').catch(function(){});
  var handle = _msCurrentHandle || "<%= j @profile.provider_handle.to_s %>";
  var url = msCardUrl(handle);
  var el = document.getElementById('ms-live-url');
  if (el) el.textContent = url.replace('https://', '');
  var viewLink = document.getElementById('ms-view-card-link');
  if (viewLink) viewLink.href = url.replace('https://fora.center', '');
  var wrap = document.getElementById('ms-qr-canvas');
  if (wrap && typeof QRCode !== 'undefined') {
    new QRCode(wrap.parentElement, {
      text: url, width: 130, height: 130,
      colorDark: '#1b3a6b', colorLight: '#ffffff',
      correctLevel: QRCode.CorrectLevel.M
    });
  }
  _msQrGenerated = true;
}

function msDownloadQR() {
  var canvas = document.querySelector('.ms-qr-wrap canvas');
  if (!canvas) return;
  var link = document.createElement('a');
  var handle = _msCurrentHandle || "<%= j @profile.provider_handle.to_s %>";
  link.download = 'fora-' + handle + '-qr.png';
  link.href = canvas.toDataURL('image/png');
  link.click();
}

// ── Editor mode helpers ───────────────────────────────────────────────────────
function msCopyCardLink(url, btn) {
  navigator.clipboard.writeText(url).then(function() {
    var orig = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function(){ btn.textContent = orig; }, 1800);
  });
}

function msAddService() {
  var csrf = (document.querySelector('meta[name="csrf-token"]')||{}).content||'';
  fetch('/card-builder/restart', {
    method: 'POST',
    headers: {'Content-Type':'application/json','X-CSRF-Token':csrf}
  }).then(function(){ window.location = '/mvp/dashboard?setup=services'; });
}

// ── MS helpers ────────────────────────────────────────────────────────────────
function msShowErr(id, msg) {
  var el = document.getElementById(id);
  if (!el) return;
  el.textContent = msg;
  el.classList.add('show');
}
function msHideErr(id) {
  var el = document.getElementById(id);
  if (el) el.classList.remove('show');
}
function msEscHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Auto-init ─────────────────────────────────────────────────────────────────
<% if @profile.provider_mode? && !@profile.card_builder_complete? %>
(function(){
  msGoStep(_msCurrentStep, true);
  // Pre-select occupation if profile already has naics_code from a previous session
  <% if @profile.naics_code.present? %>
  (function(){
    var existing = MS_OCCUPATIONS.find(function(o){
      return o.naics_code === "<%= j @profile.naics_code %>" &&
             (<%= @profile.onet_code.present? ? "o.onet_code === '#{j @profile.onet_code}'" : 'true' %>);
    });
    if (existing) msSelectOcc(existing);
  })();
  <% end %>
  msRenderOccList();
  var hl = document.getElementById('ms-hl-input');
  if (hl) msOnHlInput(hl.value);
})();
<% end %>

// Auto-open My Services panel when redirected from /card-builder
(function(){
  var params = new URLSearchParams(window.location.search);
  if (params.get('setup') === 'services') {
    openSvcPanel();
    var url = new URL(window.location.href);
    url.searchParams.delete('setup');
    window.history.replaceState({}, '', url.toString());
  }
})();
</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
</body>
</html>
