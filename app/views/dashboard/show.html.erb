          {title:'H.B. 1887 \u2014 Lead Plumbing Disclosure Act (PA, 2025)', sub:'Requires sellers and landlords to disclose known lead service lines or lead solder in plumbing before sale or lease. Signed into law November 2025. Phased enforcement begins January 2026.', tag:'Bill \u00b7 State'},
          {title:'Philadelphia Plumbing Code \u2014 backflow preventer requirements (2024 update)', sub:'L&I updated backflow preventer requirements for residential irrigation and commercial food service connections effective March 2024. Annual testing now required for all RPZ assemblies.', tag:'City ordinance'}
