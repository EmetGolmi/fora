<% content_for(:title) { "#{@address} — FORA Philadelphia" } %>

<% content_for :head do %>
  <%= stylesheet_link_tag "dashboard_home" %>
<% end %>

<%= render "dashboard/sections/page_shortcuts" %>

<div class="dh-main">

  <%= render "dashboard/sections/address_block" %>

  <%= render "dashboard/sections/on_this_day" %>

  <%= render "dashboard/sections/quick_reference" %>

  <%= render "dashboard/sections/officials" %>

  <%= render "dashboard/sections/rco" %>

  <%= render "dashboard/sections/legislation" %>

  <%= render "dashboard/sections/pathways" %>

  <%= render "dashboard/sections/care_for_your_home" %>

  <%= render "dashboard/sections/transportation" %>


</div>

<script>
// ── Quick Reference collapse/expand ──────────────────────────────────────────
function toggleQRef() {
  var body = document.getElementById('qref-body');
  var btn  = document.querySelector('.qref-collapse-btn');
  if (!body) return;
  var collapsed = body.style.display === 'none';
  body.style.display = collapsed ? '' : 'none';
  if (btn) btn.textContent = collapsed ? '\u25BC' : '\u25B2';
}

// ── Map picker dropdown ──────────────────────────────────────────────────────
function toggleMap(el, ev) {
  ev.stopPropagation();
  document.querySelectorAll('.address-wrap.open').forEach(function(o) {
    if (o !== el) o.classList.remove('open');
  });
  el.classList.toggle('open');
}
document.addEventListener('click', function() {
  document.querySelectorAll('.address-wrap.open').forEach(function(o) {
    o.classList.remove('open');
  });
});

// ── Section shortcut active state (IntersectionObserver) ────────────────────
(function() {
  var sections  = document.querySelectorAll('.section-anchor[id]');
  var shortcuts = document.querySelectorAll('.ps-link');
  if (!sections.length || !shortcuts.length || !('IntersectionObserver' in window)) return;

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      var id    = entry.target.id;
      shortcuts.forEach(function(s) { s.classList.remove('active'); });
      var match = document.querySelector('.ps-link[href="#' + id + '"]');
      if (match) match.classList.add('active');
    });
  }, { rootMargin: '-100px 0px -60% 0px' });

  sections.forEach(function(s) { observer.observe(s); });
})();

// ── Legislation Docket / Record toggle ─────────────────────────────────────
(function() {
  var docketActive = true;
  var state = {
    docket: { offset: <%= (@docket_bills || []).size %>, hasMore: <%= @docket_has_more %>, fetching: false, total: <%= @docket_total || 0 %> },
    record: { offset: <%= (@record_bills || []).size %>, hasMore: <%= @record_has_more %>, fetching: false, total: <%= @record_total || 0 %> }
  };

  function esc(s) {
    return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function flagClass(jur) {
    if (jur === 'federal')      return 'fed';
    if (jur === 'pennsylvania') return 'state';
    if (jur === 'philadelphia') return 'local';
    return 'local';
  }
  function flagLabel(jur) {
    if (jur === 'federal')      return 'Federal';
    if (jur === 'pennsylvania') return 'State';
    if (jur === 'philadelphia') return 'Local';
    return jur || 'Local';
  }

  function buildRow(b, view) {
    var fc = flagClass(b.jurisdiction);
    var fl = flagLabel(b.jurisdiction);
    var dateHtml = '';
    if (b.status_date) {
      dateHtml = view === 'docket'
        ? '<div style="font-family:\'JetBrains Mono\',monospace;font-size:7.5px;letter-spacing:0.06em;color:var(--gilt);margin-top:3px;">Upcoming action \xB7 ' + esc(b.status_date) + '</div>'
        : '<div style="font-family:\'JetBrains Mono\',monospace;font-size:7.5px;letter-spacing:0.06em;color:var(--ink-mut);margin-top:3px;">' + esc(b.status_date) + '</div>';
    }
    var numHtml = b.identifier ? '<span class="leg-bill-number">' + esc(b.identifier) + '</span>' : '';
    return '<a href="/mvp/bills/' + b.id + '" style="text-decoration:none;color:inherit;display:block;">' +
      '<div class="leg-row">' +
        '<div class="leg-relevance"><div class="leg-rel-score tier-low" style="color:var(--ink-mut);font-size:16px;">\u2014</div><div class="leg-rel-label">Rank</div></div>' +
        '<div>' +
          '<div class="leg-meta-row"><span class="bill-level-flag ' + fc + '">' + fl + '</span>' + numHtml + '</div>' +
          '<div class="leg-title">' + esc((b.title || '').substring(0, 220)) + ((b.title || '').length > 220 ? '\u2026' : '') + '</div>' +
          dateHtml +
        '</div>' +
        '<div class="leg-action"><span class="leg-action-btn">Read bill \u2192</span></div>' +
      '</div>' +
    '</a>';
  }

  function loadMore(view) {
    var s = state[view];
    if (s.fetching || !s.hasMore) return;
    s.fetching = true;
    var sentinel = document.getElementById(view + '-sentinel');
    sentinel.innerHTML = '<div style="text-align:center;padding:12px;font-family:\'JetBrains Mono\',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:var(--gilt);">&#9670; Loading...</div>';

    fetch('/dashboard/bills?view=' + view + '&offset=' + s.offset)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var feed = document.getElementById(view + '-feed');
        data.bills.forEach(function(b) { feed.insertAdjacentHTML('beforeend', buildRow(b, view)); });
        s.offset  += data.bills.length;
        s.hasMore  = data.has_more;
        s.fetching = false;
        sentinel.innerHTML = s.hasMore
          ? ''
          : '<div style="text-align:center;padding:14px;font-family:\'JetBrains Mono\',monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--ink-mut);">&#9733; All bills loaded</div>';
      })
      .catch(function() { s.fetching = false; sentinel.innerHTML = ''; });
  }

  if ('IntersectionObserver' in window) {
    var scrollObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (!e.isIntersecting) return;
        loadMore(e.target.id.replace('-sentinel', ''));
      });
    }, { rootMargin: '300px' });
    ['docket', 'record'].forEach(function(v) {
      var el = document.getElementById(v + '-sentinel');
      if (el) scrollObserver.observe(el);
    });
  }

  window.foraLegToggle = function() {
    docketActive = !docketActive;
    var view = docketActive ? 'docket' : 'record';
    document.getElementById('leg-docket-panel').style.display = docketActive ? 'block' : 'none';
    document.getElementById('leg-record-panel').style.display = docketActive ? 'none'  : 'block';
    document.getElementById('leg-title').textContent          = docketActive ? 'The Docket' : 'The Record';
    document.getElementById('leg-toggle-link').textContent    = docketActive ? 'Check The Record \u2192' : 'See what\u2019s on The Docket \u2192';
    document.getElementById('leg-count').textContent          = docketActive
      ? state.docket.total + ' upcoming actions'
      : state.record.total + ' recent bills';

    var sentinel = document.getElementById(view + '-sentinel');
    if (sentinel) {
      var rect = sentinel.getBoundingClientRect();
      if (rect.top < window.innerHeight + 300) loadMore(view);
    }
  };
})();
</script>
