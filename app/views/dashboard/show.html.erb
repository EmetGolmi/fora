          {title:'S.B. 742 \u2014 Home Improvement Consumer Protection Act amendments (PA, 2025)', sub:'Strengthens requirements for written contracts on jobs over $500. Requires contractors to disclose HIC registration number on all ads and bids. Passed Senate October 2025.', tag:'Bill \u00b7 State'},
          {title:'Philadelphia Code \u00a7 9-1601 \u2014 Home Improvement Contractor licensing', sub:'City ordinance requires any contractor doing home improvement work in Philadelphia to register with L&I. Unregistered contractors are subject to fines up to $2,000 per violation.', tag:'City ordinance'}
