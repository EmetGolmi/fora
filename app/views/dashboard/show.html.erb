function dbOasisExpand(btn) {
  var detail = document.getElementById('db-oasis-detail');
  var icon = document.getElementById('db-expand-icon');
  if (!detail) return;
  var open = detail.style.display !== 'none';
  detail.style.display = open ? 'none' : '';
  if (icon) icon.textContent = open ? '+' : '\u2212';
  if (btn) btn.classList.toggle('open', !open);
}

function dbAddComment() {
  var inp = document.getElementById('db-comment-txt');
  if (!inp || !inp.value.trim()) return;
  var initials = '<%= ((@profile.market_display_name.presence || @profile.provider_handle.to_s).upcase.gsub(/[^A-Z]/,"")[0,2]).presence || "ME" %>';
  _dbOasisComments.push({ text: inp.value.trim(), ts: Date.now(), av: initials });
  inp.value = '';
  dbRenderComments();
}

function dbRenderComments() {
  var el = document.getElementById('db-comment-list');
  if (!el || !_dbOasisComments.length) { if(el) el.innerHTML=''; return; }
  el.innerHTML = _dbOasisComments.map(function(c) {
    var mins = Math.round((Date.now() - c.ts) / 60000);
    var when = mins < 1 ? 'just now' : mins < 60 ? mins + 'm ago' : Math.floor(mins/60) + 'h ago';
    return '<div class="db-comment"><div class="db-comment-av">' + c.av + '</div>'
      + '<div class="db-comment-body"><div class="db-comment-who">You \u00b7 <span style="font-weight:400;color:#aaa;font-size:10px">' + when + '</span></div>'
      + '<div class="db-comment-text">' + c.text.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</div>'
      + '</div></div>';
  }).join('');
  el.scrollTop = el.scrollHeight;
}

function cardShareItems(name, url) {
  var enc = encodeURIComponent, txt = enc(name), href = enc(url), safeUrl = url.replace(/'/g,"\\'");
  var copyFn = 'event.stopPropagation();event.preventDefault();navigator.clipboard&&navigator.clipboard.writeText(\''+safeUrl+'\').then(function(){var el=this;el.textContent=el.textContent.replace(/Copy /,"Copied! ");setTimeout(function(){el.textContent=el.textContent.replace(/Copied! /,"Copy ");},2000);}.bind(this))';
  return '<a class="lshare-item" href="https://twitter.com/intent/tweet?text='+txt+'&url='+href+'" target="_blank" rel="noopener" onclick="event.stopPropagation()"><span style="font-weight:900">𝕏</span> Share on X</a>'
       + '<a class="lshare-item" href="https://www.facebook.com/sharer/sharer.php?u='+href+'" target="_blank" rel="noopener" onclick="event.stopPropagation()"><span style="color:#1877f2;font-weight:700">f</span> Share on Facebook</a>'
       + '<a class="lshare-item" href="https://wa.me/?text='+enc(name+' '+url)+'" target="_blank" rel="noopener" onclick="event.stopPropagation()"><span style="color:#25d366">●</span> Share on WhatsApp</a>'
       + '<a class="lshare-item" href="https://www.linkedin.com/sharing/share-offsite/?url='+href+'" target="_blank" rel="noopener" onclick="event.stopPropagation()"><span style="color:#0a66c2;font-weight:700">in</span> Share on LinkedIn</a>'
       + '<a class="lshare-item" href="https://reddit.com/submit?url='+href+'&title='+txt+'" target="_blank" rel="noopener" onclick="event.stopPropagation()"><span style="color:#ff4500;font-weight:700">r/</span> Share on Reddit</a>'
       + '<a class="lshare-item" href="#" onclick="'+copyFn+'"><span>📸</span> Copy for Instagram</a>'
       + '<a class="lshare-item" href="#" onclick="'+copyFn+'"><span>♪</span> Copy for TikTok</a>';
}

function toggleShareMenu(id, name, url) {
  var menus = document.querySelectorAll('.lshare-menu');
  menus.forEach(function(m){ if (m.id !== id) m.classList.remove('open'); });
  var el = document.getElementById(id);
  if (el) {
    if (url && !el.innerHTML.trim()) { el.innerHTML = cardShareItems(name, url); }
    el.classList.toggle('open');
  }
}

document.addEventListener('click', function(e) {
  if (!e.target.closest('.lshare-btn') && !e.target.closest('.lshare-menu')) {
    document.querySelectorAll('.lshare-menu.open').forEach(function(m){ m.classList.remove('open'); });
  }
});

