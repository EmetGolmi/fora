                <%= item.identifier.presence || "" %>
              <% elsif type == "NeighborhoodIssue" %>
                <span class="dk-k k-issue">Issue</span>
                <%= item.location_description.presence || item.rco_slug %>
              <% elsif type == "CivicRepresentative" %>
                <span class="dk-k" style="background:var(--blue-pl);color:var(--blue);">Rep</span>
                <%= item.office.to_s.split.first(3).join(" ") %>
              <% end %>
              <span class="dk-w"><%= time_ago_short(h[:last_at]) %></span>
            </div>
            <div class="dk-t">
              <% if type == "CivicBill" %>
                <%= item.title.truncate(70) %>
              <% elsif type == "NeighborhoodIssue" %>
                <%= item.body.truncate(70) %>
              <% elsif type == "CivicRepresentative" %>
                <%= item.name %>
