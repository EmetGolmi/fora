          {title:'Philadelphia Zoning Code \u2014 2023 accessory dwelling unit amendments', sub:'Bill No. 220665 amended the Zoning Code to permit ADUs by-right in R-1 through R-10 districts on lots over 1,600 sq ft. Design standards set maximum height and required setbacks for accessory structures.', tag:'City ordinance'},
          {title:'H.B. 1677 \u2014 Architect Licensure Modernization Act (PA, 2025)', sub:'Updates continuing education requirements for PA-licensed architects and aligns reciprocity with 47 states participating in the NCARB licensing system. Effective January 2026.', tag:'Bill \u00b7 State'}
