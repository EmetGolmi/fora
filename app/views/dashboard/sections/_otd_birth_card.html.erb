<% full_width = local_assigns.fetch(:full_width, false) %>
<div class="otd-born <%= 'otd-full-width' if full_width %>">
  <div class="otd-born-label">★ Born today · Philadelphia</div>
  <div class="otd-born-name"><%= entry.title %></div>
  <div class="otd-born-year">
    <%= entry.year %><% if entry.neighborhood.present? %> · <%= entry.neighborhood %><% end %>
  </div>
  <div class="otd-born-body"><%= entry.body %></div>
</div>
