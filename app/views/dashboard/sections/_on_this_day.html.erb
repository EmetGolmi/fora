<section class="section-anchor" id="otd" style="margin-top:0;">
  <div class="section-eyebrow">★ <%= @today.strftime("%A · %B %-d, %Y") %></div>
  <div class="section-heading">On this day in Philadelphia</div>
  <div class="gilt-rule"></div>

  <% if @on_this_day_event.nil? && @on_this_day_birth.nil? %>
    <%# Case 3: 0 entries — fallback %>
    <div class="otd-empty">
      <div class="otd-empty-title">No entry yet for today.</div>
      <div class="otd-empty-body">
        Philadelphia history is being added daily.
        <em>Care to nominate one?</em>
      </div>
    </div>

  <% elsif @on_this_day_event && @on_this_day_birth %>
    <%# Case 1: 1 event + 1 birth — 2-column standard %>
    <div class="otd-row">
      <%= render "dashboard/sections/otd_feature_card", entry: @on_this_day_event %>
      <%= render "dashboard/sections/otd_birth_card", entry: @on_this_day_birth %>
    </div>

  <% else %>
    <%# Case 2: 1 entry of either type — full-width %>
    <% entry = @on_this_day_event || @on_this_day_birth %>
    <% if entry.entry_type == "event" %>
      <%= render "dashboard/sections/otd_feature_card", entry: entry, full_width: true %>
    <% else %>
      <%= render "dashboard/sections/otd_birth_card", entry: entry, full_width: true %>
    <% end %>
  <% end %>
</section>
