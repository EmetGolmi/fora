<%#
  STUB — Phase 2: this content will be resolved dynamically from
  the address (Census Tract → trash day, GIS → nearest stations, etc).
  MVP hardcodes Bella Vista / 19147 / D2 values.
%>
<section class="section-anchor qref-anchor" id="qref">
  <div class="section-eyebrow">★ Quick Reference · For your kitchen cabinet</div>
  <div class="section-heading">The numbers and places you'll need before you need them</div>
  <div class="section-sub">Print it. Text it to a babysitter. Tape it inside the cabinet. The information that matters at 11pm on a Tuesday — already there, before you go looking.</div>
  <div class="gilt-rule"></div>

  <div class="qref">
    <div class="qref-header">
      <div class="qref-h-icon">★</div>
      <div class="qref-h-title"><%= @address %> · Quick Reference</div>
      <div class="qref-h-sub">19147 · Bella Vista · D2</div>
      <div class="qref-actions">
        <button class="qref-btn" onclick="window.print()">🖨 Print</button>
      </div>
    </div>

    <div class="qref-body">
      <div class="qref-item">
        <div class="qref-label">Poison Control · 24/7</div>
        <div class="qref-phone"><%= phone_link("18002221222", "1-800-222-1222") %></div>
        <div class="qref-meta">Free · Free language line</div>
      </div>
      <div class="qref-item">
        <div class="qref-label">Trash &amp; Recycling</div>
        <div class="qref-value">Wednesday morning</div>
        <div class="qref-meta">Recycling alternating · check phila.gov for next date</div>
      </div>
      <div class="qref-item">
        <div class="qref-label">Nearest Hospital</div>
        <div class="qref-value">Pennsylvania Hospital</div>
        <div class="qref-meta">
          <%= address_link("800 Spruce St, Philadelphia, PA 19107", display_text: "800 Spruce St") %>
          · 0.6 mi · ER 24/7
        </div>
      </div>
      <div class="qref-item">
        <div class="qref-label">Nearest Police</div>
        <div class="qref-value">3rd District</div>
        <div class="qref-meta">
          <%= address_link("11th and Wharton, Philadelphia, PA", display_text: "11th &amp; Wharton".html_safe) %>
          · 0.4 mi · <%= phone_link("2156863030", "(215) 686-3030") %>
        </div>
      </div>
    </div>

    <div class="qref-divider"></div>

    <div class="qref-body">
      <div class="qref-item">
        <div class="qref-label">Nearest Fire Station</div>
        <div class="qref-value">Engine 1 / Ladder 5</div>
        <div class="qref-meta">
          <%= address_link("9th and Bainbridge, Philadelphia, PA", display_text: "9th &amp; Bainbridge".html_safe) %>
          · 0.2 mi
        </div>
      </div>
      <div class="qref-item">
        <div class="qref-label">City Services · 24/7</div>
        <div class="qref-phone"><%= phone_link("311", "311") %></div>
        <div class="qref-meta">Or text 311 from your phone</div>
      </div>
      <div class="qref-item">
        <div class="qref-label">Power Outage · PECO</div>
        <div class="qref-phone"><%= phone_link("18008414141", "1-800-841-4141") %></div>
        <div class="qref-meta">Or text "OUT" to 697-326</div>
      </div>
      <div class="qref-item">
        <div class="qref-label">Water Emergency · PWD</div>
        <div class="qref-phone"><%= phone_link("2156856300", "(215) 685-6300") %></div>
        <div class="qref-meta">Main break · sewage backup</div>
      </div>
    </div>

    <div class="qref-footer">
      <div class="qref-footer-text">Sources: City of Philadelphia, PWD, PECO, AAPCC · Updated May 2026</div>
      <div class="qref-footer-meta">FORA · Free forever</div>
    </div>
  </div>
</section>
