<% content_for(:title) { "East Passyunk Crossing Civic Association — FORA" } %>

<% content_for :head do %>
<style>
:root {
  --blue: #1b3a6b; --gilt: #b8860b; --gilt-lt: #d4a832; --gilt-pl: #f8f0dc;
  --gilt-rul: rgba(184,134,11,0.22); --ink: #0e1a2e; --ink-soft: #5a6e8a;
  --ink-mut: #8a9ab8; --rule: rgba(27,58,107,0.1); --bg: #f2f4f8;
  --green: #155c2d; --green-p: #e5f0e8; --green-r: #8cc4a0;
}
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
body { font-family:'Nunito',sans-serif; background:var(--bg); color:var(--ink); }
</style>
<% end %>

<div style="background:var(--blue); padding:44px 48px 40px; position:relative; overflow:hidden;">
  <div style="position:absolute;right:-60px;top:-80px;width:400px;height:400px;border-radius:50%;border:44px solid rgba(255,255,255,0.02);pointer-events:none;"></div>

  <div style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.14em; text-transform:uppercase; color:rgba(255,255,255,0.3); margin-bottom:16px;">
    <a href="/" style="color:rgba(255,255,255,0.3); text-decoration:none;">FORA</a>
    <span style="margin:0 6px; opacity:0.3;">/</span>
    <a href="#" style="color:rgba(255,255,255,0.3); text-decoration:none;">Philadelphia</a>
    <span style="margin:0 6px; opacity:0.3;">/</span>
    <a href="/usa/pa/philly/rco/bvna" style="color:rgba(255,255,255,0.3); text-decoration:none;">RCOs</a>
    <span style="margin:0 6px; opacity:0.3;">/</span>
    <span style="color:var(--gilt-lt);">East Passyunk Crossing</span>
  </div>

  <div style="display:flex; align-items:flex-start; gap:20px; margin-bottom:20px;">
    <div style="width:64px; height:64px; border-radius:12px; background:var(--gilt-pl); border:2px solid var(--gilt-rul); display:flex; align-items:center; justify-content:center; font-family:'Libre Baskerville',serif; font-size:18px; font-weight:700; color:var(--gilt); flex-shrink:0;">EP</div>
    <div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.18em; text-transform:uppercase; color:var(--gilt-lt); margin-bottom:5px; display:flex; align-items:center; gap:8px;">
        <span style="background:rgba(184,134,11,0.18); border:1px solid var(--gilt-rul); padding:2px 8px; border-radius:3px;">RCO</span>
        <span style="color:rgba(255,255,255,0.3); font-size:7.5px;">✓ Verified · Philadelphia PCPC</span>
      </div>
      <div style="font-family:'Libre Baskerville',serif; font-size:32px; font-weight:700; color:white; line-height:1.1; margin-bottom:6px;">East Passyunk Crossing Civic Association</div>
      <div style="font-family:'Nunito',sans-serif; font-size:14px; color:rgba(255,255,255,0.5); margin-bottom:12px;">East Passyunk · Philadelphia · 19148</div>
      <div style="display:flex; gap:6px; flex-wrap:wrap;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 10px; border-radius:100px; border:1px solid; background:rgba(196,132,90,0.2); border-color:rgba(196,132,90,0.4); color:#f5c9a8;">Civic Association</span>
        <span style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 10px; border-radius:100px; border:1px solid; background:rgba(255,255,255,0.06); border-color:rgba(255,255,255,0.14); color:rgba(255,255,255,0.48);">19148</span>
        <span style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.1em; text-transform:uppercase; padding:3px 10px; border-radius:100px; border:1px solid; background:rgba(21,92,45,0.2); border-color:rgba(140,196,160,0.35); color:#86efac;">District 2</span>
      </div>
    </div>
  </div>

  <div style="display:flex; gap:8px; margin-top:4px;">
    <a href="https://www.eastpassyunk.org" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; background:var(--gilt); border:none; border-radius:100px; padding:10px 20px; color:white; text-decoration:none; font-weight:700;">Visit Website ↗</a>
    <button style="background:transparent; border:1.5px solid rgba(255,255,255,0.18); border-radius:100px; padding:9px 20px; font-family:'JetBrains Mono',monospace; font-size:9px; letter-spacing:0.12em; text-transform:uppercase; color:rgba(255,255,255,0.55); cursor:pointer;">+ Follow</button>
  </div>
</div>

<div style="max-width:900px; margin:0 auto; padding:40px 24px;">

  <div style="background:white; border:1px solid var(--rule); border-left:3px solid var(--gilt); border-radius:10px; padding:20px 24px; margin-bottom:32px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.16em; text-transform:uppercase; color:var(--gilt); margin-bottom:10px;">◆ Coming to FORA</div>
    <p style="font-family:'Nunito',sans-serif; font-size:14px; color:var(--ink-soft); line-height:1.7; margin:0;">The East Passyunk Crossing Civic Association's full profile — meetings, zoning cases, active efforts, and community record — is being built on FORA. In the meantime, visit their website or attend a monthly meeting to get involved.</p>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:32px;">
    <div style="background:white; border:1px solid var(--rule); border-radius:10px; padding:18px 20px;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-mut); margin-bottom:10px;">◆ What EPCA covers</div>
      <div style="font-family:'Nunito',sans-serif; font-size:13px; color:var(--ink); line-height:1.7;">East Passyunk Avenue corridor, Italian Market area, surrounding residential blocks of 19148. Shares boundaries with BVNA to the north and Newbold Civic Association to the west.</div>
    </div>
    <div style="background:white; border:1px solid var(--rule); border-radius:10px; padding:18px 20px;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-mut); margin-bottom:10px;">◆ Your councilmember</div>
      <a href="/mvp/officials/usa/pa/philly/council-president" style="font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; color:var(--blue); text-decoration:none; display:block; line-height:1.4;">Kenyatta Johnson ›</a>
      <div style="font-family:'Nunito',sans-serif; font-size:12px; color:var(--ink-soft); margin-top:2px;">Council President · District 2</div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7.5px; color:var(--ink-mut); margin-top:6px;">(215) 686-3412</div>
    </div>
  </div>

  <div style="background:white; border:1px solid var(--rule); border-radius:10px; padding:18px 20px; margin-bottom:32px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-mut); margin-bottom:14px;">◆ Issue tags</div>
    <div style="display:flex; flex-wrap:wrap; gap:6px;">
      <% ["Vision Zero","Pedestrian safety","Slow zones","Zoning","Historic preservation","East Passyunk Ave","Small business","Public safety","Traffic calming","Parks"].each do |tag| %>
        <span style="font-family:'JetBrains Mono',monospace; font-size:7.5px; letter-spacing:0.08em; text-transform:uppercase; padding:4px 9px; border-radius:100px; background:var(--bg); border:1px solid var(--rule); color:var(--ink-soft);"><%= tag %></span>
      <% end %>
    </div>
  </div>

  <div style="background:white; border:1px solid var(--rule); border-radius:10px; padding:18px 20px;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.14em; text-transform:uppercase; color:var(--ink-mut); margin-bottom:14px;">◆ Contact & links</div>
    <div style="display:flex; flex-direction:column; gap:8px;">
      <div style="display:flex; gap:10px; align-items:center; padding:6px 0; border-bottom:1px solid var(--rule);">
        <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-mut); width:64px; flex-shrink:0;">Website</span>
        <a href="https://www.eastpassyunk.org" target="_blank" rel="noopener" style="font-family:'Nunito',sans-serif; font-size:12px; color:#3a6abf; text-decoration:none;">eastpassyunk.org ↗</a>
      </div>
      <div style="display:flex; gap:10px; align-items:center; padding:6px 0; border-bottom:1px solid var(--rule);">
        <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-mut); width:64px; flex-shrink:0;">RCO Status</span>
        <span style="font-family:'Nunito',sans-serif; font-size:12px; color:var(--ink);">Verified · Philadelphia PCPC · Active</span>
      </div>
      <div style="display:flex; gap:10px; align-items:baseline; padding:6px 0;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-mut); width:64px; flex-shrink:0;">Sister orgs</span>
        <a href="/usa/pa/philly/rco/bvna" style="font-family:'Nunito',sans-serif; font-size:12px; color:#3a6abf; text-decoration:none;">Bella Vista Neighbors Association ›</a>
      </div>
    </div>
  </div>

</div>
