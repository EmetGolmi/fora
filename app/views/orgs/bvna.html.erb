<% content_for :head do %>
<style>
:root {
  --bg:       #f2f4f8;
  --bg2:      #e8ebf2;
  --white:    #ffffff;
  --blue:     #1b3a6b;
  --blue-md:  #254f92;
  --blue-lt:  #3a6abf;
  --blue-pl:  #dde5f5;
  --blue-vp:  #edf1fb;
  --gilt:     #b8860b;
  --gilt-lt:  #d4a832;
  --gilt-pl:  #f8f0dc;
  --gilt-rul: rgba(184,134,11,0.22);
  --ink:      #0e1a2e;
  --ink-mid:  #2c3e5a;
  --ink-soft: #5a6e8a;
  --ink-mut:  #8a9ab8;
  --rule:     rgba(27,58,107,0.1);
  --rule-lt:  rgba(27,58,107,0.05);
  --green:    #155c2d;
  --green-p:  #e5f0e8;
  --green-r:  #8cc4a0;
  --red:      #8b2020;
  --red-p:    #f7eaea;
  --red-r:    #d4a0a0;
  --amber:    #c47f00;
  --amber-p:  #fdf3dc;
  --amber-r:  rgba(196,127,0,0.28);
  --terra:    #c4845a;
  --terra-p:  #faf0e8;
  --terra-r:  rgba(196,132,90,0.28);
}
*,*::before,*::after{box-sizing:border-box;}

/* ── QUIET TICKER ── */
.quiet-ticker{height:26px;background:#0e1a2e;border-bottom:1px solid rgba(27,58,107,0.4);display:flex;align-items:center;padding:0 24px;gap:18px;}
.qt-item{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.3);}
.qt-item span{color:rgba(255,255,255,0.65);}

/* ── HERO ── */
.bvna-hero{background:var(--blue);padding:44px 48px 52px;position:relative;overflow:hidden;}
.bvna-hero::after{content:'★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★';position:absolute;bottom:0;left:0;right:0;height:26px;display:flex;align-items:center;padding:0 48px;font-size:11px;letter-spacing:0.55em;color:var(--gilt);overflow:hidden;white-space:nowrap;-webkit-mask-image:linear-gradient(to right,black 92%,transparent 100%);mask-image:linear-gradient(to right,black 92%,transparent 100%);}
.hero-ring{position:absolute;right:-60px;top:-80px;width:400px;height:400px;border-radius:50%;border:44px solid rgba(255,255,255,0.02);pointer-events:none;}
.hero-ring2{position:absolute;right:60px;top:20px;width:220px;height:220px;border-radius:50%;border:1px solid rgba(184,134,11,0.1);pointer-events:none;}

/* breadcrumb */
.hero-breadcrumb{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-bottom:16px;line-height:2;position:relative;}
.hero-breadcrumb a{color:rgba(255,255,255,0.3);text-decoration:none;white-space:nowrap;}
.hero-breadcrumb a:hover{color:rgba(255,255,255,0.75);}
.hero-breadcrumb .sep{opacity:0.2;margin:0 5px;}
.bc-row{display:flex;flex-wrap:wrap;align-items:center;gap:0;}
.bc-cosmic{color:rgba(255,255,255,0.15);font-size:7px;letter-spacing:0.1em;}
.bc-cosmic a{color:rgba(255,255,255,0.15);}
.bc-cosmic a:hover{color:rgba(255,255,255,0.5);}
.bc-earth{color:rgba(255,255,255,0.22);font-size:7.5px;}
.bc-earth a{color:rgba(255,255,255,0.22);}
.bc-earth a:hover{color:rgba(255,255,255,0.6);}
.bc-local{color:rgba(255,255,255,0.45);font-size:8px;}
.bc-local a{color:rgba(255,255,255,0.45);}
.bc-local a:hover{color:rgba(255,255,255,0.85);}
.bc-here{color:var(--gilt-lt);font-size:8px;font-weight:600;}
.bc-collapse{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.2);cursor:pointer;border:1px solid rgba(255,255,255,0.12);padding:2px 8px;border-radius:3px;margin-left:4px;transition:all 0.12s;white-space:nowrap;}
.bc-collapse:hover{color:rgba(255,255,255,0.5);border-color:rgba(255,255,255,0.3);}
.bc-full{display:none;}
.bc-full.open{display:flex;flex-wrap:wrap;align-items:center;gap:0;}

.hero-inner{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:start;}

/* org identity */
.org-identity{display:flex;align-items:flex-start;gap:20px;margin-bottom:18px;}
.org-mark{width:64px;height:64px;border-radius:12px;background:var(--gilt-pl);border:2px solid var(--gilt-rul);display:flex;align-items:center;justify-content:center;font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:var(--gilt);flex-shrink:0;position:relative;}
.org-verified-badge{position:absolute;bottom:-4px;right:-4px;width:20px;height:20px;border-radius:50%;background:var(--green);border:2.5px solid var(--blue);display:flex;align-items:center;justify-content:center;font-size:9px;}
.org-local-label{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:var(--gilt-lt);margin-bottom:5px;display:flex;align-items:center;gap:8px;}
.org-local-label-badge{background:rgba(184,134,11,0.18);border:1px solid var(--gilt-rul);padding:2px 8px;border-radius:3px;}
.org-verified-text{color:rgba(255,255,255,0.3);font-size:7.5px;letter-spacing:0.12em;}
.org-name{font-family:'Libre Baskerville',serif;font-size:36px;font-weight:700;color:white;line-height:1.1;margin-bottom:6px;}
.org-jurisdiction{font-family:'Nunito',sans-serif;font-size:15px;font-weight:300;color:rgba(255,255,255,0.55);margin-bottom:10px;}
.org-tags{display:flex;gap:6px;flex-wrap:wrap;}
.org-tag{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;padding:3px 10px;border-radius:100px;border:1px solid;}
.tag-type{background:rgba(196,132,90,0.2);border-color:rgba(196,132,90,0.4);color:#f5c9a8;}
.tag-year{background:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.14);color:rgba(255,255,255,0.48);}
.tag-bounds{background:rgba(255,255,255,0.06);border-color:rgba(255,255,255,0.14);color:rgba(255,255,255,0.48);}
.tag-np{background:rgba(21,92,45,0.2);border-color:rgba(140,196,160,0.35);color:#86efac;}
.org-mission{font-family:'Nunito',sans-serif;font-size:13.5px;font-weight:300;color:rgba(255,255,255,0.5);line-height:1.7;max-width:620px;margin-top:14px;font-style:italic;border-left:2px solid var(--gilt-rul);padding-left:14px;}

/* stat strip */
.hero-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);border-radius:10px;overflow:hidden;margin-top:20px;}
.hs{background:rgba(255,255,255,0.03);padding:12px 16px;}
.hs-num{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:white;}
.hs-label{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.27);margin-top:3px;}

/* action buttons */
.hero-right{display:flex;flex-direction:column;gap:8px;min-width:190px;}
.btn-primary{background:var(--gilt);border:none;border-radius:100px;padding:12px 24px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:white;cursor:pointer;font-weight:700;width:100%;}
.btn-primary:hover{background:var(--gilt-lt);}
.btn-secondary{background:transparent;border:1.5px solid rgba(255,255,255,0.18);border-radius:100px;padding:11px 24px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.55);cursor:pointer;width:100%;}
.btn-secondary:hover{border-color:rgba(255,255,255,0.4);color:rgba(255,255,255,0.85);}
.btn-green{background:var(--green-p);border:1px solid var(--green-r);border-radius:100px;padding:11px 24px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;color:var(--green);cursor:pointer;font-weight:700;width:100%;}
.btn-green:hover{background:#d0e8d8;}
.hero-followers{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.22);text-align:center;}

/* ── TABS ── */
.org-tabs{background:var(--white);border-bottom:1px solid var(--rule);position:sticky;top:60px;z-index:100;}
.tabs-inner{display:flex;padding:0 48px;}
.tab{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);padding:16px 18px;border-bottom:3px solid transparent;cursor:pointer;transition:color 0.15s,border-color 0.15s;white-space:nowrap;}
.tab:hover{color:var(--blue);}
.tab.active{color:var(--blue);border-bottom-color:var(--gilt);font-weight:700;}

/* ── BODY ── */
.org-body{display:grid;grid-template-columns:1fr 308px;max-width:1200px;margin:0 auto;}
.org-main{padding:32px 48px;border-right:1px solid var(--rule);}
.sec-ey{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.2em;text-transform:uppercase;color:var(--gilt);margin-bottom:4px;display:flex;align-items:center;gap:6px;}
.sec-ey::before{content:'◆';font-size:6px;}
.sec-title{font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;color:var(--blue);margin-bottom:16px;}
.sec-block{margin-bottom:40px;}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--rule);}
.sec-link{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;color:var(--blue-lt);text-decoration:none;cursor:pointer;}
.sec-link:hover{text-decoration:underline;}

/* ── EFFORT CARDS ── */
.effort-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:15px 16px;margin-bottom:10px;cursor:pointer;transition:box-shadow 0.15s;border-left:3px solid transparent;}
.effort-card:hover{box-shadow:0 4px 16px rgba(27,58,107,0.08);}
.effort-card.active-effort{border-left-color:var(--green);}
.effort-card.stalled-effort{border-left-color:var(--amber);}
.effort-card.resolved-effort{border-left-color:var(--blue-lt);}
.ec-top{display:flex;align-items:flex-start;gap:8px;margin-bottom:8px;}
.ec-status{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;padding:3px 8px;border-radius:3px;flex-shrink:0;margin-top:2px;}
.es-active{background:var(--green-p);color:var(--green);border:1px solid var(--green-r);}
.es-stalled{background:var(--amber-p);color:var(--amber);border:1px solid var(--amber-r);}
.es-resolved{background:var(--blue-vp);color:var(--blue-lt);border:1px solid var(--blue-pl);}
.es-forming{background:var(--terra-p);color:var(--terra);border:1px solid var(--terra-r);}
.ec-title{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:var(--blue);flex:1;line-height:1.3;}
.ec-meta{display:flex;gap:12px;align-items:center;flex-wrap:wrap;}
.ec-target{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);}
.ec-stats{display:flex;gap:10px;margin-left:auto;}
.ec-stat{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);}
.ec-stat strong{color:var(--ink);font-weight:700;}
.ec-last{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);}
.new-effort-btn{border:1.5px dashed var(--rule);border-radius:10px;padding:14px;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:all 0.12s;}
.new-effort-btn:hover{border-color:var(--blue-lt);background:var(--blue-vp);}
.neb-label{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-mut);}
.new-effort-btn:hover .neb-label{color:var(--blue);}

/* ── ZONING TIMELINE ── */
.zoning-alert{background:var(--red-p);border:1px solid var(--red-r);border-radius:8px;padding:11px 14px;margin-bottom:16px;display:flex;gap:10px;align-items:flex-start;}
.za-icon{font-size:16px;flex-shrink:0;}
.za-label{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--red);font-weight:700;margin-bottom:3px;}
.za-text{font-family:'Nunito',sans-serif;font-size:12.5px;color:var(--ink);line-height:1.5;}
.ts-wrap{position:relative;padding:32px 0 8px;margin-bottom:4px;}
.ts-axis-line{position:absolute;left:0;right:0;top:20px;height:2px;background:linear-gradient(to right,var(--blue) 0%,var(--blue-lt) 60%,var(--blue-pl) 100%);border-radius:1px;}
.ts-today-tick{position:absolute;left:0;top:10px;width:2px;height:22px;background:var(--gilt);border-radius:1px;}
.ts-today-lbl{position:absolute;left:6px;top:4px;font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--gilt);}
.ts-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;}
.ts-item{position:relative;padding-top:20px;}
.ts-node{width:12px;height:12px;border-radius:50%;border:2px solid;position:absolute;top:-6px;left:50%;transform:translateX(-50%);z-index:1;}
.ts-node-red{background:var(--red-p);border-color:var(--red);}
.ts-node-amber{background:var(--amber-p);border-color:var(--amber);}
.ts-node-blue{background:var(--blue-vp);border-color:var(--blue-lt);}
.ts-node-green{background:var(--green-p);border-color:var(--green);}
.ts-card{background:var(--white);border:1px solid var(--rule);border-radius:8px;padding:10px 12px;cursor:pointer;transition:box-shadow 0.12s;}
.ts-card:hover{box-shadow:0 4px 12px rgba(27,58,107,0.1);}
.ts-card-urgent{border-color:var(--red-r);background:var(--red-p);}
.ts-card-date{font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;color:var(--blue);margin-bottom:5px;}
.ts-date-urgent{color:var(--red);}
.ts-card-address{font-family:'Nunito',sans-serif;font-size:12.5px;font-weight:700;color:var(--blue);line-height:1.3;margin-bottom:2px;}
.ts-card-type{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);margin-bottom:7px;letter-spacing:0.06em;}
.ts-badge{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 7px;border-radius:3px;display:inline-block;}
.ts-month-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px;}
.ts-month-cell{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);text-align:center;}
.ts-month-current{color:var(--gilt);}
.pos-pending{background:var(--amber-p);color:var(--amber);border:1px solid var(--amber-r);}
.pos-support{background:var(--green-p);color:var(--green);border:1px solid var(--green-r);}
.pos-conditions{background:var(--blue-vp);color:var(--blue-lt);border:1px solid var(--blue-pl);}
.pos-oppose{background:var(--red-p);color:var(--red);border:1px solid var(--red-r);}

/* ── MEETINGS ── */
.meeting-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:16px;margin-bottom:10px;}
.mc-head{display:flex;align-items:flex-start;gap:14px;margin-bottom:12px;}
.mc-date-box{background:var(--blue);border-radius:8px;padding:8px 12px;text-align:center;flex-shrink:0;min-width:52px;}
.mc-month{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gilt-lt);}
.mc-day{font-family:'Libre Baskerville',serif;font-size:24px;font-weight:700;color:white;line-height:1;}
.mc-body{flex:1;}
.mc-title{font-family:'Nunito',sans-serif;font-size:14px;font-weight:700;color:var(--ink);margin-bottom:3px;}
.mc-meta{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);line-height:1.7;}
.mc-agenda{margin-top:10px;border-top:1px solid var(--rule-lt);padding-top:10px;}
.mc-agenda-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.14em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:6px;}
.mc-agenda-item{display:flex;gap:8px;padding:5px 0;border-bottom:1px solid var(--rule-lt);}
.mc-agenda-item:last-child{border-bottom:none;}
.mc-ai-num{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--ink-mut);flex-shrink:0;width:16px;}
.mc-ai-text{font-family:'Nunito',sans-serif;font-size:12.5px;color:var(--ink);}
.mc-ai-effort{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;background:var(--terra-p);color:var(--terra);border:1px solid var(--terra-r);padding:1px 6px;border-radius:3px;margin-left:4px;}
.mc-actions{display:flex;gap:8px;margin-top:12px;}
.mc-btn{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.12em;text-transform:uppercase;padding:7px 14px;border-radius:100px;cursor:pointer;transition:all 0.12s;}
.mc-btn-rsvp{background:var(--green-p);border:1px solid var(--green-r);color:var(--green);font-weight:700;}
.mc-btn-rsvp:hover{background:#d0e8d8;}
.mc-btn-cal{background:var(--bg);border:1px solid var(--rule);color:var(--ink-soft);}
.mc-btn-cal:hover{background:var(--bg2);}

/* ── COMMITTEES ── */
.committee-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.committee-card{background:var(--white);border:1px solid var(--rule);border-radius:10px;padding:14px 15px;transition:box-shadow 0.12s;}
.committee-card:hover{box-shadow:0 3px 12px rgba(27,58,107,0.07);}
.cc-icon{font-size:20px;margin-bottom:8px;}
.cc-name{font-family:'Libre Baskerville',serif;font-size:13px;font-weight:700;color:var(--blue);margin-bottom:3px;}
.cc-chair{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);margin-bottom:6px;}
.cc-desc{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);line-height:1.55;}
.cc-count{font-family:'JetBrains Mono',monospace;font-size:7px;color:var(--ink-mut);margin-top:6px;}

/* ── THE RECORD ── */
.record-row{display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid var(--rule-lt);}
.record-row:last-child{border-bottom:none;}
.rr-year{font-family:'Libre Baskerville',serif;font-size:18px;font-weight:700;color:var(--blue-pl);width:44px;flex-shrink:0;text-align:right;}
.rr-body{flex:1;}
.rr-title{font-family:'Nunito',sans-serif;font-size:13px;font-weight:700;color:var(--ink);margin-bottom:3px;}
.rr-outcome{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 8px;border-radius:3px;display:inline-block;margin-bottom:4px;}
.outcome-won{background:var(--green-p);color:var(--green);border:1px solid var(--green-r);}
.outcome-partial{background:var(--amber-p);color:var(--amber);border:1px solid var(--amber-r);}
.outcome-ongoing{background:var(--blue-vp);color:var(--blue-lt);border:1px solid var(--blue-pl);}
.outcome-referred{background:var(--bg2);color:var(--ink-soft);border:1px solid var(--rule);}
.rr-desc{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink-soft);line-height:1.55;}

/* ── SIDEBAR ── */
.org-sidebar{padding:26px 24px;background:var(--white);}
.sb-block{margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid var(--rule);}
.sb-block:last-child{border-bottom:none;}
.sb-ey{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.16em;text-transform:uppercase;color:var(--gilt);margin-bottom:10px;display:flex;align-items:center;gap:5px;}
.sb-ey::before{content:'◆';font-size:5.5px;}
.sb-title{font-family:'Libre Baskerville',serif;font-size:14px;font-weight:700;color:var(--blue);margin-bottom:12px;}
.contact-row{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--rule-lt);}
.contact-row:last-child{border-bottom:none;}
.contact-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);width:64px;flex-shrink:0;}
.contact-val{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink);}
.contact-val a{color:var(--blue-lt);text-decoration:none;}
.contact-val a:hover{text-decoration:underline;}
.member-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--rule-lt);}
.member-row:last-child{border-bottom:none;}
.m-circle{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:9px;font-weight:700;flex-shrink:0;}
.m-circle.ring{box-shadow:0 0 0 2.5px var(--gilt),0 0 0 4.5px transparent;}
.m-body{flex:1;min-width:0;}
.m-name{font-family:'Nunito',sans-serif;font-size:12.5px;font-weight:700;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.m-role{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-mut);margin-top:1px;}
.m-pill{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;padding:1px 6px;border-radius:3px;background:var(--bg);border:1px solid var(--rule);color:var(--ink-soft);}
.tag-cloud{display:flex;flex-wrap:wrap;gap:5px;}
.issue-tag{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.08em;text-transform:uppercase;padding:4px 9px;border-radius:100px;background:var(--bg);border:1px solid var(--rule);color:var(--ink-soft);cursor:pointer;transition:all 0.12s;}
.issue-tag:hover{background:var(--blue);color:white;border-color:var(--blue);}
.sister-card{background:var(--bg);border:1px solid var(--rule);border-radius:8px;padding:10px 12px;margin-bottom:8px;cursor:pointer;transition:all 0.12s;}
.sister-card:hover{background:var(--blue-vp);border-color:var(--blue-pl);}
.sc-top{display:flex;align-items:flex-start;gap:8px;margin-bottom:4px;}
.sc-flag{font-size:16px;flex-shrink:0;}
.sc-name{font-family:'Nunito',sans-serif;font-size:12.5px;font-weight:700;color:var(--blue);line-height:1.3;}
.sc-city{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink-mut);}
.sc-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px;}
.sc-tag{font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:0.07em;text-transform:uppercase;padding:2px 6px;border-radius:100px;background:var(--white);border:1px solid var(--rule);color:var(--ink-mut);}
.sc-type{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;text-transform:uppercase;padding:2px 6px;border-radius:3px;float:right;}
.sc-type.sister-city{background:var(--gilt-pl);color:var(--gilt);border:1px solid var(--gilt-rul);}
.sc-type.shared-issue{background:var(--blue-vp);color:var(--blue-lt);border:1px solid var(--blue-pl);}
.suggested-banner{background:var(--terra-p);border:1px solid var(--terra-r);border-radius:8px;padding:11px 13px;margin-bottom:10px;}
.sb-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:var(--terra);margin-bottom:4px;}
.sb-text{font-family:'Nunito',sans-serif;font-size:12px;color:var(--ink);line-height:1.5;}
.sb-action{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--terra);margin-top:6px;cursor:pointer;}
.sb-action:hover{text-decoration:underline;}

/* ── MAP ── */
.map-block{background:var(--bg);border:1px solid var(--rule);border-radius:10px;overflow:hidden;margin-bottom:16px;}
.map-placeholder{width:100%;aspect-ratio:4/3;background:linear-gradient(135deg,#1a2e4a 0%,#1b3a6b 40%,#254f92 100%);position:relative;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;}
.map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.04) 1px,transparent 1px);background-size:20px 20px;}
.map-boundary{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:55%;height:60%;border:2px solid var(--gilt);border-radius:4px;background:rgba(184,134,11,0.06);display:flex;align-items:center;justify-content:center;}
.map-pin{font-size:22px;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.4));}
.map-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.9);background:rgba(27,58,107,0.85);padding:3px 8px;border-radius:3px;position:absolute;bottom:10px;left:10px;}
.map-corners{position:absolute;font-family:'JetBrains Mono',monospace;font-size:6px;color:rgba(184,134,11,0.6);line-height:1.4;}
.map-corners.nw{top:8px;left:8px;}
.map-corners.ne{top:8px;right:8px;text-align:right;}
.map-corners.sw{bottom:24px;left:8px;}
.map-corners.se{bottom:24px;right:8px;text-align:right;}
.map-meta{padding:10px 12px;}
.map-meta-row{display:flex;justify-content:space-between;margin-bottom:4px;}
.map-meta-label{font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);}
.map-meta-val{font-family:'JetBrains Mono',monospace;font-size:7.5px;color:var(--ink);}
.map-btn{width:100%;background:var(--bg2);border:1px solid var(--rule);border-radius:0 0 10px 10px;padding:8px;font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.1em;text-transform:uppercase;color:var(--ink-mut);cursor:pointer;transition:all 0.12s;text-align:center;display:block;}
.map-btn:hover{background:var(--blue-vp);color:var(--blue);border-color:var(--blue-pl);}
</style>
<% end %>

