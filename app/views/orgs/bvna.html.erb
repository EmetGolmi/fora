<script>
function toggleCosmic() {
  var full  = document.getElementById('bc-full');
  var short = document.getElementById('bc-short');
  var isOpen = full.classList.contains('open');
  if (isOpen) {
    full.classList.remove('open');
    short.style.display = '';
  } else {
    full.classList.add('open');
    short.style.display = 'none';
  }
}
</script>
