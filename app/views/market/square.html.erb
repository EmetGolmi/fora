<script>
function toggleCat(header) {
  var subs = header.nextElementSibling;
  var isOpen = subs.classList.contains('open');
  if (isOpen) {
    subs.classList.remove('open');
    header.classList.remove('open');
  } else {
    subs.classList.add('open');
    header.classList.add('open');
  }
}

function toggleReviews(id) {
  var expand = document.getElementById('reviews-' + id);
  var toggle = document.getElementById('toggle-' + id);
  if (expand) {
    var isOpen = expand.classList.contains('open');
    expand.classList.toggle('open');
    if (toggle) toggle.classList.toggle('open');
  }
}

