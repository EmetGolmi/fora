<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign in — FORA</title>
<link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Nunito:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#1b3a6b;--gilt:#b8860b;--gilt-lt:#d4a832;
  --ink:#0e1a2e;--ink-soft:#5a6e8a;--ink-mut:#8a9ab8;
  --bg:#f0f3f8;--white:#fff;--rule:rgba(27,58,107,.1);
  --red:#b91c1c;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Nunito',sans-serif;background:var(--bg);color:var(--ink);min-height:100vh;display:flex;flex-direction:column;}

.nav{background:rgba(27,58,107,.97);border-bottom:2px solid var(--gilt);display:flex;align-items:center;padding:13px 26px;}
.nav-logo{font-family:'Libre Baskerville',serif;font-size:21px;font-weight:700;color:#fff;letter-spacing:.12em;text-decoration:none;}
.nav-logo span{color:var(--gilt-lt);}

.page{flex:1;display:flex;align-items:center;justify-content:center;padding:40px 20px;}

.card{background:var(--white);border:1px solid var(--rule);border-radius:16px;box-shadow:0 18px 44px rgba(20,44,82,.1);width:100%;max-width:420px;padding:36px 32px;}

.card-eyebrow{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--gilt);margin-bottom:10px;}
.card-h{font-family:'Libre Baskerville',serif;font-size:26px;font-weight:700;line-height:1.2;margin-bottom:6px;}
.card-sub{font-size:14px;color:var(--ink-soft);margin-bottom:28px;}

.field{margin-bottom:18px;}
.field label{display:block;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:7px;}
.field input{width:100%;border:1.5px solid var(--rule);border-radius:8px;padding:11px 14px;font-family:'Nunito',sans-serif;font-size:15px;color:var(--ink);background:var(--bg);outline:none;transition:border-color .15s;}
.field input:focus{border-color:var(--blue);}

.error{background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:11px 14px;font-size:13.5px;color:var(--red);margin-bottom:18px;}

.btn-submit{width:100%;background:var(--blue);color:#fff;border:none;border-radius:100px;padding:13px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:700;cursor:pointer;margin-top:6px;}
.btn-submit:hover{background:#254f92;}

.card-foot{margin-top:22px;text-align:center;font-size:13.5px;color:var(--ink-soft);}
.card-foot a{color:var(--blue);font-weight:700;text-decoration:none;}
.card-foot a:hover{text-decoration:underline;}

.footer{background:#0e1a2e;color:rgba(255,255,255,.4);padding:20px 26px;text-align:center;font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:.05em;}
</style>
</head>
<body>

<nav class="nav">
  <a href="<%= root_path %>" class="nav-logo">F<span>O</span>RA</a>
</nav>

<div class="page">
  <div class="card">
    <div class="card-eyebrow">Welcome back</div>
    <div class="card-h">Sign in to FORA</div>
    <div class="card-sub">Your civic life, your trade, your community.</div>

    <% if @error %>
      <div class="error"><%= @error %></div>
    <% end %>

    <%= form_with url: session_path, method: :post do |f| %>
      <div class="field">
        <%= f.label :email, "Email address" %>
        <%= f.email_field :email, autocomplete: "email", autofocus: true, placeholder: "you@example.com" %>
      </div>
      <div class="field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••" %>
      </div>
      <%= f.submit "Sign in →", class: "btn-submit" %>
    <% end %>

    <div class="card-foot">
      Don't have an account? <a href="<%= join_path %>">Join FORA — free</a>
    </div>
  </div>
</div>

<footer class="footer">FORA · Temple ◯ · Forum △ · Market ▢</footer>

</body>
</html>
