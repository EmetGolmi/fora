<% content_for(:title) { "The Jihad Tax · FORA" } %>

<% content_for :head do %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/tabler-icons.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}

/* ── HERO ── */
.nat-hero{background:#0e1a2e;padding:52px 24px 44px;position:relative;overflow:hidden;}
.nat-hero::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 85% 30%,rgba(184,134,11,0.08) 0%,transparent 60%);pointer-events:none;}
.nat-inner{max-width:1100px;margin:0 auto;position:relative;}
.nat-breadcrumb{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.20em;text-transform:uppercase;color:rgba(255,255,255,0.30);margin-bottom:16px;}
.nat-breadcrumb a{color:rgba(255,255,255,0.30);text-decoration:none;}
.nat-breadcrumb a:hover{color:#d4a832;}
.nat-breadcrumb span{color:#d4a832;}
.nat-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.28em;text-transform:uppercase;color:#d4a832;margin-bottom:12px;}
.nat-title{font-family:'Libre Baskerville',serif;font-size:44px;font-weight:700;color:#ffffff;line-height:1.05;margin-bottom:14px;}
.nat-title em{color:#d4a832;font-style:normal;}
.nat-subtitle{font-family:'Nunito',sans-serif;font-size:15px;color:rgba(255,255,255,0.55);max-width:700px;line-height:1.80;margin-bottom:28px;}
.nat-rule{width:44px;height:3px;background:linear-gradient(to right,#b8860b,#d4a832);border-radius:2px;}

/* ── CAVEAT BANNER ── */
.nat-caveat-wrap{background:#0e1a2e;padding:0 24px 28px;}
.nat-caveat{max-width:1100px;margin:0 auto;background:rgba(184,134,11,0.08);border:1px solid rgba(212,168,50,0.25);border-radius:7px;padding:14px 18px;display:flex;gap:12px;align-items:flex-start;}
.nat-caveat i{font-size:18px;color:#d4a832;flex-shrink:0;margin-top:1px;}
.nat-caveat-text{font-family:'Nunito',sans-serif;font-size:13px;color:rgba(255,255,255,0.50);line-height:1.70;}

/* ── FORA EDITORIAL DISCLOSURE ── */
.nat-fora-wrap{background:#0e1a2e;padding:0 24px 20px;}
.nat-fora-banner{max-width:1100px;margin:0 auto;border-left:3px solid rgba(192,57,43,0.70);background:rgba(139,0,0,0.12);border-radius:0 6px 6px 0;padding:13px 18px;display:flex;gap:12px;align-items:flex-start;}
.nat-fora-banner i{font-size:16px;color:rgba(255,120,100,0.70);flex-shrink:0;margin-top:2px;}
.nat-fora-text{font-family:'Nunito',sans-serif;font-size:12.5px;color:rgba(255,255,255,0.42);line-height:1.70;}
.nat-fora-text strong{color:rgba(255,140,120,0.80);font-weight:700;}

/* ── STATS GRID ── */
.nat-stats-section{background:#0e1a2e;padding:0 24px 44px;}
.nat-stats-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:14px;}
@media(max-width:800px){.nat-stats-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:500px){.nat-stats-grid{grid-template-columns:1fr;}}
.nat-stat-card{background:rgba(27,58,107,0.35);border:1px solid rgba(212,168,50,0.15);border-radius:8px;padding:20px 22px;}
.nat-stat-card.red{background:rgba(120,30,30,0.35);border-color:rgba(220,50,50,0.25);}
.nat-stat-card.is-clickable{cursor:pointer;transition:transform 0.12s,box-shadow 0.12s,border-color 0.12s;}
.nat-stat-card.is-clickable:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,0.30);}
.nat-stat-card.red.is-clickable:hover{border-color:rgba(220,50,50,0.55);}
.nat-stat-eyebrow{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:8px;}
.nat-stat-card .nat-stat-eyebrow{color:rgba(255,255,255,0.35);}
.nat-stat-card.red .nat-stat-eyebrow{color:rgba(255,160,160,0.60);}
.nat-stat-value{font-family:'Libre Baskerville',serif;font-size:30px;font-weight:700;line-height:1.0;margin-bottom:6px;}
.nat-stat-card .nat-stat-value{color:#d4a832;}
.nat-stat-card.red .nat-stat-value{color:#ff7070;}
.nat-stat-sub{font-family:'Nunito',sans-serif;font-size:11px;line-height:1.5;}
.nat-stat-card .nat-stat-sub{color:rgba(255,255,255,0.30);}
.nat-stat-card.red .nat-stat-sub{color:rgba(255,160,160,0.45);}

/* ── CITY LINK STRIP ── */
.nat-city-strip{background:#f5f7fb;border-bottom:1px solid rgba(27,58,107,0.10);padding:12px 24px;}
.nat-city-strip-inner{max-width:1100px;margin:0 auto;display:flex;align-items:center;gap:16px;flex-wrap:wrap;}
.nat-city-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:#8a9ab8;flex-shrink:0;}
.nat-city-link{font-family:'JetBrains Mono',monospace;font-size:8.5px;letter-spacing:0.07em;text-transform:uppercase;color:#1b3a6b;text-decoration:none;border-bottom:1px solid rgba(27,58,107,0.20);padding-bottom:1px;}
.nat-city-link:hover{color:#b8860b;border-bottom-color:#b8860b;}
.nat-city-soon{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.07em;text-transform:uppercase;color:#aab4c4;}

/* ── SECTION WRAPPER ── */
.nat-section{max-width:1100px;margin:0 auto;padding:40px 24px 0;}
.nat-section-hdr{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.22em;text-transform:uppercase;color:#b8860b;margin-bottom:16px;}
.nat-section-title{font-family:'Libre Baskerville',serif;font-size:22px;font-weight:700;color:#1b3a6b;margin-bottom:20px;}

/* ── SECTION HEADER ── */
.sec-header{padding:10px 0 6px;border-bottom:0.5px solid rgba(27,58,107,0.12);margin-bottom:0;}
.sec-eyebrow{font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:0.08em;color:#8a9ab8;display:flex;align-items:center;gap:6px;margin-bottom:3px;}
.sec-title{font-size:15px;font-weight:500;color:#1b3a6b;}
.sec-sub{font-size:12px;color:#8a9ab8;margin-top:2px;}

/* ── AGENCY TABLE ── */
.agency-table{width:100%;border-collapse:collapse;font-size:13px;margin-bottom:2rem;}
.agency-table th{text-align:left;font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:0.07em;color:#8a9ab8;padding:8px 10px;border-bottom:0.5px solid rgba(27,58,107,0.12);}
.agency-table th:not(:first-child){text-align:right;}
.agency-table td{padding:10px;border-bottom:0.5px solid rgba(27,58,107,0.12);vertical-align:middle;}
.agency-table td:not(:first-child){text-align:right;}
.agency-table tr:hover td{background:#f5f7fb;}
.agency-table tr:last-child td{border-bottom:none;}
.agency-name{font-weight:500;color:#1b3a6b;display:block;}
.agency-desc{font-size:11px;color:#8a9ab8;margin-top:2px;}
.tag{display:inline-flex;align-items:center;font-size:10px;font-weight:500;padding:2px 8px;border-radius:20px;white-space:nowrap;}
.tag-pub{background:#EAF3DE;color:#3B6D11;}
.tag-part{background:#FAEEDA;color:#854F0B;}
.tag-class{background:#FCEBEB;color:#A32D2D;}
/* ── DONUT CHART + LEGEND ── */
.ag-chart-wrap{display:grid;grid-template-columns:240px 1fr;gap:28px;align-items:center;margin-bottom:20px;}
@media(max-width:700px){.ag-chart-wrap{grid-template-columns:1fr;}.ag-donut-wrap{max-width:240px;}}
.ag-donut-wrap{width:240px;}
.ag-legend{display:flex;flex-direction:column;gap:2px;}
.ag-legend-item{display:flex;align-items:center;gap:8px;padding:5px 7px;border-radius:5px;cursor:pointer;transition:background 0.10s;}
.ag-legend-item:hover,.ag-legend-item.is-active{background:rgba(27,58,107,0.07);}
.ag-legend-color{width:9px;height:9px;border-radius:2px;flex-shrink:0;}
.ag-legend-name{flex:1;font-family:'Nunito',sans-serif;font-size:11.5px;font-weight:600;color:#2c3e5a;line-height:1.2;}
.ag-legend-amt{font-family:'JetBrains Mono',monospace;font-size:9.5px;color:#8a9ab8;white-space:nowrap;text-align:right;}
.ag-legend-pct{color:#aab4c4;}
/* ── INSIGHT CALLOUT ── */
.ag-insight{background:#f0f3f8;border-left:4px solid #1b3a6b;border-radius:0 6px 6px 0;padding:14px 18px;margin-bottom:20px;}
.ag-insight p{font-family:'Nunito',sans-serif;font-size:13px;color:#2c3e5a;line-height:1.75;margin:0;}
/* ── ACTIVE TABLE ROW ── */
.agency-table tbody tr{cursor:pointer;}
.ag-tr-active td{background:rgba(27,58,107,0.07) !important;}
.amount{font-size:13px;font-weight:500;color:#1b3a6b;white-space:nowrap;}

/* ── MAIL/ANTHRAX CARDS ── */
.mail-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-top:12px;margin-bottom:2rem;}
.mail-card{background:#ffffff;border:0.5px solid rgba(27,58,107,0.12);border-radius:8px;padding:14px 16px;}
.mail-icon{font-size:18px;color:#5a6e8a;margin-bottom:8px;}
.mail-card-title{font-size:12px;font-weight:500;color:#5a6e8a;margin-bottom:4px;}
.mail-card-value{font-size:20px;font-weight:500;color:#185FA5;line-height:1.1;margin-bottom:4px;}
.mail-card-desc{font-size:11px;color:#5a6e8a;line-height:1.55;}

/* ── TIMELINE ── */
.nat-timeline{margin-top:4px;position:relative;padding-left:28px;}
.nat-timeline::before{content:'';position:absolute;left:7px;top:8px;bottom:8px;width:2px;background:linear-gradient(to bottom,#1b3a6b,rgba(27,58,107,0.15));}
.nat-tl-item{position:relative;margin-bottom:24px;}
.nat-tl-dot{position:absolute;left:-24px;top:4px;width:10px;height:10px;border-radius:50%;background:#1b3a6b;border:2px solid #ffffff;box-shadow:0 0 0 1px #1b3a6b;}
.nat-tl-year{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.12em;color:#b8860b;font-weight:700;margin-bottom:4px;}
.nat-tl-text{font-family:'Nunito',sans-serif;font-size:13px;color:#2c3e5a;line-height:1.70;}
.nat-tl-text strong{color:#0e1a2e;}

/* ── CALLOUT BOX ── */
.nat-callout{background:#f0f3f8;border-left:4px solid #1b3a6b;border-radius:0 7px 7px 0;padding:22px 24px;margin-top:4px;}
.nat-callout-title{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:#1b3a6b;margin-bottom:14px;}
.nat-callout p{font-family:'Nunito',sans-serif;font-size:13.5px;color:#2c3e5a;line-height:1.80;margin-bottom:12px;}
.nat-callout p:last-child{margin-bottom:0;}
.nat-callout strong{color:#0e1a2e;}

/* ── SOURCES ── */
.nat-sources{background:#f5f7fb;border-radius:7px;padding:18px 20px;margin-top:4px;}
.nat-sources-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.18em;text-transform:uppercase;color:#b8860b;margin-bottom:10px;}
.nat-sources-text{font-family:'Nunito',sans-serif;font-size:12px;color:#5a6e8a;line-height:1.85;}
.nat-sources-text a{color:#254f92;text-decoration:none;}
.nat-sources-text a:hover{text-decoration:underline;}

/* ── FOOTER ── */
.nat-footer{background:#1b3a6b;margin-top:60px;padding:36px 24px 44px;}
.nat-footer-inner{max-width:1100px;margin:0 auto;font-family:'Nunito',sans-serif;font-size:12.5px;color:rgba(255,255,255,0.45);line-height:1.70;}
.nat-footer-inner a{color:rgba(212,168,50,0.80);text-decoration:none;}
.nat-footer-inner a:hover{text-decoration:underline;}
.nat-footer-rule{width:40px;height:2px;background:#b8860b;border-radius:2px;margin-bottom:14px;}
</style>
<% end %>

<%# ── HERO ── %>
<div class="nat-hero">
  <div class="nat-inner">
    <div class="nat-breadcrumb">
      <%= link_to "fora.center", root_path %> ›
      <span>usa</span> ›
      <span>The Jihad Tax</span>
    </div>
    <div class="nat-eyebrow">Islamic Jihad Cost Database · National</div>
    <h1 class="nat-title">The <em>Jihad</em> Tax</h1>
    <p class="nat-subtitle">
      How much has the United States spent since September 11, 2001 on
      anti-terrorism — across DOD, DHS, DOE, USPS, Justice, and the
      intelligence community — and what did we actually buy?
    </p>
    <div class="nat-rule"></div>
  </div>
</div>

<%# ── CAVEAT BANNER ── %>
<div class="nat-caveat-wrap">
  <div class="nat-caveat">
    <i class="ti ti-alert-triangle"></i>
    <p class="nat-caveat-text">
      <strong style="color:rgba(255,255,255,0.65);">Methodology note:</strong>
      The U.S. does not have a single authoritative counter-terrorism spending figure.
      The estimates here draw from the Stimson Center (2018), Brown University's Costs
      of War project, and Congressional Budget Office data. Classified spending is not
      fully reflected. All figures are nominal, not inflation-adjusted, unless noted.
    </p>
  </div>
</div>

<%# ── FORA EDITORIAL DISCLOSURE ── %>
<div class="nat-fora-wrap">
  <div class="nat-fora-banner">
    <i class="ti ti-alert-circle"></i>
    <p class="nat-fora-text">
      <strong>FORA editorial framework:</strong>
      The 3,800+ deaths figure applies an expanded methodology.
      Persons enslaved during Islamic-connected maritime raids — beginning with the
      <em>Little James</em> (1627) — are counted as deaths. This is a deliberate departure
      from standard counter-terrorism databases, reflecting FORA's editorial position that
      slavery is a form of death. Standard databases (NAF, GTD) begin their count at 9/11.
    </p>
  </div>
</div>

<%# ── STAT CARDS ── %>
<div class="nat-stats-section">
  <div class="nat-stats-grid">
    <% @stats.each do |s| %>
      <div class="nat-stat-card<%= ' red' if s[:color] == 'red' %><%= ' is-clickable' if s[:modal_id] %>"
           <% if s[:modal_id] %>data-modal="<%= s[:modal_id] %>"<% end %>>
        <div class="nat-stat-eyebrow">◆ <%= s[:label] %></div>
        <div class="nat-stat-value"><%= s[:value] %></div>
        <div class="nat-stat-sub"><%= s[:sub] %></div>
      </div>
    <% end %>
  </div>
</div>

<%# ── CITY LINK STRIP ── %>
<div class="nat-city-strip">
  <div class="nat-city-strip-inner">
    <span class="nat-city-lbl">City breakdown →</span>
    <%= link_to "Philadelphia", city_ijdb_path(city: "philadelphia"), class: "nat-city-link" %>
    <span class="nat-city-soon">New York · Chicago · Los Angeles — coming soon</span>
  </div>
</div>

<%# ── AGENCY BREAKDOWN ── %>
<%
  agency_display = {
    "DOD/OCO"             => { name: "DOD — Overseas Contingency Ops",           desc: "Afghanistan, Iraq, Syria war funding; ATFP bases",            est: false },
    "VA"                  => { name: "Veterans Administration",                   desc: "Post-9/11 veteran care, disability, mental health",           est: false },
    "DHS"                 => { name: "DHS — Entire department",                   desc: "TSA, CBP, FEMA, Secret Service, Coast Guard, CISA",          est: false },
    "Treasury/Interest"   => { name: "Debt interest on CT spending",              desc: "These wars were funded entirely through borrowing",           est: false, prefix: ">" },
    "DOD/Base"            => { name: "DOD — Base budget increase",                desc: "Pentagon baseline above pre-9/11 trajectory",                est: false },
    "IC/ODNI"             => { name: "Intelligence Community (ODNI / NSA / CIA)", desc: "National Intelligence Program; SIGINT, HUMINT",              est: true },
    "State/USAID"         => { name: "State Dept / USAID",                        desc: "Anti-Terrorism Assistance (ATA), foreign aid, stabilization", est: false },
    "DOJ/FBI"             => { name: "DOJ / FBI",                                 desc: "JTTF, domestic CT investigations, National Security Division", est: true },
    "DOE/NNSA"            => { name: "DOE — NNSA / Radiological Security",        desc: "Nuclear material security, dirty bomb detection, NEST teams", est: true },
    "HHS/CDC"             => { name: "HHS / CDC — Biodefense",                    desc: "BARDA, SNS stockpile, bioterrorism preparedness",            est: true },
    "USPS/Postal Service" => { name: "USPS — Mail security program",              desc: "BDS network, irradiation, anthrax response & cleanup",       est: true },
  }
  conf_label = { "documented" => "Public", "estimated" => "Public", "partial" => "Partial", "classified" => "Classified" }
  conf_class = { "documented" => "tag-pub", "estimated" => "tag-pub", "partial" => "tag-part", "classified" => "tag-class" }
%>
<div class="nat-section">
  <div class="sec-header" style="margin-bottom:20px">
    <div class="sec-eyebrow"><i class="ti ti-building-bank" style="font-size:13px" aria-hidden="true"></i> Agency breakdown</div>
    <div class="sec-title">Where the money went, 2002–2022</div>
    <div class="sec-sub">Estimated cumulative counter-terrorism spending by federal agency. Classified portions not reflected.</div>
  </div>

  <div class="ag-chart-wrap">
    <div class="ag-donut-wrap">
      <canvas id="agency-donut" aria-label="Donut chart of CT spending by agency" role="img"></canvas>
    </div>
    <div class="ag-legend" id="ag-legend"></div>
  </div>

  <div class="ag-insight">
    <p>The most important visual fact: DOD and VA together account for more than half the total. State Dept, DOJ, DOE, HHS, and USPS combined — the entire civilian counter-terrorism apparatus — are less than 4% of the pie. The war machine dwarfs everything else.</p>
  </div>

  <table class="agency-table" id="agency-table" aria-label="Counter-terrorism spending by agency 2002 to 2022">
    <thead>
      <tr>
        <th>Agency / program</th>
        <th>Est. 2002–2022 spend</th>
        <th>Transparency</th>
      </tr>
    </thead>
    <tbody>
      <% @agency_entries.sort_by { |e| -(e.amount_low_cents || 0) }.each_with_index do |entry, i| %>
        <%
          display    = agency_display[entry.entity_name] || { name: entry.title, desc: entry.description, est: false }
          conf       = entry.confidence
          prefix     = display[:prefix] || "~"
          raw        = entry.formatted_range.to_s.sub(/\A[≥≤~]\s*/, '')
          amount_str = entry.amount_low_cents ? "#{prefix}#{raw}#{display[:est] ? ' est.' : ''}" : nil
        %>
        <tr data-idx="<%= i %>">
          <td>
            <span class="agency-name"><%= display[:name] %></span>
            <span class="agency-desc"><%= display[:desc] %></span>
          </td>
          <td><span class="amount"><%= amount_str %></span></td>
          <td><span class="tag <%= conf_class[conf] %>"><%= conf_label[conf] || conf.capitalize %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<script>
(function () {
  var AGENCIES = [
    { name: "DOD — Overseas Contingency Ops",   short: "DOD / OCO",    amount: "~$2.3T",       pct: 26.9, color: "#185FA5", val: 2300 },
    { name: "Veterans Administration",           short: "VA",           amount: "~$2.2T",       pct: 25.7, color: "#0C447C", val: 2200 },
    { name: "DHS — Entire department",           short: "DHS",          amount: "~$1.1T",       pct: 12.9, color: "#0F6E56", val: 1100 },
    { name: "Debt interest on CT spending",      short: "Debt interest", amount: ">$1T",         pct: 11.7, color: "#A32D2D", val: 1000 },
    { name: "DOD — Base budget increase",        short: "DOD / Base",   amount: "~$900B",       pct: 10.5, color: "#378ADD", val:  900 },
    { name: "Intelligence Community",            short: "Intelligence", amount: "~$700B est.",  pct:  8.2, color: "#888780", val:  700 },
    { name: "State Dept / USAID",                short: "State/USAID",  amount: "~$138B",       pct:  1.6, color: "#1D9E75", val:  138 },
    { name: "DOJ / FBI",                         short: "DOJ/FBI",      amount: "~$100B est.",  pct:  1.2, color: "#5DCAA5", val:  100 },
    { name: "DOE — NNSA / Radiological",         short: "DOE/NNSA",    amount: "~$60B est.",   pct:  0.7, color: "#EF9F27", val:   60 },
    { name: "HHS / CDC — Biodefense",            short: "HHS/CDC",      amount: "~$50B est.",   pct:  0.6, color: "#BA7517", val:   50 },
    { name: "USPS — Mail security",              short: "USPS",         amount: "~$2B est.",    pct:  0.0, color: "#B4B2A9", val:    2 }
  ];

  var selectedIdx = null;

  var centerLabel = {
    id: 'centerLabel',
    afterDraw: function (chart) {
      var ctx = chart.ctx;
      var ca  = chart.chartArea;
      var cx  = (ca.left + ca.right)  / 2;
      var cy  = (ca.top  + ca.bottom) / 2;
      ctx.save();
      ctx.textAlign    = 'center';
      ctx.textBaseline = 'middle';
      if (selectedIdx !== null) {
        var ag = AGENCIES[selectedIdx];
        ctx.fillStyle = '#8a9ab8';
        ctx.font = '500 9px "Nunito",sans-serif';
        ctx.fillText(ag.short, cx, cy - 20);
        ctx.fillStyle = '#1b3a6b';
        ctx.font = 'bold 17px "Libre Baskerville",serif';
        ctx.fillText(ag.amount, cx, cy - 3);
        ctx.fillStyle = '#8a9ab8';
        ctx.font = '10px "JetBrains Mono",monospace';
        ctx.fillText(ag.pct < 0.1 ? '<0.1%' : ag.pct.toFixed(1) + '%', cx, cy + 14);
      } else {
        ctx.fillStyle = '#1b3a6b';
        ctx.font = 'bold 20px "Libre Baskerville",serif';
        ctx.fillText('~$8T', cx, cy - 8);
        ctx.fillStyle = '#8a9ab8';
        ctx.font = '500 10px "Nunito",sans-serif';
        ctx.fillText('2002\u20132022 total', cx, cy + 10);
      }
      ctx.restore();
    }
  };

  var chart = new Chart(document.getElementById('agency-donut'), {
    type: 'doughnut',
    data: {
      datasets: [{
        data:            AGENCIES.map(function (a) { return a.val; }),
        backgroundColor: AGENCIES.map(function (a) { return a.color; }),
        borderWidth:  1.5,
        borderColor:  '#f5f7fb',
        hoverOffset:  0,
        offset:       0
      }]
    },
    options: {
      responsive:        true,
      maintainAspectRatio: true,
      cutout:            '62%',
      animation:         { duration: 500 },
      plugins: {
        legend:  { display: false },
        tooltip: { enabled: false }
      },
      onClick: function (_evt, elements) {
        if (elements.length) { selectAgency(elements[0].index); }
        else { deselect(); }
      }
    },
    plugins: [centerLabel]
  });

  /* ── legend ── */
  var legendEl = document.getElementById('ag-legend');
  AGENCIES.forEach(function (ag, i) {
    var pctStr = ag.pct < 0.1 ? '<0.1%' : ag.pct.toFixed(1) + '%';
    var item = document.createElement('div');
    item.className   = 'ag-legend-item';
    item.dataset.idx = i;
    item.innerHTML   =
      '<span class="ag-legend-color" style="background:' + ag.color + '"></span>' +
      '<span class="ag-legend-name">' + ag.name + '</span>' +
      '<span class="ag-legend-amt">' + ag.amount + ' &nbsp;<span class="ag-legend-pct">' + pctStr + '</span></span>';
    item.addEventListener('click', function () { selectAgency(i); });
    legendEl.appendChild(item);
  });

  /* ── table rows ── */
  document.querySelectorAll('#agency-table tbody tr').forEach(function (tr) {
    tr.addEventListener('click', function () {
      selectAgency(parseInt(tr.dataset.idx, 10));
    });
  });

  /* ── selection ── */
  function selectAgency(idx) {
    selectedIdx = (selectedIdx === idx) ? null : idx;
    applySelection();
  }

  function deselect() {
    selectedIdx = null;
    applySelection();
  }

  function applySelection() {
    chart.data.datasets[0].offset = AGENCIES.map(function (_, i) {
      return i === selectedIdx ? 14 : 0;
    });
    chart.update('none');

    document.querySelectorAll('.ag-legend-item').forEach(function (el, i) {
      el.classList.toggle('is-active', i === selectedIdx);
    });

    document.querySelectorAll('#agency-table tbody tr').forEach(function (tr) {
      tr.classList.toggle('ag-tr-active', parseInt(tr.dataset.idx, 10) === selectedIdx);
    });
  }
}());
</script>

