<%# ── FILTER JS (vanilla only) ───────────────────────────────────────────── %>
<script>
(function () {
  var btns  = document.querySelectorAll('.mc-filter-btn');
  var cards = document.querySelectorAll('.mc-card');

  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      btns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');

      var f = btn.dataset.filter;

      cards.forEach(function (card) {
        var types = card.dataset.types ? card.dataset.types.split(' ') : [];
        card.style.display = (f === 'all' || types.indexOf(f) !== -1) ? '' : 'none';
      });
    });
  });
}());
</script>

<%# ── CHOROPLETH MAP JS ───────────────────────────────────────────────────── %>
<script>
(function () {
  var NAMES = {4:'Afghanistan',12:'Algeria',48:'Bahrain',364:'Iran',368:'Iraq',376:'Israel',400:'Jordan',414:'Kuwait',422:'Lebanon',434:'Libya',504:'Morocco',512:'Oman',586:'Pakistan',634:'Qatar',682:'Saudi Arabia',760:'Syria',788:'Tunisia',792:'Turkey',818:'Egypt',887:'Yemen'};

  var MODES = {
    all: { data: {
