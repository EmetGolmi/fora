<%# ── FILTER JS (vanilla only) ───────────────────────────────────────────── %>
<script>
(function () {
  var btns  = document.querySelectorAll('.mc-filter-btn');
  var cards = document.querySelectorAll('.mc-card');

  btns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      btns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');

      var f = btn.dataset.filter;

      cards.forEach(function (card) {
        var types = card.dataset.types ? card.dataset.types.split(' ') : [];
        card.style.display = (f === 'all' || types.indexOf(f) !== -1) ? '' : 'none';
      });
    });
  });
}());
</script>
