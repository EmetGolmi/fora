<% content_for(:title) { "Israel as Sanctuary · Minority Consent · FORA" } %>

<% content_for :head do %>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}

/* ── HERO ── */
.is-hero{background:var(--blue);padding:48px 24px 44px;position:relative;overflow:hidden;}
.is-hero::after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 75% 50%,rgba(184,134,11,0.12) 0%,transparent 55%);pointer-events:none;}
.is-hero-inner{max-width:1100px;margin:0 auto;position:relative;}
.is-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.28em;text-transform:uppercase;color:#d4a832;margin-bottom:12px;}
.is-title{font-family:'Libre Baskerville',serif;font-size:34px;font-weight:700;color:#ffffff;line-height:1.2;margin-bottom:14px;max-width:720px;}
.is-subhead{font-family:'Nunito',sans-serif;font-size:14.5px;color:rgba(255,255,255,0.62);max-width:660px;line-height:1.78;margin-bottom:24px;}
.is-hero-rule{width:48px;height:3px;background:linear-gradient(to right,#b8860b,#d4a832);border-radius:2px;}

/* ── CONTRAST BANNER ── */
.is-contrast{max-width:1100px;margin:36px auto;padding:0 24px;}
.is-contrast-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.is-contrast-panel{padding:20px 22px;border-radius:8px;}
.is-contrast-lbl{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.22em;text-transform:uppercase;font-weight:700;margin-bottom:10px;}
.is-contrast-text{font-family:'Nunito',sans-serif;font-size:13.5px;line-height:1.72;}
@media(max-width:600px){.is-contrast-grid{grid-template-columns:1fr;}}

/* ── SECTION SHELLS ── */
.is-section{max-width:1100px;margin:0 auto;padding:36px 24px 0;}
.is-section-eyebrow{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.26em;text-transform:uppercase;color:#b8860b;margin-bottom:20px;}

/* ── COMMUNITY CARDS ── */
.is-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:start;}
@media(max-width:940px){.is-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:580px){.is-grid{grid-template-columns:1fr;}}

.is-card{background:#fff;border:1px solid rgba(27,58,107,0.12);border-radius:8px;overflow:hidden;transition:box-shadow 0.15s,transform 0.15s;}
.is-card:hover{box-shadow:0 5px 22px rgba(27,58,107,0.11);transform:translateY(-1px);}
.is-card-bar{height:4px;}
.is-card-body{padding:16px;}
.is-card-num{font-family:'JetBrains Mono',monospace;font-size:8px;letter-spacing:0.14em;text-transform:uppercase;color:#b8860b;margin-bottom:6px;}
.is-card-name{font-family:'Libre Baskerville',serif;font-size:16px;font-weight:700;color:var(--blue);margin-bottom:10px;line-height:1.3;}
.is-card-text{font-family:'Nunito',sans-serif;font-size:13px;color:var(--ink-soft);line-height:1.68;margin-bottom:12px;}
.is-card-img{width:100%;height:120px;object-fit:cover;display:block;border-radius:4px;margin-bottom:12px;}
.is-card-link{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--blue);text-decoration:none;letter-spacing:0.06em;}
.is-card-link:hover{text-decoration:underline;}

/* ── COMPARISON TABLE ── */
.is-table-wrap{overflow-x:auto;margin-top:4px;}
.is-table{width:100%;border-collapse:collapse;font-family:'Nunito',sans-serif;font-size:13px;}
.is-table th{background:var(--blue);color:#fff;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.14em;text-transform:uppercase;padding:11px 14px;text-align:left;border:0.5px solid rgba(255,255,255,0.15);}
.is-table td{padding:12px 14px;vertical-align:top;border:0.5px solid rgba(27,58,107,0.13);line-height:1.6;}
.is-table tr:nth-child(even) td{background:#fafaf8;}
.is-table tr:nth-child(odd) td{background:#fff;}
.is-table .col-home{color:#a32d2d;}
.is-table .col-israel{color:#0f6e56;}
.is-table .col-community{font-weight:700;color:var(--ink);}
.is-table .col-contrast{font-style:italic;color:var(--ink-soft);font-size:12px;}

/* mobile table → cards */
@media(max-width:680px){
  .is-table-wrap{display:none;}
  .is-table-mobile{display:block;}
}
@media(min-width:681px){
  .is-table-mobile{display:none;}
}
.is-table-card{background:#fff;border:1px solid rgba(27,58,107,0.12);border-radius:8px;padding:16px;margin-bottom:12px;}
.is-table-card-community{font-family:'Libre Baskerville',serif;font-size:15px;font-weight:700;color:var(--blue);margin-bottom:10px;}
.is-table-card-row{margin-bottom:8px;}
.is-table-card-lbl{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:3px;}
.is-table-card-val{font-family:'Nunito',sans-serif;font-size:12.5px;line-height:1.6;}

/* ── NUANCE BOX ── */
.is-nuance{max-width:1100px;margin:44px auto 0;padding:0 24px;}
.is-nuance-inner{background:#faeeda;border-left:3px solid #ba7517;border-radius:0 6px 6px 0;padding:20px 24px;}
.is-nuance-lbl{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:#7a4a00;font-weight:700;margin-bottom:10px;}
.is-nuance-text{font-family:'Nunito',sans-serif;font-size:13.5px;color:#4a2f00;line-height:1.76;}
.is-nuance-text p+p{margin-top:10px;}

/* ── BACK LINK ── */
.is-back{text-align:center;margin:48px 0 20px;padding:0 24px;}
.is-back a{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--blue);text-decoration:none;letter-spacing:0.1em;}
.is-back a:hover{text-decoration:underline;}

/* ── FOOTER ── */
.is-footer{background:var(--blue);margin-top:52px;padding:44px 24px 52px;}
.is-footer-inner{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr;gap:40px;align-items:start;}
.is-footer-lbl{font-family:'JetBrains Mono',monospace;font-size:7.5px;letter-spacing:0.22em;text-transform:uppercase;color:#d4a832;margin-bottom:10px;}
.is-footer-text{font-family:'Nunito',sans-serif;font-size:13px;color:rgba(255,255,255,0.55);line-height:1.75;}
.is-footer-text a{color:rgba(212,168,50,0.85);text-decoration:none;}
.is-footer-text a:hover{text-decoration:underline;}
.is-footer-sources ul{list-style:none;}
.is-footer-sources li{margin-bottom:5px;}
.is-footer-sources a{font-family:'Nunito',sans-serif;font-size:12px;color:rgba(255,255,255,0.45);text-decoration:none;transition:color 0.12s;}
.is-footer-sources a:hover{color:rgba(255,255,255,0.8);}
.is-footer-rule{width:40px;height:2px;background:#b8860b;border-radius:2px;margin:22px 0 0;}
@media(max-width:680px){
  .is-title{font-size:24px;}
  .is-footer-inner{grid-template-columns:1fr;}
}
</style>
<% end %>

<%# ── HERO ─────────────────────────────────────────────────────────────── %>
<div class="is-hero">
  <div class="is-hero-inner">
    <div class="is-eyebrow">◆ FORA · MINORITY CONSENT · ISRAEL</div>
    <h1 class="is-title">While neighbors erased their minorities,<br>Israel became their refuge</h1>
    <p class="is-subhead">Israel is the only country in the Middle East where nearly every minority documented at fora.center/mc has a legally protected community, world headquarters, or place of asylum. This is not a political argument. It is a demographic one.</p>
    <div class="is-hero-rule"></div>
  </div>
</div>

<%# ── CONTRAST BANNER ───────────────────────────────────────────────────── %>
<div class="is-contrast">
  <div class="is-contrast-grid">
    <div class="is-contrast-panel" style="background:#fcebeb;border-left:3px solid #a32d2d;">
      <div class="is-contrast-lbl" style="color:#a32d2d;">Across the Region</div>
      <p class="is-contrast-text" style="color:#791f1f;">Bahá'ís executed in Iran. Yazidis genocided in Iraq. Mandaeans near-extinct. Ahmadis criminalized in Pakistan. Gay men hanged in Iran. Druze persecuted in Syria. Girls sold as slaves in Afghanistan — the Taliban has legally codified human slavery.</p>
    </div>
    <div class="is-contrast-panel" style="background:#eaf3de;border-left:3px solid #27500a;">
      <div class="is-contrast-lbl" style="color:#27500a;">In Israel</div>
      <p class="is-contrast-text" style="color:#3b6d11;">Bahá'í World Headquarters in Haifa (UNESCO). 150,000 Druze citizens serving in IDF. Yazidi refugees accepted. Ahmadi mosque operating since 1928. LGBTQ+ asylum granted. Armenians in Jerusalem since 4th century CE. Israel provides sanctuary to communities facing persecution at the hands of jihadist violence and state-enforced religious uniformity.</p>
    </div>
  </div>
</div>

<%# ── COMMUNITY CARDS ───────────────────────────────────────────────────── %>
<div class="is-section">
  <div class="is-section-eyebrow">◆ Community by Community</div>
  <div class="is-grid">
    <% @israel_communities.each do |c| %>
      <%
        color  = c['color'] || '#1b3a6b'
        clight = c['color_light'] || '#e6f1fb'
      %>
      <div class="is-card">
        <div class="is-card-bar" style="background:<%= color %>;"></div>
        <div class="is-card-body">
          <div class="is-card-num">
            #<%= c['number'] %> · <%= c['name'] %>
          </div>
          <div class="is-card-name"><%= c['name'] %></div>
          <% if c['wikimedia_image'] %>
            <img src="<%= c['wikimedia_image'] %>"
                 alt="<%= c['image_caption'] %>"
                 loading="lazy"
                 class="is-card-img"
                 onerror="this.style.display='none'">
          <% end %>
          <p class="is-card-text"><%= c['israel_connection'] %></p>
          <%= link_to "← Read full history at /mc", mc_path, class: "is-card-link" %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# ── COMPARISON TABLE ──────────────────────────────────────────────────── %>
<%
  table_rows = [
    {
      community: "Bahá'í",
      home:      "Iran — executed, imprisoned, banned; faith declared heresy",
      israel:    "World Headquarters on Mount Carmel, Haifa — UNESCO World Heritage Site",
      contrast:  "The faith persecuted in its birthplace governs itself from the country Iran calls its enemy"
    },
    {
      community: "Ahmadi Muslim",
      home:      "Pakistan — constitutionally declared non-Muslim; jailed for saying Assalamu Alaikum",
      israel:    "Legal mosque in Kababir, Haifa — operating since 1928",
      contrast:  "In Pakistan, calling a mosque a mosque is a criminal act. In Israel, their mosque has stood for nearly 100 years."
    },
    {
      community: "Druze",
      home:      "Syria — displaced by civil war; conscripted or fled",
      israel:    "~150,000 full citizens; male Druze serve in IDF by community request; 10× population growth since 1948",
      contrast:  "The same community — thriving in one country, surviving in the other"
    },
    {
      community: "Arab Christian",
      home:      "Iraq −87% since 2003; Syria −35%; Egypt falling share",
      israel:    "~180,000 full citizens; Nazareth thriving; stable",
      contrast:  "The only Arabic-speaking Christian community in the Middle East not in demographic freefall"
    },
    {
      community: "Yazidi",
      home:      "Iraq/Syria — UN-recognised genocide 2014; 5,000 men killed in one day",
      israel:    "Refugees accepted; genocide formally recognised while Arab League was silent",
      contrast:  "Israel among first states in region to name what happened to Yazidis"
    },
    {
      community: "Armenian",
      home:      "Turkey — genocide denied; Ecumenical Patriarchate under pressure; community of 3,000",
      israel:    "Jerusalem Armenian Quarter continuously inhabited since 4th century CE",
      contrast:  "The quarter predates Islam, the Ottoman Empire, and the modern Turkish state"
    },
    {
      community: "Circassian",
      home:      "Russia — genocide of 1864 never recognized; diaspora language endangered",
      israel:    "~5,000 full citizens in Kfar Kama and Rehaniya; IDF service; language preserved",
      contrast:  "Circassian identity more protected in Israel than in much of the global diaspora"
    },
    {
      community: "Mandaean",
      home:      "Iraq — 93% collapse since 2003; UN declared existential threat 2007",
      israel:    "Small community able to perform river baptism (masbuta) in natural waterways",
      contrast:  "Their most sacred ritual — forbidden by geography in diaspora cities — is possible here"
    },
    {
      community: "Sexual & gender minorities",
      home:      "Iran — death penalty; Saudi Arabia — death penalty; 11 MENA states criminalize",
      israel:    "Fully legal; Tel Aviv Pride annual; LGBTQ+ asylum granted to Iranians, Palestinians, Egyptians, Syrians",
      contrast:  "The only country in the Middle East where being who you are is not a crime"
    },
  ]
%>
<div class="is-section" style="margin-top:48px;">
  <div class="is-section-eyebrow">◆ The Regional Comparison</div>

  <%# Desktop table %>
  <div class="is-table-wrap">
    <table class="is-table">
      <thead>
        <tr>
          <th style="width:13%;">Community</th>
          <th style="width:29%;">Status in home country</th>
          <th style="width:29%;">Status in Israel</th>
          <th style="width:29%;">The contrast</th>
        </tr>
      </thead>
      <tbody>
        <% table_rows.each do |row| %>
          <tr>
            <td class="col-community"><%= row[:community] %></td>
            <td class="col-home"><%= row[:home] %></td>
            <td class="col-israel"><%= row[:israel] %></td>
            <td class="col-contrast"><%= row[:contrast] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Mobile cards %>
  <div class="is-table-mobile">
    <% table_rows.each do |row| %>
      <div class="is-table-card">
        <div class="is-table-card-community"><%= row[:community] %></div>
        <div class="is-table-card-row">
          <div class="is-table-card-lbl" style="color:#a32d2d;">Home country</div>
          <div class="is-table-card-val" style="color:#a32d2d;"><%= row[:home] %></div>
        </div>
        <div class="is-table-card-row">
          <div class="is-table-card-lbl" style="color:#0f6e56;">In Israel</div>
          <div class="is-table-card-val" style="color:#0f6e56;"><%= row[:israel] %></div>
        </div>
        <div class="is-table-card-row" style="margin-bottom:0;">
          <div class="is-table-card-lbl" style="color:var(--ink-mut);">The contrast</div>
          <div class="is-table-card-val" style="color:var(--ink-soft);font-style:italic;"><%= row[:contrast] %></div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%# ── NUANCE BOX ─────────────────────────────────────────────────────────── %>
<div class="is-nuance">
  <div class="is-nuance-inner">
    <div class="is-nuance-lbl">◆ Nuance worth including</div>
    <div class="is-nuance-text">
      <p>Israel's minority protections are real but imperfect. Druze communities face budget discrimination and have launched protests demanding equal treatment. Bedouin villages face demolition orders in the Negev. Arab citizens face structural inequalities in land allocation and public funding. The 2018 Nation-State Basic Law downgraded Arabic from official to 'special status.' The European Court of Human Rights has ruled against Israel on minority rights issues.</p>
      <p>The argument on this page is not that Israel is perfect. It is that Israel is the regional exception to a 75-year pattern of erasure — and that this exception is documented, measurable, and significant.</p>
    </div>
  </div>
</div>

<%# ── BACK LINK ──────────────────────────────────────────────────────────── %>
<div class="is-back">
  <%= link_to "← Back to Minority Consent (fora.center/mc)", mc_path %>
</div>

<%# ── FOOTER ─────────────────────────────────────────────────────────────── %>
<footer class="is-footer">
  <div class="is-footer-inner">

    <div>
      <div class="is-footer-lbl">◆ About this page</div>
      <p class="is-footer-text">
        This page draws on demographic data from the community profiles at <a href="<%= mc_path %>">fora.center/mc</a> — 24 minority communities in the Middle East and Central Asia. Israel connection data was compiled from academic sources, NGO reports, and community organization records. The comparison table uses documented, verifiable status in each country as of 2024–2025.
      </p>
      <div class="is-footer-rule"></div>
    </div>

    <div class="is-footer-sources">
      <div class="is-footer-lbl">◆ Sources</div>
      <ul>
        <li><a href="https://www.minorityrights.org" target="_blank" rel="noopener">Minority Rights Group International</a></li>
        <li><a href="https://www.cbs.gov.il" target="_blank" rel="noopener">Israeli Central Bureau of Statistics 2024</a></li>
        <li><a href="https://www.bahai.org/the-bahai-world-centre" target="_blank" rel="noopener">Bahá'í World Centre — Haifa</a></li>
        <li><a href="https://www.pewresearch.org" target="_blank" rel="noopener">Pew Research — religious minorities</a></li>
        <li><a href="https://www.ilga.org" target="_blank" rel="noopener">ILGA World — sexual orientation laws</a></li>
        <li><a href="https://www.timesofisrael.com" target="_blank" rel="noopener">Times of Israel — community reporting</a></li>
        <li><a href="https://bahaipedia.org" target="_blank" rel="noopener">Bahaipedia — institutional history</a></li>
      </ul>
    </div>

  </div>
</footer>
