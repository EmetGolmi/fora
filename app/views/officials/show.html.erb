<% content_for(:title) { "#{@member['directOrderName']} — FORA" } %>

<div style="background: #1b2a4a; color: #fff; padding: 40px 20px;">
  <div style="max-width: 800px; margin: 0 auto; display: flex; align-items: center; gap: 24px;">
    <% if @member.dig("depiction", "imageUrl") %>
      <img src="<%= @member.dig('depiction', 'imageUrl') %>"
           alt="<%= @member['directOrderName'] %>"
           style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 3px solid #fff;">
    <% end %>
    <div>
      <h1 style="margin: 0 0 8px;"><%= @member["directOrderName"] %></h1>
      <p style="margin: 0 0 8px; font-size: 18px; opacity: 0.9;">
        <% last_term = @member.dig("terms")&.last || {} %>
        <% if last_term["chamber"] == "Senate" %>
          U.S. Senator, Pennsylvania
        <% else %>
          U.S. Representative, Congressional District <%= last_term["district"] %>
        <% end %>
      </p>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <span style="background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 12px; font-size: 14px;">
          <%= @member["partyName"] %>
        </span>
        <% if last_term["district"] %>
          <span style="background: rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 12px; font-size: 14px;">
            District <%= last_term["district"] %>
          </span>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div style="max-width: 800px; margin: 0 auto; padding: 20px;">
  <p><%= link_to "← Back to Dashboard", "javascript:history.back()" %></p>

  <% has_social = [@social[:twitter], @social[:facebook], @social[:instagram], @social[:youtube], @social[:tiktok], @social[:website]].any?(&:present?) %>
  <% if has_social %>
    <h3 style="margin-bottom: 12px;">Contact & Social Media</h3>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 2em; align-items: center;">

      <% if @social[:website].present? %>
        <a href="<%= @social[:website] %>" target="_blank" rel="noopener" title="Official Website"
           style="display:flex; align-items:center; gap:6px; color: #1b2a4a; text-decoration:none; padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Official Site
        </a>
      <% end %>

      <% if @social[:twitter].present? %>
        <a href="https://x.com/<%= @social[:twitter] %>" target="_blank" rel="noopener" title="X (Twitter)"
           style="display:flex; align-items:center; gap:6px; color: #1b2a4a; text-decoration:none; padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X
        </a>
      <% end %>

      <% if @social[:facebook].present? %>
        <a href="https://facebook.com/<%= @social[:facebook] %>" target="_blank" rel="noopener" title="Facebook"
           style="display:flex; align-items:center; gap:6px; color: #1b2a4a; text-decoration:none; padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
      <% end %>

      <% if @social[:instagram].present? %>
        <a href="https://instagram.com/<%= @social[:instagram] %>" target="_blank" rel="noopener" title="Instagram"
           style="display:flex; align-items:center; gap:6px; color: #1b2a4a; text-decoration:none; padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          Instagram
        </a>
      <% end %>

      <% if @social[:youtube].present? %>
        <a href="https://youtube.com/<%= @social[:youtube] %>" target="_blank" rel="noopener" title="YouTube"
           style="display:flex; align-items:center; gap:6px; color: #1b2a4a; text-decoration:none; padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          YouTube
        </a>
      <% end %>

      <% if @social[:tiktok].present? %>
        <a href="https://tiktok.com/@<%= @social[:tiktok] %>" target="_blank" rel="noopener" title="TikTok"
           style="display:flex; align-items:center; gap:6px; color: #1b2a4a; text-decoration:none; padding: 8px 14px; border: 1px solid #ddd; border-radius: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/></svg>
          TikTok
        </a>
      <% end %>

    </div>
  <% end %>

  <h3 style="margin-bottom: 12px;">Sponsored Legislation</h3>
  <%
    bill_type_labels = {
      "HR" => "H.R.", "S" => "S.", "HJRES" => "H.J.Res.", "SJRES" => "S.J.Res.",
      "HRES" => "H.Res.", "SRES" => "S.Res.", "HCONRES" => "H.Con.Res.", "SCONRES" => "S.Con.Res."
    }
    format_bill_id = ->(bill) {
      type = bill["type"].to_s.upcase
      prefix = bill_type_labels[type] || type
      "#{prefix} #{bill['number']}"
    }
  %>
  <% if @bills.any? %>
    <% @bills.each do |bill| %>
      <div style="margin-bottom: 1.5em; padding: 12px; border: 1px solid #ddd; border-radius: 8px;">
        <strong><%= format_bill_id.call(bill) %></strong> — <%= bill["title"] %>
        <br>
        <small style="color: #666;">
          <% if bill.dig("latestAction", "text") %>
            <%= bill.dig("latestAction", "text") %>
          <% end %>
          <% if bill.dig("latestAction", "actionDate") %>
            | <%= bill.dig("latestAction", "actionDate") %>
          <% end %>
        </small>
      </div>
    <% end %>
  <% else %>
    <p>No sponsored legislation found.</p>
  <% end %>
</div>
