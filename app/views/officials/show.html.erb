<% content_for(:title) { "#{@member['directOrderName']} — FORA" } %>

<% content_for :head do %>
<style>
  /* ── Mobile animations ── */
  @keyframes foil-shift {
    0%   { background-position: -200% center; }
    100% { background-position:  200% center; }
  }
  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .mob-ticker-track {
    display: inline-flex;
    white-space: nowrap;
    animation: ticker-scroll 28s linear infinite;
  }

  .mob-foil {
    background: linear-gradient(105deg,
      rgba(255,255,255,0)     0%,
      rgba(184,134,11,.08)   25%,
      rgba(255,255,255,.14)  50%,
      rgba(184,134,11,.06)   75%,
      rgba(255,255,255,0)   100%);
    background-size: 200% auto;
    animation: foil-shift 4s ease-in-out infinite;
    pointer-events: none;
  }
  /* ── Mobile modals ── */
  .mob-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.55);
    z-index: 100;
    align-items: flex-end;
    justify-content: center;
  }
  .mob-modal.open { display: flex; }
  .mob-sheet {
    background: white;
    border-radius: 16px 16px 0 0;
    padding: 20px 18px 32px;
    width: 100%;
    max-height: 75vh;
    overflow-y: auto;
  }
  .mob-handle {
    width: 36px; height: 4px;
    background: rgba(0,0,0,.12);
    border-radius: 2px;
    margin: 0 auto 16px;
  }
  .mob-got-it {
    font-family: 'JetBrains Mono', monospace;
    font-size: 8px; letter-spacing: .14em; text-transform: uppercase;
    color: white; background: #1b3a6b; border: none;
    border-radius: 100px; padding: 12px; cursor: pointer; width: 100%;
  }
</style>
<% end %>

<%
  # Nil guards for thread-assigned variables — any thread failure leaves these nil
  @bills          ||= []
  @bill_id_map    ||= {}
  @bills_active   ||= []
  @bills_resolved ||= []
  @committees     ||= []
  @news_articles  ||= []
  @wiki_photo     ||= nil
  @social         ||= {}
  @fec_total_raised ||= nil
  @fec_cycle        ||= nil
  @missed_votes_pct  ||= nil
  @party_vote_pct    ||= nil
  @top_pacs     ||= []
  @recent_votes ||= []

  last_term = @member.dig("terms")&.last || {}
  is_senator = last_term["chamber"] == "Senate"
  office_title = if is_senator
    "U.S. Senator · Pennsylvania"
  else
    "U.S. Representative · Congressional District #{last_term['district']}"
  end

  bill_type_labels = {
    "HR" => "H.R.", "S" => "S.", "HJRES" => "H.J.Res.", "SJRES" => "S.J.Res.",
    "HRES" => "H.Res.", "SRES" => "S.Res.", "HCONRES" => "H.Con.Res.", "SCONRES" => "S.Con.Res."
  }
  format_bill_id = ->(bill) {
    type   = bill["type"].to_s.upcase
    prefix = bill_type_labels[type] || type
    "#{prefix} #{bill['number']}"
  }

  party_raw = (@member["partyName"] || @member["partyHistory"]&.last&.dig("partyName") || "").strip
  party_tag_style = case party_raw
    when /Democrat/i   then "background:rgba(29,78,216,0.2); border-color:rgba(59,130,246,0.4); color:#93c5fd;"
    when /Republican/i then "background:rgba(139,26,26,0.2); border-color:rgba(239,68,68,0.35); color:#fca5a5;"
    else                    "background:rgba(255,255,255,0.07); border-color:rgba(255,255,255,0.18); color:rgba(255,255,255,0.6);"
    end

  party_bar_color = case party_raw
    when /Democrat/i   then "#003087"
    when /Republican/i then "#B22234"
    else                    "#5a6e8a"
    end

  bills_count   = @bills.size
  name_initials = @member['directOrderName'].to_s.split.map(&:first).first(2).join
  votes_cast    = @member["totalVotingRecords"].presence || "—"
  estimated_votes = if @member["totalVotingRecords"].present?
    @member["totalVotingRecords"].to_s
  elsif @missed_votes_pct && is_senator
    "~#{((1 - @missed_votes_pct / 100.0) * 1400).round} of ~1,400"
  else
    "—"
  end
%>


<!-- ══════════════════════════════════════════
     DESKTOP LAYOUT
══════════════════════════════════════════ -->
<div class="desktop-profile">

  <%# News ticker %>
  <% if @news_articles.any? %>
  <div class="dp-ticker">
    <span class="dp-ticker-label">★ News</span>
    <div class="dp-ticker-overflow">
      <div class="dp-ticker-track">
        <% (@news_articles + @news_articles).each do |a| %>
          <span class="dp-ticker-item">★ &nbsp;<%= a['title'] %></span>
        <% end %>
      </div>
    </div>
  </div>
  <% end %>

  <%# Hero %>
  <div class="dp-hero">
    <div style="position:absolute; right:-40px; top:-60px; width:340px; height:340px; border-radius:50%; border:36px solid rgba(255,255,255,0.025); pointer-events:none;"></div>
    <div style="position:absolute; right:40px; top:-20px; width:200px; height:200px; border-radius:50%; border:1px solid rgba(184,134,11,0.15); pointer-events:none;"></div>

    <div class="dp-hero-inner">
      <a href="javascript:history.back()" class="dp-hero-back">← My Government</a>

      <div class="dp-hero-identity">
        <div class="dp-avatar">
          <% desk_photo = @wiki_photo.presence || @member.dig("depiction", "imageUrl") %>
          <% if desk_photo %>
            <img src="<%= desk_photo %>" alt="<%= @member['directOrderName'] %>">
          <% else %>
            <div class="dp-avatar-initials"><%= name_initials %></div>
          <% end %>
          <div class="dp-avatar-badge">✓</div>
        </div>

        <div>
          <h1 class="dp-name"><%= @member["directOrderName"] %></h1>
          <p class="dp-office-title"><%= office_title %></p>
          <div class="dp-tags">
            <% if party_raw.present? %>
              <span class="dp-tag" style="<%= party_tag_style %>"><%= party_raw %></span>
            <% end %>
            <% if !is_senator && last_term["district"].present? %>
              <span class="dp-tag" style="border-color:rgba(255,255,255,0.15); background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.5);">District <%= last_term['district'] %></span>
            <% end %>
          </div>
          <div class="dp-social">
            <% if @social_handles[:website].present? %>
              <a href="<%= @social_handles[:website] %>" target="_blank" rel="noopener" class="dp-social-link" title="Official Website">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </a>
            <% end %>
            <% if @social_handles[:x].present? %>
              <a href="https://x.com/<%= @social_handles[:x] %>" target="_blank" rel="noopener" class="dp-social-link" title="X / Twitter">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            <% end %>
            <% if @social_handles[:instagram].present? %>
              <a href="https://instagram.com/<%= @social_handles[:instagram] %>" target="_blank" rel="noopener" class="dp-social-link" title="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
              </a>
            <% end %>
            <% if @social_handles[:youtube].present? %>
              <a href="https://youtube.com/<%= @social_handles[:youtube] %>" target="_blank" rel="noopener" class="dp-social-link" title="YouTube">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            <% end %>
            <button onclick="dpShare()" class="dp-social-link" style="background:none;border:none;cursor:pointer;padding:0;line-height:0;" title="Share this profile">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:rgba(255,255,255,0.55);"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
      </div>

      <%# Stat bar %>
      <div class="dp-stat-bar">
        <div class="dp-stat" onclick="dpOpenModal('attendance')">
          <span class="dp-stat-info">ⓘ</span>
          <div class="dp-stat-value"><%= @missed_votes_pct ? "#{(100 - @missed_votes_pct).round(1)}%" : "—" %></div>
          <div class="dp-stat-label">Attendance</div>
        </div>
        <div class="dp-stat" onclick="dpOpenModal('party')">
          <span class="dp-stat-info">ⓘ</span>
          <div class="dp-stat-value"><%= @party_vote_pct ? "#{@party_vote_pct.round(1)}%" : "—" %></div>
          <div class="dp-stat-label">Party-Line</div>
        </div>
        <div class="dp-stat" onclick="dpOpenModal('bills')">
          <span class="dp-stat-info">ⓘ</span>
          <div class="dp-stat-value"><%= bills_count %></div>
          <div class="dp-stat-label">Bills Sponsored</div>
        </div>
        <% if @finance %>
        <div class="dp-stat" onclick="dpOpenModal('finance')">
          <span class="dp-stat-info">ⓘ</span>
          <%
            dp_raised = @finance.total_raised_cents.to_i
            dp_raised_fmt = dp_raised >= 1_000_000 ? "$#{(dp_raised/1_000_000.0).round(1)}M" :
                            dp_raised >= 1_000 ? "$#{(dp_raised/1_000.0).round(0).to_i}K" : "$#{dp_raised}"
          %>
          <div class="dp-stat-value"><%= dp_raised_fmt %></div>
          <div class="dp-stat-label">Campaign Raised</div>
        </div>
        <% end %>
        <div class="dp-stat" onclick="dpOpenModal('committees')">
          <span class="dp-stat-info">ⓘ</span>
          <div class="dp-stat-value"><%= @committees.size %></div>
          <div class="dp-stat-label">Committees</div>
        </div>
      </div>
    </div><!-- /dp-hero-inner -->

    <div class="dp-stars">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>
  </div><!-- /dp-hero -->

  <%# Body %>
  <div style="background:#f2f4f8; padding:1px 0;">
    <div class="dp-body">

      <%# ── MAIN COLUMN ── %>
      <div class="dp-main">

        <%# Sponsored Legislation %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Sponsored Legislation</div>
          <h2 class="dp-section-title">Bills <span style="font-size:13px; font-weight:400; color:#8a9ab8; font-family:'JetBrains Mono',monospace; letter-spacing:0.06em;"><%= bills_count %> total</span></h2>
          <% if @bills.any? %>
            <% @bills.each do |bill| %>
              <%= render "shared/bill_card", bill: bill, bill_id: @bill_id_map[format_bill_id.call(bill)], show_action_badge: false %>
            <% end %>
          <% else %>
            <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#8a9ab8; padding:24px 0; text-align:center;">No sponsored legislation found.</p>
          <% end %>
        </div>

        <%# Attendance & Voting %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Voting Record</div>
          <h2 class="dp-section-title">Attendance &amp; Party-Line <sup style="font-size:10px; color:#b8860b;">*</sup></h2>
          <div class="dp-stat-cards">
            <div class="dp-stat-card">
              <div class="dp-stat-card-title">Attendance</div>
              <div class="dp-stat-card-row">
                <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;">Attendance Rate</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;"><%= @missed_votes_pct ? "#{(100 - @missed_votes_pct).round(1)}%" : "—" %></span>
              </div>
              <div class="dp-stat-card-row">
                <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;">Missed Votes</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;"><%= @missed_votes_pct ? "#{@missed_votes_pct.round(1)}%" : "—" %></span>
              </div>
              <div class="dp-stat-card-row">
                <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;">Votes Cast (est.)</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;"><%= estimated_votes %></span>
              </div>
              <div class="dp-stat-card-row">
                <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;">Chamber Average</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;">—</span>
              </div>
            </div>
            <div class="dp-stat-card">
              <div class="dp-stat-card-title">Party-Line Voting</div>
              <div class="dp-stat-card-row">
                <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;">With Party</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;"><%= @party_vote_pct ? "#{@party_vote_pct.round(1)}%" : "—" %></span>
              </div>
              <div class="dp-stat-card-row">
                <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;">Independent Votes</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;"><%= @party_vote_pct ? "#{(100 - @party_vote_pct).round(1)}%" : "—" %></span>
              </div>
              <div class="dp-stat-card-row">
                <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;">Chamber Average</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;">—</span>
              </div>
            </div>
          </div>
          <% if @recent_votes.any? %>
            <div style="margin-top:18px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.14em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">Recent Votes <sup>*</sup></div>
              <% @recent_votes.each do |v| %>
                <% v_pill_color = {"Yea"=>"#27500A","Nay"=>"#7a1515","Not Voting"=>"#633806"}[v[:position]] || "#5a6e8a" %>
                <% v_pill_bg    = {"Yea"=>"rgba(39,80,10,.1)","Nay"=>"rgba(122,21,21,.08)","Not Voting"=>"rgba(99,56,6,.1)"}[v[:position]] || "rgba(0,0,0,.06)" %>
                <div style="background:white; border:1px solid rgba(27,58,107,0.07); border-radius:8px; padding:10px 14px; margin-bottom:6px; display:flex; align-items:center; justify-content:space-between; gap:12px;">
                  <div>
                    <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#1b3a6b; line-height:1.35;"><%= v[:bill] %></div>
                    <div style="font-family:'JetBrains Mono',monospace; font-size:8px; color:#8a9ab8; margin-top:2px;"><%= v[:date] %></div>
                  </div>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:7.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:<%= v_pill_color %>; background:<%= v_pill_bg %>; border-radius:100px; padding:4px 10px; white-space:nowrap;"><%= v[:position] %></span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Campaign Finance %>
        <% if @finance.present? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Campaign Finance</div>
          <h2 class="dp-section-title">Cost of Getting the Message Out</h2>
          <%= render "officials/finance_summary", finance: @finance %>
        </div>
        <% end %>

        <%# Q&A %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Community</div>
          <h2 class="dp-section-title">Q&amp;A</h2>
          <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:32px; text-align:center;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:8px;">Coming Soon</div>
            <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#5a6e8a; line-height:1.6; margin:0;">Ask questions about this official's record, votes, and positions.</p>
          </div>
        </div>

        <%# Data Note %>
        <div style="border-top:1px solid #e0e5ef; padding-top:14px; margin-top:4px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#b8860b; margin-bottom:5px;">◆ Data Note</div>
          <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#8a9ab8; line-height:1.6; margin:0;">Statistics marked * are hardcoded as of March 2026. Live data connections for state officials are in progress. Sources: PA General Assembly, governor.pa.gov, OpenStates.</p>
        </div>

      </div><!-- /dp-main -->

      <%# ── SIDEBAR ── %>
      <div class="dp-sidebar">

        <%# Contact %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Contact</div>
          <% if @member.dig("addressInformation","officeAddress").present? %>
            <div class="dp-card-entry">
              <div class="dp-card-sublabel">Office</div>
              <div class="dp-card-text"><%= @member.dig("addressInformation","officeAddress") %></div>
            </div>
          <% end %>
          <% if @member.dig("addressInformation","phoneNumber").present? %>
            <div class="dp-card-entry">
              <div class="dp-card-sublabel">Phone</div>
              <a href="tel:<%= @member.dig('addressInformation','phoneNumber') %>" style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#1b3a6b; text-decoration:none;"><%= @member.dig("addressInformation","phoneNumber") %></a>
            </div>
          <% end %>
          <% if @social_handles[:website].present? %>
            <div class="dp-card-entry">
              <div class="dp-card-sublabel">Website</div>
              <a href="<%= @social_handles[:website] %>" target="_blank" rel="noopener" class="dp-card-text" style="text-decoration:underline; text-underline-offset:2px; word-break:break-all;"><%= @social_handles[:website].gsub(/^https?:\/\//, '').chomp('/') %></a>
            </div>
          <% end %>
          <% if [@member.dig("addressInformation","officeAddress"), @member.dig("addressInformation","phoneNumber"), @social_handles[:website]].none?(&:present?) %>
            <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#8a9ab8; margin:0;">Contact info coming soon.</p>
          <% end %>
        </div>

        <%# Committees %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Committees</div>
          <% if @committees.present? %>
            <% @committees.each do |committee| %>
              <div class="dp-card-entry">
                <% if committee[:role].present? %>
                  <div class="dp-card-sublabel"><%= committee[:role] %></div>
                <% end %>
                <div class="dp-card-text"><%= committee[:name] %></div>
              </div>
            <% end %>
          <% else %>
            <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#8a9ab8; margin:0;">Committee assignments coming soon.</p>
          <% end %>
        </div>

        <%# Donors & Lobbyists card %>
        <% fmt_money = ->(amt) { amt >= 1_000_000 ? "$#{(amt/1_000_000.0).round(1)}M" : amt >= 1_000 ? "$#{(amt/1_000.0).round(0).to_i}K" : "$#{amt.to_i}" } %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Donors &amp; Lobbyists</div>

          <%# Top PAC Contributors %>
          <div>
            <% if @top_pacs.any? %>
              <% pac_max = @top_pacs.first[:total].to_f; pac_max = 1.0 if pac_max.zero? %>
              <% @top_pacs.each do |pac| %>
                <div style="margin-bottom:6px;">
                  <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:2px;">
                    <span style="font-family:'Nunito',sans-serif; font-size:9.5px; color:#1b3a6b; line-height:1.3; max-width:72%; overflow-wrap:break-word;"><%= pac[:name] %></span>
                    <span style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#b8860b; white-space:nowrap;"><%= fmt_money.call(pac[:total]) %></span>
                  </div>
                  <div style="height:3px; background:#eef0f3; border-radius:2px; overflow:hidden;">
                    <div style="width:<%= [(pac[:total] / pac_max * 100).round, 100].min %>%; height:100%; background:#b8860b; border-radius:2px;"></div>
                  </div>
                </div>
              <% end %>
              <div style="font-family:'JetBrains Mono',monospace; font-size:6px; color:#b0b8c8; margin-top:4px;">Source: FEC · <a href="https://www.fec.gov" target="_blank" rel="noopener" style="color:#b0b8c8;">fec.gov ↗</a></div>
            <% else %>
              <p style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; margin:0;">Data unavailable · <a href="https://www.fec.gov" target="_blank" rel="noopener" style="color:#8a9ab8;">fec.gov ↗</a></p>
            <% end %>
          </div>
        </div>

        <%# Recent Legislation %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Recent Legislation</div>
          <% if @bills.any? %>
            <% @bills.first(10).each do |bill| %>
              <div class="dp-card-entry">
                <div class="dp-card-sublabel"><%= format_bill_id.call(bill) %></div>
                <div class="dp-card-text" style="line-height:1.35;">
                  <% bill_path = @bill_id_map[format_bill_id.call(bill)] ? bill_path(@bill_id_map[format_bill_id.call(bill)]) : nil %>
                  <% if bill_path %>
                    <a href="<%= bill_path %>" style="color:#1b3a6b; text-decoration:underline; text-underline-offset:2px;"><%= bill["title"].to_s.truncate(80) %></a>
                  <% else %>
                    <%= bill["title"].to_s.truncate(80) %>
                  <% end %>
                </div>
                <% action_text = bill.dig("latestAction","text").to_s %>
                <% if action_text.present? %>
                  <div style="font-family:'JetBrains Mono',monospace; font-size:6px; color:#8a9ab8; margin-top:3px;"><%= action_text.truncate(60) %></div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#8a9ab8; margin:0;">No sponsored legislation found.</p>
          <% end %>
        </div>

      </div><!-- /dp-sidebar -->
    </div><!-- /dp-body -->
  </div>

  <%# Desktop modal overlay %>
  <div id="dp-modal" class="dp-modal" onclick="if(event.target===this)dpCloseModal()">
    <div class="dp-modal-box">
      <button class="dp-modal-close" onclick="dpCloseModal()">×</button>
      <div class="dp-modal-eyebrow" id="dp-modal-eyebrow"></div>
      <h3 class="dp-modal-title" id="dp-modal-title"></h3>
      <div class="dp-modal-body" id="dp-modal-body"></div>
    </div>
  </div>

</div><!-- /desktop-profile -->


<!-- ══════════════════════════════════════════
     MOBILE CARD
══════════════════════════════════════════ -->
<div class="mobile-profile">
<div class="mobile-card">

<%
  party_line_pct = 0.68  # placeholder until real data — Democrat fraction
  party_raw = (@member["partyName"] || @member["partyHistory"]&.last&.dig("partyName") || "").strip
  if party_raw =~ /Democrat/i
    party_r, party_g, party_b = 0, 48, 135      # #003087
    opp_r,   opp_g,   opp_b   = 178, 34, 52     # #B22234
  elsif party_raw =~ /Republican/i
    party_r, party_g, party_b = 178, 34, 52     # #B22234
    opp_r,   opp_g,   opp_b   = 0, 48, 135      # #003087
    party_line_pct = 0.68
  else
    party_r, party_g, party_b = 27, 58, 107     # #1b3a6b neutral
    opp_r,   opp_g,   opp_b   = 27, 58, 107
  end
  # blend_color represents the official's actual voting record — party_line_pct fraction toward their party color, remainder toward opposition
  blend_r = ((party_r * party_line_pct) + (opp_r * (1 - party_line_pct))).round
  blend_g = ((party_g * party_line_pct) + (opp_g * (1 - party_line_pct))).round
  blend_b = ((party_b * party_line_pct) + (opp_b * (1 - party_line_pct))).round
  blend_color = "rgb(#{blend_r},#{blend_g},#{blend_b})"
  nameplate_color = party_raw =~ /Democrat/i ? "#003087" : (party_raw =~ /Republican/i ? "#8B0000" : "#1b3a6b")
%>

  <!-- ─────────────────────────────────────
       SECTION 1 · CARD FRONT
  ───────────────────────────────────────── -->
  <div style="background:#1b3a6b; position:relative; overflow:hidden;">

    <!-- Photo zone -->
    <div style="height:260px; overflow:hidden; position:relative;">
      <% congress_img = @member.dig("depiction","imageUrl")&.gsub('_200.jpg', '.jpg') %>
      <% mob_photo = @wiki_photo.presence || congress_img %>
      <% if mob_photo %>
        <img src="<%= mob_photo %>" alt="" style="width:100%; height:100%; object-fit:cover; object-position:50% 15%; display:block;">
      <% else %>
        <div style="width:100%; height:100%; background:linear-gradient(135deg,#254f92,#1b3a6b); display:flex; align-items:center; justify-content:center; font-family:'Libre Baskerville',serif; font-size:52px; font-weight:700; color:#d4a832;"><%= name_initials %></div>
      <% end %>
      <!-- Fade gradient -->
      <div style="position:absolute; bottom:0; left:0; right:0; height:90px; background:linear-gradient(to bottom,transparent,#0a1220); pointer-events:none;"></div>
      <!-- Foil shimmer -->
      <div class="mob-foil" style="position:absolute; inset:0;"></div>
      <% if @news_articles&.any? %>
        <!-- News ticker -->
        <div style="position:absolute; bottom:0; left:0; right:0; height:20px; overflow:hidden; background:rgba(0,0,0,.35); z-index:3;">
          <div class="mob-ticker-track">
            <% ticker_items = (@news_articles + @news_articles).map { |a| "NEWS · #{a['title']}" } %>
            <% ticker_items.each do |item| %>
              <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.1em; color:#d4a832; padding:0 24px; line-height:20px; display:inline-block;">★ <%= item %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Nameplate -->
    <div style="background:<%= nameplate_color %>; padding:10px 16px 10px 21px; border-bottom:1.5px solid rgba(184,134,11,.3);">
      <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:white; line-height:1.2;"><%= @member["directOrderName"] %></div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; text-transform:uppercase; letter-spacing:.12em; color:#d4a832; margin-top:3px;"><%= office_title %></div>
    </div>

    <!-- Quick stats strip -->
    <div style="background:<%= blend_color %>; display:flex;">
      <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
        <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= votes_cast %></div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Votes Cast</div>
      </div>
      <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
        <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= bills_count %></div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Bills</div>
      </div>
      <div style="flex:1; text-align:center; padding:10px 6px;">
        <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= @party_vote_pct ? "#{@party_vote_pct.round(1)}%" : "—" %></div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Party-Line</div>
      </div>
    </div>

    <!-- Social + Follow row -->
    <div style="background:<%= blend_color %>; padding:8px 14px 8px 21px; display:flex; align-items:center; justify-content:space-between;">
      <div style="display:flex; gap:14px; align-items:center; flex-wrap:wrap;">
        <% if @social[:website].present? %>
          <a href="<%= @social[:website] %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </a>
        <% end %>
        <% if @social[:twitter].present? %>
          <a href="https://x.com/<%= @social[:twitter] %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        <% end %>
        <% if @social[:facebook].present? %>
          <a href="https://facebook.com/<%= @social[:facebook] %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        <% end %>
        <% if @social[:instagram].present? %>
          <a href="https://instagram.com/<%= @social[:instagram] %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
          </a>
        <% end %>
        <% if @social[:youtube].present? %>
          <a href="<%= @social[:youtube] %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        <% end %>
      </div>
      <button onclick="alert('Follow coming soon')" style="background:#b8860b; border:none; border-radius:100px; padding:6px 14px; font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.12em; text-transform:uppercase; color:white; cursor:pointer; display:flex; align-items:center; gap:5px; flex-shrink:0;">
        <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Follow
      </button>
    </div>

    <!-- Star strip -->
    <div style="background:#1b3a6b; padding:7px 16px; font-size:9px; letter-spacing:.4em; color:#b8860b; white-space:nowrap; overflow:hidden; -webkit-mask-image:linear-gradient(to right,black 90%,transparent); mask-image:linear-gradient(to right,black 90%,transparent);">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>

  </div><!-- /card front -->


  <!-- ─────────────────────────────────────
       SECTION 2 · STAT BACK
  ───────────────────────────────────────── -->
  <div style="background:#f2f4f8;">

    <!-- Attendance -->
    <div style="padding:10px 14px; border-bottom:1px solid #e8ebf2;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b;">◆ Attendance</span>
        <button onclick="openModal('modal-attendance')" style="background:none; border:.5px solid #b8860b; border-radius:3px; padding:2px 7px; font-family:'JetBrains Mono',monospace; font-size:6px; letter-spacing:.08em; color:#b8860b; cursor:pointer;">ⓘ info</button>
      </div>
      <% [["Votes Cast", estimated_votes], ["Attendance Rate", @missed_votes_pct ? "#{(100 - @missed_votes_pct).round(1)}%" : "—"], ["Missed", @missed_votes_pct ? "#{@missed_votes_pct.round(1)}%" : "—"], ["#{is_senator ? 'Senate' : 'House'} Avg", "—"]].each do |label, val| %>
        <div style="display:flex; justify-content:space-between; align-items:baseline; padding:3px 0; border-bottom:1px solid #eef0f3;">
          <span style="font-family:'Nunito',sans-serif; font-size:10px; color:#5a6e8a;"><%= label %></span>
          <span style="font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:700; color:#1b3a6b;"><%= val %></span>
        </div>
      <% end %>
    </div>

    <!-- Party-Line -->
    <div style="padding:10px 14px; border-bottom:1px solid #e8ebf2;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b;">◆ Party-Line Voting</span>
        <button onclick="openModal('modal-party')" style="background:none; border:.5px solid #b8860b; border-radius:3px; padding:2px 7px; font-family:'JetBrains Mono',monospace; font-size:6px; letter-spacing:.08em; color:#b8860b; cursor:pointer;">ⓘ info</button>
      </div>
      <% [["With Party", @party_vote_pct ? "#{@party_vote_pct.round(1)}%" : "—"], ["Independent", @party_vote_pct ? "#{(100 - @party_vote_pct).round(1)}%" : "—"], ["#{is_senator ? 'Senate' : 'House'} Average", "—"]].each do |label, val| %>
        <div style="display:flex; justify-content:space-between; align-items:baseline; padding:3px 0; border-bottom:1px solid #eef0f3;">
          <span style="font-family:'Nunito',sans-serif; font-size:10px; color:#5a6e8a;"><%= label %></span>
          <span style="font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:700; color:#1b3a6b;"><%= val %></span>
        </div>
      <% end %>
    </div>

    <!-- Bills -->
    <div style="padding:10px 14px;">
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b;">◆ Bills Sponsored</span>
        <button onclick="openModal('modal-committees')" style="background:none; border:.5px solid #b8860b; border-radius:3px; padding:2px 7px; font-family:'JetBrains Mono',monospace; font-size:6px; letter-spacing:.08em; color:#b8860b; cursor:pointer;">ⓘ info</button>
      </div>
      <% [["This Session", bills_count.to_s], ["Passed into Law", "—"], ["In Committee", "—"]].each do |label, val| %>
        <div style="display:flex; justify-content:space-between; align-items:baseline; padding:3px 0; border-bottom:1px solid #eef0f3;">
          <span style="font-family:'Nunito',sans-serif; font-size:10px; color:#5a6e8a;"><%= label %></span>
          <span style="font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:700; color:#1b3a6b;"><%= val %></span>
        </div>
      <% end %>
    </div>

    <!-- Gilt rule divider -->
    <div style="height:3px; background:linear-gradient(to right,transparent,#b8860b 30%,#d4a832 50%,#b8860b 70%,transparent);"></div>

  </div><!-- /stat back -->


  <!-- ─────────────────────────────────────
       SECTION 3 · PROFILE SECTIONS
  ───────────────────────────────────────── -->
  <div style="background:#f2f4f8;">

    <!-- Active Bills -->
    <div style="padding:12px 14px; border-bottom:1px solid #e8ebf2;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ Sponsored Legislation</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:15px; font-weight:700; color:#1b3a6b; margin:0 0 10px;">Active Bills</h3>
      <% if @bills.any? %>
        <% @bills.each do |bill| %>
          <%= render "shared/bill_card", bill: bill, bill_id: @bill_id_map[format_bill_id.call(bill)], show_action_badge: false %>
        <% end %>
      <% else %>
        <p style="font-family:'Nunito',sans-serif; font-size:12px; color:#8a9ab8; text-align:center; padding:12px 0;">No sponsored legislation found.</p>
      <% end %>
    </div>

    <!-- Voting Record -->
    <div style="padding:12px 14px; border-bottom:1px solid #e8ebf2;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ On the Floor</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:15px; font-weight:700; color:#1b3a6b; margin:0 0 10px;">Recent Votes <sup style="font-size:9px; color:#b8860b;">*</sup></h3>
      <% if @recent_votes.any? %>
        <% @recent_votes.each do |v| %>
          <% m_pill_color = {"Yea"=>"#27500A","Nay"=>"#7a1515","Not Voting"=>"#633806"}[v[:position]] || "#5a6e8a" %>
          <% m_pill_bg    = {"Yea"=>"rgba(39,80,10,.12)","Nay"=>"rgba(122,21,21,.10)","Not Voting"=>"rgba(99,56,6,.10)"}[v[:position]] || "rgba(0,0,0,.06)" %>
          <div style="background:white; border-radius:6px; padding:8px 10px; margin-bottom:6px; display:flex; align-items:center; justify-content:space-between; gap:10px;">
            <div style="flex:1; min-width:0;">
              <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#2d3a50; line-height:1.3;"><%= v[:bill] %></div>
              <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8; margin-top:2px;"><%= v[:date] %></div>
            </div>
            <span style="font-family:'JetBrains Mono',monospace; font-size:7px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:<%= m_pill_color %>; background:<%= m_pill_bg %>; border-radius:100px; padding:3px 8px; white-space:nowrap;"><%= v[:position] %></span>
          </div>
        <% end %>
      <% else %>
        <p style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; text-align:center; padding:4px 0;">Voting history coming soon.</p>
      <% end %>
    </div>

    <!-- Money -->
    <div style="padding:12px 14px; border-bottom:1px solid #e8ebf2;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ Campaign Finance</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:15px; font-weight:700; color:#1b3a6b; margin:0 0 10px;">Cost of Getting the Message Out</h3>
      <% if @finance %>
        <div style="background:white; border-radius:8px; padding:14px 12px; margin-bottom:8px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">2026 Cycle · As of <%= @finance.coverage_through_date&.strftime("%B %-d, %Y") %></div>
          <div style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:12px;">
            <div>
              <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.1em; text-transform:uppercase; color:#8a9ab8; margin-bottom:2px;">Total Raised</div>
              <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b;"><%= number_to_currency(@finance.total_raised_cents.to_f / 100, precision: 0) %></div>
            </div>
            <div>
              <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.1em; text-transform:uppercase; color:#8a9ab8; margin-bottom:2px;">Cash on Hand</div>
              <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1b3a6b;"><%= number_to_currency(@finance.cash_on_hand_cents.to_f / 100, precision: 0) %></div>
            </div>
            <% if @finance.debts_owed_cents.to_i > 0 %>
            <div>
              <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.1em; text-transform:uppercase; color:#8a9ab8; margin-bottom:2px;">Debts Owed</div>
              <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#8b2020;"><%= number_to_currency(@finance.debts_owed_cents.to_f / 100, precision: 0) %></div>
            </div>
            <% end %>
          </div>
          <% if @finance.total_raised_cents.to_i > 0 %>
            <% indiv_pct = (@finance.individual_contrib_cents.to_f / @finance.total_raised_cents * 100).round(1) %>
            <% pac_pct   = (@finance.pac_contrib_cents.to_f      / @finance.total_raised_cents * 100).round(1) %>
            <div style="margin-bottom:6px;">
              <div style="display:flex; justify-content:space-between; margin-bottom:2px;">
                <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; color:#8a9ab8;">Individual</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; color:#8a9ab8;"><%= indiv_pct %>%</span>
              </div>
              <div style="height:4px; background:#eef0f3; border-radius:2px; overflow:hidden;">
                <div style="width:<%= [indiv_pct, 100].min %>%; height:100%; background:rgba(184,134,11,0.65); border-radius:2px;"></div>
              </div>
            </div>
            <div>
              <div style="display:flex; justify-content:space-between; margin-bottom:2px;">
                <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; color:#8a9ab8;">PAC / Committees</span>
                <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; color:#8a9ab8;"><%= pac_pct %>%</span>
              </div>
              <div style="height:4px; background:#eef0f3; border-radius:2px; overflow:hidden;">
                <div style="width:<%= [pac_pct, 100].min %>%; height:100%; background:rgba(100,160,220,0.6); border-radius:2px;"></div>
              </div>
            </div>
          <% end %>
          <div style="font-family:'JetBrains Mono',monospace; font-size:6px; color:#b0b8c8; margin-top:10px;">Source: FEC public records · <a href="https://www.fec.gov/data/candidate/<%= @finance.fec_candidate_id %>/" target="_blank" style="color:#b0b8c8;">fec.gov ↗</a></div>
        </div>
      <% else %>
        <div style="background:white; border-radius:8px; padding:14px 12px; text-align:center; margin-bottom:8px;">
          <div style="font-family:'Libre Baskerville',serif; font-size:26px; font-weight:700; color:#d4d8e0; line-height:1;">$—</div>
          <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; margin-top:6px;">FEC campaign finance data coming soon.</div>
        </div>
      <% end %>
      <div style="background:#f8f9fc; border:1px solid #e0e5ef; border-radius:8px; padding:10px 12px;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.12em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">◆ Top PAC Contributors</div>
        <% if @top_pacs.any? %>
          <% @top_pacs.each do |pac| %>
            <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
              <span style="font-family:'Nunito',sans-serif; font-size:9.5px; color:#1b3a6b; max-width:70%; overflow-wrap:break-word;"><%= pac[:name] %></span>
              <span style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#b8860b; white-space:nowrap;"><%= fmt_money.call(pac[:total]) %></span>
            </div>
          <% end %>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; color:#b0b8c8; margin-top:6px;">Source: FEC · <a href="https://www.fec.gov" target="_blank" rel="noopener" style="color:#b0b8c8;">fec.gov ↗</a></div>
        <% else %>
          <p style="font-family:'Nunito',sans-serif; font-size:9.5px; color:#8a9ab8; margin:0;">Data unavailable · <a href="https://www.fec.gov" target="_blank" rel="noopener" style="color:#8a9ab8;">fec.gov ↗</a></p>
        <% end %>
      </div>
    </div>

    <!-- Committees -->
    <div style="padding:12px 14px; border-bottom:1px solid #e8ebf2;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ Committees</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:15px; font-weight:700; color:#1b3a6b; margin:0 0 10px;">Where Bills Live or Die</h3>
      <% if @committees.present? %>
        <% @committees.each do |committee| %>
          <div style="background:white; border-radius:6px; padding:10px 12px; margin-bottom:6px;">
            <% if committee[:role].present? %>
              <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#8a9ab8; margin-bottom:4px;"><%= committee[:role] %></div>
            <% end %>
            <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#1b3a6b; line-height:1.45;"><%= committee[:name] %></div>
          </div>
        <% end %>
      <% else %>
        <p style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; text-align:center; padding:4px 0;">Committee assignments coming soon.</p>
      <% end %>
    </div>

    <!-- Reach Out -->
    <div style="padding:12px 14px; border-bottom:1px solid #e8ebf2;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ Reach Out</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:15px; font-weight:700; color:#1b3a6b; margin:0 0 10px;">Contact</h3>
      <% if @member.dig("addressInformation","officeAddress").present? %>
        <div style="background:white; border-radius:6px; padding:10px 12px; margin-bottom:6px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#8a9ab8; margin-bottom:4px;">Office</div>
          <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#1b3a6b; line-height:1.5;"><%= @member.dig("addressInformation","officeAddress") %></div>
        </div>
      <% end %>
      <% if @member.dig("addressInformation","phoneNumber").present? %>
        <div style="background:white; border-radius:6px; padding:10px 12px; margin-bottom:6px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#8a9ab8; margin-bottom:4px;">Phone</div>
          <a href="tel:<%= @member.dig('addressInformation','phoneNumber') %>" style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#1b3a6b; text-decoration:none;"><%= @member.dig("addressInformation","phoneNumber") %></a>
        </div>
      <% end %>
      <% if @social[:website].present? %>
        <div style="background:white; border-radius:6px; padding:10px 12px; margin-bottom:6px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#8a9ab8; margin-bottom:4px;">Website</div>
          <a href="<%= @social[:website] %>" target="_blank" rel="noopener" style="font-family:'Nunito',sans-serif; font-size:11px; color:#1b3a6b; text-decoration:underline; text-underline-offset:2px; word-break:break-all;"><%= @social[:website].gsub(/^https?:\/\//,'').chomp('/') %></a>
        </div>
      <% end %>
    </div>

    <!-- Q&A -->
    <div style="padding:12px 14px 28px;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ Community</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:15px; font-weight:700; color:#1b3a6b; margin:0 0 10px;">Q&A</h3>
      <div style="background:white; border-radius:8px; padding:18px 14px; text-align:center;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:6px;">Coming Soon</div>
        <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.55; margin:0;">Ask questions about this official's record, votes, and positions.</p>
      </div>
    </div>

    <!-- Data Note -->
    <div style="padding:12px 14px 24px;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ Data Note</div>
      <p style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; line-height:1.55; margin:0;">Statistics marked * are hardcoded as of March 2026. Live data connections for state officials are in progress. Sources: PA General Assembly, governor.pa.gov, OpenStates.</p>
    </div>

  </div><!-- /profile sections -->


  <!-- ─────────────────────────────────────
       SECTION 4 · MODALS
  ───────────────────────────────────────── -->

  <div id="modal-attendance" class="mob-modal" onclick="if(event.target===this)closeModal('modal-attendance')">
    <div class="mob-sheet">
      <div class="mob-handle"></div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:5px;">◆ About This Stat</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:18px; font-weight:700; color:#1b3a6b; margin:0 0 12px;">Attendance</h3>
      <p style="font-family:'Nunito',sans-serif; font-size:13px; color:#4a5568; line-height:1.65; margin:0 0 10px;">Attendance tracks how often this member participates in floor votes during the current session of Congress.</p>
      <p style="font-family:'Nunito',sans-serif; font-size:13px; color:#4a5568; line-height:1.65; margin:0 0 22px;">A high vote rate means the member is present and engaged. FORA compares individual rates to the chamber average so you can put the number in context.</p>
      <button class="mob-got-it" onclick="closeModal('modal-attendance')">Got it</button>
    </div>
  </div>

  <div id="modal-party" class="mob-modal" onclick="if(event.target===this)closeModal('modal-party')">
    <div class="mob-sheet">
      <div class="mob-handle"></div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:5px;">◆ About This Stat</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:18px; font-weight:700; color:#1b3a6b; margin:0 0 12px;">Party-Line Voting</h3>
      <p style="font-family:'Nunito',sans-serif; font-size:13px; color:#4a5568; line-height:1.65; margin:0 0 10px;">Party-line voting measures how often this member votes with the majority of their party on contested votes — votes where the two parties are on opposite sides.</p>
      <p style="font-family:'Nunito',sans-serif; font-size:13px; color:#4a5568; line-height:1.65; margin:0 0 22px;">A high score means the member closely follows party leadership. A lower score suggests more independent judgment. Knowing the pattern helps you understand who this member actually represents.</p>
      <button class="mob-got-it" onclick="closeModal('modal-party')">Got it</button>
    </div>
  </div>

  <div id="modal-committees" class="mob-modal" onclick="if(event.target===this)closeModal('modal-committees')">
    <div class="mob-sheet">
      <div class="mob-handle"></div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:5px;">◆ About Committees</div>
      <h3 style="font-family:'Libre Baskerville',serif; font-size:18px; font-weight:700; color:#1b3a6b; margin:0 0 12px;">Where Bills Live or Die</h3>
      <p style="font-family:'Nunito',sans-serif; font-size:13px; color:#4a5568; line-height:1.65; margin:0 0 10px;">Most bills never reach a floor vote. They're assigned to a committee where they're reviewed, amended, or quietly shelved. Committee members decide what moves forward.</p>
      <p style="font-family:'Nunito',sans-serif; font-size:13px; color:#4a5568; line-height:1.65; margin:0 0 22px;">Knowing which committees a member sits on tells you where their power is concentrated — and which industries they're positioned to influence most.</p>
      <button class="mob-got-it" onclick="closeModal('modal-committees')">Got it</button>
    </div>
  </div>

  <script>
    function openModal(id) {
      document.getElementById(id).classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.querySelectorAll('.mob-modal.open').forEach(function(m) {
          m.classList.remove('open');
        });
        document.body.style.overflow = '';
      }
    });
  </script>

</div><!-- /mobile-card -->
</div><!-- /mobile-profile -->

<script>
  /* ── Desktop profile JS ── */
  var DP_MODALS = {
    attendance: {
      eyebrow: "◆ About This Stat",
      title: "Attendance",
      body: "<p>Attendance tracks how often this member participates in floor votes during the current session of Congress.</p><p>A high vote rate means the member is present and engaged. FORA compares individual rates to the chamber average so you can put the number in context.</p>"
    },
    party: {
      eyebrow: "◆ About This Stat",
      title: "Party-Line Voting",
      body: "<p>Party-line voting measures how often this member votes with the majority of their party on contested votes — votes where the two parties are on opposite sides.</p><p>A high score means the member closely follows party leadership. A lower score suggests more independent judgment. Knowing the pattern helps you understand who this member actually represents.</p>"
    },
    bills: {
      eyebrow: "◆ About This Stat",
      title: "Bills Sponsored",
      body: "<p>This counts legislation introduced in the current session of Congress by this member as a primary sponsor.</p><p>Sponsoring a bill doesn't mean it will pass — most bills never reach a floor vote. But it does show which issues a member is willing to put their name on.</p>"
    },
    finance: {
      eyebrow: "◆ About This Stat",
      title: "Campaign Finance",
      body: "<p>Total funds raised for the most recent election cycle, reported to the Federal Election Commission (FEC).</p><p>This includes individual contributions, PAC money, and self-funding. More money doesn't guarantee a win — but it shapes who gets heard. Source: FEC weball data.</p>"
    },
    committees: {
      eyebrow: "◆ About Committees",
      title: "Committee Assignments",
      body: "<p>Most bills never reach a floor vote. They're assigned to a committee where they're reviewed, amended, or quietly shelved. Committee members decide what moves forward.</p><p>Knowing which committees a member sits on tells you where their power is concentrated — and which industries they're positioned to influence most.</p>"
    }
  };

  function dpOpenModal(key) {
    var data = DP_MODALS[key];
    if (!data) return;
    document.getElementById('dp-modal-eyebrow').textContent = data.eyebrow;
    document.getElementById('dp-modal-title').textContent = data.title;
    document.getElementById('dp-modal-body').innerHTML = data.body;
    document.getElementById('dp-modal').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function dpCloseModal() {
    document.getElementById('dp-modal').classList.remove('open');
    document.body.style.overflow = '';
  }

  function dpShare() {
    var url = window.location.href;
    var nameEl = document.querySelector('.dp-name');
    var title = (nameEl ? nameEl.textContent.trim() : document.title) + ' — FORA';
    if (navigator.share) {
      navigator.share({ title: title, url: url }).catch(function() {});
    } else {
      navigator.clipboard.writeText(url).then(function() {
        alert('Link copied to clipboard!');
      }).catch(function() {
        prompt('Copy this link:', url);
      });
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      dpCloseModal();
      document.querySelectorAll('.mob-modal.open').forEach(function(m) {
        m.classList.remove('open');
      });
      document.body.style.overflow = '';
    }
  });
</script>
