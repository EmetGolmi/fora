<%
  initials     = "#{official.first_name[0]}#{official.last_name[0]}"
  term_start   = official.term_start
  term_end     = official.term_end
  total_days   = (term_end - term_start).to_i.clamp(1, 99_999)
  elapsed_days = [(Date.today - term_start).to_i, total_days].min.clamp(0, total_days)
  years_serving = (elapsed_days / 365.25).floor

  vote_colors = { 'yes' => '#155c2d', 'no' => '#7a1515', 'abstain' => '#5a6e8a' }
  vote_labels = { 'yes' => 'Yea',     'no' => 'Nay',     'abstain' => 'Abstain' }
  vote_bg     = { 'yes' => '#eaf3de', 'no' => '#fcebeb',  'abstain' => '#f0f3f8' }
  tag_colors  = { 'green' => '#155c2d', 'blue' => '#1b3a6b', 'amber' => '#b8860b', 'red' => '#7a1515' }
  tag_bgs     = { 'green' => 'rgba(21,92,45,0.08)', 'blue' => 'rgba(27,58,107,0.08)', 'amber' => 'rgba(184,134,11,0.08)', 'red' => 'rgba(122,21,21,0.08)' }

  district_label = (official.district_number.present? && official.district_number > 0) ? "District #{official.district_number}" : "At-Large"
  eyebrow_text   = "Philadelphia City Council · #{district_label}"
%>

<!-- ══════════════════════════════════════════
     DESKTOP LAYOUT
══════════════════════════════════════════ -->
<div class="desktop-profile">

  <%# Hero %>
  <div class="dp-hero">
    <div style="position:absolute; right:-40px; top:-60px; width:340px; height:340px; border-radius:50%; border:36px solid rgba(255,255,255,0.025); pointer-events:none;"></div>
    <div style="position:absolute; right:40px; top:-20px; width:200px; height:200px; border-radius:50%; border:1px solid rgba(184,134,11,0.15); pointer-events:none;"></div>

    <div class="dp-hero-inner">
      <a href="javascript:history.back()" class="dp-hero-back">← My Government</a>

      <div class="dp-hero-identity">
        <div class="dp-avatar">
          <% if official.photo_url.present? %>
            <img src="<%= official.photo_url %>" alt="<%= official.full_name %>">
          <% else %>
            <div class="dp-avatar-initials"><%= initials %></div>
          <% end %>
          <div class="dp-avatar-badge">✓</div>
        </div>

        <div>
          <h1 class="dp-name"><%= official.full_name %></h1>
          <p class="dp-office-title"><%= official.office_title %></p>
          <div class="dp-tags">
            <span class="dp-tag" style="background:rgba(29,78,216,0.2); border-color:rgba(59,130,246,0.4); color:#93c5fd;"><%= official.party %></span>
            <span class="dp-tag" style="border-color:rgba(255,255,255,0.15); background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.5);">Philadelphia</span>
            <% if official.district_name.present? %>
              <span class="dp-tag" style="border-color:rgba(184,134,11,0.4); background:rgba(184,134,11,0.1); color:#d4a832;"><%= district_label %> · <%= official.district_name %></span>
            <% end %>
          </div>
          <div class="dp-social">
            <% if official.website_url.present? %>
              <a href="<%= official.website_url %>" target="_blank" rel="noopener" class="dp-social-link" title="Official Website">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </a>
            <% end %>
            <% if official.twitter_handle.present? %>
              <a href="https://x.com/<%= official.twitter_handle %>" target="_blank" rel="noopener" class="dp-social-link" title="X / Twitter">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            <% end %>
            <button onclick="navigator.share ? navigator.share({title:'<%= official.full_name %> — FORA', url: window.location.href}) : navigator.clipboard.writeText(window.location.href)" class="dp-social-link" style="background:none;border:none;cursor:pointer;padding:0;line-height:0;" title="Share this profile">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:rgba(255,255,255,0.55);"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
      </div>

      <%# Stat bar %>
      <div class="dp-stat-bar">
        <div class="dp-stat" style="cursor:default;">
          <div class="dp-stat-value"><%= official.bills_introduced_count || '—' %></div>
          <div class="dp-stat-label">Bills Introduced</div>
        </div>
        <div class="dp-stat" style="cursor:default;">
          <div class="dp-stat-value"><%= official.bills_passed_count || '—' %></div>
          <div class="dp-stat-label">Bills Passed</div>
        </div>
        <div class="dp-stat" style="cursor:default;">
          <div class="dp-stat-value"><%= official.attendance_rate_pct ? "#{official.attendance_rate_pct}%" : '—' %></div>
          <div class="dp-stat-label">Attendance</div>
        </div>
        <div class="dp-stat" style="cursor:default;">
          <div class="dp-stat-value"><%= official.party_line_vote_pct ? "#{official.party_line_vote_pct}%" : '—' %></div>
          <div class="dp-stat-label">Party-Line Votes</div>
        </div>
      </div>
    </div>

    <div class="dp-stars">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>
  </div>

  <%# Body %>
  <div style="background:#f2f4f8; padding:1px 0;">
    <div class="dp-body">

      <%# ── MAIN COLUMN ── %>
      <div class="dp-main">

        <%# Proximity callout %>
        <div style="background:white; border-left:3px solid #9b8a5a; border-radius:0 8px 8px 0; padding:12px 16px; font-family:'Nunito',sans-serif; font-size:12px; color:#5a6e8a; line-height:1.6; border:0.5px solid #dde5f5; border-left:3px solid #9b8a5a;">
          <strong style="color:#1b3a6b; font-weight:600;">Your most local elected official.</strong> Your city councilmember controls the things you see every day — zoning, permits, street repairs, trash pickup contracts, rec centers, and whether your neighborhood gets a new development or stops one. This is the office that answers the phone.
        </div>

        <%# Recent Votes — pill style %>
        <% if official.recent_votes.present? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Voting Record</div>
          <h2 class="dp-section-title">Recent Votes</h2>
          <% official.recent_votes.each do |v| %>
            <% vc  = vote_colors[v['vote']] || '#5a6e8a' %>
            <% vbg = vote_bg[v['vote']]    || '#f0f3f8' %>
            <div style="display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:0.5px solid #e8ecf4;">
              <span style="font-family:'Nunito',sans-serif; font-size:10px; padding:3px 9px; border-radius:10px; background:<%= vbg %>; color:<%= vc %>; flex-shrink:0; min-width:38px; text-align:center; font-weight:600;"><%= vote_labels[v['vote']] || v['vote'].capitalize %></span>
              <div style="flex:1;">
                <div style="font-family:'Nunito',sans-serif; font-size:12px; color:#1b3a6b; font-weight:500; line-height:1.35;"><%= v['title'] %></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; margin-top:2px;"><%= [v['bill'], v['result'], v['date']].select(&:present?).join(' · ') %></div>
              </div>
              <% if v['tag'].present? %>
                <span style="font-family:'Nunito',sans-serif; font-size:10px; padding:2px 8px; border-radius:8px; background:#f0f3f8; color:#5a6e8a; white-space:nowrap; flex-shrink:0;"><%= v['tag'] %></span>
              <% end %>
              <%= fora_share_btn({official: official.full_name, title: v['title'], desc: [v['bill'], v['result'], v['date']].select(&:present?).join(' · ')}, color: 'rgba(27,58,107,0.25)') %>
            </div>
          <% end %>
        </div>
        <% end %>

        <%# Committees — pill-style role badges %>
        <% if official.committees.present? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Council Assignments</div>
          <h2 class="dp-section-title">Committees</h2>
          <% official.committees.each do |c| %>
            <% is_chair = c['role'].to_s.downcase == 'chair' %>
            <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 10px; background:white; border-radius:6px; margin-bottom:6px; border:0.5px solid #e8ecf4;">
              <span style="font-family:'Nunito',sans-serif; font-size:12px; color:#1b3a6b; flex:1; padding-right:10px;"><%= c['name'] %></span>
              <span style="font-family:'Nunito',sans-serif; font-size:10px; padding:2px 9px; border-radius:8px; font-weight:500; flex-shrink:0;
                           background:<%= is_chair ? '#faeeda' : '#f0f3f8' %>;
                           color:<%= is_chair ? '#633806' : '#5a6e8a' %>;"><%= c['role'].capitalize %></span>
            </div>
          <% end %>
          <% chair_cmte = official.committees.find { |c| c['role'].to_s.downcase == 'chair' } %>
          <% if chair_cmte %>
            <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; background:#f7f9fc; border-radius:6px; padding:8px 10px; margin-top:6px; border-left:2px solid #378add; line-height:1.5;">Committee chair roles show where your rep's power actually sits. <%= official.last_name %> chairs <em><%= chair_cmte['name'] %></em> — that's where district development decisions originate.</div>
          <% end %>
        </div>
        <% end %>

        <%# Upcoming Events %>
        <% if official.upcoming_events.present? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Calendar</div>
          <h2 class="dp-section-title">Upcoming Events</h2>
          <% official.upcoming_events.each do |ev| %>
            <% tc = tag_colors[ev['tag_color']] || '#5a6e8a' %>
            <% tb = tag_bgs[ev['tag_color']] || 'rgba(90,110,138,0.08)' %>
            <div style="display:flex; gap:10px; align-items:flex-start; padding:8px 0; border-bottom:0.5px solid #e8ecf4;">
              <div style="min-width:38px; text-align:center; background:white; border:0.5px solid #e8ecf4; border-radius:6px; padding:5px 0; flex-shrink:0;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:8px; text-transform:uppercase; letter-spacing:1px; color:#8a9ab8;"><%= ev['month'] %></div>
                <div style="font-family:'Libre Baskerville',serif; font-size:18px; font-weight:500; color:#1b3a6b; line-height:1;"><%= ev['day'] %></div>
              </div>
              <div>
                <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:#1b3a6b; margin-bottom:2px;"><%= ev['title'] %></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; margin-bottom:4px;"><%= ev['location'] %></div>
                <% if ev['tag'].present? %>
                  <span style="font-family:'Nunito',sans-serif; display:inline-block; font-size:10px; padding:2px 8px; border-radius:8px; background:<%= tb %>; color:<%= tc %>;"><%= ev['tag'] %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <% end %>

        <%# Data note %>
        <div style="border-top:1px solid #e0e5ef; padding-top:14px; margin-top:4px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#b8860b; margin-bottom:5px;">◆ Data Note</div>
          <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#8a9ab8; line-height:1.6; margin:0;">Data as of <%= official.data_as_of %>. Sources: Philadelphia City Council, Office of the City Clerk, phlcouncil.com.</p>
        </div>

      </div><!-- /dp-main -->

      <%# ── SIDEBAR ── %>
      <div class="dp-sidebar">

        <%# Contact your rep — structured rows %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Contact Your Rep</div>
          <% if official.office_phone.present? %>
            <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 10px; background:#f7f9fc; border-radius:6px; margin-bottom:5px;">
              <div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:#8a9ab8;">Office phone</div>
                <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:#1b3a6b; margin-top:2px;"><%= official.office_phone %></div>
              </div>
              <a href="tel:<%= official.office_phone.gsub(/\D/,'') %>" style="font-family:'Nunito',sans-serif; font-size:11px; color:#1b5fa5; text-decoration:none; flex-shrink:0; margin-left:8px;">Call ↗</a>
            </div>
          <% end %>
          <% if official.office_address.present? %>
            <div style="display:flex; align-items:center; justify-content:space-between; padding:8px 10px; background:#f7f9fc; border-radius:6px; margin-bottom:5px;">
              <div style="flex:1; padding-right:8px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:#8a9ab8;">District office</div>
                <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:#1b3a6b; margin-top:2px;"><%= official.office_address %></div>
              </div>
              <a href="https://maps.google.com/?q=<%= CGI.escape(official.office_address) %>" target="_blank" rel="noopener" style="font-family:'Nunito',sans-serif; font-size:11px; color:#1b5fa5; text-decoration:none; flex-shrink:0;">Map ↗</a>
            </div>
          <% end %>
          <% if official.office_hours.present? %>
            <div style="padding:8px 10px; background:#f7f9fc; border-radius:6px; margin-bottom:5px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:#8a9ab8;">Office hours</div>
              <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:#1b3a6b; margin-top:2px;"><%= official.office_hours %></div>
            </div>
          <% end %>
          <% if official.website_url.present? %>
            <div style="padding:8px 10px; background:#f7f9fc; border-radius:6px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:#8a9ab8;">Website</div>
              <a href="<%= official.website_url %>" target="_blank" rel="noopener" style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:#1b5fa5; text-decoration:none; margin-top:2px; display:block;"><%= official.website_url.gsub(/^https?:\/\//,'').split('/').first %> ↗</a>
            </div>
          <% end %>
        </div>

        <%# Constituent request types %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Submit a Request</div>
          <% _req_url = official.contact_url.presence || official.website_url %>
          <% [
            { icon: '🕳', label: 'Pothole / street repair' },
            { icon: '🗑', label: 'Trash / sanitation issue' },
            { icon: '🏚', label: 'Vacant / blighted property' },
            { icon: '💡', label: 'Broken streetlight' },
            { icon: '📋', label: 'Zoning question' },
            { icon: '💬', label: 'Other — message office' },
          ].each do |req| %>
            <a href="<%= _req_url %>" target="_blank" rel="noopener" class="eo-card" style="display:flex; align-items:center; gap:8px; padding:7px 8px; background:#f7f9fc; border-radius:6px; margin-bottom:5px; text-decoration:none; transition:background 0.12s;">
              <span style="font-size:14px; flex-shrink:0; line-height:1;"><%= req[:icon] %></span>
              <span style="font-family:'Nunito',sans-serif; font-size:12px; color:#1b3a6b; flex:1;"><%= req[:label] %></span>
              <span style="font-family:'Nunito',sans-serif; font-size:12px; color:#8a9ab8;">→</span>
            </a>
          <% end %>
        </div>

        <%# District at a glance %>
        <% _has_district = official.district_population.present? || official.district_median_income.present? || official.district_owner_occupancy_pct.present? || official.district_neighborhoods_count.present? || official.district_rco_count.present? %>
        <% if _has_district %>
        <div class="dp-card">
          <div class="dp-card-title">◆ <%= district_label %> — At a Glance</div>
          <% [
            ['Population',        official.district_population        ? "~#{number_with_delimiter(official.district_population)}" : nil],
            ['Neighborhoods',     official.district_neighborhoods_count],
            ['Median Hh. Income', official.district_median_income     ? "$#{number_with_delimiter(official.district_median_income)}" : nil],
            ['Owner-Occupied',    official.district_owner_occupancy_pct ? "#{official.district_owner_occupancy_pct}%" : nil],
            ['RCOs Active',       official.district_rco_count         ? "#{official.district_rco_count} registered" : nil],
            ['Council Since',     "#{term_start.year} · Yr #{years_serving + 1}"],
          ].each do |label, val| %>
            <% next unless val.present? %>
            <div style="display:flex; justify-content:space-between; align-items:baseline; padding:6px 0; border-bottom:0.5px solid #e8ecf4; font-size:12px;">
              <span style="font-family:'Nunito',sans-serif; color:#5a6e8a;"><%= label %></span>
              <span style="font-family:'Nunito',sans-serif; font-weight:600; color:#1b3a6b;"><%= val %></span>
            </div>
          <% end %>
          <% if official.district_number == 1 %>
            <div style="padding:6px 0; border-bottom:0.5px solid #e8ecf4;">
              <a href="/usa/pa/philly/rco/bvna" style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:#3a6abf;text-decoration:none;">BVNA · Bella Vista Neighbors Assn. ›</a>
            </div>
          <% end %>
          <% if official.district_neighborhoods.present? %>
            <div style="margin-top:10px;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:#8a9ab8; margin-bottom:5px;">Neighborhoods</div>
              <div style="display:flex; flex-wrap:wrap; gap:4px;">
                <% official.district_neighborhoods.first(8).each do |n| %>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.06em; padding:2px 7px; border-radius:100px; background:#f0f3f8; color:#5a6e8a; border:0.5px solid #dde5f5;"><%= n %></span>
                <% end %>
                <% if official.district_neighborhoods.size > 8 %>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; padding:2px 7px; border-radius:100px; background:#f0f3f8; color:#8a9ab8;">+<%= official.district_neighborhoods.size - 8 %> more</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <% end %>

      </div><!-- /dp-sidebar -->
    </div><!-- /dp-body -->
  </div>

</div><!-- /desktop-profile -->


<!-- ══════════════════════════════════════════
     MOBILE LAYOUT
══════════════════════════════════════════ -->
<div class="mobile-profile">
<div class="mobile-card">

  <!-- Section 1 · Card Front -->
  <div style="background:#1b3a6b; position:relative; overflow:hidden;">

    <!-- Photo zone -->
    <div style="height:260px; overflow:hidden; position:relative;">
      <% if official.photo_url.present? %>
        <img src="<%= official.photo_url %>" alt="" style="width:100%; height:100%; object-fit:cover; object-position:50% 15%; display:block;">
      <% else %>
        <div style="width:100%; height:100%; background:linear-gradient(135deg,#254f92,#1b3a6b); display:flex; align-items:center; justify-content:center; font-family:'Libre Baskerville',serif; font-size:52px; font-weight:700; color:#d4a832;"><%= initials %></div>
      <% end %>
      <div style="position:absolute; bottom:0; left:0; right:0; height:90px; background:linear-gradient(to bottom,transparent,#0a1220); pointer-events:none;"></div>
      <div class="mob-foil" style="position:absolute; inset:0;"></div>
    </div>

    <!-- Nameplate -->
    <div style="background:#003087; padding:10px 16px 10px 21px; border-bottom:1.5px solid rgba(184,134,11,.3);">
      <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:white; line-height:1.2;"><%= official.full_name %></div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; text-transform:uppercase; letter-spacing:.12em; color:#d4a832; margin-top:3px;"><%= official.office_title %></div>
    </div>

    <!-- Quick stats strip -->
    <div style="background:#003087; display:flex;">
      <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
        <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= official.attendance_rate_pct ? "#{official.attendance_rate_pct}%" : '—' %></div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Attendance</div>
      </div>
      <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
        <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= official.bills_passed_count || '—' %></div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Bills Passed</div>
      </div>
      <div style="flex:1; text-align:center; padding:10px 6px;">
        <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= official.party_line_vote_pct ? "#{official.party_line_vote_pct}%" : '—' %></div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Party-Line</div>
      </div>
    </div>

    <!-- Social row -->
    <div style="background:#003087; padding:8px 14px 8px 21px; display:flex; align-items:center; justify-content:space-between;">
      <div style="display:flex; gap:14px; align-items:center;">
        <% if official.website_url.present? %>
          <a href="<%= official.website_url %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </a>
        <% end %>
        <% if official.twitter_handle.present? %>
          <a href="https://x.com/<%= official.twitter_handle %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        <% end %>
      </div>
      <% if official.contact_url.present? %>
        <a href="<%= official.contact_url %>" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.14em; text-transform:uppercase; color:rgba(255,255,255,.5); text-decoration:none;">Contact Office ↗</a>
      <% end %>
    </div>
  </div>

    <!-- Section 2 · Issue Focus Areas -->
    <% if official.issue_focus_areas.present? %>
    <div style="padding:16px 20px; background:white; border-bottom:1px solid #e8ecf4;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Issue Focus Areas</div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
        <% official.issue_focus_areas.each do |area| %>
          <div style="background:#f7f9fc; border-radius:8px; padding:10px;">
            <div style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:600; color:#1b3a6b;"><%= area['name'] %></div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; margin-top:1px; margin-bottom:5px;"><%= area['bills_count'] %> bills</div>
            <div style="height:3px; background:#e8ecf4; border-radius:2px; overflow:hidden;">
              <div style="width:<%= area['pct'] %>%; height:100%; background:<%= area['color'] %>; border-radius:2px;"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <!-- Section 3 · Recent Votes -->
    <% if official.recent_votes.present? %>
    <div style="padding:16px 20px; background:white; border-bottom:1px solid #e8ecf4;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Recent Votes</div>
      <% official.recent_votes.each do |v| %>
        <% vc  = vote_colors[v['vote']] || '#5a6e8a' %>
        <% vbg = vote_bg[v['vote']]    || '#f0f3f8' %>
        <div style="display:flex; align-items:center; gap:8px; padding:8px 0; border-bottom:0.5px solid #e8ecf4;">
          <span style="font-family:'Nunito',sans-serif; font-size:10px; padding:2px 8px; border-radius:10px; background:<%= vbg %>; color:<%= vc %>; flex-shrink:0; font-weight:600; min-width:32px; text-align:center;"><%= vote_labels[v['vote']] || v['vote'].capitalize %></span>
          <div style="flex:1;">
            <div style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:500; color:#1b3a6b; line-height:1.3;"><%= v['title'] %></div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; margin-top:2px;"><%= [v['bill'], v['date']].select(&:present?).join(' · ') %></div>
          </div>
          <% if v['tag'].present? %>
            <span style="font-family:'Nunito',sans-serif; font-size:10px; padding:1px 7px; border-radius:8px; background:#f0f3f8; color:#5a6e8a; white-space:nowrap; flex-shrink:0;"><%= v['tag'] %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <% end %>

    <!-- Section 4 · Committees -->
    <% if official.committees.present? %>
    <div style="padding:16px 20px; background:white; border-bottom:1px solid #e8ecf4;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Council Committees</div>
      <% official.committees.each do |c| %>
        <% is_chair = c['role'].to_s.downcase == 'chair' %>
        <div style="display:flex; align-items:center; justify-content:space-between; padding:7px 10px; background:#f7f9fc; border-radius:6px; margin-bottom:5px;">
          <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#1b3a6b; flex:1; padding-right:8px;"><%= c['name'] %></span>
          <span style="font-family:'Nunito',sans-serif; font-size:10px; padding:2px 8px; border-radius:8px; font-weight:500; flex-shrink:0;
            background:<%= is_chair ? '#faeeda' : '#f0f3f8' %>;
            color:<%= is_chair ? '#633806' : '#5a6e8a' %>;"><%= c['role'].capitalize %></span>
        </div>
      <% end %>
    </div>
    <% end %>

    <!-- Section 5 · Upcoming Events -->
    <% if official.upcoming_events.present? %>
    <div style="padding:16px 20px; background:white; border-bottom:1px solid #e8ecf4;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Upcoming Events</div>
      <% official.upcoming_events.each do |ev| %>
        <% tc = tag_colors[ev['tag_color']] || '#5a6e8a' %>
        <div style="display:flex; align-items:center; gap:12px; padding:8px 0; border-bottom:0.5px solid #e8ecf4;">
          <div style="width:38px; flex-shrink:0; background:#f7f9fc; border:0.5px solid #e8ecf4; border-radius:6px; text-align:center; padding:5px 0;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:7px; text-transform:uppercase; color:#8a9ab8;"><%= ev['month'] %></div>
            <div style="font-family:'Libre Baskerville',serif; font-size:17px; font-weight:500; color:#1b3a6b; line-height:1;"><%= ev['day'] %></div>
          </div>
          <div style="flex:1;">
            <div style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:700; color:#1b3a6b;"><%= ev['title'] %></div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; margin-top:2px;"><%= ev['location'] %></div>
            <% if ev['tag'].present? %>
              <span style="font-family:'Nunito',sans-serif; font-size:10px; padding:2px 8px; border-radius:8px; margin-top:3px; display:inline-block; background:<%= tag_bgs[ev['tag_color']] || 'rgba(90,110,138,0.08)' %>; color:<%= tc %>;"><%= ev['tag'] %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <% end %>

    <!-- Section 6 · District at a glance -->
    <div style="padding:16px 20px; background:white; border-bottom:1px solid #e8ecf4;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ <%= district_label %> — At a Glance</div>
      <% [
        ['Population',     official.district_population        ? "~#{number_with_delimiter(official.district_population)}" : nil],
        ['Neighborhoods',  official.district_neighborhoods_count],
        ['Median Income',  official.district_median_income     ? "$#{number_with_delimiter(official.district_median_income)}" : nil],
        ['Owner-Occupied', official.district_owner_occupancy_pct ? "#{official.district_owner_occupancy_pct}%" : nil],
        ['RCOs Active',    official.district_rco_count         ? "#{official.district_rco_count} registered" : nil],
        ['Council Since',  term_start.year.to_s],
      ].each do |label, val| %>
        <% next unless val.present? %>
        <div style="display:flex; justify-content:space-between; align-items:center; padding:5px 0; border-bottom:0.5px solid #e8ecf4;">
          <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;"><%= label %></span>
          <span style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:600; color:#1b3a6b;"><%= val %></span>
        </div>
      <% end %>
      <% if official.district_number == 1 %>
        <div style="padding:6px 0;">
          <a href="/usa/pa/philly/rco/bvna" style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.08em;text-transform:uppercase;color:#3a6abf;text-decoration:none;">BVNA · Bella Vista Neighbors Assn. ›</a>
        </div>
      <% end %>
    </div>

    <!-- Section 7 · Contact footer -->
    <div style="padding:16px 20px; display:flex; gap:10px; background:white;">
      <% if official.contact_url.present? %>
        <a href="<%= official.contact_url %>" target="_blank" rel="noopener" style="flex:1; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:.12em; text-transform:uppercase; text-align:center; padding:10px 8px; background:#1b3a6b; color:white; border-radius:8px; text-decoration:none;">Contact Office</a>
      <% end %>
      <% if official.website_url.present? %>
        <a href="<%= official.website_url %>" target="_blank" rel="noopener" style="flex:1; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:.12em; text-transform:uppercase; text-align:center; padding:10px 8px; background:#f7f9fc; color:#1b3a6b; border:1px solid rgba(27,58,107,0.2); border-radius:8px; text-decoration:none;">phlcouncil.com ↗</a>
      <% end %>
    </div>

</div>
</div>
