    </div><!-- /dp-body -->
  </div>

</div><!-- /desktop-profile -->


<!-- ═══════════════════════════════════════
     MOBILE
═══════════════════════════════════════ -->
<div class="mobile-profile">
<div class="mobile-card">

  <div style="background:#1b3a6b; position:relative; overflow:hidden;">
    <div style="height:260px; overflow:hidden; position:relative;">
      <% if official.photo_url.present? %>
        <img src="<%= official.photo_url %>" alt="" style="width:100%; height:100%; object-fit:cover; object-position:50% 20%; display:block;">
      <% else %>
        <div style="width:100%; height:100%; background:linear-gradient(135deg,#254f92,#1b3a6b); display:flex; align-items:center; justify-content:center; font-family:'Libre Baskerville',serif; font-size:52px; font-weight:700; color:#d4a832;"><%= initials %></div>
      <% end %>
      <div style="position:absolute; bottom:0; left:0; right:0; height:90px; background:linear-gradient(to bottom,transparent,#0a1220); pointer-events:none;"></div>
      <div class="mob-foil" style="position:absolute; inset:0;"></div>
    </div>

    <div style="background:#003087; padding:10px 16px 10px 21px; border-bottom:1.5px solid rgba(184,134,11,.3);">
      <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:white; line-height:1.2;"><%= official.full_name %></div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; text-transform:uppercase; letter-spacing:.12em; color:#d4a832; margin-top:3px;"><%= official.office_title %></div>
    </div>

    <div style="background:#003087; display:flex;">
      <% (ed['stats'] || [{ 'value' => '$6.84B', 'label' => 'FY2026 Budget' }, { 'value' => '18 yrs', 'label' => 'As CFO' }, { 'value' => 'A-range', 'label' => 'Bond Rating' }]).first(3).each_with_index do |s, i| %>
        <div style="flex:1; text-align:center; padding:10px 6px; <%= i < 2 ? 'border-right:1px solid rgba(255,255,255,.06);' : '' %>">
          <div style="font-family:'Libre Baskerville',serif; font-size:14px; font-weight:700; color:white; line-height:1;"><%= s['value'] %></div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;"><%= s['label'] %></div>
        </div>
      <% end %>
    </div>

    <div style="background:#003087; padding:8px 14px 8px 21px; display:flex; align-items:center; justify-content:space-between;">
      <div style="display:flex; gap:14px; align-items:center;">
        <% if official.website_url.present? %>
          <a href="<%= official.website_url %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </a>
        <% end %>
      </div>
      <% contact = ed['contact'] %>
      <% if contact&.dig('email').present? %>
        <a href="mailto:<%= contact['email'] %>" style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.14em; text-transform:uppercase; color:rgba(255,255,255,.5); text-decoration:none;">Email Office ↗</a>
      <% end %>
    </div>
  </div>

  <% if ed['role_callout'].present? %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06); background:#fafbfd;">
    <div style="border-left:3px solid #b8860b; padding-left:12px; font-family:'Nunito',sans-serif; font-size:12px; color:#5a6e8a; line-height:1.65;">
      <%= ed['role_callout'] %>
    </div>
  </div>
  <% end %>

  <%# Budget bar (mobile) %>
  <% budget = ed['budget'] %>
  <% if budget.present? %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:8px;">◆ FY2026 Budget · <%= budget['total'] %></div>
    <div style="display:flex; border-radius:4px; overflow:hidden; height:14px; margin-bottom:10px;">
      <% (budget['segments'] || []).each do |seg| %>
        <div style="width:<%= seg['pct'] %>%; background:<%= seg['color'] %>;" title="<%= seg['label'] %>"></div>
      <% end %>
    </div>
    <% (budget['segments'] || []).each do |seg| %>
      <div style="display:flex; justify-content:space-between; padding:3px 0;">
        <div style="display:flex; align-items:center; gap:6px;">
          <div style="width:7px; height:7px; border-radius:2px; background:<%= seg['color'] %>; flex-shrink:0;"></div>
          <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;"><%= seg['label'] %></span>
        </div>
        <span style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8;"><%= seg['pct'] %>%</span>
      </div>
    <% end %>
  </div>
  <% end %>

  <%# Revenue sources (mobile) %>
  <% rev = ed['revenue_sources'] %>
  <% if rev.present? %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Revenue Sources</div>
    <% rev.each_with_index do |src, ri| %>
      <div onclick="openRevModal(<%= ri %>)" style="padding:8px 0; <%= ri < rev.length - 1 ? 'border-bottom:0.5px solid rgba(27,58,107,0.05);' : '' %> cursor:pointer;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
          <span style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#1b3a6b;"><%= src['name'] %></span>
          <div style="display:flex; align-items:center; gap:8px; flex-shrink:0; margin-left:8px;">
            <span style="font-family:'Libre Baskerville',serif; font-size:13px; font-weight:700; color:#0e1a2e;"><%= src['amount'] %></span>
            <button onclick="event.stopPropagation(); shareRevSource('<%= j src['name'] %>')" style="background:none; border:none; padding:0; cursor:pointer; color:#b8b8c8; line-height:0;">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
        <div style="background:#f0f3f9; border-radius:3px; height:3px; margin-bottom:4px; overflow:hidden;">
          <div style="width:<%= src['bar_pct'] %>%; height:100%; background:<%= src['color'] %>; border-radius:3px;"></div>
        </div>
        <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.4; margin-bottom:4px;"><%= src['explain'] %></div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:<%= src['color'] %>; letter-spacing:.06em;">Tap for details →</div>
      </div>
    <% end %>
  </div>
  <% end %>

  <%# Does / Doesn't (mobile) %>
  <% does_list = ed['does'] %>
  <% if does_list.present? %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#1d9e75; margin-bottom:10px;">◆ What This Office Does</div>
    <% does_list.each_with_index do |item, i| %>
      <div style="padding:6px 0; <%= i < does_list.length - 1 ? 'border-bottom:0.5px solid rgba(27,58,107,0.05);' : '' %>">
        <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#1b3a6b; margin-bottom:2px;"><%= item['title'] %></div>
        <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;"><%= item['sub'] %></div>
      </div>
    <% end %>
  </div>
  <% end %>

  <%# Fiscal risks (mobile) %>
  <% risks = ed['fiscal_risks'] %>
  <% if risks.present? %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#c85050; margin-bottom:10px;">◆ Fiscal Risks</div>
    <% risks.each_with_index do |risk, i| %>
      <% rc = risk_colors[risk['level']] || risk_colors['med'] %>
      <div style="padding:8px 0; <%= i < risks.length - 1 ? 'border-bottom:0.5px solid rgba(27,58,107,0.05);' : '' %>">
        <div style="display:flex; align-items:center; gap:6px; margin-bottom:3px;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.08em; text-transform:uppercase; padding:1px 6px; border-radius:100px; background:<%= rc[:badge_bg] %>; color:<%= rc[:badge_color] %>;"><%= rc[:badge_text] %></span>
          <span style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#1b3a6b;"><%= risk['title'] %></span>
        </div>
        <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.4;"><%= risk['sub'] %></div>
      </div>
    <% end %>
  </div>
  <% end %>

  <%# Credit ratings (mobile) %>
  <% ratings = ed['credit_ratings'] %>
  <% if ratings.present? %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Bond Credit Ratings · Highest in 40+ years</div>
    <div style="display:flex; gap:8px;">
      <% ratings.each do |r| %>
        <div style="flex:1; background:#f4f7fc; border:0.5px solid #dde5f5; border-radius:8px; padding:10px; text-align:center;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8; letter-spacing:.08em; margin-bottom:4px;"><%= r['agency'] %></div>
          <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:#1d9e75;"><%= r['rating'] %></div>
        </div>
      <% end %>
    </div>
  </div>
  <% end %>

  <%# Pension (mobile) %>
  <% pension = ed['pension'] %>
  <% if pension.present? %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:8px;">◆ Pension Fund · <%= pension['funded_pct'] %>% funded</div>
    <div style="background:#e8ecf4; border-radius:100px; height:8px; overflow:hidden; margin-bottom:6px;">
      <div style="width:<%= pension['funded_pct'] %>%; height:100%; background:linear-gradient(90deg,#1d9e75,#4ec9a0); border-radius:100px;"></div>
    </div>
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8; margin-bottom:8px;">Up from <%= pension['from_pct'] %>% in <%= pension['from_year'] %></div>
    <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.5;"><%= pension['savings_note'] %></div>
  </div>
  <% end %>

</div>
</div>

