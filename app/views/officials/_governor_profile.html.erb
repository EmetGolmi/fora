      <div onclick="issueModal('<%= row[:id] %>')" style="display:flex; align-items:center; gap:10px; padding:10px 0; <%= i < 2 ? 'border-bottom:0.5px solid rgba(27,58,107,0.06);' : '' %> cursor:pointer;" onmousedown="this.style.background='#f8f9fd'" onmouseup="this.style.background=''" onmouseleave="this.style.background=''">
        <div style="flex:1; min-width:0;">
          <div style="font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; color:#1b3a6b; line-height:1.2;"><%= row[:name] %></div>
          <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; margin-top:2px; line-height:1.3;"><%= row[:sub] %></div>
