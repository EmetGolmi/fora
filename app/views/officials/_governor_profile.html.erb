      <circle cx="70" cy="70" r="<%= _mdr %>" fill="none" stroke="#e8ecf4" stroke-width="16"/>
      <% _msegs.each do |s| %>
        <circle id="bseg-mob-<%= s[:idx] %>" cx="70" cy="70" r="<%= _mdr %>" fill="none"
          stroke="<%= s[:color] %>" stroke-width="16" stroke-linecap="butt"
          stroke-dasharray="<%= s[:len] %> <%= (_mdc - s[:len]).round(3) %>"
          stroke-dashoffset="<%= (_mdc - s[:prior]).round(3) %>"
          transform="rotate(-90 70 70)"
          style="cursor:pointer; transition:opacity 0.18s;" data-active="0"
          data-name="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>"
          onclick="event.stopPropagation(); bFocus('mob',<%= s[:idx] %>)"/>
      <% end %>
      <text id="bcv-mob" x="70" y="66" text-anchor="middle" font-family="'Libre Baskerville',serif" font-size="16" font-weight="700" fill="#1b3a6b"><%= _m_total %></text>
      <text id="bcl-mob" x="70" y="80" text-anchor="middle" font-family="'JetBrains Mono',monospace" font-size="6" fill="#8a9ab8" letter-spacing="0.5">GENERAL FUND</text>
    </svg>
    <% _msegs.each do |s| %>
      <div id="bleg-mob-<%= s[:idx] %>" style="display:flex; justify-content:space-between; align-items:center; padding:5px 4px; border-bottom:1px solid rgba(27,58,107,0.05); border-radius:4px; transition:background 0.15s; cursor:pointer; margin:0 -4px;"
           onclick="bFocus('mob',<%= s[:idx] %>)">
        <div style="display:flex; align-items:center; gap:6px;">
          <div style="width:8px; height:8px; border-radius:2px; background:<%= s[:color] %>;"></div>
          <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;"><%= s[:cat].capitalize %></span>
        </div>
        <div style="display:flex; align-items:center; gap:5px;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;"><%= s[:pct] %>%</span>
          <button data-title="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>" data-desc="<%= h(budget_description(s[:cat])) %>"
