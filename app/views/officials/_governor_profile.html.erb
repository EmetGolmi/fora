              <div class="dp-card-text" style="font-weight:700; color:#1b3a6b;"><%= official.lt_governor_name %></div>
              <div class="dp-card-sublabel" style="margin-top:2px;"><%= _lg_label %></div>
            </div>
            <span style="font-family:'JetBrains Mono',monospace; font-size:10px; color:#b8860b; flex-shrink:0;">→</span>
          </div>
        </div>
        </a>
        <% end %>

        <%# Term & Election %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Term &amp; Election</div>
          <div style="text-align:center; margin-bottom:14px;">
            <svg width="86" height="86" viewBox="0 0 86 86">
              <circle cx="43" cy="43" r="35" fill="none" stroke="#e8ecf4" stroke-width="6"/>
              <circle cx="43" cy="43" r="35" fill="none" stroke="<%= ring_color %>" stroke-width="6"
                stroke-dasharray="<%= _ring_circ %>" stroke-dashoffset="<%= ring_offset %>"
                stroke-linecap="round" transform="rotate(-90 43 43)"/>
              <text x="43" y="39" text-anchor="middle" dominant-baseline="central"
                style="font-family:'Libre Baskerville',serif;font-size:17px;font-weight:700;fill:#0e1a2e;"><%= "Yr #{year_num}" %></text>
              <text x="43" y="57" text-anchor="middle"
                style="font-family:'JetBrains Mono',monospace;font-size:7px;fill:#8a9ab8;">of 4 done</text>
            </svg>
          </div>
          <% exec_timeline.each_with_index do |row, i| %>
            <% tl_last = (i == exec_timeline.size - 1) %>
            <div style="display:flex; gap:10px;">
              <div style="display:flex; flex-direction:column; align-items:center; flex-shrink:0; width:14px;">
                <div style="width:9px; height:9px; border-radius:50%; background:<%= row[:dot_color] %>; flex-shrink:0;<%= row[:now] ? " border:2px solid white; box-shadow:0 0 0 2px #{ring_color};" : "" %>"></div>
                <% unless tl_last %>
                  <div style="width:1.5px; flex:1; min-height:12px; background:<%= row[:line_color] || "#e8ecf4" %>;"></div>
                <% end %>
              </div>
              <div style="padding-bottom:<%= tl_last ? '0' : '12px' %>; flex:1;">
                <div style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:700; color:#0e1a2e;"><%= row[:evt] %></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8; margin-top:1px;"><%= row[:date] %></div>
                <% if row[:badge] %>
                  <% if row[:badge][:glow] || row[:glow] %>
                    <span class="tl-badge-glow"><%= row[:badge][:text] %></span>
                  <% else %>
                    <span class="tl-badge" style="<%= row[:badge][:style] %>"><%= row[:badge][:text] %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <%# Divided government %>
        <% if official.divided_gov_note.present? %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Legislative Context</div>
          <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.6; margin:0;"><%= official.divided_gov_note %></p>
        </div>
        <% end %>

      </div><!-- /dp-sidebar -->
    </div><!-- /dp-body -->
  </div>

</div><!-- /desktop-profile -->


