    <% [
      { key: 'Senate tie-breaking votes', val: '✓ Multiple cast', good: true },
      { key: 'Jan 6 certification', val: '✓ Completed', good: true },
      { key: 'Munich Security Conference', val: '⚑ Damaged EU trust', good: false },
      { key: 'Zelensky confrontation', val: '⚑ Condemned intl.', good: false },
