                impact: '$85M in Violence Intervention grants distributed to 130+ projects statewide under his leadership.' },
              { badge: 'Appointed by Shapiro', bg: 'rgba(245,158,11,0.1)', color: '#92400e', border: 'rgba(245,158,11,0.3)',
                name: 'Chair, Advisory Council for Inclusive Procurement',
                desc: 'Advises state agencies on diversifying contracting. Davis reports 30% increase in state spending with Black-owned and Latino-owned businesses.',
                impact: nil },
              { badge: 'Self-initiated', bg: 'rgba(16,185,129,0.1)', color: '#065f46', border: 'rgba(16,185,129,0.3)',
                name: 'Chair, Democratic Lt. Governors Association',
                desc: 'National role fundraising and organizing for Democratic gubernatorial races. Focused on 31 governor\'s races in 2026 midterms including Pennsylvania.',
                impact: 'This is the role that signals his political ambition — building a national profile while in state office.' }
            ].each do |role| %>
              <div style="display:flex; gap:12px; padding:10px 12px; background:white; border:0.5px solid rgba(27,58,107,0.09); border-radius:8px;">
