        <div style="width:7px; height:7px; border-radius:50%; background:<%= p['color'] %>; flex-shrink:0;"></div>
        <div style="font-family:'Nunito',sans-serif; font-size:12px; color:#2d3a50; flex:1; line-height:1.35;"><%= p['name'] %></div>
        <div style="width:50px; height:3px; background:#e8ecf4; border-radius:2px; overflow:hidden; flex-shrink:0;">
          <div style="width:<%= pct %>%; height:100%; background:<%= p['color'] %>; border-radius:2px;"></div>
        </div>
      </div>
    <% end %>
