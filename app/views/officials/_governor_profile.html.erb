  <!-- Section 5 · Issues & Positions (mayor and governor) -->

  <!-- Q&A -->
  <div style="padding:12px 14px 28px; border-bottom:1px solid #e8ebf2;">
    <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">◆ Community</div>
    <h3 style="font-family:'Libre Baskerville',serif; font-size:15px; font-weight:700; color:#1b3a6b; margin:0 0 10px;">Q&A</h3>
    <div class="bt-card">
      <div class="bt-eyebrow">◆ How do you see it?</div>
      <div class="bt-perspective-grid" id="bt-perspectives-m">
        <button type="button" class="bt-perspective-btn" data-type="empathy"        data-label="🤝 With empathy">🤝 With empathy</button>
        <button type="button" class="bt-perspective-btn" data-type="practical"      data-label="🔧 Practical fix">🔧 Practical fix</button>
        <button type="button" class="bt-perspective-btn" data-type="accountability" data-label="📋 Hold accountable">📋 Hold accountable</button>
        <button type="button" class="bt-perspective-btn" data-type="opposition"     data-label="↔ Different view">↔ Different view</button>
      </div>
      <textarea class="bt-textarea" id="bt-body-m" rows="3"
        placeholder="What do you think about <%= official.full_name %>'s record and positions?"></textarea>
      <div class="bt-form-row">
        <div><input class="bt-input" type="text" id="bt-name-m" placeholder="Your occupation (optional)"></div>
        <div style="display:flex; align-items:center;">
          <div class="bt-checkbox-row">
            <input type="checkbox" id="bt-anon-m">
            <label for="bt-anon-m">Post anonymously</label>
          </div>
        </div>
      </div>
      <div class="photo-attach-wrap">
        <span class="photo-attach-label">📷 Add a photo (optional)</span>
        <div class="photo-attach-options">
          <label class="photo-opt-btn">
            <input type="file" accept="image/*" style="display:none;" onchange="handleFileUpload(this, 'qa-m')">
            📁 Camera roll
          </label>
          <span class="photo-opt-divider">or</span>
          <input type="text" class="photo-link-input" placeholder="🔗 Paste a photo link" oninput="handleLinkInput(this, 'qa-m')">
        </div>
        <div class="photo-preview-area" id="preview-qa-m" style="display:none;">
          <img class="photo-preview-img" id="preview-img-qa-m" src="" alt="Preview" onclick="openLightbox(this.src)">
          <div class="photo-preview-meta">
            <span class="photo-preview-name" id="preview-name-qa-m"></span>
            <button class="photo-remove-btn" onclick="clearPhoto('qa-m')">✕ Remove</button>
          </div>
        </div>
      </div>
      <button class="bt-submit" onclick="ofOpenShare('m')">Share your take →</button>
      <div class="bt-share-panel" id="bt-share-panel-m" hidden>
        <div class="bt-share-panel-label">Your take — ready to share</div>
        <div class="bt-share-copy" id="bt-share-copy-m"></div>
        <div id="bt-share-photo-m"></div>
        <div class="bt-share-btns" id="bt-share-btns-m"></div>
      </div>
    </div>
  </div>

  <!-- Section 6 · Contact footer -->
  <div style="padding:16px 20px; display:flex; gap:10px;">
    <% if official.contact_url.present? %>
      <a href="<%= official.contact_url %>" target="_blank" rel="noopener" style="flex:1; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:.12em; text-transform:uppercase; text-align:center; padding:10px 8px; background:#1b3a6b; color:white; border-radius:8px; text-decoration:none;">Contact Office</a>
    <% end %>
    <% if official.website_url.present? %>
      <a href="<%= official.website_url %>" target="_blank" rel="noopener" style="flex:1; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:.12em; text-transform:uppercase; text-align:center; padding:10px 8px; background:white; color:#1b3a6b; border:1px solid rgba(27,58,107,0.2); border-radius:8px; text-decoration:none;">governor.pa.gov ↗</a>
    <% end %>
  </div>

</div>
</div>

<div id="bud-modal" onclick="if(event.target===this)budModalClose()" style="display:none; position:fixed; inset:0; background:rgba(14,26,46,0.55); z-index:9000; align-items:center; justify-content:center; padding:20px;">
  <div style="background:#fff; border-radius:14px; max-width:420px; width:100%; padding:24px 24px 20px; position:relative; box-shadow:0 8px 32px rgba(14,26,46,0.18);">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
      <div id="bud-modal-dot" style="width:12px; height:12px; border-radius:3px; flex-shrink:0;"></div>
      <div style="flex:1;">
        <div id="bud-modal-title" style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:#0e1a2e;"></div>
        <div id="bud-modal-pct" style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; margin-top:2px;"></div>
      </div>
      <button onclick="budModalClose()" style="background:none; border:none; cursor:pointer; font-size:20px; color:#8a9ab8; padding:0 4px; line-height:1;">×</button>
    </div>
    <p id="bud-modal-desc" style="font-family:'Nunito',sans-serif; font-size:13px; color:#3a4e6a; line-height:1.65; margin:0;"></p>
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#b8c0d0; letter-spacing:.08em; margin-top:14px; text-transform:uppercase;">FY 2025–26 · General Fund</div>
  </div>
</div>

<script>
function budModalOpen(el) {
  var m = document.getElementById('bud-modal');
  if (!m) return;
  document.getElementById('bud-modal-title').textContent = el.dataset.title;
  document.getElementById('bud-modal-pct').textContent   = el.dataset.pct + '% of General Fund';
  document.getElementById('bud-modal-dot').style.background = el.dataset.clr;
  document.getElementById('bud-modal-desc').textContent  = el.dataset.desc;
  m.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function budModalClose() {
  var m = document.getElementById('bud-modal');
  if (m) m.style.display = 'none';
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e){ if(e.key==='Escape') budModalClose(); });

function bFocus(ctx, i) {
  var seg = document.getElementById('bseg-'+ctx+'-'+i);
  if (!seg) return;
  var isOn = seg.dataset.active === '1';
  bReset(ctx);
  if (isOn) return;
  var j = 0, s;
  while ((s = document.getElementById('bseg-'+ctx+'-'+j))) {
    s.style.opacity = (j === i) ? '1' : '0.18';
    j++;
  }
  seg.dataset.active = '1';
  var name = seg.dataset.name, pct = seg.dataset.pct, color = seg.dataset.clr;
  var cv = document.getElementById('bcv-'+ctx);
  var cl = document.getElementById('bcl-'+ctx);
  if (cv) { cv.textContent = pct+'%'; cv.setAttribute('fill', color); }
  if (cl) { cl.textContent = name.toUpperCase(); cl.setAttribute('fill', color); }
  var row = document.getElementById('bleg-'+ctx+'-'+i);
  if (row) row.style.background = 'rgba(0,0,0,0.045)';
}
function bReset(ctx) {
  var j = 0, s;
  while ((s = document.getElementById('bseg-'+ctx+'-'+j))) {
    s.style.opacity = '1';
    s.dataset.active = '0';
    var r = document.getElementById('bleg-'+ctx+'-'+j);
    if (r) r.style.background = '';
    j++;
  }
  var svg = document.querySelector('[data-ctx="'+ctx+'"]');
  var cv = document.getElementById('bcv-'+ctx);
  var cl = document.getElementById('bcl-'+ctx);
  if (cv) { cv.textContent = svg ? svg.dataset.total : ''; cv.setAttribute('fill','#1b3a6b'); }
  if (cl) { cl.textContent = 'GENERAL FUND'; cl.setAttribute('fill','#8a9ab8'); }
}
</script>

<script>
(function() {
  var officialName = '<%= j official.full_name %>';
  var pageUrl = window.location.href;
  var state = { d: { type: 'empathy', label: '🤝 With empathy' }, m: { type: 'empathy', label: '🤝 With empathy' } };
  ['d', 'm'].forEach(function(sfx) {
    var grid = document.getElementById('bt-perspectives-' + sfx);
    if (!grid) return;
    var defaultBtn = grid.querySelector('[data-type="empathy"]');
    if (defaultBtn) defaultBtn.classList.add('active');
    grid.querySelectorAll('.bt-perspective-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        grid.querySelectorAll('.bt-perspective-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        state[sfx].type  = btn.dataset.type;
        state[sfx].label = btn.dataset.label;
      });
    });
  });
  var photoState = {};
  window.handleFileUpload = function(input, formId) {
    var file = input.files && input.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert('Please use a photo under 2 MB.'); input.value = ''; return; }
    var reader = new FileReader();
    reader.onload = function(e) {
      photoState[formId] = { photo_data: e.target.result, photo_url: null, photo_filename: file.name };
      showPhotoPreview(formId, e.target.result, file.name);
    };
    reader.readAsDataURL(file);
  };
  window.handleLinkInput = function(input, formId) {
    var url = input.value.trim();
    if (!url) { clearPhoto(formId); return; }
    var img = new Image();
    img.onload = function() {
      photoState[formId] = { photo_data: null, photo_url: url, photo_filename: url.split('/').pop().split('?')[0] || 'photo' };
      showPhotoPreview(formId, url, photoState[formId].photo_filename);
    };
    img.src = url;
  };
  function showPhotoPreview(formId, src, name) {
    var area = document.getElementById('preview-' + formId);
    var imgEl = document.getElementById('preview-img-' + formId);
    var nameEl = document.getElementById('preview-name-' + formId);
    if (area)   area.style.display = 'flex';
    if (imgEl)  imgEl.src = src;
    if (nameEl) nameEl.textContent = name || '';
  }
  window.clearPhoto = function(formId) {
    delete photoState[formId];
    var area = document.getElementById('preview-' + formId);
    if (area) area.style.display = 'none';
  };
  window.openLightbox = function(src) {
    var lb = document.getElementById('fora-lightbox');
    if (!lb) {
      lb = document.createElement('div');
      lb.id = 'fora-lightbox';
      lb.className = 'lightbox-overlay';
      lb.innerHTML = '<button class="lightbox-close" onclick="closeLightbox()">✕</button><img src="" alt="Full photo">';
      lb.addEventListener('click', function(e) { if (e.target === lb) closeLightbox(); });
      document.body.appendChild(lb);
    }
    lb.querySelector('img').src = src;
    lb.classList.add('open');
  };
  window.closeLightbox = function() {
    var lb = document.getElementById('fora-lightbox');
    if (lb) lb.classList.remove('open');
  };
  window.ofOpenShare = function(sfx) {
    var bodyEl  = document.getElementById('bt-body-'        + sfx);
    var nameEl  = document.getElementById('bt-name-'        + sfx);
    var anonEl  = document.getElementById('bt-anon-'        + sfx);
    var panel   = document.getElementById('bt-share-panel-' + sfx);
    var copyEl  = document.getElementById('bt-share-copy-'  + sfx);
    var btnsEl  = document.getElementById('bt-share-btns-'  + sfx);
    var photoEl = document.getElementById('bt-share-photo-' + sfx);
    var body = bodyEl ? bodyEl.value.trim() : '';
    if (!body) { bodyEl && bodyEl.focus(); return; }
    var anon   = anonEl && anonEl.checked;
    var name   = (!anon && nameEl && nameEl.value.trim()) ? nameEl.value.trim() : null;
    var byline = name ? ' — ' + name : '';
    var lbl    = (state[sfx] || {}).label || '◆ My take';
    var shareText = lbl + ': ' + body + byline + '\n\nvia FORA on ' + officialName + ' — ' + pageUrl;
    if (copyEl) copyEl.textContent = shareText;
    var photo = photoState['qa-' + sfx] || {};
    if (photoEl) {
      var src = photo.photo_data || photo.photo_url;
      photoEl.innerHTML = src ? '<img src="' + src + '" alt="Attached photo" onclick="openLightbox(this.src)" style="max-width:100%; max-height:160px; border-radius:6px; margin-bottom:10px; cursor:pointer; display:block;">' : '';
    }
    var enc = encodeURIComponent, t240 = shareText.substring(0, 240);
    var platforms = [
      ['𝕏 / Twitter',  function() { window.open('https://twitter.com/intent/tweet?text=' + enc(t240), '_blank', 'noopener'); }],
      ['Facebook',      function() { window.open('https://www.facebook.com/sharer/sharer.php?u=' + enc(pageUrl), '_blank', 'noopener'); }],
      ['WhatsApp',      function() { window.open('https://wa.me/?text=' + enc(shareText.substring(0, 300)), '_blank', 'noopener'); }],
      ['LinkedIn',      function() { window.open('https://www.linkedin.com/shareArticle?mini=true&url=' + enc(pageUrl) + '&summary=' + enc(shareText.substring(0, 200)), '_blank', 'noopener'); }],
      ['Instagram',     function() { navigator.clipboard.writeText(shareText).then(function() { window.open('https://www.instagram.com/', '_blank', 'noopener'); }); }],
      ['Copy text',     function() { navigator.clipboard.writeText(shareText).then(function() { var b = btnsEl && btnsEl.querySelector('[data-copy]'); if (b) { var o = b.textContent; b.textContent = 'Copied!'; setTimeout(function() { b.textContent = o; }, 1800); } }); }]
    ];
    if (btnsEl) {
      btnsEl.innerHTML = '';
      platforms.forEach(function(pair) {
        var btn = document.createElement('button');
        btn.className = 'bt-share-plat';
        btn.textContent = pair[0];
        if (pair[0] === 'Copy text') btn.dataset.copy = '1';
        btn.addEventListener('click', pair[1]);
        btnsEl.appendChild(btn);
      });
    }
    if (panel) panel.hidden = false;
  };
})();
</script>
