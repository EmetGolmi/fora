          <div style="display:flex; flex-direction:column; gap:8px;">
            <% [
              { badge: 'Constitutional', bg: 'rgba(29,78,216,0.1)', color: '#1d4ed8', border: 'rgba(29,78,216,0.3)',
                name: 'President of the PA Senate',
                desc: 'Presides over Senate sessions. Casts tie-breaking votes. Largely ceremonial — but the tie-breaker matters in a divided chamber.',
                impact: nil },
              { badge: 'Constitutional', bg: 'rgba(29,78,216,0.1)', color: '#1d4ed8', border: 'rgba(29,78,216,0.3)',
