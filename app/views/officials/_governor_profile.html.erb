      <a href="<%= official.contact_url %>" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.14em; text-transform:uppercase; color:rgba(255,255,255,.5); text-decoration:none;">Contact Office ↗</a>
    </div>
  </div>

  <!-- Section 1b · Issues & Positions -->
  <% if %w[mayor governor].include?(official.office_type) %>
  <div style="padding:16px 20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:12px;">◆ Issues &amp; Positions</div>
    <% if official.office_type == 'mayor' %>
      <% _mob_issues = [
        { id: 'kensington', name: 'Kensington drug crisis',    sub: 'Encampment sweeps · enforcement + treatment', tension: 'High',   tension_style: 'background:rgba(220,38,38,0.1); color:#b91c1c; border:0.5px solid rgba(220,38,38,0.25);' },
        { id: 'ice',        name: 'ICE & immigration',          sub: '"Welcoming city" — resisting federal pressure', tension: 'High',   tension_style: 'background:rgba(220,38,38,0.1); color:#b91c1c; border:0.5px solid rgba(220,38,38,0.25);' },
        { id: 'schools',    name: 'Schools & extended year',    sub: '40 schools in pilot — before/after care',       tension: 'Active', tension_style: 'background:rgba(245,158,11,0.1); color:#92400e; border:0.5px solid rgba(245,158,11,0.25);' }
      ] %>
    <% else %>
      <% _mob_issues = [
        { id: 'school_funding', name: 'School funding equity',          sub: '2023 court ruling — $1.1B budget fight', tension: 'High',   tension_style: 'background:rgba(220,38,38,0.1); color:#b91c1c; border:0.5px solid rgba(220,38,38,0.25);' },
        { id: 'abortion',       name: 'Abortion & reproductive rights', sub: 'Vetoed restrictions — wants const. protection', tension: 'High',   tension_style: 'background:rgba(220,38,38,0.1); color:#b91c1c; border:0.5px solid rgba(220,38,38,0.25);' },
        { id: 'erpo',           name: 'Gun violence & ERPO',            sub: 'Red flag law blocked by GOP Senate',     tension: 'Active', tension_style: 'background:rgba(245,158,11,0.1); color:#92400e; border:0.5px solid rgba(245,158,11,0.25);' }
      ] %>
    <% end %>
