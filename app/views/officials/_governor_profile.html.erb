        <div style="display:flex; align-items:center; gap:4px;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:8px; font-weight:700; color:<%= row[:good] ? '#155c2d' : '#b45309' %>; text-align:right; line-height:1.3;"><%= row[:val] %></span>
          <%= fora_share_btn({official: official.full_name, title: row[:key], desc: row[:val]}, color: 'rgba(27,58,107,0.25)') %>
        </div>
