<%
  _ring_circ   = 219.9
  term_start   = official.term_start || Date.new(2024, 1, 1)
  term_end     = official.term_end   || Date.new(2028, 1, 1)
  total_days   = (term_end - term_start).to_i.clamp(1, 99_999)
  elapsed_days = [(Date.today - term_start).to_i, total_days].min.clamp(0, total_days)
  ring_pct     = elapsed_days.to_f / total_days
  ring_offset  = (_ring_circ * (1 - ring_pct)).round(2)
  year_num     = (elapsed_days / 365.25).floor + 1
  ring_color   = "rgb(11,46,130)"

  party_tag_style = case official.party
    when "Republican"          then "background:rgba(220,38,38,0.2); border-color:rgba(239,68,68,0.4); color:#fca5a5;"
    when "Working Families Party" then "background:rgba(168,85,247,0.2); border-color:rgba(168,85,247,0.4); color:#d8b4fe;"
    when "Appointed"           then "background:rgba(107,114,128,0.2); border-color:rgba(156,163,175,0.4); color:#d1d5db;"
    else                            "background:rgba(29,78,216,0.2); border-color:rgba(59,130,246,0.4); color:#93c5fd;"
    end

  geo_tag = if %w[president vp].include?(official.office_type)
    "United States"
  elsif %w[managing_director finance_director mayor].include?(official.office_type)
    "Philadelphia"
  else
    "Pennsylvania"
  end

  gov_initials = "#{official.first_name[0]}#{official.last_name[0]}"

  exec_timeline = case official.office_type
  when "president"
    [
      { dot_color: "rgb(178,34,34)", line_color: "rgb(178,34,34)",
        evt: "Won 2024 Presidential Election", date: "November 5, 2024",
        badge: { text: "312 electoral votes · 49.9% popular vote", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(178,34,34)", line_color: "rgb(178,34,34)",
        evt: "Inaugurated — 47th President", date: "January 20, 2025",
        badge: { text: "Second non-consecutive term in US history", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "#b8860b",
        line_color: "linear-gradient(to bottom,#b8860b,rgba(184,134,11,0.12))",
        evt: "In office", date: official.data_as_of,
        badge: { text: "Currently serving", style: "background:rgba(184,134,11,0.08); color:#b8860b; border:1px solid rgba(184,134,11,0.3);" },
        now: true },
      { dot_color: "rgba(139,32,32,0.5)", line_color: nil,
        evt: "Term ends", date: "January 20, 2029",
        badge: { text: "Constitutionally limited to current term", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
    ]
  when "vp"
    [
      { dot_color: "rgb(178,34,34)", line_color: "rgb(178,34,34)",
        evt: "Won 2024 Election — Vice President", date: "November 5, 2024",
        badge: { text: "On ticket with President Trump", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(178,34,34)", line_color: "rgb(178,34,34)",
        evt: "Sworn in — 50th Vice President", date: "January 20, 2025",
        badge: { text: "President of the United States Senate", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "#b8860b",
        line_color: "linear-gradient(to bottom,#b8860b,rgba(184,134,11,0.12))",
        evt: "In office", date: official.data_as_of,
        badge: { text: "Currently serving", style: "background:rgba(184,134,11,0.08); color:#b8860b; border:1px solid rgba(184,134,11,0.3);" },
        now: true },
      { dot_color: "rgba(139,32,32,0.5)", line_color: nil,
        evt: "Term ends", date: "January 20, 2029",
        badge: { text: "Constitutionally limited to current term", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
    ]
  when "governor"
    [
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Elected Governor", date: "November 2022",
        badge: { text: "Won by 14.8 pts over Mastriano", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Sworn in", date: "January 17, 2023", badge: nil },
      { dot_color: "#b8860b",
        line_color: "linear-gradient(to bottom,#b8860b,rgba(184,134,11,0.12))",
        evt: "In office", date: official.data_as_of,
        badge: { text: "Currently serving", style: "background:rgba(184,134,11,0.08); color:#b8860b; border:1px solid rgba(184,134,11,0.3);" },
        now: true },
      { dot_color: "rgba(139,32,32,0.5)", line_color: nil,
        evt: "General Election", date: "November 2026",
        badge: { text: "⚡ ~7 months away", glow: true }, glow: true },
    ]
  when "lt_governor"
    [
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Elected Lt. Governor", date: "November 2022",
        badge: { text: "On ticket with Gov. Shapiro", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Sworn in — 34th Lt. Governor", date: "January 17, 2023",
        badge: { text: "First Black Lt. Governor of Pennsylvania", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "#b8860b",
        line_color: "linear-gradient(to bottom,#b8860b,rgba(184,134,11,0.12))",
        evt: "In office", date: official.data_as_of,
        badge: { text: "Currently serving", style: "background:rgba(184,134,11,0.08); color:#b8860b; border:1px solid rgba(184,134,11,0.3);" },
        now: true },
      { dot_color: "rgba(139,32,32,0.5)", line_color: nil,
        evt: "General Election", date: "November 2026",
        badge: { text: "⚡ ~7 months away", glow: true }, glow: true },
    ]
  when "mayor"
    [
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Won Democratic primary", date: "May 2023",
        badge: { text: "47% in crowded primary field", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Elected Mayor", date: "November 2023",
        badge: { text: "83.8% of the vote", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Sworn in — 100th Mayor of Philadelphia", date: "January 1, 2024", badge: nil },
      { dot_color: "#b8860b",
        line_color: "linear-gradient(to bottom,#b8860b,rgba(184,134,11,0.12))",
        evt: "In office", date: official.data_as_of,
        badge: { text: "Currently serving", style: "background:rgba(184,134,11,0.08); color:#b8860b; border:1px solid rgba(184,134,11,0.3);" },
        now: true },
      { dot_color: "rgba(139,32,32,0.35)", line_color: nil,
        evt: "General Election", date: "November 2027",
        badge: { text: "~18 months away", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
    ]
  when "managing_director"
    [
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Served as Philadelphia Fire Commissioner", date: "2015 – January 2024",
        badge: { text: "Led 5,000-person department through COVID-19 & civil unrest", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Appointed Managing Director by Mayor Parker", date: "January 1, 2024",
        badge: { text: "Oversees 26 departments & ~26,000 city employees", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "#b8860b",
        line_color: "linear-gradient(to bottom,#b8860b,rgba(184,134,11,0.12))",
        evt: "In office", date: official.data_as_of,
        badge: { text: "Currently serving", style: "background:rgba(184,134,11,0.08); color:#b8860b; border:1px solid rgba(184,134,11,0.3);" },
        now: true },
      { dot_color: "rgba(139,32,32,0.35)", line_color: nil,
        evt: "Term aligned with Mayor Parker's", date: "January 2028",
        badge: { text: "Appointed role", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
    ]
  when "finance_director"
    [
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Appointed Director of Finance by Mayor Nutter", date: "January 2008",
        badge: { text: "First appointment — career city finance executive", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Reappointed by Mayor Kenney", date: "January 2016", badge: nil },
      { dot_color: "rgb(11,46,130)", line_color: "rgb(11,46,130)",
        evt: "Reappointed by Mayor Parker", date: "January 2024",
        badge: { text: "Serving across three administrations", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
      { dot_color: "#b8860b",
        line_color: "linear-gradient(to bottom,#b8860b,rgba(184,134,11,0.12))",
        evt: "In office", date: official.data_as_of,
        badge: { text: "Currently serving", style: "background:rgba(184,134,11,0.08); color:#b8860b; border:1px solid rgba(184,134,11,0.3);" },
        now: true },
      { dot_color: "rgba(139,32,32,0.35)", line_color: nil,
        evt: "Term aligned with Mayor Parker's", date: "January 2028",
        badge: { text: "Appointed role", style: "background:#f0f3f8; color:#8a9ab8; border:0.5px solid #dde5f5;" } },
    ]
  else
    []
  end

  news_dot_colors = ["#378add", "#639922", "#b8860b", "#e24b4a", "#8a40b4"]
%>

<!-- ══════════════════════════════════════════
     DESKTOP LAYOUT
══════════════════════════════════════════ -->
<div class="desktop-profile">

  <%# Hero %>
  <div class="dp-hero">
    <div style="position:absolute; right:-40px; top:-60px; width:340px; height:340px; border-radius:50%; border:36px solid rgba(255,255,255,0.025); pointer-events:none;"></div>
    <div style="position:absolute; right:40px; top:-20px; width:200px; height:200px; border-radius:50%; border:1px solid rgba(184,134,11,0.15); pointer-events:none;"></div>

    <div class="dp-hero-inner">
      <a href="javascript:history.back()" class="dp-hero-back">← My Government</a>

      <div class="dp-hero-identity">
        <div class="dp-avatar">
          <% if official.photo_url.present? %>
            <img src="<%= official.photo_url %>" alt="<%= official.full_name %>">
          <% else %>
            <div class="dp-avatar-initials"><%= gov_initials %></div>
          <% end %>
          <div class="dp-avatar-badge">✓</div>
        </div>

        <div>
          <h1 class="dp-name"><%= official.full_name %></h1>
          <p class="dp-office-title"><%= official.office_title %></p>
          <div class="dp-tags">
            <span class="dp-tag" style="<%= party_tag_style %>"><%= official.party %></span>
            <span class="dp-tag" style="border-color:rgba(255,255,255,0.15); background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.5);"><%= geo_tag %></span>
          </div>
          <div class="dp-social">
            <% if official.website_url.present? %>
              <a href="<%= official.website_url %>" target="_blank" rel="noopener" class="dp-social-link" title="Official Website">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </a>
            <% end %>
            <% if official.twitter_handle.present? %>
              <a href="https://x.com/<%= official.twitter_handle %>" target="_blank" rel="noopener" class="dp-social-link" title="X / Twitter">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            <% end %>
            <button onclick="navigator.share ? navigator.share({title:'<%= official.full_name %> — FORA', url: window.location.href}) : navigator.clipboard.writeText(window.location.href)" class="dp-social-link" style="background:none;border:none;cursor:pointer;padding:0;line-height:0;" title="Share this profile">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:rgba(255,255,255,0.55);"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
      </div>

      <%# Stat bar %>
      <div class="dp-stat-bar">
        <% if official.office_type == 'lt_governor' %>
          <% yr_in_office = ((Date.today - official.term_start) / 365.25).floor + 1 %>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">34th</div>
            <div class="dp-stat-label">Lt. Governor</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">Yr <%= yr_in_office %></div>
            <div class="dp-stat-label">of 4-yr Term</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">Senate</div>
            <div class="dp-stat-label">President</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">2023</div>
            <div class="dp-stat-label">Since</div>
          </div>
        <% elsif official.office_type == 'managing_director' %>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">26</div>
            <div class="dp-stat-label">Departments</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">~26K</div>
            <div class="dp-stat-label">Employees</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">2024</div>
            <div class="dp-stat-label">Appointed</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">9 yrs</div>
            <div class="dp-stat-label">Prior City Svc.</div>
          </div>
        <% elsif official.office_type == 'finance_director' %>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">$6.8B</div>
            <div class="dp-stat-label">Budget</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">18 yrs</div>
            <div class="dp-stat-label">In Role</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">AA</div>
            <div class="dp-stat-label">Bond Rating</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value">2008</div>
            <div class="dp-stat-label">Since</div>
          </div>
        <% else %>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value"><%= official.bills_signed_count || '—' %></div>
            <div class="dp-stat-label">Bills Signed</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value"><%= official.veto_count || '—' %></div>
            <div class="dp-stat-label">Vetoes</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value"><%= official.executive_orders&.length || '—' %></div>
            <div class="dp-stat-label">Executive Orders</div>
          </div>
          <div class="dp-stat" style="cursor:default;">
            <div class="dp-stat-value"><%= official.approval_rating ? "#{official.approval_rating}%" : '—' %></div>
            <div class="dp-stat-label">Approval Rating</div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="dp-stars">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>
  </div>

  <%# Body %>
  <div style="background:#f2f4f8; padding:1px 0;">
    <div class="dp-body">

      <%# ── MAIN COLUMN ── %>
      <div class="dp-main">

        <%# Policy Priorities %>
        <% if official.policy_priorities.present? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Executive Agenda</div>
          <h2 class="dp-section-title">Stated Policy Priorities</h2>
          <% official.policy_priorities.each do |p| %>
            <% pct = p['level'] == 'high' ? 82 : 52 %>
            <div style="display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid rgba(27,58,107,0.06);">
              <div style="width:8px; height:8px; border-radius:50%; background:<%= p['color'] %>; flex-shrink:0;"></div>
              <div style="font-family:'Nunito',sans-serif; font-size:12px; color:#2d3a50; flex:1; line-height:1.4;"><%= p['name'] %></div>
              <div style="width:80px; height:4px; background:#e8ecf4; border-radius:2px; overflow:hidden; flex-shrink:0;">
                <div style="width:<%= pct %>%; height:100%; background:<%= p['color'] %>; border-radius:2px;"></div>
              </div>
              <span style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.08em; text-transform:uppercase; color:<%= p['color'] %>; width:36px; text-align:right; flex-shrink:0;"><%= p['level'] %></span>
            </div>
          <% end %>
        </div>
        <% end %>

        <%# Executive Orders %>
        <% if official.executive_orders.present? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Executive Action</div>
          <h2 class="dp-section-title">Executive Orders <span style="font-size:13px; font-weight:400; color:#8a9ab8; font-family:'JetBrains Mono',monospace; letter-spacing:0.06em;"><%= official.executive_orders.length %> this term</span></h2>
          <% official.executive_orders.each do |eo| %>
            <% if eo['slug'].present? %>
              <a href="/eo/<%= eo['slug'] %>" style="text-decoration:none; display:flex; align-items:stretch; color:inherit;">
            <% end %>
            <div class="eo-card" style="display:flex; align-items:stretch; background:white; border:0.5px solid #dde5f5; border-radius:8px; margin-bottom:8px; overflow:hidden; transition:background 0.12s; width:100%;">
              <div style="width:8px; background:#b8860b; flex-shrink:0;"></div>
              <div style="flex:1; padding:11px 14px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.12em; text-transform:uppercase; color:#b8860b; margin-bottom:4px;">Executive Order · <%= eo['number'] %> · <%= eo['date'] %></div>
                <div style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:600; color:#1b3a6b; line-height:1.35; margin-bottom:6px;"><%= eo['title'] %></div>
                <% if eo['category'].present? %>
                  <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.08em; text-transform:uppercase; padding:2px 8px; border-radius:100px; background:#f0f3f8; color:#5a6e8a; border:0.5px solid #dde5f5;"><%= eo['category'] %></span>
                <% end %>
              </div>
            </div>
            <% if eo['slug'].present? %>
              </a>
            <% end %>
          <% end %>
        </div>
        <% end %>

        <%# Veto Record %>
        <% if official.veto_record.present? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Legislative Interaction</div>
          <h2 class="dp-section-title">Veto Record <span style="font-size:13px; font-weight:400; color:#8a9ab8; font-family:'JetBrains Mono',monospace; letter-spacing:0.06em;"><%= official.veto_count %> this term</span></h2>
          <% official.veto_record.each do |v| %>
            <% rail_color = { "vetoed" => "#7a1515", "signed" => "#27500A", "overridden" => "#633806" }[v['outcome']] || "#5a6e8a" %>
            <% if v['bill_id'].present? %>
            <a href="/bills/<%= v['bill_id'] %>" style="text-decoration:none; display:block;">
            <% end %>
            <div class="eo-card" style="display:flex; align-items:stretch; background:white; border:0.5px solid #dde5f5; border-radius:8px; margin-bottom:8px; overflow:hidden; transition:background 0.12s;">
              <div style="width:8px; background:<%= rail_color %>; flex-shrink:0;"></div>
              <div style="flex:1; padding:11px 14px;">
                <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.12em; text-transform:uppercase; color:<%= rail_color %>; margin-bottom:4px;">Legislature · <%= v['bill'] %> · <%= v['outcome'].capitalize %></div>
                <div style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:600; color:#1b3a6b; line-height:1.35; margin-bottom:5px;"><%= v['title'] %></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8;"><%= v['note'] %></div>
              </div>
            </div>
            <% if v['bill_id'].present? %>
            </a>
            <% end %>
          <% end %>
        </div>
        <% end %>

        <%# Q&A %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Community</div>
          <h2 class="dp-section-title">Q&amp;A</h2>
          <div style="background:white; border:1px solid rgba(27,58,107,0.09); border-radius:10px; padding:32px; text-align:center;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:8px;">Coming Soon</div>
            <p style="font-family:'Nunito',sans-serif; font-size:14px; color:#5a6e8a; line-height:1.6; margin:0;">Ask questions about this official's record and positions.</p>
          </div>
        </div>

        <%# Data note %>
        <div style="border-top:1px solid #e0e5ef; padding-top:14px; margin-top:4px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.14em; text-transform:uppercase; color:#b8860b; margin-bottom:5px;">◆ Data Note</div>
          <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#8a9ab8; line-height:1.6; margin:0;">Data hardcoded as of <%= official.data_as_of %>. Sources: governor.pa.gov, Franklin &amp; Marshall College Poll, PA General Assembly.</p>
        </div>

      </div><!-- /dp-main -->

      <%# ── SIDEBAR ── %>
      <div class="dp-sidebar">

        <%# Contact %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Contact</div>
          <div class="dp-card-entry">
            <div class="dp-card-sublabel">Office</div>
            <div class="dp-card-text"><%= official.office_address.presence || "Office address on file" %></div>
          </div>
          <% if official.website_url.present? %>
            <div class="dp-card-entry">
              <div class="dp-card-sublabel">Website</div>
              <a href="<%= official.website_url %>" target="_blank" rel="noopener" class="dp-card-text" style="text-decoration:underline; text-underline-offset:2px;"><%= official.website_url.gsub(/^https?:\/\//, '').split('/').first %> ↗</a>
            </div>
          <% end %>
          <% if official.contact_url.present? %>
            <div class="dp-card-entry">
              <div class="dp-card-sublabel">Constituent Request</div>
              <a href="<%= official.contact_url %>" target="_blank" rel="noopener" class="dp-card-text" style="text-decoration:underline; text-underline-offset:2px;">Submit online ↗</a>
            </div>
          <% end %>
        </div>

        <%# Budget %>
        <% if official.budget_total_billions.present? && official.budget_breakdown.present? %>
        <div class="dp-card">
          <div class="dp-card-title">◆ FY 2025–26 Budget</div>
          <%
            _gap  = 2.8
            _dr   = 40; _dc = (2 * Math::PI * _dr).round(3)
            _bd   = budget_sorted(official)
            _n    = _bd.size
            _arc  = _dc - (_n * _gap)
            _total = _bd.values.sum.to_f
            _cum  = 0.0
            _segs = _bd.map.with_index do |(cat, pct), i|
              len = ((pct.to_f / _total) * _arc).round(3)
              s = { cat: cat, pct: pct, color: budget_segment_color(cat), len: len, prior: _cum.round(3), idx: i }
              _cum += len + _gap; s
            end
            _d_total = "$#{official.budget_total_billions}B"
          %>
          <svg width="120" height="120" viewBox="0 0 120 120" style="display:block; margin:8px auto 14px; cursor:default;"
               data-ctx="dsk" data-total="<%= _d_total %>"
               onclick="bReset('dsk')">
            <circle cx="60" cy="60" r="<%= _dr %>" fill="none" stroke="#e8ecf4" stroke-width="14"/>
            <% _segs.each do |s| %>
              <circle id="bseg-dsk-<%= s[:idx] %>" cx="60" cy="60" r="<%= _dr %>" fill="none"
                stroke="<%= s[:color] %>" stroke-width="14" stroke-linecap="butt"
                stroke-dasharray="<%= s[:len] %> <%= _dc %>"
                stroke-dashoffset="<%= (_dc - s[:prior]).round(3) %>"
                transform="rotate(-90 60 60)"
                style="cursor:pointer; transition:opacity 0.18s;" data-active="0"
                data-name="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>"
                onclick="event.stopPropagation(); bFocus('dsk',<%= s[:idx] %>)"/>
            <% end %>
            <text id="bcv-dsk" x="60" y="56" text-anchor="middle" font-family="'Libre Baskerville',serif" font-size="13" font-weight="700" fill="#1b3a6b"><%= _d_total %></text>
            <text id="bcl-dsk" x="60" y="69" text-anchor="middle" font-family="'JetBrains Mono',monospace" font-size="5.5" fill="#8a9ab8" letter-spacing="0.5">GENERAL FUND</text>
          </svg>
          <div style="display:flex; flex-direction:column; gap:2px;">
            <% _segs.each do |s| %>
              <div id="bleg-dsk-<%= s[:idx] %>" class="dp-card-row" style="border-radius:4px; transition:background 0.15s; cursor:pointer; padding:3px 4px; margin:0 -4px;"
                   onclick="bFocus('dsk',<%= s[:idx] %>)">
                <div style="display:flex; align-items:center; gap:7px;">
                  <div style="width:8px; height:8px; border-radius:2px; background:<%= s[:color] %>; flex-shrink:0;"></div>
                  <span class="dp-card-label"><%= s[:cat].capitalize %></span>
                </div>
                <div style="display:flex; align-items:center; gap:5px;">
                  <span class="dp-card-value"><%= s[:pct] %>%</span>
                  <button data-title="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>" data-desc="<%= h(budget_description(s[:cat])) %>"
                          onclick="event.stopPropagation(); budModalOpen(this)"
                          style="background:none; border:none; cursor:pointer; font-size:9px; color:#b0bbd0; padding:0 1px; line-height:1; transition:color 0.12s;"
                          onmouseenter="this.style.color='#1b3a6b'" onmouseleave="this.style.color='#b0bbd0'">ⓘ</button>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <% end %>

        <%# Approval %>
        <% if official.approval_rating.present? %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Job Approval</div>
          <div style="font-family:'Libre Baskerville',serif; font-size:26px; font-weight:700; color:#1b3a6b; line-height:1; margin-bottom:8px;"><%= official.approval_rating %>%</div>
          <div style="height:6px; background:#e8ecf4; border-radius:3px; overflow:hidden; margin-bottom:6px;">
            <div style="width:<%= official.approval_rating %>%; height:100%; background:<%= official.approval_rating.to_i >= 50 ? '#155c2d' : '#8b2020' %>; border-radius:3px;"></div>
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8; letter-spacing:.08em;"><%= official.approval_source %></div>
        </div>
        <% end %>

        <%# Lt. Governor / VP — shown on governor/mayor/president profiles %>
        <% if official.lt_governor_name.present? && !%w[lt_governor vp].include?(official.office_type) %>
        <%  _lg_path  = official.office_type == 'president' ? us_vp_path : pa_lt_governor_path
            _lg_title = official.office_type == 'president' ? '◆ Vice President' : '◆ Lt. Governor'
            _lg_label = official.office_type == 'president' ? 'Vice President of the United States' : 'Lieutenant Governor of Pennsylvania' %>
        <a href="<%= _lg_path %>" style="text-decoration:none; display:block;">
        <div class="dp-card eo-card" style="transition:background 0.12s; cursor:pointer;">
          <div class="dp-card-title"><%= _lg_title %></div>
          <div style="display:flex; align-items:center; gap:12px; padding:4px 0;">
            <div style="width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,#254f92,#1b3a6b); display:flex; align-items:center; justify-content:center; font-family:'Libre Baskerville',serif; font-size:13px; font-weight:700; color:#d4a832; flex-shrink:0;"><%= official.lt_governor_initials %></div>
            <div style="flex:1;">
              <div class="dp-card-text" style="font-weight:700; color:#1b3a6b;"><%= official.lt_governor_name %></div>
              <div class="dp-card-sublabel" style="margin-top:2px;"><%= _lg_label %></div>
            </div>
            <span style="font-family:'JetBrains Mono',monospace; font-size:10px; color:#b8860b; flex-shrink:0;">→</span>
          </div>
        </div>
        </a>
        <% end %>

        <%# Term & Election %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Term &amp; Election</div>
          <div style="text-align:center; margin-bottom:14px;">
            <svg width="86" height="86" viewBox="0 0 86 86">
              <circle cx="43" cy="43" r="35" fill="none" stroke="#e8ecf4" stroke-width="6"/>
              <circle cx="43" cy="43" r="35" fill="none" stroke="<%= ring_color %>" stroke-width="6"
                stroke-dasharray="<%= _ring_circ %>" stroke-dashoffset="<%= ring_offset %>"
                stroke-linecap="round" transform="rotate(-90 43 43)"/>
              <text x="43" y="39" text-anchor="middle" dominant-baseline="central"
                style="font-family:'Libre Baskerville',serif;font-size:17px;font-weight:700;fill:#0e1a2e;"><%= "Yr #{year_num}" %></text>
              <text x="43" y="57" text-anchor="middle"
                style="font-family:'JetBrains Mono',monospace;font-size:7px;fill:#8a9ab8;">of 4 done</text>
            </svg>
          </div>
          <% exec_timeline.each_with_index do |row, i| %>
            <% tl_last = (i == exec_timeline.size - 1) %>
            <div style="display:flex; gap:10px;">
              <div style="display:flex; flex-direction:column; align-items:center; flex-shrink:0; width:14px;">
                <div style="width:9px; height:9px; border-radius:50%; background:<%= row[:dot_color] %>; flex-shrink:0;<%= row[:now] ? " border:2px solid white; box-shadow:0 0 0 2px #{ring_color};" : "" %>"></div>
                <% unless tl_last %>
                  <div style="width:1.5px; flex:1; min-height:12px; background:<%= row[:line_color] || "#e8ecf4" %>;"></div>
                <% end %>
              </div>
              <div style="padding-bottom:<%= tl_last ? '0' : '12px' %>; flex:1;">
                <div style="font-family:'Nunito',sans-serif; font-size:11px; font-weight:700; color:#0e1a2e;"><%= row[:evt] %></div>
                <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8; margin-top:1px;"><%= row[:date] %></div>
                <% if row[:badge] %>
                  <% if row[:badge][:glow] || row[:glow] %>
                    <span class="tl-badge-glow"><%= row[:badge][:text] %></span>
                  <% else %>
                    <span class="tl-badge" style="<%= row[:badge][:style] %>"><%= row[:badge][:text] %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <%# Divided government %>
        <% if official.divided_gov_note.present? %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Legislative Context</div>
          <p style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.6; margin:0;"><%= official.divided_gov_note %></p>
        </div>
        <% end %>

      </div><!-- /dp-sidebar -->
    </div><!-- /dp-body -->
  </div>

</div><!-- /desktop-profile -->


<!-- ══════════════════════════════════════════
     MOBILE CARD
══════════════════════════════════════════ -->
<div class="mobile-profile">
<div class="mobile-card">

  <!-- Section 1 · Card Front -->
  <div style="background:#1b3a6b; position:relative; overflow:hidden;">

    <!-- Photo zone -->
    <div style="height:260px; overflow:hidden; position:relative;">
