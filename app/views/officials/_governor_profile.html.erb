            <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.08em; text-transform:uppercase; padding:2px 8px; border-radius:100px; background:#f0f3f8; color:#5a6e8a; border:0.5px solid #dde5f5;"><%= eo['category'] %></span>
