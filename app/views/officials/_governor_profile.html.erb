          <span style="font-family:'JetBrains Mono',monospace; font-size:7.5px; padding:2px 7px; border-radius:8px; <%= row[:tension_style] %>"><%= row[:tension] %></span>
          <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#8a9ab8;">Full breakdown ›</span>
        </div>
      </div>
    <% end %>
  </div>
  <% end %>

  <!-- Section 2 · Policy priorities -->
