        <%# Lt. Governor sidebar cards %>
        <% if official.office_type == 'lt_governor' %>

        <%# Succession %>
        <div class="dp-card">
          <div class="dp-card-title">◆ If Shapiro Leaves Office</div>
          <div style="background:#f8f6f0; border-radius:6px; padding:10px 12px; margin-bottom:10px;">
            <div style="display:flex; align-items:center; gap:8px; padding:5px 0; border-bottom:0.5px solid rgba(27,58,107,0.09);">
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; min-width:16px;">1</div>
              <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#1b3a6b;">Josh Shapiro</div>
              <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; margin-left:auto;">Governor</div>
            </div>
            <div style="display:flex; align-items:center; gap:8px; padding:5px 0;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#b8860b; min-width:16px;">2</div>
              <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#b8860b;">Austin Davis</div>
              <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#b8860b; margin-left:auto;">becomes Governor</div>
            </div>
          </div>
          <p style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; line-height:1.55; margin:0;">If Shapiro resigned, was removed, or died in office, Davis would become Governor immediately. No special election — he serves the remainder of the term. This is the single most consequential thing about this office.</p>
        </div>

        <%# 2026 Race %>
        <div class="dp-card">
          <div class="dp-card-title">◆ 2026 Governor's Race</div>
          <div style="background:#f8f6f0; border-radius:6px; padding:10px 12px;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.12em; text-transform:uppercase; color:#8a9ab8; margin-bottom:5px;">Running for Governor</div>
            <div style="font-family:'Nunito',sans-serif; font-size:12px; color:#1b3a6b; line-height:1.5;">Shapiro and Davis announced they are running for re-election together. Davis is considered a top Democratic gubernatorial contender regardless.</div>
            <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; margin-top:5px; font-style:italic;">The 2026 PA governor's race is one of 31 Davis is organizing as DLGA chair — including his own.</div>
          </div>
        </div>

        <%# What he can't do %>
        <div class="dp-card">
          <div class="dp-card-title">◆ What He Can't Do</div>
          <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.6;">
            <% [
              "Cannot introduce legislation — he's not a senator",
              'Cannot grant pardons himself — recommends to the Governor only',
              'Cannot direct state agencies — he has no executive cabinet',
              'Cannot act independently of Shapiro on budget or policy'
            ].each_with_index do |item, i| %>
              <div style="padding:6px 0; <%= i < 3 ? 'border-bottom:0.5px solid rgba(27,58,107,0.08);' : '' %>"><%= item %></div>
            <% end %>
          </div>
        </div>

        <% end %><%# /lt_governor sidebar %>

        <%# VP sidebar cards %>
        <% if official.office_type == 'vp' %>

        <%# Succession %>
        <div class="dp-card">
          <div class="dp-card-title">◆ If Trump Leaves Office</div>
          <div style="background:#f8f6f0; border-radius:6px; padding:10px 12px; margin-bottom:10px;">
            <div style="display:flex; align-items:center; gap:8px; padding:5px 0; border-bottom:0.5px solid rgba(27,58,107,0.09);">
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; min-width:16px;">1</div>
              <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#1b3a6b;">Donald Trump</div>
              <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; margin-left:auto;">President</div>
            </div>
            <div style="display:flex; align-items:center; gap:8px; padding:5px 0;">
              <div style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#b8860b; min-width:16px;">2</div>
              <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:700; color:#b8860b;">JD Vance</div>
              <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#b8860b; margin-left:auto;">becomes President</div>
            </div>
          </div>
          <p style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; line-height:1.55; margin:0;">If Trump resigned, was removed, or died in office, Vance would become President immediately — no election. He would serve the remainder of the term through January 2029. This is the single most consequential fact about this office.</p>
        </div>

        <%# 2028 Race %>
        <div class="dp-card">
          <div class="dp-card-title">◆ 2028 Presidential Race</div>
          <div style="background:#f8f6f0; border-radius:6px; padding:10px 12px;">
            <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.12em; text-transform:uppercase; color:#8a9ab8; margin-bottom:5px;">Heir apparent</div>
            <div style="font-family:'Nunito',sans-serif; font-size:12px; color:#1b3a6b; line-height:1.5;">Trump has publicly called Vance his likely successor. No major Republican has announced a 2028 challenge. Vance is building a national donor network and policy profile from the VP's office.</div>
            <div style="font-family:'Nunito',sans-serif; font-size:10px; color:#8a9ab8; margin-top:5px; font-style:italic;">Every high-profile foreign policy assignment doubles as a 2028 primary audition.</div>
          </div>
        </div>

        <%# What he can't do %>
        <div class="dp-card">
          <div class="dp-card-title">◆ What He Can't Do</div>
          <div style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; line-height:1.6;">
            <% [
              "Cannot vote in the Senate except to break a 50–50 tie",
              "Cannot introduce legislation — he's not a senator",
              "Cannot direct executive agencies independently of Trump",
              "Cannot conduct foreign policy unilaterally — only represents Trump's positions"
            ].each_with_index do |item, i| %>
              <div style="padding:6px 0; <%= i < 3 ? 'border-bottom:0.5px solid rgba(27,58,107,0.08);' : '' %>"><%= item %></div>
            <% end %>
          </div>
        </div>

        <% end %><%# /vp sidebar %>

        <%# Budget %>
        <% if official.budget_total_billions.present? && official.budget_breakdown.present? %>
        <div class="dp-card">
          <div class="dp-card-title">◆ FY 2025–26 Budget</div>
          <%
            _gap  = 2.8
            _dr   = 40; _dc = (2 * Math::PI * _dr).round(3)
            _bd   = budget_sorted(official)
            _n    = _bd.size
            _arc  = _dc - (_n * _gap)
            _total = _bd.values.sum.to_f
            _cum  = 0.0
            _segs = _bd.map.with_index do |(cat, pct), i|
              len = ((pct.to_f / _total) * _arc).round(3)
              s = { cat: cat, pct: pct, color: budget_segment_color(cat), len: len, prior: _cum.round(3), idx: i }
              _cum += len + _gap; s
            end
            _d_total = official.budget_total_billions >= 1000 ? "$#{(official.budget_total_billions / 1000.0).round(1)}T" : "$#{official.budget_total_billions}B"
          %>
          <svg width="120" height="120" viewBox="0 0 120 120" style="display:block; margin:8px auto 14px; cursor:default;"
               data-ctx="dsk" data-total="<%= _d_total %>"
               onclick="bReset('dsk')">
            <circle cx="60" cy="60" r="<%= _dr %>" fill="none" stroke="#e8ecf4" stroke-width="14"/>
            <% _segs.each do |s| %>
              <circle id="bseg-dsk-<%= s[:idx] %>" cx="60" cy="60" r="<%= _dr %>" fill="none"
                stroke="<%= s[:color] %>" stroke-width="14" stroke-linecap="butt"
                stroke-dasharray="<%= s[:len] %> <%= (_dc - s[:len]).round(3) %>"
                stroke-dashoffset="<%= (_dc - s[:prior]).round(3) %>"
                transform="rotate(-90 60 60)"
                style="cursor:pointer; transition:opacity 0.18s;" data-active="0"
                data-name="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>"
                onclick="event.stopPropagation(); bFocus('dsk',<%= s[:idx] %>)"/>
            <% end %>
            <text id="bcv-dsk" x="60" y="56" text-anchor="middle" font-family="'Libre Baskerville',serif" font-size="13" font-weight="700" fill="#1b3a6b"><%= _d_total %></text>
            <text id="bcl-dsk" x="60" y="69" text-anchor="middle" font-family="'JetBrains Mono',monospace" font-size="5.5" fill="#8a9ab8" letter-spacing="0.5">GENERAL FUND</text>
          </svg>
          <div style="display:flex; flex-direction:column; gap:2px;">
            <% _segs.each do |s| %>
              <div id="bleg-dsk-<%= s[:idx] %>" class="dp-card-row" style="border-radius:4px; transition:background 0.15s; cursor:pointer; padding:3px 4px; margin:0 -4px;"
                   onclick="bFocus('dsk',<%= s[:idx] %>)">
                <div style="display:flex; align-items:center; gap:7px;">
                  <div style="width:8px; height:8px; border-radius:2px; background:<%= s[:color] %>; flex-shrink:0;"></div>
                  <span class="dp-card-label"><%= s[:cat].capitalize %></span>
                </div>
                <div style="display:flex; align-items:center; gap:5px;">
                  <span class="dp-card-value"><%= s[:pct] %>%</span>
                  <button data-title="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>" data-desc="<%= h(budget_description(s[:cat])) %>"
                          onclick="event.stopPropagation(); budModalOpen(this)"
                          style="background:none; border:none; cursor:pointer; font-size:9px; color:#b0bbd0; padding:0 1px; line-height:1; transition:color 0.12s;"
                          onmouseenter="this.style.color='#1b3a6b'" onmouseleave="this.style.color='#b0bbd0'">ⓘ</button>
                </div>
              </div>
            <% end %>
          </div>
        </div>
        <% end %>

        <%# Approval %>
        <% if official.approval_rating.present? %>
        <div class="dp-card">
          <div class="dp-card-title">◆ Job Approval</div>
          <div style="font-family:'Libre Baskerville',serif; font-size:26px; font-weight:700; color:#1b3a6b; line-height:1; margin-bottom:8px;"><%= official.approval_rating %>%</div>
          <div style="height:6px; background:#e8ecf4; border-radius:3px; overflow:hidden; margin-bottom:6px;">
            <div style="width:<%= official.approval_rating %>%; height:100%; background:<%= official.approval_rating.to_i >= 50 ? '#155c2d' : '#8b2020' %>; border-radius:3px;"></div>
          </div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#8a9ab8; letter-spacing:.08em;"><%= official.approval_source %></div>
        </div>
        <% end %>

        <%# Lt. Governor / VP — shown on governor/mayor/president profiles %>
        <% if official.lt_governor_name.present? && !%w[lt_governor vp].include?(official.office_type) %>
        <%  _lg_path  = official.office_type == 'president' ? us_vp_path : pa_lt_governor_path
            _lg_title = official.office_type == 'president' ? '◆ Vice President' : '◆ Lt. Governor'
            _lg_label = official.office_type == 'president' ? 'Vice President of the United States' : 'Lieutenant Governor of Pennsylvania' %>
        <a href="<%= _lg_path %>" style="text-decoration:none; display:block;">
        <div class="dp-card eo-card" style="transition:background 0.12s; cursor:pointer;">
          <div class="dp-card-title"><%= _lg_title %></div>
          <div style="display:flex; align-items:center; gap:12px; padding:4px 0;">
            <div style="width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,#254f92,#1b3a6b); display:flex; align-items:center; justify-content:center; font-family:'Libre Baskerville',serif; font-size:13px; font-weight:700; color:#d4a832; flex-shrink:0;"><%= official.lt_governor_initials %></div>
