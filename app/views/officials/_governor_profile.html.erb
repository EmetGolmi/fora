    <% official.executive_orders.each do |eo| %>
      <% if eo['slug'].present? %>
        <a href="/eo/<%= eo['slug'] %>" style="text-decoration:none; display:flex; align-items:stretch; color:inherit;">
      <% end %>
      <div class="eo-card" style="display:flex; align-items:stretch; background:white; border:0.5px solid #dde5f5; border-radius:8px; margin-bottom:8px; overflow:hidden; transition:background 0.12s; width:100%;">
        <div style="width:8px; background:#b8860b; flex-shrink:0;"></div>
        <div style="flex:1; padding:10px 12px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.1em; text-transform:uppercase; color:#b8860b; margin-bottom:3px;">Executive Order · <%= eo['number'] %> · <%= eo['date'] %></div>
          <div style="font-family:'Nunito',sans-serif; font-size:12px; font-weight:600; color:#1b3a6b; line-height:1.35; margin-bottom:5px;"><%= eo['title'] %></div>
          <% if eo['category'].present? %>
            <span style="font-family:'JetBrains Mono',monospace; font-size:6.5px; letter-spacing:.08em; text-transform:uppercase; padding:2px 8px; border-radius:100px; background:#f0f3f8; color:#5a6e8a; border:0.5px solid #dde5f5;"><%= eo['category'] %></span>
          <% end %>
        </div>
      </div>
      <% if eo['slug'].present? %>
        </a>
      <% end %>
    <% end %>
  </div>
  <% end %>

  <!-- Section 4 · Budget -->
  <% if official.budget_total_billions.present? && official.budget_breakdown.present? %>
  <div style="padding:20px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ FY 2025–26 Budget</div>
    <%
      _mgap  = 2.8
      _mdr   = 48; _mdc = (2 * Math::PI * _mdr).round(3)
      _mbd   = budget_sorted(official)
      _mn    = _mbd.size
      _marc  = _mdc - (_mn * _mgap)
      _mt    = _mbd.values.sum.to_f
      _mc    = 0.0
      _msegs = _mbd.map.with_index do |(cat, pct), i|
        len = ((pct.to_f / _mt) * _marc).round(3)
        s = { cat: cat, pct: pct, color: budget_segment_color(cat), len: len, prior: _mc.round(3), idx: i }
        _mc += len + _mgap; s
      end
      _m_total = "$#{official.budget_total_billions}B"
    %>
    <svg width="140" height="140" viewBox="0 0 140 140" style="display:block; margin:0 auto 14px; cursor:default;"
         data-ctx="mob" data-total="<%= _m_total %>"
         onclick="bReset('mob')">
      <circle cx="70" cy="70" r="<%= _mdr %>" fill="none" stroke="#e8ecf4" stroke-width="16"/>
      <% _msegs.each do |s| %>
        <circle id="bseg-mob-<%= s[:idx] %>" cx="70" cy="70" r="<%= _mdr %>" fill="none"
          stroke="<%= s[:color] %>" stroke-width="16" stroke-linecap="butt"
          stroke-dasharray="<%= s[:len] %> <%= _mdc %>"
          stroke-dashoffset="<%= (_mdc - s[:prior]).round(3) %>"
          transform="rotate(-90 70 70)"
          style="cursor:pointer; transition:opacity 0.18s;" data-active="0"
          data-name="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>"
          onclick="event.stopPropagation(); bFocus('mob',<%= s[:idx] %>)"/>
      <% end %>
      <text id="bcv-mob" x="70" y="66" text-anchor="middle" font-family="'Libre Baskerville',serif" font-size="16" font-weight="700" fill="#1b3a6b"><%= _m_total %></text>
      <text id="bcl-mob" x="70" y="80" text-anchor="middle" font-family="'JetBrains Mono',monospace" font-size="6" fill="#8a9ab8" letter-spacing="0.5">GENERAL FUND</text>
    </svg>
    <% _msegs.each do |s| %>
      <div id="bleg-mob-<%= s[:idx] %>" style="display:flex; justify-content:space-between; align-items:center; padding:5px 4px; border-bottom:1px solid rgba(27,58,107,0.05); border-radius:4px; transition:background 0.15s; cursor:pointer; margin:0 -4px;"
           onclick="bFocus('mob',<%= s[:idx] %>)">
        <div style="display:flex; align-items:center; gap:6px;">
          <div style="width:8px; height:8px; border-radius:2px; background:<%= s[:color] %>;"></div>
          <span style="font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a;"><%= s[:cat].capitalize %></span>
        </div>
        <div style="display:flex; align-items:center; gap:5px;">
          <span style="font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; color:#1b3a6b;"><%= s[:pct] %>%</span>
          <button data-title="<%= h(s[:cat].capitalize) %>" data-pct="<%= s[:pct] %>" data-clr="<%= s[:color] %>" data-desc="<%= h(budget_description(s[:cat])) %>"
                  onclick="event.stopPropagation(); budModalOpen(this)"
                  style="background:none; border:none; cursor:pointer; font-size:11px; color:#b0bbd0; padding:0 1px; line-height:1;">ⓘ</button>
        </div>
      </div>
    <% end %>
  </div>
  <% end %>

  <!-- Section 5 · Contact footer -->
  <div style="padding:16px 20px; display:flex; gap:10px;">
    <% if official.contact_url.present? %>
      <a href="<%= official.contact_url %>" target="_blank" rel="noopener" style="flex:1; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:.12em; text-transform:uppercase; text-align:center; padding:10px 8px; background:#1b3a6b; color:white; border-radius:8px; text-decoration:none;">Contact Office</a>
    <% end %>
    <% if official.website_url.present? %>
      <a href="<%= official.website_url %>" target="_blank" rel="noopener" style="flex:1; font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:.12em; text-transform:uppercase; text-align:center; padding:10px 8px; background:white; color:#1b3a6b; border:1px solid rgba(27,58,107,0.2); border-radius:8px; text-decoration:none;">governor.pa.gov ↗</a>
    <% end %>
  </div>

</div>
</div>

<div id="bud-modal" onclick="if(event.target===this)budModalClose()" style="display:none; position:fixed; inset:0; background:rgba(14,26,46,0.55); z-index:9000; align-items:center; justify-content:center; padding:20px;">
  <div style="background:#fff; border-radius:14px; max-width:420px; width:100%; padding:24px 24px 20px; position:relative; box-shadow:0 8px 32px rgba(14,26,46,0.18);">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
      <div id="bud-modal-dot" style="width:12px; height:12px; border-radius:3px; flex-shrink:0;"></div>
      <div style="flex:1;">
        <div id="bud-modal-title" style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:#0e1a2e;"></div>
        <div id="bud-modal-pct" style="font-family:'JetBrains Mono',monospace; font-size:9px; color:#8a9ab8; margin-top:2px;"></div>
      </div>
      <button onclick="budModalClose()" style="background:none; border:none; cursor:pointer; font-size:20px; color:#8a9ab8; padding:0 4px; line-height:1;">×</button>
    </div>
    <p id="bud-modal-desc" style="font-family:'Nunito',sans-serif; font-size:13px; color:#3a4e6a; line-height:1.65; margin:0;"></p>
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; color:#b8c0d0; letter-spacing:.08em; margin-top:14px; text-transform:uppercase;">FY 2025–26 · General Fund</div>
  </div>
</div>

<script>
function budModalOpen(el) {
  var m = document.getElementById('bud-modal');
  if (!m) return;
  document.getElementById('bud-modal-title').textContent = el.dataset.title;
  document.getElementById('bud-modal-pct').textContent   = el.dataset.pct + '% of General Fund';
  document.getElementById('bud-modal-dot').style.background = el.dataset.clr;
  document.getElementById('bud-modal-desc').textContent  = el.dataset.desc;
  m.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function budModalClose() {
  var m = document.getElementById('bud-modal');
  if (m) m.style.display = 'none';
  document.body.style.overflow = '';
}
document.addEventListener('keydown', function(e){ if(e.key==='Escape') budModalClose(); });

function bFocus(ctx, i) {
  var seg = document.getElementById('bseg-'+ctx+'-'+i);
  if (!seg) return;
  var isOn = seg.dataset.active === '1';
  bReset(ctx);
  if (isOn) return;
  var j = 0, s;
  while ((s = document.getElementById('bseg-'+ctx+'-'+j))) {
    s.style.opacity = (j === i) ? '1' : '0.18';
    j++;
  }
  seg.dataset.active = '1';
  var name = seg.dataset.name, pct = seg.dataset.pct, color = seg.dataset.clr;
  var cv = document.getElementById('bcv-'+ctx);
  var cl = document.getElementById('bcl-'+ctx);
  if (cv) { cv.textContent = pct+'%'; cv.setAttribute('fill', color); }
  if (cl) { cl.textContent = name.toUpperCase(); cl.setAttribute('fill', color); }
  var row = document.getElementById('bleg-'+ctx+'-'+i);
  if (row) row.style.background = 'rgba(0,0,0,0.045)';
}
function bReset(ctx) {
  var j = 0, s;
  while ((s = document.getElementById('bseg-'+ctx+'-'+j))) {
    s.style.opacity = '1';
    s.dataset.active = '0';
    var r = document.getElementById('bleg-'+ctx+'-'+j);
    if (r) r.style.background = '';
    j++;
  }
  var svg = document.querySelector('[data-ctx="'+ctx+'"]');
  var cv = document.getElementById('bcv-'+ctx);
  var cl = document.getElementById('bcl-'+ctx);
  if (cv) { cv.textContent = svg ? svg.dataset.total : ''; cv.setAttribute('fill','#1b3a6b'); }
  if (cl) { cl.textContent = 'GENERAL FUND'; cl.setAttribute('fill','#8a9ab8'); }
}
</script>
