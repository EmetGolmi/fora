        <img src="<%= official.photo_url %>" alt="" style="width:100%; height:100%; object-fit:cover; object-position:50% 15%; display:block;">
      <% else %>
        <div style="width:100%; height:100%; background:linear-gradient(135deg,#254f92,#1b3a6b); display:flex; align-items:center; justify-content:center; font-family:'Libre Baskerville',serif; font-size:52px; font-weight:700; color:#d4a832;"><%= gov_initials %></div>
      <% end %>
      <div style="position:absolute; bottom:0; left:0; right:0; height:90px; background:linear-gradient(to bottom,transparent,#0a1220); pointer-events:none;"></div>
      <div class="mob-foil" style="position:absolute; inset:0;"></div>
    </div>

    <!-- Nameplate -->
    <div style="background:#003087; padding:10px 16px 10px 21px; border-bottom:1.5px solid rgba(184,134,11,.3);">
      <div style="font-family:'Libre Baskerville',serif; font-size:20px; font-weight:700; color:white; line-height:1.2;"><%= official.full_name %></div>
      <div style="font-family:'JetBrains Mono',monospace; font-size:7px; text-transform:uppercase; letter-spacing:.12em; color:#d4a832; margin-top:3px;"><%= official.office_title %></div>
    </div>

    <!-- Quick stats strip -->
    <div style="background:#003087; display:flex;">
      <% if official.office_type == 'lt_governor' %>
        <% yr_mob = ((Date.today - official.term_start) / 365.25).floor + 1 %>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;">34th</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Lt. Governor</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;">Yr <%= yr_mob %></div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">of 4-yr Term</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px;">
          <div style="font-family:'Libre Baskerville',serif; font-size:13px; font-weight:700; color:white; line-height:1; padding-top:2px;">Senate</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">President</div>
        </div>
      <% elsif official.office_type == 'managing_director' %>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;">26</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Departments</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:14px; font-weight:700; color:white; line-height:1;">~26K</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Employees</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px;">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;">2024</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Since</div>
        </div>
      <% elsif official.office_type == 'finance_director' %>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:14px; font-weight:700; color:white; line-height:1;">$6.8B</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Budget</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:14px; font-weight:700; color:white; line-height:1;">18 yrs</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">In Role</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px;">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;">AA</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Bond Rating</div>
        </div>
      <% else %>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= official.bills_signed_count %></div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Bills Signed</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px; border-right:1px solid rgba(255,255,255,.06);">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= official.veto_count %></div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Vetoes</div>
        </div>
        <div style="flex:1; text-align:center; padding:10px 6px;">
          <div style="font-family:'Libre Baskerville',serif; font-size:16px; font-weight:700; color:white; line-height:1;"><%= official.approval_rating %>%</div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:5.5px; text-transform:uppercase; letter-spacing:.1em; color:rgba(255,255,255,.28); margin-top:4px;">Approval</div>
        </div>
      <% end %>
    </div>

    <!-- Social row -->
    <div style="background:#003087; padding:8px 14px 8px 21px; display:flex; align-items:center; justify-content:space-between;">
      <div style="display:flex; gap:14px; align-items:center;">
        <% if official.website_url.present? %>
          <a href="<%= official.website_url %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </a>
        <% end %>
        <% if official.twitter_handle.present? %>
          <a href="https://x.com/<%= official.twitter_handle %>" target="_blank" rel="noopener" style="color:rgba(255,255,255,.4); line-height:0; text-decoration:none;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        <% end %>
      </div>
      <a href="<%= official.contact_url %>" target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.14em; text-transform:uppercase; color:rgba(255,255,255,.5); text-decoration:none;">Contact Office ↗</a>
    </div>
  </div>

  <!-- Section 2 · Policy priorities -->
  <% if official.policy_priorities.present? %>
  <div style="padding:20px 20px 4px; border-bottom:1px solid rgba(27,58,107,0.06);">
    <div style="font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:.18em; text-transform:uppercase; color:#b8860b; margin-bottom:10px;">◆ Policy Priorities</div>
    <% official.policy_priorities.each do |p| %>
      <% pct = p['level'] == 'high' ? 82 : 52 %>
      <div style="display:flex; align-items:center; gap:8px; padding:6px 0; border-bottom:1px solid rgba(27,58,107,0.05);">
        <div style="width:7px; height:7px; border-radius:50%; background:<%= p['color'] %>; flex-shrink:0;"></div>
        <div style="font-family:'Nunito',sans-serif; font-size:12px; color:#2d3a50; flex:1; line-height:1.35;"><%= p['name'] %></div>
        <div style="width:50px; height:3px; background:#e8ecf4; border-radius:2px; overflow:hidden; flex-shrink:0;">
          <div style="width:<%= pct %>%; height:100%; background:<%= p['color'] %>; border-radius:2px;"></div>
        </div>
      </div>
    <% end %>
  </div>
  <% end %>

  <!-- Section 3 · Executive orders -->
  <% if official.executive_orders.present? %>
  <div style="padding:16px 16px 8px; border-bottom:1px solid rgba(27,58,107,0.06);">
