          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Q&A -->
    <div style="padding:12px 14px 28px;">
      <div style="font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:.18em;text-transform:uppercase;color:#b8860b;margin-bottom:4px;">◆ Community</div>
      <h3 style="font-family:'Libre Baskerville',serif;font-size:15px;font-weight:700;color:#1b3a6b;margin:0 0 10px;">Q&amp;A</h3>
      <div style="background:white;border-radius:8px;padding:18px 14px;text-align:center;border:0.5px solid #dde5f5;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:#b8860b;margin-bottom:6px;">Coming Soon</div>
        <p style="font-family:'Nunito',sans-serif;font-size:11px;color:#5a6e8a;line-height:1.55;margin:0;">Ask questions about this official's record, votes, and positions.</p>
      </div>
    </div>

  </div><!-- /profile sections -->

</div><!-- /mobile-card -->
</div><!-- /background -->
</div><!-- /mobile-profile -->


<!-- ─────────────────────────────────────
     MODALS (mobile sheet modals)
───────────────────────────────────────── -->
<div id="modal-term" class="mob-modal" onclick="if(event.target===this)closeModal('modal-term')">
  <div class="mob-sheet">
    <div class="mob-handle"></div>
    <div style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:#b8860b;margin-bottom:5px;">◆ About This Stat</div>
    <h3 style="font-family:'Libre Baskerville',serif;font-size:18px;font-weight:700;color:#1b3a6b;margin:0 0 12px;">Term &amp; Election</h3>
    <p style="font-family:'Nunito',sans-serif;font-size:13px;color:#4a5568;line-height:1.65;margin:0 0 22px;"><%= static[:term_blurb] %></p>
    <button class="mob-got-it" onclick="closeModal('modal-term')">Got it</button>
  </div>
</div>

<div id="modal-committees-info" class="mob-modal" onclick="if(event.target===this)closeModal('modal-committees-info')">
  <div class="mob-sheet">
    <div class="mob-handle"></div>
    <div style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:#b8860b;margin-bottom:5px;">◆ About Committees</div>
    <h3 style="font-family:'Libre Baskerville',serif;font-size:18px;font-weight:700;color:#1b3a6b;margin:0 0 12px;">Where Bills Live or Die</h3>
    <p style="font-family:'Nunito',sans-serif;font-size:13px;color:#4a5568;line-height:1.65;margin:0 0 10px;">Most bills never reach a floor vote. They're assigned to a committee where they're reviewed, amended, or quietly shelved. Committee members decide what moves forward.</p>
    <p style="font-family:'Nunito',sans-serif;font-size:13px;color:#4a5568;line-height:1.65;margin:0 0 22px;">Knowing which committees a member sits on tells you where their power is concentrated — and which industries they're positioned to influence most.</p>
    <button class="mob-got-it" onclick="closeModal('modal-committees-info')">Got it</button>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.mob-modal.open').forEach(function(m) {
        m.classList.remove('open');
      });
      document.body.style.overflow = '';
    }
  });
  function dpShare() {
    var url = window.location.href;
    var title = '<%= s_name %> — FORA';
    if (navigator.share) {
      navigator.share({ title: title, url: url }).catch(function() {});
    } else {
      navigator.clipboard.writeText(url).then(function() {
        alert('Link copied!');
      }).catch(function() {
        prompt('Copy this link:', url);
      });
    }
  }
</script>
