<!-- ══════════════════════════════════════════
     DESKTOP LAYOUT  (reuses dp-* CSS from application.css)
══════════════════════════════════════════ -->
<div class="desktop-profile">

  <!-- Hero -->
  <div class="dp-hero">
    <div style="position:absolute;right:-40px;top:-60px;width:340px;height:340px;border-radius:50%;border:36px solid rgba(255,255,255,0.025);pointer-events:none;"></div>
    <div style="position:absolute;right:40px;top:-20px;width:200px;height:200px;border-radius:50%;border:1px solid rgba(184,134,11,0.15);pointer-events:none;"></div>

    <div class="dp-hero-inner">
      <a href="javascript:history.back()" class="dp-hero-back">← My Government</a>

      <div class="dp-hero-identity">
        <div class="dp-avatar">
          <% if s_photo %>
            <img src="<%= s_photo %>" alt="<%= s_name %>">
          <% else %>
            <div class="dp-avatar-initials"><%= s_initials %></div>
          <% end %>
          <div class="dp-avatar-badge">✓</div>
        </div>
        <div>
          <h1 class="dp-name"><%= s_name %></h1>
          <p class="dp-office-title"><%= s_office %></p>
          <div class="dp-tags">
            <% if party_raw.present? %>
              <span class="dp-tag" style="<%= party_tag_style %>"><%= party_raw %></span>
            <% end %>
          </div>
          <div class="dp-social">
            <% if static[:social][:website].present? %>
              <a href="<%= static[:social][:website] %>" target="_blank" rel="noopener" class="dp-social-link" title="Website">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </a>
            <% end %>
            <% if static[:social][:twitter].present? %>
              <a href="https://x.com/<%= static[:social][:twitter] %>" target="_blank" rel="noopener" class="dp-social-link" title="X">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            <% end %>
            <% if static[:social][:instagram].present? %>
              <a href="https://instagram.com/<%= static[:social][:instagram] %>" target="_blank" rel="noopener" class="dp-social-link" title="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
              </a>
            <% end %>
            <% if static[:social][:youtube].present? %>
              <a href="<%= static[:social][:youtube] %>" target="_blank" rel="noopener" class="dp-social-link" title="YouTube">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            <% end %>
            <button onclick="dpShare()" class="dp-social-link" style="background:none;border:none;cursor:pointer;padding:0;line-height:0;" title="Share">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:rgba(255,255,255,0.55);"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Stat bar — True Color background -->
      <div class="dp-stat-bar" style="background:<%= static[:true_color_bg] %>; border-top:0.5px solid rgba(255,255,255,0.06);">
        <% static[:stats].each do |val, label| %>
          <div class="dp-stat">
            <div class="dp-stat-value"><%= val %></div>
            <div class="dp-stat-label"><%= label %></div>
          </div>
        <% end %>
      </div>
    </div><!-- /dp-hero-inner -->

    <div class="dp-stars">★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★</div>
  </div><!-- /dp-hero -->

  <div style="background:#f2f4f8; padding:1px 0;">
    <div class="dp-body">
      <div class="dp-main">

        <!-- News -->
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Recent Coverage</div>
          <h2 class="dp-section-title">Latest News</h2>
          <% static[:news].each do |n| %>
            <div style="display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid rgba(27,58,107,0.06);">
              <div style="width:7px;height:7px;border-radius:50%;background:<%= n[:dot] %>;flex-shrink:0;"></div>
              <span style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:#8a9ab8;width:60px;flex-shrink:0;"><%= n[:source] %></span>
              <span style="font-family:'Nunito',sans-serif;font-size:12px;color:#2d3a50;flex:1;line-height:1.4;"><%= n[:text] %></span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:7px;color:#8a9ab8;flex-shrink:0;"><%= n[:age] %></span>
            </div>
          <% end %>
          <p style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:#b0b8c8;margin-top:8px;">* News via NewsAPI · fora.center · Last updated March 2026</p>
        </div>

        <!-- Term & Election Timeline -->
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Term &amp; Election</div>
          <h2 class="dp-section-title">Where We Are</h2>
          <div style="display:flex;align-items:center;gap:20px;margin-bottom:20px;">
            <svg width="86" height="86" viewBox="0 0 86 86" style="flex-shrink:0;">
              <circle cx="43" cy="43" r="35" fill="none" stroke="#e8ecf4" stroke-width="6"/>
              <circle cx="43" cy="43" r="35" fill="none" stroke="<%= static[:ring_color] %>" stroke-width="6"
                stroke-dasharray="<%= ring_circ %>" stroke-dashoffset="<%= ring_offset.round(2) %>"
                stroke-linecap="round" transform="rotate(-90 43 43)"/>
              <text x="43" y="39" text-anchor="middle" dominant-baseline="central"
                style="font-family:'Libre Baskerville',serif;font-size:17px;font-weight:700;fill:#0e1a2e;"><%= static[:ring_label] %></text>
              <text x="43" y="57" text-anchor="middle"
                style="font-family:'JetBrains Mono',monospace;font-size:7px;fill:#8a9ab8;"><%= static[:ring_sub] %></text>
            </svg>
            <p style="font-family:'Nunito',sans-serif;font-size:12px;color:#5a6e8a;line-height:1.65;"><%= static[:term_blurb] %></p>
          </div>

          <% static[:timeline].each_with_index do |row, i| %>
            <% is_last = (i == static[:timeline].size - 1) %>
            <div style="display:flex;gap:12px;">
              <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;width:16px;">
                <div style="width:10px;height:10px;border-radius:50%;background:<%= row[:dot_color] %>;flex-shrink:0;<%= row[:now] ? "border:2px solid white;box-shadow:0 0 0 2px #{static[:ring_color]};" : "" %>"></div>
                <% unless is_last %>
                  <div style="width:1.5px;flex:1;min-height:14px;background:<%= row[:line_color] || "#e8ecf4" %>;"></div>
                <% end %>
              </div>
              <div style="padding-bottom:<%= is_last ? '0' : '14px' %>;flex:1;">
                <div style="font-family:'Nunito',sans-serif;font-size:12px;font-weight:700;color:<%= row[:muted] ? '#8a9ab8' : '#0e1a2e' %>;"><%= row[:evt].html_safe %></div>
                <div style="font-family:'JetBrains Mono',monospace;font-size:7.5px;color:#8a9ab8;margin-top:1px;"><%= row[:date] %></div>
                <% if row[:badge] %>
                  <% if row[:badge][:glow] || row[:glow] %>
                    <span class="tl-badge-glow"><%= row[:badge][:text] %></span>
                  <% else %>
                    <span class="tl-badge" style="<%= row[:badge][:style] %>"><%= row[:badge][:text] %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Bills -->
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Sponsored Legislation</div>
          <h2 class="dp-section-title">Active Bills</h2>
          <% static[:bills].each do |bill| %>
            <div style="display:flex;align-items:stretch;background:white;border:0.5px solid #dde5f5;border-radius:8px;margin-bottom:8px;overflow:hidden;">
              <div style="width:5px;background:<%= bill[:rail] %>;flex-shrink:0;"></div>
              <div style="flex:1;padding:10px 14px;">
                <div style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.1em;text-transform:uppercase;color:<%= bill[:rail] %>;margin-bottom:3px;">State · <%= bill[:id] %></div>
                <div style="font-family:'Nunito',sans-serif;font-size:11px;font-weight:600;color:#1b3a6b;line-height:1.35;margin-bottom:3px;"><%= bill[:title] %></div>
                <div style="font-family:'JetBrains Mono',monospace;font-size:7px;color:#8a9ab8;"><%= bill[:status] %></div>
              </div>
            </div>
          <% end %>
          <p style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;color:#b0b8c8;margin-top:6px;">* Bill data hardcoded · as of March 2026</p>
        </div>

        <!-- Committees (if any) -->
        <% if static[:committees].any? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Committees</div>
          <h2 class="dp-section-title">Where Bills Live or Die</h2>
          <% static[:committees].each do |c| %>
            <div style="background:white;border-radius:6px;padding:10px 12px;margin-bottom:6px;border:0.5px solid #dde5f5;">
              <div style="font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:.14em;text-transform:uppercase;color:#8a9ab8;margin-bottom:4px;"><%= c[:role] %></div>
              <div style="font-family:'Nunito',sans-serif;font-size:12px;color:#1b3a6b;"><%= c[:name] %></div>
            </div>
          <% end %>
          <p style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;color:#b0b8c8;margin-top:6px;">* Committee assignments hardcoded · as of March 2026</p>
        </div>
        <% end %>

        <!-- Voting Record -->
        <% if static[:voting].any? %>
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ On the Floor</div>
          <h2 class="dp-section-title">Recent Votes</h2>
          <% static[:voting].each do |title, vote| %>
            <% pill_color = {"Yea"=>"#27500A","Nay"=>"#7a1515","Miss"=>"#633806"}[vote] || "#5a6e8a" %>
            <% pill_bg    = {"Yea"=>"rgba(39,80,10,.12)","Nay"=>"rgba(122,21,21,.10)","Miss"=>"rgba(99,56,6,.10)"}[vote] || "rgba(0,0,0,.06)" %>
            <div style="background:white;border-radius:6px;padding:9px 10px;margin-bottom:6px;display:flex;align-items:center;justify-content:space-between;gap:10px;border:0.5px solid #dde5f5;">
              <span style="font-family:'Nunito',sans-serif;font-size:11px;color:#2d3a50;flex:1;line-height:1.3;"><%= title %></span>
              <span style="font-family:'JetBrains Mono',monospace;font-size:7px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:<%= pill_color %>;background:<%= pill_bg %>;border-radius:100px;padding:3px 8px;white-space:nowrap;"><%= vote %></span>
            </div>
          <% end %>
          <p style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:0.08em;color:#b0b8c8;margin-top:6px;">* Voting history hardcoded · as of March 2026</p>
        </div>
        <% end %>

      </div><!-- /dp-main -->

      <!-- Sidebar -->
      <div class="dp-sidebar">

        <!-- Contact -->
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Reach Out</div>
          <h2 class="dp-section-title">Contact</h2>
          <% [["Office", static[:contact_office]], ["Phone", static[:contact_phone]]].each do |k, v| %>
            <div style="background:white;border-radius:6px;padding:10px 12px;margin-bottom:6px;border:0.5px solid #dde5f5;">
              <div style="font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:.14em;text-transform:uppercase;color:#8a9ab8;margin-bottom:4px;"><%= k %></div>
              <div style="font-family:'Nunito',sans-serif;font-size:11px;color:#1b3a6b;"><%= v %></div>
            </div>
          <% end %>
          <div style="background:white;border-radius:6px;padding:10px 12px;margin-bottom:6px;border:0.5px solid #dde5f5;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:.14em;text-transform:uppercase;color:#8a9ab8;margin-bottom:4px;">Website</div>
            <a href="<%= static[:contact_web] %>" target="_blank" rel="noopener" style="font-family:'Nunito',sans-serif;font-size:11px;color:#3a6abf;text-decoration:none;word-break:break-all;"><%= static[:contact_web_display] %></a>
          </div>
        </div>

        <!-- Q&A -->
        <div class="dp-section">
          <div class="dp-section-eyebrow">◆ Community</div>
          <h2 class="dp-section-title">Q&amp;A</h2>
          <div style="background:white;border-radius:8px;padding:18px 14px;text-align:center;border:0.5px solid #dde5f5;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.18em;text-transform:uppercase;color:#b8860b;margin-bottom:6px;">Coming Soon</div>
            <p style="font-family:'Nunito',sans-serif;font-size:11px;color:#5a6e8a;line-height:1.55;margin:0;">Ask questions about this official's record and positions.</p>
          </div>
        </div>

        <!-- Data note -->
        <div style="background:#fdf8ed;border:0.5px solid rgba(184,134,11,0.25);border-radius:8px;padding:12px 14px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:.14em;text-transform:uppercase;color:#b8860b;margin-bottom:6px;">◆ Data Note</div>
          <p style="font-family:'Nunito',sans-serif;font-size:10px;color:#6b5c2e;line-height:1.55;margin:0;">Statistics marked <strong>*</strong> are hardcoded as of March 2026. Live data connections for state officials are in progress. Sources: PA General Assembly, governor.pa.gov, OpenStates.</p>
        </div>

      </div><!-- /dp-sidebar -->
    </div><!-- /dp-body -->
  </div>
</div><!-- /desktop-profile -->


<!-- ══════════════════════════════════════════
     MOBILE LAYOUT  (matches fora.center mobile card exactly)
══════════════════════════════════════════ -->
<div class="mobile-profile">
<div style="background:#e8ebf2; min-height:100vh;">
<div class="mobile-card" style="max-width:480px; margin:0 auto;">


  <!-- ─────────────────────────────────────
       SECTION 1 · HERO BAND
  ───────────────────────────────────────── -->
  <div style="background:#1b3a6b; position:relative; overflow:hidden;">

    <!-- Decorative rings -->
    <div style="position:absolute;right:-20px;top:-30px;width:160px;height:160px;border-radius:50%;border:16px solid rgba(255,255,255,0.025);pointer-events:none;"></div>
    <div style="position:absolute;right:20px;top:0;width:80px;height:80px;border-radius:50%;border:1px solid rgba(184,134,11,0.1);pointer-events:none;"></div>

    <div style="padding:14px 14px 20px; position:relative; z-index:1;">
      <a href="javascript:history.back()" style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,0.3);text-decoration:none;display:block;margin-bottom:14px;">← My Government</a>

      <!-- Photo + name -->
      <div style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px;">
        <div style="width:72px;height:72px;border-radius:50%;background:linear-gradient(135deg,#254f92,#1b3a6b);border:2.5px solid rgba(184,134,11,0.5);display:flex;align-items:center;justify-content:center;font-family:'Libre Baskerville',serif;font-size:24px;font-weight:700;color:#d4a832;flex-shrink:0;overflow:hidden;position:relative;">
          <% if s_photo %>
            <img src="<%= s_photo %>" alt="<%= s_name %>" style="width:100%;height:100%;object-fit:cover;object-position:center top;border-radius:50%;">
          <% else %>
            <span><%= s_initials %></span>
          <% end %>
          <div style="position:absolute;bottom:-1px;right:-1px;width:18px;height:18px;border-radius:50%;background:#155c2d;border:2px solid #1b3a6b;display:flex;align-items:center;justify-content:center;font-size:8px;color:white;">✓</div>
        </div>

        <div>
          <div style="font-family:'Libre Baskerville',serif;font-size:20px;font-weight:700;color:white;line-height:1.15;margin-bottom:3px;"><%= s_name %></div>
          <div style="font-family:'Nunito',sans-serif;font-size:10px;font-weight:300;color:rgba(255,255,255,0.5);margin-bottom:8px;"><%= s_office %></div>
          <% if party_raw.present? %>
            <span style="font-family:'JetBrains Mono',monospace;font-size:7px;letter-spacing:.1em;text-transform:uppercase;padding:2px 8px;border-radius:100px;border:1px solid;<%= party_tag_style %>"><%= party_raw %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div><!-- /hero band -->


  <!-- ─────────────────────────────────────
       SECTION 2 · STAT STRIP (True Color BG) + NEWS
  ───────────────────────────────────────── -->

  <!-- TRUE COLOR stat bar -->
  <div style="display:grid;grid-template-columns:repeat(<%= static[:stats].size %>,1fr);background:<%= static[:true_color_bg] %>;">
    <% static[:stats].each do |val, label| %>
      <div style="padding:9px 4px;text-align:center;border-right:0.5px solid rgba(255,255,255,0.07);">
        <div style="font-family:'Libre Baskerville',serif;font-size:13px;font-weight:700;color:white;line-height:1;"><%= val %></div>
        <div style="font-family:'JetBrains Mono',monospace;font-size:5px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,0.3);margin-top:3px;"><%= label %></div>
      </div>
    <% end %>
  </div>

  <!-- Gilt rule (matches federal mobile exactly) -->
  <div style="height:3px;background:linear-gradient(to right,transparent,#b8860b 30%,#d4a832 50%,#b8860b 70%,transparent);"></div>

  <!-- News strip -->
  <div style="background:#f6f8fd;border-bottom:1px solid #e8ebf2;">
    <% static[:news].each_with_index do |n, i| %>
      <div style="display:flex;align-items:center;gap:10px;padding:8px 14px;<%= i < static[:news].size - 1 ? 'border-bottom:0.5px solid #eaecf2;' : '' %>">
        <div style="width:6px;height:6px;border-radius:50%;background:<%= n[:dot] %>;flex-shrink:0;"></div>
        <span style="font-family:'JetBrains Mono',monospace;font-size:6.5px;letter-spacing:.08em;text-transform:uppercase;color:#8a9ab8;width:48px;flex-shrink:0;"><%= n[:source] %></span>
        <span style="font-family:'Nunito',sans-serif;font-size:10px;color:#4a5568;flex:1;line-height:1.35;"><%= n[:text] %></span>
        <span style="font-family:'JetBrains Mono',monospace;font-size:6.5px;color:#b0b8c8;flex-shrink:0;"><%= n[:age] %></span>
      </div>
    <% end %>
  </div>


