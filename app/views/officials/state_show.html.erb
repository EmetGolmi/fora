<% content_for(:title) { "#{@member['name']} — FORA" } %>

<% content_for :head do %>
<style>
  /* ── Animations (matches federal show.html.erb) ── */
  @keyframes foil-shift {
    0%   { background-position: -200% center; }
    100% { background-position:  200% center; }
  }
  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 4px 1px rgba(184,134,11,0.4); }
    50%       { box-shadow: 0 0 10px 3px rgba(184,134,11,0.7); }
  }
  .mob-ticker-track {
    display: inline-flex;
    white-space: nowrap;
    animation: ticker-scroll 28s linear infinite;
  }
  .mob-foil {
    background: linear-gradient(105deg,
      rgba(255,255,255,0) 0%, rgba(184,134,11,.08) 25%,
      rgba(255,255,255,.14) 50%, rgba(184,134,11,.06) 75%,
      rgba(255,255,255,0) 100%);
    background-size: 200% auto;
    animation: foil-shift 4s ease-in-out infinite;
    pointer-events: none;
  }
  /* ── Mobile modals (identical to federal) ── */
  .mob-modal {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,.55); z-index: 100;
    align-items: flex-end; justify-content: center;
  }
  .mob-modal.open { display: flex; }
  .mob-sheet {
    background: white; border-radius: 16px 16px 0 0;
    padding: 20px 18px 32px; width: 100%;
    max-height: 75vh; overflow-y: auto;
  }
  .mob-handle {
    width: 36px; height: 4px; background: rgba(0,0,0,.12);
    border-radius: 2px; margin: 0 auto 16px;
  }
  .mob-got-it {
    font-family: 'JetBrains Mono', monospace;
    font-size: 8px; letter-spacing: .14em; text-transform: uppercase;
    color: white; background: #1b3a6b; border: none;
    border-radius: 100px; padding: 12px; cursor: pointer; width: 100%;
  }
  /* ── Timeline ── */
  .tl-badge-glow {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 6.5px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 100px; margin-top: 3px;
    background: rgba(184,134,11,0.1); color: #b8860b;
    border: 1px solid rgba(184,134,11,0.4);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  .tl-badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 6.5px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 100px; margin-top: 3px;
  }
  /* ── Social icons ── */
  .social-btn:hover { color: white !important; }
</style>
<% end %>

