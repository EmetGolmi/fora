<% content_for(:title) { "#{@member['name']} — FORA" } %>

<% content_for :head do %>
<style>
  /* ── Animations (matches federal show.html.erb) ── */
  @keyframes foil-shift {
    0%   { background-position: -200% center; }
    100% { background-position:  200% center; }
  }
  @keyframes ticker-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @keyframes pulse-glow {
    0%, 100% { box-shadow: 0 0 4px 1px rgba(184,134,11,0.4); }
    50%       { box-shadow: 0 0 10px 3px rgba(184,134,11,0.7); }
  }
  .mob-ticker-track {
    display: inline-flex;
    white-space: nowrap;
    animation: ticker-scroll 28s linear infinite;
  }
  .mob-foil {
    background: linear-gradient(105deg,
      rgba(255,255,255,0) 0%, rgba(184,134,11,.08) 25%,
      rgba(255,255,255,.14) 50%, rgba(184,134,11,.06) 75%,
      rgba(255,255,255,0) 100%);
    background-size: 200% auto;
    animation: foil-shift 4s ease-in-out infinite;
    pointer-events: none;
  }
  /* ── Mobile modals (identical to federal) ── */
  .mob-modal {
    display: none; position: fixed; inset: 0;
    background: rgba(0,0,0,.55); z-index: 100;
    align-items: flex-end; justify-content: center;
  }
  .mob-modal.open { display: flex; }
  .mob-sheet {
    background: white; border-radius: 16px 16px 0 0;
    padding: 20px 18px 32px; width: 100%;
    max-height: 75vh; overflow-y: auto;
  }
  .mob-handle {
    width: 36px; height: 4px; background: rgba(0,0,0,.12);
    border-radius: 2px; margin: 0 auto 16px;
  }
  .mob-got-it {
    font-family: 'JetBrains Mono', monospace;
    font-size: 8px; letter-spacing: .14em; text-transform: uppercase;
    color: white; background: #1b3a6b; border: none;
    border-radius: 100px; padding: 12px; cursor: pointer; width: 100%;
  }
  /* ── Timeline ── */
  .tl-badge-glow {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 6.5px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 100px; margin-top: 3px;
    background: rgba(184,134,11,0.1); color: #b8860b;
    border: 1px solid rgba(184,134,11,0.4);
    animation: pulse-glow 2s ease-in-out infinite;
  }
  .tl-badge {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 6.5px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 100px; margin-top: 3px;
  }
  /* ── Social icons ── */
  .social-btn:hover { color: white !important; }
  /* ── Q&A / Your Take ── */
  .bt-card { background:white; border-radius:10px; border:0.5px solid #dde5f5; padding:22px 26px; }
  .bt-eyebrow { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.18em; text-transform:uppercase; color:#b8860b; font-weight:700; margin-bottom:12px; }
  .bt-perspective-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:14px; }
  .bt-perspective-btn { padding:9px 10px; border-radius:6px; border:1.5px solid #dde5f5; background:white; font-family:'Nunito',sans-serif; font-size:11px; font-weight:600; color:#5a6e8a; cursor:pointer; text-align:left; transition:all 0.12s; }
  .bt-perspective-btn:hover { border-color:#3a6abf; color:#1b3a6b; }
  .bt-perspective-btn.active[data-type="empathy"]        { background:#e8f4fd; border-color:#1b3a6b; color:#1b3a6b; }
  .bt-perspective-btn.active[data-type="practical"]      { background:#e5f0e8; border-color:#155c2d; color:#155c2d; }
  .bt-perspective-btn.active[data-type="accountability"] { background:#fff3dc; border-color:#b8860b; color:#b8860b; }
  .bt-perspective-btn.active[data-type="opposition"]     { background:#faeaea; border-color:#8b1a1a; color:#8b1a1a; }
  .bt-textarea { width:100%; min-height:90px; border:1px solid #dde5f5; border-radius:6px; padding:12px 14px; font-family:'Nunito',sans-serif; font-size:14px; color:#0e1a2e; line-height:1.65; resize:vertical; outline:none; box-sizing:border-box; }
  .bt-textarea:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .bt-form-row { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:10px; margin-bottom:10px; }
  .bt-input { width:100%; border:1px solid #dde5f5; border-radius:6px; padding:8px 12px; font-family:'Nunito',sans-serif; font-size:12px; color:#0e1a2e; outline:none; box-sizing:border-box; }
  .bt-input:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .bt-checkbox-row { display:flex; align-items:center; gap:8px; font-family:'Nunito',sans-serif; font-size:12px; color:#5a6e8a; }
  .bt-submit { width:100%; padding:11px; background:#1b3a6b; color:white; border:none; border-radius:7px; font-family:'Nunito',sans-serif; font-size:13px; font-weight:700; cursor:pointer; }
  .bt-submit:hover { background:#254f92; }
  .bt-share-panel { background:#f8faff; border:1px solid #dde5f5; border-radius:8px; padding:16px 18px; margin-top:14px; }
  .bt-share-panel-label { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.16em; text-transform:uppercase; color:#8a9ab8; margin-bottom:8px; }
  .bt-share-copy { font-family:'Nunito',sans-serif; font-size:12px; color:#2c3e5a; line-height:1.6; padding:10px 12px; background:white; border:1px solid #dde5f5; border-radius:6px; margin-bottom:12px; white-space:pre-wrap; word-break:break-word; }
  .bt-share-btns { display:flex; flex-wrap:wrap; gap:6px; }
  .bt-share-plat { font-family:'JetBrains Mono',monospace; font-size:8px; letter-spacing:0.07em; padding:6px 12px; border-radius:4px; border:1px solid #dde5f5; background:white; color:#254f92; cursor:pointer; }
  .bt-share-plat:hover { background:#edf1fb; }
  /* ── Photo attachment ── */
  .photo-attach-wrap { margin-top:10px; margin-bottom:10px; }
  .photo-attach-label { font-family:'JetBrains Mono',monospace; font-size:7px; letter-spacing:0.14em; text-transform:uppercase; color:#5a6e8a; display:block; margin-bottom:6px; }
  .photo-attach-options { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .photo-opt-btn { font-family:'Nunito',sans-serif; font-size:12px; color:#1b3a6b; background:#f2f6ff; border:1px solid #dde5f5; border-radius:6px; padding:7px 12px; cursor:pointer; white-space:nowrap; }
  .photo-opt-btn:hover { background:#e8effd; }
  .photo-opt-divider { font-family:'Nunito',sans-serif; font-size:11px; color:#b0b8c8; }
  .photo-link-input { flex:1; min-width:160px; border:1px solid #dde5f5; border-radius:6px; padding:7px 10px; font-family:'Nunito',sans-serif; font-size:12px; color:#0e1a2e; outline:none; box-sizing:border-box; }
  .photo-link-input:focus { border-color:#3a6abf; box-shadow:0 0 0 3px rgba(58,106,191,0.1); }
  .photo-preview-area { display:flex; align-items:center; gap:10px; margin-top:8px; padding:8px 10px; background:#f8faff; border:1px solid #dde5f5; border-radius:6px; }
  .photo-preview-img { width:48px; height:48px; object-fit:cover; border-radius:4px; cursor:pointer; }
  .photo-preview-meta { flex:1; min-width:0; }
  .photo-preview-name { font-family:'Nunito',sans-serif; font-size:11px; color:#5a6e8a; display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .photo-remove-btn { font-family:'Nunito',sans-serif; font-size:11px; color:#8b1a1a; background:none; border:none; cursor:pointer; padding:0; margin-top:3px; display:block; }
  .lightbox-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9999; align-items:center; justify-content:center; }
  .lightbox-overlay.open { display:flex; }
  .lightbox-overlay img { max-width:90vw; max-height:85vh; border-radius:8px; object-fit:contain; }
  .lightbox-close { position:absolute; top:18px; right:22px; background:none; border:none; color:white; font-size:26px; cursor:pointer; line-height:1; }
  @media (max-width:600px) { .bt-form-row { grid-template-columns:1fr; } }
</style>
<% end %>

